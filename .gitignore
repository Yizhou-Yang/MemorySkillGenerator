# IDE
.vscode/
.idea/
*.swp
*.swo

# CodeBuddy / Agent skill cache
.codebuddy/

# Experiment — exclude large binary/log outputs only, keep JSON reports & traces
experiments_results/**/*.log
experiments_results/**/experience_library/
# Harbor TB2 session recordings (multi-GB asciinema casts / agent logs)
experiments_results/harbor_tb2/**/*.cast
experiments_results/harbor_tb2/**/sessions/agent.log

# Vector database local storage
chroma_data/
qdrant_data/

# Model cache
models_cache/
.cache/

