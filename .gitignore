.DS_Store
Thumbs.db

# Large archive / temp files
docs.tar.gz
docs_no_pdf.tar.gz
temp/
search_results.json

# AlfredWorld virtual environment
.venv_alfworld/

# Docs (large reference PDFs, not source code)
docs/

# Local reference papers — keep out of git
paper_reference/

# Paper source (double-blind, under review) — NEVER commit to the public repo
paper/

# Local secrets — NEVER commit
.git-credentials.local
.secrets/

# Stray result archives
*.zip

# persistent local copies of benchmark datasets (do not commit)
.datasets/

# terminal-bench runtime artifacts
logs/
runs/

# old terminal-bench task format (use .datasets/terminal-bench-2 instead)
terminal-bench/

# Harbor/terminal-bench raw harness output — huge (.cast recordings, per-task
# dirs). Only trace.jsonl (+ results.json summaries the bridge reads) belong in
# git; raw runs stay local.
experiments_results/harbor_tb2/*/runs_*/
experiments_results/harbor_tb2/*/mem_*.pkl

# Experiment result DATA stays out of git EXCEPT the compact trace.jsonl files
# (a few MB each) — they are the sync channel for off-server analysis. Raw
# harness output (runs_*/, .cast, pkl, logs, reports) stays server-local.
experiments_results/latest/*
experiments_results/latest_evolving/*
experiments_results/harbor_tb2/*
experiments_results/ablation/*
experiments_results/formal/2026-*/
experiments_results/vgr/
run_*.log
