[44.909555, "i", "cat > /workspace/plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n' IHn'].\n  - simpl.\n    symmetry.\n    apply Nat.add_0_r.\n  - simpl.\n    rewrite Nat.add_succ_r.\n    rewrite IHn'.\n    reflexivity.\nQed.\nEOF\n"]
