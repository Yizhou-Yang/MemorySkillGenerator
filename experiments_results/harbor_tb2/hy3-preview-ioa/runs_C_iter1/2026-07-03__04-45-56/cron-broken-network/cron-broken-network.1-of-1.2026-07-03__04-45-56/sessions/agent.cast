[75.813621, "i", "cat > /app/curl.py << 'EOF'\n#!/usr/bin/env python3\nimport sys\nimport urllib.request\nimport urllib.error\n\ndef fetch(url, timeout=10):\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"robust-curl/1.0\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as resp:\n            resp.read()\n            return resp.status\n    except urllib.error.HTTPError as e:\n        # Server answered, but with a 4xx/5xx status.\n        return e.code\n    except Exception as e:\n        # Transport-level failure: DNS resolution error, connection refused,\n        # socket timeout, SSL error, etc. Report '000' like curl does\n        # instead of letting the script die with a traceback.\n        sys.stderr.write(\"transport error: %s\\n\" % e)\n        return 0\n\ndef main(argv):\n    if len(argv) < 2:\n        sys.stderr.write(\"usage: python3 curl.py URL\\n\")\n        return 2\n    code = fetch(argv[1])\n    if code == 0:\n        print(\"000\")\n    else:\n        print(code)\n"]
