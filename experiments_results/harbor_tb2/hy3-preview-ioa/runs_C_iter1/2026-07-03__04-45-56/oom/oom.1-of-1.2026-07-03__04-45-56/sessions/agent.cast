[156.365223, "i", "cat > /tmp/cache_model.py << 'EOF'\nimport os\nfrom huggingface_hub import snapshot_download\nfrom transformers import AutoTokenizer, AutoModel\n\nREPO = \"albert/albert-base-v2\"\n\n# 1) Pull ALL repo files so the cache is fully offline-capable\ndl = snapshot_download(repo_id=REPO, local_dir=None)\nprint(\"snapshot_download ->\", dl)\n\n# 2) Materialize tokenizer and model into the cache explicitly\nAutoTokenizer.from_pretrained(REPO)\nprint(\"tokenizer cached\")\nAutoModel.from_pretrained(REPO)\nprint(\"model cached\")\nprint(\"DONE\")\nEOF\n"]
