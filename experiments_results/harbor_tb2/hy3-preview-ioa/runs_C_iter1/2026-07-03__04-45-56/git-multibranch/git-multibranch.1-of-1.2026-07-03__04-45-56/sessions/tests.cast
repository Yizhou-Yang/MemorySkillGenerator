[31.289909, "o", "\r\n        result = os.popen(\u001b[33m\"\u001b[39;49;00m\u001b[33mbash verify.sh\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).read()\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mprint\u001b[39;49;00m(result)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mTEST PASSED\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m result, \u001b[33m\"\u001b[39;49;00m\u001b[33mHTTPS multi-branch deploy test failed\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: HTTPS multi-branch deploy test failed\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 'TEST PASSED' in \"Hit:1 http://archive.ubuntu.com/ubuntu resolute InRelease\\nHit:2 http://security.ubuntu.com/ubuntu resolute-security ... content', got: <h1>Main Branch Deployed</h1>\\nExpected dev: 'dev branch content', got: <h1>Dev Branch Deployed</h1>\\n\"\u001b[0m\r\n\r\n"]
