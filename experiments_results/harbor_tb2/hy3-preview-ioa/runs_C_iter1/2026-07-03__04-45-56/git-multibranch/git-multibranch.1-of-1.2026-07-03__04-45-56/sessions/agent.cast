[165.115605, "i", "useradd -m -s /bin/bash git 2>/dev/null; echo 'git:password' | chpasswd; mkdir -p /git /run/sshd /etc/nginx/ssl /var/www/main /var/www/dev; git init --bare /git/project; echo '<h1>main placeholder</h1>' > /var/www/main/index.html; echo '<h1>dev placeholder</h1>' > /var/www/dev/index.html; chown -R git:git /git /var/www; ssh-keygen -A\n"]
