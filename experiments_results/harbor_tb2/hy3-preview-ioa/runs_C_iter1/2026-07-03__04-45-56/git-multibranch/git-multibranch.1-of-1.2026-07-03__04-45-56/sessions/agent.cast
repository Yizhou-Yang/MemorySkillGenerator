[166.986092, "i", "openssl req -x509 -newkey rsa:2048 -nodes -keyout /etc/nginx/ssl/nginx.key -out /etc/nginx/ssl/nginx.crt -days 365 -subj \"/CN=localhost\" 2>/dev/null\ncat > /etc/nginx/conf.d/ssl.conf <<'EOF'\nserver {\n    listen 8443 ssl;\n    server_name localhost;\n    ssl_certificate /etc/nginx/ssl/nginx.crt;\n    ssl_certificate_key /etc/nginx/ssl/nginx.key;\n    root /var/www/main;\n    index index.html;\n    location /dev/ {\n        alias /var/www/dev/;\n        index index.html;\n    }\n}\nEOF\n"]
