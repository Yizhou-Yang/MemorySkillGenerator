[165.427903, "o", "\u001b[33mhint: Using 'master' as the name for the initial branch. This default branch name\u001b[m\r\n\u001b[33mhint: will change to \"main\" in Git 3.0. To configure the initial branch name\u001b[m\r\n\u001b[33mhint: to use in all of your new repositories, which will suppress this warning,\u001b[m\r\n\u001b[33mhint: call:\u001b[m\r\n\u001b[33mhint:\u001b[m\r\n\u001b[33mhint: \tgit config --global init.defaultBranch <name>\u001b[m\r\n\u001b[33mhint:\u001b[m\r\n\u001b[33mhint: Names commonly chosen instead of 'master' are 'main', 'trunk' and\u001b[m\r\n\u001b[33mhint: 'development'. The just-created branch can be renamed via this command:\u001b[m\r\n\u001b[33mhint:\u001b[m\r\n\u001b[33mhint: \tgit branch -m <name>\u001b[m\r\n\u001b[33mhint:\u001b[m\r\n\u001b[33mhint: Disable this message with \"git config set advice.defaultBranchName false\"\u001b[m\r\n"]
[165.428073, "o", "Initialized empty Git repository in /git/project/\r\n"]
[165.466589, "o", "\u001b[?2004h"]
[165.467049, "o", "root@d74a665d2e11:/app# "]
[166.09178, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\numask 022\nGIT_DIR=/git/project\nwhile read oldrev newrev refname; do\n    branch=\"${refname#refs/heads/}\"\n    case \"$branch\" in\n        main) target=/var/www/main ;;\n        dev)  target=/var/www/dev ;;\n        *) continue ;;\n    esac\n    mkdir -p \"$target\"\n    git --git-dir=\"$GIT_DIR\" archive \"$branch\" 2>/dev/null | tar -x -C \"$target\"\ndone\nEOF\nchmod +x /git/project/hooks/post-receive\n"]
[166.092565, "o", "cat > /git/project/hooks/post-receive <<'EOF'"]
[166.092757, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
