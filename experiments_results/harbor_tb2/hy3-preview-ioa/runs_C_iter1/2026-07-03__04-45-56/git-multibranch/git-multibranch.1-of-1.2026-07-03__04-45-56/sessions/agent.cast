[166.681837, "i", "printf 'Host localhost\\n    StrictHostKeyChecking no\\n    UserKnownHostsFile /dev/null\\n    LogLevel ERROR\\n\\n' | cat - /etc/ssh/ssh_config > /tmp/ssh_config.new && mv /tmp/ssh_config.new /etc/ssh/ssh_config\nmkdir -p /etc/ssh/ssh_config.d\ncat > /etc/ssh/ssh_config.d/99-localhost.conf <<'EOF'\nHost localhost\n    StrictHostKeyChecking no\n    UserKnownHostsFile /dev/null\n    LogLevel ERROR\nEOF\n"]
[166.684221, "o", "printf 'Host localhost\\n    StrictHostKeyChecking no\\n    UserKnownHostsFile /dev/null\\n    LogLevel ERROR\\n\\n' | cat - /etc/ssh/ssh_config > /tmp/ssh_config.new && mv /tmp/ssh_config.new /etc/ssh/ssh_config\r\n\u001b[?2004l\r"]
