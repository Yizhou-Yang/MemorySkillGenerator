[228.733049, "i", "cat > /app/test.sh <<'EOF'\n#!/bin/bash\nset -e\nexport GIT_SSH_COMMAND=\"expect -f /app/ssh-password.exp\"\ncd /tmp\nrm -rf localrepo && mkdir localrepo && cd localrepo\ngit init -b main -q\ngit config user.email t@t.com\ngit config user.name tester\necho '<h1>Main Branch Deployed</h1>' > index.html\ngit add -A && git commit -qm 'main commit'\ngit remote add origin ssh://git@localhost/git/project\ngit push -q origin main\necho '--- pushed main ---'\ngit checkout -q -b dev\ngit rm -q index.html 2>/dev/null || true\necho '<h1>Dev Branch Deployed</h1>' > index.html\ngit add -A && git commit -qm 'dev commit'\ngit push -q origin dev\necho '--- pushed dev ---'\nEOF\nchmod +x /app/test.sh\n"]
