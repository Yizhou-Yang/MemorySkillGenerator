[271.50868, "i", "cat > /app/convert.py << 'PYEOF'\nimport csv, struct\n\nI32=5; I64=6; DOUBLE=7; BINARY=8; LIST=9; STRUCT=12\n\nPINT32=1; PINT64=2; PFLOAT=4; PDOUBLE=5; PBYTE_ARRAY=6\nREP_REQUIRED=0; CONVERTED_UTF8=0; CODEC_UNCOMPRESSED=0\nENC_PLAIN=0; ENC_RLE=3; PAGE_DATA_PAGE=0\n\ndef write_varint(buf, n):\n    while True:\n        b = n & 0x7F; n >>= 7\n        if n:\n            buf.append(b | 0x80)\n        else:\n            buf.append(b); break\n\ndef zigzag(n):\n    return (n << 1) if n >= 0 else ((-n << 1) - 1)\n\ndef write_zigzag(buf, n):\n    write_varint(buf, zigzag(n))\n\ndef write_value(buf, ftype, value):\n    if ftype == I32 or ftype == I64:\n        write_zigzag(buf, value)\n    elif ftype == DOUBLE:\n        buf += struct.pack('<d', value)\n    elif ftype == BINARY:\n        b = value if isinstance(value, bytes) else value.encode('utf-8')\n        write_varint(buf, len(b)); buf += b\n    elif ftype == LIST:\n        etype, items = value; n = len(items)\n        if n < 15:\n            buf.append((n << 4) | (etype & 0x0F))\n        else:\n            buf.append((0x0F << 4) | (etype & 0x0F)); write_varint(buf, n)\n        for it in items:\n            write_value(buf, etype, it)\n    elif ftype == STRUCT:\n        write_struct(buf, value)\n    else:\n        raise ValueError('bad ftype %r' % ftype)\n\ndef write_struct(buf, fields):\n    last = 0\n    for fid, ftype, value in fields:\n        delta = fid - last\n        if 1 <= delta <= 15:\n            buf.append((delta << 4) | (ftype & 0x0F))\n        else:\n            buf.append(ftype & 0x0F); write_zigzag(buf, fid)\n        last = fid; write_value(buf, ftype, value)\n    buf.append(0x00)\n\ndef encode_plain(values, coltype):\n    out = bytearray()\n    if coltype == PINT32:\n        for v in values: out += struct.pack('<i', int(v))\n    elif coltype == PINT64:\n        for v in values: out += struct.pack('<q', int(v))\n    elif coltype == PFLOAT:\n        for v in values: out += struct.pack('<f', float(v))\n    elif coltype == PDOUBLE:\n        for v in values: out += struct.pack('<d', float(v))\n    elif coltype == PBYTE_ARRAY:\n        for v in values:\n            b = v if isinstance(v, bytes) else v.encode('utf-8')\n            out += struct.pack('<I', len(b)) + b\n    else:\n        raise ValueError('unsupported coltype')\n    return bytes(out)\n\ndef infer_type(vals):\n    intok = True; big = False\n    for v in vals:\n        if v == '': continue\n        try: iv = int(v)\n        except ValueError: intok = False; break\n        if abs(iv) > 0x7FFFFFFF: big = True\n    if intok: return PINT64 if big else PINT32\n    fok = True\n    for v in vals:\n        if v == '': continue\n        try: float(v)\n        except ValueError: fok = False; break\n    if fok: return PDOUBLE\n    return PBYTE_ARRAY\n\ndef main():\n    with open('/app/data.csv', newline='') as f:\n        rows = [r for r in csv.reader(f) if r]\n    header = rows[0]; data = rows[1:]\n    ncols = len(header); nrows = len(data)\n    cols = [(header[j], infer_type([data[i][j] for i in range(nrows)]),\n             [data[i][j] for i in range(nrows)]) for j in range(ncols)]\n\n    out = bytearray(); out += b'PAR1'\n    rg_cols = []; total = 0\n    for (name, t, colvals) in cols:\n        page_data = encode_plain(colvals, t)\n        dph = [(1, I32, nrows), (2, I32, ENC_PLAIN), (3, I32, ENC_RLE), (4, I32, ENC_RLE)]\n        ph = bytearray()\n        write_struct(ph, [(1, I32, PAGE_DATA_PAGE), (2, I32, len(page_data)),\n                          (3, I32, len(page_data)), (5, STRUCT, dph)])\n        page = bytes(ph) + page_data\n        off = len(out); out += page; cs = len(page); total += cs\n        meta = [(1, I32, t), (2, LIST, (I32, [ENC_RLE, ENC_PLAIN])),\n                (3, LIST, (BINARY, [name])), (4, I32, CODEC_UNCOMPRESSED),\n                (5, I64, nrows), (6, I64, cs), (7, I64, cs), (8, I64, off)]\n        rg_cols.append([(2, I64, off), (3, STRUCT, meta)])\n\n    schema = [[(4, BINARY, 'schema'), (5, I32, ncols)]]\n    for (name, t, colvals) in cols:\n        fld = [(1, I32, t), (3, I32, REP_REQUIRED), (4, BINARY, name)]\n        if t == PBYTE_ARRAY: fld.append((6, I32, CONVERTED_UTF8))\n        schema.app"]
[271.508733, "i", "end(fld)\n\n    row_group = [(1, LIST, (STRUCT, rg_cols)), (2, I64, total), (3, I32, nrows)]\n    fm = [(1, I32, 1), (2, LIST, (STRUCT, schema)), (3, I64, nrows),\n          (4, LIST, (STRUCT, [row_group])), (5, BINARY, 'minimal-parquet-writer/1.0')]\n    footer = bytearray(); write_struct(footer, fm); fb = bytes(footer)\n    out += fb; out += struct.pack('<I', len(fb)); out += b'PAR1'\n    with open('/app/data.parquet', 'wb') as f: f.write(out)\n    print('wrote', len(out), 'bytes')\n\nmain()\nPYEOF\n"]
[271.51004, "o", "cat > /app/convert.py << 'PYEOF'"]
