[271.543002, "o", "\u001b[?2004hroot@7f298e3eab10:/app# "]
[271.679792, "i", "cat > /app/verify.py << 'PYEOF'\nimport struct, csv\n\nclass R:\n    def __init__(self, data, pos=0):\n        self.d = data; self.pos = pos\n    def byte(self):\n        b = self.d[self.pos]; self.pos += 1; return b\n    def varint(self):\n        shift = 0; res = 0\n        while True:\n            b = self.byte(); res |= (b & 0x7F) << shift\n            if not (b & 0x80): break\n            shift += 7\n        return res\n    def zigzag(self):\n        n = self.varint(); return (n >> 1) ^ -(n & 1)\n    def binary(self):\n        n = self.varint(); b = self.d[self.pos:self.pos+n]; self.pos += n; return b\n\ndef value(r, t):\n    if t == 1: return True\n    if t == 2: return False\n    if t == 3: return r.byte()\n    if t in (4, 5, 6): return r.zigzag()\n    if t == 7: b = r.d[r.pos:r.pos+8]; r.pos += 8; return struct.unpack('<d', b)[0]\n    if t == 8: return r.binary()\n    if t in (9, 10):\n        st = r.byte(); n = (st >> 4) & 0x0F; et = st & 0x0F\n        if n == 0x0F: n = r.varint()\n        return [value(r, et) for _ in range(n)]\n    if t == 11:\n        n = r.varint()\n        if n == 0: return {}\n        kt = r.byte(); vt = r.byte(); m = {}\n        for _ in range(n):\n            m[value(r, kt)] = value(r, vt)\n        return m\n    if t == 12: return struct_(r)\n    raise ValueError('bad type %d' % t)\n\ndef struct_(r):\n    f = {}; last = 0\n    while True:\n        h = r.byte()\n        if h == 0: break\n        d = (h >> 4) & 0x0F; ft = h & 0x0F\n        fid = last + d if d else r.zigzag(); last = fid\n        f[fid] = value(r, ft)\n    return f\n\ndef decode_plain(body, t, n):\n    if t == 1:\n        return [struct.unpack_from('<i', body, i*4)[0] for i in range(n)]\n    if t == 2:\n        return [struct.unpack_from('<q', body, i*8)[0] for i in range(n)]\n    if t == 5:\n        return [struct.unpack_from('<d', body, i*8)[0] for i in range(n)]\n    if t == 6:\n        out=[]; p=0\n        for _ in range(n):\n            ln = struct.unpack_from('<I', body, p)[0]; p += 4\n            out.append(body[p:p+ln].decode('utf-8')); p += ln\n        return out\n    raise ValueError('bad coltype %d' % t)\n\ndef main():\n    d = open('/app/data.parquet','rb').read()\n    flen = struct.unpack('<I', d[-8:-4])[0]\n    fm = struct_(R(d, len(d)-8-flen))\n    rows_data = []\n    for rg in fm[4]:\n        for cc in rg[1]:\n            meta = cc[3]; off = cc[2]\n            ph = struct_(R(d, off)); bs = ph[3]; pstart = off + (len(d)-8-flen - 0)  # placeholder\n            r = R(d, off); ph = struct_(r); body = d[r.pos:r.pos+ph[3]]\n            t = meta[1]; name = meta[3][0].decode('utf-8') if isinstance(meta[3][0], bytes) else meta[3][0]\n            nv = ph[5][1]\n            vals = decode_plain(body, t, nv)\n            rows_data.append((name, vals))\n    cols = [n for n,_ in rows_data]\n    print('columns:', cols)\n    nrows = len(rows_data[0][1])\n    for i in range(nrows):\n        print({n: rows_data[j][1][i] for j, n in enumerate(cols)})\n    # compare with CSV\n    with open('/app/data.csv', newline='') as f:\n        csvrows = [r for r in csv.reader(f) if r]\n    hdr = csvrows[0]\n    ok = True\n    for i in range(nrows):\n        for j, n in enumerate(cols):\n            cv = csvrows[i+1][j]\n            pv = rows_data[j][1][i]\n            if n == 'age':\n                if int(pv) != int(cv): ok = False\n            else:\n                if str(pv) != cv: ok = False\n    print('MATCH' if ok else 'MISMATCH')\n\nmain()\nPYEOF\n"]
[271.680853, "o", "cat > /app/verify.py << 'PYEOF'"]
