[271.740413, "o", "> "]
[271.741698, "o", "        csvrows = [r for r in csv.reader(f) if r]\r\n\u001b[?2004l\r\u001b[?2004h>     hdr = csvrows[0]\r\n\u001b[?2004l\r\u001b[?2004h>     ok = True\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(nrows):\r\n\u001b[?2004l\r\u001b[?2004h>         for j, n in enumerate(cols):\r\n\u001b[?2004l\r\u001b[?2004h>             cv = csvrows[i+1][j]\r\n\u001b[?2004l\r\u001b[?2004h>             pv = rows_data[j][1][i]\r\n\u001b[?2004l\r\u001b[?2004h>             if n == 'age':\r\n\u001b[?2004l\r"]
[271.743417, "o", "\u001b[?2004h>                 if int(pv) != int(cv): ok = False\r\n\u001b[?2004l\r\u001b[?2004h>             else:"]
