[153.251481, "i", "cat > /app/convert.py << 'PYEOF'\nimport csv, struct\n\nBOOL_TRUE=1; BOOL_FALSE=2; BYTE=3; I16=4; I32=5; I64=6; DOUBLE=7; BINARY=8; LIST=9; SET=10; MAP=11; STRUCT=12\n\nPBOOLEAN=0; PINT32=1; PINT64=2; PINT96=3; PFLOAT=4; PDOUBLE=5; PBYTE_ARRAY=6; PFIXED_LEN_BYTE_ARRAY=7\nREP_REQUIRED=0\nCONVERTED_UTF8=0\nCODEC_UNCOMPRESSED=0\nENC_PLAIN=0; ENC_RLE=3\nPAGE_DATA_PAGE=0\n\ndef write_varint(buf, n):\n    while True:\n        b = n & 0x7F\n        n >>= 7\n        if n:\n            buf.append(b | 0x80)\n        else:\n            buf.append(b)\n            break\n\ndef zigzag(n):\n    return (n << 1) if n >= 0 else ((-n << 1) - 1)\n\ndef write_zigzag(buf, n):\n    write_varint(buf, zigzag(n))\n\ndef write_value(buf, ftype, value):\n    if ftype == BOOL_TRUE or ftype == BOOL_FALSE:\n        return\n    if ftype == BYTE:\n        buf.append(value & 0xFF)\n    elif ftype in (I16, I32, I64):\n        write_zigzag(buf, value)\n    elif ftype == DOUBLE:\n        buf += struct.pack('<d', value)\n    elif ftype == BINARY:\n        if isinstance(value, str):\n            value = value.encode('utf-8')\n        write_varint(buf, len(value))\n        buf += value\n    elif ftype == LIST:\n        elem_type, items = value\n        size = len(items)\n        if size < 15:\n            buf.append((size << 4) | (elem_type & 0x0F))\n        else:\n            buf.append((0x0F << 4) | (elem_type & 0x0F))\n            write_varint(buf, size)\n        for item in items:\n            write_value(buf, elem_type, item)\n    elif ftype == STRUCT:\n        write_struct(buf, value)\n    else:\n        raise ValueError('unsupported type %r' % ftype)\n\ndef write_struct(buf, fields):\n    last = 0\n    for fid, ftype, value in fields:\n        delta = fid - last\n        if 1 <= delta <= 15:\n            buf.append((delta << 4) | (ftype & 0x0F))\n        else:\n            buf.append(ftype & 0x0F)\n            write_zigzag(buf, fid)\n        last = fid\n        write_value(buf, ftype, value)\n    buf.append(0x00)\n\ndef encode_plain(values, coltype):\n    out = bytearray()\n    if coltype == PINT32:\n        for v in values:\n            out += struct.pack('<i', v)\n    elif coltype == PINT64:\n        for v in values:\n            out += struct.pack('<q', v)\n    elif coltype == PFLOAT:\n        for v in values:\n            out += struct.pack('<f', v)\n    elif coltype == PDOUBLE:\n        for v in values:\n            out += struct.pack('<d', v)\n    elif coltype == PBYTE_ARRAY:\n        for v in values:\n            if isinstance(v, str):\n                v = v.encode('utf-8')\n            out += struct.pack('<I', len(v)) + v\n    else:\n        raise ValueError('unsupported coltype')\n    return bytes(out)\n\ndef infer_type(vals):\n    intok = True; int64needed = False\n    for v in vals:\n        if v == '':\n            continue\n        try:\n            iv = int(v)\n        except ValueError:\n            intok = False; break\n        if abs(iv) > 0x7FFFFFFF:\n            int64needed = True\n    if intok:\n        return PINT64 if int64needed else PINT32\n    floatok = True\n    for v in vals:\n        if v == '':\n            continue\n        try:\n            float(v)\n        except ValueError:\n            floatok = False; break\n    if floatok:\n        return PDOUBLE\n    return PBYTE_ARRAY\n\ndef main():\n    with open('/app/data.csv', newline='') as f:\n        rows = [r for r in csv.reader(f) if r]\n    header = rows[0]\n    data = rows[1:]\n    ncols = len(header); nrows = len(data)\n    cols = []\n    for j in range(ncols):\n        colvals = [data[i][j] for i in range(nrows)]\n        t = infer_type(colvals)\n        cols.append((header[j], t, colvals))\n\n    out = bytearray(); out += b'PAR1'\n    row_group_columns = []; total_byte_size = 0\n    for (name, t, colvals) in cols:\n        page_data = encode_plain(colvals, t)\n        data_page_header = [(1, I32, nrows), (2, I32, ENC_PLAIN), (3, I32, ENC_RLE), (4, I32, ENC_RLE)]\n        page_header = [(1, I32, PAGE_DATA_PAGE), (2, I32, len(page_data)), (3, I32, len(page_data)), (5, STRUCT, data_page_header)]\n        ph = bytearray(); write_struct(ph, page_header)\n        page = bytes(ph) + page_data\n        data_pa"]
[153.251553, "i", "ge_offset = len(out)\n        out += page\n        chunk_size = len(page); total_byte_size += chunk_size\n        col_meta = [(1, I32, t), (2, LIST, (I32, [ENC_RLE, ENC_PLAIN])), (3, LIST, (BINARY, [name])),\n                    (4, I32, CODEC_UNCOMPRESSED), (5, I32, nrows), (6, I64, chunk_size),\n                    (7, I64, chunk_size), (9, I64, data_page_offset)]\n        row_group_columns.append([(2, I64, data_page_offset), (3, STRUCT, col_meta)])\n\n    schema = [[(1, BINARY, 'schema'), (4, I32, REP_REQUIRED), (5, I32, ncols)]]\n    for (name, t, colvals) in cols:\n        f = [(1, BINARY, name), (2, I32, t), (4, I32, REP_REQUIRED), (5, I32, 0)]\n        if t == PBYTE_ARRAY:\n            f.append((6, I32, CONVERTED_UTF8))\n        schema.append(f)\n\n    row_group = [(1, LIST, (STRUCT, row_group_columns)), (2, I64, total_byte_size), (3, I32, nrows)]\n    file_meta = [(1, I32, 1), (2, LIST, (STRUCT, schema)), (3, I64, nrows),\n                 (4, LIST, (STRUCT, [row_group])), (5, BINARY, 'minimal-parquet-writer/1.0')]\n\n    footer = bytearray(); write_struct(footer, file_meta)\n    footer_bytes = bytes(footer)\n    out += footer_bytes\n    out += struct.pack('<I', len(footer_bytes))\n    out += b'PAR1'\n    with open('/app/data.parquet', 'wb') as f:\n        f.write(out)\n    print('wrote', len(out), 'bytes')\n\nmain()\nPYEOF\n"]
