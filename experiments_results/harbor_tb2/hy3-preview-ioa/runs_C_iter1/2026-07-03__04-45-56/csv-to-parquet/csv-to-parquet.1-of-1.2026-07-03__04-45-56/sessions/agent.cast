[271.536251, "o", "        off = len(out); out += page; cs = len(page); total += cs\r\n\u001b[?2004l\r"]
[271.536626, "o", "\u001b[?2004h>         meta = [(1, I32, t), (2, LIST, (I32, [ENC_RLE, ENC_PLAIN])),\r\n\u001b[?2004l\r"]
[271.536738, "o", "\u001b[?2004h> "]
[271.537714, "o", "                (3, LIST, (BINARY, [name])), (4, I32, CODEC_UNCOMPRESSED),\r\n\u001b[?2004l\r"]
[271.537896, "o", "\u001b[?2004h>                 (5, I64, nrows), (6, I64, cs), (7, I64, cs), (8, I64, off)]\r\n\u001b[?2004l\r\u001b[?2004h>         rg_cols.append([(2, I64, off), (3, STRUCT, meta)])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     schema = [[(4, BINARY, 'schema'), (5, I32, ncols)]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.538124, "o", "    for (name, t, colvals) in cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.538639, "o", "        fld = [(1, I32, t), (3, I32, REP_REQUIRED), (4, BINARY, name)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.538888, "o", "        if t == PBYTE_ARRAY: fld.append((6, I32, CONVERTED_UTF8))\r\n\u001b[?2004l\r\u001b[?2004h>         schema.append(fld)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.539115, "o", "    row_group = [(1, LIST, (STRUCT, rg_cols)), (2, I64, total), (3, I32, nrows)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.539343, "o", "    fm = [(1, I32, 1), (2, LIST, (STRUCT, schema)), (3, I64, nrows),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.539585, "o", "          (4, LIST, (STRUCT, [row_group])), (5, BINARY, 'minimal-parquet-writer/1.0')]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.539877, "o", "    footer = bytearray(); write_struct(footer, fm); fb = bytes(footer)\r\n\u001b[?2004l\r\u001b[?2004h>     out += fb; out += struct.pack('<I', len(fb)); out += b'PAR1'\r\n\u001b[?2004l\r\u001b[?2004h> "]
