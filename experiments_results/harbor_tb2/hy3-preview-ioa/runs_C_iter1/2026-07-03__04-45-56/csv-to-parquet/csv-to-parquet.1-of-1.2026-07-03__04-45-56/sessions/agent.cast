[271.534832, "o", "\u001b[?2004h> "]
[271.535216, "o", "                          (3, I32, len(page_data)), (5, STRUCT, dph)])"]
[271.535262, "o", "\r\n"]
[271.535288, "o", "\u001b[?2004l\r"]
