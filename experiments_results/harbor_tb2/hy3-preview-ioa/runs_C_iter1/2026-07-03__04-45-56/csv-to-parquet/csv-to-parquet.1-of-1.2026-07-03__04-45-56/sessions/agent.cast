[271.533645, "o", "> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.533765, "o", "    with open('/app/data.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         rows = [r for r in csv.reader(f) if r]\r\n\u001b[?2004l\r\u001b[?2004h>     header = rows[0]; data = rows[1:]\r\n\u001b[?2004l\r\u001b[?2004h>     ncols = len(header); nrows = len(data)\r\n\u001b[?2004l\r\u001b[?2004h>     cols = [(header[j], infer_type([data[i][j] for i in range(nrows)]),\r\n\u001b[?2004l\r\u001b[?2004h>              [data[i][j] for i in range(nrows)]) for j in range(ncols)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     out = bytearray(); out += b'PAR1'\r\n\u001b[?2004l\r\u001b[?2004h>     rg_cols = []; total = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for (name, t, colvals) in cols:\r\n\u001b[?2004l\r\u001b[?2004h>         page_data = encode_plain(colvals, t)\r\n\u001b[?2004l\r\u001b[?2004h>         dph = [(1, I32, nrows), (2, I32, ENC_PLAIN), (3, I32, ENC_RLE), (4, I32, ENC_RLE)]"]
[271.534102, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[271.53442, "o", "        ph = bytearray()\r\n\u001b[?2004l\r\u001b[?2004h> "]
