[610.703788, "i", "cd /app && cat > diag2.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\ns=80\ndef stat(r,c):\n    sq=a[r*s:(r+1)*s, c*s:(c+1)*s]\n    corners=np.concatenate([sq[5:15,5:15].reshape(-1,3),sq[65:75,65:75].reshape(-1,3),sq[5:15,65:75].reshape(-1,3),sq[65:75,5:15].reshape(-1,3)])\n    bg=corners.mean(0)\n    cen=sq[10:70,10:70].reshape(-1,3)\n    diff=np.abs(cen-bg).sum(1)\n    frac=(diff>60).mean()\n    bright=(cen.sum(1)>600).sum()\n    dark=(cen.sum(1)<250).sum()\n    return frac, bright, dark\nfor (r,c) in [(0,0),(0,3),(2,6)]:\n    f,b,d=stat(r,c)\n    print(chr(ord('a')+c)+str(8-r),'frac %.3f'%f,'bright',b,'dark',d,'->', 'W' if b>d else 'B')\n# ascii of d8 (detected B)\nr,c=0,3\nsq=a[r*s:(r+1)*s, c*s:(c+1)*s]\nprint('ASCII d8')\nfor y in range(0,80,4):\n    line=''\n    for x in range(0,80,4):\n        v=sq[y,x].sum()\n        line+= '#' if v<200 else ('+' if v<500 else ('.' if v<650 else ' '))\n    print(line)\nEOF\npython3 diag2.py\n"]
[610.707093, "o", "cd /app && cat > diag2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image"]
