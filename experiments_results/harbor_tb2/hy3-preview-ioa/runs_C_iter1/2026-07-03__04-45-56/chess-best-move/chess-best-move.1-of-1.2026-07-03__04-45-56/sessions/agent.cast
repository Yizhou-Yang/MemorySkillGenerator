[569.495511, "i", "('a')+c)+str(8-r), piece_color[(r,c)])\nprint('total occupied', len(occ))\n# ascii art of first occupied square\nr,c=occ[0]\nprint('ASCII of', chr(ord('a')+c)+str(8-r))\nsq=a[r*s:(r+1)*s, c*s:(c+1)*s]\nfor y in range(0,80,4):\n    line=''\n    for x in range(0,80,4):\n        v=sq[y,x].sum()\n        line+= '#' if v<200 else ('+' if v<500 else ('.' if v<650 else ' '))\n    print(line)\nEOF\npython3 diag.py\n"]
