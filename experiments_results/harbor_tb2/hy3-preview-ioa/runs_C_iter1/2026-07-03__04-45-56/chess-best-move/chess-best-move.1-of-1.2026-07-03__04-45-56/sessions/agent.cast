[518.350417, "i", "cd /app && python3 << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('chess_puzzle.png').convert('RGB')\na = np.array(im)\nprint('shape', a.shape)\nprint('unique colors count', len(np.unique(a.reshape(-1,3),axis=0)))\n# sample corner squares\ns=80\nfor (r,c) in [(0,0),(0,1),(7,0),(7,7)]:\n    sq = a[r*s:(r+1)*s, c*s:(c+1)*s]\n    print(r,c,'mean',sq.reshape(-1,3).mean(0).astype(int),'min',sq.reshape(-1,3).min(0),'max',sq.reshape(-1,3).max(0))\nEOF\n"]
[518.351261, "o", "cd /app && python3 << 'EOF'\r\n"]
