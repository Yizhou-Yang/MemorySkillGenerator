[49.500765, "i", "cat > /app/check_cert.py << 'EOF'\n#!/usr/bin/env python3\nimport os\nimport re\nimport ssl\nimport subprocess\n\nCERT_PATH = \"/app/ssl/server.crt\"\nKEY_PATH = \"/app/ssl/server.key\"\n\n\ndef to_ymd(raw):\n    raw = raw.strip()\n    m = re.match(r\"(\\d{4})-(\\d{2})-(\\d{2})\", raw)\n    if m:\n        return m.group(0)\n    m = re.match(r\"(\\d{4})(\\d{2})(\\d{2})\", raw)\n    if m:\n        return \"%s-%s-%s\" % (m.group(1), m.group(2), m.group(3))\n    return raw\n\n\ndef main():\n    if not os.path.exists(CERT_PATH):\n        raise FileNotFoundError(\"Certificate not found: %s\" % CERT_PATH)\n\n    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\n    ctx.load_cert_chain(CERT_PATH, KEY_PATH)\n\n    subject = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\"],\n        capture_output=True, text=True, check=True,\n    ).stdout.strip()\n\n    dates = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-dates\", \"-dateopt\", \"iso_8601\"],\n        capture_output="]
[49.50091, "o", "cat > /app/check_cert.py << 'EOF'\r\n#!/usr/bin/env python3\r\nimport os\r\nimport re\r\nimport ssl\r\nimport subprocess\r\n\r\nCERT_PATH = \"/app/ssl/server.crt\"\r\nKEY_PATH = \"/app/ssl/server.key\"\r\n\r\n\r\ndef to_ymd(raw):\r\n    raw = raw.strip()\r\n    m = re.match(r\"(\\d{4})-(\\d{2})-(\\d{2})\", raw)\r\n    if m:\r\n        return m.group(0)\r\n    m = re.match(r\"(\\d{4})(\\d{2})(\\d{2})\", raw)\r\n    if m:\r\n        return \"%s-%s-%s\" % (m.group(1), m.group(2), m.group(3))\r\n    return raw\r\n\r\n\r\ndef main():\r\n    if not os.path.exists(CERT_PATH):\r\n        raise FileNotFoundError(\"Certificate not found: %s\" % CERT_PATH)\r\n\r\n    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\r\n    ctx.load_cert_chain(CERT_PATH, KEY_PATH)\r\n\r\n    subject = subprocess.run(\r\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\"],\r\n        capture_output=True, text=True, check=True,\r\n    ).stdout.strip()\r\n\r\n    dates = subprocess.run(\r\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-dates\", \"-dateopt\", \"iso_8601\"],\r\n        capture_output="]
[49.501299, "i", "True, text=True, check=True,\n    ).stdout.strip()\n\n    cn = \"unknown\"\n    body = subject.replace(\"subject=\", \"\").strip()\n    for part in body.split(\",\"):\n        k, _, v = part.partition(\"=\")\n        if k.strip() == \"CN\":\n            cn = v.strip()\n\n    expiration = \"\"\n    for line in dates.splitlines():\n        if line.startswith(\"notAfter=\"):\n            expiration = to_ymd(line.split(\"=\", 1)[1])\n\n    print(subject)\n    print(dates)\n    print(\"Common Name: %s\" % cn)\n    print(\"Expiration date: %s\" % expiration)\n\n    print(\"Certificate verification successful\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[49.501355, "o", "True, text=True, check=True,\r\n    ).stdout.strip()\r\n\r\n    cn = \"unknown\"\r\n    body = subject.replace(\"subject=\", \"\").strip()\r\n    for part in body.split(\",\"):\r\n        k, _, v = part.partition(\"=\")\r\n        if k.strip() == \"CN\":\r\n            cn = v.strip()\r\n\r\n    expiration = \"\"\r\n    for line in dates.splitlines():\r\n        if line.startswith(\"notAfter=\"):\r\n            expiration = to_ymd(line.split(\"=\", 1)[1])\r\n\r\n    print(subject)\r\n    print(dates)\r\n    print(\"Common Name: %s\" % cn)\r\n    print(\"Expiration date: %s\" % expiration)\r\n\r\n    print(\"Certificate verification successful\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nEOF\r\n"]
