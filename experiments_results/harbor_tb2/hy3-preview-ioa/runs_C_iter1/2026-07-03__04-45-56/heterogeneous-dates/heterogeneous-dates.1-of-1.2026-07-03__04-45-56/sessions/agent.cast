[348.162761, "i", "python3 - <<'PYEOF'\nimport csv, re\n\ndef norm(s):\n    s = s.split()[0]\n    p = re.split(r'[/-]', s)\n    a, b, c = [int(x) for x in p]\n    if a > 31:        # first part is year\n        return (a, b, c)\n    return (c, a, b)  # month, day, year\n\nhigh = {}\nwith open('/app/daily_temp_sf_high.csv') as f:\n    r = csv.reader(f); next(r)\n    for row in r:\n        if row:\n            high[norm(row[0])] = float(row[1])\n\nlow = {}\nwith open('/app/daily_temp_sf_low.csv') as f:\n    r = csv.reader(f); next(r)\n    for row in r:\n        if row:\n            low[norm(row[0])] = float(row[1])\n\ndiffs = [high[k] - low[k] for k in high if k in low]\nprint('matched days:', len(diffs))\nprint('high keys:', len(high), 'low keys:', len(low))\navg = sum(diffs) / len(diffs)\nwith open('/app/avg_temp.txt', 'w') as f:\n    f.write(str(avg))\nprint('avg diff:', avg)\nPYEOF\n"]
