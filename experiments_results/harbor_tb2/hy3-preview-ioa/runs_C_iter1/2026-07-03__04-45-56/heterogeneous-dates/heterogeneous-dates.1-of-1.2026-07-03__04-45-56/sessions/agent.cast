[336.143337, "i", "python3 - <<'PYEOF'\nimport csv, re\n\ndef norm(s):\n    s = s.split()[0]\n    m, d, y = [int(x) for x in re.split(r'[/-]', s)]\n    return (y, m, d)\n\nhigh = {}\nwith open('/app/daily_temp_sf_high.csv') as f:\n    r = csv.reader(f)\n    next(r)\n    for row in r:\n        if not row:\n            continue\n        high[norm(row[0])] = float(row[1])\n\nlow = {}\nwith open('/app/daily_temp_sf_low.csv') as f:\n    r = csv.reader(f)\n    next(r)\n    for row in r:\n        if not row:\n            continue\n        low[norm(row[0])] = float(row[1])\n\ndiffs = [high[k] - low[k] for k in high if k in low]\navg = sum(diffs) / len(diffs)\nwith open('/app/avg_temp.txt', 'w') as f:\n    f.write(str(avg))\nprint('matched days:', len(diffs))\nprint('avg diff:', avg)\nPYEOF\n"]
