[18.29566, "i", "cat > /app/scraper.py << 'EOF'\nimport re\nimport requests\nfrom bs4 import BeautifulSoup\nimport pandas as pd\n\nURL = \"http://server:8000\"\n\n\ndef parse_book(b):\n    title = b.find(\"div\", class_=\"book-title\").get_text(strip=True)\n    author = b.find(\"div\", class_=\"book-author\").get_text(strip=True)\n    author = re.sub(r\"(?i)^\\s*by\\s+\", \"\", author).strip()\n    year_txt = b.find(\"span\", class_=\"book-year\").get_text(strip=True)\n    rating_txt = b.find(\"span\", class_=\"book-rating\").get_text(strip=True)\n    price_txt = b.find(\"span\", class_=\"book-price\").get_text(strip=True)\n    year = int(re.search(r\"(\\d+)\", year_txt).group(1))\n    rating = float(re.search(r\"([\\d.]+)\", rating_txt).group(1))\n    price = float(re.search(r\"\\$?([\\d.]+)\", price_txt).group(1))\n    return {\n        \"title\": title,\n        \"author\": author,\n        \"year\": year,\n        \"rating\": rating,\n        \"price\": price,\n    }\n\n\ndef main():\n    resp = requests.get(URL, timeout=10)\n    resp.raise_for_status"]
[18.296159, "o", "cat > /app/scraper.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[18.296224, "i", "()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n    books = [parse_book(b) for b in soup.find_all(\"div\", class_=\"book\")]\n\n    df = pd.DataFrame(books, columns=[\"title\", \"author\", \"year\", \"rating\", \"price\"])\n    df.to_csv(\"books.csv\", index=False)\n\n    total = len(df)\n    avg_price = df[\"price\"].mean()\n    highest = df.loc[df[\"rating\"].idxmax()]\n\n    with open(\"report.txt\", \"w\") as f:\n        f.write(f\"Total number of books scraped: {total}\\n\")\n        f.write(f\"Average book price: ${avg_price:.2f}\\n\")\n        f.write(f\"Highest rated book: {highest['title']} by {highest['author']} (Rating: {highest['rating']}/5)\\n\")\n\n    print(df.head())\n    print(\"Total:\", total, \"Avg price: %.2f\" % avg_price)\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
