[244.705312, "i", "cat > /app/run-alpine.sh << 'EOF'\n#!/bin/bash\nexec qemu-system-x86_64 \\\n  -m 1024 \\\n  -smp 2 \\\n  -kernel /tmp/vmlinuz-lts \\\n  -initrd /tmp/intel-ucode.img,/tmp/amd-ucode.img,/tmp/initramfs-lts \\\n  -append \"console=ttyS0,115200 modules=loop,squashfs,sd-mod,usb-storage quiet\" \\\n  -cdrom /app/alpine.iso \\\n  -serial telnet:127.0.0.1:6665,server,nowait \\\n  -display none \\\n  -daemonize\nEOF\n"]
