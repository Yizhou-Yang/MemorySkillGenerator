[165.172753, "o", "\u001b[?2004hroot@7fa4dd3267d3:/app# "]
[172.598321, "i", "python3 /tmp/iso.py cat /boot/syslinux/SYSLINUX.CFG; echo; echo '---GRUB---'; python3 /tmp/iso.py cat /boot/grub/GRUB.CFG; echo\n"]
[172.598655, "o", "python3 /tmp/iso.py cat /boot/syslinux/SYSLINUX.CFG; echo; echo '---GRUB---'; python3 /tmp/iso.py cat /boot/grub/GRUB.CFG; echo\r\n\u001b[?2004l\r"]
[172.630628, "o", "TIMEOUT 10"]
[172.630802, "o", "\r\nPROMPT 1\r\nDEFAULT lts\r\n\r\nLABEL lts\r\nMENU LABEL Linux lts\r\nKERNEL /boot/vmlinuz-lts\r\n"]
[172.630946, "o", "INITRD /boot/intel-ucode.img,/boot/amd-ucode.img,/boot/initramfs-lts\r\nFDTDIR /boot/dtbs-lts\r\nAPPEND modules=loop,squashfs,sd-mod,usb-storage quiet \r\n"]
[172.634031, "o", "\r\n---GRUB---\r\n"]
[172.656893, "o", "set timeout=1\r\n\r\nmenuentry \"Linux lts\" {\r\nlinux\t/boot/vmlinuz-lts modules=loop,squashfs,sd-mod,usb-storage quiet \r\ninitrd\t/boot/intel-ucode.img /boot/amd-ucode.img /boot/initramfs-lts\r\n}\r\n"]
