[298.300146, "i", "cat > /tmp/probe.py << 'PYEOF'\nimport socket, time, sys\n\nPORT=6665\nend=time.time()+240\nlast=0\nwhile time.time()<end:\n    try:\n        s=socket.socket()\n        s.settimeout(6)\n        s.connect(('127.0.0.1',PORT))\n        buf=b''\n        # send CRLF to coax a fresh prompt\n        s.sendall(b'\\r\\n')\n        t0=time.time()\n        while time.time()-t0<6:\n            try:\n                d=s.recv(4096)\n            except socket.timeout:\n                break\n            if not d: break\n            buf+=d\n            if b'login' in buf.lower():\n                print('LOGIN_PROMPT_RECEIVED')\n                print(buf.decode('latin1','replace')[-600:])\n                s.close()\n                sys.exit(0)\n        s.close()\n    except Exception as e:\n        pass\n    time.sleep(2)\nprint('TIMEOUT_NO_PROMPT')\nsys.exit(1)\nPYEOF\n"]
