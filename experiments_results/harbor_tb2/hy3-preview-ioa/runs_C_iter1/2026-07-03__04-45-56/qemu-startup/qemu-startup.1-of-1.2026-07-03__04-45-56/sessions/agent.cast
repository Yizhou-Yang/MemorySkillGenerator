[129.503804, "i", "cat > /tmp/iso.py << 'PYEOF'\nimport sys\n\nISO='/app/alpine.iso'\nSECTOR=2048\n\ndef read_at(f,lba,size):\n    f.seek(lba*SECTOR)\n    return f.read(size)\n\ndef parse_record(data,off):\n    length=data[off]\n    if length<33: return None\n    name_len=data[off+32]\n    name=data[off+33:off+33+name_len].split(b';')[0].decode('latin1')\n    ext_lba=int.from_bytes(data[off+2:off+6],'little')\n    size=int.from_bytes(data[off+10:off+14],'little')\n    is_dir=bool(data[off+25]&2)\n    return {'name':name,'lba':ext_lba,'size':size,'is_dir':is_dir}\n\ndef list_dir(f,lba,size):\n    data=read_at(f,lba,size)\n    entries=[]; off=0\n    while off<len(data):\n        length=data[off]\n        if length==0:\n            off=(off//SECTOR+1)*SECTOR\n            continue\n        rec=parse_record(data,off)\n        if rec: entries.append(rec)\n        off+=length\n    return entries\n\ndef root_dir(f):\n    pvd=read_at(f,16,SECTOR)\n    return parse_record(pvd,156)\n\ndef find(f,path):\n    parts=[p for p in pat"]
[129.504054, "o", "cat > /tmp/iso.py << 'PYEOF'"]
[129.504304, "o", "\r\n\u001b[?2004l\r"]
[129.504477, "i", "h.split('/') if p]\n    cur=root_dir(f)\n    for part in parts:\n        if not cur['is_dir']:\n            raise NotADirectoryError(cur['name'])\n        entries=list_dir(f,cur['lba'],cur['size'])\n        nxt=None\n        for e in entries:\n            if e['name'].lower()==part.lower():\n                nxt=e; break\n        if nxt is None:\n            raise FileNotFoundError('not found: '+part)\n        cur=nxt\n    return cur\n\ndef main():\n    f=open(ISO,'rb')\n    cmd=sys.argv[1]\n    if cmd=='list':\n        rec=find(f,sys.argv[2])\n        for e in list_dir(f,rec['lba'],rec['size']):\n            print(('D' if e['is_dir'] else 'F'), e['name'], e['lba'], e['size'])\n    elif cmd=='cat':\n        rec=find(f,sys.argv[2])\n        data=read_at(f,rec['lba'],rec['size'])\n        sys.stdout.buffer.write(data)\n    elif cmd=='extract':\n        rec=find(f,sys.argv[2])\n        data=read_at(f,rec['lba'],rec['size'])\n        with open(sys.argv[3],'wb') as o:\n            o.write(data)\n        print('wrote',sys.argv[3],rec['size'])\n\nma"]
