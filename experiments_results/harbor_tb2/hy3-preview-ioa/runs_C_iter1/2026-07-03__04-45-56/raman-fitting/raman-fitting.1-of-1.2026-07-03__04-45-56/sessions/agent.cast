[227.508223, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\n# --- Load data (comma decimal separator, two whitespace-separated columns) ---\nxs, ys = [], []\nwith open('/app/graphene.dat') as fh:\n    for line in fh:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.split()\n        if len(parts) < 2:\n            continue\n        xs.append(float(parts[0].replace(',', '.')))\n        ys.append(float(parts[1].replace(',', '.')))\nx = np.array(xs)\ny = np.array(ys)\n\n# --- Lorentzian model: offset + amplitude / (1 + ((x - x0)/gamma)^2) ---\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude / (1.0 + ((x - x0) / gamma) ** 2)\n\ndef fit_peak(x0_guess, half_width, x_data, y_data):\n    \"\"\"Fit a Lorentzian to a window around x0_guess.\"\"\"\n    m = (x_data > x0_guess - half_width) & (x_data < x0_guess + half_width)\n    xw, yw = x_data[m], y_data[m]\n    # robust background estimate"]
[227.509449, "o", "cat > /app/fit.py << 'EOF'"]
[227.510025, "o", "\r\n\u001b[?2004l\r"]
[227.510746, "o", "\u001b[?2004h"]
[227.511318, "o", "> "]
[227.512423, "o", "import json"]
[227.516872, "o", "\r\n\u001b[?2004l\r"]
[227.518755, "o", "\u001b[?2004h> "]
[227.520025, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[227.520134, "o", "\u001b[?2004h"]
[227.520421, "o", "> "]
[227.521069, "o", "from scipy.optimize import curve_fit"]
[227.521263, "o", "\r\n"]
[227.521342, "o", "\u001b[?2004l\r"]
[227.521452, "o", "\u001b[?2004h"]
[227.52183, "o", "> "]
[227.521971, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.522242, "o", "> "]
[227.522304, "o", "# --- Load data (comma decimal separator, two whitespace-separated columns) ---"]
[227.522467, "o", "\r\n"]
[227.522799, "i", " from the wings of the window\n    edge = (xw - x0_guess)\n    wing = (np.abs(edge) > 0.6 * half_width)\n    offset0 = np.median(yw[wing]) if wing.any() else np.median(yw)\n    amplitude0 = yw.max() - offset0\n    gamma0 = half_width * 0.15\n    p0 = [x0_guess, max(gamma0, 1.0), amplitude0, offset0]\n    bounds = ([x0_guess - half_width, 1e-3, 0.0, -np.inf],\n              [x0_guess + half_width, half_width, np.inf, np.inf])\n    popt, _ = curve_fit(lorentzian, xw, yw, p0=p0, bounds=bounds, maxfev=100000)\n    resid = yw - lorentzian(xw, *popt)\n    rms = float(np.sqrt(np.mean(resid ** 2)))\n    return popt, rms, xw, yw\n\n# G peak: x0 ~ 19139\ng_popt, g_rms, gx, gy = fit_peak(19139.0, 700.0, x, y)\n# 2D peak: x0 ~ 33245\nd_popt, d_rms, dx, dy = fit_peak(33245.0, 2500.0, x, y)\n\nG = {'x0': float(g_popt[0]), 'gamma': float(abs(g_popt[1])),\n     'amplitude': float(g_popt[2]), 'offset': float(g_popt[3])}\nD2 = {'x0': float(d_popt[0]), 'gamma': float(abs(d_popt[1])),\n      'amplitude': float(d_popt[2]), 'offset': float(d_popt[3])}\n"]
[227.523376, "i", "\nresults = {'G': G, '2D': D2}\n\n# --- I/O side effect: write the output file (required deliverable) ---\nwith open('/app/results.json', 'w') as out:\n    json.dump(results, out, indent=2)\n\nprint('Fit RMS  -> G: %.2f, 2D: %.2f' % (g_rms, d_rms))\nprint(json.dumps(results, indent=2))\nEOF\npython3 /app/fit.py\n"]
