[477.586286, "i", "cat > /tmp/exp.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\ndef lor(x,x0,g,a,o): return o+a/(1+((x-x0)/g)**2)\n\nfor name,c,hw in [('G',19139.0,1800.0),('2D',33245.0,2500.0)]:\n    m=(x>c-hw)&(x<c+hw)\n    xw,yw=x[m],y[m]\n    if name=='G':\n        p0=[c,150.0,60000.0,20000.0]\n        b=([c-600,50,0,10000],[c+600,400,200000,40000])\n    else:\n        p0=[c,1500.0,4000.0,21000.0]\n        b=([c-1000,200,0,10000],[c+1000,4000,100000,40000])\n    popt,_=curve_fit(lor,xw,yw,p0=p0,bounds=b,maxfev=200000)\n    rms=np.sqrt(np.mean((yw-lor(xw,*popt))**2))\n    print('%s: x0=%.2f gamma=%.2f amp=%.2f off=%.2f rms=%.2f'%(name,popt[0],abs(popt[1]),popt[2],popt[3],rms))\nEOF\npython3 /tmp/exp.py\n"]
