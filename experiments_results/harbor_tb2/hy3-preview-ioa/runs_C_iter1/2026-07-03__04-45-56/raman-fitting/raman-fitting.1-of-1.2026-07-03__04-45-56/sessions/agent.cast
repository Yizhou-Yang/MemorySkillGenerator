[49.039374, "i", "cat > /tmp/explore.py << 'EOF'\nimport numpy as np\ndata = []\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    parts = line.split()\n    if len(parts)<2: continue\n    x = float(parts[0].replace(',','.'))\n    y = float(parts[1].replace(',','.'))\n    data.append((x,y))\ndata = np.array(data)\nx = data[:,0]; y = data[:,1]\nprint('shapes', x.shape, y.shape)\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\n# find peaks via simple diff\nfrom scipy.signal import find_peaks\n# smooth\nys = y\npk, props = find_peaks(ys, distance=20, prominence=50)\nprint('num peaks', len(pk))\nfor i in pk[:20]:\n    print('peak x=%.2f y=%.2f' % (x[i], y[i]))\nEOF\npython3 /tmp/explore.py\n"]
