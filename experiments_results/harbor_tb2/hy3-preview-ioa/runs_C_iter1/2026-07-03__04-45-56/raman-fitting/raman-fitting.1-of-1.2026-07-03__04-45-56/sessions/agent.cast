[197.248998, "i", "cat > /tmp/explore4.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\nm=(x>27000)&(x<34500)\nxx=x[m]; yy=y[m]\npk,props=find_peaks(yy, distance=10, prominence=100)\nprint('2D region peaks:')\nfor j,i in enumerate(pk):\n    print('  x=%.2f y=%.2f prom=%.2f'%(xx[i],yy[i],props['prominences'][j]))\nprint('global max in region x=%.2f y=%.2f'%(xx[np.argmax(yy)], yy.max()))\nprint('number of peaks', len(pk))\nEOF\npython3 /tmp/explore4.py\n"]
[197.249559, "o", "cat > /tmp/explore4.py << 'EOF'"]
