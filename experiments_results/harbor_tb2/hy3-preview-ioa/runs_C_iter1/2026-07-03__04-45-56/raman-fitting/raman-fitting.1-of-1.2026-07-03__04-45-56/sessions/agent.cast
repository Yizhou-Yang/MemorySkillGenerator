[619.656988, "i", "cat > /tmp/wincmp.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\ndef lor(x,x0,g,a,o): return o+a/(1+((x-x0)/g)**2)\nfor hw in (600,800,1000,1200,1500,2000):\n    c=19139.0\n    m=(x>c-hw)&(x<c+hw); xw,yw=x[m],y[m]\n    base=np.median(yw[np.abs(xw-c)>0.6*hw])\n    best=None\n    for g0 in [hw*0.05,hw*0.1,hw*0.2]:\n      for a0 in [max(yw.max()-base,1)*f for f in (0.7,1.0,1.3)]:\n        for o0 in [base*f for f in (0.7,1.0,1.3)]:\n          try:\n            popt,_=curve_fit(lor,xw,yw,p0=[c,g0,a0,o0],maxfev=200000)\n            rms=np.sqrt(np.mean((yw-lor(xw,*popt))**2))\n            if best is None or rms<best[0]: best=(rms,popt)\n          except Exception: pass\n    rms,popt=best\n    print('hw=%4d  x0=%.1f g=%.1f amp=%.1f off=%.1f rms=%.1f'%(h"]
[619.65742, "i", "w,popt[0],abs(popt[1]),popt[2],popt[3],rms))\nEOF\npython3 /tmp/wincmp.py\n"]
