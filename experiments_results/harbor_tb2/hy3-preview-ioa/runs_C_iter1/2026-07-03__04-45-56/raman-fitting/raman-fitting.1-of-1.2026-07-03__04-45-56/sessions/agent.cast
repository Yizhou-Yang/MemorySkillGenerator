[595.970319, "i", "cat > /app/fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\n# --- Load data: whitespace-separated, comma decimal separator ---\nxs, ys = [], []\nwith open('/app/graphene.dat') as fh:\n    for line in fh:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.split()\n        if len(parts) < 2:\n            continue\n        xs.append(float(parts[0].replace(',', '.')))\n        ys.append(float(parts[1].replace(',', '.')))\nx = np.array(xs)\ny = np.array(ys)\n\n# Lorentzian: offset + amplitude / (1 + ((x - x0)/gamma)^2)\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude / (1.0 + ((x - x0) / gamma) ** 2)\n\n\ndef fit_peak(x0_guess, half_width):\n    \"\"\"Multi-start least-squares fit of a 4-parameter Lorentzian.\"\"\"\n    m = (x > x0_guess - half_width) & (x < x0_guess + half_width)\n    xw, yw = x[m], y[m]\n    baseline = np.median(yw[(np.abs(xw - x0_guess) > 0.6 * half_width)])\n    best"]
[595.971117, "o", "cat > /app/fit.py << 'EOF'"]
[595.971179, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[595.971246, "o", "> "]
[595.971708, "o", "import json"]
[595.97179, "o", "\r\n"]
[595.971886, "o", "\u001b[?2004l\r\u001b[?2004h"]
[595.972104, "o", "> "]
[595.97216, "o", "import numpy as np"]
[595.97223, "o", "\r\n"]
[595.972408, "o", "\u001b[?2004l\r"]
[595.973075, "o", "\u001b[?2004h"]
[595.976005, "o", "> from scipy.optimize import curve_fit"]
[595.976441, "o", "\r\n"]
[595.976527, "o", "\u001b[?2004l\r"]
[595.976636, "o", "\u001b[?2004h"]
[595.976956, "o", "> "]
[595.977039, "o", "\r\n"]
[595.977249, "o", "\u001b[?2004l\r"]
[595.977327, "o", "\u001b[?2004h"]
[595.977562, "o", "> "]
[595.97791, "o", "# --- Load data: whitespace-separated, comma decimal separator ---"]
[595.978038, "o", "\r\n"]
[595.978115, "o", "\u001b[?2004l\r"]
[595.97852, "o", "\u001b[?2004h"]
[595.97861, "o", "> "]
[595.978738, "o", "xs, ys = [], []"]
[595.978892, "o", "\r\n"]
[595.978976, "i", " = None\n    g_grid = [half_width * f for f in (0.05, 0.1, 0.2, 0.4)]\n    a_grid = [max(yw.max() - baseline, 1.0) * f for f in (0.5, 1.0, 1.5)]\n    o_grid = [baseline * f for f in (0.5, 1.0, 1.5)]\n    for g0 in g_grid:\n        for a0 in a_grid:\n            for o0 in o_grid:\n                p0 = [x0_guess, g0, a0, o0]\n                try:\n                    popt, _ = curve_fit(lorentzian, xw, yw, p0=p0,\n                                        maxfev=200000)\n                    rms = float(np.sqrt(np.mean((yw - lorentzian(xw, *popt)) ** 2)))\n                    if best is None or rms < best[0]:\n                        best = (rms, popt)\n                except Exception:\n                    pass\n    rms, popt = best\n    return float(popt[0]), float(abs(popt[1])), float(popt[2]), float(popt[3]), rms\n\n\n# Fit G peak (x0 ~ 19139)\ng_x0, g_gamma, g_amp, g_off, g_rms = fit_peak(19139.0, 2500.0)\n# Fit 2D peak (x0 ~ 33245)\nd_x0, d_gamma, d_amp, d_off, d_rms = fit_peak(33245.0, 2500.0)\n\nresults = {\n    'G': {'x0': g_x0, '"]
[595.979272, "i", "gamma': g_gamma, 'amplitude': g_amp, 'offset': g_off},\n    '2D': {'x0': d_x0, 'gamma': d_gamma, 'amplitude': d_amp, 'offset': d_off},\n}\n\n# --- Deliverable: write the results file (required I/O side-effect) ---\nwith open('/app/results.json', 'w') as out:\n    json.dump(results, out, indent=2)\n\nprint('G  fit RMS = %.2f' % g_rms)\nprint('2D fit RMS = %.2f' % d_rms)\nprint(open('/app/results.json').read())\nEOF\npython3 /app/fit.py\n"]
