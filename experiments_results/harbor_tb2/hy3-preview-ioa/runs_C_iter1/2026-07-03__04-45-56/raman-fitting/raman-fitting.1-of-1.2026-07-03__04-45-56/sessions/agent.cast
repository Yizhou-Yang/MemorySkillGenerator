[401.844674, "i", "cat > /tmp/raw2.py << 'EOF'\nimport numpy as np\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\nprint('num points total', len(x))\nprint('spacing near G:')\nm=(x>18000)&(x<20000)\nxx=x[m]\nprint('  points in [18000,20000]:', m.sum(), 'approx spacing', (xx.max()-xx.min())/max(m.sum()-1,1))\nprint('Full G region data [17500,20500]:')\nm=(x>17500)&(x<20500)\nxx=x[m]; yy=y[m]\nii=np.argsort(xx)\nfor a,b in zip(xx[ii],yy[ii]):\n    print('  %8.2f  %8.2f'%(a,b))\nEOF\npython3 /tmp/raw2.py\n"]
