[522.025115, "i", "cat > /tmp/grid.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\ndef lor(x,x0,g,a,o): return o+a/(1+((x-x0)/g)**2)\n\nfor name,c,hw in [('G',19139.0,900.0),('2D',33245.0,2500.0)]:\n    m=(x>c-hw)&(x<c+hw)\n    xw,yw=x[m],y[m]\n    best=None\n    if name=='G':\n        x0s=[19139.0]; gs=[80,150,250,400,600]; amps=[40000,60000,80000]; offs=[15000,19000,22000]\n    else:\n        x0s=[33245.0]; gs=[800,1500,2500]; amps=[2000,4000,6000]; offs=[15000,19000,21000]\n    for x0 in x0s:\n      for g in gs:\n        for a in amps:\n          for o in offs:\n            try:\n                popt,_=curve_fit(lor,xw,yw,p0=[x0,g,a,o],maxfev=200000)\n                rms=np.sqrt(np.mean((yw-lor(xw,*popt))**2))\n     "]
[522.025824, "i", "           if best is None or rms<best[0]:\n                    best=(rms,popt)\n            except Exception:\n                pass\n    rms,popt=best\n    print('%s: x0=%.2f gamma=%.2f amp=%.2f off=%.2f rms=%.2f'%(name,popt[0],abs(popt[1]),popt[2],popt[3],rms))\nEOF\npython3 /tmp/grid.py\n"]
