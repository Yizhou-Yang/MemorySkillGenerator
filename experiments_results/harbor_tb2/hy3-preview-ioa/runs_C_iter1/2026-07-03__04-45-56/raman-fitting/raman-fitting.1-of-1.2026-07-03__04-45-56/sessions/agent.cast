[325.789372, "i", "cat > /tmp/raw.py << 'EOF'\nimport numpy as np\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\nfor c in (19139.0, 33245.0):\n    print('=== region around x=%.0f ===' % c)\n    m=(x>c-400)&(x<c+400)\n    xx=x[m]; yy=y[m]\n    ii=np.argsort(xx)  # ascending\n    for a,b in zip(xx[ii],yy[ii]):\n        print('  %8.2f  %8.2f'%(a,b))\nEOF\npython3 /tmp/raw.py\n"]
