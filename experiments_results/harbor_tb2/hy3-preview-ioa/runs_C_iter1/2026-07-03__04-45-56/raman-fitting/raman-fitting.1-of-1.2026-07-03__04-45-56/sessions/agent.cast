[299.132736, "i", "cat > /tmp/diag2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\ndef lor(x,x0,g,a,o): return o+a/(1+((x-x0)/g)**2)\nc=19139.0\nfor hw in (800,1200,1800,2500,3500):\n    m=(x>c-hw)&(x<c+hw)\n    xw,yw=x[m],y[m]\n    o0=np.median(yw[(np.abs(xw-c)>0.7*hw)])\n    a0=yw.max()-o0\n    p0=[c,hw*0.25,a0,o0]\n    try:\n        popt,_=curve_fit(lor,xw,yw,p0=p0,maxfev=200000)\n        rms=np.sqrt(np.mean((yw-lor(xw,*popt))**2))\n        print('hw=%5d  x0=%.1f g=%.1f amp=%.1f off=%.1f rms=%.1f'%(hw,popt[0],abs(popt[1]),popt[2],popt[3],rms))\n    except Exception as e:\n        print('hw=%5d failed: %s'%(hw,e))\nEOF\npython3 /tmp/diag2.py\n"]
[299.133379, "o", "cat > /tmp/diag2.py << 'EOF'"]
