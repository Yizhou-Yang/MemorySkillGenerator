[180.948772, "i", "cat > /tmp/explore4.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\nm=(x>27000)&(x<34500)\nxx=x[m]; yy=y[m]\npk,props=find_peaks(yy, distance=10, prominence=100)\nprint('2D region peaks:')\nfor i in pk:\n    print('  x=%.2f y=%.2f prom=%.2f'%(xx[i],yy[i],props['prominences'][i]))\nprint('global max in region x=%.2f y=%.2f'%(xx[np.argmax(yy)], yy.max()))\nEOF\npython3 /tmp/explore4.py\n"]
[180.951995, "o", "cat > /tmp/explore4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.signal import find_peaks\r\n\u001b[?2004l\r\u001b[?2004h> data=[]\r\n\u001b[?2004l\r\u001b[?2004h> for line in open('/app/graphene.dat'):\r\n\u001b[?2004l\r\u001b[?2004h>     line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if not line: continue\r\n\u001b[?2004l\r\u001b[?2004h>     p=line.split()\r\n\u001b[?2004l\r\u001b[?2004h>     if len(p)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>     data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\r\n\u001b[?2004l\r\u001b[?2004h> data=np.array(data)\r\n\u001b[?2004l\r\u001b[?2004h> x=data[:,0]; y=data[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> m=(x>27000)&(x<34500)\r\n\u001b[?2004l\r\u001b[?2004h> xx=x[m]; yy=y[m]\r\n\u001b[?2004l\r\u001b[?2004h> pk,props=find_peaks(yy, distance=10, prominence=100)\r\n\u001b[?2004l\r\u001b[?2004h> print('2D region peaks:')\r\n\u001b[?2004l\r\u001b[?2004h> for i in pk:\r\n\u001b[?2004l\r\u001b[?2004h>     print('  x=%.2f y=%.2f prom=%.2f'%(xx[i],yy[i],props['prominences'][i]))\r\n\u001b[?2004l\r\u001b[?2004h> print('global max in region x=%.2f y=%.2f'%(xx[np.argmax(yy)], yy.max()))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004"]
