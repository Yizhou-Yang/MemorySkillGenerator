[229.434802, "m", "Episode 10: 1 commands"]
[229.434802, "o", "\u001b[?2004hroot@2739e611cf42:/app# "]
[267.71048, "i", "cat > /tmp/diag.py << 'EOF'\nimport numpy as np\ndata=[]\nfor line in open('/app/graphene.dat'):\n    line=line.strip()\n    if not line: continue\n    p=line.split()\n    if len(p)<2: continue\n    data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\nfor c in (19139,):\n    m=(x>c-1500)&(x<c+1500)\n    xx=x[m]; yy=y[m]\n    print('G window edges:')\n    print('  low edge x=%.1f y=%.1f'%(xx[0],yy[0]))\n    print('  high edge x=%.1f y=%.1f'%(xx[-1],yy[-1]))\n    print('  max x=%.1f y=%.1f'%(xx[np.argmax(yy)], yy.max()))\nEOF\npython3 /tmp/diag.py\n"]
[267.710901, "o", "cat > /tmp/diag.py << 'EOF'"]
