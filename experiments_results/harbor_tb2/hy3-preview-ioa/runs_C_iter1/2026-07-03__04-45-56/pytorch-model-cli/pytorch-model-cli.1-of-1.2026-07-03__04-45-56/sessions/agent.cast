[315.463915, "i", "cat > /app/cli_tool.cpp << 'CPP'\n#include <cstdio>\n#include <cstdlib>\n#include <cstring>\n#include <cmath>\n#include \"cJSON.h\"\n#include \"lodepng.h\"\n\nstatic double* load_array(cJSON* arr, int* nout){\n    if(!cJSON_IsArray(arr)){ *nout=0; return NULL; }\n    int n=cJSON_GetArraySize(arr);\n    double* out=(double*)malloc(sizeof(double)*n);\n    for(int i=0;i<n;i++){\n        cJSON* e=cJSON_GetArrayItem(arr,i);\n        out[i]=e->valuedouble;\n    }\n    *nout=n;\n    return out;\n}\n\nint main(int argc, char** argv){\n    if(argc<3){\n        fprintf(stderr,\"usage: %s weights.json image.png\\n\", argv[0]);\n        return 1;\n    }\n    FILE* f=fopen(argv[1],\"rb\");\n    if(!f){ fprintf(stderr,\"cannot open weights\\n\"); return 1; }\n    fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET);\n    char* buf=(char*)malloc(sz+1);\n    if(fread(buf,1,sz,f)!=(size_t)sz){ fprintf(stderr,\"read fail\\n\"); return 1; }\n    buf[sz]=0; fclose(f);\n    cJSON* root=cJSON_Parse(buf);\n    if(!root){ fprintf(stderr,\"bad json\\n\"); return 1; }\n    cJSON"]
[315.463981, "i", "* shapes=cJSON_GetObjectItem(root,\"shapes\");\n    int IN=cJSON_GetObjectItem(shapes,\"in\")->valueint;\n    int HID=cJSON_GetObjectItem(shapes,\"hidden\")->valueint;\n    int OUT=cJSON_GetObjectItem(shapes,\"out\")->valueint;\n    cJSON* layers=cJSON_GetObjectItem(root,\"layers\");\n    int nl=cJSON_GetArraySize(layers);\n    double* W[16]; double* B[16]; int Wn[16];\n    for(int l=0;l<nl;l++){\n        cJSON* ly=cJSON_GetArrayItem(layers,l);\n        W[l]=load_array(cJSON_GetObjectItem(ly,\"W\"), &Wn[l]);\n        int dummy; B[l]=load_array(cJSON_GetObjectItem(ly,\"b\"), &dummy);\n    }\n    free(buf);\n\n    unsigned char* png=NULL; unsigned w=0,h=0;\n    unsigned err=lodepng_decode_file(&png,&w,&h,argv[2],LCT_GREY,8);\n    if(err){ fprintf(stderr,\"png err %s\\n\", lodepng_error_text(err)); return 1; }\n\n    double* x=(double*)calloc(IN,sizeof(double));\n    unsigned total=w*h;\n    for(int i=0;i<IN && (unsigned)i<total;i++) x[i]=png[i]/255.0;\n\n    double* cur=x; int cin=IN;\n    for(int l=0;l<nl;l++){\n        int outn = (l==0)?HID : (l==1?"]
[315.46399, "i", "HID : OUT);\n        double* nxt=(double*)malloc(sizeof(double)*outn);\n        for(int o=0;o<outn;o++){\n            double s=B[l][o];\n            int base=o*cin;\n            for(int i=0;i<cin;i++) s+=W[l][base+i]*cur[i];\n            if(l<nl-1) s = (s>0.0)?s:0.0;\n            nxt[o]=s;\n        }\n        if(cur!=x) free(cur);\n        cur=nxt; cin=outn;\n    }\n    int pred=0; double best=cur[0];\n    for(int o=1;o<OUT;o++) if(cur[o]>best){ best=cur[o]; pred=o; }\n    printf(\"%d\\n\", pred);\n    free(png);\n    return 0;\n}\nCPP\n"]
