[253.939042, "i", "cat > /tmp/convert.py << 'PYEOF'\nimport zipfile, struct, json\nz=zipfile.ZipFile('/app/model.pth')\ndef rd(n):\n    b=z.read(n)\n    return list(struct.unpack('<%df'% (len(b)//4), b))\nw0=rd('simple_mnist/data/0')  # 12544 = 16*784\nb0=rd('simple_mnist/data/1')  # 16\nw1=rd('simple_mnist/data/2')  # 256 = 16*16\nb1=rd('simple_mnist/data/3')  # 16\nw2=rd('simple_mnist/data/4')  # 160 = 10*16\nb2=rd('simple_mnist/data/5')  # 10\nprint('counts',len(w0),len(b0),len(w1),len(b1),len(w2),len(b2))\nimport sys\nsys.path.insert(0,'/tmp')\nimport decode as D\nW,H,ch,raw=D.read_png('/app/image.png')\n\ndef infer(x):\n    # layer1\n    h=[0.0]*16\n    for o in range(16):\n        s=b0[o]\n        base=o*784\n        for i in range(784):\n            s+=w0[base+i]*x[i]\n        h[o]=s if s>0 else 0.0\n    h2=[0.0]*16\n    for o in range(16):\n        s=b1[o]\n        base=o*16\n        for i in range(16):\n            s+=w1[base+i]*h[i]\n        h2[o]=s if s>0 else 0.0\n    out=[0.0]*10\n    for o in range(10):\n        s=b2[o]\n        base=o*16\n        for"]
[253.939102, "i", " i in range(16):\n            s+=w2[base+i]*h2[i]\n        out[o]=s\n    return out\n\nx=[raw[i]/255.0 for i in range(784)]\nout=infer(x)\nprint('norm /255 pred', out.index(max(out)), 'logits', [round(v,2) for v in out])\nmean,std=0.1307,0.3081\nx2=[(raw[i]/255.0-mean)/std for i in range(784)]\nout2=infer(x2)\nprint('norm mnist pred', out2.index(max(out2)), 'logits', [round(v,2) for v in out2])\n# plain 0..255\nx3=[float(raw[i]) for i in range(784)]\nout3=infer(x3)\nprint('plain pred', out3.index(max(out3)))\n\n# write weights.json\nobj={\n  'shapes':{'in':784,'hidden':16,'out':10},\n  'layers':[\n    {'W':w0,'b':b0},\n    {'W':w1,'b':b1},\n    {'W':w2,'b':b2},\n  ]\n}\nwith open('/app/weights.json','w') as f:\n    json.dump(obj,f)\nprint('wrote weights.json')\nPYEOF\n"]
