[66.197153, "i", "C4=$(find / -maxdepth 6 -type d -name c4_sample 2>/dev/null | head -1); echo \"C4=$C4\"; python3 - \"$C4\" <<'EOF'\nimport sys, os\nfrom collections import Counter\nroot = sys.argv[1]\nfiles = []\ntotal = 0\nfor dp, dn, fn in os.walk(root):\n    for f in fn:\n        p = os.path.join(dp, f)\n        try:\n            s = os.path.getsize(p)\n        except OSError:\n            continue\n        files.append((p, s)); total += s\nnf = len(files)\nsizes = [s for _, s in files]\nbig = [x for x in files if x[1] > 15000000]\nprint('total files:', nf)\nprint('total size MB:', round(total/1e6, 3))\nprint('max file size MB:', round((max(sizes) if sizes else 0)/1e6, 3))\nprint('files > 15MB:', len(big))\nfor p, s in sorted(big, key=lambda x:-x[1])[:20]:\n    print('   %.2f MB  %s' % (s/1e6, os.path.relpath(p, root)))\nc = Counter(os.path.dirname(p) for p, s in files)\nprint('--- dirs with most files ---')\nfor d, n in c.most_common(10):\n    print('   %d  %s' % (n, os.path.relpath(d, root)))\nprint('max files in any single dir:', max(c.values()) if c else 0)\nEOF\n"]
