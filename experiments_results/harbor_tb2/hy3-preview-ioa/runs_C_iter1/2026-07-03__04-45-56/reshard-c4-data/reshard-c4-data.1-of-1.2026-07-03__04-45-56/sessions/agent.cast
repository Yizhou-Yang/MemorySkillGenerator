[432.893365, "i", "cat > /app/reshard.py <<'PYEOF'\nimport os, json, shutil\n\nSRC = '/app/c4_sample'\nDST = '/app/c4_reshard'\nMANIFEST = '/app/c4_reshard_manifest.json'\nMAX_FILES = 30\nMAX_SIZE = 15 * 1024 * 1024\n\ndef main():\n    if not os.path.isdir(SRC):\n        raise SystemExit('source not found: ' + SRC)\n    os.makedirs(DST, exist_ok=True)\n    files = []\n    for name in os.listdir(SRC):\n        p = os.path.join(SRC, name)\n        if os.path.isfile(p):\n            files.append(name)\n    files.sort()\n    for name in files:\n        s = os.path.getsize(os.path.join(SRC, name))\n        if s > MAX_SIZE:\n            raise SystemExit('file exceeds 15MB: ' + name)\n    manifest = []\n    batch = 0\n    idx = 0\n    n = len(files)\n    while idx < n:\n        sub = os.path.join(DST, 'batch_%04d' % batch)\n        os.makedirs(sub, exist_ok=True)\n        for name in files[idx:idx+MAX_FILES]:\n            src_p = os.path.join(SRC, name)\n            dst_p = os.path.join(sub, name)\n            shutil.mo"]
