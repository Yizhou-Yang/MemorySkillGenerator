[432.907549, "i", "ve(src_p, dst_p)\n            manifest.append({'orig': name, 'dest': os.path.relpath(dst_p, DST)})\n        idx += MAX_FILES\n        batch += 1\n    with open(MANIFEST, 'w') as f:\n        json.dump({'src': SRC, 'dst': DST, 'entries': manifest}, f, indent=2)\n    print('resharded %d files into %d folders' % (n, batch))\n    print('manifest: ' + MANIFEST)\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
