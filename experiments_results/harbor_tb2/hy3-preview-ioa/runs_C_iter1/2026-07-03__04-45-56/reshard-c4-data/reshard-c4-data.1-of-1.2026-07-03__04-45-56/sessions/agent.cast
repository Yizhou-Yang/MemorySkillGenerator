[489.958329, "i", "cat > /app/revert.py <<'PYEOF'\n#!/usr/bin/env python3\n\"\"\"Revert the resharding done by reshard.py.\n\nReads /app/c4_reshard_manifest.json and moves every file back from its\nresharded location under c4_reshard/ to its original path inside c4_sample/.\nAny batch_* folders left empty afterwards are removed. The manifest is\nleft in place; it is not deleted by this script.\n\nRun:  python3 /app/revert.py\n\"\"\"\nimport os\nimport json\nimport shutil\n\nMANIFEST = '/app/c4_reshard_manifest.json'\n\n\ndef main():\n    with open(MANIFEST) as f:\n        data = json.load(f)\n    src = data['src']\n    dst = data['dst']\n\n    if not os.path.isdir(dst):\n        raise SystemExit('resharded folder not found: ' + dst)\n\n    os.makedirs(src, exist_ok=True)\n\n    moved = 0\n    for entry in data['entries']:\n        orig = entry['orig']\n        dest_rel = entry['dest']\n        dest_path = os.path.join(dst, dest_rel)\n        orig_path = os.path.join(src, orig)\n        if not os.path.isfile(dest_path):\n            print('WARNING: missing file, skipping: ' + dest_path)\n            continue\n        os.makedirs(os.path.dirname(orig_path), exist_ok=True)\n        shutil.move(dest_path, orig_path)\n        moved += 1\n\n    # remove empty batch folders\n    if os.path.isdir(dst):\n        for name in sorted(os.listdir(dst)):\n            p = os.path.join(dst, name)\n            if os.path.isdir(p) and not os.listdir(p):\n                os.rmdir(p)\n        # if c4_reshard itself is now empty, optionally leave it; do not delete.\n\n    print('restored %d files back to %s' % (moved, src))\n\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
[489.959615, "o", "cat > /app/revert.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.969803, "o", "#!/usr/bin/env python3"]
[489.971087, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Revert the resharding done by reshard.py.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Reads /app/c4_reshard_manifest.json and moves every file back from its\r\n\u001b[?2004l\r\u001b[?2004h> resharded location under c4_reshard/ to its original path inside c4_sample/.\r\n\u001b[?2004l\r\u001b[?2004h> Any batch_* folders left empty afterwards are removed. The manifest is\r\n\u001b[?2004l\r\u001b[?2004h> left in place; it is not deleted by this script.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Run:  python3 /app/revert.py\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import shutil\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> MANIFEST = '/app/c4_reshard_manifest.json'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     with open(MANIFEST) as f:\r\n\u001b[?2004l\r\u001b[?2004h>         data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h>     src = data['src']\r\n\u001b[?2004l\r\u001b[?2004h>     dst = data['dst']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.976894, "o", "    if not os.path.isdir(dst):\r\n\u001b[?2004l\r\u001b[?2004h>         raise SystemExit('resharded folder not found: ' + dst)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     os.makedirs(src, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[489.981267, "o", "    moved = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for entry in data['entries']:\r\n\u001b[?2004l\r\u001b[?2004h>         orig = entry['orig']\r\n\u001b[?2004l\r\u001b[?2004h>         dest_rel = entry['dest']\r\n\u001b[?2004l\r\u001b[?2004h>         dest_path = os.path.join(dst, dest_rel)\r\n\u001b[?2004l\r\u001b[?2004h>         orig_path = os.path.join(src, orig)\r\n\u001b[?2004l\r\u001b[?2004h>         if not os.path.isfile(dest_path):\r\n\u001b[?2004l\r\u001b[?2004h>             print('WARNING: missing file, skipping: ' + dest_path)\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         os.makedirs(os.path.dirname(orig_path), exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>         shutil.move(dest_path, orig_path)\r\n\u001b[?2004l\r\u001b[?2004h>         moved += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # remove empty batch folders\r\n\u001b[?2004l\r\u001b[?2004h>     if os.path.isdir(dst):\r\n\u001b[?2004l\r\u001b[?2004h>         for name in sorted(os.listdir(dst)):\r\n\u001b[?2004l\r\u001b[?2004h>             p = os.path.join(dst, name)\r\n\u001b[?2004l\r\u001b[?2004h>             if os.path.isdir(p) and not os.listdir(p):\r\n\u001b[?2004l\r\u001b[?2004h>                 os.rmdir(p)\r\n\u001b[?2004l\r\u001b[?2004h>         # if c4_reshard itself is now empty, optionally leave it; do not delete.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print('restored %d files back to %s' % (moved, src))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[489.989318, "o", "\u001b[?2004hroot@82d2829cde94:/app# "]
[490.143454, "i", "ls -la /app/revert.py /app/c4_reshard_manifest.json && echo '--- revert.py NOT run ---' && head -5 /app/revert.py\n"]
[490.14475, "o", "ls -la /app/revert.py /app/c4_reshard_manifest.json && echo '--- revert.py NOT run ---' && head -5 /app/revert.py"]
[490.144779, "o", "\r\n\u001b[?2004l\r"]
[490.153941, "o", "-rw-r--r-- 1 root root 1138346 Jul  2 21:54 /app/c4_reshard_manifest.json\r\n-rw-r--r-- 1 root root    1564 Jul  2 21:55 /app/revert.py\r\n"]
[490.154479, "o", "--- revert.py NOT run ---\r\n"]
[490.159851, "o", "#!/usr/bin/env python3\r\n\"\"\"Revert the resharding done by reshard.py.\r\n\r\nReads /app/c4_reshard_manifest.json and moves every file back from its\r\nresharded location under c4_reshard/ to its original path inside c4_sample/.\r\n"]
[490.160291, "m", "Episode 8: 0 commands"]
