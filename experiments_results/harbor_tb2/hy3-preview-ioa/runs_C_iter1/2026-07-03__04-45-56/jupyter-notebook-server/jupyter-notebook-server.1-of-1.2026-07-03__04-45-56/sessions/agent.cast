[164.258413, "i", "python3 - <<'PY'\nfrom jupyter_server.auth import passwd\nimport json\n\npwd_hash = passwd('benchmarkpass')\nprint('HASH:', pwd_hash)\n\ncfg = '''c.ServerApp.ip = '0.0.0.0'\nc.ServerApp.port = 8888\nc.ServerApp.certfile = '/root/.jupyter/mycert.pem'\nc.ServerApp.keyfile = '/root/.jupyter/mykey.key'\nc.ServerApp.password = {ph!r}\nc.ServerApp.open_browser = False\nc.ServerApp.allow_root = True\n'''.format(ph=pwd_hash)\n\nwith open('/root/.jupyter/jupyter_server_config.py','w') as f:\n    f.write(cfg)\nprint('config written')\nPY\n"]
