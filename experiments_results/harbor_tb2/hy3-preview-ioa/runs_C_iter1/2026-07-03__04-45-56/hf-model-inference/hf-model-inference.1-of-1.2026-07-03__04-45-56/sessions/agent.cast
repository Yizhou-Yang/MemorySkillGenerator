[341.068462, "i", "cat > /app/test.py << 'EOF'\nimport requests\nimport json\n\nURL = \"http://0.0.0.0:5000/sentiment\"\n\nsamples = [\n    \"I absolutely loved this movie, it was fantastic!\",\n    \"This was a terrible waste of time and very boring.\",\n    \"The service was okay, nothing special but not bad.\",\n]\n\nfor text in samples:\n    try:\n        r = requests.post(URL, json={\"text\": text})\n        print(\"TEXT:\", text)\n        print(\"RESPONSE:\", r.status_code, r.text)\n        print(\"-\" * 60)\n    except Exception as e:\n        print(\"TEXT:\", text)\n        print(\"ERROR:\", e)\n        print(\"-\" * 60)\nEOF\n"]
[341.068813, "o", "cat > /app/test.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> URL = \"http://0.0.0.0:5000/sentiment\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> samples = [\r\n\u001b[?2004l\r\u001b[?2004h>     \"I absolutely loved this movie, it was fantastic!\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"This was a terrible waste of time and very boring.\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"The service was okay, nothing special but not bad.\",\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for text in samples:\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         r = requests.post(URL, json={\"text\": text})\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"TEXT:\", text)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"RESPONSE:\", r.status_code, r.text)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"-\" * 60)\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"TEXT:\", text)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"ERROR:\", e)\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"-\" * 60)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2"]
