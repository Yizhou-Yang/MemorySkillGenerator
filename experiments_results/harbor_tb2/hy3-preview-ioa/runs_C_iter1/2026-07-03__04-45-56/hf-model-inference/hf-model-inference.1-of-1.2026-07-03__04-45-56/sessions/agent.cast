[331.793729, "i", "cat > /app/app.py << 'EOF'\nfrom flask import Flask, request, jsonify\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\nimport torch\nimport os\n\nMODEL_PATH = \"/app/model_cache/sentiment_model\"\n\napp = Flask(__name__)\n\ntokenizer = AutoTokenizer.from_pretrained(MODEL_PATH)\nmodel = AutoModelForSequenceClassification.from_pretrained(MODEL_PATH)\nmodel.eval()\n\n# id2label for SST-2 distilbert: 0=NEGATIVE, 1=POSITIVE\nid2label = model.config.id2label\nif not id2label:\n    id2label = {0: \"NEGATIVE\", 1: \"POSITIVE\"}\n\ndef normalize(label):\n    return label.lower()\n\n@app.route(\"/sentiment\", methods=[\"POST\"])\ndef sentiment():\n    try:\n        data = request.get_json(silent=True)\n        if not data or \"text\" not in data:\n            return jsonify({\"error\": \"Missing 'text' field in request body\"}), 400\n        text = data[\"text\"]\n        if not isinstance(text, str) or text.strip() == \"\":\n            return jsonify({\"error\": \"'text' must be a non-empty str"]
[331.794123, "o", "cat > /app/app.py << 'EOF'"]
[331.794178, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.794415, "o", "> "]
[331.794474, "o", "from flask import Flask, request, jsonify"]
[331.794594, "o", "\r\n"]
[331.794666, "o", "\u001b[?2004l\r"]
[331.794766, "o", "\u001b[?2004h"]
[331.794935, "o", "> "]
[331.795165, "o", "from transformers import AutoTokenizer, AutoModelForSequenceClassification"]
[331.795325, "o", "\r\n"]
[331.795442, "o", "\u001b[?2004l\r"]
[331.795572, "o", "\u001b[?2004h"]
[331.795692, "o", "> "]
[331.795809, "o", "import torch"]
[331.795958, "o", "\r\n"]
[331.796047, "o", "\u001b[?2004l\r"]
[331.796144, "o", "\u001b[?2004h"]
[331.796325, "o", "> "]
[331.797322, "o", "import os"]
[331.797404, "o", "\r\n"]
[331.797474, "o", "\u001b[?2004l\r"]
[331.797663, "o", "\u001b[?2004h"]
[331.798029, "i", "ing\"}), 400\n\n        inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n        with torch.no_grad():\n            logits = model(**inputs).logits\n            probs = torch.softmax(logits, dim=-1)[0]\n\n        # build confidence dict keyed by lowercase label\n        conf = {}\n        for idx, lab in id2label.items():\n            conf[normalize(lab)] = float(probs[int(idx)])\n\n        # ensure positive/negative keys exist\n        positive = conf.get(\"positive\", 0.0)\n        negative = conf.get(\"negative\", 0.0)\n\n        pred_idx = int(torch.argmax(probs).item())\n        pred_label = normalize(id2label[pred_idx])\n\n        return jsonify({\n            \"sentiment\": pred_label,\n            \"confidence\": {\n                \"positive\": positive,\n                \"negative\": negative\n            }\n        })\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n\n@app.route(\"/health\", methods=[\"GET\"])\ndef health():\n    return jsonify({\"status\": \"ok\"})\n\nif __name__ == \"__main__"]
[331.798143, "o", "> \r\n"]
[331.798498, "i", "\":\n    app.run(host=\"0.0.0.0\", port=5000)\nEOF\n"]
