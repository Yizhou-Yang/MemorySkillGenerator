[1069.48765, "m", "Episode 28: 4 commands"]
[1069.48765, "o", "\u001b[0;7m\u000f5\r\u001b[35d\u001b[m\u000fThe Troll Room\r\u001b[36dThis is a small room with passages to the east and south and a forbidding hole leading west. Bloodstains and deep scratches (perhaps made by an axe) mar the\r\u001b[37dwalls.\r\u001b[38dThere is a bloody axe here.\r\u001b[40d>"]
[1078.052479, "i", "east\n"]
[1078.053141, "o", "east\r\u001b[2d\u001b[4M\u001bM\u001b[C\u001b[0;7m\u000fEast-West Passage\u001b[1;138H40\u001b[155G6\r\u001b[37d\u001b[m\u000fEast-West Passage\r\u001b[38dThis is a narrow east-west passageway. There is a narrow stairway leading down at the north end of the room.\r\u001b[40d>"]
[1078.403314, "i", "look\n"]
[1078.404588, "o", "look\r\u001b[2d\u001b[4M\u001bM\u001b[155G\u001b[0;7m\u000f7\r\u001b[37d\u001b[m\u000fEast-West Passage\r\u001b[38dThis is a narrow east-west passageway. There is a narrow stairway leading down at the north end of the room.\r\u001b[40d>"]
