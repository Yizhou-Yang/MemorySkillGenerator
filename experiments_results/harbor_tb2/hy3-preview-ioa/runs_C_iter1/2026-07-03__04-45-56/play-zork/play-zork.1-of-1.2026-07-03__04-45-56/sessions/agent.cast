[1121.260781, "o", "\u001b[5M\u001bM\u001b[C"]
[1121.261679, "o", "\u001b[0;7m\u000fGallery      \u001b[155G"]
[1121.261958, "o", "2\r\u001b[36d"]
[1121.262187, "o", "\u001b[m\u000fGallery\r\u001b[37d"]
[1121.262459, "o", "This is an art gallery. Most of the paintings have been stolen by vandals with exceptional taste. The vandals left through either the north or west exits.\r\u001b[38d"]
[1121.267029, "o", "Fortunately, there is still one chance for you to be a vandal, for on the far wall is a painting of unparalleled beauty.\r\u001b[40d"]
[1121.267432, "o", ">"]
[1121.556563, "i", "look\n"]
[1121.557178, "o", "l"]
[1121.557436, "o", "o"]
