[791.244614, "o", "\u001b[m\u000fThe Troll Room\r\u001b[36d"]
[791.244893, "o", "This is a small room with passages to the east and south and a forbidding hole leading west. Bloodstains and deep scratches (perhaps made by an axe) mar the\r\u001b[37d"]
[791.245118, "o", "walls.\r\u001b[38d"]
[791.245345, "o", "There is a bloody axe here.\r\u001b[40d"]
