[788.553914, "o", "3\r\u001b[33d"]
[788.554533, "o", "\u001b[m\u000fThe Troll Room\r\u001b[34d"]
[788.554893, "o", "This is a small room with passages to the east and south and a forbidding hole leading west. Bloodstains and deep scratches (perhaps made by an axe) mar the\r\u001b[35d"]
[788.555111, "o", "walls.\r\u001b[36d"]
[788.555338, "o", "A nasty-looking troll, brandishing a bloody axe, blocks all passages out of the room.\r\u001b[37d"]
[788.556006, "o", "Your sword has begun to glow very brightly.\r\u001b[38d"]
[788.556275, "o", "The axe gets you right in the side. Ouch!\r\u001b[40d"]
[788.5565, "o", ">"]
