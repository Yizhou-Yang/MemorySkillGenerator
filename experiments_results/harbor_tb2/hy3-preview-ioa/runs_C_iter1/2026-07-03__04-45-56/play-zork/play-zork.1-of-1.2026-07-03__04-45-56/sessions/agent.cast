[2228.927805, "o", "\u001b[m\u000fChasm\r\u001b[35d"]
[2228.927878, "o", "A chasm runs southwest to northeast and the path follows it. You are on the south side of the chasm, where a crack opens into a passage.\r\u001b[36d"]
[2228.928111, "o", "A small leaflet is on the ground.\r\u001b[37d"]
[2228.928179, "o", "There is a ZORK owner's manual here.\r\u001b[38d"]
[2228.92825, "o", "A painting by a neglected genius is here.\r\u001b[40d"]
[2228.928327, "o", ">"]
