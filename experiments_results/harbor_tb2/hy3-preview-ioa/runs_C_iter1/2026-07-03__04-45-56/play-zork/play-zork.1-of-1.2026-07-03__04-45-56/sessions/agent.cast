[677.053245, "o", "\u001b[4M\u001bM\u001b[C\u001b[0;7m\u000fBehind House  \u001b[154G"]
[677.053277, "o", "4\r\u001b[37d\u001b[m\u000fBehind House\r\u001b[38d"]
[677.053595, "o", "You are behind the white house. A path leads into the forest to the east. In one corner of the house there is a small window which is slightly ajar.\r\u001b[40d"]
[677.053858, "o", ">"]
[677.398783, "i", "open window\n"]
[677.399474, "o", "o"]
[677.399653, "o", "p"]
