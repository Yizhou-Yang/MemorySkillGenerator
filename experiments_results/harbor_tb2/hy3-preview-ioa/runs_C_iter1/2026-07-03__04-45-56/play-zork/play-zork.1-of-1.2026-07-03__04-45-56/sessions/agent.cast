[1121.557959, "o", "k"]
[1121.558448, "o", "\r\u001b[2d"]
[1121.558719, "o", "\u001b[5M\u001bM\u001b[155G"]
[1121.559036, "o", "\u001b[0;7m\u000f3\r\u001b[36d"]
[1121.559261, "o", "\u001b[m\u000fGallery\r\u001b[37d"]
[1121.559539, "o", "This is an art gallery. Most of the paintings have been stolen by vandals with exceptional taste. The vandals left through either the north or west exits.\r\u001b[38d"]
[1121.559794, "o", "Fortunately, there is still one chance for you to be a vandal, for on the far wall is a painting of unparalleled beauty.\r\u001b[40d"]
[1121.560439, "m", "Episode 31: 5 commands"]
