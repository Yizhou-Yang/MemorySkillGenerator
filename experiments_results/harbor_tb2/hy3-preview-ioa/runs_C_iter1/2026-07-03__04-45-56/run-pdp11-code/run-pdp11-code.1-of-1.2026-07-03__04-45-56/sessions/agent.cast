[127.769789, "i", "cat > /tmp/recon.py << 'EOF'\nimport re\nout = bytearray()\nwith open('/app/data.hex') as f:\n    for line in f:\n        parts = line.split()\n        if not parts:\n            continue\n        words = parts[1:]  # skip offset token\n        for w in words:\n            v = int(w, 8)\n            out.append(v & 0xFF)\n            out.append((v >> 8) & 0xFF)\nwith open('/app/recon.bin','wb') as fo:\n    fo.write(out)\nprint('length', len(out))\nprint('first bytes', out[:8].hex(' '))\nEOF\npython3 /tmp/recon.py\n"]
[127.771038, "o", "cat > /tmp/recon.py << 'EOF'\r\n"]
