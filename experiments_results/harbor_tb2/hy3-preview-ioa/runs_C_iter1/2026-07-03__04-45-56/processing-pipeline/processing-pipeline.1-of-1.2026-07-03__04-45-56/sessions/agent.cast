[18.11375, "o", "\r\n"]
[18.113946, "o", "^M$"]
[18.114141, "o", "\r\n"]
[18.114383, "o", "# Check if input data exists^M$"]
[18.114603, "o", "\r\n"]
[18.114811, "o", "if [ -f \"/data/output/raw_data.txt\" ]; then^M$"]
[18.115029, "o", "\r\n"]
[18.115243, "o", "    # Process the data^M$"]
[18.115494, "o", "\r\n"]
[18.115722, "o", "    cat /data/output/raw_data.txt | tr 'a-z' 'A-Z' > /data/output/processed_data.txt^M$"]
[18.115924, "o", "\r\n"]
[18.116245, "o", "    echo \"Data processed successfully!\"^M$"]
[18.116487, "o", "\r\n"]
[18.116709, "o", "    exit 0^M$"]
[18.116907, "o", "\r\n"]
[18.117101, "o", "else^M$"]
[18.11732, "o", "\r\n"]
[18.117565, "o", "    echo \"Error: Input data not found!\"^M$"]
[18.117766, "o", "\r\n"]
[18.117964, "o", "    exit 1^M$"]
[18.118158, "o", "\r\n"]
[18.118381, "o", "fi"]
