[474.031398, "i", "cat > /app/scan.py << 'EOF'\nfrom huggingface_hub import hf_hub_download\nfrom pyarrow import parquet as pq\nfrom collections import Counter\nimport os\nc = Counter()\nshards = [f\"metadata/train-{i:05d}-of-00012.parquet\" for i in range(12)]\nfor i, fname in enumerate(shards):\n    path = hf_hub_download(\"open-thoughts/OpenThoughts-114k\", fname, repo_type=\"dataset\")\n    pf = pq.ParquetFile(path)\n    for batch in pf.iter_batches(batch_size=1000):\n        d = batch.to_pydict()[\"domain\"]\n        for v in d:\n            c[v] += 1\n    del pf\n    os.remove(path)\n    print(f\"shard {i+1} done\", flush=True)\nprint(\"ALL DOMAIN COUNTS:\", dict(c), flush=True)\nEOF\npython3 /app/scan.py\n"]
