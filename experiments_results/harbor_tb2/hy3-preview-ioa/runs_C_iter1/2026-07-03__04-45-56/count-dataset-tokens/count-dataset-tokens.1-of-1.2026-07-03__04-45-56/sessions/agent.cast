[406.070181, "i", "cat > /app/inspect.py << 'EOF'\nfrom huggingface_hub import hf_hub_download\nfrom pyarrow import parquet as pq\nfrom collections import Counter\npath = hf_hub_download(\"open-thoughts/OpenThoughts-114k\", \"metadata/train-00000-of-00012.parquet\", repo_type=\"dataset\")\npf = pq.ParquetFile(path)\nprint(\"schema:\", pf.schema_arrow.names)\nc = Counter()\nsample = None\nfor batch in pf.iter_batches(batch_size=500):\n    d = batch.to_pydict()[\"domain\"]\n    for v in d:\n        c[v] += 1\n    if sample is None:\n        sample = batch.to_pydict()\nprint(\"domain counts:\", dict(c))\nif sample:\n    print(\"keys:\", list(sample.keys()))\n    print(\"reason len:\", len(sample.get(\"deepseek_reasoning\",[\"\"])[0] or \"\"))\n    print(\"sol len:\", len(sample.get(\"deepseek_solution\",[\"\"])[0] or \"\"))\nEOF\npython3 /app/inspect.py\n"]
[406.070438, "o", "cat > /app/inspect.py << 'EOF'"]
