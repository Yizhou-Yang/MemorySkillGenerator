[123.359205, "o", "\u001b[?1h\u001b=\r"]
[123.360108, "o", "I am a Postdoctoral Researcher at Stanford CS.\u001b[m"]
[123.360448, "o", "\r\n"]
[123.36069, "o", "\u001b[m"]
[123.36086, "o", "\r\n"]
[123.361052, "o", "Previously, I was a Student Researcher at [Google Research](https://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple.\u001b[m \b"]
[123.362353, "o", "com/work-with-us) and a data scientist and the second full-time employee at [HealthRhythms](https://www.healthrhythms.com). \u001b[m"]
[123.362521, "o", "\r\n"]
[123.362694, "o", "\r\u001b[K\u001b[?1l\u001b>"]
