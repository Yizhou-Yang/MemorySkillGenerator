[574.894389, "o", "\u001b[m\r\n\u001b[1mdiff --git a/_includes/about.md b/_includes/about.md\u001b[m\u001b[m\r\n\u001b[1mindex 5322c14..7561d9e 100644\u001b[m\u001b[m\r\n\u001b[1m--- a/_includes/about.md\u001b[m\u001b[m\r\n\u001b[1m+++ b/_includes/about.md\u001b[m\u001b[m\r\n\u001b[36m@@ -1,3 +1,3 @@\u001b[m\u001b[m\r\n\u001b[31m-I am a sixth year PhD student at the [Paul G. Allen School of Computer Science & Engineering](https://www.cs.washington.edu/) at The University of Washington, \u001b[m \b\u001b[31mwhere I am advised by [Tim Althoff](http://www.timalthoff.com/). I am affiliated with [UW NLP](https://twitter.com/uwnlp).\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mI am a Postdoctoral Researcher at Stanford CS.\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-**I am looking for a full time job!** If you think we would be a good match, please reach out. Previously, I was a Student Researcher at [Google Research](http\u001b[m \b\u001b[31ms://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple.com/work-with-us) and a data scientist and the second full-time \u001b[m \b\u001b[31memployee at [HealthRhythms](https://www.healthrhythms.co"]
[574.894777, "o", "m). \u001b[m\u001b[m\r\n\\ No newline at end of file\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mPreviously, I was a Student Researcher at [Google Research](https://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple\u001b[m \b\u001b[32m\u001b[m\u001b[32m.com/work-with-us) and a data scientist and the second full-time employee at [HealthRhythms](https://www.healthrhythms.com).\u001b[m\u001b[41m \u001b[m\u001b[m\r\n\\ No newline at end of file\u001b[m\u001b[m\r\n\u001b[1mdiff --git a/_layouts/default.html b/_layouts/default.html\u001b[m\u001b[m\r\n\u001b[1mindex 3fe07ee..cff5b5e 100644\u001b[m\u001b[m\r\n\u001b[1m--- a/_layouts/default.html\u001b[m\u001b[m\r\n\u001b[1m+++ b/_layouts/default.html\u001b[m\u001b[m\r\n\u001b[36m@@ -27,7 +27,9 @@\u001b[m\u001b[m\r\n     <link href=\"css/bootstrap.min.css\" rel=\"stylesheet\">\u001b[m\u001b[m\r\n     <link href=\"css/style.css\" rel=\"stylesheet\">\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-    <link href=\"https://fonts.googleapis.com/css?family=Noto+Sans+HK:100,300|Barlow+Condensed|PT+Mono|PT+Serif&display=swap\" rel=\"stylesheet\">\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    <link\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        href=\"https://fonts.googleapis.com/css?family=Noto+"]
[574.894791, "o", "Sans+HK:100,300|Barlow+Condensed|PT+Mono|PT+Serif&display=swap\"\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        rel=\"stylesheet\">\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n </head>\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[36m@@ -38,7 +40,7 @@\u001b[m\u001b[m\r\n             <div class=\"jumbotron\">\u001b[m\u001b[m\r\n                 <div class=\"row\">\u001b[m\u001b[m\r\n                     <h3>\u001b[m\u001b[m\r\n\u001b[31m-                        PhD Student @ UW CSE\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                        Postdoc @ Stanford\u001b[m\u001b[m\r\n:\u001b[K\r\u001b[K                     </h3>\u001b[m\u001b[m\r\n:\u001b[K"]
[575.18712, "i", "\n"]
[575.18719, "o", "\r\u001b[K                 </div>\u001b[m\u001b[m\r\n:\u001b[K"]
[575.527363, "i", "echo READY\n"]
[575.527947, "o", "\r\u001b[K                 <div class=\"row\">\u001b[m\u001b[m\r\n:\u001b[K"]
[575.528106, "o", "\u0007\r\u001b[K:\u001b[K\r\u001b[K...skipping..."]
[575.528252, "o", "\r\n"]
[575.528342, "o", "\u001b[m"]
[575.528429, "o", "\r\n"]
[575.528921, "o", "                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\u001b[m\r\n\u001b[m\r\n      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\u001b[m"]
[575.529074, "o", "\r\n      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\u001b[m\r\n      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\u001b[m"]
[575.529209, "o", "\r\n\u001b[m\r\n  h  H                 Display this help.\u001b[m\r\n  q  :q  Q  :Q  ZZ     Exit.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n"]
[575.529341, "o", "\u001b[m\r\n                           \u001b[1mMOVING\u001b[0m\u001b[m\r\n\u001b[m\r\n  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\u001b[m"]
[575.52961, "o", "\r\n  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\u001b[m\r\n  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\u001b[m\r\n  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\u001b[m"]
[575.530098, "o", "\r\n  ESC-SPACE         *  Forward  one window, but don't stop at end-of-file.\u001b[m"]
[575.530192, "o", "\r\n"]
[575.530279, "o", "  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m"]
[575.530328, "o", "\r\n"]
[575.530479, "o", "  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\u001b[m\r\n  ESC-)  RightArrow *  Right one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n"]
[575.530646, "o", "  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\u001b[m\r\n  ESC-}  ^RightArrow   Right to last column displayed.\u001b[m"]
[575.530775, "o", "\r\n  ESC-{  ^LeftArrow    Left  to first column.\u001b[m\r\n  F                    Forward forever; like \"tail -f\".\u001b[m\r\n  ESC-F                Like F but stop when search pattern is found.\u001b[m\r\n  r  ^R  ^L            Repaint screen.\u001b[m"]
[575.530885, "o", "\r\n  R                    Repaint screen, discarding buffered input.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n"]
[575.531319, "o", "        Default \"window\" is the screen height.\u001b[m\r\n"]
[575.53146, "o", "        Default \"half-window\" is half of the screen height.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m"]
[575.531599, "o", "\r\n\u001b[m\r\n                          \u001b[1mSEARCHING\u001b[0m\u001b[m\r\n"]
[575.53167, "o", "\u001b[m"]
[575.531886, "o", "\r\n  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m"]
[575.532227, "o", "\r\n  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K"]
[575.533037, "o", "\r\u001b[K  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m"]
[575.534244, "o", "\r\n"]
[575.534339, "o", "  N                 *  Repeat previous search in reverse direction.\u001b[m"]
[575.534391, "o", "\r\n"]
[575.53462, "o", "  ESC-n             *  Repeat previous search, spanning files.\u001b[m\r\n"]
[575.535074, "o", "  ESC-N             *  Repeat previous search, reverse dir. & spanning files.\u001b[m\r\n  ESC-u                Undo (toggle) search highlighting.\u001b[m\r\n  ESC-U                Clear search highlighting.\u001b[m"]
[575.535221, "o", "\r\n  &\u001b[4mpattern\u001b[24m          *  Display only matching lines.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        A search pattern may begin with one or more of:\u001b[m\r\n        ^N or !  Search for NON-matching lines.\u001b[m\r\n        ^E or *  Search multiple files (pass thru END OF FILE).\u001b[m"]
[575.537985, "o", "\r\n        ^F or @  Start search at FIRST file (for /) or last file (for ?).\u001b[m\r\n        ^K       Highlight matches, but don't move (KEEP position).\u001b[m\r\n        ^R       Don't use REGULAR EXPRESSIONS.\u001b[m\r\n        ^W       WRAP search if no match found.\u001b[m\r\n"]
[575.538388, "o", " -------------------------------------------------------"]
[575.53842, "o", "--------------------\u001b[m"]
[575.539241, "o", "\r\n"]
[575.539297, "o", "\u001b[m"]
[575.539507, "o", "\r\n                           \u001b[1mJUMPING\u001b[0m\u001b[m"]
[575.539615, "o", "\r\n\u001b[m\r\n  g  <  ESC-<       *  Go to first line in file (or line \u001b[4mN\u001b[24m).\u001b[m"]
[575.539843, "o", "\r\n  G  >  ESC->       *  Go to last line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n  p  %              *  Go to beginning of file (or \u001b[4mN\u001b[24m percent into file).\u001b[m\r\n  t                 *  Go to the (\u001b[4mN\u001b[24m-th) next tag.\u001b[m\r\n  T                 *  Go to the (\u001b[4mN\u001b[24m-th) previous tag.\u001b[m\r\n  {  (  [           *  Find close bracket } ) ].\u001b[m"]
[575.540115, "o", "\r\n  }  )  ]           *  Find open bracket { ( [.\u001b[m\r\n  ESC-^F \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find close bracket \u001b[4m<c2>\u001b[24m.\u001b[m\r\n  ESC-^B \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find open bracket \u001b[4m<c1>\u001b[24m.\u001b[m"]
[575.540147, "o", "\r\n        ---------------------------------------------------\u001b[m\r\n        Each \"find close bracket\" command goes forward to the close bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) open bracket in the top line.\u001b[m\r\n        Each \"find open bracket\" command goes backward to the open bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) close bracket in the bottom line.\u001b[m"]
[575.540352, "o", "\r\n"]
[575.540438, "o", "\u001b[m"]
[575.540539, "o", "\r\n"]
[575.540676, "o", "  m\u001b[4m<letter>\u001b[24m            Mark the current top line with <letter>.\u001b[m"]
[575.540853, "o", "\r\n  M\u001b[4m<letter>\u001b[24m            Mark the current bottom line with <letter>.\u001b[m\r\n  '\u001b[4m<letter>\u001b[24m            Go to a previously marked position.\u001b[m\r\n  ''                   Go to the previous position.\u001b[m\r\n  ^X^X                 Same as '.\u001b[m"]
[575.541054, "o", "\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K"]
[575.541258, "o", "...skipping..."]
[575.541385, "o", "\r\n"]
[575.541517, "o", "  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\u001b[m"]
[575.54165, "o", "\r\n"]
[575.541744, "o", "  N                 *  Repeat previous search in reverse direction.\u001b[m"]
[575.541938, "o", "\r\n"]
[575.545161, "o", "  ESC-n             *  Repeat previous search, spanning files.\u001b[m\r\n  ESC-N             *  Repeat previous search, reverse dir. & spanning files.\u001b[m\r\n  ESC-u                Undo (toggle) search highlighting.\u001b[m\r\n  ESC-U                Clear search highlighting.\u001b[m"]
[575.545434, "o", "\r\n  &\u001b[4mpattern\u001b[24m          *  Display only matching lines.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        A search pattern may begin with one or more of:\u001b[m\r\n        ^N or !  Search for NON-matching lines.\u001b[m\r\n        ^E or *  Search multiple files (pass thru END OF FILE).\u001b[m\r\n        ^F or @  Start search at FIRST file (for /) or last file (for ?).\u001b[m\r\n        ^K       Highlight matches, but don't move (KEEP position).\u001b[m\r\n        ^R       Don't use REGULAR EXPRESSIONS.\u001b[m\r\n        ^W       WRAP search if no match found.\u001b[m\r\n ---------------------------------------------------------------------------\u001b[m\r\n\u001b[m\r\n                           \u001b[1mJUMPING\u001b[0m\u001b[m"]
[575.546275, "o", "\r\n\u001b[m\r\n  g  <  ESC-<       *  Go to first line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n  G  >  ESC->       *  Go to last line in file (or line \u001b[4mN\u001b[24m).\u001b[m\r\n  p  %              *  Go to beginning of file (or \u001b[4mN\u001b[24m percent into file).\u001b[m\r\n  t                 *  Go to the (\u001b[4mN\u001b[24m-th) next tag.\u001b[m"]
[575.546317, "o", "\r\n  T                 *  Go to the (\u001b[4mN\u001b[24m-th) previous tag.\u001b[m\r\n  {  (  [           *  Find close bracket } ) ].\u001b[m\r\n  }  )  ]           *  Find open bracket { ( [.\u001b[m\r\n  ESC-^F \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find close bracket \u001b[4m<c2>\u001b[24m.\u001b[m\r\n  ESC-^B \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find open bracket \u001b[4m<c1>\u001b[24m.\u001b[m\r\n        ---------------------------------------------------\u001b[m\r\n        Each \"find close bracket\" command goes forward to the close bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) open bracket in the top line.\u001b[m"]
[575.546863, "o", "\r\n        Each \"find open bracket\" command goes backward to the open bracket \u001b[m\r\n          matching the (\u001b[4mN\u001b[24m-th) close bracket in the bottom line.\u001b[m"]
[575.546889, "o", "\r\n\u001b[m"]
[575.54692, "o", "\r\n  m\u001b[4m<letter>\u001b[24m            Mark the current top line with <letter>.\u001b[m"]
[575.547112, "o", "\r\n  M\u001b[4m<letter>\u001b[24m            Mark the current bottom line with <letter>.\u001b[m\r\n  '\u001b[4m<letter>\u001b[24m            Go to a previously marked position.\u001b[m\r\n  ''                   Go to the previous position.\u001b[m\r\n  ^X^X                 Same as '.\u001b[m\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K"]
[575.547142, "o", "\r\u001b[KExamine: \u001b[KA\bA\u001b[KD\bD\u001b[KY\bY\r\u001b[K"]
[575.573786, "m", "Episode 11: 3 commands"]
[575.573786, "o", "\r\u001b[K\u001b[7mADY: No such file or directory  (press RETURN)\u001b[27m"]
