[95.683731, "i", "cat > /tmp/parse.py << 'PYEOF'\nimport struct\ndata = open('/app/trunc.db','rb').read()\nprint('len', len(data))\nprint('first byte', hex(data[0]))\nncells = int.from_bytes(data[3:5],'big')\nprint('ncells', ncells)\ndef rv(buf, pos):\n    r=0\n    for i in range(9):\n        b=buf[pos+i]\n        if i==8:\n            return (r<<8)|b, i+1\n        r=(r<<7)|(b&0x7f)\n        if not (b&0x80):\n            return r, i+1\nfor i in range(ncells):\n    off=int.from_bytes(data[8+2*i:10+2*i],'big')\n    pos=off\n    plen,n=rv(data,pos); pos+=n\n    rowid,n=rv(data,pos); pos+=n\n    hs,pos2=rv(data,pos); hstart=pos; pos=pos2\n    types=[]\n    while pos-hstart < hs:\n        t,m=rv(data,pos); pos+=m; types.append(t)\n    body=pos\n    vals=[]\n    for t in types:\n        if t==0: vals.append(None)\n        elif t<8: vals.append(int.from_bytes(data[body:body+t],'big',signed=True)); body+=t\n        elif t==7: vals.append(struct.unpack('>d', data[body:body+8])[0]); body+=8\n        elif t==8: vals.append(0)\n        elif t==9: vals.append(1)\n        elif t%2==0:\n            s=(t-12)//2; vals.append(data[body:body+s]); body+=s\n        else:\n            s=(t-13)//2; vals.append(data[body:body+s].decode('utf-8','replace')); body+=s\n    print(i, rowid, types, vals)\nPYEOF\npython3 /tmp/parse.py\n"]
[95.684503, "o", "cat > /tmp/parse.py << 'PYEOF'"]
