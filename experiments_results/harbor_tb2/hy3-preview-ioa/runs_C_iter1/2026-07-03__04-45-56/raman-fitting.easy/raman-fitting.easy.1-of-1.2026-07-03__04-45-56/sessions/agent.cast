[261.232581, "i", "cat > /app/profile.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('/app/graphene_converted.dat')\nx = data[:,0]; y = data[:,1]\nidx = np.argsort(x); x=x[idx]; y=y[idx]\n# moving average smooth\nw=15\nsm = np.convolve(y, np.ones(w)/w, mode='same')\n# coarse downsample to 40 points\nn=40\nedges = np.linspace(x.min(), x.max(), n+1)\nfor i in range(n):\n    m = (x>=edges[i]) & (x<edges[i+1])\n    if m.sum()==0: continue\n    print(f'x~{x[m].mean():9.1f}  y={sm[m].mean():9.1f}')\nEOF\npython3 /app/profile.py\n"]
