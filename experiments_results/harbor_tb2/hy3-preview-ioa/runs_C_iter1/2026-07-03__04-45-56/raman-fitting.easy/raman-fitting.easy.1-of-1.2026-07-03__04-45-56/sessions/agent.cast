[620.429144, "o", "root@882cf59b4aca:/app# "]
[667.545052, "i", "cat > /app/fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\ndata = np.loadtxt('/app/graphene_converted.dat')\nx = data[:,0]; y = data[:,1]\norder = np.argsort(x); x=x[order]; y=y[order]\n\ndef lor(x,x0,g,a):\n    return a*(g*g)/((x-x0)**2+g*g)\n\n# Combined: linear baseline + 2 Lorentzians\ndef model(x, x1,g1,a1, x2,g2,a2, off, slope):\n    return off + slope*(x-x.mean()) + lor(x,x1,g1,a1) + lor(x,x2,g2,a2)\n\np0 = [19140, 400, 70000,  35000, 8000, 6000,  8000, 0.0]\npopt,_ = curve_fit(model, x, y, p0=p0, maxfev=400000)\nyp = model(x,*popt)\nprint('Combined R2 =', 1-np.sum((y-yp)**2)/np.sum((y-y.mean())**2))\nprint('G : x0=%.2f gamma=%.2f amp=%.2f'%(popt[0],popt[1],popt[2]))\nprint('2D: x0=%.2f gamma=%.2f amp=%.2f'%(popt[3],popt[4],popt[5]))\nprint('offset=%.2f slope=%.5f'%(popt[6],popt[7]))\nEOF\npython3 /app/fit2.py\n"]
