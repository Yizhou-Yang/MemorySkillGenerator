[343.392395, "i", "cat > /app/analyze.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\ndata = np.loadtxt('/app/graphene_converted.dat')\nx = data[:,0]; y = data[:,1]\nidx = np.argsort(x); x=x[idx]; y=y[idx]\nsm = np.convolve(y, np.ones(31)/31, mode='same')\npk, props = find_peaks(sm, prominence=1500, distance=40)\nprint('num peaks (smoothed):', len(pk))\npairs = sorted(zip(pk, props['prominences']), key=lambda t:-t[1])\nfor i,pr in pairs:\n    print(f'  x={x[i]:9.2f}  y={sm[i]:9.1f}  prom={pr:9.1f}')\nEOF\npython3 /app/analyze.py\n"]
