[620.243064, "o", "G : x0=19198.78 gamma=383.83 amp=72681.92 off=13633.08  R2=0.9525"]
[620.243148, "o", "\r\n"]
[620.243212, "o", "2D: x0=38367.78 gamma=30471.88 amp=30591.44 off=-10349.57  R2=0.9521"]
