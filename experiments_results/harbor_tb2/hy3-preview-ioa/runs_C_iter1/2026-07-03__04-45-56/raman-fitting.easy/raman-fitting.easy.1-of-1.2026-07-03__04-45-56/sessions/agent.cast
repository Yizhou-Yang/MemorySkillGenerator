[619.137051, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\n# 1. Convert the European-decimal text file so numpy can read it\nwith open('/app/graphene.dat') as f:\n    txt = f.read().replace(',', '.')\nwith open('/app/graphene_converted.dat', 'w') as f:\n    f.write(txt)\n\n# 2. Load and sort by x\ndata = np.loadtxt('/app/graphene_converted.dat')\nx = data[:, 0]; y = data[:, 1]\norder = np.argsort(x); x = x[order]; y = y[order]\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * (gamma**2) / ((x - x0)**2 + gamma**2)\n\ndef fit_peak(xc, half_win):\n    m = (x >= xc - half_win) & (x <= xc + half_win)\n    xw = x[m]; yw = y[m]\n    imax = np.argmax(yw)\n    x0g = xw[imax]; ypk = yw[imax]\n    base = np.min(yw)\n    half = base + 0.5 * (ypk - base)\n    ileft = np.where(yw[:imax] <= half)[0]\n    iright = np.where(yw[imax:] <= half)[0]\n    xl = xw[ileft[-1]] if len(ileft) else x0g - 500.0\n    xr = xw[imax + iright[0]] if len(iright) else x0g + 500.0\n    g0 = max((xr "]
[619.137122, "i", "- xl) / 2.0, 10.0)\n    p0 = [x0g, g0, ypk - base, base]\n    popt, _ = curve_fit(lorentzian, xw, yw, p0=p0, maxfev=200000)\n    yp = lorentzian(xw, *popt)\n    ss = np.sum((yw - yp) ** 2); tot = np.sum((yw - yw.mean()) ** 2)\n    r2 = 1.0 - ss / tot\n    return popt, r2\n\n# 3. G peak: global maximum\niG = int(np.argmax(y)); xG = x[iG]\npG, r2G = fit_peak(xG, 5500)\n\n# 4. 2D peak: strongest feature at higher x than G\nreg = x > (xG + 2000)\nif reg.sum() == 0:\n    reg = x > xG\nx2D = x[reg][int(np.argmax(y[reg]))]\np2D, r2_2D = fit_peak(x2D, 13000)\n\n# 5. Write results for both peaks\nresults = {\n    \"G\":  {\"x0\": float(pG[0]), \"gamma\": float(pG[1]), \"amplitude\": float(pG[2]), \"offset\": float(pG[3])},\n    \"2D\": {\"x0\": float(p2D[0]), \"gamma\": float(p2D[1]), \"amplitude\": float(p2D[2]), \"offset\": float(p2D[3])},\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"G : x0=%.2f gamma=%.2f amp=%.2f off=%.2f  R2=%.4f\" % (pG[0], pG[1], pG[2], pG[3], r2G))\nprint(\"2D: x0=%.2f gamma=%.2f amp=%.2f off=%."]
[619.137138, "i", "2f  R2=%.4f\" % (p2D[0], p2D[1], p2D[2], p2D[3], r2_2D))\nprint(\"results.json keys:\", list(results.keys()))\nEOF\npython3 /app/fit.py\n"]
