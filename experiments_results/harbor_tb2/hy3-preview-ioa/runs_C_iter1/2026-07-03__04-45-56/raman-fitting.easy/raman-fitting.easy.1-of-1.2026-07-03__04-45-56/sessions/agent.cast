[418.871174, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\ndata = np.loadtxt('/app/graphene_converted.dat')\nx = data[:,0]; y = data[:,1]\nidx = np.argsort(x); x=x[idx]; y=y[idx]\n# rolling minimum baseline (lower envelope) over window W\nW = 200\nbase = np.full_like(y, np.inf)\nfor i in range(len(y)):\n    lo = max(0, i-W); hi = min(len(y), i+W)\n    base[i] = np.min(y[lo:hi])\ndetr = y - base\npk, props = find_peaks(detr, prominence=3000, distance=50)\nprint('baseline-subtracted peaks (above baseline):')\nfor i in sorted(pk, key=lambda k:-detr[k])[:12]:\n    print(f'  x={x[i]:9.2f}  peak_y={y[i]:9.1f}  above_base={detr[i]:9.1f}  prom={props[\"prominences\"][list(pk).index(i)]:9.1f}')\nEOF\npython3 /app/diag.py\n"]
