[134.734581, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\n# convert European decimal comma to dot\nwith open('/app/graphene.dat') as f:\n    txt = f.read().replace(',', '.')\nwith open('/app/graphene_converted.dat','w') as f:\n    f.write(txt)\ndata = np.loadtxt('/app/graphene_converted.dat')\nx = data[:,0]; y = data[:,1]\nprint('xmin', x.min(), 'xmax', x.max(), 'n', len(x), 'ymax', y.max())\nidx = np.argsort(x); x=x[idx]; y=y[idx]\nthr = y.max()*0.2\npeaks=[]\nfor i in range(1,len(x)-1):\n    if y[i]>y[i-1] and y[i]>=y[i+1] and y[i]>thr:\n        peaks.append((x[i], y[i]))\npeaks.sort(key=lambda p:-p[1])\nprint('top peaks:')\nfor p in peaks[:15]:\n    print(round(p[0],2), round(p[1],2))\nEOF\npython3 /app/explore.py\n"]
[134.735137, "o", "cat > /app/explore.py << 'EOF'"]
