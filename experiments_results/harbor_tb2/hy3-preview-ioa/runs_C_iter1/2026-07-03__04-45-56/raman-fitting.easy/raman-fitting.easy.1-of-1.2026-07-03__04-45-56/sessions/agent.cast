[517.043333, "i", "cat > /app/diag2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nfrom scipy.signal import find_peaks\n\ndata = np.loadtxt('/app/graphene_converted.dat')\nx = data[:,0]; y = data[:,1]\norder = np.argsort(x); x=x[order]; y=y[order]\nk=51; kernel=np.ones(k)/k\nys=np.convolve(y,kernel,mode='same'); ys[:k//2]=y[:k//2]; ys[-k//2:]=y[-k//2:]\npeaks,_=find_peaks(ys, prominence=0.02*ys.max(), distance=20)\nprint('candidate peaks:', [round(x[p],1) for p in peaks])\n\ndef lor(x,x0,g,a,o):\n    return o + a*(g*g)/((x-x0)**2+g*g)\n\ndef r2(xw,yw,p0):\n    try:\n        popt,_=curve_fit(lor,xw,yw,p0=p0,maxfev=200000)\n        yp=lor(xw,*popt)\n        ss=((yw-yp)**2).sum(); tot=((yw-yw.mean())**2).sum()\n        return 1-ss/tot, popt\n    except Exception as e:\n        return -1, None\n\nfor p in peaks:\n    px=x[p]; base=np.min(ys); amp0=max(ys[p]-base,1)\n    lo,hi=px-6000,px+6000\n    m=(x>=lo)&(x<=hi)\n    r,po=r2(x[m],y[m],[px,400,amp0,base])\n    print(f'x={px:9.1f} y={ys[p]:"]
[517.043814, "o", "cat > /app/diag2.py << 'EOF'"]
[517.04437, "o", "\r\n\u001b[?2004l\r"]
