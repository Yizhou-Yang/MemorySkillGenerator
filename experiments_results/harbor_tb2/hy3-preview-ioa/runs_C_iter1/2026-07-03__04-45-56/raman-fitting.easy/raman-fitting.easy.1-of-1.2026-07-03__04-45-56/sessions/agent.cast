[210.861211, "i", "cat > /app/peaks.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\ndata = np.loadtxt('/app/graphene_converted.dat')\nx = data[:,0]; y = data[:,1]\nidx = np.argsort(x); x=x[idx]; y=y[idx]\npk, props = find_peaks(y, prominence=4000, distance=20)\nprint('num peaks', len(pk))\norder = np.argsort(props['prominences'])[::-1]\nprint('top 8 peaks by prominence:')\nfor j in order[:8]:\n    i = pk[j]\n    print(f'  x={x[i]:.2f}  y={y[i]:.1f}  prom={props[\"prominences\"][j]:.1f}')\nEOF\npython3 /app/peaks.py\n"]
