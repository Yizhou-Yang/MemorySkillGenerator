[463.941444, "i", "python3 - <<'EOF'\nimport socket\nhost='172.24.0.3'\nfor p in [22,2375,2376,9000,9001,8080,80,443,2379,8100,3478]:\n    s=socket.socket(); s.settimeout(0.4)\n    r=s.connect_ex((host,p))\n    if r==0: print('OPEN',p)\n    s.close()\nprint('done')\nEOF\n"]
