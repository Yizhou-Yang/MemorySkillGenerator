[69.984493, "i", "cat > index.html <<'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dr. Lydia Moreno — Research Profile</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"wrap\">\n      <h1>Dr. Lydia Moreno</h1>\n      <p>Associate Professor of Computational Neuroscience, Riverbend University</p>\n    </div>\n  </header>\n  <nav class=\"site\">\n    <div class=\"wrap\">\n      <a class=\"active\" href=\"index.html\">About Me</a>\n      <a href=\"publications.html\">Publications</a>\n      <a href=\"blog.html\">Blog</a>\n    </div>\n  </nav>\n  <main>\n    <h2>About</h2>\n    <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University&rsquo;s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n\n    <h2>Education</h2>\n    <ul>\n      <li><strong>Ph.D., Computational Biology</strong> &mdash; Baywood Institute of Technology, 2014&ndash;2019. Dissertation: &ldquo;Deep Learning Models for Decoding Neural Population Activity.&rdquo;</li>\n      <li><strong>M.Sc., Bioinformatics</strong> &mdash; Riverbend University, 2012&ndash;2014. Thesis: &ldquo;Statistical Methods for Single-Cell RNA-Seq Analysis.&rdquo;</li>\n      <li><strong>B.Sc., Computer Science</strong> &mdash; Crestfield College of Engineering, 2008&ndash;2012. Graduated magna cum laude; President, Data Science Club.</li>\n    </ul>\n\n    <h2>Research Interests</h2>\n    <ul>\n      <li><strong>Neural Encoding &amp; Decoding</strong> &mdash; Developing interpretable models that translate spike-train data into behavioral predictions.</li>\n      <li><strong>Machine Learning for Biomedical Imaging</strong> &mdash; Applying convolutional and graph neural networks to MRI and two-photon microscopy data.</li>\n      <li><strong>Single-Cell Omics</strong> &mdash; Designing scalable pipelines for integrating multi-modal single-cell genomics and spatial transcriptomics.</li>\n      <li><strong>Explainable AI in Neuroscience</strong> &mdash; Building frameworks to probe decision boundaries and feature attributions in black-box models.</li>\n    </ul>\n\n    <h2>Selected Projects</h2>\n    <div class=\"project\">\n      <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\n      <div class=\"role\">Lead Developer &amp; Project Coordinator</div>\n      <ul>\n        <li>Designed a PyTorch-based pipeline to segment two-photon images of mouse visual cortex.</li>\n        <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium-imaging traces.</li>\n        <li>Deployed a Dockerized microservice for real-time data processing with Cascade Imaging Lab.</li>\n      </ul>\n    </div>\n    <div class=\"project\">\n      <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\n      <div class=\"role\">Principal Investigator</div>\n      <ul>\n        <li>Constructed graph representations of reconstructed neuron meshes from electron-microscopy.</li>\n        <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\n        <li>Published an open-source toolkit in the NeuroTools suite, adopted by 12 labs worldwide.</li>\n      </ul>\n    </div>\n    <div class=\"project\">\n      <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\n      <div class=\"role\">Co-Principal Investigator</div>\n      <ul>\n        <li>Developed a Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH data.</li>\n        <li>Implemented Bayesian clustering to resolve cell-type hierarchies in human cortical organoids.</li>\n        <li>Presented at the International Conference on Single-Cell Genomics (ICSCG) 2023.</li>\n      </ul>\n    </div>\n\n    <h2>Teaching &amp; Mentorship<"]
[69.984554, "i", "/h2>\n    <ul>\n      <li><strong>Undergraduate Course:</strong> &ldquo;Introduction to Computational Neuroscience&rdquo; (Spring 2025)</li>\n      <li><strong>Graduate Seminar:</strong> &ldquo;Advanced Machine Learning Methods in Biology&rdquo; (Fall 2024)</li>\n      <li><strong>Mentorship:</strong> Supervised 8 Ph.D. students and 12 Master&rsquo;s theses.</li>\n    </ul>\n\n    <h2>Skills &amp; Tools</h2>\n    <ul>\n      <li><strong>Languages:</strong> Python, R, C++</li>\n      <li><strong>Frameworks:</strong> PyTorch, TensorFlow, scikit-learn, NetworkX</li>\n      <li><strong>Data Tools:</strong> Nextflow, Snakemake, Docker, Kubernetes</li>\n      <li><strong>Analysis:</strong> MATLAB, Jupyter, Seurat, Scanpy</li>\n      <li><strong>Visualization:</strong> D3.js, Plotly, Matplotlib</li>\n    </ul>\n\n    <h2>Contact</h2>\n    <p class=\"contact\">\n      <strong>Email:</strong> lydia.moreno@riverbend.edu<br>\n      <strong>Office:</strong> Blakely Hall, Room 312, Riverbend University<br>\n      <strong>Twitter:</strong> <a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a><br>\n      <strong>GitHub:</strong> <a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a>\n    </p>\n  </main>\n  <footer>\n    &copy; 2025 Dr. Lydia Moreno &middot; Riverbend University School of Biological Sciences\n  </footer>\n</body>\n</html>\nEOF\n"]
