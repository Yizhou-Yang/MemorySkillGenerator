[85.696774, "i", "cat > blog.html <<'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Blog — Dr. Lydia Moreno</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"wrap\">\n      <h1>Dr. Lydia Moreno</h1>\n      <p>Associate Professor of Computational Neuroscience, Riverbend University</p>\n    </div>\n  </header>\n  <nav class=\"site\">\n    <div class=\"wrap\">\n      <a href=\"index.html\">About Me</a>\n      <a href=\"publications.html\">Publications</a>\n      <a class=\"active\" href=\"blog.html\">Blog</a>\n    </div>\n  </nav>\n  <main>\n    <h2>Blog</h2>\n    <div class=\"post\">\n      <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\n      <div class=\"date\">March 2025</div>\n      <p>A look at how we can make black-box neural decoders transparent enough for neuroscientists to trust, with concrete examples from the DeepVision pipeline.</p>\n    </div>\n    <div class=\"post\">\n      <h3>Bridging Machine Learning and Single-Cell Genomics</h3>\n      <div class=\"date\">January 2025</div>\n      <p>Reflections on integrating scRNA-Seq, ATAC-Seq, and spatial FISH data, and the modeling lessons learned from the CellMap project.</p>\n    </div>\n    <div class=\"post\">\n      <h3>Scaling Graph Neural Networks for Connectomics</h3>\n      <div class=\"date\">November 2024</div>\n      <p>Notes on training GNNs over electron-microscopy reconstructions and the infrastructure needed to scale to whole-brain connectomes.</p>\n    </div>\n  </main>\n  <footer>\n    &copy; 2025 Dr. Lydia Moreno &middot; Riverbend University School of Biological Sciences\n  </footer>\n</body>\n</html>\nEOF\n"]
[85.748158, "o", "cat > blog.html <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> <!DOCTYPE html>\r\n\u001b[?2004l\r\u001b[?2004h> <html lang=\"en\">\r\n\u001b[?2004l\r\u001b[?2004h> <head>\r\n\u001b[?2004l\r\u001b[?2004h>   <meta charset=\"utf-8\">\r\n\u001b[?2004l\r\u001b[?2004h>   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n\u001b[?2004l\r\u001b[?2004h>   <title>Blog — Dr. Lydia Moreno</title>\r\n\u001b[?2004l\r\u001b[?2004h>   <link rel=\"stylesheet\" href=\"css/style.css\">\r\n\u001b[?2004l\r\u001b[?2004h> </head>\r\n\u001b[?2004l\r\u001b[?2004h> <body>\r\n\u001b[?2004l\r\u001b[?2004h>   <header class=\"site\">\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"wrap\">\r\n\u001b[?2004l\r\u001b[?2004h>       <h1>Dr. Lydia Moreno</h1>\r\n\u001b[?2004l\r\u001b[?2004h>       <p>Associate Professor of Computational Neuroscience, Riverbend University</p>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </header>\r\n\u001b[?2004l\r\u001b[?2004h>   <nav class=\"site\">\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"wrap\">\r\n\u001b[?2004l\r\u001b[?2004h>       <a href=\"index.html\">About Me</a>\r\n\u001b[?2004l\r\u001b[?2004h>       <a href=\"publications.html\">Publications</a>\r\n\u001b[?2004l\r\u001b[?2004h>       <a class=\"active\" href=\"blog.html\">Blog</a>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </nav>\r\n\u001b[?2004l\r\u001b[?2004h>   <main>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Blog</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"post\">\r\n\u001b[?2004l\r\u001b[?2004h>       <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\r\n\u001b[?2004l\r\u001b[?2004h>       <div class=\"date\">March 2025</div>\r\n\u001b[?2004l\r\u001b[?2004h>       <p>A look at how we can make black-box neural decoders transparent enough for neuroscientists to trust, with concrete examples from the DeepVision pipeline.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"post\">\r\n\u001b[?2004l\r\u001b[?2004h>       <h3>Bridging Machine Learning and Single-Cell Genomics</h3>\r\n\u001b[?2004l\r\u001b[?2004h>       <div class=\"date\">January 2025</div>\r\n\u001b[?2004l\r\u001b[?2004h>       <p>Reflections on integrating scRNA-Seq, ATAC-Seq, and spatial FISH data, and the modeling lessons learned from the CellMap project.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"post\">\r\n\u001b[?2004l\r\u001b[?2004h>       <h3>Scaling Graph Neural Networks for Connectomics</h3>\r\n\u001b[?2004l\r\u001b[?2004h>       <div class=\"date\">November 2024</div>\r\n\u001b[?2004l\r\u001b[?2004h>       <p>Notes on training GNNs over electron-microscopy reconstructions and the infrastructure needed to scale to whole-brain connectomes.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </main>\r\n\u001b[?2004l\r\u001b[?2004h>   <footer>\r\n\u001b[?2004l\r\u001b[?2004h>     &copy; 2025 Dr. Lydia Moreno &middot; Riverbend University School of Biological Sciences\r\n\u001b[?2004l\r\u001b[?2004h>   </footer>\r\n\u001b[?2004l\r\u001b[?2004h> </body>\r\n\u001b[?2004l\r\u001b[?2004h> </html>\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
