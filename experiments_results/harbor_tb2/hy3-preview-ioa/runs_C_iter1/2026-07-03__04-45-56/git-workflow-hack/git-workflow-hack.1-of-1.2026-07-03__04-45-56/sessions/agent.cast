[85.511357, "i", "cat > publications.html <<'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Publications — Dr. Lydia Moreno</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"wrap\">\n      <h1>Dr. Lydia Moreno</h1>\n      <p>Associate Professor of Computational Neuroscience, Riverbend University</p>\n    </div>\n  </header>\n  <nav class=\"site\">\n    <div class=\"wrap\">\n      <a href=\"index.html\">About Me</a>\n      <a class=\"active\" href=\"publications.html\">Publications</a>\n      <a href=\"blog.html\">Blog</a>\n    </div>\n  </nav>\n  <main>\n    <h2>Publications</h2>\n    <div class=\"pub\">\n      <p>Moreno, L., &amp; Patel, A. (2024). &ldquo;Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals.&rdquo; <em>Journal of Computational Neuroscience</em>, 45(2), 123&ndash;137.</p>\n    </div>\n    <div class=\"pub\">\n      <p>Moreno, L., Zhang, W., &amp; Singh, R. (2023). &ldquo;Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets.&rdquo; <em>Neuroinformatics</em>, 21(4), 299&ndash;312.</p>\n    </div>\n    <div class=\"pub\">\n      <p>Moreno, L. et al. (2022). &ldquo;Integrative Single-Cell Atlas of Human Cerebral Organoids.&rdquo; <em>Cell Systems</em>, 9(1), 67&ndash;82.</p>\n    </div>\n    <div class=\"pub\">\n      <p>Chen, J., Moreno, L., &amp; Russo, M. (2021). &ldquo;Explainable AI Techniques in Neural Decoding.&rdquo; <em>Frontiers in Neuroscience</em>, 15, 756843.</p>\n    </div>\n  </main>\n  <footer>\n    &copy; 2025 Dr. Lydia Moreno &middot; Riverbend University School of Biological Sciences\n  </footer>\n</body>\n</html>\nEOF\n"]
