[51.533601, "i", "cat > css/style.css <<'EOF'\n:root{\n  --bg:#ffffff; --fg:#1f2933; --muted:#52606d; --accent:#1d4e89; --accent2:#2a6f97;\n  --border:#e4e7eb; --light:#f5f7fa;\n}\n*{box-sizing:border-box;}\nbody{\n  margin:0; font-family:Georgia,'Times New Roman',serif; color:var(--fg);\n  background:var(--bg); line-height:1.7; font-size:18px;\n}\na{color:var(--accent); text-decoration:none;}\na:hover{text-decoration:underline;}\nheader.site{\n  background:var(--accent); color:#fff; padding:2.2rem 1rem;\n  border-bottom:4px solid var(--accent2);\n}\nheader.site .wrap{max-width:880px; margin:0 auto;}\nheader.site h1{margin:0 0 .3rem; font-size:2.2rem; letter-spacing:.5px;}\nheader.site p{margin:0; font-style:italic; opacity:.9;}\nnav.site{\n  background:var(--light); border-bottom:1px solid var(--border);\n  position:sticky; top:0; z-index:10;\n}\nnav.site .wrap{\n  max-width:880px; margin:0 auto; display:flex; gap:1.4rem; padding:.7rem 1rem;\n}\nnav.site a{color:var(--fg); font-family:Helvetica,Arial,sans-serif; font-size:.95rem; font-weight:600;}\nnav.site a:hover,nav.site a.active{color:var(--accent); text-decoration:none;}\nmain{max-width:880px; margin:0 auto; padding:2.2rem 1rem 4rem;}\nh2{\n  font-family:Helvetica,Arial,sans-serif; color:var(--accent); font-size:1.4rem;\n  border-bottom:2px solid var(--border); padding-bottom:.3rem; margin-top:2.4rem;\n}\nh3{font-family:Helvetica,Arial,sans-serif; color:var(--accent2); margin-bottom:.2rem;}\nul{margin:.4rem 0 1rem; padding-left:1.3rem;}\nli{margin:.25rem 0;}\n.project, .post, .pub{\n  background:var(--light); border:1px solid var(--border); border-radius:8px;\n  padding:1rem 1.2rem; margin:1rem 0;\n}\n.role{font-family:Helvetica,Arial,sans-serif; color:var(--muted); font-size:.9rem; text-transform:uppercase; letter-spacing:.5px;}\n.contact{font-family:Helvetica,Arial,sans-serif;}\nfooter{max-width:880px; margin:0 auto; padding:1.5rem 1rem 3rem; color:var(--muted); font-size:.85rem; border-top:1px solid var(--border); font-family:Helvetica,Arial,sans-serif;}\n.date{font-family:Helvetica,Arial,sans-serif; color:var(--muted); font-size:.85rem;}\nEOF\n"]
