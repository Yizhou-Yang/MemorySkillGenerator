[215.751186, "i", "cat > /app/proto.py <<'EOF'\nimport struct, zlib, zipfile\n\nzf = zipfile.ZipFile('/app/model.pth')\nnames = ['input_layer.weight','input_layer.bias','hidden_layer.weight','hidden_layer.bias','output_layer.weight','output_layer.bias']\nkeys = ['simple_mnist/data/%d'%i for i in range(6)]\nW = {}\nfor n,k in zip(names,keys):\n    raw = zf.read(k)\n    W[n] = list(struct.unpack('<%df'%(len(raw)//4), raw))\nprint('shapes', [len(W[n]) for n in names])\n\ndef decode_png(path):\n    data = open(path,'rb').read()\n    assert data[:8]==b'\\x89PNG\\r\\n\\x1a\\n'\n    pos=8; width=height=ct=None; idat=b''\n    while pos < len(data):\n        ln=int.from_bytes(data[pos:pos+4],'big'); typ=data[pos+4:pos+8]; cpos=pos+8\n        if typ==b'IHDR':\n            width=int.from_bytes(data[cpos:cpos+4],'big'); height=int.from_bytes(data[cpos+4:cpos+8],'big')\n            ct=data[cpos+9]\n        elif typ==b'IDAT': idat+=data[cpos:cpos+ln]\n        elif typ==b'IEND': break\n        pos=cpos+ln+4\n    raw=zlib.decompress(idat)\n    ch={0:1,2:3,6:4}[ct]; stride="]
[215.751364, "o", "cat > /app/proto.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct, zlib, zipfile\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.751389, "i", "width*ch\n    prev=bytearray(stride); out=[]; rp=0\n    for y in range(height):\n        f=raw[rp]; rp+=1\n        line=bytearray(raw[rp:rp+stride]); rp+=stride\n        for i in range(stride):\n            a=line[i-ch] if i>=ch else 0; b=prev[i]; c=prev[i-ch] if i>=ch else 0; v=line[i]\n            if f==0: pass\n            elif f==1: v=(v+a)&255\n            elif f==2: v=(v+b)&255\n            elif f==3: v=(v+((a+b)>>1))&255\n            elif f==4:\n                p=a+b-c; pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\n                pr=a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\n                v=(v+pr)&255\n            line[i]=v\n        prev=line; out.extend(line)\n    return width,height,ch,out\n\nw,h,ch,pix=decode_png('/app/image.png')\nprint('png',w,h,ch)\ngray=[pix[i*ch] for i in range(w*h)]\n\ndef infer(x):\n    def mm(Wt,xin):\n        o=len(Wt); inn=len(xin); out=[0.0]*o\n        for r in range(o):\n            s=0.0\n            for c in range(inn): s+=Wt[r*inn+c]*xin[c]\n            out[r]=s\n        return out\n    z=mm(W"]
[215.751418, "i", "['input_layer.weight'],x); z=[v+W['input_layer.bias'][i] for i,v in enumerate(z)]; z=[max(0.0,v) for v in z]\n    z=mm(W['hidden_layer.weight'],z); z=[v+W['hidden_layer.bias'][i] for i,v in enumerate(z)]; z=[max(0.0,v) for v in z]\n    z=mm(W['output_layer.weight'],z); z=[v+W['output_layer.bias'][i] for i,v in enumerate(z)]\n    return z.index(max(z))\n\nx1=[v/255.0 for v in gray]\nprint('pred /255      :', infer(x1))\nx2=[(v/255.0-0.1307)/0.3081 for v in gray]\nprint('pred normalize :', infer(x2))\nEOF\npython3 /app/proto.py\n"]
