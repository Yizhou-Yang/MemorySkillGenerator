[292.784125, "i", "cat > /app/convert.py <<'EOF'\nimport struct, zipfile, json\nzf = zipfile.ZipFile('/app/model.pth')\nnames = ['input_layer.weight','input_layer.bias','hidden_layer.weight','hidden_layer.bias','output_layer.weight','output_layer.bias']\nkeys = ['simple_mnist/data/%d'%i for i in range(6)]\nW = {}\nfor n,k in zip(names,keys):\n    raw = zf.read(k)\n    W[n] = list(struct.unpack('<%df'%(len(raw)//4), raw))\nout = {}\nfor n in names:\n    out[n] = W[n]\nwith open('/app/weights.json','w') as f:\n    json.dump(out, f)\nprint('wrote weights.json with', sum(len(v) for v in W.values()), 'values')\nEOF\npython3 /app/convert.py\n"]
[292.784821, "o", "cat > /app/convert.py <<'EOF'"]
