[215.759675, "o", "    ch={0:1,2:3,6:4}[ct]; stride=width*ch\r\n\u001b[?2004l\r\u001b[?2004h>     prev=bytearray(stride); out=[]; rp=0\r\n\u001b[?2004l\r\u001b[?2004h>     for y in range(height):\r\n\u001b[?2004l\r\u001b[?2004h>         f=raw[rp]; rp+=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.760291, "o", "        line=bytearray(raw[rp:rp+stride]); rp+=stride\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.761175, "o", "        for i in range(stride):\r\n\u001b[?2004l\r\u001b[?2004h>             a=line[i-ch] if i>=ch else 0; b=prev[i]; c=prev[i-ch] if i>=ch else 0; v=line[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.762028, "o", "            if f==0: pass"]
[215.762149, "o", "\r\n\u001b[?2004l\r"]
[215.762933, "o", "\u001b[?2004h"]
[215.763129, "o", ">             elif f==1: v=(v+a)&255\r\n"]
[215.763152, "o", "\u001b[?2004l\r"]
[215.763315, "o", "\u001b[?2004h> "]
[215.763456, "o", "            elif f==2: v=(v+b)&255\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.763658, "o", "            elif f==3: v=(v+((a+b)>>1))&255\r\n\u001b[?2004l\r"]
[215.763685, "o", "\u001b[?2004h> "]
[215.763901, "o", "            elif f==4:\r\n\u001b[?2004l\r"]
[215.764183, "o", "\u001b[?2004h> "]
[215.764781, "o", "                p=a+b-c; pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.765108, "o", "                pr=a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\r\n\u001b[?2004l\r"]
[215.765357, "o", "\u001b[?2004h> "]
[215.765395, "o", "                v=(v+pr)&255\r\n\u001b[?2004l\r\u001b[?2004h>             line[i]=v\r\n\u001b[?2004l\r"]
[215.768664, "o", "\u001b[?2004h>         prev=line; out.extend(line)\r\n\u001b[?2004l\r\u001b[?2004h>     return width,height,ch,out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> w,h,ch,pix=decode_png('/app/image.png')\r\n\u001b[?2004l\r\u001b[?2004h> print('png',w,h,ch)\r\n\u001b[?2004l\r\u001b[?2004h> gray=[pix[i*ch] for i in range(w*h)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def infer(x):\r\n\u001b[?2004l\r\u001b[?2004h>     def mm(Wt,xin):\r\n\u001b[?2004l\r\u001b[?2004h>         o=len(Wt); inn=len(xin); out=[0.0]*o\r\n\u001b[?2004l\r\u001b[?2004h>         for r in range(o):\r\n\u001b[?2004l\r\u001b[?2004h>             s=0.0\r\n\u001b[?2004l\r\u001b[?2004h>             for c in range(inn): s+=Wt[r*inn+c]*xin[c]\r\n\u001b[?2004l\r\u001b[?2004h>             out[r]=s\r\n\u001b[?2004l\r\u001b[?2004h>         return out\r\n\u001b[?2004l\r\u001b[?2004h>     z=mm(W['input_layer.weight'],x); z=[v+W['input_layer.bias'][i] for i,v in enumerate(z)]; z=[max(0.0,v) for v in z]\r\n\u001b[?2004l\r\u001b[?2004h>     z=mm(W['hidden_layer.weight'],z); z=[v+W['hidden_layer.bias'][i] for i,v in enumerate(z)]; z=[max(0.0,v) for v in z]\r\n\u001b[?2004l\r\u001b[?2004h>     z=mm(W['output_layer.weight'],z); z=[v+W['out"]
[215.768718, "o", "put_layer.bias'][i] for i,v in enumerate(z)]\r\n\u001b[?2004l\r\u001b[?2004h>     return z.index(max(z))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> x1=[v/255.0 for v in gray]\r\n\u001b[?2004l\r\u001b[?2004h> print('pred /255      :', infer(x1))\r\n\u001b[?2004l\r\u001b[?2004h> x2=[(v/255.0-0.1307)/0.3081 for v in gray]\r\n\u001b[?2004l\r\u001b[?2004h> print('pred normalize :', infer(x2))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
