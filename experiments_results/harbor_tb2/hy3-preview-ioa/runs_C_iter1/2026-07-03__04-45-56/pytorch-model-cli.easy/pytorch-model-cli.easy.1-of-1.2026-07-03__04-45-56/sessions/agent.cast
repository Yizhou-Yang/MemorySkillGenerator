[293.9424, "i", "cat > /app/main.c <<'EOF'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include \"cJSON.h\"\n#include \"lodepng.h\"\n\nstatic double* load_array(cJSON* root, const char* key, int* nout) {\n    cJSON* item = cJSON_GetObjectItem(root, key);\n    if (!item || !cJSON_IsArray(item)) { fprintf(stderr, \"missing %s\\n\", key); exit(1); }\n    int n = cJSON_GetArraySize(item);\n    double* arr = (double*)malloc(sizeof(double)*n);\n    cJSON* e; int i = 0;\n    cJSON_ArrayForEach(e, item) { arr[i++] = e->valuedouble; }\n    if (nout) *nout = n;\n    return arr;\n}\n\nint main(int argc, char** argv) {\n    if (argc < 3) { fprintf(stderr, \"usage: %s weights.json image.png\\n\", argv[0]); return 1; }\n    FILE* f = fopen(argv[1], \"rb\");\n    if (!f) { perror(\"fopen weights\"); return 1; }\n    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);\n    char* buf = (char*)malloc(sz + 1);\n    if (fread(buf, 1, sz, f) != (size_t)sz) { fprintf(stderr, \"read error\\n\"); return 1; }\n    buf[sz] = 0; fclose(f);\n   "]
[293.942473, "i", " cJSON* root = cJSON_Parse(buf);\n    if (!root) { fprintf(stderr, \"json parse error\\n\"); return 1; }\n\n    int n_w1,n_b1,n_w2,n_b2,n_w3,n_b3;\n    double* w1 = load_array(root, \"input_layer.weight\", &n_w1);\n    double* b1 = load_array(root, \"input_layer.bias\", &n_b1);\n    double* w2 = load_array(root, \"hidden_layer.weight\", &n_w2);\n    double* b2 = load_array(root, \"hidden_layer.bias\", &n_b2);\n    double* w3 = load_array(root, \"output_layer.weight\", &n_w3);\n    double* b3 = load_array(root, \"output_layer.bias\", &n_b3);\n\n    unsigned char* img = NULL; unsigned w, h;\n    unsigned err = lodepng_decode32_file(&img, &w, &h, argv[2]);\n    if (err) { fprintf(stderr, \"png error %s\\n\", lodepng_error_text(err)); return 1; }\n    int N = (int)(w * h);\n    if (N != n_w1) { fprintf(stderr, \"expected %d pixels, got %d\\n\", n_w1, N); return 1; }\n    double* x = (double*)malloc(sizeof(double)*N);\n    for (int i = 0; i < N; i++) x[i] = img[i*4] / 255.0;\n\n    double* h1 = (double*)malloc(sizeof(double)*n_b1);\n    for (int o = 0; o"]
[293.942519, "i", " < n_b1; o++) { double s = b1[o]; for (int c = 0; c < N; c++) s += w1[o*N + c] * x[c]; h1[o] = s > 0 ? s : 0; }\n    double* h2 = (double*)malloc(sizeof(double)*n_b2);\n    for (int o = 0; o < n_b2; o++) { double s = b2[o]; for (int c = 0; c < n_b1; c++) s += w2[o*n_b1 + c] * h1[c]; h2[o] = s > 0 ? s : 0; }\n    double* h3 = (double*)malloc(sizeof(double)*n_b3);\n    for (int o = 0; o < n_b3; o++) { double s = b3[o]; for (int c = 0; c < n_b2; c++) s += w3[o*n_b2 + c] * h2[c]; h3[o] = s; }\n\n    int best = 0; for (int o = 1; o < n_b3; o++) if (h3[o] > h3[best]) best = o;\n    printf(\"%d\\n\", best);\n    return 0;\n}\nEOF\n"]
