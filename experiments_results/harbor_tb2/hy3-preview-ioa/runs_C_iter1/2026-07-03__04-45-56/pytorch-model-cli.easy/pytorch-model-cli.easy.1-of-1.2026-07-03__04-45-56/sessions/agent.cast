[489.0043, "i", "apt-get install --print-uris -y build-essential | grep \"^'\" | sed \"s/^'\\([^']*\\)'.*/\\1/\" > /app/urls.txt; wc -l /app/urls.txt\n"]
[489.005342, "o", "apt-get install --print-uris -y build-essential | grep \"^'\" | sed \"s/^'\\([^']*\\)'.*/\\1/\" > /app/urls.txt; wc -l /app/urls.txt\r\n\u001b[?2004l\r"]
[490.989681, "i", "python3 - <<'EOF'\nimport urllib.request\nn=0\nfor line in open('/app/urls.txt'):\n    url=line.strip()\n    if not url: continue\n    fn='/app/'+url.rsplit('/',1)[-1]\n    try:\n        urllib.request.urlretrieve(url, fn)\n        n+=1\n    except Exception as e:\n        print('FAIL', url, e)\nprint('downloaded', n)\nEOF\n"]
[490.990005, "o", "python3 - <<'EOF'\r\nimport urllib.request\r\nn=0\r\nfor line in open('/app/urls.txt'):\r\n    url=line.strip()\r\n    if not url: continue\r\n    fn='/app/'+url.rsplit('/',1)[-1]\r\n    try:\r\n        urllib.request.urlretrieve(url, fn)\r\n        n+=1\r\n    except Exception as e:\r\n        print('FAIL', url, e)\r\nprint('downloaded', n)\r\nEOF\r\n"]
