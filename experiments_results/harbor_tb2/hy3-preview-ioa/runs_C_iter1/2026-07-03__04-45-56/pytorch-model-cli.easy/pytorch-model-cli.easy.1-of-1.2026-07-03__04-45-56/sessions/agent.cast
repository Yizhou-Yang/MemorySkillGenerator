[293.948837, "o", "\u001b[?2004h"]
[293.949448, "o", ">     fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);\r\n\u001b[?2004l\r\u001b[?2004h>     char* buf = (char*)malloc(sz + 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.949821, "o", "    if (fread(buf, 1, sz, f) != (size_t)sz) { fprintf(stderr, \"read error\\n\"); return 1; }"]
[293.949967, "o", "\r\n"]
[293.950111, "o", "\u001b[?2004l\r"]
[293.950267, "o", "\u001b[?2004h"]
[293.950414, "o", "> "]
[293.950624, "o", "    buf[sz] = 0; fclose(f);"]
[293.950978, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     cJSON* root = cJSON_Parse(buf);\r\n\u001b[?2004l\r"]
[293.951007, "o", "\u001b[?2004h"]
[293.951184, "o", "> "]
[293.951385, "o", "    if (!root) { fprintf(stderr, \"json parse error\\n\"); return 1; }"]
[293.95153, "o", "\r\n"]
[293.951671, "o", "\u001b[?2004l\r"]
[293.951846, "o", "\u001b[?2004h"]
[293.952086, "o", "> "]
[293.952414, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     int n_w1,n_b1,n_w2,n_b2,n_w3,n_b3;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.952798, "o", "    double* w1 = load_array(root, \"input_layer.weight\", &n_w1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.95298, "o", "> "]
[293.953467, "o", "    double* b1 = load_array(root, \"input_layer.bias\", &n_b1);\r\n\u001b[?2004l\r\u001b[?2004h>     double* w2 = load_array(root, \"hidden_layer.weight\", &n_w2);"]
[293.953627, "o", "\r\n"]
[293.95373, "o", "\u001b[?2004l\r"]
[293.953942, "o", "\u001b[?2004h"]
[293.954096, "o", "> "]
[293.954398, "o", "    double* b2 = load_array(root, \"hidden_layer.bias\", &n_b2);"]
[293.954538, "o", "\r\n"]
[293.954678, "o", "\u001b[?2004l\r"]
[293.954841, "o", "\u001b[?2004h"]
[293.955037, "o", "> "]
[293.955333, "o", "    double* w3 = load_array(root, \"output_layer.weight\", &n_w3);"]
[293.955477, "o", "\r\n"]
[293.955616, "o", "\u001b[?2004l\r"]
[293.955783, "o", "\u001b[?2004h"]
[293.95596, "o", "> "]
[293.956244, "o", "    double* b3 = load_array(root, \"output_layer.bias\", &n_b3);"]
[293.956384, "o", "\r\n"]
[293.95653, "o", "\u001b[?2004l\r"]
[293.956691, "o", "\u001b[?2004h"]
[293.956833, "o", "> "]
[293.957009, "o", "\r\n"]
[293.957145, "o", "\u001b[?2004l\r"]
[293.957297, "o", "\u001b[?2004h"]
[293.95744, "o", "> "]
[293.957687, "o", "    unsigned char* img = NULL; unsigned w, h;"]
[293.957824, "o", "\r\n"]
[293.958025, "o", "\u001b[?2004l\r"]
[293.958187, "o", "\u001b[?2004h"]
[293.958328, "o", "> "]
[293.958604, "o", "    unsigned err = lodepng_decode32_file(&img, &w, &h, argv[2]);"]
[293.958744, "o", "\r\n"]
[293.95892, "o", "\u001b[?2004l\r"]
[293.959085, "o", "\u001b[?2004h"]
[293.959232, "o", "> "]
[293.959602, "o", "    if (err) { fprintf(stderr, \"png error %s\\n\", lodepng_error_text(err)); return 1; }"]
[293.959746, "o", "\r\n"]
[293.95993, "o", "\u001b[?2004l\r"]
[293.960148, "o", "\u001b[?2004h"]
[293.960928, "o", ">     int N = (int)(w * h);\r\n\u001b[?2004l\r\u001b[?2004h>     if (N != n_w1) { fprintf(stderr, \"expected %d pixels, got %d\\n\", n_w1, N); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     double* x = (double*)malloc(sizeof(double)*N);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.960999, "o", "    for (int i = 0; i < N; i++) x[i] = img[i*4] / 255.0;\r\n\u001b[?2004l\r"]
[293.961278, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[293.961304, "o", "\u001b[?2004h"]
[293.961882, "o", ">     double* h1 = (double*)malloc(sizeof(double)*n_b1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.961922, "o", "    for (int o = 0; o < n_b1; o++) { double s = b1[o]; for (int c = 0; c < N; c++) s += w1[o*N + c] * x[c]; h1[o] = s > 0 ? s : 0; }\r\n\u001b[?2004l\r"]
[293.962116, "o", "\u001b[?2004h> "]
[293.962429, "o", "    double* h2 = (double*)malloc(sizeof(double)*n_b2);\r\n"]
[293.962456, "o", "\u001b[?2004l\r"]
[293.962728, "o", "\u001b[?2004h> "]
[293.963168, "o", "    for (int o = 0; o < n_b2; o++) { double s = b2[o]; for (int c = 0; c < n_b1; c++) s += w2[o*n_b1 + c] * h1[c]; h2[o] = s > 0 ? s : 0; }\r\n\u001b[?2004l\r"]
[293.963191, "o", "\u001b[?2004h> "]
[293.964586, "o", "    double* h3 = (double*)malloc(sizeof(double)*n_b3);\r\n\u001b[?2004l\r\u001b[?2004h>     for (int o = 0; o < n_b3; o++) { double s = b3[o]; for (int c = 0; c < n_b2; c++) s += w3[o*n_b2 + c] * h2[c]; h3[o] = s; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int best = 0; for (int o = 1; o < n_b3; o++) if (h3[o] > h3[best]) best = o;\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"%d\\n\", best);\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[293.975296, "o", "\u001b[?2004h"]
[293.975353, "o", "root@18ca25fadf71:/app# "]
