[23.985936, "o", "\u001b[?2004l\r"]
[23.988997, "o", "import torch\r"]
[23.989277, "o", "\r\n"]
[23.989469, "o", "import torch.nn as nn\r\r\n\r\r\n\r\r\nclass MnistModel(nn.Module):\r\r\n    def __init__(\r\r\n        self,\r\r\n        input_dim: int,\r\r\n        hidden_dim: int,\r\r\n        num_classes: int,\r\r\n    ) -> torch.nn.Module:\r\r\n        super().__init__()\r\r\n\r\r\n        self.input_layer = nn.Linear(input_dim, hidden_dim)\r\r\n        self.hidden_layer = nn.Linear(hidden_dim, hidden_dim)\r"]
[23.989661, "o", "\r\n"]
[23.98984, "o", "        self.output_layer = nn.Linear(hidden_dim, num_classes)\r"]
[23.990165, "o", "\r\n"]
[23.990486, "o", "        self.activation = nn.ReLU()\r"]
[23.990849, "o", "\r\n"]
[23.991266, "o", "\r"]
[23.991529, "o", "\r\n"]
[23.991703, "o", "    def forward(self, x):\r"]
[23.991849, "o", "\r\n"]
[23.992044, "o", "        x = self.input_layer(x)\r"]
[23.992212, "o", "\r\n"]
[23.992375, "o", "        x = self.activation(x)\r"]
[23.992604, "o", "\r\n"]
[23.992796, "o", "\r"]
[23.99299, "o", "\r\n        x = self.hidden_layer(x)\r\r\n        x = self.activation(x)\r\r\n\r\r\n        x = self.output_layer(x)\r\r\n        return x\r\r\n"]
[23.993731, "o", "\u001b[?2004hroot@18ca25fadf71:/app# "]
