[196.00979, "i", "cat > /app/launch.sh <<'EOF'\n#!/bin/sh\ncd /app\nnohup qemu-system-x86_64 \\\n  -m 2048 -smp 2 \\\n  -cdrom /app/alpine.iso \\\n  -drive file=/app/alpine-disk.qcow2,if=virtio,format=qcow2 \\\n  -netdev user,id=net0,hostfwd=tcp::2222-:22 \\\n  -device e1000,netdev=net0 \\\n  -display none \\\n  -serial telnet:127.0.0.1:4545,server,nowait \\\n  -monitor none \\\n  > /app/qemu.log 2>&1 &\necho \"launched qemu pid $!\"\nEOF\nchmod +x /app/launch.sh\n"]
