[541.520783, "o", "^[[40;14R"]
[541.820715, "o", "\r\n===CMD: sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/; s/^#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config===\r\nsed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/; s/^#PasswordAut\r\r\r\nhentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config\r\r\nlocalhost:~# \u001b[6n"]
