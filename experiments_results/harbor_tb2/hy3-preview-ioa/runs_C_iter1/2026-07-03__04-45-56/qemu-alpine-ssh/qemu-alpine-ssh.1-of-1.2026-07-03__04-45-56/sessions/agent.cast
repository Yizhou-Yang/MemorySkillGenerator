[367.03841, "o", "\r\r\r\nWelcome to Alpine Linux 3.19\r\r\n\rKernel 6.6.4-1-lts on an x86_64 (/dev/ttyS0)\r\r\n\r\r\r\n\rlocalhost login: \r\n>>> LOGIN PROMPT DETECTED <<<\r\n\r\n>>> PROBE_DONE got_login=True <<<\r\n"]
[367.053724, "m", "Episode 5: 2 commands"]
[367.053724, "o", "\u001b[?2004hroot@411fe746526f:/app# "]
[413.612727, "i", "cat > /app/run_batch.py <<'PY'\nimport telnetlib, time, sys\n\ndef expect(tn, pat, timeout=40):\n    end=time.time()+timeout\n    buf=b''\n    while time.time()<end:\n        try:\n            d=tn.read_very_eager()\n        except Exception:\n            d=b''\n        if d:\n            buf+=d\n            if pat in buf:\n                return buf\n        time.sleep(0.05)\n    return buf\n\ntn=telnetlib.Telnet('127.0.0.1',4545,timeout=30)\ntime.sleep(0.5)\ntn.read_very_eager()\ntn.write(b'root\\n')\nbuf=expect(tn,b'localhost:~#',timeout=25)\nsys.stdout.buffer.write(b'---LOGIN---\\n'+buf)\nsys.stdout.buffer.flush()\n\nfor line in sys.stdin:\n    cmd=line.rstrip('\\n').encode()\n    if not cmd.strip():\n        continue\n    tn.write(cmd+b'\\n')\n    time.sleep(0.3)\n    out=expect(tn,b'localhost:~#',timeout=45)\n    sys.stdout.buffer.write(b'\\n===CMD: '+cmd+b'===\\n')\n    sys.stdout.buffer.write(out)\n    sys.stdout.buffer.flush()\n\ntn.write(b'exit\\n')\nPY\n"]
[413.613751, "o", "cat > /app/run_batch.py <<'PY'\r\n\u001b[?2004l\r"]
[413.614055, "o", "\u001b[?2004h> import telnetlib, time, sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def expect(tn, pat, timeout=40):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.61429, "o", "    end=time.time()+timeout\r\n\u001b[?2004l\r\u001b[?2004h>     buf=b''\r\n\u001b[?2004l\r\u001b[?2004h>     while time.time()<end:\r\n\u001b[?2004l\r\u001b[?2004h> "]
