[585.759549, "i", "cat > /app/test_ssh.py <<'PY'\nimport pty, os, time, sys, select\ncmd=['ssh','-p','2222','-o','StrictHostKeyChecking=no','-o','UserKnownHostsFile=/dev/null','-o','PreferredAuthentications=password','-o','PubkeyAuthentication=no','root@localhost','id; hostname; echo MARKER_DONE']\npid, fd = pty.fork()\nif pid==0:\n    os.execvp('ssh', cmd)\nbuf=b''\nend=time.time()+30\nsent=False\nwhile time.time()<end:\n    r,_,_=select.select([fd],[],[],0.5)\n    if r:\n        try:\n            d=os.read(fd,4096)\n        except OSError:\n            break\n        if d:\n            buf+=d\n            sys.stdout.buffer.write(d); sys.stdout.buffer.flush()\n            if (not sent) and b'assword:' in buf:\n                os.write(fd,b'password123\\n'); sent=True\n            if b'MARKER_DONE' in buf:\n                break\nprint('\\n=== TEST_DONE sent_password=%s ===' % sent)\nPY\n"]
[585.759622, "o", "cat > /app/test_ssh.py <<'PY'"]
