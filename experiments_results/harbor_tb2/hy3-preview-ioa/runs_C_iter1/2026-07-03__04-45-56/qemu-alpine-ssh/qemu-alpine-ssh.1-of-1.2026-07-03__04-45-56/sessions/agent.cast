[325.186092, "i", "cat > /app/probe.py <<'PY'\nimport telnetlib, time, sys\ntry:\n    tn = telnetlib.Telnet('127.0.0.1', 4545, timeout=30)\nexcept Exception as e:\n    print('connect error', e); sys.exit(1)\nbuf=b''\nend=time.time()+120\ngot=False\nwhile time.time()<end:\n    try:\n        d=tn.read_very_eager()\n    except Exception:\n        d=b''\n    if d:\n        buf+=d\n        sys.stdout.buffer.write(d); sys.stdout.buffer.flush()\n        if b'login:' in buf:\n            got=True\n            print('\\n>>> LOGIN PROMPT DETECTED <<<')\n            break\n    time.sleep(0.1)\nprint('\\n>>> PROBE_DONE got_login=%s <<<' % got)\nPY\n"]
