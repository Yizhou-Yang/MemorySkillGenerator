[527.821229, "i", "printf '%s\\n' \"echo 'root:password123' | chpasswd\" 'ssh-keygen -A' \"sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/; s/^#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config\" 'grep -E \"PermitRootLogin|PasswordAuthentication\" /etc/ssh/sshd_config' '/usr/sbin/sshd' 'sleep 1; ps w | grep -v grep | grep sshd' 'netstat -tln 2>/dev/null | grep :22 || ss -tln 2>/dev/null | grep :22' | python3 /app/run_batch.py\n"]
[527.822965, "o", "printf '%s\\n' \"echo 'root:password123' | chpasswd\" 'ssh-keygen -A' \"sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/; s/^#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config\" 'grep -E \"PermitRootLogin|PasswordAuthentication\" /etc/ssh/sshd_config' '/usr/sbin/sshd' 'sleep 1; ps w | grep -v grep | grep sshd' 'netstat -tln 2>/dev/null | grep :22 || ss -tln 2>/dev/null | grep :22' | python3 /app/run_batch.py\r\n"]
