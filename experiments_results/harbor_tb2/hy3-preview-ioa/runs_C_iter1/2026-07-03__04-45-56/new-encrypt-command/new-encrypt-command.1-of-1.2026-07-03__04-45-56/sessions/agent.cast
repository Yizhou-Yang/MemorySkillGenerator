[36.840823, "o", "#!/usr/bin/env python3"]
[36.841593, "o", "\r\n"]
[36.841828, "o", "import argparse"]
[36.84209, "o", "\r\n"]
[36.842685, "o", "import os"]
[36.872156, "o", "\r\n"]
[36.8742, "o", "import sys"]
[36.87584, "o", "\r\n"]
[36.877072, "o", "\r\n"]
[36.87824, "o", "\r\n"]
[36.879276, "o", "def encrypt(input_file, protocol='rev'):"]
[36.880282, "o", "\r\n"]
[36.881725, "o", "    \"\"\"Naively encrypts the content of the file and returns it as a string.\"\"\""]
[36.883657, "o", "\r\n"]
[36.885382, "o", "    with open(input_file, 'r') as file:"]
[36.886676, "o", "\r\n"]
[36.887769, "o", "        content = file.read()"]
[36.888841, "o", "\r\n"]
[36.889751, "o", "\r\n"]
[36.890643, "o", "    if protocol == 'rev':"]
[36.891528, "o", "\r\n"]
[36.892481, "o", "        return content[::-1]"]
[36.893251, "o", "\r\n"]
[36.894124, "o", "    elif protocol == 'doub':"]
[36.895098, "o", "\r\n"]
[36.895983, "o", "        return content * 2"]
[36.896859, "o", "\r\n"]
[36.89762, "o", "    elif protocol == 'cap':"]
[36.898461, "o", "\r\n"]
[36.899905, "o", "        return content.upper()"]
[36.900126, "o", "\r\n"]
[36.900306, "o", "    else:"]
[36.900405, "o", "\r\n        raise ValueError(f\"Invalid protocol: {protocol}\")\r\n\r\n"]
[36.900627, "o", "def main():\r\n    # Parse command-line arguments\r\n    parser = argparse.ArgumentParser(add_help=False)\r\n    parser.add_argument('input_files', nargs='+', help='Input files to encrypt')\r\n"]
[36.90071, "o", "\r\n"]
[36.900731, "o", "    parser.add_argument("]
[36.900883, "o", "\r\n        '-o', '--output',"]
[36.900979, "o", "\r\n        default=None,"]
[36.901172, "o", "\r\n        help='Output file to write the encrypted content'\r\n    )\r\n    parser.add_argument('-p', '--protocol',\r\n        default='doub',\r\n"]
[36.901336, "o", "        help='Encryption protocol to use (rev, doub, cap).'\r\n"]
[36.901369, "o", "    )\r\n    parser.add_argument('-v', '--version',\r\n"]
[36.901575, "o", "        action='store_true',\r\n        help='Output version information and exit'\r\n    )\r\n    args = parser.parse_args()\r\n"]
[36.901762, "o", "\r\n    output_file = args.output\r\n    input_files = args.input_files\r\n"]
[36.901871, "o", "\r\n    if args.version:\r\n"]
[36.901961, "o", "        print(\"rencrypt 1.0\")\r\n        sys.exit(0)\r\n\r\n    if not input_files:\r\n        print(\"Error: No input files provided.\")\r\n        sys.exit(1)\r\n\r\n    # Process each file\r\n    encrypted_contents = []\r\n    for input_file in input_files:\r\n        if not os.path.exists(input_file):\r\n            print(f\"Error: File '{input_file}' not found.\")\r\n            sys.exit(1)\r\n\r\n        encrypted_contents.append(encrypt(input_file, protocol=args.protocol))\r\n\r\n    # Output the encrypted contents\r\n    os.makedirs(os.path.dirname(output_file), exist_ok=True)\r\n    if output_file:\r\n        with open(output_file, 'w') as out_file:\r\n            out_file.write(\"\\n\".join(encrypted_contents))\r\n        print(f\"Encrypted content written to '{output_file}'\")\r\n    else:\r\n        print(\"\\n\".join(encrypted_contents))\r\n\r\nif __name__ == \"__main__\":\r\n    main()"]
