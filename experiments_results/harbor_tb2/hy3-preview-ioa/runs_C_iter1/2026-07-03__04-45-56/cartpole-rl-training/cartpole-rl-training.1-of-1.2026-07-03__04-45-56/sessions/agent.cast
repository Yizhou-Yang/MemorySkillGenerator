[169.034916, "i", "cat > /app/agent.py <<'PYEOF'\nimport os\nimport random\n\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport gymnasium as gym\n\nMODEL_FILENAME = 'qnet.pt'\n\n\nclass QNetwork(nn.Module):\n    def __init__(self, state_dim=4, action_dim=2, hidden=128):\n        super().__init__()\n        self.fc1 = nn.Linear(state_dim, hidden)\n        self.fc2 = nn.Linear(hidden, hidden)\n        self.fc3 = nn.Linear(hidden, action_dim)\n\n    def forward(self, x):\n        x = F.relu(self.fc1(x))\n        x = F.relu(self.fc2(x))\n        return self.fc3(x)\n\n\nclass ReplayBuffer:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.buffer = []\n\n    def push(self, state, action, reward, next_state, done):\n        if len(self.buffer) >= self.capacity:\n            self.buffer.pop(0)\n        self.buffer.append((state, action, reward, next_state, done))\n\n    def sample(self, batch_size):\n        return random.sample(self.buffer, batch_size)\n\n    def __len__(self):\n        return l"]
[169.0357, "o", "cat > /app/agent.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import random\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h> import gymnasium as gym\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> MODEL_FILENAME = 'qnet.pt'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class QNetwork(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, state_dim=4, action_dim=2, hidden=128):\r\n\u001b[?2004l\r\u001b[?2004h>         super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h>         self.fc1 = nn.Linear(state_dim, hidden)\r\n\u001b[?2004l\r\u001b[?2004h>         self.fc2 = nn.Linear(hidden, hidden)\r\n\u001b[?2004l\r\u001b[?2004h>         self.fc3 = nn.Linear(hidden, action_dim)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x):"]
[169.035774, "i", "en(self.buffer)\n\n\nclass Agent:\n    def __init__(self, state_dim=4, action_dim=2):\n        self.state_dim = state_dim\n        self.action_dim = action_dim\n        self.device = torch.device('cpu')\n        self.policy_net = QNetwork(state_dim, action_dim).to(self.device)\n        self.policy_net.eval()\n\n    def select_action(self, current_observation):\n        state = torch.as_tensor(np.asarray(current_observation, dtype=np.float32), dtype=torch.float32).to(self.device)\n        if state.dim() == 1:\n            state = state.unsqueeze(0)\n        with torch.no_grad():\n            q_values = self.policy_net(state)\n            action = int(q_values.argmax(dim=1).item())\n        return action\n\n    def save(self, directory):\n        os.makedirs(directory, exist_ok=True)\n        path = os.path.join(directory, MODEL_FILENAME)\n        torch.save(self.policy_net.state_dict(), path)\n\n    def load(self, directory):\n        path = os.path.join(directory, MODEL_FILENAME)\n        state_dict = torch.load(path, map_location=self"]
[169.035906, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         x = F.relu(self.fc1(x))"]
[169.035969, "i", ".device, weights_only=True)\n        self.policy_net.load_state_dict(state_dict)\n        self.policy_net.eval()\n\n    def evaluate(self, env, episodes=20):\n        rewards = []\n        for _ in range(episodes):\n            obs, _ = env.reset()\n            total = 0.0\n            done = False\n            while not done:\n                action = self.select_action(obs)\n                obs, reward, terminated, truncated, _ = env.step(action)\n                total += reward\n                done = terminated or truncated\n            rewards.append(total)\n        return float(np.mean(rewards))\n\n    def train(self, save_dir='/app/trained_model', episodes=3000,\n              batch_size=128, gamma=0.99, lr=1e-3,\n              epsilon_start=1.0, epsilon_final=0.05, epsilon_decay=0.995,\n              target_update=50, buffer_capacity=50000, learn_start=1000,\n              eval_every=25):\n        env = gym.make('CartPole-v1')\n        target_net = QNetwork(self.state_dim, self.action_dim).to(self.device)\n        target_net."]
[169.036131, "o", "\r\n"]
[169.036318, "i", "load_state_dict(self.policy_net.state_dict())\n        optimizer = torch.optim.Adam(self.policy_net.parameters(), lr=lr)\n        buffer = ReplayBuffer(buffer_capacity)\n        epsilon = epsilon_start\n        best_eval = -float('inf')\n        best_state = None\n        step_count = 0\n        for ep in range(episodes):\n            obs, _ = env.reset()\n            total_reward = 0.0\n            done = False\n            while not done:\n                if random.random() < epsilon:\n                    action = env.action_space.sample()\n                else:\n                    action = self.select_action(obs)\n                next_obs, reward, terminated, truncated, _ = env.step(action)\n                done = terminated or truncated\n                buffer.push(obs, action, reward, next_obs, done)\n                obs = next_obs\n                total_reward += reward\n                step_count += 1\n                if len(buffer) >= batch_size and step_count > learn_start:\n                    transitions = buffer.sample"]
[169.036462, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.036504, "i", "(batch_size)\n                    states = torch.as_tensor(np.asarray([t[0] for t in transitions], dtype=np.float32)).to(self.device)\n                    actions = torch.as_tensor([t[1] for t in transitions], dtype=torch.int64).to(self.device)\n                    rewards_t = torch.as_tensor([t[2] for t in transitions], dtype=torch.float32).to(self.device)\n                    next_states = torch.as_tensor(np.asarray([t[3] for t in transitions], dtype=np.float32)).to(self.device)\n                    dones = torch.as_tensor([t[4] for t in transitions], dtype=torch.float32).to(self.device)\n                    q_values = self.policy_net(states).gather(1, actions.unsqueeze(1)).squeeze(1)\n                    with torch.no_grad():\n                        next_q = target_net(next_states).max(dim=1)[0]\n                        target = rewards_t + gamma * next_q * (1 - dones)\n                    loss = F.smooth_l1_loss(q_values, target)\n                    optimizer.zero_grad()\n                    loss.backward()\n       "]
[169.036585, "i", "             torch.nn.utils.clip_grad_norm_(self.policy_net.parameters(), 10)\n                    optimizer.step()\n            epsilon = max(epsilon_final, epsilon * epsilon_decay)\n            if ep % target_update == 0:\n                target_net.load_state_dict(self.policy_net.state_dict())\n            if ep % eval_every == 0 or ep == episodes - 1:\n                eval_score = self.evaluate(env, episodes=20)\n                print('Episode %d: train_reward=%.0f eval=%.1f epsilon=%.3f' % (ep, total_reward, eval_score, epsilon))\n                if eval_score > best_eval:\n                    best_eval = eval_score\n                    best_state = {k: v.detach().clone() for k, v in self.policy_net.state_dict().items()}\n                if eval_score >= 490:\n                    break\n        env.close()\n        if best_state is None:\n            best_state = self.policy_net.state_dict()\n        self.policy_net.load_state_dict(best_state)\n        self.save(save_dir)\n        print('Saved best model (eval=%.1f) to %s"]
[169.036694, "i", "' % (best_eval, save_dir))\n\n\nif __name__ == '__main__':\n    random.seed(0)\n    np.random.seed(0)\n    torch.manual_seed(0)\n    agent = Agent()\n    agent.train()\nPYEOF\n"]
