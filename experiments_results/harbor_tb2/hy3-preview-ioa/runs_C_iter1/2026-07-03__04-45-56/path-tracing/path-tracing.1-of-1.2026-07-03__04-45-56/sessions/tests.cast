[25.083931, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_image_compiles\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m"]
[25.084142, "o", "\r\n"]
[25.084353, "o", "        result = subprocess.run(\u001b[90m\u001b[39;49;00m"]
[25.084562, "o", "\r\n"]
[25.084852, "o", "            [\u001b[33m\"\u001b[39;49;00m\u001b[33mgcc\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m-o\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m/app/image\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m/app/image.c\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m-lm\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m],\u001b[90m\u001b[39;49;00m"]
[25.085125, "o", "\r\n"]
[25.085363, "o", "            capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[25.085577, "o", "\r\n"]
[25.085846, "o", "            text=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
