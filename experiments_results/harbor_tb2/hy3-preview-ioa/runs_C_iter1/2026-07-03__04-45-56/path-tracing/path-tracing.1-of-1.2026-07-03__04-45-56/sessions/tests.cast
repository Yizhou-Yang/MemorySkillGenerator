[25.019888, "o", "\r\n"]
[25.077616, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_image_c_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m"]
[25.078003, "o", "\r\n"]
[25.078256, "o", "        image_c_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/image.c\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m"]
