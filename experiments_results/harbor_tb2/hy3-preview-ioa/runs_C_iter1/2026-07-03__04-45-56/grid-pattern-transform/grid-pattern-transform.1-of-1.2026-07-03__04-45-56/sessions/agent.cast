[25.29225, "i", "cat > /app/grid_transform.py << 'EOF'\ndef solve(input_grid):\n    \"\"\"\n    Transform a 2x2 input grid into a 6x6 output grid.\n\n    Each cell of the input expands into a block, tiled 3x3 times to form\n    the output. Blocks in even block-rows are the original input; blocks\n    in odd block-rows are the horizontally mirrored input.\n    \"\"\"\n    height = len(input_grid)\n    width = len(input_grid[0]) if height else 0\n\n    block_h = height\n    block_w = width\n    tiles = 3\n\n    output_h = height * tiles\n    output_w = width * tiles\n    output_grid = [[0] * output_w for _ in range(output_h)]\n\n    for r in range(output_h):\n        block_row = r // block_h\n        lr = r % block_h\n        for c in range(output_w):\n            lc = c % block_w\n            # mirror horizontally within the block for odd block-rows\n            if block_row % 2 == 1:\n                lc = block_w - 1 - lc\n            output_grid[r][c] = input_grid[lr][lc]\n\n    return output_grid\nEOF\n"]
[25.308506, "o", "cat > /app/grid_transform.py << 'EOF'"]
