[660.333408, "i", "cat > /tmp/dl.py <<'EOF'\nimport urllib.request, concurrent.futures, sys, os\nurls=[u.strip() for u in open('/tmp/urls.txt') if u.strip()]\nos.makedirs('/tmp/debs', exist_ok=True)\ndef get(u):\n    fn='/tmp/debs/'+os.path.basename(u.split('?')[0])\n    for _ in range(3):\n        try:\n            urllib.request.urlretrieve(u, fn); return (u,'ok')\n        except Exception as e:\n            pass\n    return (u,'FAIL')\nwith concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:\n    for u,r in ex.map(get, urls):\n        if r!='ok': print('FAIL',u)\nprint('done', len(urls))\nEOF\npython3 /tmp/dl.py\n"]
