[587.434105, "i", "cat > /tmp/getgcc.sh <<'EOF'\n#!/bin/bash\ngrep -oE \"https?://[^']+\\.deb\" /tmp/uris.txt > /tmp/urls.txt\nmkdir -p /tmp/debs && cd /tmp/debs\nwc -l /tmp/urls.txt\ncat /tmp/urls.txt | xargs -P 8 -n 1 curl -sS -O\nls /tmp/debs/*.deb | wc -l\nfor f in /tmp/debs/*.deb; do dpkg -x \"$f\" / 2>/dev/null; done\nldconfig 2>/dev/null || true\nG=$(ls /usr/bin/*g++-12* 2>/dev/null | head -1); [ -n \"$G\" ] && ln -sf \"$G\" /usr/bin/g++\nC=$(ls /usr/bin/*gcc-12* 2>/dev/null | head -1); [ -n \"$C\" ] && ln -sf \"$C\" /usr/bin/gcc\necho '--- check ---'\nwhich g++ gcc make\nEOF\n"]
