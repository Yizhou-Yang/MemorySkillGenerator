[371.421169, "i", "cat > /app/cli_tool << 'PYEOF'\n#!/usr/bin/env python3\nimport sys, json, zlib, struct\n\nMEAN = 0.1307\nSTD = 0.3081\n\ndef load_weights(path):\n    with open(path) as f:\n        return json.load(f)\n\ndef paeth(a, b, c):\n    p = a + b - c\n    pa = abs(p - a); pb = abs(p - b); pc = abs(p - c)\n    if pa <= pb and pa <= pc:\n        return a\n    elif pb <= pc:\n        return b\n    return c\n\ndef unfilter(bpp, height, stride, data):\n    out = bytearray()\n    prev = bytearray(stride)\n    pos = 0\n    for y in range(height):\n        f = data[pos]; pos += 1\n        row = bytearray(data[pos:pos + stride]); pos += stride\n        for i in range(stride):\n            a = row[i - bpp] if i >= bpp else 0\n            b = prev[i]\n            c = prev[i - bpp] if i >= bpp else 0\n            if f == 1:\n                row[i] = (row[i] + a) & 0xff\n            elif f == 2:\n                row[i] = (row[i] + b) & 0xff\n            elif f == 3:\n                row[i] = (row[i] + ((a + b) >> 1)) & 0xff\n            elif f == 4:\n                "]
[371.421756, "i", "row[i] = (row[i] + paeth(a, b, c)) & 0xff\n        out.extend(row)\n        prev = row\n    return out\n\ndef decode_png(path):\n    with open(path, 'rb') as f:\n        data = f.read()\n    if data[:8] != b'\\x89PNG\\r\\n\\x1a\\n':\n        raise ValueError('not a PNG file')\n    pos = 8\n    width = height = bitdepth = colortype = None\n    idat = bytearray()\n    palette = None\n    while pos < len(data):\n        length = struct.unpack('>I', data[pos:pos + 4])[0]\n        ctype = data[pos + 4:pos + 8].decode('latin1')\n        cdata = data[pos + 8:pos + 8 + length]\n        if ctype == 'IHDR':\n            width, height = struct.unpack('>II', cdata[0:8])\n            bitdepth = cdata[8]\n            colortype = cdata[9]\n        elif ctype == 'PLTE':\n            palette = cdata\n        elif ctype == 'IDAT':\n            idat.extend(cdata)\n        elif ctype == 'IEND':\n            break\n        pos += 12 + length\n    if colortype not in (0, 2, 3, 4, 6) or bitdepth != 8:\n        raise ValueError('unsupported PNG format')\n    channels "]
[371.421917, "o", "cat > /app/cli_tool << 'PYEOF'\r\n\u001b[?2004l\r"]
[371.421973, "i", "= {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}[colortype]\n    stride = width * channels\n    raw = zlib.decompress(bytes(idat))\n    pixels = unfilter(channels, height, stride, raw)\n    gray = [0.0] * (width * height)\n    for y in range(height):\n        base = y * stride\n        for x in range(width):\n            off = base + x * channels\n            if colortype == 0 or colortype == 4:\n                v = pixels[off]\n            elif colortype == 2 or colortype == 6:\n                r = pixels[off]; g = pixels[off + 1]; b = pixels[off + 2]\n                v = int(0.299 * r + 0.587 * g + 0.114 * b)\n            else:\n                v = palette[pixels[off] * 3]\n            gray[y * width + x] = float(v)\n    return width, height, gray\n\ndef resize(gray, w, h, tw=28, th=28):\n    if w == tw and h == th:\n        return gray\n    out = [0.0] * (tw * th)\n    for ty in range(th):\n        sy = (ty + 0.5) * h / th - 0.5\n        y0 = max(0, min(h - 1, int(sy))); y1 = min(h - 1, y0 + 1)\n        fy = sy - y0\n        for tx in range(tw):\n  "]
[371.422026, "i", "          sx = (tx + 0.5) * w / tw - 0.5\n            x0 = max(0, min(w - 1, int(sx))); x1 = min(w - 1, x0 + 1)\n            fx = sx - x0\n            v00 = gray[y0 * w + x0]; v01 = gray[y0 * w + x1]\n            v10 = gray[y1 * w + x0]; v11 = gray[y1 * w + x1]\n            out[ty * tw + tx] = (v00 * (1 - fx) * (1 - fy) + v01 * fx * (1 - fy)\n                              + v10 * (1 - fx) * fy + v11 * fx * fy)\n    return out\n\ndef matvec(W, b, shape, x):\n    odim, idim = shape\n    out = [0.0] * odim\n    for i in range(odim):\n        s = b[i]; base = i * idim\n        for j in range(idim):\n            s += W[base + j] * x[j]\n        out[i] = s\n    return out\n\ndef main():\n    if len(sys.argv) != 3:\n        sys.stderr.write('usage: cli_tool weights.json image.png\\n')\n        sys.exit(1)\n    w = load_weights(sys.argv[1])\n    ww, hh, gray = decode_png(sys.argv[2])\n    img = resize(gray, ww, hh, 28, 28)\n    x = [(p / 255.0 - MEAN) / STD for p in img]\n    h1 = matvec(w['input_layer.weight']['data'], w['input_layer.bias']['d"]
[371.42207, "i", "ata'], w['input_layer.weight']['shape'], x)\n    h1 = [max(0.0, v) for v in h1]\n    h2 = matvec(w['hidden_layer.weight']['data'], w['hidden_layer.bias']['data'], w['hidden_layer.weight']['shape'], h1)\n    h2 = [max(0.0, v) for v in h2]\n    o = matvec(w['output_layer.weight']['data'], w['output_layer.bias']['data'], w['output_layer.weight']['shape'], h2)\n    pred = max(range(10), key=lambda i: o[i])\n    print(pred)\n    with open('/app/prediction.txt', 'w') as f:\n        f.write(str(pred))\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
