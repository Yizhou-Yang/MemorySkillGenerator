[273.453786, "i", "cat > /app/extract_weights.py << 'PYEOF'\nimport sys, json, struct, pickle, zipfile\n\nclass StorageType:\n    def __init__(self, name):\n        n = name.lower()\n        if 'double' in n:\n            self.fmt='d'; self.itemsize=8\n        elif 'long' in n or 'int64' in n:\n            self.fmt='q'; self.itemsize=8\n        elif 'int' in n:\n            self.fmt='i'; self.itemsize=4\n        else:\n            self.fmt='f'; self.itemsize=4\n\nclass Tensor:\n    def __init__(self, data, shape):\n        self.data=list(data); self.shape=list(shape)\n\ndef rebuild_tensor_v2(storage, offset, size, stride, requires_grad, backward_hooks):\n    numel=1\n    for s in size:\n        numel*=s\n    return Tensor(storage[offset:offset+numel], list(size))\n\nclass U(pickle.Unpickler):\n    def __init__(self, file, zf):\n        super().__init__(file); self.zf=zf\n    def find_class(self, module, name):\n        if module=='torch._utils' and name=='_rebuild_tensor_v2':\n            return rebuild_tensor_v2\n        if 'Storage' in name:\n            re"]
[273.454597, "i", "turn StorageType(name)\n        return super().find_class(module, name)\n    def persistent_load(self, pid):\n        if isinstance(pid, tuple) and pid[0]=='storage':\n            st=pid[1]; key=pid[2]; loc=pid[3]; numel=pid[4]\n            if isinstance(key, bytes):\n                key=key.decode()\n            data=self.zf.read('archive/data/'+key)\n            n=len(data)//st.itemsize\n            return list(struct.unpack('<'+str(n)+st.fmt, data))\n        raise pickle.UnpicklingError('persist '+repr(pid))\n\nwith zipfile.ZipFile('/app/model.pth') as zf:\n    pkls=[n for n in zf.namelist() if n.endswith('data.pkl')]\n    with zf.open(pkls[0]) as f:\n        obj=U(f, zf).load()\n\nstate=obj\nif isinstance(obj, dict):\n    for cand in ('state_dict','model','net'):\n        if cand in obj and isinstance(obj[cand], dict):\n            state=obj[cand]; break\n\nout={}\nfor k,v in state.items():\n    out[k]={'shape':v.shape,'data':v.data}\nwith open('/app/weights.json','w') as f:\n    json.dump(out, f)\nprint('loaded params:')\nfor k,v in"]
[273.454804, "i", " out.items():\n    print(' ', k, v['shape'])\nPYEOF\n"]
