[371.435236, "o", "                r = pixels[off]; g = pixels[off + 1]; b = pixels[off + 2]\r\n\u001b[?2004l\r"]
[371.435308, "o", "\u001b[?2004h> "]
[371.435446, "o", "                v = int(0.299 * r + 0.587 * g + 0.114 * b)\r\n\u001b[?2004l\r"]
[371.435467, "o", "\u001b[?2004h> "]
[371.435519, "o", "            else:\r\n\u001b[?2004l\r"]
[371.435565, "o", "\u001b[?2004h> "]
[371.435697, "o", "                v = palette[pixels[off] * 3]\r\n\u001b[?2004l\r"]
[371.435731, "o", "\u001b[?2004h> "]
[371.436162, "o", "            gray[y * width + x] = float(v)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.436268, "o", "> "]
[371.436349, "o", "    return width, height, gray\r\n\u001b[?2004l\r"]
[371.436479, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[371.436509, "o", "\u001b[?2004h> "]
[371.436737, "o", "def resize(gray, w, h, tw=28, th=28):\r\n\u001b[?2004l\r"]
[371.436851, "o", "\u001b[?2004h> "]
[371.437927, "o", "    if w == tw and h == th:"]
[371.438061, "o", "\r\n"]
[371.438186, "o", "\u001b[?2004l\r"]
[371.438336, "o", "\u001b[?2004h"]
[371.438465, "o", "> "]
[371.438635, "o", "        return gray"]
[371.438778, "o", "\r\n"]
[371.438927, "o", "\u001b[?2004l\r"]
[371.439096, "o", "\u001b[?2004h"]
[371.439249, "o", "> "]
[371.43946, "o", "    out = [0.0] * (tw * th)"]
[371.439603, "o", "\r\n"]
[371.43979, "o", "\u001b[?2004l\r"]
[371.439955, "o", "\u001b[?2004h"]
[371.440085, "o", "> "]
[371.440266, "o", "    for ty in range(th):"]
[371.440389, "o", "\r\n"]
[371.440512, "o", "\u001b[?2004l\r"]
[371.440652, "o", "\u001b[?2004h"]
[371.440799, "o", "> "]
[371.441064, "o", "        sy = (ty + 0.5) * h / th - 0.5"]
[371.441214, "o", "\r\n"]
[371.441365, "o", "\u001b[?2004l\r"]
[371.441533, "o", "\u001b[?2004h"]
[371.441688, "o", "> "]
[371.442012, "o", "        y0 = max(0, min(h - 1, int(sy))); y1 = min(h - 1, y0 + 1)"]
[371.442166, "o", "\r\n"]
[371.442317, "o", "\u001b[?2004l\r"]
[371.442484, "o", "\u001b[?2004h"]
[371.44264, "o", "> "]
[371.442868, "o", "        fy = sy - y0"]
[371.443019, "o", "\r\n"]
[371.443167, "o", "\u001b[?2004l\r"]
[371.443341, "o", "\u001b[?2004h"]
[371.443494, "o", "> "]
[371.443707, "o", "        for tx in range(tw):"]
[371.44389, "o", "\r\n"]
[371.444041, "o", "\u001b[?2004l\r"]
[371.444205, "o", "\u001b[?2004h"]
[371.444358, "o", "> "]
[371.444601, "o", "            sx = (tx + 0.5) * w / tw - 0.5"]
[371.444763, "o", "\r\n"]
[371.444931, "o", "\u001b[?2004l\r"]
[371.445098, "o", "\u001b[?2004h"]
[371.445255, "o", "> "]
[371.445563, "o", "            x0 = max(0, min(w - 1, int(sx))); x1 = min(w - 1, x0 + 1)"]
[371.445728, "o", "\r\n"]
[371.445895, "o", "\u001b[?2004l\r"]
[371.446065, "o", "\u001b[?2004h"]
[371.44623, "o", "> "]
[371.446436, "o", "            fx = sx - x0"]
[371.446587, "o", "\r\n"]
[371.446753, "o", "\u001b[?2004l\r"]
[371.446939, "o", "\u001b[?2004h"]
[371.447096, "o", "> "]
[371.44739, "o", "            v00 = gray[y0 * w + x0]; v01 = gray[y0 * w + x1]"]
[371.447541, "o", "\r\n"]
[371.447693, "o", "\u001b[?2004l\r"]
[371.447898, "o", "\u001b[?2004h"]
[371.448056, "o", "> "]
[371.448352, "o", "            v10 = gray[y1 * w + x0]; v11 = gray[y1 * w + x1]"]
[371.448502, "o", "\r\n"]
[371.448652, "o", "\u001b[?2004l\r"]
[371.448859, "o", "\u001b[?2004h"]
[371.449021, "o", "> "]
[371.449353, "o", "            out[ty * tw + tx] = (v00 * (1 - fx) * (1 - fy) + v01 * fx * (1 - fy)"]
[371.449505, "o", "\r\n"]
[371.449656, "o", "\u001b[?2004l\r"]
[371.449854, "o", "\u001b[?2004h"]
[371.450014, "o", "> "]
[371.450317, "o", "                              + v10 * (1 - fx) * fy + v11 * fx * fy)"]
[371.450469, "o", "\r\n"]
[371.450619, "o", "\u001b[?2004l\r"]
[371.450848, "o", "\u001b[?2004h"]
[371.451011, "o", "> "]
[371.45126, "o", "    return out"]
[371.451472, "o", "\r\n"]
[371.45173, "o", "\u001b[?2004l\r"]
[371.452036, "o", "\u001b[?2004h"]
[371.452194, "o", "> "]
[371.452347, "o", "\r\n"]
[371.452498, "o", "\u001b[?2004l\r"]
[371.452667, "o", "\u001b[?2004h"]
[371.45286, "o", "> "]
[371.453956, "o", "def matvec(W, b, shape, x):"]
[371.454117, "o", "\r\n"]
[371.454269, "o", "\u001b[?2004l\r"]
[371.454442, "o", "\u001b[?2004h"]
[371.4546, "o", "> "]
[371.454835, "o", "    odim, idim = shape"]
[371.45499, "o", "\r\n"]
[371.455142, "o", "\u001b[?2004l\r"]
[371.455325, "o", "\u001b[?2004h"]
[371.455483, "o", "> "]
[371.455687, "o", "    out = [0.0] * odim"]
[371.455874, "o", "\r\n"]
[371.456026, "o", "\u001b[?2004l\r"]
[371.456192, "o", "\u001b[?2004h"]
[371.45635, "o", "> "]
[371.456557, "o", "    for i in range(odim):"]
[371.456704, "o", "\r\n"]
[371.456891, "o", "\u001b[?2004l\r"]
[371.457058, "o", "\u001b[?2004h"]
[371.457211, "o", "> "]
[371.457441, "o", "        s = b[i]; base = i * idim"]
[371.45759, "o", "\r\n"]
[371.457759, "o", "\u001b[?2004l\r"]
[371.457942, "o", "\u001b[?2004h"]
[371.458097, "o", "> "]
[371.458313, "o", "        for j in range(idim):"]
[371.458462, "o", "\r\n"]
[371.458609, "o", "\u001b[?2004l\r"]
[371.458799, "o", "\u001b[?2004h"]
[371.458971, "o", "> "]
[371.4592, "o", "            s += W[base + j] * x[j]"]
[371.459347, "o", "\r\n"]
[371.459494, "o", "\u001b[?2004l\r"]
[371.45966, "o", "\u001b[?2004h"]
[371.459845, "o", "> "]
[371.46004, "o", "        out[i] = s"]
[371.460186, "o", "\r\n"]
[371.460347, "o", "\u001b[?2004l\r"]
[371.460526, "o", "\u001b[?2004h> "]
[371.460734, "o", "    return out\r\n\u001b[?2004l\r"]
[371.460923, "o", "\u001b[?2004h> "]
[371.461036, "o", "\r\n\u001b[?2004l\r"]
[371.461219, "o", "\u001b[?2004h> "]
[371.461393, "o", "def main():"]
[371.461538, "o", "\r\n"]
[371.461682, "o", "\u001b[?2004l\r"]
[371.461985, "o", "\u001b[?2004h"]
[371.462094, "o", "> "]
[371.462276, "o", "    if len(sys.argv) != 3:\r\n\u001b[?2004l\r"]
[371.462399, "o", "\u001b[?2004h> "]
[371.462647, "o", "        sys.stderr.write('usage: cli_tool weights.json image.png\\n')\r\n\u001b[?2004l\r"]
[371.462789, "o", "\u001b[?2004h> "]
[371.462961, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[371.463087, "o", "\u001b[?2004h> "]
[371.463277, "o", "    w = load_weights(sys.argv[1])\r\n\u001b[?2004l\r"]
[371.463408, "o", "\u001b[?2004h> "]
[371.463616, "o", "    ww, hh, gray = decode_png(sys.argv[2])\r\n\u001b[?2004l\r"]
[371.463751, "o", "\u001b[?2004h> "]
[371.463968, "o", "    img = resize(gray, ww, hh, 28, 28)\r\n\u001b[?2004l\r"]
[371.464089, "o", "\u001b[?2004h> "]
[371.464306, "o", "    x = [(p / 255.0 - MEAN) / STD for p in img]\r\n\u001b[?2004l\r"]
[371.46443, "o", "\u001b[?2004h> "]
[371.464787, "o", "    h1 = matvec(w['input_layer.weight']['data'], w['input_layer.bias']['data'], w['input_layer.weight']['shape'], x)\r\n\u001b[?2004l\r"]
[371.464937, "o", "\u001b[?2004h> "]
[371.465132, "o", "    h1 = [max(0.0, v) for v in h1]\r\n\u001b[?2004l\r"]
[371.465275, "o", "\u001b[?2004h> "]
[371.465616, "o", "    h2 = matvec(w['hidden_layer.weight']['data'], w['hidden_layer.bias']['data'], w['hidden_layer.weight']['shape'], h1)\r\n\u001b[?2004l\r"]
[371.465756, "o", "\u001b[?2004h> "]
[371.465976, "o", "    h2 = [max(0.0, v) for v in h2]\r\n\u001b[?2004l\r"]
[371.466103, "o", "\u001b[?2004h> "]
[371.466458, "o", "    o = matvec(w['output_layer.weight']['data'], w['output_layer.bias']['data'], w['output_layer.weight']['shape'], h2)\r\n\u001b[?2004l\r"]
[371.466632, "o", "\u001b[?2004h> "]
[371.466886, "o", "    pred = max(range(10), key=lambda i: o[i])\r\n\u001b[?2004l\r"]
[371.467012, "o", "\u001b[?2004h> "]
[371.467166, "o", "    print(pred)\r\n\u001b[?2004l\r"]
[371.467294, "o", "\u001b[?2004h> "]
[371.467519, "o", "    with open('/app/prediction.txt', 'w') as f:\r\n\u001b[?2004l\r"]
[371.467643, "o", "\u001b[?2004h> "]
[371.467853, "o", "        f.write(str(pred))\r\n\u001b[?2004l\r"]
[371.468028, "o", "\u001b[?2004h> "]
[371.468146, "o", "\r\n\u001b[?2004l\r"]
[371.46827, "o", "\u001b[?2004h> "]
[371.468451, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[371.46862, "o", "\u001b[?2004h> "]
[371.468835, "o", "    main()\r\n\u001b[?2004l\r"]
