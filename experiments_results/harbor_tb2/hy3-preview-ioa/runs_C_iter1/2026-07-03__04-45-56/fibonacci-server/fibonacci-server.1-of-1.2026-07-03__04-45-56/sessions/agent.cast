[25.905908, "i", "cat > /app/server.py << 'EOF'\nimport json\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\ndef fib(n):\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/fib':\n            self.send_error(404, 'Not Found')\n            return\n        qs = parse_qs(parsed.query)\n        if 'n' not in qs:\n            self.send_error(400, 'Missing query parameter n')\n            return\n        val = qs['n'][0]\n        try:\n            n = int(val)\n        except (ValueError, TypeError):\n            self.send_error(400, 'n must be an integer')\n            return\n        if n < 0:\n            self.send_error(400, 'n must be non-negative')\n            return\n        body = json.dumps({'result': fib(n)}).encode('utf-8')\n        self.send_response(200)\n        self.send_heade"]
[25.906463, "i", "r('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def log_message(self, *args):\n        pass\n\nif __name__ == '__main__':\n    ThreadingHTTPServer(('0.0.0.0', 3000), Handler).serve_forever()\nEOF\n"]
