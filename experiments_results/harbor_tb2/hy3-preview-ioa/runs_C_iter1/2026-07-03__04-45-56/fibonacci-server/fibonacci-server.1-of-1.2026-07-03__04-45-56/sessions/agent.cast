[36.828126, "i", "python3 -c \"\nimport urllib.request as u, urllib.error as e\ndef test(path):\n    try:\n        r=u.urlopen('http://localhost:3000'+path)\n        print(path,'->',r.status,r.read().decode())\n    except e.HTTPError as ex:\n        print(path,'->',ex.code,ex.read().decode())\ntest('/fib?n=10')\ntest('/fib?n=0')\ntest('/fib')\ntest('/fib?n=abc')\ntest('/fib?n=3.5')\n\"\n"]
