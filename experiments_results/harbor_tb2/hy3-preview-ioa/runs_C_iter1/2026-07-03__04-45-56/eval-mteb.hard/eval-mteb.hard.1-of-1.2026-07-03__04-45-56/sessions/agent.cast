[552.969578, "i", "cat > /usr/local/lib/python3.10/site-packages/sitecustomize.py << 'EOF'\nimport os as _os\n_orig_statvfs = _os.statvfs\n\ndef _patched_statvfs(path):\n    res = _orig_statvfs(path)\n    return _os.statvfs_result((\n        res.f_bsize, res.f_frsize, res.f_blocks,\n        res.f_bfree, res.f_bfree,  # make f_bavail equal f_bfree (real free space)\n        res.f_files, res.f_ffree, res.f_favail,\n        res.f_flag, res.f_namemax,\n    ))\n\n_os.statvfs = _patched_statvfs\nEOF\n"]
