[94.381353, "o", ">         s = s.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if s:\r\n\u001b[?2004l\r\u001b[?2004h>             skill_counts[s] = skill_counts.get(s, 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h> dep_sizes = {d[\"id\"]: len(emp_by_dept.get(d[\"id\"], [])) for d in departments}\r\n\u001b[?2004l\r\u001b[?2004h> status_counts = {}\r\n\u001b[?2004l\r\u001b[?2004h> for p in projects:\r\n\u001b[?2004l\r\u001b[?2004h>     status_counts[p[\"status\"]] = status_counts.get(p[\"status\"], 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h> yos = [int(e[\"years_of_service\"]) for e in employees]\r\n\u001b[?2004l\r\u001b[?2004h> avg_yos = sum(yos) / len(yos) if yos else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> computed = {\r\n\u001b[?2004l\r\u001b[?2004h>     \"averageDepartmentBudget\": sum(budgets) / len(budgets) if budgets else 0,\r\n\u001b[?2004l\r\u001b[?2004h>     \"totalEmployees\": total_employees,\r\n\u001b[?2004l\r\u001b[?2004h>     \"skillDistribution\": skill_counts,\r\n\u001b[?2004l\r\u001b[?2004h>     \"departmentSizes\": dep_sizes,\r\n\u001b[?2004l\r\u001b[?2004h>     \"projectStatusDistribution\": status_counts,\r\n\u001b[?2004l\r\u001b[?2004h>     \"averageYearsOfService\": avg_yos,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b["]
[94.381396, "o", "?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Map to exactly the schema-derived statistic key names\r\n\u001b[?2004l\r\u001b[?2004h> statistics = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.381673, "o", "for key in stat_keys:\r\n"]
[94.381716, "o", "\u001b[?2004l\r"]
[94.38186, "o", "\u001b[?2004h"]
[94.381889, "o", "> "]
[94.382077, "o", "    value = computed[key]\r\n"]
[94.382105, "o", "\u001b[?2004l\r"]
[94.38225, "o", "\u001b[?2004h"]
[94.38228, "o", "> "]
[94.382475, "o", "    node = stat_props[key]"]
[94.382503, "o", "\r\n\u001b[?2004l\r"]
[94.382671, "o", "\u001b[?2004h"]
[94.382713, "o", "> "]
[94.383026, "o", "    if node.get(\"type\") == \"integer\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.383204, "o", "        value = int(value)\r\n\u001b[?2004l\r"]
[94.383233, "o", "\u001b[?2004h"]
[94.383369, "o", "> "]
[94.38353, "o", "    elif node.get(\"type\") == \"number\":\r\n\u001b[?2004l\r"]
[94.383672, "o", "\u001b[?2004h> "]
[94.383884, "o", "        value = float(value)\r\n\u001b[?2004l\r"]
[94.383914, "o", "\u001b[?2004h"]
[94.384098, "o", ">     statistics[key] = value\r\n\u001b[?2004l\r"]
[94.384214, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[94.384345, "o", "\u001b[?2004h"]
[94.384368, "o", "> "]
[94.38472, "o", "# ---- Build metadata (keys derived from schema) ----\r\n\u001b[?2004l\r"]
[94.384841, "o", "\u001b[?2004h> metadata = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.384938, "o", "> "]
[94.385029, "o", "    \"version\": \"1.0\","]
[94.385201, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.385449, "o", "    \"timestamp\": datetime.now(timezone.utc).isoformat(),\r\n\u001b[?2004l\r"]
[94.385475, "o", "\u001b[?2004h> "]
[94.385729, "o", "    \"generator\": \"csv-to-json-processor\",\r\n\u001b[?2004l\r"]
[94.385765, "o", "\u001b[?2004h> "]
[94.385915, "o", "}\r\n\u001b[?2004l\r"]
[94.385941, "o", "\u001b[?2004h"]
[94.38606, "o", "> "]
[94.386446, "o", "metadata = {k: metadata[k] for k in metadata_keys}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[94.386475, "o", "\u001b[?2004h> "]
[94.38674, "o", "# ---- Build organization (keys derived from schema) ----\r\n\u001b[?2004l\r"]
[94.386766, "o", "\u001b[?2004h> "]
[94.386943, "o", "organization = {\r\n\u001b[?2004l\r"]
[94.38697, "o", "\u001b[?2004h"]
[94.38709, "o", "> "]
[94.387478, "o", "    \"name\": \"Global Tech Organization\",\r\n\u001b[?2004l\r"]
[94.387504, "o", "\u001b[?2004h> "]
[94.387768, "o", "    \"founded\": \"2015-01-01\",\r\n\u001b[?2004l\r"]
[94.387793, "o", "\u001b[?2004h> "]
[94.388009, "o", "    \"departments\": built_departments,\r\n\u001b[?2004l\r"]
[94.388035, "o", "\u001b[?2004h> "]
[94.388169, "o", "}\r\n\u001b[?2004l\r"]
[94.388196, "o", "\u001b[?2004h"]
[94.388318, "o", "> "]
[94.388538, "o", "organization = {k: organization[k] for k in org_keys}\r\n\u001b[?2004l\r"]
[94.388563, "o", "\u001b[?2004h> "]
[94.388721, "o", "\r\n\u001b[?2004l\r"]
[94.388752, "o", "\u001b[?2004h> "]
[94.389563, "o", "# ---- Assemble final object exactly from schema's top-level keys ----\r\n\u001b[?2004l\r\u001b[?2004h> output = {k: {\"metadata\": metadata, \"organization\": organization, \"statistics\": statistics}[k] for k in top_keys}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.389605, "o", "# ---- Validate against schema before writing ----"]
[94.389738, "o", "\r\n\u001b[?2004l\r"]
[94.389876, "o", "\u001b[?2004h> "]
[94.39007, "o", "validate(instance=output, schema=schema)\r\n\u001b[?2004l\r"]
[94.390096, "o", "\u001b[?2004h"]
[94.390224, "o", "> "]
[94.390424, "o", "print(\"Schema validation: PASSED\")\r\n\u001b[?2004l\r"]
[94.390452, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[94.390609, "o", "\u001b[?2004h> "]
[94.390814, "o", "with open(OUT_PATH, \"w\") as f:"]
[94.390924, "o", "\r\n\u001b[?2004l\r"]
[94.39095, "o", "\u001b[?2004h"]
[94.391071, "o", "> "]
[94.391252, "o", "    json.dump(output, f, indent=2)\r\n\u001b[?2004l\r"]
[94.391277, "o", "\u001b[?2004h> "]
[94.391516, "o", "print(f\"Wrote {OUT_PATH}\")\r\n\u001b[?2004l\r"]
[94.391652, "o", "\u001b[?2004h> "]
[94.391678, "o", "PYEOF\r\n"]
[94.391816, "o", "\u001b[?2004l\r"]
[94.435045, "o", "\u001b[?2004hroot@8e9321c4b4f8:/app# "]
[94.482119, "i", "python3 build.py\n"]
[94.483191, "o", "python3 build.py\r\n\u001b[?2004l\r"]
[94.694111, "o", "Schema validation: PASSED\r\n"]
[94.694792, "o", "Wrote organization.json"]
[94.694876, "o", "\r\n"]
