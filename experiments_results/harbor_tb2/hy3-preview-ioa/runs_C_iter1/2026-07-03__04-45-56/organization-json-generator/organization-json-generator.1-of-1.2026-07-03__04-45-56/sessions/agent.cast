[94.321457, "i", "cat > build.py << 'PYEOF'\nimport csv, json\nfrom datetime import datetime, timezone\nfrom jsonschema import validate\n\nSCHEMA_PATH = \"schema.json\"\nDATA_DIR = \"data\"\nOUT_PATH = \"organization.json\"\n\n# ---- Load schema at runtime ----\nwith open(SCHEMA_PATH) as f:\n    schema = json.load(f)\n\n# Derive structures directly from the schema (no hardcoded field names)\ntop_keys   = schema[\"required\"]                      # metadata, organization, statistics\nmetadata_keys = schema[\"properties\"][\"metadata\"][\"required\"]\norg_keys   = schema[\"properties\"][\"organization\"][\"required\"]\n\ndept_node  = schema[\"properties\"][\"organization\"][\"properties\"][\"departments\"][\"items\"]\ndept_required = dept_node[\"required\"]\ndept_props = dept_node[\"properties\"]\n\nemp_node   = dept_props[\"employees\"][\"items\"]\nemp_required = emp_node[\"required\"]\nemp_props  = emp_node[\"properties\"]\n\nproj_node  = dept_props[\"projects\"][\"items\"]\nproj_required = proj_node[\"required\"]\nproj_props = proj_node[\"properties\"]\n\nstat_node  = schema[\"properties\"][\"statistics\"]\ns"]
[94.321746, "i", "tat_keys  = stat_node[\"required\"]         # exact statistic key names from schema\nstat_props = stat_node[\"properties\"]\n\n# Column-name mapping: schema field name -> csv column name\ndef csv_col(field, mapping):\n    return mapping.get(field, field)\n\n# ---- Type coercion driven by the schema node ----\ndef coerce(value, node):\n    t = node.get(\"type\")\n    if t == \"integer\":\n        return int(value)\n    if t == \"number\":\n        return float(value)\n    return value\n\ndef read_csv(name):\n    with open(f\"{DATA_DIR}/{name}\") as f:\n        return list(csv.DictReader(f))\n\ndepartments = read_csv(\"departments.csv\")\nemployees   = read_csv(\"employees.csv\")\nprojects    = read_csv(\"projects.csv\")\n\n# ---- Build employees grouped by department ----\nemp_by_dept = {}\nfor e in employees:\n    emp_by_dept.setdefault(e[\"department_id\"], []).append(e)\n\nproj_by_dept = {}\nfor p in projects:\n    proj_by_dept.setdefault(p[\"department_id\"], []).append(p)\n\n# ---- Build departments structure (field names derived from schema) ----\nbuilt_depar"]
[94.321775, "o", "cat > build.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.321841, "i", "tments = []\nfor d in departments:\n    emp_list = []\n    for e in emp_by_dept.get(d[\"id\"], []):\n        emp = {}\n        for k in emp_required:\n            node = emp_props[k]\n            if node.get(\"type\") == \"array\":\n                emp[k] = [s.strip() for s in e[k].split(\";\") if s.strip()]\n            else:\n                emp[k] = coerce(e[k], node)\n        emp_list.append(emp)\n    proj_list = []\n    for p in proj_by_dept.get(d[\"id\"], []):\n        proj = {}\n        for k in proj_required:\n            node = proj_props[k]\n            col = csv_col(k, {\"members\": \"member_ids\"})\n            if node.get(\"type\") == \"array\":\n                proj[k] = [s.strip() for s in p[col].split(\";\") if s.strip()]\n            else:\n                proj[k] = coerce(p[col], node)\n        proj_list.append(proj)\n    dept = {}\n    for k in dept_required:\n        node = dept_props[k]\n        if k == \"employees\":\n            dept[k] = emp_list\n        elif k == \"projects\":\n            dept[k] = proj_list\n        else:\n            "]
[94.321956, "i", "dept[k] = coerce(d[k], node)\n    built_departments.append(dept)\n\n# ---- Build statistics (keys derived exactly from schema) ----\nbudgets = [float(d[\"budget\"]) for d in departments]\ntotal_employees = len(employees)\nskill_counts = {}\nfor e in employees:\n    for s in e[\"skills\"].split(\";\"):\n        s = s.strip()\n        if s:\n            skill_counts[s] = skill_counts.get(s, 0) + 1\ndep_sizes = {d[\"id\"]: len(emp_by_dept.get(d[\"id\"], [])) for d in departments}\nstatus_counts = {}\nfor p in projects:\n    status_counts[p[\"status\"]] = status_counts.get(p[\"status\"], 0) + 1\nyos = [int(e[\"years_of_service\"]) for e in employees]\navg_yos = sum(yos) / len(yos) if yos else 0\n\ncomputed = {\n    \"averageDepartmentBudget\": sum(budgets) / len(budgets) if budgets else 0,\n    \"totalEmployees\": total_employees,\n    \"skillDistribution\": skill_counts,\n    \"departmentSizes\": dep_sizes,\n    \"projectStatusDistribution\": status_counts,\n    \"averageYearsOfService\": avg_yos,\n}\n\n# Map to exactly the schema-derived statistic key names\nstatisti"]
[94.322084, "o", "> "]
[94.32211, "i", "cs = {}\nfor key in stat_keys:\n    value = computed[key]\n    node = stat_props[key]\n    if node.get(\"type\") == \"integer\":\n        value = int(value)\n    elif node.get(\"type\") == \"number\":\n        value = float(value)\n    statistics[key] = value\n\n# ---- Build metadata (keys derived from schema) ----\nmetadata = {\n    \"version\": \"1.0\",\n    \"timestamp\": datetime.now(timezone.utc).isoformat(),\n    \"generator\": \"csv-to-json-processor\",\n}\nmetadata = {k: metadata[k] for k in metadata_keys}\n\n# ---- Build organization (keys derived from schema) ----\norganization = {\n    \"name\": \"Global Tech Organization\",\n    \"founded\": \"2015-01-01\",\n    \"departments\": built_departments,\n}\norganization = {k: organization[k] for k in org_keys}\n\n# ---- Assemble final object exactly from schema's top-level keys ----\noutput = {k: {\"metadata\": metadata, \"organization\": organization, \"statistics\": statistics}[k] for k in top_keys}\n\n# ---- Validate against schema before writing ----\nvalidate(instance=output, schema=schema)\nprint(\"Schema valida"]
