[958.069538, "i", "cat > /tmp/getk.py << 'EOF'\nimport urllib.request\nu='https://codeload.github.com/torvalds/linux/tar.gz/refs/tags/v6.9'\nreq=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})\nr=urllib.request.urlopen(req,timeout=60)\ntotal=0\nwith open('/app/linux-6.9.tgz','wb') as f:\n    while True:\n        b=r.read(1<<20)\n        if not b: break\n        f.write(b); total+=len(b)\n        if total%(20<<20)<(1<<20): print('...',total>>20,'MB')\nprint('DONE',total,'bytes')\nEOF\npython3 /tmp/getk.py\n"]
