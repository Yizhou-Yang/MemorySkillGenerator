[612.254036, "i", "cat > /tmp/probe.py << 'EOF'\nimport urllib.request\nbase=['https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.9.tar.xz',\n'https://www.kernel.org/pub/linux/kernel/v6.x/linux-6.9.tar.xz',\n'https://kernel.org/pub/linux/kernel/v6.x/linux-6.9.tar.xz',\n'https://mirrors.edge.kernel.org/pub/linux/kernel/v6.x/linux-6.9.tar.xz',\n'https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.9.tar.gz']\nhdr={'User-Agent':'Mozilla/5.0'}\nfor u in base:\n    try:\n        req=urllib.request.Request(u,headers=hdr,method='HEAD')\n        r=urllib.request.urlopen(req,timeout=30)\n        print(r.status,u)\n    except Exception as e:\n        print(getattr(e,'code','?'),u)\nEOF\npython3 /tmp/probe.py\n"]
