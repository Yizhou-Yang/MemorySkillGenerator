[329.032313, "i", "cat > /tmp/dl.py << 'EOF'\nimport urllib.request, sys\nwith open('/tmp/debs/urls.txt') as f:\n    urls=[u.strip() for u in f if u.strip()]\nfor i,u in enumerate(urls):\n    fn=u.split('/')[-1]\n    fn=urllib.parse.unquote(fn)\n    try:\n        urllib.request.urlretrieve(u,'/tmp/debs/'+fn)\n        print('OK',i+1,'/',len(urls),fn)\n    except Exception as e:\n        print('FAIL',u,e)\nEOF\n"]
