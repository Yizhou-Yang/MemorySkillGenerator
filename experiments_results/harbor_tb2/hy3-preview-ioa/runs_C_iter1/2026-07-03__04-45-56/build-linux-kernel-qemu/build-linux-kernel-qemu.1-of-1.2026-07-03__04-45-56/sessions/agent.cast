[810.697142, "i", "cat > /tmp/probe5.py << 'EOF'\nimport urllib.request\nhosts=['https://example.com','https://raw.githubusercontent.com/torvalds/linux/master/README','http://archive.ubuntu.com/ubuntu/','https://mirrors.edge.kernel.org/pub/linux/kernel/v6.x/linux-6.9.tar.xz','https://kernel.org/']\nhdr={'User-Agent':'Mozilla/5.0'}\nfor u in hosts:\n    try:\n        req=urllib.request.Request(u,headers=hdr)\n        r=urllib.request.urlopen(req,timeout=25)\n        print('OK',r.status,u,len(r.read(200)))\n    except urllib.error.HTTPError as e:\n        print('HTTP',e.code,u)\n    except Exception as e:\n        print('ERR',str(e)[:60],u)\nEOF\npython3 /tmp/probe5.py\n"]
