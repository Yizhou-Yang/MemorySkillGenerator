[1316.953488, "i", "apt-get install --print-uris --no-install-recommends -y libelf-dev 2>/dev/null | grep \"^'\" | cut -d\"'\" -f2 > /tmp/debs/elf.txt; cat /tmp/debs/elf.txt\n"]
[1316.954222, "o", "apt-get install --print-uris --no-install-recommends -y libelf-dev 2>/dev/null | grep \"^'\" | cut -d\"'\" -f2 > /tmp/debs/elf.txt; cat /tmp/debs/elf.txt\r\n\u001b[?2004l\r"]
[1319.01433, "i", "cat > /tmp/dl2.py << 'EOF'\nimport urllib.request\nwith open('/tmp/debs/elf.txt') as f:\n    urls=[u.strip() for u in f if u.strip()]\nhdr={'User-Agent':'Debian APT-HTTP/1.3 (2.7.14)'}\nfor i,u in enumerate(urls):\n    fn=urllib.parse.unquote(u.split('/')[-1])\n    req=urllib.request.Request(u,headers=hdr)\n    try:\n        d=urllib.request.urlopen(req,timeout=60).read()\n        open('/tmp/debs/'+fn,'wb').write(d)\n        print('OK',fn,len(d))\n    except Exception as e:\n        print('FAIL',u,e)\nEOF\npython3 /tmp/dl2.py\n"]
[1319.020107, "o", "cat > /tmp/dl2.py << 'EOF'\r\nimport urllib.request\r\nwith open('/tmp/debs/elf.txt') as f:\r\n    urls=[u.strip() for u in f if u.strip()]\r\nhdr={'User-Agent':'Debian APT-HTTP/1.3 (2.7.14)'}\r\nfor i,u in enumerate(urls):\r\n    fn=urllib.parse.unquote(u.split('/')[-1])\r\n    req=urllib.request.Request(u,headers=hdr)\r\n    try:\r\n        d=urllib.request.urlopen(req,timeout=60).read()\r\n        open('/tmp/debs/'+fn,'wb').write(d)\r\n        print('OK',fn,len(d))\r\n    except Exception as e:\r\n        print('FAIL',u,e)\r\nEOF\r\npython3 /tmp/dl2.py\r\n"]
