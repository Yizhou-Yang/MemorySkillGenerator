[760.520822, "i", "cat > /tmp/probe4.py << 'EOF'\nimport urllib.request\ntests={\n 'korg_xz':'https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.9.tar.xz',\n 'korg_gz':'https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.9.tar.gz',\n 'korg6_8':'https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.8.tar.xz',\n}\nhdr={'User-Agent':'Mozilla/5.0'}\nfor name,u in tests.items():\n    try:\n        req=urllib.request.Request(u,headers=hdr)\n        r=urllib.request.urlopen(req,timeout=30)\n        data=r.read(300)\n        print(name,r.status,r.headers.get('Content-Length'),repr(data[:120]))\n    except urllib.error.HTTPError as e:\n        body=e.read(300)\n        print(name,'HTTP',e.code,repr(body[:200]))\n    except Exception as e:\n        print(name,'ERR',str(e)[:100])\nEOF\npython3 /tmp/probe4.py\n"]
