[1028.358644, "i", "cat > /tmp/getk.py << 'EOF'\nimport urllib.request, time\nu='https://codeload.github.com/torvalds/linux/tar.gz/refs/tags/v6.9'\nhdr={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36'}\nfor attempt in range(8):\n    try:\n        req=urllib.request.Request(u,headers=hdr)\n        r=urllib.request.urlopen(req,timeout=60)\n        total=0\n        with open('/app/linux-6.9.tgz','wb') as f:\n            while True:\n                b=r.read(1<<20)\n                if not b: break\n                f.write(b); total+=len(b)\n        print('DONE',total,'bytes')\n        break\n    except urllib.error.HTTPError as e:\n        print('attempt',attempt,'HTTP',e.code,'retrying...')\n        time.sleep(8+attempt*5)\n    except Exception as e:\n        print('attempt',attempt,'ERR',str(e)[:60],'retrying...')\n        time.sleep(8+attempt*5)\nEOF\npython3 /tmp/getk.py\n"]
