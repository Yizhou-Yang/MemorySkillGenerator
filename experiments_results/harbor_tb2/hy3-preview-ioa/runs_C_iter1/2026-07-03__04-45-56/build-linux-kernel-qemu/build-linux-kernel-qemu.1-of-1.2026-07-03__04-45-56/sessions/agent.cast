[1215.099369, "i", "python3 - << 'EOF'\nimport io\np='init/main.c'\nwith open(p) as f: lines=f.readlines()\n# line index 882 -> zero-based 881 is 'void start_kernel(void)'\n# find the '{' after it\nfor i in range(881, min(891,len(lines))):\n    if lines[i].rstrip()=='{':\n        insert=('\\tprintk(KERN_INFO \"Hello, this is a custom kernel\");\\n')\n        lines.insert(i+1, insert)\n        print('inserted after line', i+1)\n        break\nwith open(p,'w') as f: f.writelines(lines)\nEOF\n"]
[1215.099753, "o", "python3 - << 'EOF'\r\n\u001b[?2004l\r"]
