[227.881261, "i", "cat > /app/bitcoin_service.py << 'PYEOF'\n#!/usr/bin/env python3\nimport os\nimport re\nimport time\nimport requests\nfrom flask import Flask, jsonify\n\napp = Flask(__name__)\n\nRPC_HOST = os.environ.get('BITCOIN_RPC_HOST', '127.0.0.1')\nRPC_PORT = int(os.environ.get('BITCOIN_RPC_PORT', '8332'))\nRPC_USER = os.environ.get('BITCOIN_RPC_USER', 'bitcoin')\nRPC_PASSWORD = os.environ.get('BITCOIN_RPC_PASSWORD', 'bitcoin')\nP2P_PORT = int(os.environ.get('BITCOIN_P2P_PORT', '8333'))\nRPC_TIMEOUT = float(os.environ.get('BITCOIN_RPC_TIMEOUT', '3.0'))\n\nHEX64 = re.compile(r'^[0-9a-fA-F]{64}$')\n\n\nclass BitcoinRPCError(Exception):\n    pass\n\n\nclass BitcoinClient:\n    def __init__(self, host=RPC_HOST, port=RPC_PORT, user=RPC_USER,\n                 password=RPC_PASSWORD, timeout=RPC_TIMEOUT):\n        self.url = 'http://%s:%s/' % (host, port)\n        self.auth = (user, password)\n        self.timeout = timeout\n        self._session = requests.Session()\n        self._session.auth = self.auth\n        self._connected = None\n        self._check"]
[227.881341, "i", "ed_at = 0.0\n\n    def _rpc(self, method, params=None):\n        payload = {\n            'jsonrpc': '1.0',\n            'id': 'bitcoin_service',\n            'method': method,\n            'params': params if params is not None else [],\n        }\n        try:\n            resp = self._session.post(self.url, json=payload, timeout=self.timeout)\n            resp.raise_for_status()\n        except requests.exceptions.RequestException as exc:\n            raise BitcoinRPCError('Unable to reach Bitcoin node: %s' % exc)\n        data = resp.json()\n        if data.get('error'):\n            raise BitcoinRPCError(data['error'].get('message', 'RPC error'))\n        return data.get('result')\n\n    def is_connected(self, force=False):\n        now = time.time()\n        if not force and self._connected is not None and now - self._checked_at < 10:\n            return self._connected\n        try:\n            self._rpc('getblockchaininfo')\n            self._connected = True\n        except BitcoinRPCError:\n            self._connected = Fals"]
[227.881353, "i", "e\n        self._checked_at = now\n        return self._connected\n\n    def get_block(self, block_hash):\n        return self._rpc('getblock', [block_hash, 1])\n\n    def get_transaction(self, txid):\n        return self._rpc('getrawtransaction', [txid, 1])\n\n\n_client = BitcoinClient()\n\n\ndef _valid_hash(value):\n    return bool(HEX64.match(value or ''))\n\n\n@app.route('/block/<block_hash>')\ndef block(block_hash):\n    if not _valid_hash(block_hash):\n        return jsonify({'error': 'Invalid block hash'}), 404\n    if not _client.is_connected():\n        return jsonify({'error': 'Not connected to the Bitcoin network'}), 503\n    try:\n        blk = _client.get_block(block_hash)\n    except BitcoinRPCError:\n        return jsonify({'error': 'Block not found'}), 404\n    return jsonify({\n        'hash': blk.get('hash'),\n        'height': blk.get('height'),\n        'merkleroot': blk.get('merkleroot'),\n        'time': blk.get('time'),\n        'nonce': blk.get('nonce'),\n        'tx': blk.get('tx', []),\n    })\n\n\n@app.route('/transacti"]
[227.881378, "i", "on/<txid>')\ndef transaction(txid):\n    if not _valid_hash(txid):\n        return jsonify({'error': 'Invalid transaction ID'}), 404\n    if not _client.is_connected():\n        return jsonify({'error': 'Not connected to the Bitcoin network'}), 503\n    try:\n        tx = _client.get_transaction(txid)\n    except BitcoinRPCError:\n        return jsonify({'error': 'Transaction not found'}), 404\n    vin = []\n    for v in tx.get('vin', []):\n        vin.append({\n            'coinbase': v.get('coinbase'),\n            'sequence': v.get('sequence'),\n        })\n    vout = []\n    for v in tx.get('vout', []):\n        spk = v.get('scriptPubKey', {}) or {}\n        vout.append({\n            'value': v.get('value'),\n            'n': v.get('n'),\n            'scriptPubKey': {\n                'asm': spk.get('asm'),\n                'hex': spk.get('hex'),\n                'type': spk.get('type'),\n            },\n        })\n    return jsonify({\n        'txid': tx.get('txid'),\n        'blockhash': tx.get('blockhash'),\n        'vin': vin,\n  "]
[227.882627, "i", "      'vout': vout,\n    })\n\n\n@app.route('/status')\ndef status():\n    if _client.is_connected():\n        return jsonify({'status': 'online'})\n    return jsonify({'status': 'Not connected to the Bitcoin network'}), 503\n\n\nif __name__ == '__main__':\n    app.run(host='0.0.0.0', port=5000)\nPYEOF\n"]
