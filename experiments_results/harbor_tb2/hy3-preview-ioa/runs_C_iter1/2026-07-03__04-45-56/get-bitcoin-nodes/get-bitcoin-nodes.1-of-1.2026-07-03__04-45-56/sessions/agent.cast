[242.906263, "i", "python3 - << 'PYEOF'\nimport urllib.request, json\nbase='http://127.0.0.1:5000'\ntests=[\n  ('/status', None),\n  ('/block/notahex', 404),\n  ('/block/'+'0'*64, 503),\n  ('/transaction/xyz', 404),\n  ('/transaction/'+'a'*64, 503),\n]\nfor path, expect in tests:\n    try:\n        r=urllib.request.urlopen(base+path, timeout=5)\n        code=r.getcode(); body=r.read().decode()\n    except urllib.error.HTTPError as e:\n        code=e.code; body=e.read().decode()\n    print(path, '->', code, body[:120], '' if expect is None else ('OK' if code==expect else 'EXPECT %s'%expect))\nPYEOF\n"]
[242.914062, "o", "python3 - << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request, json\r\n\u001b[?2004l\r\u001b[?2004h> base='http://127.0.0.1:5000'\r\n\u001b[?2004l\r\u001b[?2004h> tests=[\r\n\u001b[?2004l\r\u001b[?2004h>   ('/status', None),\r\n\u001b[?2004l\r\u001b[?2004h>   ('/block/notahex', 404),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.914114, "o", "  ('/block/'+'0'*64, 503),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.914224, "o", "  ('/transaction/xyz', 404),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.915147, "o", "  ('/transaction/'+'a'*64, 503),\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.944173, "o", "> ]"]
[242.947509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
