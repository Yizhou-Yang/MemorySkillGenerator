[227.934443, "o", "        return self._connected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def get_block(self, block_hash):\r\n\u001b[?2004l\r\u001b[?2004h>         return self._rpc('getblock', [block_hash, 1])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def get_transaction(self, txid):\r\n\u001b[?2004l\r\u001b[?2004h>         return self._rpc('getrawtransaction', [txid, 1])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> _client = BitcoinClient()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _valid_hash(value):\r\n\u001b[?2004l\r\u001b[?2004h>     return bool(HEX64.match(value or ''))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.route('/block/<block_hash>')\r\n\u001b[?2004l\r\u001b[?2004h> def block(block_hash):\r\n\u001b[?2004l\r\u001b[?2004h>     if not _valid_hash(block_hash):\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({'error': 'Invalid block hash'}), 404\r\n\u001b[?2004l\r\u001b[?2004h>     if not _client.is_connected():\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({'error': 'Not connected to the Bitcoin network'}), 503\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.934821, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h>         blk = _client.get_block(block_hash)\r\n\u001b[?2004l\r\u001b[?2004h>     except BitcoinRPCError:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({'error': 'Block not found'}), 404\r\n\u001b[?2004l\r\u001b[?2004h>     return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h>         'hash': blk.get('hash'),\r\n\u001b[?2004l\r\u001b[?2004h>         'height': blk.get('height'),\r\n\u001b[?2004l\r\u001b[?2004h>         'merkleroot': blk.get('merkleroot'),\r\n\u001b[?2004l\r\u001b[?2004h>         'time': blk.get('time'),\r\n\u001b[?2004l\r\u001b[?2004h>         'nonce': blk.get('nonce'),\r\n\u001b[?2004l\r\u001b[?2004h>         'tx': blk.get('tx', []),\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.route('/transaction/<txid>')\r\n\u001b[?2004l\r\u001b[?2004h> def transaction(txid):\r\n\u001b[?2004l\r\u001b[?2004h>     if not _valid_hash(txid):\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({'error': 'Invalid transaction ID'}), 404\r\n\u001b[?2004l\r\u001b[?2004h>     if not _client.is_connected():\r\n\u001b[?2004l\r\u001b[?2004h"]
