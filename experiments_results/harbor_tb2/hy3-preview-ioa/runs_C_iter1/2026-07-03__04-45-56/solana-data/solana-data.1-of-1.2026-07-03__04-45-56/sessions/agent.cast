[380.374267, "i", "cat > /tmp/t2.py << 'EOF'\nimport urllib.request, json\nurl='https://rpc.ankr.com/solana'\nfor m in ['getHealth','getSlot','getVersion','getClusterNodes']:\n    req=urllib.request.Request(url, data=json.dumps({'jsonrpc':'2.0','id':1,'method':m,'params':[] if m!='getClusterNodes' else []}).encode(), headers={'Content-Type':'application/json'})\n    try:\n        r=urllib.request.urlopen(req, timeout=25)\n        print(m, r.read().decode()[:200])\n    except Exception as e:\n        print(m,'ERR',repr(e)[:120])\nEOF\n"]
