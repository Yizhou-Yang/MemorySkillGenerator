[187.57438, "i", "cat > /tmp/nettest.py << 'EOF'\nimport urllib.request, json, urllib.error\nfor net in ['devnet','mainnet-beta']:\n    url = 'https://api.%s.solana.com' % ('devnet' if net=='devnet' else 'mainnet-beta')\n    try:\n        req = urllib.request.Request(url, data=json.dumps({'jsonrpc':'2.0','id':1,'method':'getHealth'}).encode(), headers={'Content-Type':'application/json'})\n        r = urllib.request.urlopen(req, timeout=20)\n        print(net, 'OK', r.read().decode())\n    except Exception as e:\n        print(net, 'ERR', repr(e))\nEOF\n"]
