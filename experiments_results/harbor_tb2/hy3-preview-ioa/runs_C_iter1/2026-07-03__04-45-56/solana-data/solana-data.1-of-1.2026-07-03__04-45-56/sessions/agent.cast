[601.029117, "i", "cat > /tmp/t3.py << 'EOF'\nimport urllib.request, json, time\nURL='https://solana.publicnode.com'\ndef call(m, params):\n    req=urllib.request.Request(URL, data=json.dumps({'jsonrpc':'2.0','id':1,'method':m,'params':params}).encode(), headers={'Content-Type':'application/json','User-Agent':'Mozilla/5.0'})\n    return json.loads(urllib.request.urlopen(req, timeout=60).read().decode())\nt=time.time(); slot=call('getSlot',[]); print('slot', slot['result'], '%.1fs'%(time.time()-t))\nt=time.time(); blk=call('getBlock',[slot['result']-10,{'encoding':'jsonParsed'}]); print('getBlock keys', list(blk.get('result') or {})[:0] if blk.get('result') is None else list(blk['result'].keys()), '%.1fs'%(time.time()-t))\nprint('block sample', json.dumps(blk['result'], default=str)[:300] if blk.get('result') else blk.get('error'))\nt=time.time(); acc=call('getAccountInfo',['11111111111111111111111111111111',{'encoding':'jsonParsed'}]); print('acct', json.dumps(acc.get('result'), default=str)[:300], '%.1fs'%(time.time()-t))\nt=time.time()"]
[601.029401, "o", "cat > /tmp/t3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request, json, time\r\n\u001b[?2004l\r\u001b[?2004h> URL='https://solana.publicnode.com'\r\n\u001b[?2004l\r\u001b[?2004h> def call(m, params):\r\n\u001b[?2004l\r\u001b[?2004h>     req=urllib.request.Request(URL, data=json.dumps({'jsonrpc':'2.0','id':1,'method':m,'params':params}).encode(), headers={'Content-Type':'application/json','User-Agent':'Mozilla/5.0'})"]
