[323.713877, "i", "python3 - << 'EOF'\nimport socket\nhosts = ['api.devnet.solana.com','api.mainnet-beta.solana.com','api.testnet.solana.com','solana-api.projectserum.com','rpc.ankr.com','solana-mainnet.g.alchemy.com']\nfor h in hosts:\n    try:\n        s=socket.create_connection((h,443),timeout=12)\n        s.sendall(b'\\x16\\x03\\x01\\x00\\x05\\x01\\x00\\x00\\x01\\x00')\n        data=s.recv(200)\n        print(h, 'OK' if data[:1]==b'\\x16' or data[:1]==b'\\x15' else 'HTTP', repr(data[:80]))\n    except Exception as e:\n        print(h,'ERR',repr(e)[:80])\nEOF\n"]
