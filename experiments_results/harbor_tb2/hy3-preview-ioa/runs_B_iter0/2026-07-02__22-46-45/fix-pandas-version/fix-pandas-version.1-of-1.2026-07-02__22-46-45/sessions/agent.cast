[616.751904, "o", "drwxr-xr-x  3 root root 4096 Jul  2 15:12 .\r\ndrwxr-xr-x 19 root root 4096 Jul  2 15:12 ..\r\ndrwxr-xr-x  2 root root 4096 Jul  2 13:59 src\r\n"]
[616.752544, "o", "\u001b[?2004hroot@fb0305d397bc:/app# "]
