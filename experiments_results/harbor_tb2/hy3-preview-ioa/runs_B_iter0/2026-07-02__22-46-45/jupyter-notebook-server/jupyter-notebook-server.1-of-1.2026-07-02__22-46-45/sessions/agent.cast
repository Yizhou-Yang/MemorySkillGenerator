[556.13403, "i", "python3 - <<'PY'\nfrom jupyter_server.auth import passwd\nimport os\nhp = passwd('benchmarkpass')\nprint(hp)\nwith open('/app/jupyter_notebook_config.py','w') as f:\n    f.write('c.ServerApp.port = 8888\\n')\n    f.write('c.ServerApp.ip = \\'0.0.0.0\\'\\n')\n    f.write('c.ServerApp.certfile = \\'/app/mycert.pem\\'\\n')\n    f.write('c.ServerApp.keyfile = \\'/app/mykey.key\\'\\n')\n    f.write('c.ServerApp.password = ' + repr(hp) + '\\n')\n    f.write('c.ServerApp.allow_root = True\\n')\n    f.write('c.ServerApp.open_browser = False\\n')\n    f.write('c.ServerApp.token = \\'\\'\\n')\n    f.write('c.ServerApp.password_required = True\\n')\n    f.write('c.ServerApp.allow_origin = \\'*\\'\\n')\nprint('written')\nPY\n"]
