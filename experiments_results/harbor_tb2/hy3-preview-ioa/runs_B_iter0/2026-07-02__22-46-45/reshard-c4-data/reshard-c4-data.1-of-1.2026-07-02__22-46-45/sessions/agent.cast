[470.02624, "i", "cat > /tmp/build_reshard.py <<'PYEOF'\nimport os\nimport shutil\n\nROOT = \"/app\"\nSAMPLE = os.path.join(ROOT, \"c4_sample\")\nRESHARD = os.path.join(ROOT, \"c4_reshard\")\n\nPER_LEAF = 30    # max files per leaf folder\nPER_GROUP = 30   # max leaf folders per group folder\n\nfiles = sorted(\n    f for f in os.listdir(SAMPLE)\n    if os.path.isfile(os.path.join(SAMPLE, f))\n)\nn = len(files)\nleaves = (n + PER_LEAF - 1) // PER_LEAF\ngroups = (leaves + PER_GROUP - 1) // PER_GROUP\nprint(\"files:\", n, \"leaves:\", leaves, \"groups:\", groups)\n\nif os.path.exists(RESHARD):\n    shutil.rmtree(RESHARD)\nos.makedirs(RESHARD)\n\nfor i, fname in enumerate(files):\n    leaf = i // PER_LEAF\n    group = leaf // PER_GROUP\n    leaf_in_group = leaf % PER_GROUP\n    dest_dir = os.path.join(RESHARD, \"%03d\" % group, \"%03d\" % leaf_in_group)\n    os.makedirs(dest_dir, exist_ok=True)\n    os.link(os.path.join(SAMPLE, fname), os.path.join(dest_dir, fname))\n\nprint(\"done\")\nPYEOF\n"]
[470.027824, "o", "cat > /tmp/build_reshard.py <<'PYEOF'\r\nimport os\r\nimport shutil\r\n\r\nROOT = \"/app\"\r\nSAMPLE = os.path.join(ROOT, \"c4_sample\")\r\nRESHARD = os.path.join(ROOT, \"c4_reshard\")\r\n\r\nPER_LEAF = 30    # max files per leaf folder\r\nPER_GROUP = 30   # max leaf folders per group folder\r\n\r\nfiles = sorted(\r\n    f for f in os.listdir(SAMPLE)\r\n    if os.path.isfile(os.path.join(SAMPLE, f))\r\n)\r\nn = len(files)\r\nleaves = (n + PER_LEAF - 1) // PER_LEAF\r\ngroups = (leaves + PER_GROUP - 1) // PER_GROUP\r\nprint(\"files:\", n, \"leaves:\", leaves, \"groups:\", groups)\r\n\r\nif os.path.exists(RESHARD):\r\n    shutil.rmtree(RESHARD)\r\nos.makedirs(RESHARD)\r\n\r\nfor i, fname in enumerate(files):\r\n    leaf = i // PER_LEAF\r\n    group = leaf // PER_GROUP\r\n    leaf_in_group = leaf % PER_GROUP\r\n    dest_dir = os.path.join(RESHARD, \"%03d\" % group, \"%03d\" % leaf_in_group)\r\n    os.makedirs(dest_dir, exist_ok=True)\r\n    os.link(os.path.join(SAMPLE, fname), os.path.join(dest_dir, fname))\r\n\r\nprint(\"done\")\r\nPYEOF\r\n"]
[470.628865, "i", "python3 /tmp/build_reshard.py\n"]
