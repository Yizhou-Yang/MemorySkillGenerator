[24.559314, "i", "cat > /app/server.py << 'EOF'\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nimport json\nimport urllib.parse\n\n\ndef fib(n):\n    if n < 0:\n        return None\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def _send(self, code, obj):\n        body = json.dumps(obj).encode()\n        self.send_response(code)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urllib.parse.urlparse(self.path)\n        if parsed.path != '/fib':\n            self._send(404, {'error': 'not found'})\n            return\n        qs = urllib.parse.parse_qs(parsed.query)\n        if 'n' not in qs:\n            self._send(400, {'error': 'missing query param n'})\n            return\n        val = qs['n'][0]\n        try:\n            n = int(val)\n        except (ValueError, TypeError):\n            self._send(400, {'error': 'n must be an integer'})\n            return\n        # ensure it is a true integer string (no float-like)\n        if str(n) != val.strip():\n            self._send(400, {'error': 'n must be an integer'})\n            return\n        result = fib(n)\n        if result is None:\n            self._send(400, {'error': 'n must be a non-negative integer'})\n            return\n        self._send(200, {'result': result})\n\n    def log_message(self, *args):\n        pass\n\n\nif __name__ == '__main__':\n    HTTPServer(('0.0.0.0', 3000), Handler).serve_forever()\nEOF\n"]
