[28.639611, "o", "Require Import Arith."]
[28.647457, "o", "\r\n"]
[28.648746, "o", "\r\n"]
[28.649695, "o", "Theorem plus_comm : forall n m : nat,"]
[28.649957, "o", "\r\n"]
[28.658922, "o", "  n + m = m + n."]
[28.659303, "o", "\r\n"]
[28.659586, "o", "Proof."]
[28.659837, "o", "\r\n"]
[28.660116, "o", "  intros n m."]
[28.661075, "o", "\r\n"]
[28.661363, "o", "  induction n as [|n' IHn']."]
[28.661648, "o", "\r\n"]
[28.661993, "o", "  - simpl."]
[28.662376, "o", "\r\n"]
[28.663438, "o", "    (* Need to handle the base case *)"]
[28.667667, "o", "\r\n"]
[28.668933, "o", "    admit."]
[28.669243, "o", "\r\n"]
[28.669507, "o", "  - simpl."]
[28.669783, "o", "\r\n"]
[28.670074, "o", "    (* Need to use the inductive hypothesis and plus_n_Sm *)"]
[28.670348, "o", "\r\n"]
[28.670641, "o", "    admit."]
[28.670928, "o", "\r\n"]
[28.671242, "o", "Qed. "]
[28.672196, "m", "Episode 3: 2 commands"]
