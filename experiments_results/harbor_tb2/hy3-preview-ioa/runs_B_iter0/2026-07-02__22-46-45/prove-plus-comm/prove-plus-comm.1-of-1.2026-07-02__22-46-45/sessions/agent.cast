[46.964333, "o", "Require Import Arith.\r\n\r\nTheorem plus_comm : forall n m : nat,\r\n  n + m = m + n.\r\nProof.\r\n  intros n m.\r\n  induction n as [|n' IHn'].\r\n  - simpl.\r\n    rewrite plus_n_O.\r\n    reflexivity.\r\n  - simpl.\r\n    rewrite plus_n_Sm.\r\n    rewrite IHn'.\r\n    reflexivity.\r\nQed.\r\n\u001b[?2004hroot@f1dfb8d8ed50:/workspace# "]
