[249.539859, "o", "\u001b[?2004h>         if i == 8:\r\n\u001b[?2004l\r\u001b[?2004h>             result = (result << 8) | x\r\n\u001b[?2004l\r\u001b[?2004h>             return result, off+9\r\n\u001b[?2004l\r\u001b[?2004h>         result = (result << 7) | (x & 0x7f)\r\n\u001b[?2004l\r\u001b[?2004h>         if not (x & 0x80):\r\n\u001b[?2004l\r\u001b[?2004h>             return result, off+i+1\r\n\u001b[?2004l\r\u001b[?2004h>     return result, off+9\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ptrs = [int.from_bytes(data[8+i*2:10+i*2],'big') for i in range(cell_count)]\r\n\u001b[?2004l\r\u001b[?2004h> rows = []\r\n\u001b[?2004l\r\u001b[?2004h> for p in ptrs:\r\n\u001b[?2004l\r\u001b[?2004h>     off = p\r\n\u001b[?2004l\r\u001b[?2004h>     plen, off = read_varint(data, off)\r\n\u001b[?2004l\r\u001b[?2004h>     rowid, off = read_varint(data, off)\r\n\u001b[?2004l\r\u001b[?2004h>     payload = data[off:off+plen]\r\n\u001b[?2004l\r\u001b[?2004h>     hlen, h = read_varint(payload, 0)\r\n\u001b[?2004l\r\u001b[?2004h>     types = []\r\n\u001b[?2004l\r\u001b[?2004h>     pos = h\r\n\u001b[?2004l\r\u001b[?2004h>     while pos < hlen:\r\n\u001b[?2004l\r\u001b[?2004h>         t, pos = read_varint(payload, pos)\r\n\u001b[?2004l\r\u001b[?2004h>         types.append(t)\r\n\u001b[?2004l\r\u001b[?2004h>     vals = []\r\n\u001b[?2004l\r\u001b[?2004h>     pos = hlen\r\n\u001b[?2004l\r\u001b[?2004h>     for t in types:\r\n\u001b[?2004l\r\u001b[?2004h>         if t == 0:\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(None)\r\n\u001b[?2004l\r\u001b[?2004h>         elif t == 1:\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(int.from_bytes(payload[pos:pos+1],'big',signed=True)); pos+=1\r\n\u001b[?2004l\r\u001b[?2004h>         elif t == 2:\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(int.from_bytes(payload[pos:pos+2],'big',signed=True)); pos+=2\r\n\u001b[?2004l\r\u001b[?2004h>         elif t == 3:\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(int.from_bytes(payload[pos:pos+3],'big',signed=True)); pos+=3\r\n\u001b[?2004l\r"]
