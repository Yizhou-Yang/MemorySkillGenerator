[229.469204, "i", "cat > /tmp/parse.py << 'EOF'\nimport json, struct\n\nwith open('/app/trunc.db','rb') as f:\n    data = f.read()\n\nprint('file len', len(data))\npage_type = data[0]\ncell_count = int.from_bytes(data[3:5], 'big')\ncell_content_start = int.from_bytes(data[5:7], 'big')\nprint('page_type', hex(page_type), 'cell_count', cell_count, 'content_start', hex(cell_content_start))\n\ndef read_varint(b, off):\n    result = 0\n    for i in range(9):\n        x = b[off+i]\n        if i == 8:\n            result = (result << 8) | x\n            return result, off+9\n        result = (result << 7) | (x & 0x7f)\n        if not (x & 0x80):\n            return result, off+i+1\n    return result, off+9\n\nptrs = [int.from_bytes(data[8+i*2:10+i*2],'big') for i in range(cell_count)]\nprint('ptrs', [hex(p) for p in ptrs])\n\nrows = []\nfor p in ptrs:\n    off = p\n    plen, off = read_varint(data, off)\n    rowid, off = read_varint(data, off)\n    payload = data[off:off+plen]\n    hlen, h = read_varint(payload, 0)\n    types = []\n    pos = h\n    while pos < hlen:\n        t, pos = read_varint(payload, pos)\n        types.append(t)\n    vals = []\n    pos = hlen\n    for t in types:\n        if t == 0:\n            vals.append(None)\n        elif t == 1:\n            vals.append(int.from_bytes(payload[pos:pos+1],'big',signed=True)); pos+=1\n        elif t == 2:\n            vals.append(int.from_bytes(payload[pos:pos+2],'big',signed=True)); pos+=2\n        elif t == 3:\n            vals.append(int.from_bytes(payload[pos:pos+3],'big',signed=True)); pos+=3\n        elif t == 4:\n            vals.append(int.from_bytes(payload[pos:pos+4],'big',signed=True)); pos+=4\n        elif t == 5:\n            vals.append(int.from_bytes(payload[pos:pos+6],'big',signed=True)); pos+=6\n        elif t == 6:\n            vals.append(int.from_bytes(payload[pos:pos+8],'big',signed=True)); pos+=8\n        elif t == 7:\n            vals.append(struct.unpack('>d', payload[pos:pos+8])[0]); pos+=8\n        elif t == 8:\n            vals.append(0)\n        elif t == 9:\n            vals.append(1)\n        elif t >= 12 and t % 2 == 0:\n            n = (t-12)//2; vals.append(payload[pos:pos+n]); pos+=n\n        elif t >= 13 and t % 2 == 1:\n            n = (t-13)//2; vals.append(payload[pos:pos+n].decode('utf-8','replace')); pos+=n\n        else:\n            vals.append('?t%d'%t)\n    rows.append((rowid, payload, vals))\n\nfor rowid, payload, vals in rows:\n    print(rowid, vals)\nEOF\n"]
[229.575306, "o", "cat > /tmp/parse.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import json, struct\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/trunc.db','rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('file len', len(data))\r\n\u001b[?2004l\r\u001b[?2004h> page_type = data[0]\r\n\u001b[?2004l\r\u001b[?2004h> cell_count = int.from_bytes(data[3:5], 'big')\r\n\u001b[?2004l\r\u001b[?2004h> cell_content_start = int.from_bytes(data[5:7], 'big')\r\n\u001b[?2004l\r\u001b[?2004h> print('page_type', hex(page_type), 'cell_count', cell_count, 'content_start', hex(cell_content_start))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def read_varint(b, off):\r\n\u001b[?2004l\r\u001b[?2004h>     result = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(9):\r\n\u001b[?2004l\r\u001b[?2004h>         x = b[off+i]\r\n\u001b[?2004l\r\u001b[?2004h>         if i == 8:\r\n\u001b[?2004l\r\u001b[?2004h>             result = (result << 8) | x\r\n\u001b[?2004l\r\u001b[?2004h>             return result, off+9\r\n\u001b[?2004l\r\u001b[?2004h>         result = (result << 7) | (x & 0x7f)\r\n\u001b[?2004l\r\u001b[?2004h>         if not (x & 0x80):\r\n\u001b[?2004l\r\u001b[?2004h>             return result, off+i+1\r\n\u001b[?2004l\r\u001b[?2004h>     return result, off+9\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ptrs = [int.from_bytes(data[8+i*2:10+i*2],'big') for i in range(cell_count)]\r\n\u001b[?2004l\r\u001b[?2004h> print('ptrs', [hex(p) for p in ptrs])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> rows = []\r\n\u001b[?2004l\r\u001b[?2004h> for p in ptrs:\r\n\u001b[?2004l\r\u001b[?2004h>     off = p\r\n\u001b[?2004l\r\u001b[?2004h>     plen, off = read_varint(data, off)\r\n\u001b[?2004l\r\u001b[?2004h>     rowid, off = read_varint(data, off)\r\n\u001b[?2004l\r\u001b[?2004h>     payload = data[off:off+plen]\r\n\u001b[?2004l\r\u001b[?2004h> "]
