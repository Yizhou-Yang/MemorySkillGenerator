[69.201133, "i", "cat > /app/grid_transform.py << 'EOF'\ndef solve(input_grid):\n    height = len(input_grid)\n    width = len(input_grid[0])\n\n    def rotate90(grid):\n        return [list(row) for row in zip(*grid[::-1])]\n\n    output = []\n    for tr in range(3):\n        tile = rotate90(input_grid) if tr % 2 == 1 else input_grid\n        for i in range(height):\n            row = []\n            for _ in range(3):\n                row.extend(tile[i])\n            output.append(row)\n    return output\nEOF\n"]
