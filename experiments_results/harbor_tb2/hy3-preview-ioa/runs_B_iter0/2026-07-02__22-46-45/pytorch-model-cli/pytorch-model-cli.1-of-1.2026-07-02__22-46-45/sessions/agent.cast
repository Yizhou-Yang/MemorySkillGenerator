[13.024948, "o", "import torch\r\r\nimport torch.nn as nn\r\r\n\r\r\n\r\r\nclass MnistModel(nn.Module):\r\r\n    def __init__(\r\r\n        self,\r\r\n        input_dim: int,\r\r\n        hidden_dim: int,\r\r\n        num_classes: int,\r\r\n    ) -> torch.nn.Module:\r\r\n        super().__init__()\r\r\n\r\r\n        self.input_layer = nn.Linear(input_dim, hidden_dim)\r\r\n        self.hidden_layer = nn.Linear(hidden_dim, hidden_dim)\r\r\n        self.output_layer = nn.Linear(hidden_dim, num_classes)\r\r\n        self.activation = nn.ReLU()\r\r\n\r\r\n    def forward(self, x):\r\r\n        x = self.input_layer(x)\r\r\n        x = self.activation(x)\r"]
[13.025999, "o", "\r\n"]
[13.026539, "o", "\r"]
[13.026722, "o", "\r\n"]
[13.026904, "o", "        x = self.hidden_layer(x)\r"]
[13.027102, "o", "\r\n"]
[13.027293, "o", "        x = self.activation(x)\r"]
[13.027429, "o", "\r\n"]
[13.027599, "o", "\r"]
[13.027832, "o", "\r\n"]
[13.027949, "o", "        x = self.output_layer(x)\r"]
[13.028173, "o", "\r\n"]
[13.028329, "o", "        return x\r"]
