[211.588991, "i", "cat > peaks.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\nraw = open('graphene.dat').read().replace(',', '.')\nfrom io import StringIO\narr = np.loadtxt(StringIO(raw))\nx, y = arr[:,0], arr[:,1]\norder = np.argsort(x)\nxs = x[order]; ys = y[order]\n# find peaks with some prominence\npk, props = find_peaks(ys, prominence=2000, distance=5)\nprint('num peaks found:', len(pk))\nfor i in pk:\n    print(f'x={xs[i]:.2f}  y={ys[i]:.1f}  prom={props[\"prominences\"][list(pk).index(i)]:.1f}')\nprint('--- region x in [1500,3000] ---')\nm = (xs>1500)&(xs<3000)\nfor xx,yy in zip(xs[m], ys[m]):\n    print(xx, yy)\nEOF\npython3 peaks.py\n"]
