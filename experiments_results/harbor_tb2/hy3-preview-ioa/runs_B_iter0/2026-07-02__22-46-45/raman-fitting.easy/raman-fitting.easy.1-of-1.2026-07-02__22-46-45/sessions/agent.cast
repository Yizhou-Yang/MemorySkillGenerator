[571.999916, "i", "cat > fit_final.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\nraw = open('graphene.dat').read().replace(',', '.')\nfrom io import StringIO\ndata = np.loadtxt(StringIO(raw))\norder = np.argsort(data[:,0])\nx = data[order,0]; y = data[order,1]\n\ndef lor(x, x0, gamma, amp, offset):\n    return offset + amp*gamma**2/((x-x0)**2+gamma**2)\n\ndef fit_peak(p0, bounds, lo, hi):\n    m = (x>lo)&(x<hi)\n    xf, yf = x[m], y[m]\n    popt, _ = curve_fit(lor, xf, yf, p0=p0, bounds=bounds, maxfev=500000)\n    pred = lor(xf, *popt)\n    r2 = 1 - np.sum((yf-pred)**2)/np.sum((yf-yf.mean())**2)\n    return popt, r2\n\ngp, gr2 = fit_peak([19200,450,60000,15000],\n                   ([18000,50,1000,0],[20000,2000,100000,40000]),\n                   18500,19900)\ndp, dr2 = fit_peak([33245,950,2750,18500],\n                   ([32000,100,100,15000],[34500,3000,10000,21000]),\n                   31500,35500)\n\nresult = {\n  \"G\":  {\"x0\":float(gp[0]),\"gamma\":float(abs(gp[1])),\"amplitude\":float(gp[2]),\"offset\":float(gp[3])}"]
[572.000523, "o", "cat > fit_final.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> raw = open('graphene.dat').read().replace(',', '.')\r\n\u001b[?2004l\r\u001b[?2004h> from io import StringIO\r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt(StringIO(raw))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[572.000577, "i", ",\n  \"2D\": {\"x0\":float(dp[0]),\"gamma\":float(abs(dp[1])),\"amplitude\":float(dp[2]),\"offset\":float(dp[3])},\n}\njson.dump(result, open('results.json','w'), indent=2)\nprint('G :', gp, 'R2=%.5f'%gr2)\nprint('2D:', dp, 'R2=%.5f'%dr2)\nEOF\npython3 fit_final.py\n"]
