[667.42462, "i", "0],\n    [19210, 500, 60000, 20000],\n    [19210, 300, 70000, 0],\n])\n# 2D peak region\ndp, dr2 = fit_peak(31500, 35500, [\n    [33245, 850, 2200, 19000],\n    [33245, 900, 2200, 18500],\n    [33245, 800, 2500, 19500],\n    [33245, 1000, 2000, 18000],\n])\n\nresult = {\n  \"G\":  {\"x0\": float(gp[0][0]), \"gamma\": float(abs(gp[0][1])), \"amplitude\": float(gp[0][2]), \"offset\": float(gp[0][3])},\n  \"2D\": {\"x0\": float(dp[0][0]), \"gamma\": float(abs(dp[0][1])), \"amplitude\": float(dp[0][2]), \"offset\": float(dp[0][3])},\n}\njson.dump(result, open('results.json','w'), indent=2)\nprint('G : x0=%.3f gamma=%.3f amp=%.3f offset=%.3f  R2=%.5f' % (gp[0][0], abs(gp[0][1]), gp[0][2], gp[0][3], gr2))\nprint('2D: x0=%.3f gamma=%.3f amp=%.3f offset=%.3f  R2=%.5f' % (dp[0][0], abs(dp[0][1]), dp[0][2], dp[0][3], dr2))\nEOF\npython3 fit_best.py\n"]
[667.439844, "o", "raw = open('graphene.dat').read().replace(',', '.')\r\n\u001b[?2004l\r\u001b[?2004h> from io import StringIO\r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt(StringIO(raw))\r\n\u001b[?2004l\r\u001b[?2004h> order = np.argsort(data[:,0])\r\n\u001b[?2004l\r\u001b[?2004h> x = data[order,0]; y = data[order,1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lor(x, x0, gamma, amp, offset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[667.454697, "o", "    return offset + amp*gamma**2/((x-x0)**2+gamma**2)\r\n\u001b[?2004l\r"]
[667.456272, "o", "\u001b[?2004h"]
[667.474146, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[667.477712, "o", "def fit_peak(lo, hi, p0_list):\r\n\u001b[?2004l\r\u001b[?2004h>     m = (x>lo)&(x<hi)\r\n\u001b[?2004l\r\u001b[?2004h>     xf, yf = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     best = None\r\n\u001b[?2004l\r\u001b[?2004h>     for p0 in p0_list:\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             popt, _ = curve_fit(lor, xf, yf, p0=p0, maxfev=500000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[667.477777, "o", "            pred = lor(xf, *popt)\r\n\u001b[?2004l\r"]
[667.480722, "o", "\u001b[?2004h> "]
[667.480903, "o", "            r2 = 1 - np.sum((yf-pred)**2)/np.sum((yf-yf.mean())**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[667.480961, "o", "            if best is None or r2 > best[1]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[667.481047, "o", "                best = (popt, r2)\r\n\u001b[?2004l\r"]
[667.481495, "o", "\u001b[?2004h> "]
[667.4816, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[667.481656, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[667.481724, "o", "    return best\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
