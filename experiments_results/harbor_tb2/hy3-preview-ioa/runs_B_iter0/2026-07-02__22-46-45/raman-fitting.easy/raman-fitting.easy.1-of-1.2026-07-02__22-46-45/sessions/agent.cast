[667.421274, "i", "cat > fit_best.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\nraw = open('graphene.dat').read().replace(',', '.')\nfrom io import StringIO\ndata = np.loadtxt(StringIO(raw))\norder = np.argsort(data[:,0])\nx = data[order,0]; y = data[order,1]\n\ndef lor(x, x0, gamma, amp, offset):\n    return offset + amp*gamma**2/((x-x0)**2+gamma**2)\n\ndef fit_peak(lo, hi, p0_list):\n    m = (x>lo)&(x<hi)\n    xf, yf = x[m], y[m]\n    best = None\n    for p0 in p0_list:\n        try:\n            popt, _ = curve_fit(lor, xf, yf, p0=p0, maxfev=500000)\n            pred = lor(xf, *popt)\n            r2 = 1 - np.sum((yf-pred)**2)/np.sum((yf-yf.mean())**2)\n            if best is None or r2 > best[1]:\n                best = (popt, r2)\n        except Exception:\n            pass\n    return best\n\n# G peak region (background is flat well away on both sides within 18000-20500)\ngp, gr2 = fit_peak(18000, 20500, [\n    [19210, 380, 65000, 14000],\n    [19210, 400, 65000, 1200"]
[667.421593, "o", "cat > fit_best.py << 'EOF'"]
[667.421677, "o", "\r\n"]
[667.42176, "o", "\u001b[?2004l\r"]
[667.421913, "o", "\u001b[?2004h"]
[667.422, "o", "> "]
