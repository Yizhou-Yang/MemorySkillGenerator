[251.035053, "o", "\r\n1656.082519 6410.159993\r\n1656.347519 6344.91374\r\n1656.612673 6249.561357\r\n1656.877983 6188.139104\r\n1657.143444 5802.031905\r\n\u001b[?2004hroot@ec9d7e8ea249:/app# "]
[326.538044, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\n# Convert decimal commas -> dots so numpy can read it\nraw = open('graphene.dat').read().replace(',', '.')\nfrom io import StringIO\ndata = np.loadtxt(StringIO(raw))\nx = data[:, 0]; y = data[:, 1]\norder = np.argsort(x)\nx = x[order]; y = y[order]\n\ndef lorentzian(x, x0, gamma, amp, offset):\n    return offset + amp * gamma**2 / ((x - x0)**2 + gamma**2)\n\ndef fit_peak(center, half, amp0, off0):\n    m = (x > center - half) & (x < center + half)\n    xf, yf = x[m], y[m]\n    p0 = [center, half * 0.1, amp0, off0]\n    popt, pcov = curve_fit(lorentzian, xf, yf, p0=p0, maxfev=200000)\n    return popt\n\n# G peak around x=19139\nmG = (x > 15000) & (x < 24000)\ng_off0 = np.median(y[mG][y[mG] < np.percentile(y[mG], 40)])\ng_amp0 = y[mG].max() - g_off0\ngp = fit_peak(19139, 5000, g_amp0, g_off0)\n\n# 2D peak around x=33244\nmD = (x > 28000) & (x < 40000)\nd_off0 = np.median(y[mD])\nd_amp0 = y[mD].max() - d_off0\ndp = fit_peak(33244, 6000, d_amp0, d_off"]
[326.538238, "i", "0)\n\nresult = {\n    \"G\":  {\"x0\": float(gp[0]), \"gamma\": float(abs(gp[1])), \"amplitude\": float(gp[2]), \"offset\": float(gp[3])},\n    \"2D\": {\"x0\": float(dp[0]), \"gamma\": float(abs(dp[1])), \"amplitude\": float(dp[2]), \"offset\": float(dp[3])},\n}\nwith open('results.json', 'w') as f:\n    json.dump(result, f, indent=2)\nprint('G  params:', gp)\nprint('2D params:', dp)\nEOF\npython3 fit.py\n"]
[326.538836, "o", "cat > fit.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[326.538965, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Convert decimal commas -> dots so numpy can read it\r\n\u001b[?2004l\r\u001b[?2004h> "]
[326.539377, "o", "raw = open('graphene.dat').read().replace(',', '.')\r\n\u001b[?2004l\r"]
