[396.82753, "i", "cat > diag2.py << 'EOF'\nimport numpy as np\nraw = open('graphene.dat').read().replace(',', '.')\nfrom io import StringIO\ndata = np.loadtxt(StringIO(raw))\nx = data[:,0]; y = data[:,1]\norder = np.argsort(x); x=x[order]; y=y[order]\nprint('=== 2D region 30500-36000 ===')\nm=(x>30500)&(x<36000)\nfor xx,yy in zip(x[m],y[m]):\n    print(f'{xx:.1f}  {yy:.1f}')\nprint('=== G region 18500-20000 ===')\nm=(x>18500)&(x<20000)\nfor xx,yy in zip(x[m],y[m]):\n    print(f'{xx:.1f}  {yy:.1f}')\nEOF\npython3 diag2.py > diag2.txt 2>&1\nsed -n '1,80p' diag2.txt\n"]
