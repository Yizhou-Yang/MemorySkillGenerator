[157.934092, "i", "cat > explore.py << 'EOF'\nimport numpy as np\n# convert commas to dots for numpy\nraw = open('graphene.dat').read().replace(',', '.')\nfrom io import StringIO\narr = np.loadtxt(StringIO(raw))\nx, y = arr[:,0], arr[:,1]\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\nprint('n points:', len(x))\n# find peaks: local maxima where y is notably high\n# sort by x ascending\norder = np.argsort(x)\nxs = x[order]; ys = y[order]\n# find local maxima\ndy = np.diff(ys)\npeaks = []\nfor i in range(1, len(ys)-1):\n    if ys[i] > ys[i-1] and ys[i] >= ys[i+1] and ys[i] > 8000:\n        peaks.append((xs[i], ys[i]))\npeaks.sort(key=lambda t: -t[1])\nprint('top peaks (x, y):')\nfor p in peaks[:15]:\n    print(p)\nEOF\npython3 explore.py\n"]
[157.935996, "o", "cat > explore.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> # convert commas to dots for numpy\r\n\u001b[?2004l\r\u001b[?2004h> raw = open('graphene.dat').read().replace(',', '.')\r\n\u001b[?2004l\r\u001b[?2004h> from io import StringIO\r\n\u001b[?2004l\r\u001b[?2004h> arr = np.loadtxt(StringIO(raw))"]
[157.942504, "o", "\r\n"]
[157.942569, "o", "\u001b[?2004l\r\u001b[?2004h> x, y = arr[:,0], arr[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> print('x range:', x.min(), x.max())\r\n\u001b[?2004l\r\u001b[?2004h> print('y range:', y.min(), y.max())\r\n\u001b[?2004l\r\u001b[?2004h> print('n points:', len(x))\r\n\u001b[?2004l\r\u001b[?2004h> # find peaks: local maxima where y is notably high\r\n\u001b[?2004l\r\u001b[?2004h> # sort by x ascending\r\n\u001b[?2004l\r\u001b[?2004h> order = np.argsort(x)\r\n\u001b[?2004l\r\u001b[?2004h> xs = x[order]; ys = y[order]\r\n\u001b[?2004l\r\u001b[?2004h> # find local maxima\r\n\u001b[?2004l\r\u001b[?2004h> dy = np.diff(ys)\r\n\u001b[?2004l\r\u001b[?2004h> peaks = []\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(1, len(ys)-1):\r\n\u001b[?2004l\r\u001b[?2004h>     if ys[i] > ys[i-1] and ys[i] >= ys[i+1] and ys[i] > 8000:\r\n\u001b[?2004l\r\u001b[?2004h>         peaks.append((xs[i], ys[i]))\r\n\u001b[?2004l\r\u001b[?2004h> peaks.sort(key=lambda t: -t[1])\r\n\u001b[?2004l\r\u001b[?2004h> print('top peaks (x, y):')\r\n\u001b[?2004l\r\u001b[?2004h> for p in peaks[:15]:\r\n\u001b[?2004l\r\u001b[?2004h>     print(p)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
