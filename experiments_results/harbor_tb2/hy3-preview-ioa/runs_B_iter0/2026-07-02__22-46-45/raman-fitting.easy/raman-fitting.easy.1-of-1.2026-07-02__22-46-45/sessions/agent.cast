[398.390177, "o", "31829.6  19630.2\r\n32102.8  19883.1\r\n32380.8  20339.9\r\n32663.7  20547.1\r\n32951.7  21063.5\r\n33245.0  21252.7\r\n33543.6  21041.2\r\n33847.7  20523.2\r\n34157.5  20285.4\r\n34473.2  19931.5\r\n34794.8  19781.2\r\n35122.7  19895.8\r\n35456.8  19666.3\r\n35797.5  19599.2\r\n=== G region 18500-20000 ===\r\n18584.9  35830.5\r\n18675.1  40100.9\r\n18766.1  46110.7\r\n18858.0  54280.9\r\n18950.9  65451.7\r\n19044.7  78843.4\r\n19139.5  79400.1\r\n19235.3  78815.2\r\n19332.1  79083.3\r\n19429.9  78849.1\r\n19528.7  67902.9\r\n19628.6  46667.6\r\n19729.5  32649.6\r\n19831.5  24480.4\r\n19934.6  19658.8\r\n"]
