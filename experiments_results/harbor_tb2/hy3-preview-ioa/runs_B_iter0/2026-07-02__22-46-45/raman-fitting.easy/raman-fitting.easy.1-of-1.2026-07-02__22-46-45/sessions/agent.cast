[432.51335, "i", "cat > fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\nraw = open('graphene.dat').read().replace(',', '.')\nfrom io import StringIO\ndata = np.loadtxt(StringIO(raw))\nx = data[:,0]; y = data[:,1]\norder = np.argsort(x); x=x[order]; y=y[order]\n\ndef lorentzian(x, x0, gamma, amp, offset):\n    return offset + amp * gamma**2 / ((x - x0)**2 + gamma**2)\n\ndef do_fit(lo, hi, p0):\n    m = (x>lo)&(x<hi)\n    xf, yf = x[m], y[m]\n    popt, pcov = curve_fit(lorentzian, xf, yf, p0=p0, maxfev=500000)\n    resid = yf - lorentzian(xf, *popt)\n    ss_res = np.sum(resid**2); ss_tot = np.sum((yf-yf.mean())**2)\n    r2 = 1 - ss_res/ss_tot\n    return popt, r2\n\n# G peak\ngp, gr2 = do_fit(18000, 20500, [19139, 400, 65000, 14000])\n# 2D peak\ndp, dr2 = do_fit(31000, 35500, [33245, 800, 2250, 19000])\n\nresult = {\n  \"G\":  {\"x0\": float(gp[0]), \"gamma\": float(abs(gp[1])), \"amplitude\": float(gp[2]), \"offset\": float(gp[3])},\n  \"2D\": {\"x0\": float(dp[0]), \"gamma\": float("]
