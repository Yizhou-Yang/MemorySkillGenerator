[326.541665, "o", "def lorentzian(x, x0, gamma, amp, offset):\r\n\u001b[?2004l\r"]
[326.543032, "o", "\u001b[?2004h>     return offset + amp * gamma**2 / ((x - x0)**2 + gamma**2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[326.54306, "o", "def fit_peak(center, half, amp0, off0):\r\n\u001b[?2004l\r\u001b[?2004h>     m = (x > center - half) & (x < center + half)\r\n\u001b[?2004l\r\u001b[?2004h>     xf, yf = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     p0 = [center, half * 0.1, amp0, off0]\r\n\u001b[?2004l\r\u001b[?2004h>     popt, pcov = curve_fit(lorentzian, xf, yf, p0=p0, maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h>     return popt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # G peak around x=19139\r\n\u001b[?2004l\r"]
[326.543599, "o", "\u001b[?2004h> "]
