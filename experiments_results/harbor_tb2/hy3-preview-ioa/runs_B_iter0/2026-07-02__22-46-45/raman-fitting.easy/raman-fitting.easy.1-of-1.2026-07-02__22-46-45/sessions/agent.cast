[357.160055, "i", "cat > diag.py << 'EOF'\nimport numpy as np\nraw = open('graphene.dat').read().replace(',', '.')\nfrom io import StringIO\ndata = np.loadtxt(StringIO(raw))\nx = data[:,0]; y = data[:,1]\norder = np.argsort(x); x=x[order]; y=y[order]\ndef show(lo, hi, step=20):\n    print(f'--- region [{lo},{hi}] ---')\n    for i in range(len(x)):\n        if lo<=x[i]<=hi and i%step==0:\n            print(f'{x[i]:.1f}  {y[i]:.1f}')\nshow(15000, 24000, 25)\nprint()\nshow(28000, 40000, 25)\nEOF\npython3 diag.py > diag.txt 2>&1\nwc -l diag.txt; head -60 diag.txt\n"]
