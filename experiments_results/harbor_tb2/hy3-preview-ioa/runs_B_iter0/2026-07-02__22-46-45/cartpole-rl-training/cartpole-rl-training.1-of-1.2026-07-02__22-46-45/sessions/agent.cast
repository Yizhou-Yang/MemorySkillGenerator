[142.513265, "i", "cat > /app/train.py << 'PYEOF'\nimport os\nimport random\nimport math\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport gymnasium as gym\nfrom agent import Agent\n\nSEED = 0\ntorch.manual_seed(SEED)\nnp.random.seed(SEED)\nrandom.seed(SEED)\n\nenv = gym.make('CartPole-v1')\n\npolicy = Agent()\ntarget = Agent()\ntarget.policy_net.load_state_dict(policy.policy_net.state_dict())\n\noptimizer = torch.optim.Adam(policy.policy_net.parameters(), lr=1e-3)\n\nBATCH = 128\nGAMMA = 0.99\nBUF = 20000\nTARGET_UPDATE = 10\nEPS_START = 1.0\nEPS_END = 0.02\nEPS_DECAY = 700\n\nbuffer = []\nsteps_done = 0\nEPISODES = 2000\nSAVE_PATH = '/app/trained_model'\n\n\ndef select_eps(obs):\n    global steps_done\n    steps_done += 1\n    eps = EPS_END + (EPS_START - EPS_END) * math.exp(-1.0 * steps_done / EPS_DECAY)\n    if random.random() > eps:\n        with torch.no_grad():\n            o = torch.as_tensor(obs, dtype=torch.float32).unsqueeze(0)\n            return int(policy.policy_net(o).argmax(1).item())\n    return int(env.actio"]
[142.513448, "i", "n_space.sample())\n\n\ndef optimize():\n    if len(buffer) < BATCH:\n        return\n    batch = random.sample(buffer, BATCH)\n    states = torch.tensor(np.array([b[0] for b in batch], dtype=np.float32))\n    actions = torch.tensor([b[1] for b in batch], dtype=torch.int64).unsqueeze(1)\n    rewards = torch.tensor([b[2] for b in batch], dtype=torch.float32)\n    nexts = torch.tensor(np.array([b[3] for b in batch], dtype=np.float32))\n    dones = torch.tensor([b[4] for b in batch], dtype=torch.bool)\n    q = policy.policy_net(states).gather(1, actions).squeeze(1)\n    with torch.no_grad():\n        nq = target.policy_net(nexts).max(1).values\n        nq = torch.where(dones, torch.zeros_like(nq), nq)\n        target_q = rewards + GAMMA * nq\n    loss = F.smooth_l1_loss(q, target_q)\n    optimizer.zero_grad()\n    loss.backward()\n    optimizer.step()\n\n\ndef evaluate(n=20):\n    policy.policy_net.eval()\n    rs = []\n    for _ in range(n):\n        o, _ = env.reset()\n        d = False\n        t = 0.0\n        while not d:\n            with"]
[142.513499, "i", " torch.no_grad():\n                a = int(policy.policy_net(torch.as_tensor(o, dtype=torch.float32).unsqueeze(0)).argmax(1).item())\n            o, r, term, trunc, _ = env.step(a)\n            t += r\n            d = term or trunc\n        rs.append(t)\n    policy.policy_net.train()\n    return sum(rs) / len(rs)\n\n\nfor ep in range(EPISODES):\n    o, _ = env.reset()\n    d = False\n    total = 0.0\n    while not d:\n        a = select_eps(o)\n        no, r, term, trunc, _ = env.step(a)\n        d = term or trunc\n        buffer.append((o, a, r, no, d))\n        if len(buffer) > BUF:\n            buffer.pop(0)\n        o = no\n        total += r\n        optimize()\n    if ep % TARGET_UPDATE == 0:\n        target.policy_net.load_state_dict(policy.policy_net.state_dict())\n    if ep % 100 == 0:\n        avg = evaluate()\n        print(f'Episode {ep}, train_total={total:.0f}, eval_avg={avg:.1f}, steps={steps_done}', flush=True)\n        if avg >= 495.0:\n            print('Reached target, stopping early.', flush=True)\n            break\n\npo"]
[142.51356, "i", "licy.save(SAVE_PATH)\nfinal_avg = evaluate(n=100)\nprint(f'Final eval avg (100): {final_avg:.2f}', flush=True)\nprint(f'Saved to {SAVE_PATH}', flush=True)\nenv.close()\nPYEOF\n"]
