[142.214056, "i", "cat > /app/agent.py << 'PYEOF'\nimport os\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n\nclass DQN(nn.Module):\n    def __init__(self, n_obs=4, n_act=2, hidden=64):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(n_obs, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, n_act),\n        )\n\n    def forward(self, x):\n        return self.net(x)\n\n\nclass Agent:\n    def __init__(self, n_obs=4, n_act=2, hidden=64):\n        self.device = torch.device('cpu')\n        self.policy_net = DQN(n_obs, n_act, hidden).to(self.device)\n\n    def select_action(self, current_observation):\n        obs = torch.as_tensor(current_observation, dtype=torch.float32, device=self.device)\n        if obs.dim() == 1:\n            obs = obs.unsqueeze(0)\n        with torch.no_grad():\n            q_values = self.policy_net(obs)\n        return int(q_values.argmax(dim=1).item()"]
[142.214718, "o", "cat > /app/agent.py << 'PYEOF'"]
