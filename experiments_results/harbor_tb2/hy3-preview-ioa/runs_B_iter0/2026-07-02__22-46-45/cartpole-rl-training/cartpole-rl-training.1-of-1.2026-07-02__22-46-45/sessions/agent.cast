[142.53593, "o", "> "]
[142.540499, "o", "import random"]
[142.54075, "o", "\r\n\u001b[?2004l\r"]
[142.540824, "o", "\u001b[?2004h> "]
[142.54088, "o", "import math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.540948, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.54102, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.541107, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.54121, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.541278, "o", "import gymnasium as gym\r\n\u001b[?2004l\r"]
[142.541292, "o", "\u001b[?2004h> "]
[142.544588, "o", "from agent import Agent\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> SEED = 0\r\n\u001b[?2004l\r\u001b[?2004h> torch.manual_seed(SEED)\r\n\u001b[?2004l\r\u001b[?2004h> np.random.seed(SEED)\r\n\u001b[?2004l\r\u001b[?2004h> random.seed(SEED)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> env = gym.make('CartPole-v1')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> policy = Agent()"]
[142.557388, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> target = Agent()"]
[142.557641, "o", "\r\n"]
[142.559942, "o", "\u001b[?2004l\r\u001b[?2004h> target.policy_net.load_state_dict(policy.policy_net.state_dict())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> optimizer = torch.optim.Adam(policy.policy_net.parameters(), lr=1e-3)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> BATCH = 128\r\n\u001b[?2004l\r\u001b[?2004h> GAMMA = 0.99\r\n\u001b[?2004l\r\u001b[?2004h> BUF = 20000\r\n\u001b[?2004l\r\u001b[?2004h> TARGET_UPDATE = 10\r\n\u001b[?2004l\r\u001b[?2004h> EPS_START = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> EPS_END = 0.02\r\n\u001b[?2004l\r\u001b[?2004h> EPS_DECAY = 700\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> buffer = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.560392, "o", "steps_done = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.560846, "o", "EPISODES = 2000\r\n\u001b[?2004l\r\u001b[?2004h> SAVE_PATH = '/app/trained_model'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.560915, "o", "\u001b[?2004h"]
[142.561268, "o", "> "]
[142.561339, "o", "def select_eps(obs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.561432, "o", "    global steps_done\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.561502, "o", "    steps_done += 1\r\n\u001b[?2004l\r"]
[142.561517, "o", "\u001b[?2004h"]
[142.564728, "o", ">     eps = EPS_END + (EPS_START - EPS_END) * math.exp(-1.0 * steps_done / EPS_DECAY)\r\n\u001b[?2004l\r\u001b[?2004h>     if random.random() > eps:\r\n\u001b[?2004l\r\u001b[?2004h>         with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>             o = torch.as_tensor(obs, dtype=torch.float32).unsqueeze(0)\r\n\u001b[?2004l\r\u001b[?2004h>             return int(policy.policy_net(o).argmax(1).item())\r\n\u001b[?2004l\r\u001b[?2004h>     return int(env.action_space.sample())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def optimize():\r\n\u001b[?2004l\r\u001b[?2004h>     if len(buffer) < BATCH:\r\n\u001b[?2004l\r\u001b[?2004h>         return\r\n\u001b[?2004l\r\u001b[?2004h>     batch = random.sample(buffer, BATCH)\r\n"]
[142.564776, "o", "\u001b[?2004l\r"]
[142.568808, "o", "\u001b[?2004h>     states = torch.tensor(np.array([b[0] for b in batch], dtype=np.float32))\r\n\u001b[?2004l\r\u001b[?2004h>     actions = torch.tensor([b[1] for b in batch], dtype=torch.int64).unsqueeze(1)\r\n\u001b[?2004l\r\u001b[?2004h>     rewards = torch.tensor([b[2] for b in batch], dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h>     nexts = torch.tensor(np.array([b[3] for b in batch], dtype=np.float32))\r\n\u001b[?2004l\r\u001b[?2004h>     dones = torch.tensor([b[4] for b in batch], dtype=torch.bool)\r\n\u001b[?2004l\r\u001b[?2004h>     q = policy.policy_net(states).gather(1, actions).squeeze(1)\r\n\u001b[?2004l\r\u001b[?2004h>     with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>         nq = target.policy_net(nexts).max(1).values\r\n\u001b[?2004l\r"]
[142.568954, "o", "\u001b[?2004h> "]
[142.569926, "o", "        nq = torch.where(dones, torch.zeros_like(nq), nq)\r\n\u001b[?2004l\r"]
[142.569953, "o", "\u001b[?2004h> "]
[142.576051, "o", "        target_q = rewards + GAMMA * nq\r\n\u001b[?2004l\r\u001b[?2004h>     loss = F.smooth_l1_loss(q, target_q)\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h>     loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.640358, "o", "> def evaluate(n=20):\r\n\u001b[?2004l\r\u001b[?2004h>     policy.policy_net.eval()\r\n\u001b[?2004l\r\u001b[?2004h>     rs = []\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h>         o, _ = env.reset()\r\n\u001b[?2004l\r\u001b[?2004h>         d = False\r\n\u001b[?2004l\r\u001b[?2004h>         t = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         while not d:\r\n\u001b[?2004l\r\u001b[?2004h>             with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>                 a = int(policy.policy_net(torch.as_tensor(o, dtype=torch.float32).unsqueeze(0)).argmax(1).item())\r\n\u001b[?2004l\r\u001b[?2004h>             o, r, term, trunc, _ = env.step(a)\r\n\u001b[?2004l\r\u001b[?2004h>             t += r\r\n\u001b[?2004l\r\u001b[?2004h>             d = term or trunc\r\n\u001b[?2004l\r\u001b[?2004h>         rs.append(t)\r\n\u001b[?2004l\r\u001b[?2004h>     policy.policy_net.train()\r\n\u001b[?2004l\r\u001b[?2004h>     return sum(rs) / len(rs)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for ep in range(EPISODES):\r\n\u001b[?2004l\r\u001b[?2004h>     o, _ = env.reset()\r\n\u001b[?2004l\r\u001b[?2004h>     d = False\r\n\u001b[?2004l\r\u001b[?2004h>     total = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     while "]
[142.640532, "o", "not d:\r\n\u001b[?2004l\r\u001b[?2004h>         a = select_eps(o)\r\n\u001b[?2004l\r\u001b[?2004h>         no, r, term, trunc, _ = env.step(a)\r\n\u001b[?2004l\r\u001b[?2004h>         d = term or trunc\r\n\u001b[?2004l\r\u001b[?2004h>         buffer.append((o, a, r, no, d))\r\n\u001b[?2004l\r\u001b[?2004h>         if len(buffer) > BUF:\r\n\u001b[?2004l\r\u001b[?2004h>             buffer.pop(0)\r\n\u001b[?2004l\r\u001b[?2004h>         o = no\r\n\u001b[?2004l\r\u001b[?2004h>         total += r\r\n\u001b[?2004l\r\u001b[?2004h>         optimize()\r\n\u001b[?2004l\r\u001b[?2004h>     if ep % TARGET_UPDATE == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         target.policy_net.load_state_dict(policy.policy_net.state_dict())\r\n\u001b[?2004l\r\u001b[?2004h>     if ep % 100 == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         avg = evaluate()\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'Episode {ep}, train_total={total:.0f}, eval_avg={avg:.1f}, steps={steps_done}', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h>         if avg >= 495.0:\r\n\u001b[?2004l\r\u001b[?2004h>             print('Reached target, stopping early.', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> policy.save(SAVE_PATH)"]
[142.640573, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> final_avg = evaluate(n=100)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Final eval avg (100): {final_avg:.2f}', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Saved to {SAVE_PATH}', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> env.close()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r\u001b[?2004hroot@c8768147fe25:/app# "]
