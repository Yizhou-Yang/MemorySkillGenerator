[68.511081, "i", "cat > /tmp/do.py << 'EOF'\nimport json, urllib.request\n\nBASE = 'http://api:8000'\n\ndef req(method, path, body=None):\n    url = BASE + path\n    data = json.dumps(body).encode() if body is not None else None\n    r = urllib.request.Request(url, data=data, method=method, headers={'Content-Type':'application/json'})\n    with urllib.request.urlopen(r) as resp:\n        return json.loads(resp.read().decode())\n\n# 1. create spreadsheet\nss = req('POST', '/spreadsheets/', {'title': 'Financial Report'})\nprint('spreadsheet:', ss)\nsid = ss['id']\n\n# 2. create sheet\nsheet = req('POST', f'/spreadsheets/{sid}/sheets/', {'title': 'Q1 Data'})\nprint('sheet:', sheet)\nsheet_id = sheet['id']\n\n# 3 + 4. data + profit column\nupdates = {\n  'A1': {'value': 'Month'},\n  'B1': {'value': 'Revenue'},\n  'C1': {'value': 'Expenses'},\n  'D1': {'value': 'Profit'},\n  'A2': {'value': 'January'},\n  'B2': {'value': 10000},\n  'C2': {'value': 8000},\n  'D2': {'value': 2000},\n  'A3': {'value': 'February'},\n  'B"]
[68.511646, "o", "cat > /tmp/do.py << 'EOF'"]
[68.51181, "o", "\r\n"]
[68.511968, "o", "\u001b[?2004l\r"]
[68.512127, "i", "3': {'value': 12000},\n  'C3': {'value': 9000},\n  'D3': {'value': 3000},\n  'A4': {'value': 'March'},\n  'B4': {'value': 15000},\n  'C4': {'value': 10000},\n  'D4': {'value': 5000},\n}\nbatch = req('PUT', f'/sheets/{sheet_id}/cells/batch', {'updates': updates})\nprint('batch:', batch)\nEOF\npython3 /tmp/do.py\n"]
[68.512797, "o", "\u001b[?2004h"]
[68.513129, "o", "> "]
