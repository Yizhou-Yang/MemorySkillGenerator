[442.769041, "i", "cat > /tmp/final.py << 'EOF'\nimport json, urllib.request, urllib.error\nBASE='http://api:8000'\ndef put(cell, value):\n    url=BASE+f'/sheets/1/cells/{cell}'\n    body=json.dumps({'value':value}).encode()\n    r=urllib.request.Request(url,data=body,method='PUT',headers={'Content-Type':'application/json'})\n    try:\n        with urllib.request.urlopen(r) as resp:\n            return 'ok'\n    except urllib.error.HTTPError as e:\n        return f'ERR {e.code}: {e.read().decode()}'\ncells=[\n  ('A1','Month'),('B1','Revenue'),('C1','Expenses'),('D1','Profit'),\n  ('A2','January'),('B2',10000),('C2',8000),('D2',2000),\n  ('A3','February'),('B3',12000),('C3',9000),('D3',3000),\n  ('A4','March'),('B4',15000),('C4',10000),('D4',5000),\n]\nfor c,v in cells:\n    print(c, put(c,v))\n# verify by reading sheet\nurl=BASE+'/sheets/1'\nwith urllib.request.urlopen(url) as resp:\n    s=json.load(resp)\nprint('DATA:', json.dumps(s['data'], indent=2))\nEOF\npython3 /tmp/final.py\n"]
[442.769541, "o", "cat > /tmp/final.py << 'EOF'"]
