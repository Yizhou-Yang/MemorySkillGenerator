[9.798147, "o", "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Sheets Clone API\",\"description\":\"\\n    A RESTful API for managing spreadsheets and their data. \\n    Supports creating and managing spreadsheets, sheets, and cell data with features \\n    like pagination and batch operations.\\n    \\n    ## Features\\n    * Create and manage spreadsheets\\n    * Create multiple sheets within a spreadsheet\\n    * Update cell values individually or in batch\\n    * Paginated listing of spreadsheets and sheets\\n    * Cell validation with A1 notation support\\n    \",\"version\":\"1.0.0\"},\"paths\":{\"/docs/json\":{\"get\":{\"summary\":\"Get API documentation in JSON format\",\"description\":\"Returns the API documentation in a structured JSON format.\",\"operationId\":\"get_api_docs_docs_json_get\",\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{}}}}}}},\"/docs/simple\":{\"get\":{\"summary\":\"Get simplified API documentation\",\"description\":\"Returns a simplified version of the API documentation.\",\"operationId\":\"get_simple_docs_d"]
