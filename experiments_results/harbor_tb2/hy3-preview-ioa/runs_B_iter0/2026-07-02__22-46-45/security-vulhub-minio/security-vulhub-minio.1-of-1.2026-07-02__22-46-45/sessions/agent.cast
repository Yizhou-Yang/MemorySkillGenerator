[484.971963, "i", "cat > /tmp/diag.py << 'EOF'\nimport socket\nhosts={'node1':'192.168.112.4','node2':'192.168.112.5','node3':'192.168.112.2','gw':'192.168.112.1'}\nfor name,ip in hosts.items():\n    res={}\n    for p in (22,2375,2376,9000,9001):\n        s=socket.socket(); s.settimeout(1.0)\n        r=s.connect_ex((ip,p)); s.close()\n        res[p]='OPEN' if r==0 else 'closed'\n    print(name,ip,res)\nEOF\npython3 /tmp/diag.py\n"]
