[246.120073, "i", "python3 << 'EOF'\nimport http.client\ndef g(ip,p,path):\n    try:\n        c=http.client.HTTPConnection(ip,p,timeout=3); c.request('GET',path)\n        r=c.getresponse(); b=r.read(200)\n        print(p,path,r.status,'svr=',r.headers.get('server',''))\n        print('   ',b[:160]); c.close()\n    except Exception as e:\n        print(p,path,'ERR',e)\nfor p in (8080,8000,9000,80):\n    g('192.168.112.1',p,'/')\n    if p in (8080,8000):\n        g('192.168.112.1',p,'/containers/json')\nEOF\n"]
