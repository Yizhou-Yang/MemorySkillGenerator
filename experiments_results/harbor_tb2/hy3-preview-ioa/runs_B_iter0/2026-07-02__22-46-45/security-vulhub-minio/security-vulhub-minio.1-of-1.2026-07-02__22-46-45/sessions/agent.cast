[146.914201, "o", "    return openp\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def httpget(host,port,path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.914396, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.914495, "o", "        c=http.client.HTTPConnection(host,port,timeout=3)\r\n\u001b[?2004l\r\u001b[?2004h>         c.request('GET',path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.914779, "o", "        r=c.getresponse()\r\n\u001b[?2004l\r\u001b[?2004h>         body=r.read(200)\r\n\u001b[?2004l\r"]
[146.925613, "o", "\u001b[?2004h> "]
[146.925897, "o", "        print('  ->',port,path,'status',r.status)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.926469, "o", "        for h in ('server','www-authenticate','location','content-type'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.926839, "o", "            if h in r.headers: print('     ',h,'=',r.headers[h])\r\n\u001b[?2004l\r\u001b[?2004h>         print('     body:',body[:120])\r\n\u001b[?2004l\r\u001b[?2004h>         c.close()\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.92708, "o", "        print('  ->',port,path,'ERR',e)\r\n\u001b[?2004l\r"]
[146.928148, "o", "\u001b[?2004h"]
[146.928447, "o", "> "]
[146.92873, "o", "\r\n"]
[146.928993, "o", "\u001b[?2004l\r"]
[146.929291, "o", "\u001b[?2004h"]
[146.929559, "o", "> "]
