[78.740392, "i", "python3 << 'EOF'\nimport socket\ntargets={'node1':'192.168.112.4','node2':'192.168.112.5','node3':'192.168.112.2'}\nports=[22,80,443,2375,2376,6443,8000,8080,8443,9000,9001,9090,2379,2380,3306,5432,11211,27017]\nfor n,ip in targets.items():\n    openp=[]\n    for p in ports:\n        s=socket.socket(); s.settimeout(0.3)\n        r=s.connect_ex((ip,p)); s.close()\n        if r==0: openp.append(p)\n    print(n,ip,'OPEN',openp)\nEOF\n"]
