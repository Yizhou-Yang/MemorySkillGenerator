[289.50377, "i", "python3 << 'EOF'\nimport socket\ndef scan(ip):\n    openp=[]\n    for p in range(1,1025):\n        s=socket.socket(); s.settimeout(0.2)\n        r=s.connect_ex((ip,p)); s.close()\n        if r==0: openp.append(p)\n    return openp\nprint('node1 ports:',scan('192.168.112.4'))\ntry:\n    s=socket.socket(); s.settimeout(3); s.connect(('192.168.112.1',22))\n    s.settimeout(2); print('SSH .1 banner:', s.recv(200)); s.close()\nexcept Exception as e:\n    print('SSH .1 err',e)\nEOF\n"]
