[146.908745, "i", "cat > /tmp/recon.py << 'PYEOF'\nimport socket, http.client\nfrom urllib.parse import urlparse\n\ndef scan(ip):\n    openp=[]\n    for p in range(1,1025):\n        s=socket.socket(); s.settimeout(0.05)\n        r=s.connect_ex((ip,p)); s.close()\n        if r==0: openp.append(p)\n    return openp\n\ndef httpget(host,port,path):\n    try:\n        c=http.client.HTTPConnection(host,port,timeout=3)\n        c.request('GET',path)\n        r=c.getresponse()\n        body=r.read(200)\n        print('  ->',port,path,'status',r.status)\n        for h in ('server','www-authenticate','location','content-type'):\n            if h in r.headers: print('     ',h,'=',r.headers[h])\n        print('     body:',body[:120])\n        c.close()\n    except Exception as e:\n        print('  ->',port,path,'ERR',e)\n\nip='192.168.112.4'\nprint('OPEN PORTS node1:',scan(ip))\nfor port in (9000,9001):\n    print('=== node1',port,'===')\n    httpget(ip,port,'/')\n    httpget(ip,port,'/minio/health/live')\n    httpget(ip,port,'/minio/health/ready')\nprint('--- mounts ---')\nprint(open('/proc/mounts').read())\nPYEOF\npython3 /tmp/recon.py\n"]
