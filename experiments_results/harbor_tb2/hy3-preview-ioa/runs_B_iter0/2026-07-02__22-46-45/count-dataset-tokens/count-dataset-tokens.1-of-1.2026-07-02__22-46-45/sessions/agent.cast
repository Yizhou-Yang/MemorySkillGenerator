[233.498204, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[233.498708, "o", "# Try loading with streaming to inspect fields"]
[233.498806, "o", "\r\n"]
[233.49908, "o", "\u001b[?2004l\r"]
[233.499399, "o", "\u001b[?2004h"]
[233.499811, "o", "> "]
[233.502169, "o", "stream = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\", streaming=True)"]
[233.502487, "o", "\r\n"]
[233.502798, "o", "\u001b[?2004l\r"]
[233.503127, "o", "\u001b[?2004h"]
[233.503292, "o", "> "]
[233.508427, "o", "stream = itertools.islice(stream, 3000)"]
[233.50916, "o", "\r\n"]
[233.509509, "o", "\u001b[?2004l\r"]
[233.509707, "o", "\u001b[?2004h"]
[233.510213, "o", "> "]
[233.510929, "o", "domains = set()"]
[233.511358, "o", "\r\n"]
[233.511636, "o", "\u001b[?2004l\r"]
[233.512446, "o", "\u001b[?2004h"]
[233.512879, "o", "> "]
[233.513175, "o", "first = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[233.513507, "o", "> for ex in stream:"]
[233.514393, "o", "\r\n"]
[233.514474, "o", "\u001b[?2004l\r"]
[233.514655, "o", "\u001b[?2004h"]
[233.514948, "o", ">     if first is None:"]
[233.51527, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.515485, "o", "        first = ex"]
[233.515822, "o", "\r\n"]
[233.51597, "o", "\u001b[?2004l\r"]
[233.516114, "o", "\u001b[?2004h"]
[233.516229, "o", "> "]
[233.516507, "o", "    domains.add(ex.get(\"domain\"))"]
[233.516819, "o", "\r\n"]
[233.516897, "o", "\u001b[?2004l\r"]
[233.517101, "o", "\u001b[?2004h"]
[233.517245, "o", "> "]
[233.517427, "o", "print(\"DOMAINS:\", domains)\r\n\u001b[?2004l\r\u001b[?2004h"]
[233.517802, "o", "> "]
[233.518166, "o", "print(\"KEYS:\", list(first.keys()) if first else None)\r\n\u001b[?2004l\r"]
[233.518306, "o", "\u001b[?2004h"]
[233.518564, "o", "> "]
[233.518761, "o", "if first:"]
[233.518982, "o", "\r\n"]
[233.519158, "o", "\u001b[?2004l\r"]
[233.519209, "o", "\u001b[?2004h"]
[233.519516, "o", "> "]
[233.519756, "o", "    for k,v in first.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[233.520234, "o", "> "]
[233.520352, "o", "        s = v if isinstance(v,str) else str(v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.520494, "o", "        print(f\"--- {k} len={len(s)} ---\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[233.52064, "o", "        print(s[:200].replace(chr(10),' '))\r\n\u001b[?2004l\r"]
[233.520914, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[233.586322, "o", "\u001b[?2004hroot@197fa7054d0e:/app# "]
[233.586509, "o", "python3 /app/explore.py 2>&1 | tail -40\r\n\u001b[?2004l\r"]
