[81.020254, "o", "        <li><strong>M.Sc., Bioinformatics</strong> — Riverbend University, 2012–2014. Thesis: “Statistical Methods for Single-Cell RNA-Seq Analysis”.</li>\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.020466, "o", "> "]
[81.024589, "o", "        <li><strong>B.Sc., Computer Science</strong> — Crestfield College of Engineering, 2008–2012. Graduated magna cum laude; President, Data Science Club.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     </section>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     <section>\r\n\u001b[?2004l\r\u001b[?2004h>       <h2>Research Interests</h2>\r\n\u001b[?2004l\r\u001b[?2004h>       <ul>\r\n\u001b[?2004l\r\u001b[?2004h>         <li><strong>Neural Encoding &amp; Decoding</strong> — Interpretable models translating spike-train data into behavioral predictions.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li><strong>Machine Learning for Biomedical Imaging</strong> — CNNs and GNNs applied to MRI and two-photon microscopy data.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li><strong>Single-Cell Omics</strong> — Scalable pipelines integrating multi-modal single-cell genomics and spatial transcriptomics.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li><strong>Explainable AI in Neuroscience</strong> — Frameworks to probe decision boundaries and feature attributions.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     </section>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     <section>\r\n\u001b[?2004l\r\u001b[?2004h>       <h2>Selected Projects</h2>\r\n\u001b[?2004l\r\u001b[?2004h>       <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\r\n\u001b[?2004l\r\u001b[?2004h>       <p class=\"date-badge\">Role: Lead Developer &amp; Project Coordinator</p>"]
[81.041787, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>       <ul>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Designed a PyTorch-based pipeline to segment two-photon images of mouse visual cortex.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium-imaging traces.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Deployed a Dockerized microservice for real-time processing with Cascade Imaging Lab.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       </ul>\r\n\u001b[?2004l\r\u001b[?2004h>       <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\r\n\u001b[?2004l\r\u001b[?2004h>       <p class=\"date-badge\">Role: Principal Investigator</p>\r\n\u001b[?2004l\r\u001b[?2004h>       <ul>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Constructed graph representations of reconstructed neuron meshes from electron microscopy.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Published an open-source toolkit in the NeuroTools suite (adopted by 12 labs).</li>\r\n\u001b[?2004l\r\u001b[?2004h>       </ul>\r\n\u001b[?2004l\r\u001b[?2004h>       <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\r\n\u001b[?2004l\r\u001b[?2004h>       <p class=\"date-badge\">Role: Co-Principal Investigator</p>\r\n\u001b[?2004l\r\u001b[?2004h>       <ul>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Developed a Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH data.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Implemented Bayesian clustering to resolve cell-type hierarchies in human cortical organoids.</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Presented at ICSCG 2023.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     </section>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     <section>\r\n\u001b[?2004l\r\u001b[?2004h>       <h2>Teaching &amp; Mentorship</h2>\r\n\u001b[?2004l\r\u001b[?2004h>       <ul>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Undergraduate Course: “Introduction to Computational Neuroscience” (Spring 2025)</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Graduate Seminar: “Advanced Machine Learning Methods in Biology” (Fall 2024)</li>\r\n\u001b[?2004l\r\u001b[?2004h>         <li>Mentorship: Supervised 8 Ph.D. students and 12 Master's theses.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     </section>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     <section>\r\n\u001b[?2004l\r\u001b[?2004h>       <h2>Skills &amp; Tools</h2>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.051348, "o", "      <p><span class=\"tag\">Python</span><span class=\"tag\">R</span><span class=\"tag\">C++</span><span class=\"tag\">PyTorch</span><span class=\"tag\">TensorFlow</span><span class=\"tag\">scikit-learn</span><span class=\"tag\">NetworkX</span><span class=\"tag\">Nextflow</span><span class=\"tag\">Snakemake</span><span class=\"tag\">Docker</span><span class=\"tag\">Kubernetes</span><span class=\"tag\">MATLAB</span><span class=\"tag\">Jupyter</span><span class=\"tag\">Seurat</span><span class=\"tag\">Scanpy</span><span class=\"tag\">D3.js</span><span class=\"tag\">Plotly</span></p>\r\n\u001b[?2004l\r\u001b[?2004h>     </section>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     <section>\r\n\u001b[?2004l\r\u001b[?2004h>       <h2>Contact</h2>\r\n\u001b[?2004l\r\u001b[?2004h>       <div class=\"contact-grid\">\r\n\u001b[?2004l\r\u001b[?2004h>         <div><strong>Email</strong> lydia.moreno@riverbend.edu</div>\r\n\u001b[?2004l\r\u001b[?2004h>         <div><strong>Office</strong> Blakely Hall, Room 312, Riverbend University</div>\r\n\u001b[?2004l\r\u001b[?2004h>         <div><strong>Twitter</strong> <a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></div>\r\n\u001b[?2004l\r\u001b[?2004h>         <div><strong>GitHub</strong> <a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></div>\r\n\u001b[?2004l\r\u001b[?2004h>       </div>\r\n\u001b[?2004l\r\u001b[?2004h>     </section>\r\n\u001b[?2004l\r\u001b[?2004h>   </main>\r\n\u001b[?2004l\r\u001b[?2004h>   <footer class=\"site\">© 2025 Dr. Lydia Moreno · Built as a static research profile site.</footer>\r\n\u001b[?2004l\r\u001b[?2004h> </body>\r\n\u001b[?2004l\r\u001b[?2004h> </html>\r\n\u001b[?2004l\r\u001b[?2004h> HTML\r\n\u001b[?2004l\r"]
[81.12, "m", "Episode 5: 2 commands"]
