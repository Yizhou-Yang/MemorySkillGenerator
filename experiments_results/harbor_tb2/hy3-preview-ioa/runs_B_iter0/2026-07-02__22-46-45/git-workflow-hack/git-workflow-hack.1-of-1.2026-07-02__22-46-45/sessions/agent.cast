[80.971845, "o", "\u001b[?2004h>     <div class=\"wrap\">\r\n\u001b[?2004l\r\u001b[?2004h>       <h1>Dr. Lydia Moreno</h1>\r\n\u001b[?2004l\r\u001b[?2004h>       <div class=\"role\">Associate Professor of Computational Neuroscience · Riverbend University, School of Biological Sciences</div>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </header>\r\n\u001b[?2004l\r\u001b[?2004h>   <nav class=\"site\">\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"wrap\">\r\n\u001b[?2004l\r\u001b[?2004h>       <a href=\"index.html\" class=\"active\">About Me</a>\r\n\u001b[?2004l\r\u001b[?2004h>       <a href=\"blog.html\">Blog</a>\r\n\u001b[?2004l\r\u001b[?2004h>       <a href=\"publications.html\">Publications</a>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </nav>\r\n\u001b[?2004l\r\u001b[?2004h>   <main>\r\n\u001b[?2004l\r\u001b[?2004h>     <section>\r\n\u001b[?2004l\r\u001b[?2004h>       <h2>About</h2>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.984961, "o", "      <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University's School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     </section>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.985034, "o", "> "]
