[100.278311, "i", "cat > blog.html <<'HTML'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Blog — Dr. Lydia Moreno</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"wrap\">\n      <h1>Dr. Lydia Moreno</h1>\n      <div class=\"role\">Associate Professor of Computational Neuroscience · Riverbend University</div>\n    </div>\n  </header>\n  <nav class=\"site\">\n    <div class=\"wrap\">\n      <a href=\"index.html\">About Me</a>\n      <a href=\"blog.html\" class=\"active\">Blog</a>\n      <a href=\"publications.html\">Publications</a>\n    </div>\n  </nav>\n  <main>\n    <section>\n      <h2>Latest Posts</h2>\n      <article class=\"post\">\n        <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\n        <div class=\"date\">March 2025</div>\n        <p>A walkthrough of techniques for opening the black box of deep networks trained on neura"]
[100.278825, "i", "l data — from saliency maps to concept attribution — and why interpretability matters for neuroscience.</p>\n        <a href=\"#\">Read more →</a>\n      </article>\n      <article class=\"post\">\n        <h3>Bridging Machine Learning and Single-Cell Genomics</h3>\n        <div class=\"date\">January 2025</div>\n        <p>How representation learning is reshaping the analysis of scRNA-Seq and spatial transcriptomics, and practical lessons from building multi-modal integration pipelines.</p>\n        <a href=\"#\">Read more →</a>\n      </article>\n      <article class=\"post\">\n        <h3>Scaling Graph Neural Networks for Connectomics</h3>\n        <div class=\"date\">November 2024</div>\n        <p>Reflections on training GNNs over large electron-microscopy reconstructions: memory footprint, sampling strategies, and what we learned deploying NeuroGraph.</p>\n        <a href=\"#\">Read more →</a>\n      </article>\n    </section>\n  </main>\n  <footer class=\"site\">© 2025 Dr. Lydia Moreno · Built as a static research profile site.</footer>\n</body>\n</html>\nHTML\n"]
