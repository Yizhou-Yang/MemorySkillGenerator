[80.899038, "i", "cat > index.html <<'HTML'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dr. Lydia Moreno — Research Profile</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"wrap\">\n      <h1>Dr. Lydia Moreno</h1>\n      <div class=\"role\">Associate Professor of Computational Neuroscience · Riverbend University, School of Biological Sciences</div>\n    </div>\n  </header>\n  <nav class=\"site\">\n    <div class=\"wrap\">\n      <a href=\"index.html\" class=\"active\">About Me</a>\n      <a href=\"blog.html\">Blog</a>\n      <a href=\"publications.html\">Publications</a>\n    </div>\n  </nav>\n  <main>\n    <section>\n      <h2>About</h2>\n      <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University's School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscie"]
[80.899475, "i", "nce, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n    </section>\n\n    <section>\n      <h2>Education</h2>\n      <ul>\n        <li><strong>Ph.D., Computational Biology</strong> — Baywood Institute of Technology, 2014–2019. Dissertation: “Deep Learning Models for Decoding Neural Population Activity”.</li>\n        <li><strong>M.Sc., Bioinformatics</strong> — Riverbend University, 2012–2014. Thesis: “Statistical Methods for Single-Cell RNA-Seq Analysis”.</li>\n        <li><strong>B.Sc., Computer Science</strong> — Crestfield College of Engineering, 2008–2012. Graduated magna cum laude; President, Data Science Club.</li>\n      </ul>\n    </section>\n\n    <section>\n      <h2>Research Interests</h2>\n      <ul>\n        <li><strong>Neural Encoding &amp; Decoding</strong> — Interpretable models translating spike-train data into behavioral predictions.</li>\n        <li><strong>Machine Learning for Biomedical Imaging</strong> — CNNs and GNNs applied to MRI and two-photon microscopy data.</li>\n        <li><strong>Single-Cell Omics</strong> — Scalable pipelines integrating multi-modal single-cell genomics and spatial transcriptomics.</li>\n        <li><strong>Explainable AI in Neuroscience</strong> — Frameworks to probe decision boundaries and feature attributions.</li>\n      </ul>\n    </section>\n\n    <section>\n      <h2>Selected Projects</h2>\n      <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\n      <p class=\"date-badge\">Role: Lead Developer &amp; Project Coordinator</p>\n      <ul>\n        <li>Designed a PyTorch-based pipeline to segment two-photon images of mouse visual cortex.</li>\n        <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium-imaging tr"]
[80.899589, "i", "aces.</li>\n        <li>Deployed a Dockerized microservice for real-time processing with Cascade Imaging Lab.</li>\n      </ul>\n      <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\n      <p class=\"date-badge\">Role: Principal Investigator</p>\n      <ul>\n        <li>Constructed graph representations of reconstructed neuron meshes from electron microscopy.</li>\n        <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\n        <li>Published an open-source toolkit in the NeuroTools suite (adopted by 12 labs).</li>\n      </ul>\n      <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\n      <p class=\"date-badge\">Role: Co-Principal Investigator</p>\n      <ul>\n        <li>Developed a Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH data.</li>\n        <li>Implemented Bayesian clustering to resolve cell-type hierarchies in human cortical organoids.</li>\n        <li>Presented at ICSCG 2023.</li>\n      </ul>\n    </section>\n\n    <section>\n      <h2>Teaching &amp; Mentorship</h2>\n      <ul>\n        <li>Undergraduate Course: “Introduction to Computational Neuroscience” (Spring 2025)</li>\n        <li>Graduate Seminar: “Advanced Machine Learning Methods in Biology” (Fall 2024)</li>\n        <li>Mentorship: Supervised 8 Ph.D. students and 12 Master's theses.</li>\n      </ul>\n    </section>\n\n    <section>\n      <h2>Skills &amp; Tools</h2>\n      <p><span class=\"tag\">Python</span><span class=\"tag\">R</span><span class=\"tag\">C++</span><span class=\"tag\">PyTorch</span><span class=\"tag\">TensorFlow</span><span class=\"tag\">scikit-learn</span><span class=\"tag\">NetworkX</span><span class=\"tag\">Nextflow</span><span class=\"tag\">Snakemake</span><span class=\"tag\">Docker</span><span class=\"tag\">Kubernetes</span><span class=\"tag\">MATLAB</span><span class=\"tag\">Jupyter</span><span class=\"tag\">Seurat</span><span class=\"tag\">Scanpy</span><span class=\"tag\">D3.js</span><span class=\"tag\">Plotly</span></p>\n    </section>\n\n    <section>\n      <h2>Contact</h2>\n      <div class=\"contact-grid\">\n  "]
[80.899696, "i", "      <div><strong>Email</strong> lydia.moreno@riverbend.edu</div>\n        <div><strong>Office</strong> Blakely Hall, Room 312, Riverbend University</div>\n        <div><strong>Twitter</strong> <a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></div>\n        <div><strong>GitHub</strong> <a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></div>\n      </div>\n    </section>\n  </main>\n  <footer class=\"site\">© 2025 Dr. Lydia Moreno · Built as a static research profile site.</footer>\n</body>\n</html>\nHTML\n"]
