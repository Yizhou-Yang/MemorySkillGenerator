[100.628853, "i", "cat > publications.html <<'HTML'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Publications — Dr. Lydia Moreno</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"wrap\">\n      <h1>Dr. Lydia Moreno</h1>\n      <div class=\"role\">Associate Professor of Computational Neuroscience · Riverbend University</div>\n    </div>\n  </header>\n  <nav class=\"site\">\n    <div class=\"wrap\">\n      <a href=\"index.html\">About Me</a>\n      <a href=\"blog.html\">Blog</a>\n      <a href=\"publications.html\" class=\"active\">Publications</a>\n    </div>\n  </nav>\n  <main>\n    <section>\n      <h2>Selected Publications</h2>\n      <article class=\"pub\">\n        <p>Moreno, L., &amp; Patel, A. (2024). “Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals.” <em>Journal of Computational Neuroscience</em>, 45(2), 123–137.</p>\n        <div class=\"meta\">Journal of Computational Neuroscience · 2024</div>\n      </article>\n      <article class=\"pub\">\n        <p>Moreno, L., Zhang, W., &amp; Singh, R. (2023). “Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets.” <em>Neuroinformatics</em>, 21(4), 299–312.</p>\n        <div class=\"meta\">Neuroinformatics · 2023</div>\n      </article>\n      <article class=\"pub\">\n        <p>Moreno, L. et al. (2022). “Integrative Single-Cell Atlas of Human Cerebral Organoids.” <em>Cell Systems</em>, 9(1), 67–82.</p>\n        <div class=\"meta\">Cell Systems · 2022</div>\n      </article>\n      <article class=\"pub\">\n        <p>Chen, J., Moreno, L., &amp; Russo, M. (2021). “Explainable AI Techniques in Neural Decoding.” <em>Frontiers in Neuroscience</em>, 15, 756843.</p>\n        <div class=\"meta\">Frontiers in Neuroscience · 2021</div>\n      </article>\n    </section>\n  </main>\n  <footer class=\"site\">© 2025 Dr. Lydia Moreno · Built as a static research profile site.</footer>\n</body>\n</html>\nHTML\n"]
[100.631014, "o", "cat > publications.html <<'HTML'"]
