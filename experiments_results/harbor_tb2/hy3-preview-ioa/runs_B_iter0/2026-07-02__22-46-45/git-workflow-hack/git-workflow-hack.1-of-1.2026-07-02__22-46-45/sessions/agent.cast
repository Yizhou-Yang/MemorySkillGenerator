[117.737784, "o", "name: Deploy Site\r\n\r\n# Deploys the static research-profile site to GitHub Pages.\r\n# NOTE: A previous version of this workflow contained a malicious step that\r\n# archived the entire repository and POSTed it to an external host\r\n# (https://hackerX.com/upload). That exfiltration step has been REMOVED.\r\n# This workflow only publishes the site to GitHub Pages via the standard\r\n# GITHUB_TOKEN; it makes no outbound requests to third-party servers.\r\non:\r\n  push:\r\n    branches:\r\n      - main\r\n  workflow_dispatch:\r\n\r\npermissions:\r\n  contents: read\r\n  pages: write\r\n  id-token: write\r\n\r\njobs:\r\n  deploy:\r\n    runs-on: ubuntu-latest\r\n    environment:\r\n      name: github-pages\r\n      url: ${{ steps.deployment.outputs.page_url }}\r\n    steps:\r\n      - name: Check out repository\r\n        uses: actions/checkout@v4\r\n\r\n      - name: Setup Pages\r\n        uses: actions/configure-pages@v4\r\n\r\n      - name: Upload site artifact\r\n        uses: actions/upload-pages-artifact@v3\r\n        with:\r\n          # Publish the static site (HTML + CSS) from the repo root.\r\n          path: .\r\n\r\n      - name: Deploy to GitHub Pages\r\n        id: deployment\r\n        uses: actions/deploy-pages@v4\r\n"]
[117.738534, "o", "\u001b[?2004h"]
[117.73884, "m", "Episode 7: 5 commands"]
