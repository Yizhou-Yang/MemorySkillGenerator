[117.016863, "o", "\u001b[?2004h> permissions:\r\n\u001b[?2004l\r\u001b[?2004h>   contents: read\r\n\u001b[?2004l\r\u001b[?2004h>   pages: write\r\n\u001b[?2004l\r\u001b[?2004h>   id-token: write\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> jobs:\r\n\u001b[?2004l\r\u001b[?2004h>   deploy:\r\n\u001b[?2004l\r\u001b[?2004h>     runs-on: ubuntu-latest\r\n\u001b[?2004l\r\u001b[?2004h>     environment:\r\n\u001b[?2004l\r\u001b[?2004h>       name: github-pages\r\n\u001b[?2004l\r\u001b[?2004h>       url: ${{ steps.deployment.outputs.page_url }}\r\n\u001b[?2004l\r\u001b[?2004h>     steps:\r\n\u001b[?2004l\r\u001b[?2004h>       - name: Check out repository\r\n\u001b[?2004l\r\u001b[?2004h>         uses: actions/checkout@v4\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       - name: Setup Pages\r\n\u001b[?2004l\r\u001b[?2004h>         uses: actions/configure-pages@v4\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       - name: Upload site artifact\r\n\u001b[?2004l\r\u001b[?2004h>         uses: actions/upload-pages-artifact@v3\r\n\u001b[?2004l\r\u001b[?2004h>         with:\r\n\u001b[?2004l\r\u001b[?2004h>           # Publish the static site (HTML + CSS) from the repo root.\r\n\u001b[?2004l\r\u001b[?2004h>           path: .\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       - name: Deploy to GitHub Pages\r\n\u001b[?2004l\r\u001b[?2004h>         id: deployment\r\n\u001b[?2004l\r\u001b[?2004h>         uses: actions/deploy-pages@v4\r\n\u001b[?2004l\r\u001b[?2004h> YML\r\n\u001b[?2004l\r"]
