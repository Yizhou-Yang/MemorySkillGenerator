[61.257567, "i", "cat > css/style.css <<'CSS'\n:root {\n  --navy: #1f3a5f;\n  --navy-dark: #15283f;\n  --slate: #475569;\n  --accent: #2c7a7b;\n  --bg: #f7f8fa;\n  --card: #ffffff;\n  --border: #e2e8f0;\n  --text: #1e293b;\n  --muted: #64748b;\n}\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n  color: var(--text);\n  background: var(--bg);\n  line-height: 1.65;\n  font-size: 17px;\n}\na { color: var(--accent); text-decoration: none; }\na:hover { text-decoration: underline; }\nheader.site {\n  background: linear-gradient(135deg, var(--navy), var(--navy-dark));\n  color: #fff;\n  padding: 2.5rem 0 2rem;\n}\nheader.site .wrap { max-width: 880px; margin: 0 auto; padding: 0 1.5rem; }\nheader.site h1 { margin: 0 0 .25rem; font-size: 2.2rem; letter-spacing: -0.5px; }\nheader.site .role { color: #bcd0e8; font-size: 1.05rem; }\nnav.site {\n  background: #fff;\n  border-bottom: 1px solid var(--border);\n  position: s"]
[61.260256, "o", "cat > css/style.css <<'CSS'\r\n\u001b[?2004l\r"]
[61.260369, "i", "ticky;\n  top: 0;\n  z-index: 10;\n}\nnav.site .wrap { max-width: 880px; margin: 0 auto; padding: .6rem 1.5rem; display: flex; gap: 1.5rem; }\nnav.site a { color: var(--slate); font-weight: 600; }\nnav.site a:hover, nav.site a.active { color: var(--navy); text-decoration: none; }\nmain { max-width: 880px; margin: 2rem auto; padding: 0 1.5rem; }\nsection { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem 1.75rem; margin-bottom: 1.5rem; box-shadow: 0 1px 2px rgba(0,0,0,.03); }\nh2 { color: var(--navy); border-bottom: 2px solid var(--border); padding-bottom: .4rem; margin-top: 0; font-size: 1.4rem; }\nh3 { color: var(--navy-dark); margin-bottom: .2rem; }\nul { padding-left: 1.25rem; }\nul li { margin-bottom: .35rem; }\n.pub, .post { padding: .9rem 0; border-bottom: 1px solid var(--border); }\n.pub:last-child, .post:last-child { border-bottom: none; }\n.pub .meta, .post .date { color: var(--muted); font-size: .9rem; }\n.tag { display: inline-block; background: #e6f0ee; color: var(--accent); font-size: .78rem; padding: 2px 8px; border-radius: 4px; margin-right: 6px; }\n.contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }\n.contact-grid div { background: var(--bg); padding: .9rem 1rem; border-radius: 8px; border: 1px solid var(--border); }\n.contact-grid strong { display: block; color: var(--navy); font-size: .85rem; text-transform: uppercase; letter-spacing: .04em; }\nfooter.site { text-align: center; color: var(--muted); font-size: .85rem; padding: 2rem 1rem 3rem; }\n.date-badge { color: var(--muted); font-size: .8rem; }\nCSS\n"]
