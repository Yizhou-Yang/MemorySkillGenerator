[116.984497, "i", "cat > .github/workflows/deploy.yml <<'YML'\nname: Deploy Site\n\n# Deploys the static research-profile site to GitHub Pages.\n# NOTE: A previous version of this workflow contained a malicious step that\n# archived the entire repository and POSTed it to an external host\n# (https://hackerX.com/upload). That exfiltration step has been REMOVED.\n# This workflow only publishes the site to GitHub Pages via the standard\n# GITHUB_TOKEN; it makes no outbound requests to third-party servers.\non:\n  push:\n    branches:\n      - main\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  pages: write\n  id-token: write\n\njobs:\n  deploy:\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Check out repository\n        uses: actions/checkout@v4\n\n      - name: Setup Pages\n        uses: actions/configure-pages@v4\n\n      - name: Upload site artifact\n        uses: actions/upload-pages-artifact@v3\n        with:\n          # Publish the static site (HTML + CSS) from the repo root.\n          path: .\n\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v4\nYML\n"]
[116.989404, "o", "cat > .github/workflows/deploy.yml <<'YML'\r\n\u001b[?2004l\r\u001b[?2004h> name: Deploy Site\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Deploys the static research-profile site to GitHub Pages."]
[117.010328, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # NOTE: A previous version of this workflow contained a malicious step that\r\n\u001b[?2004l\r\u001b[?2004h> # archived the entire repository and POSTed it to an external host\r\n\u001b[?2004l\r\u001b[?2004h> # (https://hackerX.com/upload). That exfiltration step has been REMOVED.\r\n\u001b[?2004l\r\u001b[?2004h> # This workflow only publishes the site to GitHub Pages via the standard\r\n\u001b[?2004l\r\u001b[?2004h> # GITHUB_TOKEN; it makes no outbound requests to third-party servers.\r\n\u001b[?2004l\r\u001b[?2004h> on:\r\n\u001b[?2004l\r"]
[117.011027, "o", "\u001b[?2004h> "]
