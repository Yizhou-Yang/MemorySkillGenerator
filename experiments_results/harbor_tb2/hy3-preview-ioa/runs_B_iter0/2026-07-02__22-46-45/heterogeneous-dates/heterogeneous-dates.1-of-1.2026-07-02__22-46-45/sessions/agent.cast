[17.691083, "o", "\u001b[?2004hroot@9552f3c59b56:/app# "]
[29.337292, "i", "python3 -c \"\nimport csv, re\nfrom datetime import datetime\ndef norm(d):\n    d=d.split()[0]\n    for fmt in ('%Y-%m-%d','%m/%d/%Y','%m-%d-%Y'):\n        try:\n            return datetime.strptime(d,fmt).strftime('%Y-%m-%d')\n        except: pass\n    return d\nhigh={}\nwith open('daily_temp_sf_high.csv') as f:\n    for r in csv.reader(f):\n        if r and r[0]=='date': continue\n        high[norm(r[0])]=float(r[1])\nlow={}\nwith open('daily_temp_sf_low.csv') as f:\n    for r in csv.reader(f):\n        if r and r[0]=='date': continue\n        low[norm(r[0])]=float(r[1])\ndiffs=[high[d]-low[d] for d in high if d in low]\navg=sum(diffs)/len(diffs)\nwith open('avg_temp.txt','w') as f:\n    f.write(str(avg))\nprint(diffs, avg)\n\"\n"]
