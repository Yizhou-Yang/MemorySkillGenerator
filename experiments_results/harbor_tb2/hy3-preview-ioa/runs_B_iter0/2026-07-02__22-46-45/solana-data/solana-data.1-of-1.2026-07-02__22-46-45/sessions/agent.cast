[556.614927, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_transaction(signature):\r\n\u001b[?2004l\r\u001b[?2004h>     params = [signature, {\"encoding\": \"jsonParsed\", \"maxSupportedTransactionVersion\": 0}]\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         result = rpc(\"getTransaction\", params)\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         raise NotFound(\"Transaction %s not found: %s\" % (signature, e))\r\n\u001b[?2004l\r\u001b[?2004h>     if result is None:\r\n\u001b[?2004l\r\u001b[?2004h>         raise NotFound(\"Transaction %s not found\" % signature)\r\n\u001b[?2004l\r\u001b[?2004h>     meta = result.get(\"meta\") or {}\r\n\u001b[?2004l\r\u001b[?2004h>     err = meta.get(\"err\")\r\n\u001b[?2004l\r\u001b[?2004h>     success = err is None\r\n\u001b[?2004l\r\u001b[?2004h>     fee = meta.get(\"fee\")\r\n\u001b[?2004l\r\u001b[?2004h>     transfers = []\r\n\u001b[?2004l\r\u001b[?2004h>     pre = {b.get(\"accountIndex\"): b for b in (meta.get(\"preTokenBalances\") or [])}\r\n\u001b[?2004l\r\u001b[?2004h>     post = {b.get(\"accountIndex\"): b for b in (meta.get(\"postTokenBalances\") or [])}\r\n\u001b[?2004l\r\u001b["]
