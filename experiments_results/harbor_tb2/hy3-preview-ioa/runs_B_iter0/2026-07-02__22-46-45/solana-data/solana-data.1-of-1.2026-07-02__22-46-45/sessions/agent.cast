[590.958317, "i", "cat > /app/test.py << 'EOF'\nimport urllib.request, json\ndef hit(path):\n    try:\n        r = urllib.request.urlopen('http://127.0.0.1:5000'+path, timeout=30)\n        return r.status, r.read().decode()\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode()\nfor p in ['/status',\n          '/block/123',\n          '/transaction/abc',\n          '/account/11111111111111111111111111111111',\n          '/program/Vote111111111111111111111111111111111111111/accounts?limit=3&offset=0']:\n    code, body = hit(p)\n    print('---', p, 'HTTP', code)\n    try:\n        print(json.dumps(json.loads(body), indent=2)[:400])\n    except Exception:\n        print(body[:400])\nEOF\npython3 /app/test.py\n"]
