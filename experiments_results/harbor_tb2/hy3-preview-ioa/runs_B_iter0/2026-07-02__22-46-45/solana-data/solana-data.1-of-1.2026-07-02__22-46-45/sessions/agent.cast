[379.215043, "i", "cat > /app/probe2.py << 'EOF'\nimport socket\nhosts = ['api.devnet.solana.com','api.testnet.solana.com','api.mainnet-beta.solana.com']\nbody = b'{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\"}'\nfor h in hosts:\n    try:\n        s = socket.create_connection((h,443), timeout=20)\n        req = (f'POST https://{h}/ HTTP/1.1\\r\\n'\n               f'Host: {h}\\r\\n'\n               'Content-Type: application/json\\r\\n'\n               f'Content-Length: {len(body)}\\r\\n'\n               'Connection: close\\r\\n\\r\\n').encode() + body\n        s.sendall(req)\n        data = b''\n        while True:\n            try:\n                chunk = s.recv(4096)\n            except socket.timeout:\n                break\n            if not chunk: break\n            data += chunk\n            if len(data) > 2000: break\n        print('====', h, 'len', len(data))\n        print(data[:600])\n        s.close()\n    except Exception as e:\n        print('====', h, 'ERR', type(e).__name__, str(e)[:150])\nEOF\npython3 /app/probe2.py\n"]
[379.215992, "o", "cat > /app/probe2.py << 'EOF'"]
