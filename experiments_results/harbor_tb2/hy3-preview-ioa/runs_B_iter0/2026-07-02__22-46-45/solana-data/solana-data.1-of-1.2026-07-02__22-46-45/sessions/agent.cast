[556.016846, "i", "urllib.request.urlopen(req, timeout=timeout) as resp:\n            text = resp.read().decode()\n    except urllib.error.HTTPError as e:\n        raise RpcError(\"HTTP %s: %s\" % (e.code, e.reason))\n    except urllib.error.URLError as e:\n        raise RpcError(\"Network error: %s\" % e.reason)\n    except Exception as e:\n        raise RpcError(\"Request error: %s\" % e)\n    try:\n        j = json.loads(text)\n    except Exception as e:\n        raise RpcError(\"Invalid JSON response: %s\" % e)\n    if \"error\" in j and j[\"error\"] is not None:\n        msg = j[\"error\"]\n        if isinstance(msg, dict):\n            msg = msg.get(\"message\", str(msg))\n        raise RpcError(str(msg))\n    return j.get(\"result\")\n\n\ndef get_status():\n    try:\n        health = rpc(\"getHealth\")\n        online = (health == \"ok\")\n    except Exception as e:\n        return {\n            \"status\": \"offline\",\n            \"network\": NETWORK_NAME,\n            \"current_slot\": 0,\n            \"node_count\": 0,\n            \"version\": \"unknown\",\n            \"error\": s"]
[556.016947, "i", "tr(e),\n        }\n    try:\n        slot = rpc(\"getSlot\")\n    except Exception:\n        slot = 0\n    try:\n        nodes = rpc(\"getClusterNodes\")\n        node_count = len(nodes) if isinstance(nodes, list) else 0\n    except Exception:\n        node_count = 0\n    try:\n        ver = rpc(\"getVersion\")\n        version = ver.get(\"solana-core\", \"unknown\") if isinstance(ver, dict) else \"unknown\"\n    except Exception:\n        version = \"unknown\"\n    return {\n        \"status\": \"online\" if online else \"offline\",\n        \"network\": NETWORK_NAME,\n        \"current_slot\": slot,\n        \"node_count\": node_count,\n        \"version\": version,\n    }\n\n\ndef get_block(slot):\n    try:\n        slot_i = int(slot)\n    except Exception:\n        raise RpcError(\"Invalid slot number: %s\" % slot)\n    params = [slot_i, {\"encoding\": \"json\", \"transactionDetails\": \"none\", \"rewards\": False}]\n    try:\n        result = rpc(\"getBlock\", params)\n    except Exception as e:\n        raise NotFound(\"Block at slot %s not found: %s\" % (slot_i, e))\n    if resul"]
[556.017051, "i", "t is None:\n        raise NotFound(\"Block at slot %s not found\" % slot_i)\n    return {\n        \"blockhash\": result.get(\"blockhash\"),\n        \"parent_slot\": result.get(\"parentSlot\"),\n        \"previous_blockhash\": result.get(\"previousBlockhash\"),\n        \"block_height\": result.get(\"blockHeight\"),\n        \"block_time\": result.get(\"blockTime\"),\n    }\n\n\ndef get_transaction(signature):\n    params = [signature, {\"encoding\": \"jsonParsed\", \"maxSupportedTransactionVersion\": 0}]\n    try:\n        result = rpc(\"getTransaction\", params)\n    except Exception as e:\n        raise NotFound(\"Transaction %s not found: %s\" % (signature, e))\n    if result is None:\n        raise NotFound(\"Transaction %s not found\" % signature)\n    meta = result.get(\"meta\") or {}\n    err = meta.get(\"err\")\n    success = err is None\n    fee = meta.get(\"fee\")\n    transfers = []\n    pre = {b.get(\"accountIndex\"): b for b in (meta.get(\"preTokenBalances\") or [])}\n    post = {b.get(\"accountIndex\"): b for b in (meta.get(\"postTokenBalances\") or [])}\n    acc_ke"]
[556.017528, "i", "ys = []\n    msg = result.get(\"transaction\", {}).get(\"message\", {})\n    for a in msg.get(\"accountKeys\", []):\n        acc_keys.append(a.get(\"pubkey\") if isinstance(a, dict) else a)\n    for idx, pb in pre.items():\n        ob = post.get(idx)\n        if not ob:\n            continue\n        try:\n            pre_amt = int(pb.get(\"uiTokenAmount\", {}).get(\"amount\", \"0\") or \"0\")\n            post_amt = int(ob.get(\"uiTokenAmount\", {}).get(\"amount\", \"0\") or \"0\")\n        except Exception:\n            continue\n        delta = post_amt - pre_amt\n        if delta < 0:\n            owner = pb.get(\"owner\") or (acc_keys[idx] if idx < len(acc_keys) else None)\n            transfers.append({\n                \"account\": owner,\n                \"mint\": pb.get(\"mint\"),\n                \"amount\": abs(delta),\n            })\n    txn = result.get(\"transaction\", {})\n    sig = signature\n    if isinstance(txn, dict):\n        sigs = txn.get(\"signatures\") or [signature]\n        sig = sigs[0]\n    return {\n        \"signature\": sig,\n        \"slot\": r"]
[556.017595, "i", "esult.get(\"slot\"),\n        \"block_time\": result.get(\"blockTime\"),\n        \"success\": success,\n        \"fee\": fee,\n        \"token_transfers\": transfers,\n    }\n\n\ndef get_account(address):\n    params = [address, {\"encoding\": \"jsonParsed\"}]\n    try:\n        result = rpc(\"getAccountInfo\", params)\n    except Exception as e:\n        raise NotFound(\"Account %s not found: %s\" % (address, e))\n    if result is None or result.get(\"value\") is None:\n        raise NotFound(\"Account %s not found\" % address)\n    val = result[\"value\"]\n    return {\n        \"address\": address,\n        \"executable\": val.get(\"executable\"),\n        \"lamports\": val.get(\"lamports\"),\n        \"owner\": val.get(\"owner\"),\n        \"rent_epoch\": val.get(\"rentEpoch\"),\n    }\n\n\ndef get_program_accounts(pid, offset, limit):\n    params = [pid, {\"encoding\": \"jsonParsed\",\n                   \"dataSlice\": {\"offset\": 0, \"length\": 0},\n                   \"limit\": offset + limit}]\n    result = rpc(\"getProgramAccounts\", params)\n    if result is None:\n        result = []\n"]
[556.017717, "i", "    total = len(result)\n    window = result[offset:offset + limit]\n    accounts = []\n    for item in window:\n        a = item.get(\"account\") or {}\n        accounts.append({\n            \"pubkey\": item.get(\"pubkey\"),\n            \"account\": {\n                \"executable\": a.get(\"executable\"),\n                \"lamports\": a.get(\"lamports\"),\n                \"owner\": a.get(\"owner\"),\n                \"rent_epoch\": a.get(\"rentEpoch\"),\n            },\n        })\n    return {\n        \"program_id\": pid,\n        \"total_accounts\": total,\n        \"limit\": limit,\n        \"offset\": offset,\n        \"accounts\": accounts,\n    }\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def _send(self, obj, status=200):\n        body = json.dumps(obj).encode()\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def log_message(self, *args):\n        pass\n\n    def do_GET(self):\n       "]
[556.017739, "i", " parsed = urllib.parse.urlparse(self.path)\n        parts = [p for p in parsed.path.split(\"/\") if p != \"\"]\n        try:\n            if parsed.path.rstrip(\"/\") == \"/status\":\n                self._send(get_status())\n            elif len(parts) == 2 and parts[0] == \"block\":\n                self._send(get_block(parts[1]))\n            elif len(parts) == 2 and parts[0] == \"transaction\":\n                self._send(get_transaction(parts[1]))\n            elif len(parts) == 2 and parts[0] == \"account\":\n                self._send(get_account(parts[1]))\n            elif len(parts) == 3 and parts[0] == \"program\" and parts[2] == \"accounts\":\n                q = urllib.parse.parse_qs(parsed.query)\n\n                def getint(name, default):\n                    v = q.get(name, [None])[0]\n                    if v is None:\n                        return default\n                    try:\n                        return int(v)\n                    except Exception:\n                        return default\n                offset = getin"]
[556.018189, "i", "t(\"offset\", 0)\n                limit = getint(\"limit\", 10)\n                if limit < 0:\n                    limit = 10\n                if offset < 0:\n                    offset = 0\n                self._send(get_program_accounts(parts[1], offset, limit))\n            else:\n                self._send({\"error\": \"Unknown endpoint: %s\" % parsed.path}, status=404)\n        except NotFound as e:\n            self._send({\"error\": str(e)}, status=404)\n        except RpcError as e:\n            self._send({\"error\": str(e)}, status=500)\n        except Exception as e:\n            self._send({\"error\": str(e)}, status=500)\n\n\ndef main():\n    port = int(os.environ.get(\"PORT\", \"5000\"))\n    server = ThreadingHTTPServer((\"0.0.0.0\", port), Handler)\n    print(\"Serving on port %d, network=%s\" % (port, NETWORK_NAME), file=sys.stderr)\n    server.serve_forever()\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
