[359.224381, "i", "cat > /app/convert.py << 'PYEOF'\nimport io, json, zipfile, pickle, struct, sys\n\nMODEL='/app/model.pth'\nOUT='/app/weights.json'\n\nDTYPES={\n 'float32':('f',4),'float':('f',4),'FloatStorage':('f',4),\n 'float64':('d',8),'double':('d',8),'DoubleStorage':('d',8),\n 'float16':('e',2),'half':('e',2),'HalfStorage':('e',2),\n 'int64':('q',8),'long':('q',8),'LongStorage':('q',8),\n 'int32':('i',4),'int':('i',4),'IntStorage':('i',4),\n 'int16':('h',2),'short':('h',2),'ShortStorage':('h',2),\n 'int8':('b',1),'char':('b',1),'CharStorage':('b',1),\n 'uint8':('B',1),'byte':('B',1),'ByteStorage':('B',1),\n 'bool':('?',1),'BoolStorage':('?',1),\n}\n\nclass DType:\n    def __init__(self,code,size):\n        self.code=code; self.size=size\nclass Storage:\n    def __init__(self,dtype,data):\n        self.dtype=dtype; self.data=data\n\ndef rebuild(*args):\n    storage=args[0]; offset=args[1]; size=args[2]; stride=args[3]\n    dt=storage.dtype; itemsize=dt.size\n    total=1\n    for s in size: total*=s\n    start=offset*itemsize\n    raw=storage.data[star"]
[359.224806, "i", "t:start+total*itemsize]\n    vals=list(struct.unpack('<%d%s'%(total,dt.code),raw))\n    def rsf(a,d):\n        if len(d)==1: return a\n        n=d[0]; sub=len(a)//n\n        return [rsf(a[i*sub:(i+1)*sub],d[1:]) for i in range(n)]\n    return rsf(vals,list(size))\n\nclass UP(pickle.Unpickler):\n    def __init__(self,file,zf,dprefix):\n        super().__init__(file); self.zf=zf; self.dprefix=dprefix\n    def find_class(self,module,name):\n        if name in DTYPES:\n            c,s=DTYPES[name]; return DType(c,s)\n        if module=='torch._utils' and name in ('_rebuild_tensor_v2','_rebuild_tensor'):\n            return rebuild\n        if module=='torch.storage' and name=='_load_from_bytes':\n            return lambda b: b\n        return super().find_class(module,name)\n    def persistent_load(self,pid):\n        if isinstance(pid,tuple) and pid[0]=='storage':\n            dt=pid[1]\n            if not isinstance(dt,DType):\n                key=str(dt)\n                if key.startswith('<class'):\n                    key=key.split("]
[359.22487, "i", "'.')[-1].split(\"'\")[0]\n                c,s=DTYPES.get(key,(None,None))\n                if c is None:\n                    raise pickle.UnpicklingError('unknown dtype %r'%dt)\n                dt=DType(c,s)\n            key=str(pid[2])\n            data=self.zf.read(self.dprefix+key)\n            return Storage(dt,data)\n        raise pickle.UnpicklingError('bad pid %r'%pid)\n\ndef main():\n    zf=zipfile.ZipFile(MODEL)\n    names=zf.namelist()\n    pk=[n for n in names if n.endswith('data.pkl')]\n    if not pk:\n        print('NOT A ZIP STATE_DICT',file=sys.stderr); sys.exit(1)\n    dprefix=pk[0][:pk[0].rfind('/')+1]+'data/'\n    pkl=zf.read(pk[0])\n    obj=UP(io.BytesIO(pkl),zf,dprefix).load()\n    if isinstance(obj,dict) and 'state_dict' in obj:\n        obj=obj['state_dict']\n    print('keys:',list(obj.keys()),file=sys.stderr)\n    groups={}\n    for k,v in obj.items():\n        if k.endswith('.weight'):\n            pre=k[:-len('.weight')]; groups.setdefault(pre,{})['weight']=v\n        elif k.endswith('.bias'):\n            pre=k"]
[359.224905, "i", "[:-len('.bias')]; groups.setdefault(pre,{})['bias']=v\n        else:\n            print('UNKNOWN KEY',k,file=sys.stderr)\n    layers=[]\n    for pre,g in groups.items():\n        w=g['weight']; b=g['bias']\n        rows=len(w); cols=len(w[0])\n        flat=[]\n        for r in w: flat.extend(r)\n        layers.append({'pre':pre,'rows':rows,'cols':cols,'weight':flat,'bias':list(b)})\n    ordered=[]; rem=layers[:]\n    first=[l for l in rem if l['cols']==784]\n    if first:\n        cur=first[0]; ordered.append(cur); rem.remove(cur)\n        while rem:\n            nxt=[l for l in rem if l['cols']==cur['rows']]\n            if not nxt:\n                ordered.extend(rem); break\n            cur=nxt[0]; ordered.append(cur); rem.remove(cur)\n    else:\n        ordered=layers\n    print('order:',[l['pre'] for l in ordered],file=sys.stderr)\n    out={'layers':[{'rows':l['rows'],'cols':l['cols'],'weight':l['weight'],'bias':l['bias']} for l in ordered]}\n    with open(OUT,'w') as f:\n        json.dump(out,f)\n    print('wrote',OUT,file=sys."]
[359.224931, "i", "stderr)\n\nmain()\nPYEOF\n"]
