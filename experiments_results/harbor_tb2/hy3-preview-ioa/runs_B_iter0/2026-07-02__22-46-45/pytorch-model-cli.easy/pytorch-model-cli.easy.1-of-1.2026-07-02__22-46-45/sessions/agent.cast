[260.043344, "o", ")*rows);\r\n        for(int j=0;j<rows;j++){\r\n            double s=L[li].b[j];\r\n            for(int k=0;k<cols;k++) s+=L[li].W[j*cols+k]*z[k];\r\n            if(li!=nl-1 && s<0) s=0;\r\n            nz[j]=s;\r\n        }\r\n        if(z!=x) free(z);\r\n        z=nz; zs=rows;\r\n    }\r\n    int best=0; double bv=z[0];\r\n    for(int i=1;i<zs;i++){ if(z[i]>bv){ bv=z[i]; best=i; } }\r\n    printf(\"%d\\n\",best);\r\n    return 0;\r\n}\r\nCEOF\r\n"]
