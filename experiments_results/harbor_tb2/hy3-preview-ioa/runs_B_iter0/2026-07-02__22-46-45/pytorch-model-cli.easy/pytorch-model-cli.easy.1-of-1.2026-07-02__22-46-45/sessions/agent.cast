[260.042842, "i", "cat > /app/main.c << 'CEOF'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include \"cJSON.h\"\n#include \"lodepng.h\"\n\ntypedef struct {\n    int rows, cols;\n    double* W;\n    double* b;\n} Layer;\n\nstatic char* read_file(const char* path){\n    FILE* f=fopen(path,\"rb\");\n    if(!f){ fprintf(stderr,\"cannot open %s\\n\",path); exit(1);}\n    fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET);\n    char* buf=malloc(sz+1); fread(buf,1,sz,f); buf[sz]=0; fclose(f);\n    return buf;\n}\n\nint main(int argc,char** argv){\n    if(argc<3){ fprintf(stderr,\"usage: %s weights.json image.png\\n\",argv[0]); return 1; }\n    char* json=read_file(argv[1]);\n    cJSON* root=cJSON_Parse(json);\n    if(!root){ fprintf(stderr,\"json parse error\\n\"); return 1; }\n    cJSON* larr=cJSON_GetObjectItem(root,\"layers\");\n    int nl=cJSON_GetArraySize(larr);\n    Layer* L=malloc(sizeof(Layer)*nl);\n    for(int li=0; li<nl; li++){\n        cJSON* lj=cJSON_GetArrayItem(larr,li);\n        cJSON* r=cJSON_GetObjectItem(lj,\"rows\");\n "]
[260.04306, "i", "       cJSON* c=cJSON_GetObjectItem(lj,\"cols\");\n        cJSON* w=cJSON_GetObjectItem(lj,\"weight\");\n        cJSON* b=cJSON_GetObjectItem(lj,\"bias\");\n        L[li].rows=(int)r->valuedouble;\n        L[li].cols=(int)c->valuedouble;\n        int rows=L[li].rows, cols=L[li].cols;\n        L[li].W=malloc(sizeof(double)*rows*cols);\n        L[li].b=malloc(sizeof(double)*rows);\n        int n=cJSON_GetArraySize(w);\n        for(int i=0;i<n;i++) L[li].W[i]=cJSON_GetArrayItem(w,i)->valuedouble;\n        n=cJSON_GetArraySize(b);\n        for(int i=0;i<n;i++) L[li].b[i]=cJSON_GetArrayItem(b,i)->valuedouble;\n    }\n    free(json);\n    unsigned char* img=NULL; unsigned w=0,h=0;\n    unsigned err=lodepng_decode32_file(&img,&w,&h,argv[2]);\n    if(err){ fprintf(stderr,\"png error %s\\n\",lodepng_error_text(err)); return 1; }\n    int N=(int)(w*h);\n    double* x=malloc(sizeof(double)*N);\n    double mean=0;\n    for(int i=0;i<N;i++){ double v=img[i*4]/255.0; x[i]=v; mean+=v; }\n    mean/=N;\n    if(mean>0.5){ for(int i=0;i<N;i++) x[i]=1.0-x[i];"]
[260.043088, "o", "cat > /app/main.c << 'CEOF'"]
[260.043109, "i", " }\n#ifdef NORMALIZE\n    for(int i=0;i<N;i++) x[i]=(x[i]-0.1307)/0.3081;\n#endif\n    free(img);\n    double* z=x; int zs=N;\n    for(int li=0; li<nl; li++){\n        int rows=L[li].rows, cols=L[li].cols;\n        double* nz=malloc(sizeof(double)*rows);\n        for(int j=0;j<rows;j++){\n            double s=L[li].b[j];\n            for(int k=0;k<cols;k++) s+=L[li].W[j*cols+k]*z[k];\n            if(li!=nl-1 && s<0) s=0;\n            nz[j]=s;\n        }\n        if(z!=x) free(z);\n        z=nz; zs=rows;\n    }\n    int best=0; double bv=z[0];\n    for(int i=1;i<zs;i++){ if(z[i]>bv){ bv=z[i]; best=i; } }\n    printf(\"%d\\n\",best);\n    return 0;\n}\nCEOF\n"]
