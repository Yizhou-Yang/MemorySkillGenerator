[58.787993, "o", "\u001b[?2004h"]
[58.78815, "o", "> "]
[58.788441, "o", "import csv, json, datetime"]
[58.788641, "o", "\r\n"]
[58.788903, "o", "\u001b[?2004l\r"]
[58.789134, "o", "\u001b[?2004h"]
[58.789328, "o", "> "]
[58.789626, "o", "from collections import defaultdict"]
[58.789814, "i", "nd({\n            'name': p['name'],\n            'status': p['status'],\n            'members': [m.strip() for m in p['member_ids'].split(';') if m.strip()],\n            'deadline': p['deadline']\n        })\n    dept_list.append({\n        'id': did,\n        'name': d['name'],\n        'budget': float(d['budget']),\n        'employees': emps,\n        'projects': projs\n    })\n\nbudgets = [d['budget'] for d in dept_list]\navg_budget = sum(budgets) / len(budgets) if budgets else 0\ntotal_emps = len(employees)\n\nskill_dist = defaultdict(int)\nyears = []\nfor e in employees:\n    years.append(int(e['years_of_service']))\n    for s in e['skills'].split(';'):\n        s = s.strip()\n        if s:\n            skill_dist[s] += 1\navg_years = sum(years) / len(years) if years else 0\n\ndept_sizes = {d['name']: len(d['employees']) for d in dept_list}\n\nstatus_dist = defaultdict(int)\nfor p in projects:\n    status_dist[p['status']] += 1\n\nout = {\n    'metadata': {\n        'version': '1.0',\n        'timestamp': datetime.datetime.now().isoformat"]
[58.789849, "i", "(),\n        'generator': 'CSV-to-JSON Processor'\n    },\n    'organization': {\n        'name': 'Global Tech Organization',\n        'founded': '2020-01-01',\n        'departments': dept_list\n    },\n    'statistics': {\n        'averageDepartmentBudget': round(avg_budget, 2),\n        'totalEmployees': total_emps,\n        'skillDistribution': dict(skill_dist),\n        'departmentSizes': dept_sizes,\n        'projectStatusDistribution': dict(status_dist),\n        'averageYearsOfService': round(avg_years, 2)\n    }\n}\n\nwith open('organization.json', 'w') as f:\n    json.dump(out, f, indent=2)\nprint('Wrote organization.json')\nEOF\n"]
