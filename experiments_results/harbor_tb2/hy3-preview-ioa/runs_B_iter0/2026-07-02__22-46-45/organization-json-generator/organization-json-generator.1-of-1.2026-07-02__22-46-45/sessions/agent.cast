[58.785922, "i", "cat > process.py << 'EOF'\nimport csv, json, datetime\nfrom collections import defaultdict\n\nwith open('data/departments.csv') as f:\n    departments = list(csv.DictReader(f))\nwith open('data/employees.csv') as f:\n    employees = list(csv.DictReader(f))\nwith open('data/projects.csv') as f:\n    projects = list(csv.DictReader(f))\n\nemp_by_dept = defaultdict(list)\nfor e in employees:\n    emp_by_dept[e['department_id']].append(e)\n\nproj_by_dept = defaultdict(list)\nfor p in projects:\n    proj_by_dept[p['department_id']].append(p)\n\ndept_list = []\nfor d in departments:\n    did = d['id']\n    emps = []\n    for e in emp_by_dept.get(did, []):\n        emps.append({\n            'id': e['id'],\n            'name': e['name'],\n            'position': e['position'],\n            'skills': [s.strip() for s in e['skills'].split(';') if s.strip()],\n            'years_of_service': int(e['years_of_service'])\n        })\n    projs = []\n    for p in proj_by_dept.get(did, []):\n        projs.appe"]
[58.787578, "o", "cat > process.py << 'EOF'"]
