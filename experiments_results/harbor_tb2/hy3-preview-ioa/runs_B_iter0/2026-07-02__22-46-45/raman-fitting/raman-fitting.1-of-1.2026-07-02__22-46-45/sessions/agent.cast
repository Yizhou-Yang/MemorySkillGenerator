[215.069646, "i", "cat > explore2.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\ndata = []\nwith open('graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        p = line.replace(',', '.').split()\n        if len(p) < 2: continue\n        data.append((float(p[0]), float(p[1])))\nd = np.array(data)\nx = d[:,0]; y = d[:,1]\norder = np.argsort(x)\nx = x[order]; y = y[order]\n\n# smooth\nfrom scipy.ndimage import uniform_filter1d\nys = uniform_filter1d(y, size=25)\npk, props = find_peaks(ys, prominence=2000)\nprint('Smoothed peaks (prominence>2000):')\nfor i in pk:\n    print('  x=%.2f y=%.1f prom=%.1f' % (x[i], y[i], props['prominences'][list(pk).index(i)]))\n\n# examine the giant spike neighborhood\nprint('\\nNeighborhood of x=19139 spike (raw):')\nji = np.argmin(np.abs(x-19139))\nfor k in range(ji-3, ji+4):\n    print('  x=%.2f y=%.1f' % (x[k], y[k]))\nEOF\npython3 explore2.py\n"]
[215.069844, "o", "cat > explore2.py << 'EOF'"]
