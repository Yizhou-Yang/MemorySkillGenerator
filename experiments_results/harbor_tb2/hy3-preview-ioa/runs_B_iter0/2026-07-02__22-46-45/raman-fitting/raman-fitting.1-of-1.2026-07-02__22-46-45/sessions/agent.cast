[136.339003, "i", "cat > explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import argrelextrema\n\ndata = []\nwith open('graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.replace(',', '.').split()\n        if len(parts) < 2:\n            continue\n        data.append((float(parts[0]), float(parts[1])))\nd = np.array(data)\nx = d[:,0]; y = d[:,1]\nprint('n', len(x))\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\nidx = argrelextrema(y, np.greater, order=15)[0]\nfor i in idx:\n    print(round(x[i],2), round(y[i],1))\nEOF\npython3 explore.py\n"]
