[399.660482, "i", "cat > diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = []\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        data.append((float(p[0]),float(p[1])))\nd=np.array(data); x=d[:,0]; y=d[:,1]\norder=np.argsort(x); x=x[order]; y=y[order]\n\ndef lor(x,x0,g,a,o): return o + a/(1.0+((x-x0)/g)**2)\n\ndef fit(guess,win):\n    m=(x>guess-win)&(x<guess+win)\n    xx=x[m]; yy=y[m]\n    popt,_=curve_fit(lor,xx,yy,p0=[guess,40,10000,2000],\n        bounds=([guess-150,1,0,-1e4],[guess+150,800,1e6,1e6]),maxfev=20000)\n    rms=np.sqrt(np.mean((yy-lor(xx,*popt))**2))\n    return popt,rms,len(xx)\n\nprint('G peak, guess 3745:')\nfor w in (150,250,350,500):\n    p,r,n=fit(3745,w); print('  win=%d n=%d x0=%.2f g=%.2f a=%.1f o=%.1f rms=%.1f'%(w,n,p[0],p[1],p[2],p[3],r))\nprint('2D peak, guess 6329:')\nfor w in (150,250,350,500):\n    p,r,n=fit(6329,w); print('  win=%d n=%d x0=%.2f g=%.2f a="]
[399.704697, "o", "cat > diag.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = []\r\n\u001b[?2004l\r\u001b[?2004h> with open('graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if not line: continue\r\n\u001b[?2004l\r\u001b[?2004h>         p=line.replace(',','.').split()\r\n\u001b[?2004l\r\u001b[?2004h>         if len(p)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>         data.append((float(p[0]),float(p[1])))\r\n\u001b[?2004l\r\u001b[?2004h> d=np.array(data); x=d[:,0]; y=d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> order=np.argsort(x); x=x[order]; y=y[order]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lor(x,x0,g,a,o): return o + a/(1.0+((x-x0)/g)**2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fit(guess,win):\r\n\u001b[?2004l\r\u001b[?2004h>     m=(x>guess-win)&(x<guess+win)\r\n\u001b[?2004l\r\u001b[?2004h>     xx=x[m]; yy=y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     popt,_=curve_fit(lor,xx,yy,p0=[guess,40,10000,2000],\r\n\u001b[?2004l\r\u001b[?2004h>         bounds=([gues"]
[399.704732, "i", "%.1f o=%.1f rms=%.1f'%(w,n,p[0],p[1],p[2],p[3],r))\nEOF\npython3 diag.py\n"]
[399.704745, "o", "s-150,1,0,-1e4],[guess+150,800,1e6,1e6]),maxfev=20000)\r\n\u001b[?2004l\r\u001b[?2004h>     rms=np.sqrt(np.mean((yy-lor(xx,*popt))**2))\r\n\u001b[?2004l\r\u001b[?2004h>     return popt,rms,len(xx)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('G peak, guess 3745:')\r\n\u001b[?2004l\r\u001b[?2004h> for w in (150,250,350,500):\r\n\u001b[?2004l\r\u001b[?2004h>     p,r,n=fit(3745,w); print('  win=%d n=%d x0=%.2f g=%.2f a=%.1f o=%.1f rms=%.1f'%(w,n,p[0],p[1],p[2],p[3],r))\r\n\u001b[?2004l\r\u001b[?2004h> print('2D peak, guess 6329:')\r\n\u001b[?2004l\r\u001b[?2004h> for w in (150,250,350,500):\r\n\u001b[?2004l\r\u001b[?2004h>     p,r,n=fit(6329,w); print('  win=%d n=%d x0=%.2f g=%.2f a="]
