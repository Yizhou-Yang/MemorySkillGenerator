[454.587633, "i", "cat > final_fit.py << 'EOF'\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = []\nwith open('graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        p = line.replace(',', '.').split()\n        if len(p) < 2: continue\n        data.append((float(p[0]), float(p[1])))\nd = np.array(data)\nx = d[:,0]; y = d[:,1]\norder = np.argsort(x); x = x[order]; y = y[order]\n\ndef lor(x, x0, gamma, amp, offset):\n    return offset + amp / (1.0 + ((x - x0) / gamma)**2)\n\ndef fit_peak(guess, win):\n    m = (x > guess - win) & (x < guess + win)\n    xx = x[m]; yy = y[m]\n    popt, _ = curve_fit(lor, xx, yy, p0=[guess, 40, 10000, 2000],\n                        bounds=([guess-150, 1, 0, -1e4],\n                                [guess+150, 800, 1e6, 1e6]),\n                        maxfev=20000)\n    return popt\n\npG = fit_peak(3745.38, 250)\np2D = fit_peak(6328.00, 250)\n\nresult = {\n    \"G\": {\n        \"x0\": round(float(pG[0]), 3"]
[454.591769, "o", "cat > final_fit.py << 'EOF'"]
[454.592123, "o", "\r\n"]
