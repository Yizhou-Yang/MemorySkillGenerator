[295.787158, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndata = []\nwith open('graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        p = line.replace(',', '.').split()\n        if len(p) < 2: continue\n        data.append((float(p[0]), float(p[1])))\nd = np.array(data)\nx = d[:,0]; y = d[:,1]\norder = np.argsort(x); x = x[order]; y = y[order]\n\ndef lor(x, x0, gamma, amp, offset):\n    return offset + amp / (1.0 + ((x - x0)/gamma)**2)\n\ndef fit_peak(x0_guess, xwin, gam0, amp0, off0):\n    m = (x > x0_guess - xwin) & (x < x0_guess + xwin)\n    xx = x[m]; yy = y[m]\n    p0 = [x0_guess, gam0, amp0, off0]\n    popt, pcov = curve_fit(lor, xx, yy, p0=p0,\n                           bounds=([x0_guess-200, 1, 0, -1e4],\n                                   [x0_guess+200, 500, 1e6, 1e6]))\n    resid = yy - lor(xx, *popt)\n    rms = np.sqrt(np.mean(resid**2))\n    return popt, rms, len(xx)\n\nprint('=== G peak ===')\npG, r"]
[295.787784, "o", "cat > fit.py << 'EOF'"]
