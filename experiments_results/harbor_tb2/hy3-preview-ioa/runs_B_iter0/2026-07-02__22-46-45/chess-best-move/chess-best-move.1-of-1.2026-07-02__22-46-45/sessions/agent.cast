[171.977337, "i", "cat > /tmp/art.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nfiles='abcdefgh'\ndef render(r,c):\n    sq = a[r*80:(r+1)*80, c*80:(c+1)*80]\n    H,W=sq.shape[:2]\n    oh,ow=24,40\n    out=[]\n    for i in range(oh):\n        line=''\n        for j in range(ow):\n            y0=i*H//oh; y1=(i+1)*H//oh\n            x0=j*W//ow; x1=(j+1)*W//ow\n            patch=sq[y0:y1,x0:x1]\n            dd=np.sqrt(((patch-np.array([0,0,0]))**2).sum(2))<60\n            ww=np.sqrt(((patch-np.array([255,255,255]))**2).sum(2))<60\n            if dd.sum()>0:\n                line+='#'\n            elif ww.sum()>0:\n                line+='+'\n            else:\n                line+=' '\n        out.append(line.rstrip())\n    return out\nocc=[]\nfor r in range(8):\n    for c in range(8):\n        sq=a[r*80:(r+1)*80,c*80:(c+1)*80]\n        d=np.sqrt(((sq-np.array([0,0,0]))**2).sum(2))<60\n        w=np.sqrt(((sq-np.array([255,255,255]))**2).sum(2))<60\n        if d.sum()>40 or w.sum()>40:\n            occ.append((r,c,d.sum(),w.sum()))\nfor (r,c,dd,ww) in sorted(occ):\n    color='black' if dd>ww else 'white'\n    print('=== %s%d (%s) ==='%(files[c],8-r,color))\n    for line in render(r,c):\n        print('|'+line+'|')\nEOF\npython3 /tmp/art.py > /tmp/art_all.txt 2>&1; wc -l /tmp/art_all.txt\n"]
