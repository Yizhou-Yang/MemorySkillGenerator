[673.851701, "i", "cat > /tmp/match.py << 'EOF'\nfrom PIL import Image, ImageFont, ImageDraw\nimport numpy as np\n\nFONT='/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf'\nfont=ImageFont.truetype(FONT, 60)\n\n# glyph code points: white pieces U+2654..2659, black U+265A..265F\nwhite_sym={0x2654:'K',0x2655:'Q',0x2656:'R',0x2657:'B',0x2658:'N',0x2659:'P'}\nblack_sym={0x265A:'k',0x265B:'q',0x265C:'r',0x265D:'b',0x265E:'n',0x265F:'p'}\n\ndef glyph_mask(cp):\n    img=Image.new('L',(100,100),255)\n    d=ImageDraw.Draw(img)\n    d.text((50,50),chr(cp),font=font,fill=0,anchor='mm')\n    a=np.array(img)\n    mask=a<128\n    return mask\n\ndef norm(mask, S=64):\n    ys,xs=np.where(mask)\n    if len(xs)==0: return None\n    crop=mask[ys.min():ys.max()+1, xs.min():xs.max()+1]\n    im=Image.fromarray((crop*255).astype('uint8')).resize((S,S))\n    return (np.array(im)>128)\n\nrefs={}\nfor cp,name in {**white_sym,**black_sym}.items():\n    refs[name]=norm(glyph_mask(cp))\n\ndef best(mask, candidates):\n    n=norm(mask)\n    if "]
[673.852547, "o", "cat > /tmp/match.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[673.852634, "o", "> from PIL import Image, ImageFont, ImageDraw"]
[673.852714, "o", "\r\n"]
[673.852842, "o", "\u001b[?2004l\r"]
[673.853089, "o", "\u001b[?2004h"]
[673.853423, "o", "> import numpy as np"]
[673.853621, "o", "\r\n"]
[673.854154, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[673.854254, "o", "FONT='/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf'"]
[673.854344, "o", "\r\n"]
[673.854963, "o", "\u001b[?2004l\r"]
[673.85526, "o", "\u001b[?2004h> font=ImageFont.truetype(FONT, 60)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # glyph code points: white pieces U+2654..2659, black U+265A..265F\r\n\u001b[?2004l\r\u001b[?2004h> "]
[673.85529, "i", "n is None: return None,1.0\n    best=None;bs=1.0\n    for name in candidates:\n        r=refs[name]\n        diff=np.logical_xor(n,r).mean()\n        if diff<bs: bs=diff;best=name\n    return best,bs\n\nim=Image.open('/app/chess_puzzle.png').convert('RGB')\na=np.array(im).astype(int)\nfiles='abcdefgh'\nocc=[]\nfor r in range(8):\n    for c in range(8):\n        sq=a[r*80:(r+1)*80,c*80:(c+1)*80]\n        d=np.sqrt(((sq-np.array([0,0,0]))**2).sum(2))<60\n        w=np.sqrt(((sq-np.array([255,255,255]))**2).sum(2))<60\n        dd=d.sum();ww=w.sum()\n        if dd>40 or ww>40:\n            occ.append((r,c,dd,ww))\n\nresults={}\nfor (r,c,dd,ww) in sorted(occ):\n    if dd>=ww:\n        name,sc=best(d, list(black_sym.values()))\n    else:\n        # invert: mask of white ink\n        name,sc=best(w, list(white_sym.values()))\n    sqname=files[c]+str(8-r)\n    results[sqname]=name\n    print(f'{sqname}: {name}  score={sc:.3f} ({\"black\" if dd>=ww else \"white\"})')\n\n# build FEN ranks 8..1\nrows=[]\nfor r in range(8):\n    row=''\n    empty=0\n    for c in range(8):\n        s=files[c]+str(8-r)\n        if s in results:\n            if empty: row+=str(empty);empty=0\n            row+=results[s]\n        else:\n            empty+=1\n    if empty: row+=str(empty)\n    rows.append(row)\nfen='/'.join(rows)+' w - - 0 1'\nprint('FEN:', fen)\nEOF\npython3 /tmp/match.py\n"]
[673.856465, "o", "white_sym={0x2654:'K',0x2655:'Q',0x2656:'R',0x2657:'B',0x2658:'N',0x2659:'P'}\r\n\u001b[?2004l\r\u001b[?2004h> black_sym={0x265A:'k',0x265B:'q',0x265C:'r',0x265D:'b',0x265E:'n',0x265F:'p'}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
