[113.538991, "i", "cat > /tmp/explore.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im)\nprint('shape', a.shape)\n# Sample center of each square\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        sq = a[r*80:(r+1)*80, c*80:(c+1)*80]\n        # count non-background pixels\n        # background likely light/dark square colors\n        row.append(sq.shape)\n    pass\n# Print unique-ish colors via histogram of rounded\nflat = a.reshape(-1,3)\n# count most common colors\nfrom collections import Counter\ncols = [tuple(x) for x in flat[::37]]\ncnt = Counter(cols)\nfor col,n in cnt.most_common(20):\n    print(col,n)\nEOF\npython3 /tmp/explore.py\n"]
