[139.34537, "i", "cat > /tmp/ascii.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nfiles='abcdefgh'\n# define background detection\ndef ink_counts(sq):\n    # sq shape (80,80,3)\n    d = np.sqrt(((sq-np.array([0,0,0]))**2).sum(2))\n    w = np.sqrt(((sq-np.array([255,255,255]))**2).sum(2))\n    dark = d < 60\n    white = w < 60\n    return dark.sum(), white.sum()\nocc={}\nfor r in range(8):\n    for c in range(8):\n        sq = a[r*80:(r+1)*80, c*80:(c+1)*80]\n        dd,ww = ink_counts(sq)\n        if dd>40 or ww>40:\n            occ[(r,c)]=(dd,ww)\nfor (r,c),(dd,ww) in sorted(occ.items()):\n    sqname=files[c]+str(8-r)\n    print(f'{sqname}: dark={dd} white={ww}')\nprint('total occupied', len(occ))\nEOF\npython3 /tmp/ascii.py\n"]
