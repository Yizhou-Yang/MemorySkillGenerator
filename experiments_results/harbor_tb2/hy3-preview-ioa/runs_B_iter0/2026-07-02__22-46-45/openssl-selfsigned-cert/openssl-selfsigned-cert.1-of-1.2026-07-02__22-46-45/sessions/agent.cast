[638.408716, "i", "cat > /app/check_cert.py << 'PYEOF'\nimport ssl\nimport subprocess\nimport os\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\ndef main():\n    if not os.path.exists(CERT_PATH):\n        print(\"Certificate not found at \" + CERT_PATH)\n        return\n    result = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\", \"-dates\"],\n        capture_output=True, text=True,\n    )\n    if result.returncode != 0:\n        print(\"Failed to load certificate\")\n        print(result.stderr)\n        return\n    output = result.stdout\n    subject_line = [l for l in output.splitlines() if l.startswith(\"subject=\")]\n    cn = None\n    if subject_line:\n        parts = subject_line[0].split(\"CN=\")\n        if len(parts) > 1:\n            cn = parts[1].split(\"/\")[0].strip()\n    dates = [l for l in output.splitlines() if l.startswith(\"notAfter=\")]\n    expiration = None\n    if dates:\n        date_str = dates[0].replace(\"notAfter=\", \"\").strip()\n        fields = date_str.split()\n        dt = datetime.s"]
[638.409078, "i", "trptime(\" \".join(fields[:4]), \"%b %d %H:%M:%S %Y\")\n        expiration = dt.strftime(\"%Y-%m-%d\")\n    print(\"Common Name: \" + str(cn))\n    print(\"Expiration Date: \" + str(expiration))\n    print(\"Certificate verification successful\")\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
