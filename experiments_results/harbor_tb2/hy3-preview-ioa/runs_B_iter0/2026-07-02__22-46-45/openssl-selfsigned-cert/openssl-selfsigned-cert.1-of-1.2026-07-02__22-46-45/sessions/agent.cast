[662.142388, "i", "cat > /app/check_cert.py << 'PYEOF'\nimport ssl\nimport subprocess\nimport os\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\ndef main():\n    if not os.path.exists(CERT_PATH):\n        print(\"Certificate not found at \" + CERT_PATH)\n        return\n    result = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\", \"-dates\"],\n        capture_output=True, text=True,\n    )\n    if result.returncode != 0:\n        print(\"Failed to load certificate\")\n        print(result.stderr)\n        return\n    output = result.stdout\n    subject_line = [l for l in output.splitlines() if l.startswith(\"subject=\")]\n    cn = None\n    if subject_line:\n        line = subject_line[0]\n        idx = line.find(\"CN =\")\n        if idx == -1:\n            idx = line.find(\"CN=\")\n        if idx != -1:\n            rest = line[idx + 3:].lstrip(\" =\")\n            cn = rest.split(\",\")[0].strip()\n    dates = [l for l in output.splitlines() if l.startswith(\"notAft"]
