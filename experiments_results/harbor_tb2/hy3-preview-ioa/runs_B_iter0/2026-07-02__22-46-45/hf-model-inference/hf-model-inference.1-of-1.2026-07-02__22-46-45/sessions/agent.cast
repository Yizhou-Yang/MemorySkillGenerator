[426.699079, "i", "cat > /app/download_model.py << 'EOF'\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\nimport os\n\nMODEL_NAME = \"distilbert-base-uncased-finetuned-sst-2-english\"\nSAVE_DIR = \"/app/model_cache/sentiment_model\"\n\ntok = AutoTokenizer.from_pretrained(MODEL_NAME)\nm = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME)\n\ntok.save_pretrained(SAVE_DIR)\nm.save_pretrained(SAVE_DIR)\nprint(\"Model saved to\", SAVE_DIR)\nprint(os.listdir(SAVE_DIR))\nEOF\n"]
[426.704486, "o", "cat > /app/download_model.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from transformers import AutoModelForSequenceClassification, AutoTokenizer\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> MODEL_NAME = \"distilbert-base-uncased-finetuned-sst-2-english\"\r\n\u001b[?2004l\r\u001b[?2004h> SAVE_DIR = \"/app/model_cache/sentiment_model\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> tok = AutoTokenizer.from_pretrained(MODEL_NAME)\r\n\u001b[?2004l\r\u001b[?2004h> m = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> tok.save_pretrained(SAVE_DIR)\r\n\u001b[?2004l\r\u001b[?2004h> m.save_pretrained(SAVE_DIR)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Model saved to\", SAVE_DIR)\r\n\u001b[?2004l\r\u001b[?2004h> print(os.listdir(SAVE_DIR))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
