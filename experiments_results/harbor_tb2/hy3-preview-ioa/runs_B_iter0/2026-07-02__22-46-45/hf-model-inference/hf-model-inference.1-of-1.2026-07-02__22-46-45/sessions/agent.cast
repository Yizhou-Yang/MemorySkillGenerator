[657.45027, "o", "cache/huggingface/hub/models--distilbert-base-uncased-finetuned-sst-2-english/blobs only has 0.00 MB free disk space.\r\n  warnings.warn(\r\n\rLoading weights:   0%|          | 0/104 [00:00<?, ?it/s]\rLoading weights: 100%|██████████| 104/104 [00:00<00:00, 16128.96it/s]\r\n\rWriting model shards:   0%|          | 0/1 [00:00<?, ?it/s]\rWriting model shards: 100%|██████████| 1/1 [00:01<00:00,  1.04s/it]\rWriting model shards: 100%|██████████| 1/1 [00:01<00:00,  1.04s/it]\r\nModel saved to /app/model_cache/sentiment_model\r\n['tokenizer_config.json', 'model.safetensors', 'config.json', 'tokenizer.json']\r\n"]
[657.451398, "o", "\u001b[?2004hroot@9807278e3ffa:/app# "]
[695.797418, "i", "cat > /app/app.py << 'EOF'\nimport os\nimport torch\nfrom flask import Flask, request, jsonify\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\n\nMODEL_DIR = \"/app/model_cache/sentiment_model\"\n\napp = Flask(__name__)\n\ndevice = torch.device(\"cpu\")\ntokenizer = AutoTokenizer.from_pretrained(MODEL_DIR)\nmodel = AutoModelForSequenceClassification.from_pretrained(MODEL_DIR)\nmodel.to(device)\nmodel.eval()\n\nid2label = model.config.id2label\n\n@app.route(\"/sentiment\", methods=[\"POST\"])\ndef sentiment():\n    try:\n        data = request.get_json(silent=True)\n        if not data or \"text\" not in data:\n            return jsonify({\"error\": \"Missing 'text' field in JSON body\"}), 400\n        text = data[\"text\"]\n        if not isinstance(text, str) or text.strip() == \"\":\n            return jsonify({\"error\": \"'text' must be a non-empty string\"}), 400\n\n        inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, padding=True, max_length=512)\n        inputs = {k: v.to(device) for k, v in inputs.items()}"]
[695.797868, "o", "cat > /app/app.py << 'EOF'\r\n\u001b[?2004l\r"]
[695.797928, "i", "\n        with torch.no_grad():\n            logits = model(**inputs).logits\n            probs = torch.softmax(logits, dim=-1).squeeze().tolist()\n\n        labels = [id2label[i] for i in range(len(probs))]\n        confidence = {label.lower(): float(prob) for label, prob in zip(labels, probs)}\n        positive = confidence.get(\"positive\", 0.0)\n        negative = confidence.get(\"negative\", 0.0)\n        pred = \"positive\" if positive >= negative else \"negative\"\n\n        return jsonify({\n            \"sentiment\": pred,\n            \"confidence\": {\n                \"positive\": positive,\n                \"negative\": negative,\n            },\n        })\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=5000)\nEOF\n"]
[695.797995, "o", "\u001b[?2004h"]
