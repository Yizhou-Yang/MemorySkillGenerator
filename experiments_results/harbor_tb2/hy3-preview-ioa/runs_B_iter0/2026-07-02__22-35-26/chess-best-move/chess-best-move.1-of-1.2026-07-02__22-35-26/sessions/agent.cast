[360.602768, "i", "cat > /tmp/black.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\nfiles='abcdefgh'\nsquares=[(0,0),(0,2),(0,3),(0,5),(1,1),(1,5),(1,6),(2,0),(2,2),(2,4),(3,3),(3,5),(3,6)]\nfor (r,c) in squares:\n    sq=a[r*S:(r+1)*S, c*S:(c+1)*S]\n    flat=sq.reshape(-1,3)\n    bg=np.median(flat,axis=0)\n    d=np.sqrt(((flat-bg)**2).sum(axis=1))\n    mask=d>40\n    m2=mask.reshape(S,S)\n    rank=8-r\n    print(f'=== {files[c]}{rank} ===')\n    step=2\n    for y in range(8,S-8,step):\n        line=''\n        for x in range(8,S-8,step):\n            block=m2[y:y+step, x:x+step]\n            line += '#' if block.mean()>0.3 else '.'\n        print(line)\nEOF\npython3 /tmp/black.py > /tmp/black.txt 2>&1\nsed -n '1,90p' /tmp/black.txt\n"]
