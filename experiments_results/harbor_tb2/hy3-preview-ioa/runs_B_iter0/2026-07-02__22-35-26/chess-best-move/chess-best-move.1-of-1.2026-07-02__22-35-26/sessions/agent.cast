[661.820267, "i", "cat > /tmp/solve.py << 'PYEOF'\nimport chess, sys, time\n\nFEN = \"r1bq1r2/1p3pp1/p1n1p3/3nPkbP/8/P7/1P2NPP1/R1B1K2R w KQ - 0 1\"\nroot = chess.Board(FEN)\n\ndef ordered_moves(board, attacker=True):\n    moves = list(board.legal_moves)\n    def key(m):\n        board.push(m)\n        chk = board.is_check()\n        board.pop()\n        cap = board.is_capture(m)\n        return (not chk, not cap)\n    moves.sort(key=key)\n    return moves\n\ndef attacker_can_mate(board, k):\n    # attacker to move, can force mate using at most k attacker moves\n    if k <= 0:\n        return False\n    for m in ordered_moves(board):\n        board.push(m)\n        if board.is_checkmate():\n            board.pop(); return True\n        ok = defender_all_mate(board, k-1)\n        board.pop()\n        if ok:\n            return True\n    return False\n\ndef defender_all_mate(board, k):\n    # defender to move; for ALL defender moves, attacker_can_mate(after, k) True\n    if board.is_stalemate() or board.is_insufficient_material():\n        return False\n    legal = list(board.legal_moves)\n    if not legal:\n        return False  # not checkmate (checked above), so stalemate already handled\n    for m in legal:\n        board.push(m)\n        res = attacker_can_mate(board, k)\n        board.pop()\n        if not res:\n            return False\n    return True\n\ndef collect_root_mates(board, k):\n    res = []\n    for m in board.legal_moves:\n        board.push(m)\n        if board.is_checkmate():\n            res.append((m,1)); board.pop(); continue\n        if k>=2 and defender_all_mate(board, k-1):\n            res.append((m, k)); board.pop(); continue\n        board.pop()\n    return res\n\nt0=time.time()\nfound_k=None\nfor k in range(1,6):\n    mates = collect_root_mates(root, k)\n    if mates:\n        found_k=k\n        print(\"Forced mate in\", k, \"attacker move(s)\")\n        for m,d in mates:\n            print(\"  \", root.san(m), m.uci())\n        break\n    else:\n        print(\"no mate in\", k)\nprint(\"time\", round(time.time()-t0,2))\nPYEOF\npython3 /tmp/solve.py\n"]
