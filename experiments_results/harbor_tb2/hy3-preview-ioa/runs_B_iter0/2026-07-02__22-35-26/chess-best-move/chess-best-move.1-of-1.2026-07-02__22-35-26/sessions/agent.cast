[116.298396, "i", "cat > /tmp/explore.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im)\nprint('shape', a.shape)\n# downsample whole board to 80x40 ascii\ndef lum(p):\n    return 0.299*p[0]+0.587*p[1]+0.114*p[2]\n# print small ascii of whole board\nH,W,_ = a.shape\nstep = 10\nchars = '@%#*+=-:. '\nfor y in range(0,H,step):\n    row=''\n    for x in range(0,W,step):\n        l = lum(a[y,x])\n        idx = int(l/256*len(chars))\n        row += chars[min(idx,len(chars)-1)]\n    print(row)\nEOF\npython3 /tmp/explore.py\n"]
