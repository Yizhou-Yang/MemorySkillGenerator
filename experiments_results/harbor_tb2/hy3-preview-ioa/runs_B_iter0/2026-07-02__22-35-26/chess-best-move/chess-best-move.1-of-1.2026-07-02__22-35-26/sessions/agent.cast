[147.394249, "i", "cat > /tmp/analyze.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\nocc=[]\nfgrid=[['.' for _ in range(8)] for _ in range(8)]\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        sq=a[r*S:(r+1)*S, c*S:(c+1)*S]\n        # dominant color = mode via rounding to buckets\n        flat=sq.reshape(-1,3)\n        # use median per channel as bg\n        bg=np.median(flat,axis=0)\n        d=np.sqrt(((flat-bg)**2).sum(axis=1))\n        frac=(d>40).mean()\n        row.append(round(frac,3))\n        if frac>0.05:\n            fgrid[r][c]='X'\n    occ.append(row)\nprint('occupancy (foreground fraction):')\nfor r in range(8):\n    print(' '.join(f'{occ[r][c]:.3f}' for c in range(8)))\nprint('occupied grid:')\nfor r in range(8):\n    print(''.join(fgrid[r]))\nEOF\npython3 /tmp/analyze.py\n"]
