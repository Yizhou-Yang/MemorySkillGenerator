[608.934112, "i", "cat > /tmp/solve.py << 'PYEOF'\nimport chess, time, sys\n\nFEN = \"r1bq1r2/1p3pp1/p1n1p3/3nPkbP/8/P7/1P2NPP1/R1B1K2R w KQ - 0 1\"\nboard = chess.Board(FEN)\nprint(\"valid:\", board.is_valid())\nprint(\"white to move, in check:\", board.is_check())\nprint(board)\nif not board.is_valid():\n    print(\"INVALID FEN - identification error\")\n    sys.exit()\nPYEOF\npython3 /tmp/solve.py\n"]
[608.93593, "o", "cat > /tmp/solve.py << 'PYEOF'"]
