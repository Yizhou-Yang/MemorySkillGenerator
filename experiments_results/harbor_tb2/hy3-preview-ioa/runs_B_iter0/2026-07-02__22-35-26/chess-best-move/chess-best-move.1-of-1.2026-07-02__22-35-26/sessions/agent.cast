[163.986161, "i", "cat > /tmp/glyphs.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\nocc = [(0,0),(0,2),(0,3),(0,5),(1,1),(1,5),(1,6),(2,0),(2,2),(2,4),(3,3),(3,4),(3,5),(3,6),(3,7),(5,0),(6,1),(6,4),(6,5),(6,6),(7,0),(7,2),(7,4),(7,7)]\nfiles='abcdefgh'\nfor (r,c) in occ:\n    sq=a[r*S:(r+1)*S, c*S:(c+1)*S]\n    flat=sq.reshape(-1,3)\n    bg=np.median(flat,axis=0)\n    d=np.sqrt(((flat-bg)**2).sum(axis=1))\n    mask=d>40\n    fg=flat[mask]\n    meancol=np.mean(fg,axis=0).astype(int)\n    rank=8-r\n    print(f'=== {files[c]}{rank}  fgcolor rgb={tuple(meancol)} ===')\n    # render mask downsampled\n    m2=mask.reshape(S,S)\n    step=4\n    for y in range(0,S,step):\n        line=''\n        for x in range(0,S,step):\n            block=m2[y:y+step, x:x+step]\n            line += '#' if block.mean()>0.25 else ' '\n        print(line)\nEOF\npython3 /tmp/glyphs.py > /tmp/glyphs.txt 2>&1\nwc -l /tmp/glyphs.txt\n"]
[164.005795, "o", "cat > /tmp/glyphs.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h"]
