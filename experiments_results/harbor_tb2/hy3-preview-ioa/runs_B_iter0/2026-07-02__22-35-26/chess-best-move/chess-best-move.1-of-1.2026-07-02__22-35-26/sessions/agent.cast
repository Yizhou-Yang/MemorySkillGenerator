[229.972269, "o", "       #  ##        \r\n       #####        \r\n      #    ##       \r\n     #      #       \r\n     #      ##      \r\n     #########      \r\n                    \r\n                    \r\n                    \r\n                    \r\n=== a1  fgcolor rgb=(np.int64(238), np.int64(227), np.int64(218)) ===\r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n     ########       \r\n      #     #       \r\n      #    #        \r\n       #   #        \r\n  #                 \r\n                    \r\n       #   #        \r\n      #    #        \r\n      #     #       \r\n     ########       \r\n          #         \r\n          #         \r\n                    \r\n                    \r\n=== c1  fgcolor rgb=(np.int64(239), np.int64(230), np.int64(222)) ===\r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n        ###         \r\n        ###         \r\n       ####         \r\n       ## ##        \r\n       #####        \r\n       ####         \r\n       #  #         \r\n       ## #         \r\n       #   #        \r\n      ######        \r\n          #         \r\n          #         \r\n                    \r\n                    \r\n=== e1  fgcolor rgb=(np.int64(241), np.int64(232), np.int64(224)) ===\r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n        ###         \r\n        ##          \r\n     ########       \r\n    ##  ##   #      \r\n    #    #   #      \r\n    ##   #   #      \r\n     #########      \r\n      #######       \r\n      #     #       \r\n      #######       \r\n          #         \r\n          #         \r\n                    \r\n                    \r\n=== h1  fgcolor rgb=(np.int64(250), np.int64(244), np.int64(237)) ===\r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n     ########       \r\n      #     #       \r\n      #    #        \r\n           #        \r\n                    \r\n                    \r\n           #        \r\n      #    #        \r\n      #     #       \r\n     ########       \r\n          #         \r\n                    \r\n                    \r\n                    \r\n\u001b[?2004hroot@d6c48eaf7c13:/app# "]
[333.909623, "i", "cat > /tmp/hi.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\nfiles='abcdefgh'\nsquares=[(0,3),(0,5),(0,2),(7,4),(6,4),(6,2),(7,0),(7,7),(2,2),(3,3),(3,4)]\nfor (r,c) in squares:\n    sq=a[r*S:(r+1)*S, c*S:(c+1)*S]\n    flat=sq.reshape(-1,3)\n    bg=np.median(flat,axis=0)\n    d=np.sqrt(((flat-bg)**2).sum(axis=1))\n    mask=d>40\n    m2=mask.reshape(S,S)\n    rank=8-r\n    print(f'=== {files[c]}{rank} ===')\n    step=2\n    for y in range(0,S,step):\n        line=''\n        for x in range(0,S,step):\n            block=m2[y:y+step, x:x+step]\n            line += '#' if block.mean()>0.3 else '.'\n        print(line)\nEOF\npython3 /tmp/hi.py > /tmp/hi.txt 2>&1\nsed -n '1,90p' /tmp/hi.txt\n"]
[333.928327, "o", "cat > /tmp/hi.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im = Image.open('/app/chess_puzzle.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> a = np.array(im).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> S=80\r\n\u001b[?2004l\r\u001b[?2004h> files='abcdefgh'\r\n\u001b[?2004l\r\u001b[?2004h> squares=[(0,3),(0,5),(0,2),(7,4),(6,4),(6,2),(7,0),(7,7),(2,2),(3,3),(3,4)]\r\n\u001b[?2004l\r\u001b[?2004h> for (r,c) in squares:\r\n\u001b[?2004l\r\u001b[?2004h>     sq=a[r*S:(r+1)*S, c*S:(c+1)*S]\r\n\u001b[?2004l\r\u001b[?2004h>     flat=sq.reshape(-1,3)\r\n\u001b[?2004l\r\u001b[?2004h>     bg=np.median(flat,axis=0)\r\n\u001b[?2004l\r\u001b[?2004h>     d=np.sqrt(((flat-bg)**2).sum(axis=1))\r\n\u001b[?2004l\r\u001b[?2004h>     mask=d>40\r\n\u001b[?2004l\r\u001b[?2004h>     m2=mask.reshape(S,S)\r\n\u001b[?2004l\r\u001b[?2004h>     rank=8-r\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'=== {files[c]}{rank} ===')\r\n\u001b[?2004l\r\u001b[?2004h>     step=2\r\n\u001b[?2004l\r\u001b[?2004h>     for y in range(0,S,step):\r\n\u001b[?2004l\r\u001b[?2004h>         line=''\r\n\u001b[?2004l\r\u001b[?2004h>         for x in range(0,S,step):\r\n\u001b[?2004l\r\u001b[?2004h>             block=m2[y:y+step, x:x+step]\r\n\u001b[?2004l\r\u001b[?2004h>             line += '#' if block.mean()>0.3 else '.'\r\n\u001b[?2004l\r\u001b[?2004h>         print(line)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
