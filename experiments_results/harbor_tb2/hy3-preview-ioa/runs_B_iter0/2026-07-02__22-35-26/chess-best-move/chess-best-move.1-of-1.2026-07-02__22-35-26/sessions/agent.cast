[462.458248, "i", "cat > /tmp/crown.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\nfiles='abcdefgh'\nsquares=[(0,2),(3,5),(3,6)]  # c8, f5, g5\nfor (r,c) in squares:\n    sq=a[r*S:(r+1)*S, c*S:(c+1)*S]\n    flat=sq.reshape(-1,3)\n    bg=np.median(flat,axis=0)\n    d=np.sqrt(((flat-bg)**2).sum(axis=1))\n    mask=d>40\n    m2=mask.reshape(S,S)\n    rank=8-r\n    print(f'=== {files[c]}{rank} crown region (1px) ===')\n    for y in range(10,42):\n        line=''\n        for x in range(22,58):\n            line += '#' if m2[y,x] else '.'\n        print(line)\nEOF\npython3 /tmp/crown.py\n"]
