[63.515621, "i", "cat > /app/recon.py << 'EOF'\nout = bytearray()\nwith open('/app/data.hex') as f:\n    for line in f:\n        parts = line.split()\n        if not parts:\n            continue\n        for w in parts[1:]:\n            v = int(w, 8)\n            out.append(v & 0xFF)\n            out.append((v >> 8) & 0xFF)\nwith open('/app/data.bin', 'wb') as f:\n    f.write(out)\nprint('wrote', len(out), 'bytes')\nEOF\npython3 /app/recon.py\n"]
[63.515915, "o", "cat > /app/recon.py << 'EOF'"]
