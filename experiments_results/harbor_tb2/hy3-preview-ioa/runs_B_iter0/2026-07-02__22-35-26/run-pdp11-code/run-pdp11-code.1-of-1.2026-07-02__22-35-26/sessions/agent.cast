[255.602045, "i", "python3 - << 'EOF'\nimport re\nd=open('/app/data.bin','rb').read()\nprint('len',len(d))\n# byte-oriented printable runs\ns=''.join(chr(b) if 32<=b<127 else '.' for b in d)\nfor m in re.finditer(r'[\\x20-\\x7e]{4,}', s):\n    print('BYTE', m.start(), repr(m.group()))\n# word-oriented: interpret 16-bit little-endian words as two chars (PDP-11 prints chars)\nwords=[d[i]|(d[i+1]<<8) for i in range(0,len(d)-1,2)]\nprint('--- word view first 40 words ---')\nfor w in words[:40]:\n    print(oct(w), repr(chr(w&0xff))+repr(chr((w>>8)&0xff)) if 32<=(w&0xff)<127 or 32<=((w>>8)&0xff)<127 else '')\nEOF\n"]
