[42.493873, "o", "\r\n"]
[42.494003, "o", "                body=request.body,  \u001b[90m# type: ignore[arg-type]  # urllib3 stubs don't accept Iterable[bytes | str]\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.494447, "o", "\r\n"]
[42.494587, "o", "                headers=request.headers,  \u001b[90m# type: ignore[arg-type]  # urllib3#3072\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.494696, "o", "\r\n"]
[42.494809, "o", "                redirect=\u001b[94mFalse\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[42.494928, "o", "\r\n"]
[42.495059, "o", "                assert_same_host=\u001b[94mFalse\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[42.495157, "o", "\r\n"]
[42.495272, "o", "                preload_content=\u001b[94mFalse\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
