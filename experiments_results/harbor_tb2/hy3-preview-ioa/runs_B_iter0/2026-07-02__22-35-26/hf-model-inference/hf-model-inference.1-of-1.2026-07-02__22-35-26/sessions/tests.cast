[42.447342, "o", "        \u001b[94melif\u001b[39;49;00m response \u001b[95mand\u001b[39;49;00m response.get_redirect_location():\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Redirect retry?\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m redirect \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                redirect -= \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            cause = \u001b[33m\"\u001b[39;49;00m\u001b[33mtoo many redirects\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            response_redirect_location = response.get_redirect_location()\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m response_redirect_location:\u001b[90m\u001b[39;49;00m\r\n                redirect_location = response_redirect_location\u001b[90m\u001b[39;49;00m\r\n            status = response.status\u001b[90m\u001b[39;49;00m\r\n"]
[42.447409, "o", "    \u001b[90m\u001b[39;49;00m"]
[42.44745, "o", "\r\n"]
[42.447516, "o", "        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m"]
[42.447576, "o", "\r\n"]
[42.447642, "o", "            \u001b[90m# Incrementing because of a server error like a 500 in\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.447682, "o", "\r\n"]
[42.447745, "o", "            \u001b[90m# status_forcelist and the given method is in the allowed_methods\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.447786, "o", "\r\n"]
[42.447849, "o", "            cause = ResponseError.GENERIC_ERROR\u001b[90m\u001b[39;49;00m"]
[42.447893, "o", "\r\n"]
[42.448068, "o", "            \u001b[94mif\u001b[39;49;00m response \u001b[95mand\u001b[39;49;00m response.status:\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m status_count \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                    status_count -= \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.448292, "o", "\r\n"]
[42.448576, "o", "                cause = ResponseError.SPECIFIC_ERROR.format(status_code=response.status)\u001b[90m\u001b[39;49;00m\r\n                status = response.status\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        history = \u001b[96mself\u001b[39;49;00m.history + (\u001b[90m\u001b[39;49;00m\r\n            RequestHistory(method, url, error, status, redirect_location),\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m"]
[42.449948, "o", "\r\n    \u001b[90m\u001b[39;49;00m\r\n        new_retry = \u001b[96mself\u001b[39;49;00m.new(\u001b[90m\u001b[39;49;00m\r\n            total=total,\u001b[90m\u001b[39;49;00m\r\n            connect=connect,\u001b[90m\u001b[39;49;00m\r\n            read=read,\u001b[90m\u001b[39;49;00m\r\n            redirect=redirect,\u001b[90m\u001b[39;49;00m\r\n            status=status_count,\u001b[90m\u001b[39;49;00m"]
[42.450229, "o", "\r\n            other=other,\u001b[90m\u001b[39;49;00m\r\n            history=history,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m new_retry.is_exhausted():\u001b[90m\u001b[39;49;00m\r\n            reason = error \u001b[95mor\u001b[39;49;00m ResponseError(cause)\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94mraise\u001b[39;49;00m MaxRetryError(_pool, url, reason) \u001b[94mfrom\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[04m\u001b[96mreason\u001b[39;49;00m  \u001b[90m# type: ignore[arg-type]\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           urllib3.exceptions.MaxRetryError: HTTPConnectionPool(host='localhost', port=5000): Max retries exceeded with url: /sentiment (Caused by NewConnectionError(\"HTTPConnection(host='localhost', port=5000): Failed to establish a new connection: [Errno 111] Connection refused\"))\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/usr/local/lib/python3.13/site-packages/urllib3/util/retry.py\u001b[0m:543: MaxRetryError\r\n\r\n\u001b[33mDuring handling of the above exception, another excepti"]
[42.450252, "o", "on occurred:\u001b[0m\r\n\r\n"]
[42.451269, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_api_error_handling\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that the API properly handles errors\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.451542, "o", "\r\n        \u001b[90m# Test missing text field\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       response = requests.post(\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mhttp://localhost:5000/sentiment\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            json={\u001b[33m\"\u001b[39;49;00m\u001b[33minvalid_field\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mThis should cause an error\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m},\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:108: \r\n"]
[42.452141, "o", "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\u001b[1m\u001b[31m/usr/local/lib/python3.13/site-packages/requests/api.py\u001b[0m:134: in post\r\n"]
[42.453574, "o", "    \u001b[0m\u001b[94mreturn\u001b[39;49;00m request(\u001b[33m\"\u001b[39;49;00m\u001b[33mpost\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, url, data=data, json=json, **kwargs)\u001b[90m\u001b[39;49;00m\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m"]
[42.453641, "o", "\r\n"]
[42.453743, "o", "\u001b[1m\u001b[31m/usr/local/lib/python3.13/site-packages/requests/api.py\u001b[0m:71: in request\r\n"]
[42.455894, "o", "    \u001b[0m\u001b[94mreturn\u001b[39;49;00m session.request(method=method, url=url, **kwargs)\u001b[90m\u001b[39;49;00m\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m"]
[42.455947, "o", "\r\n"]
[42.456064, "o", "\u001b[1m\u001b[31m/usr/local/lib/python3.13/site-packages/requests/sessions.py\u001b[0m:651: in request"]
[42.456106, "o", "\r\n"]
[42.457597, "o", "    \u001b[0mresp = \u001b[96mself\u001b[39;49;00m.send(prep, **send_kwargs)\u001b[90m\u001b[39;49;00m\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n"]
[42.457901, "o", "\u001b[1m\u001b[31m/usr/local/lib/python3.13/site-packages/requests/sessions.py\u001b[0m:784: in send\r\n"]
[42.459512, "o", "    \u001b[0mr = adapter.send(request, **kwargs)\u001b[90m\u001b[39;49;00m"]
[42.459937, "o", "\r\n        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\nself = <requests.adapters.HTTPAdapter object at 0x7fb5037e5e00>, request = <PreparedRequest [POST]>, stream = False, timeout = None, verify = True, cert = None\r\n"]
[42.460182, "o", "proxies = OrderedDict()\r\n\r\n"]
[42.478113, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92msend\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mself\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[42.478195, "o", "\r\n"]
[42.47831, "o", "        request: PreparedRequest,\u001b[90m\u001b[39;49;00m"]
[42.478403, "o", "\r\n"]
[42.478512, "o", "        stream: \u001b[96mbool\u001b[39;49;00m = \u001b[94mFalse\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[42.478658, "o", "\r\n"]
[42.478776, "o", "        timeout: _t.TimeoutType = \u001b[94mNone\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[42.478877, "o", "\r\n"]
[42.479007, "o", "        verify: _t.VerifyType = \u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[42.479113, "o", "\r\n"]
[42.479231, "o", "        cert: _t.CertType = \u001b[94mNone\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[42.479339, "o", "\r\n"]
[42.479456, "o", "        proxies: \u001b[96mdict\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m, \u001b[96mstr\u001b[39;49;00m] | \u001b[94mNone\u001b[39;49;00m = \u001b[94mNone\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[42.479589, "o", "\r\n"]
[42.479706, "o", "    ) -> Response:\u001b[90m\u001b[39;49;00m"]
[42.479806, "o", "\r\n"]
[42.479974, "o", "    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Sends PreparedRequest object. Returns Response object.\u001b[39;49;00m"]
[42.480081, "o", "\r\n"]
[42.480197, "o", "    \u001b[33m\u001b[39;49;00m"]
[42.480298, "o", "\r\n"]
[42.480413, "o", "    \u001b[33m    :param request: The :class:`PreparedRequest <PreparedRequest>` being sent.\u001b[39;49;00m"]
[42.480551, "o", "\r\n"]
[42.480668, "o", "    \u001b[33m    :param stream: (optional) Whether to stream the request content.\u001b[39;49;00m"]
[42.480768, "o", "\r\n"]
[42.480885, "o", "    \u001b[33m    :param timeout: (optional) How long to wait for the server to send\u001b[39;49;00m"]
[42.480999, "o", "\r\n"]
[42.481118, "o", "    \u001b[33m        data before giving up, as a float, or a :ref:`(connect timeout,\u001b[39;49;00m"]
[42.481219, "o", "\r\n"]
[42.481342, "o", "    \u001b[33m        read timeout) <timeouts>` tuple.\u001b[39;49;00m"]
[42.481443, "o", "\r\n"]
[42.482449, "o", "    \u001b[33m    :type timeout: float or tuple or urllib3 Timeout object\u001b[39;49;00m"]
[42.482598, "o", "\r\n"]
[42.482715, "o", "    \u001b[33m    :param verify: (optional) Either a boolean, in which case it controls whether\u001b[39;49;00m"]
[42.482818, "o", "\r\n"]
[42.482935, "o", "    \u001b[33m        we verify the server's TLS certificate, or a string, in which case it\u001b[39;49;00m"]
[42.48306, "o", "\r\n"]
[42.483179, "o", "    \u001b[33m        must be a path to a CA bundle to use\u001b[39;49;00m"]
[42.483282, "o", "\r\n"]
[42.483397, "o", "    \u001b[33m    :param cert: (optional) Any user-provided SSL certificate to be trusted.\u001b[39;49;00m"]
[42.483499, "o", "\r\n"]
[42.483632, "o", "    \u001b[33m    :param proxies: (optional) The proxies dictionary to apply to the request.\u001b[39;49;00m"]
[42.483733, "o", "\r\n"]
[42.483851, "o", "    \u001b[33m    :rtype: requests.Response\u001b[39;49;00m"]
[42.48395, "o", "\r\n"]
[42.48409, "o", "    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.484216, "o", "\r\n"]
[42.484344, "o", "    \u001b[90m\u001b[39;49;00m"]
[42.484443, "o", "\r\n"]
[42.484578, "o", "        \u001b[94massert\u001b[39;49;00m _is_prepared(request)\u001b[90m\u001b[39;49;00m"]
[42.484686, "o", "\r\n"]
[42.484803, "o", "    \u001b[90m\u001b[39;49;00m"]
[42.484904, "o", "\r\n"]
[42.485041, "o", "        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m"]
[42.485147, "o", "\r\n"]
[42.485268, "o", "            conn = \u001b[96mself\u001b[39;49;00m.get_connection_with_tls_context(\u001b[90m\u001b[39;49;00m"]
[42.485372, "o", "\r\n"]
[42.48549, "o", "                request, verify, proxies=proxies, cert=cert\u001b[90m\u001b[39;49;00m"]
[42.485609, "o", "\r\n"]
[42.485771, "o", "            )\u001b[90m\u001b[39;49;00m"]
[42.485914, "o", "\r\n"]
[42.486056, "o", "        \u001b[94mexcept\u001b[39;49;00m LocationValueError \u001b[94mas\u001b[39;49;00m e:\u001b[90m\u001b[39;49;00m"]
[42.48616, "o", "\r\n"]
[42.486281, "o", "            \u001b[94mraise\u001b[39;49;00m InvalidURL(e, request=request)\u001b[90m\u001b[39;49;00m"]
[42.486389, "o", "\r\n"]
[42.486507, "o", "    \u001b[90m\u001b[39;49;00m"]
[42.486624, "o", "\r\n"]
[42.486741, "o", "        \u001b[96mself\u001b[39;49;00m.cert_verify(conn, request.url, verify, cert)\u001b[90m\u001b[39;49;00m"]
[42.486841, "o", "\r\n"]
[42.487064, "o", "        url = \u001b[96mself\u001b[39;49;00m.request_url(request, proxies)\u001b[90m\u001b[39;49;00m"]
[42.487176, "o", "\r\n"]
[42.487288, "o", "        \u001b[96mself\u001b[39;49;00m.add_headers(\u001b[90m\u001b[39;49;00m"]
[42.48739, "o", "\r\n"]
[42.487507, "o", "            request,\u001b[90m\u001b[39;49;00m"]
[42.487623, "o", "\r\n"]
[42.48777, "o", "            stream=stream,\u001b[90m\u001b[39;49;00m"]
[42.487873, "o", "\r\n"]
[42.488005, "o", "            timeout=timeout,\u001b[90m\u001b[39;49;00m"]
[42.488107, "o", "\r\n"]
[42.488223, "o", "            verify=verify,\u001b[90m\u001b[39;49;00m"]
[42.48833, "o", "\r\n"]
[42.488447, "o", "            cert=cert,\u001b[90m\u001b[39;49;00m"]
[42.488562, "o", "\r\n"]
[42.488678, "o", "            proxies=proxies,\u001b[90m\u001b[39;49;00m"]
[42.488779, "o", "\r\n"]
[42.488901, "o", "        )\u001b[90m\u001b[39;49;00m"]
[42.489018, "o", "\r\n"]
[42.489136, "o", "    \u001b[90m\u001b[39;49;00m"]
[42.489238, "o", "\r\n"]
[42.489357, "o", "        chunked = \u001b[95mnot\u001b[39;49;00m (request.body \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m \u001b[95mor\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mContent-Length\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m request.headers)\u001b[90m\u001b[39;49;00m"]
[42.489479, "o", "\r\n"]
[42.489615, "o", "    \u001b[90m\u001b[39;49;00m"]
[42.489717, "o", "\r\n"]
[42.489833, "o", "        \u001b[94mif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(timeout, \u001b[96mtuple\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m"]
[42.489935, "o", "\r\n"]
[42.490069, "o", "            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m"]
[42.490178, "o", "\r\n"]
[42.490296, "o", "                connect, read = timeout\u001b[90m\u001b[39;49;00m"]
[42.490406, "o", "\r\n"]
[42.490546, "o", "                resolved_timeout = TimeoutSauce(connect=connect, read=read)\u001b[90m\u001b[39;49;00m"]
[42.490645, "o", "\r\n"]
[42.49076, "o", "            \u001b[94mexcept\u001b[39;49;00m \u001b[96mValueError\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m"]
[42.49086, "o", "\r\n"]
[42.490992, "o", "                \u001b[94mraise\u001b[39;49;00m \u001b[96mValueError\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m"]
[42.491096, "o", "\r\n"]
[42.491214, "o", "                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mInvalid timeout \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtimeout\u001b[33m}\u001b[39;49;00m\u001b[33m. Pass a (connect, read) timeout tuple, \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.491329, "o", "\r\n"]
[42.491452, "o", "                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mor a single float to set both timeouts to the same value.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[42.49158, "o", "\r\n"]
[42.4917, "o", "                )\u001b[90m\u001b[39;49;00m"]
[42.491804, "o", "\r\n"]
[42.491926, "o", "        \u001b[94melif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(timeout, TimeoutSauce):\u001b[90m\u001b[39;49;00m"]
[42.492058, "o", "\r\n"]
[42.492176, "o", "            resolved_timeout = timeout\u001b[90m\u001b[39;49;00m"]
[42.49229, "o", "\r\n"]
[42.492409, "o", "        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m"]
[42.49251, "o", "\r\n"]
[42.492645, "o", "            resolved_timeout = TimeoutSauce(connect=timeout, read=timeout)\u001b[90m\u001b[39;49;00m"]
[42.492744, "o", "\r\n"]
[42.492862, "o", "    \u001b[90m\u001b[39;49;00m"]
[42.492976, "o", "\r\n"]
