[442.703744, "i", "cat > /tmp/mkparquet.py << 'PYEOF'\nimport csv, struct, sys\n\ndef write_varint(n):\n    out=bytearray()\n    while True:\n        b=n&0x7F; n>>=7\n        if n: out.append(b|0x80)\n        else: out.append(b); break\n    return out\n\ndef zigzag(n):\n    return (n<<1)^(n>>63)\n\nCT_BOOL_T=1; CT_BOOL_F=2; CT_BYTE=3; CT_I16=4; CT_I32=5; CT_I64=6\nCT_DOUBLE=7; CT_BINARY=8; CT_LIST=9; CT_MAP=11; CT_STRUCT=12\nKIND_CT={'byte':CT_BYTE,'i16':CT_I16,'i32':CT_I32,'i64':CT_I64,\n 'double':CT_DOUBLE,'binary':CT_BINARY,'struct':CT_STRUCT,\n 'list':CT_LIST,'map':CT_MAP}\n\ndef encode_value(out, kind, value):\n    if kind=='byte': out.append(value&0xFF)\n    elif kind in ('i16','i32','i64'): out.extend(write_varint(zigzag(value)))\n    elif kind=='double': out.extend(struct.pack('<d', value))\n    elif kind=='binary':\n        out.extend(write_varint(len(value))); out+=value\n    elif kind=='struct': out.extend(encode_struct(value))\n    elif kind=='list':\n        ek,items=value\n        if len(items)==0: out.append(0x00)\n        else:\n            ect=KIND_CT[ek]\n            if len(items)<15: out.append((len(items)<<4)|ect)\n            else: out.append(0xF0); out.extend(write_varint(len(items)))\n            for it in items: encode_value(out, ek, it)\n\ndef encode_struct(fields):\n    out=bytearray(); last=0\n    for f in fields:\n        fid,kind,value=f\n        delta=fid-last\n        if kind=='bool':\n            ct=CT_BOOL_T if value else CT_BOOL_F\n            if 0<delta<=15: out.append((delta<<4)|ct)\n            else: out.append(ct); out.extend(write_varint(zigzag(fid)))\n            last=fid; continue\n        ct=KIND_CT[kind]\n        if 0<delta<=15: out.append((delta<<4)|ct)\n        else: out.append(ct); out.extend(write_varint(zigzag(fid)))\n        last=fid; encode_value(out, kind, value)\n    out.append(0x00)\n    return bytes(out)\n\ndef main():\n    IN='/app/data.csv'; OUT='/app/data.parquet'\n    with open(IN, newline='') as f: rows=list(csv.reader(f))\n    if not rows: sys.exit('empty csv')\n    header=rows[0]; data=rows[1:]; ncol=len(header)\n    def is_int(s):\n        return s!='' and (s[0]=='-' or s[0].isdigit()) and s.lstrip('-').isdigit()\n    col_types=[]; col_pt=[]\n    for j in range(ncol):\n        vals=[r[j] if j<len(r) else '' for r in data]\n        if vals and all(is_int(v) for v in vals):\n            col_types.append('int'); col_pt.append(1)\n        else:\n            col_types.append('str'); col_pt.append(6)\n    num_rows=len(data)\n    def page_data(j):\n        o=bytearray()\n        if col_types[j]=='int':\n            for r in data:\n                v=int(r[j]) if (j<len(r) and r[j]!='') else 0\n                o.extend(struct.pack('<i', v))\n        else:\n            for r in data:\n                s=r[j] if j<len(r) else ''\n                b=s.encode('utf-8'); o.extend(struct.pack('<i', len(b))); o+=b\n        return bytes(o)\n    out=open(OUT,'wb'); out.write(b'PAR1')\n    offset=4; meta=[]\n    for j in range(ncol):\n        pd=page_data(j)\n        dph=[(1,'i32',num_rows),(2,'i32',3),(3,'i32',3),(4,'i32',3)]\n        ph=encode_struct([(1,'i32',0),(2,'i32',len(pd)),(3,'i32',len(pd)),(5,'struct',dph)])\n        chunk=ph+pd; out.write(chunk)\n        coff=offset; dpo=offset; tsize=len(chunk)\n        meta.append((header[j], col_types[j], col_pt[j], coff, dpo, tsize, num_rows))\n        offset+=tsize\n    schema=[[(1,'binary',b'schema'),(4,'i32',0),(5,'i32',ncol)]]\n    for j in range(ncol):\n        se=[(1,'binary',header[j].encode('utf-8')),(2,'i32',col_pt[j]),(4,'i32',0)]\n        if col_types[j]=='str': se.append((6,'i32',0))\n        schema.append(se)\n    chunks=[]; total_size=0\n    for (name,ct,pt,coff,dpo,tsize,nval) in meta:\n        cm=[(1,'i32',0),(2,'list',('i32',[0,3])),(3,'list',('binary',[name.encode('utf-8')])),\n            (4,'i32',pt),(5,'i32',0),(6,'i64',tsize),(7,'i64',tsize),(8,'i64',dpo)]\n        chunks.append([(1,'i64',coff),(3,'struct',cm)]); total_size+=tsize\n    rowgroup=[(1,'i64',total_size),(2,'list',('struct',chunks)),(3,'i64',num_rows)]\n    fm=encode_struct([(1,'i32',1),(2,'list',('struct',schema)),(3,'i64',num_rows),(4,'list',('struct',[rowgroup])"]
[442.704529, "i", ")])\n    out.write(fm); out.write(struct.pack('<I', len(fm))); out.write(b'PAR1'); out.close()\n    print('wrote', OUT, 'rows=', num_rows, 'cols=', ncol, 'footer_bytes=', len(fm))\nmain()\nPYEOF\n"]
