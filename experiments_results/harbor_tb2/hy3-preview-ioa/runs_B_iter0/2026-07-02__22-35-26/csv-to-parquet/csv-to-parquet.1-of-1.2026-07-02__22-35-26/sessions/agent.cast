[391.938368, "i", "cat > /tmp/mkparquet.py << 'PYEOF'\nimport csv, struct, sys\n\ndef write_varint(n):\n    out = bytearray()\n    while True:\n        b = n & 0x7F\n        n >>= 7\n        if n:\n            out.append(b | 0x80)\n        else:\n            out.append(b)\n            break\n    return out\n\ndef zigzag(n):\n    return (n << 1) ^ (n >> 63)\n\nCT_BOOL_T=1; CT_BOOL_F=2; CT_BYTE=3; CT_I16=4; CT_I32=5; CT_I64=6\nCT_DOUBLE=7; CT_BINARY=8; CT_LIST=9; CT_MAP=11; CT_STRUCT=12\n\nKIND_CT={'byte':CT_BYTE,'i16':CT_I16,'i32':CT_I32,'i64':CT_I64,\n 'double':CT_DOUBLE,'binary':CT_BINARY,'struct':CT_STRUCT,\n 'list':CT_LIST,'map':CT_MAP}\n\ndef encode_value(out, kind, value):\n    if kind=='byte':\n        out.append(value & 0xFF)\n    elif kind in ('i16','i32','i64'):\n        out.extend(write_varint(zigzag(value)))\n    elif kind=='double':\n        out.extend(struct.pack('<d', value))\n    elif kind=='binary':\n        out.extend(write_varint(len(value)))\n        out += value\n    elif kind=='struct':\n       "]
