[442.764661, "o", "\u001b[?2004h>             ect=KIND_CT[ek]\r\n\u001b[?2004l\r\u001b[?2004h>             if len(items)<15: out.append((len(items)<<4)|ect)\r\n\u001b[?2004l\r\u001b[?2004h>             else: out.append(0xF0); out.extend(write_varint(len(items)))\r\n\u001b[?2004l\r\u001b[?2004h>             for it in items: encode_value(out, ek, it)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def encode_struct(fields):\r\n\u001b[?2004l\r\u001b[?2004h>     out=bytearray(); last=0\r\n\u001b[?2004l\r\u001b[?2004h>     for f in fields:\r\n\u001b[?2004l\r\u001b[?2004h>         fid,kind,value=f\r\n\u001b[?2004l\r\u001b[?2004h>         delta=fid-last\r\n\u001b[?2004l\r\u001b[?2004h>         if kind=='bool':\r\n\u001b[?2004l\r\u001b[?2004h>             ct=CT_BOOL_T if value else CT_BOOL_F\r\n\u001b[?2004l\r\u001b[?2004h>             if 0<delta<=15: out.append((delta<<4)|ct)\r\n\u001b[?2004l\r\u001b[?2004h> "]
