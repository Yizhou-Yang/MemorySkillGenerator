[606.95451, "o", "> fl=struct.unpack('<I', b[-8:-4])[0]\r\n\u001b[?2004l\r\u001b[?2004h> fm, _ = rd_struct(b, len(b)-8-fl)\r\n\u001b[?2004l\r\u001b[?2004h> schema=fm[2]            # list of SchemaElement dicts\r\n\u001b[?2004l\r\u001b[?2004h> num_rows=fm[3]\r\n\u001b[?2004l\r\u001b[?2004h> rg=fm[4][0]             # first row group\r\n\u001b[?2004l\r\u001b[?2004h> cols=rg[2]              # list of ColumnChunk dicts\r\n\u001b[?2004l\r\u001b[?2004h> names=[]; types=[]\r\n\u001b[?2004l\r\u001b[?2004h> for s in schema[1:]:\r\n\u001b[?2004l\r\u001b[?2004h>     names.append(s[1].decode())\r\n\u001b[?2004l\r\u001b[?2004h>     types.append(s[2])\r\n\u001b[?2004l\r\u001b[?2004h> print('schema:', list(zip(names,types)), 'num_rows=', num_rows)\r\n\u001b[?2004l\r\u001b[?2004h> result={}\r\n\u001b[?2004l\r\u001b[?2004h> for ci, cc in enumerate(cols):\r\n\u001b[?2004l\r\u001b[?2004h>     cm=cc[3]\r\n\u001b[?2004l\r\u001b[?2004h>     path=[x.decode() for x in cm[3]]\r\n\u001b[?2004l\r\u001b[?2004h>     typ=cm[4]\r\n\u001b[?2004l\r\u001b[?2004h>     dpo=cm[8]; tcs=cm[6]\r\n\u001b[?2004l\r\u001b[?2004h>     ph, np = rd_struct(b, dpo)\r\n\u001b[?2004l\r\u001b[?2004h>     upage=ph[2]; cpage=ph[3]\r\n\u001b[?2004l\r\u001b[?2004h>     dph=ph[5]\r\n\u001b[?2004l\r\u001b[?2004h>     nvals=dph[1]; enc=dph[2]\r\n\u001b[?2004l\r\u001b[?2004h>     data=b[np:np+cpage]\r\n\u001b[?2004l\r\u001b[?2004h>     dp=0; vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>     if typ==1:  # INT32\r\n\u001b[?2004l\r\u001b[?2004h>         for _ in range(nvals):\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(struct.unpack('<i', data[dp:dp+4])[0]); dp+=4\r\n\u001b[?2004l\r\u001b[?2004h>     elif typ==6:  # BYTE_ARRAY\r\n\u001b[?2004l\r\u001b[?2004h>         for _ in range(nvals):\r\n\u001b[?2004l\r\u001b[?2004h>             ln=struct.unpack('<i', data[dp:dp+4])[0]; dp+=4\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(data[dp:dp+ln].decode()); dp+=ln\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         raise Exception('unhandled type %d'%typ)\r\n\u001b[?2004l\r\u001b[?2004h>     result[path[0]]=vals\r\n\u001b[?2004l\r\u001b[?2004h> print('decoded:', result)\r\n\u001b[?2004l\r\u001b[?2004h> # compare to CSV\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/data.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     rows=list(csv.reader(f))\r\n\u001b[?2004l\r\u001b[?2004h> ph=rows[0][:len(names)]\r\n\u001b[?2004l\r\u001b[?2004h> ok=True\r\n\u001b[?2004l\r\u001b[?2004h> for j,name in enumerate(names):\r\n\u001b[?2004l\r\u001b[?2004h>     expect=[r[j] if j<len(r) else '' for r in rows[1:]]\r\n\u001b[?2004l\r\u001b[?2004h>     got=result[name]\r\n\u001b[?2004l\r\u001b[?2004h>     if types[j]==1:\r\n\u001b[?2004l\r\u001b[?2004h>         got=[str(x) for x in got]\r\n\u001b[?2004l\r\u001b[?2004h>     if got!=expect:\r\n\u001b[?2004l\r\u001b[?2004h>         ok=False; print('MISMATCH', name, 'got', got, 'exp', expect)\r\n\u001b[?2004l\r\u001b[?2004h> print('CSV header:', ph)\r\n\u001b[?2004l\r\u001b[?2004h> print('MATCH' if ok else 'FAILED')\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r\u001b[?2004hroot@7845b82b8a32:/app# "]
