[391.951335, "i", " out.extend(encode_struct(value))\n    elif kind=='list':\n        ek, items = value\n        if len(items)==0:\n            out.append(0x00)\n        else:\n            ect=KIND_CT[ek]\n            if len(items)<15:\n                out.append((len(items)<<4)|ect)\n            else:\n                out.append(0xF0)\n                out.extend(write_varint(len(items)))\n            for it in items:\n                encode_value(out, ek, it)\n\ndef encode_struct(fields):\n    out=bytearray()\n    last=0\n    for f in fields:\n        fid, kind, value = f\n        delta=fid-last\n        if kind=='bool':\n            ct=CT_BOOL_T if value else CT_BOOL_F\n            if 0<delta<=15:\n                out.append((delta<<4)|ct)\n            else:\n                out.append(ct)\n                out.extend(write_varint(zigzag(fid)))\n            last=fid\n            continue\n        ct=KIND_CT[kind]\n        if 0<delta<=15:\n            out.append((delta<<4)|ct)\n        else:\n            out.append(ct)\n            out.extend(write_varint(zigzag(fid)))\n        last=fid\n        encode_value(out, kind, value)\n    out.append(0x00)\n    return bytes(out)\n\ndef main():\n    IN='/app/data.csv'; OUT='/app/data.parquet'\n    with open(IN, newline='') as f:\n        rows=list(csv.reader(f))\n    if not rows:\n        sys.exit('empty csv')\n    header=rows[0]; data=rows[1:]; ncol=len(header)\n    def is_int(s):\n        return s!='' and (s[0]=='-' or s[0].isdigit()) and s.lstrip('-').isdigit()\n    col_types=[]; col_pt=[]\n    for j in range(ncol):\n        vals=[r[j] if j<len(r) else '' for r in data]\n        if vals and all(is_int(v) for v in vals):\n            col_types.append('int'); col_pt.append(1)\n        else:\n            col_types.append('str'); col_pt.append(6)\n    num_rows=len(data)\n\n    def page_data(j):\n        o=bytearray()\n        if col_types[j]=='int':\n            for r in data:\n                v=int(r[j]) if (j<len(r) and r[j]!='') else 0\n                o.extend(struct.pack('<i', v))\n        else:\n            for r in data:\n                s=r[j] if j<len(r) else ''\n                b=s.encode('utf-8')\n                o.extend(struct.pack('<i', len(b))); o+=b\n        return bytes(o)\n\n    out=open(OUT,'wb')\n    out.write(b'PAR1')\n    offset=4; meta=[]\n    for j in range(ncol):\n        pd=page_data(j)\n        dph=encode_struct([(1,'i32',num_rows),(2,'i32',0),(3,'i32',3),(4,'i32',3)])\n        ph=encode_struct([(1,'i32',0),(2,'i32',len(pd)),(3,'i32',len(pd)),(5,'struct',dph)])\n        chunk=ph+pd\n        out.write(chunk)\n        coff=offset; dpo=offset; tsize=len(chunk)\n        meta.append((header[j], col_types[j], col_pt[j], coff, dpo, tsize, num_rows))\n        offset+=tsize\n\n    schema=[ [(1,'binary',b'schema'),(4,'i32',0),(5,'i32',ncol)] ]\n    for j in range(ncol):\n        se=[(1,'binary',header[j].encode('utf-8')),(2,'i32',col_pt[j]),(4,'i32',0)]\n        if col_types[j]=='str':\n            se.append((6,'i32',0))\n        schema.append(se)\n\n    chunks=[]; total_size=0\n    for (name,ct,pt,coff,dpo,tsize,nval) in meta:\n        cm=[(1,'i32',pt),(2,'list',('i32',[0,3])),(3,'list',('binary',[name.encode('utf-8')])),\n            (4,'i32',0),(5,'i64',nval),(6,'i64',tsize),(7,'i64',tsize),(8,'i64',dpo)]\n        chunks.append([(1,'i64',coff),(3,'struct',cm)])\n        total_size+=tsize\n\n    rowgroup=[(1,'i64',total_size),(2,'list',('struct',chunks)),(3,'i64',num_rows)]\n    fm=encode_struct([(1,'i32',1),(2,'list',('struct',schema)),(3,'i64',num_rows),(4,'list',('struct',[rowgroup]))])\n    out.write(fm)\n    out.write(struct.pack('<I', len(fm)))\n    out.write(b'PAR1')\n    out.close()\n    print('wrote', OUT, 'rows=', num_rows, 'cols=', ncol, 'footer_bytes=', len(fm))\n\nmain()\nPYEOF\n"]
