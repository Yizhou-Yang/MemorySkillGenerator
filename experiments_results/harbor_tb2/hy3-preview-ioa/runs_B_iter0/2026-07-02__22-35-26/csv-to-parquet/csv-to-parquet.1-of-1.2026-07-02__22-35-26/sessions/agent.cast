[442.798653, "o", "    if not rows: sys.exit('empty csv')\r\n\u001b[?2004l\r\u001b[?2004h>     header=rows[0]; data=rows[1:]; ncol=len(header)\r\n\u001b[?2004l\r\u001b[?2004h>     def is_int(s):\r\n\u001b[?2004l\r\u001b[?2004h>         return s!='' and (s[0]=='-' or s[0].isdigit()) and s.lstrip('-').isdigit()\r\n\u001b[?2004l\r\u001b[?2004h>     col_types=[]; col_pt=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(ncol):\r\n\u001b[?2004l\r\u001b[?2004h>         vals=[r[j] if j<len(r) else '' for r in data]\r\n\u001b[?2004l\r\u001b[?2004h>         if vals and all(is_int(v) for v in vals):\r\n\u001b[?2004l\r\u001b[?2004h>             col_types.append('int'); col_pt.append(1)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             col_types.append('str'); col_pt.append(6)\r\n\u001b[?2004l\r\u001b[?2004h>     num_rows=len(data)\r\n\u001b[?2004l\r\u001b[?2004h>     def page_data(j):\r\n\u001b[?2004l\r\u001b[?2004h>         o=bytearray()\r\n\u001b[?2004l\r\u001b[?2004h>         if col_types[j]=='int':\r\n\u001b[?2004l\r\u001b[?2004h>             for r in data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[442.799074, "o", "                v=int(r[j]) if (j<len(r) and r[j]!='') else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[442.804374, "o", "> "]
[442.80467, "o", "                o.extend(struct.pack('<i', v))"]
