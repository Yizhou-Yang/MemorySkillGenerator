[606.898279, "i", "cat > /tmp/readparquet.py << 'PYEOF'\nimport csv, struct, sys\n\ndef rd_varint(b, p):\n    n=0; shift=0\n    while True:\n        x=b[p]; p+=1\n        n |= (x&0x7F)<<shift\n        if not (x&0x80): break\n        shift+=7\n    return n, p\n\ndef zz(n):\n    return (n>>1) ^ -(n&1)\n\ndef rd_value(b, p, t):\n    if t==1: return True, p\n    if t==2: return False, p\n    if t==3:\n        return (b[p]-256 if b[p]>=128 else b[p]), p+1\n    if t in (4,5,6):\n        v,p=rd_varint(b,p); return zz(v), p\n    if t==7:\n        return struct.unpack('<d', b[p:p+8])[0], p+8\n    if t==8:\n        n,p=rd_varint(b,p); return bytes(b[p:p+n]), p+n\n    if t==9:\n        return rd_list(b,p)\n    if t==12:\n        return rd_struct(b,p)\n    raise Exception('bad type %d'%t)\n\ndef rd_list(b, p):\n    h=b[p]; p+=1\n    if h==0: return [], p\n    et=h&0x0F; size=(h>>4)&0x0F\n    if size==15:\n        size,p=rd_varint(b,p)\n    out=[]\n    for _ in range(size):\n        v,p=rd_value(b,p,et); out.append(v)\n    return out, p\n\ndef rd_struct(b, p):\n    d={}; last=0\n    while True:\n        h=b[p]; p+=1\n        if h==0: break\n        ft=h&0x0F; dlt=(h>>4)&0x0F\n        if dlt==0:\n            fid,p=rd_varint(b,p); fid=zz(fid)\n        else:\n            fid=last+dlt\n        last=fid\n        v,p=rd_value(b,p,ft); d[fid]=v\n    return d, p\n\nb=open('/app/data.parquet','rb').read()\nfl=struct.unpack('<I', b[-8:-4])[0]\nfm, _ = rd_struct(b, len(b)-8-fl)\nschema=fm[2]            # list of SchemaElement dicts\nnum_rows=fm[3]\nrg=fm[4][0]             # first row group\ncols=rg[2]              # list of ColumnChunk dicts\nnames=[]; types=[]\nfor s in schema[1:]:\n    names.append(s[1].decode())\n    types.append(s[2])\nprint('schema:', list(zip(names,types)), 'num_rows=', num_rows)\nresult={}\nfor ci, cc in enumerate(cols):\n    cm=cc[3]\n    path=[x.decode() for x in cm[3]]\n    typ=cm[4]\n    dpo=cm[8]; tcs=cm[6]\n    ph, np = rd_struct(b, dpo)\n    upage=ph[2]; cpage=ph[3]\n    dph=ph[5]\n    nvals=dph[1]; enc=dph[2]\n    data=b[np:np+cpage]\n    dp=0; vals=[]\n    if typ==1:  # INT32\n        for _ in range(nvals):\n            vals.append(struct.unpack('<i', data[dp:dp+4])[0]); dp+=4\n    elif typ==6:  # BYTE_ARRAY\n        for _ in range(nvals):\n            ln=struct.unpack('<i', data[dp:dp+4])[0]; dp+=4\n            vals.append(data[dp:dp+ln].decode()); dp+=ln\n    else:\n        raise Exception('unhandled type %d'%typ)\n    result[path[0]]=vals\nprint('decoded:', result)\n# compare to CSV\nwith open('/app/data.csv', newline='') as f:\n    rows=list(csv.reader(f))\nph=rows[0][:len(names)]\nok=True\nfor j,name in enumerate(names):\n    expect=[r[j] if j<len(r) else '' for r in rows[1:]]\n    got=result[name]\n    if types[j]==1:\n        got=[str(x) for x in got]\n    if got!=expect:\n        ok=False; print('MISMATCH', name, 'got', got, 'exp', expect)\nprint('CSV header:', ph)\nprint('MATCH' if ok else 'FAILED')\nPYEOF\n"]
[606.903188, "o", "cat > /tmp/readparquet.py << 'PYEOF'\r\n\u001b[?2004l\rls):\r\n            vals.append(struct.unpack('<i', data[dp:dp+4])[0]); dp+=4\r\n    elif typ==6:  # BYTE_ARRAY\r\n        for _ in range(nvals):\r\n            ln=struct.unpack('<i', data[dp:dp+4])[0]; dp+=4\r\n            vals.append(data[dp:dp+ln].decode()); dp+=ln\r\n    else:\r\n        raise Exception('unhandled type %d'%typ)\r\n    result[path[0]]=vals\r\nprint('decoded:', result)\r\n# compare to CSV\r\nwith open('/app/data.csv', newline='') as f:\r\n    rows=list(csv.reader(f))\r\nph=rows[0][:len(names)]\r\nok=True\r\nfor j,name in enumerate(names):\r\n    expect=[r[j] if j<len(r) else '' for r in rows[1:]]\r\n    got=result[name]\r\n    if types[j]==1:\r\n        got=[str(x) for x in got]\r\n    if got!=expect:\r\n        ok=False; print('MISMATCH', name, 'got', got, 'exp', expect)\r\nprint('CSV header:', ph)\r\nprint('MATCH' if ok else 'FAILED')\r\nPYEOF\r\n\u001b[?2004h"]
