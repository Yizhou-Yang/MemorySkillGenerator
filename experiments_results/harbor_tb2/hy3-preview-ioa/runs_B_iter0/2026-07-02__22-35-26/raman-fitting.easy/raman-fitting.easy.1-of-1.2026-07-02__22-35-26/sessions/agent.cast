[188.851884, "i", "cat > peaks.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('graphene.dat', delimiter=None,\n                  converters={0: lambda s: float(s.replace(',','.')),\n                              1: lambda s: float(s.replace(',','.'))})\nx = data[:,0]; y = data[:,1]\n# local maxima (excluding edges)\nmask = (y[1:-1] > y[:-2]) & (y[1:-1] >= y[2:])\nidx = np.where(mask)[0] + 1\ntops = sorted(idx, key=lambda i: -y[i])[:15]\nprint('Top local maxima:')\nfor i in tops:\n    print(f'  x={x[i]:.2f}  y={y[i]:.2f}')\nprint('global max y at x=', x[np.argmax(y)], 'y=', y.max())\nEOF\npython3 peaks.py\n"]
