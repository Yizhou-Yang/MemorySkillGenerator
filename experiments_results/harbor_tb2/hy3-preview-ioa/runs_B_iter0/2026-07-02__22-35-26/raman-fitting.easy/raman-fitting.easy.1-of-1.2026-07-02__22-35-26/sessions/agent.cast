[232.556934, "o", "\u001b[?2004hroot@f753479266fc:/app# "]
[416.264002, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.loadtxt('graphene.dat', delimiter=None,\n                  converters={0: lambda s: float(s.replace(',','.')),\n                              1: lambda s: float(s.replace(',','.'))})\nx = data[:,0]; y = data[:,1]\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp*gamma**2/((x - x0)**2 + gamma**2)\n\ndef fit(xc, half):\n    lo, hi = xc - half, xc + half\n    m = (x >= lo) & (x <= hi)\n    xw, yw = x[m], y[m]\n    off0 = np.percentile(yw, 10)\n    amp0 = yw.max() - off0\n    x00 = xw[np.argmax(yw)]\n    g0 = (hi - lo) * 0.03\n    popt, pcov = curve_fit(lor, xw, yw, p0=[x00, g0, amp0, off0],\n                          bounds=([lo, 0, 0, off0 - amp0],\n                                  [hi, hi - lo, 2*amp0, off0 + amp0]),\n                          maxfev=200000)\n    return popt, (lo, hi)\n\npoptG, wG = fit(19139.0, 1500.0)\npopt2D, w2D = fit(33244.0, 1600.0)\nprint('G native  :', poptG)\nprint('2D native :', popt2D)\n\nscale = popt"]
[416.264063, "i", "G[0] / 1580.0\nprint('scale (native/cm-1) =', scale)\nprint('G  cm-1 x0 =', poptG[0]/scale, ' gamma =', poptG[1]/scale)\nprint('2D cm-1 x0 =', popt2D[0]/scale, ' gamma =', popt2D[1]/scale)\n\nres = {\n  'G': {\n    'x0': poptG[0]/scale,\n    'gamma': poptG[1]/scale,\n    'amplitude': poptG[2],\n    'offset': poptG[3],\n  },\n  '2D': {\n    'x0': popt2D[0]/scale,\n    'gamma': popt2D[1]/scale,\n    'amplitude': popt2D[2],\n    'offset': popt2D[3],\n  },\n}\nprint(json.dumps(res, indent=2))\nwith open('results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint('written results.json')\nEOF\npython3 fit.py\n"]
[416.264187, "o", "cat > fit.py << 'EOF'\r\n\u001b[?2004l\r"]
