[232.271878, "i", "cat > peaks2.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('graphene.dat', delimiter=None,\n                  converters={0: lambda s: float(s.replace(',','.')),\n                              1: lambda s: float(s.replace(',','.'))})\nx = data[:,0]; y = data[:,1]\nmask = (y[1:-1] > y[:-2]) & (y[1:-1] >= y[2:])\nidx = np.where(mask)[0] + 1\nprint('num local maxima:', len(idx))\nfor i in idx:\n    print(f'  x={x[i]:10.3f}  y={y[i]:10.2f}')\nEOF\npython3 peaks2.py\n"]
