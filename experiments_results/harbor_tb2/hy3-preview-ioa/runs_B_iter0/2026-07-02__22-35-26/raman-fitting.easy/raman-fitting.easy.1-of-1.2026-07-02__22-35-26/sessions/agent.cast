[160.67312, "i", "cat > explore.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('graphene.dat', delimiter=None, converters={0: lambda s: float(s.decode().replace(',','.')), 1: lambda s: float(s.decode().replace(',','.'))})\nx = data[:,0]; y = data[:,1]\nprint('shape', data.shape)\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\n# check for G ~1580 and 2D ~2700\nfor target in [1580, 2700]:\n    idx = np.argmin(np.abs(x-target))\n    print('target', target, '-> x=', x[idx], 'y=', y[idx])\nEOF\npython3 explore.py\n"]
