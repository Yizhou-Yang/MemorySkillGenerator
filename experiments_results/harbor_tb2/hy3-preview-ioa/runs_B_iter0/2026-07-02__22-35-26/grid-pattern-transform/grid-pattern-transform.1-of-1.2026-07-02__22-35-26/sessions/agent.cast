[76.271553, "i", "cat > /app/grid_transform.py << 'EOF'\nimport numpy as np\n\ndef solve(input_grid):\n    \"\"\"\n    Transform the input grid according to the pattern.\n\n    Args:\n        input_grid (List[List[int]]): 2D list of integers representing the input grid\n            0: Black     1: Blue       2: Red        3: Green     4: Yellow\n            5: Grey      6: Hot Pink   7: Orange     8: Light Blue 9: Maroon\n\n    Returns:\n        List[List[int]]: 2D list of integers representing the transformed grid\n    \"\"\"\n    a, b = input_grid[0][0], input_grid[0][1]\n    c, d = input_grid[1][0], input_grid[1][1]\n\n    # Original 2x2 tile\n    O = [[a, b], [c, d]]\n    # Tile rotated 90 degrees clockwise\n    R = [[c, a], [d, b]]\n\n    output_grid = []\n    for r in range(6):\n        rblk = r // 2\n        src = O if rblk % 2 == 0 else R\n        lr = r % 2\n        row = [src[lr][col % 2] for col in range(6)]\n        output_grid.append(row)\n\n    return output_grid\nEOF\n"]
[76.27744, "o", "cat > /app/grid_transform.py << 'EOF'"]
