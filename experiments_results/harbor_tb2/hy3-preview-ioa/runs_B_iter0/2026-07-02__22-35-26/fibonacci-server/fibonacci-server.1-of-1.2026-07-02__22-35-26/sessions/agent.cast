[58.134198, "i", "cat > /app/fib_server.py << 'EOF'\nimport json\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\n\ndef fib(n):\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != \"/fib\":\n            self.send_response(404)\n            self.send_header(\"Content-Type\", \"application/json\")\n            self.end_headers()\n            self.wfile.write(json.dumps({\"error\": \"not found\"}).encode())\n            return\n        qs = parse_qs(parsed.query)\n        if \"n\" not in qs:\n            self.send_error(400, \"Missing query parameter 'n'\")\n            return\n        raw = qs[\"n\"][0]\n        try:\n            n = int(raw)\n        except (ValueError, TypeError):\n            self.send_error(400, \"Query parameter 'n' must be an integer\")\n            return\n        try:\n            result = fib(n)\n        except ValueError:\n            self.send_error(400, \"Query parameter 'n' must be a non-negative integer\")\n            return\n        body = json.dumps({\"result\": result}).encode()\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def log_message(self, *args):\n        pass\n\n\ndef main():\n    server = ThreadingHTTPServer((\"0.0.0.0\", 3000), Handler)\n    server.serve_forever()\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
