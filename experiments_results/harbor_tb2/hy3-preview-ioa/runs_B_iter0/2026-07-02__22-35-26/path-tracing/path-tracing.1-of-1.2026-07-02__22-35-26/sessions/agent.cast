[46.82293, "i", "cat > /tmp/analyze.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nimg = np.array(Image.open('image.ppm'))\nprint('shape', img.shape, 'dtype', img.dtype)\nprint('unique colors approx', len(np.unique(img.reshape(-1,3),axis=0)))\nprint('min', img.min(axis=(0,1)), 'max', img.max(axis=(0,1)))\nprint('mean', img.mean(axis=(0,1)))\n# check first row and column\nprint('first row first 10 px', img[0,:10])\nprint('last row first 10 px', img[-1,:10])\n# check smoothness: gradient magnitude\nprint('row grad mean', np.abs(np.diff(img,axis=1)).mean())\nprint('col grad mean', np.abs(np.diff(img,axis=0)).mean())\n# symmetry check\nprint('horizontal flip diff', np.abs(img - img[:,::-1]).mean())\nprint('vertical flip diff', np.abs(img - img[::-1]).mean())\nEOF\n.venv/bin/python /tmp/analyze.py\n"]
[46.823206, "o", "cat > /tmp/analyze.py << 'EOF'\r\n\u001b[?2004l\r"]
