[345.572386, "o", "\r\n"]
[345.572676, "o", "    - echo 'export PATH=\"$HOME/miniconda3/bin/:$PATH\"' >> ~/.bashrc\r\n    # if you have AWS CREDS fill them out here\r\n    - echo 'export AWS_ACCESS_KEY_ID=AKIA1234567890123456' >> ~/.bashrc\r\n    - echo 'export AWS_SECRET_ACCESS_KEY=D4w8z9wKN1aVeT3BpQj6kIuN7wH8X0M9KfV5OqzF' >> ~/.bashrc"]
[345.572792, "o", "\r\n"]
[345.572943, "o", "    - pip install --upgrade pip setuptools wheel"]
[345.573189, "o", "\r\n"]
[345.573385, "o", "    - pip install -U \"ray[default] @ https://s3-us-west-2.amazonaws.com/ray-wheels/latest/ray-3.0.0.dev0-cp310-cp310-manylinux2014_x86_64.whl\""]
[345.573578, "o", "\r\n"]
