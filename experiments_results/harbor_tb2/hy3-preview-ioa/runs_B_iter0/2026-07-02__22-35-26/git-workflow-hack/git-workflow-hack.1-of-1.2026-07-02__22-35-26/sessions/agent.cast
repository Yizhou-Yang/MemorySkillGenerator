[137.06742, "i", "cat > index.html << 'EOF'\n<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width,initial-scale=1'>\n<title>Dr. Lydia Moreno — Research Profile</title>\n<link rel='stylesheet' href='assets/style.css'>\n</head>\n<body>\n<header class='site-header'>\n  <div class='container'>\n    <div class='brand'>Lydia <span>Moreno</span></div>\n    <nav class='nav'>\n      <a href='index.html' class='active'>About Me</a>\n      <a href='blog.html'>Blog</a>\n      <a href='publications.html'>Publications</a>\n    </nav>\n  </div>\n</header>\n<main>\n  <div class='container'>\n    <section class='hero'>\n      <h1>Dr. Lydia Moreno</h1>\n      <p class='role'>Associate Professor of Computational Neuroscience · Riverbend University</p>\n      <p class='lede'>My work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information.</p>\n      <p>\n        <span class='tag'>Machine Learning</span>\n        <span class='tag'>Systems Neuroscience</span>\n        <span class='tag'>Bioinformatics</span>\n        <span class='tag'>Explainable AI</span>\n      </p>\n      <p style='margin-top:18px;'><a class='btn' href='publications.html'>View Publications</a></p>\n    </section>\n    <section>\n      <h2>About</h2>\n      <p>I received my Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center. I lead a research group focused on building interpretable models that connect neural data to behavior.</p>\n    </section>\n    <section>\n      <h2>Education</h2>\n      <ul class='clean'>\n        <li>\n          <h3>Ph.D., Computational Biology</h3>\n          <p class='sub'>Baywood Institute of Technology, 2014–2019</p>\n          <p>Dissertation: Deep Learning Models for Decoding Neural Population Activity</p>\n        </li>\n        <li>\n          <h3>M.Sc., Bioinformatics</h3>\n          <p class='sub'>Riverbend University, 2012–2014</p>\n          <p>Thesis: Statistical Methods for Single-Cell RNA-Seq Analysis</p>\n        </li>\n        <li>\n          <h3>B.Sc., Computer Science</h3>\n          <p class='sub'>Crestfield College of Engineering, 2008–2012</p>\n          <p>Graduated magna cum laude; President, Data Science Club</p>\n        </li>\n      </ul>\n    </section>\n    <section>\n      <h2>Research Interests</h2>\n      <div class='cards'>\n        <div class='card'><h3>Neural Encoding &amp; Decoding</h3><p>Interpretable models translating spike-train data into behavioral predictions.</p></div>\n        <div class='card'><h3>ML for Biomedical Imaging</h3><p>CNNs and GNNs applied to MRI and two-photon microscopy data.</p></div>\n        <div class='card'><h3>Single-Cell Omics</h3><p>Scalable pipelines integrating multi-modal single-cell genomics.</p></div>\n        <div class='card'><h3>Explainable AI</h3><p>Frameworks to probe decision boundaries in black-box models.</p></div>\n      </div>\n    </section>\n    <section>\n      <h2>Selected Projects</h2>\n      <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\n      <p class='sub'>Lead Developer &amp; Project Coordinator</p>\n      <p>PyTorch-based pipeline to segment two-photon images of mouse visual cortex; temporal convolutional networks predict stimulus orientation from calcium-imaging traces. Deployed as a Dockerized microservice with Cascade Imaging Lab.</p>\n      <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\n      <p class='sub'>Principal Investigator</p>\n      <p>Graph representations of reconstructed neuron meshes from EM; GNNs classify synapse types. Open-source toolkit adopted by 12 labs.</p>\n      <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\n      <p class='sub'>Co-Principal Investigator</p>\n      <p>Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH; Bayesian clustering of human cortical organoids.</p>\n    </section>\n    <section>\n      <h2>Skills &amp; Tools</h2>\n      <p>\n        <span class='tag'>Python"]
[137.068318, "i", "</span><span class='tag'>R</span><span class='tag'>C++</span>\n        <span class='tag'>PyTorch</span><span class='tag'>TensorFlow</span><span class='tag'>scikit-learn</span>\n        <span class='tag'>Nextflow</span><span class='tag'>Docker</span><span class='tag'>Kubernetes</span>\n        <span class='tag'>Scanpy</span><span class='tag'>D3.js</span>\n      </p>\n    </section>\n    <section class='contact'>\n      <h2>Contact</h2>\n      <p><a href='mailto:lydia.moreno@riverbend.edu'>lydia.moreno@riverbend.edu</a></p>\n      <p>Office: Blakely Hall, Room 312, Riverbend University</p>\n      <p><a href='https://twitter.com/LydiaNeuroLab'>Twitter</a> · <a href='https://github.com/lydia-moreno'>GitHub</a></p>\n    </section>\n  </div>\n</main>\n<footer class='footer'>\n  <div class='container'>© 2025 Dr. Lydia Moreno · Riverbend University</div>\n</footer>\n</body>\n</html>\nEOF\n"]
