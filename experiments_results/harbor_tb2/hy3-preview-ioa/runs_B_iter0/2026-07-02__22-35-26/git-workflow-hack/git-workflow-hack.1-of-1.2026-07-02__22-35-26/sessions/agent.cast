[137.497874, "i", "cat > publications.html << 'EOF'\n<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width,initial-scale=1'>\n<title>Publications — Lydia Moreno</title>\n<link rel='stylesheet' href='assets/style.css'>\n</head>\n<body>\n<header class='site-header'>\n  <div class='container'>\n    <div class='brand'>Lydia <span>Moreno</span></div>\n    <nav class='nav'>\n      <a href='index.html'>About Me</a>\n      <a href='blog.html'>Blog</a>\n      <a href='publications.html' class='active'>Publications</a>\n    </nav>\n  </div>\n</header>\n<main>\n  <div class='container'>\n    <section class='hero'>\n      <h1>Publications</h1>\n      <p class='lede'>Selected peer-reviewed articles.</p>\n    </section>\n    <section>\n      <h2>Selected Publications</h2>\n      <div class='publication'>\n        <p class='title'>Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals</p>\n        <p class='venue'>Moreno, L., &amp; Patel, A. (2024). Journal of Computational Neuroscience, 45(2), 123–137.</p>\n      </div>\n      <div class='publication'>\n        <p class='title'>Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets</p>\n        <p class='venue'>Moreno, L., Zhang, W., &amp; Singh, R. (2023). Neuroinformatics, 21(4), 299–312.</p>\n      </div>\n      <div class='publication'>\n        <p class='title'>Integrative Single-Cell Atlas of Human Cerebral Organoids</p>\n        <p class='venue'>Moreno, L. et al. (2022). Cell Systems, 9(1), 67–82.</p>\n      </div>\n      <div class='publication'>\n        <p class='title'>Explainable AI Techniques in Neural Decoding</p>\n        <p class='venue'>Chen, J., Moreno, L., &amp; Russo, M. (2021). Frontiers in Neuroscience, 15, 756843.</p>\n      </div>\n    </section>\n  </div>\n</main>\n<footer class='footer'>\n  <div class='container'>© 2025 Dr. Lydia Moreno · Riverbend University</div>\n</footer>\n</body>\n</html>\nEOF\n"]
