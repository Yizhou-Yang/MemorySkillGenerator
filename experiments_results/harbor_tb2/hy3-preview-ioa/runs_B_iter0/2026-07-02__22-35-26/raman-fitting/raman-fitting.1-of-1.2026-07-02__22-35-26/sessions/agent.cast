[439.405345, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[439.40547, "o", "pg = fit_peak(xg, yg, p0g)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.405613, "o", "res_g = yg - lor(xg, *pg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.405766, "o", "print('G  fit:', ['%.3f'%v for v in pg])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.405865, "o", "print('G  RMS residual: %.3f  n=%d'%(np.sqrt(np.mean(res_g**2)), len(xg)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.405911, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.406064, "o", "# 2D region around x~19139\r\n\u001b[?2004l\r\u001b[?2004h"]
[439.406163, "o", "> tm = (x>15000)&(x<23500)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.40634, "o", "x2, y2 = x[tm], y[tm]\r\n\u001b[?2004l\r\u001b[?2004h> p02=[19139, 1000, 70000, 20000]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.406416, "o", "p2 = fit_peak(x2, y2, p02)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.406501, "o", "res_2 = y2 - lor(x2, *p2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.406754, "o", "print('2D fit:', ['%.3f'%v for v in p2])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.406869, "o", "print('2D RMS residual: %.3f  n=%d'%(np.sqrt(np.mean(res_2**2)), len(x2)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.406943, "o", "EOF\r\n\u001b[?2004l\r"]
[439.41034, "o", "\u001b[?2004hroot@ce8d948da412:/app# "]
