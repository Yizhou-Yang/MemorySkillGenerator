[307.67698, "i", "cat > /app/findpks.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\nd = np.loadtxt('/app/graphene.dat', delimiter=None,\n              converters={0: lambda s: float(s.replace(',','.')),\n                          1: lambda s: float(s.replace(',','.'))})\nx = d[:,0]; y = d[:,1]\norder = np.argsort(x); x=x[order]; y=y[order]\ndef smooth(yy,k):\n    k=min(k, (len(yy)//2)|1)\n    return np.convolve(yy, np.ones(k)/k, mode='same')\nys = smooth(y,41)\npk, props = find_peaks(ys, prominence=ys.max()*0.02)\nprom = props['prominences']\norder_p = np.argsort(prom)[::-1]\nprint('num peaks', len(pk))\nfor j in order_p[:8]:\n    i = pk[j]\n    print('x=%.1f  y=%.1f  prom=%.1f'%(x[i], y[i], prom[j]))\nEOF\npython3 /app/findpks.py\n"]
[307.677622, "o", "cat > /app/findpks.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
