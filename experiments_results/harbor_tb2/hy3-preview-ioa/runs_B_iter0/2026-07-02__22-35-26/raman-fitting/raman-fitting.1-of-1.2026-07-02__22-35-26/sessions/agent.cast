[161.614112, "i", "cat > /app/peaks.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/graphene.dat', delimiter=None,\n              converters={0: lambda s: float(s.replace(',','.')),\n                          1: lambda s: float(s.replace(',','.'))})\nx = d[:,0]; y = d[:,1]\n# sort ascending by x for clarity\norder = np.argsort(x)\nx = x[order]; y = y[order]\nprint('x ascending range', x.min(), x.max())\nbaseline = np.median(y)\nprint('median baseline', baseline)\n# smooth\nk = 9\nys = np.convolve(y, np.ones(k)/k, mode='same')\n# find connected regions above 1.3*baseline\nthr = baseline*1.3\nabove = ys > thr\nidx = np.where(above)[0]\nif len(idx)==0:\n    print('no region above threshold')\nelse:\n    # group consecutive\n    groups=[]\n    start=idx[0]; prev=idx[0]\n    for i in idx[1:]:\n        if i==prev+1:\n            prev=i\n        else:\n            groups.append((start,prev)); start=i; prev=i\n    groups.append((start,prev))\n    print('num groups', len(groups))\n    for g in groups:\n        a,b=g\n        seg_y=y[a:b+1]; seg_x=x[a:b+1]\n        "]
[161.614207, "i", "j=int(np.argmax(seg_y))\n        print('center x=%.1f  ymax=%.1f  width_idx=%d  xspan=%.1f..%.1f'%(seg_x[j], seg_y.max(), b-a, seg_x[0], seg_x[-1]))\nEOF\npython3 /app/peaks.py\n"]
