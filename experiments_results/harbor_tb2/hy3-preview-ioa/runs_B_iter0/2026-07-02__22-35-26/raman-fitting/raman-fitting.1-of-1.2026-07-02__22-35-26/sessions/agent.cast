[488.607173, "i", "cat > /app/diag2.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/graphene.dat', delimiter=None,\n              converters={0: lambda s: float(s.replace(',','.')),\n                          1: lambda s: float(s.replace(',','.'))})\nx=d[:,0]; y=d[:,1]\norder=np.argsort(x); x=x[order]; y=y[order]\nfor lo,hi,name in [(3450,4050,'G'),(18200,20100,'2D')]:\n    m=(x>=lo)&(x<=hi)\n    xs=x[m]; ys=y[m]\n    print('===',name,'n=',len(xs),'===')\n    # print every other point\n    for i in range(0,len(xs),2):\n        print('x=%.1f y=%.1f'%(xs[i],ys[i]))\nEOF\npython3 /app/diag2.py\n"]
