[78.160811, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/graphene.dat', delimiter=None, converters={0: lambda s: float(s.decode().replace(',','.')), 1: lambda s: float(s.decode().replace(',','.'))})\nx = d[:,0]; y = d[:,1]\nprint('x range', x.min(), x.max(), 'n', len(x))\nprint('monotonic decreasing?', np.all(np.diff(x) < 0))\n# local maxima\nmaxs = []\nfor i in range(1, len(x)-1):\n    if y[i] > y[i-1] and y[i] >= y[i+1]:\n        maxs.append((y[i], x[i], i))\nmaxs.sort(reverse=True)\nprint('top 15 local maxima (intensity, x, idx):')\nfor m in maxs[:15]:\n    print(m)\nEOF\npython3 /app/explore.py\n"]
