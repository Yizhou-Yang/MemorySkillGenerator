[439.402482, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef load():\n    d = np.loadtxt('/app/graphene.dat', delimiter=None,\n                  converters={0: lambda s: float(s.replace(',','.')),\n                              1: lambda s: float(s.replace(',','.'))})\n    return d[:,0], d[:,1]\n\nx, y = load()\norder = np.argsort(x); x=x[order]; y=y[order]\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp*gamma**2/((x-x0)**2 + gamma**2)\n\ndef fit_peak(xc, yc, p0):\n    popt, pcov = curve_fit(lor, xc, yc, p0=p0, maxfev=400000)\n    return popt\n\n# G region around x~3747\ngm = (x>2900)&(x<4600)\nxg, yg = x[gm], y[gm]\np0g=[3747, 300, 11000, 1500]\npg = fit_peak(xg, yg, p0g)\nres_g = yg - lor(xg, *pg)\nprint('G  fit:', ['%.3f'%v for v in pg])\nprint('G  RMS residual: %.3f  n=%d'%(np.sqrt(np.mean(res_g**2)), len(xg)))\n\n# 2D region around x~19139\ntm = (x>15000)&(x<23500)\nx2, y2 = x[tm], y[tm]\np02=[19139, 1000, 70000, 20000]\np2 = fit_peak(x2, y2, p02)\nres_2 = y2 - lor(x2, *p2)\nprint('2D fit:', ['%.3f"]
[439.402559, "i", "'%v for v in p2])\nprint('2D RMS residual: %.3f  n=%d'%(np.sqrt(np.mean(res_2**2)), len(x2)))\nEOF\npython3 /app/fit.py\n"]
