[439.404316, "o", "def lor(x, x0, gamma, amp, off):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.404461, "o", "    return off + amp*gamma**2/((x-x0)**2 + gamma**2)\r\n\u001b[?2004l\r\u001b[?2004h"]
