[534.600413, "i", "cat > /app/fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/graphene.dat', delimiter=None,\n              converters={0: lambda s: float(s.replace(',','.')),\n                          1: lambda s: float(s.replace(',','.'))})\nx=d[:,0]; y=d[:,1]\norder=np.argsort(x); x=x[order]; y=y[order]\n\ndef lor(x,x0,g,a,off):\n    return off + a*g*g/((x-x0)**2 + g*g)\n\nbounds=([0,0,0,-1e9],[1e6,1e6,1e9,1e9])\n\ndef fit(x0g, win, p0):\n    m=(x>=x0g-win)&(x<=x0g+win)\n    xc,yc=x[m],y[m]\n    popt,_=curve_fit(lor,xc,yc,p0=p0,bounds=bounds,maxfev=400000)\n    r=lor(xc,*popt)-yc\n    print('win=%4d  x0=%.2f gamma=%.2f amp=%.2f off=%.2f  rms=%.1f n=%d'%(win,*popt,np.sqrt(np.mean(r**2)),len(xc)))\n    return popt\n\nprint('--- G peak (x0~3747) ---')\nfor w in [80,120,160,200]:\n    fit(3747,w,[3747,33,11700,1500])\nprint('--- 2D peak (x0~19198) ---')\nfor w in [400,600,800,1000]:\n    fit(19198,w,[19198,385,72700,14000])\nEOF\npython3 /app/fit2.py\n"]
[534.600884, "o", "cat > /app/fit2.py << 'EOF'"]
