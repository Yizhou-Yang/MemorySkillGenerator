[200.139036, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/graphene.dat', delimiter=None,\n              converters={0: lambda s: float(s.replace(',','.')),\n                          1: lambda s: float(s.replace(',','.'))})\nx = d[:,0]; y = d[:,1]\norder = np.argsort(x); x=x[order]; y=y[order]\nprint('percentiles y:', np.percentile(y,[1,5,25,50,75,95,99]))\nprint('min,max y:', y.min(), y.max())\n# sample 30 evenly spaced points in index\nfor i in np.linspace(0,len(x)-1,30).astype(int):\n    print('x=%.1f y=%.1f'%(x[i],y[i]))\nEOF\npython3 /app/diag.py\n"]
