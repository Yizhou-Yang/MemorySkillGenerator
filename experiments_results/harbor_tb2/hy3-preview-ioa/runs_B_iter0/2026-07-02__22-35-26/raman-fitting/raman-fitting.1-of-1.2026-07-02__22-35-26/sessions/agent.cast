[641.636101, "i", "cat > /app/final_fit.py << 'EOF'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/graphene.dat', delimiter=None,\n              converters={0: lambda s: float(s.replace(',','.')),\n                          1: lambda s: float(s.replace(',','.'))})\nx=d[:,0]; y=d[:,1]\norder=np.argsort(x); x=x[order]; y=y[order]\n\ndef lor(x,x0,g,a,off):\n    return off + a*g*g/((x-x0)**2 + g*g)\n\nbounds=([0,0,0,-1e9],[1e6,1e6,1e9,1e9])\n\ndef fit_peak(x0, win, p0):\n    m=(x>=x0-win)&(x<=x0+win)\n    xc,yc=x[m],y[m]\n    popt,_=curve_fit(lor,xc,yc,p0=p0,bounds=bounds,maxfev=400000)\n    return popt, xc, yc\n\ndef do_fit(name, x0, win0, p0):\n    win=win0\n    for it in range(4):\n        popt,xc,yc=fit_peak(x0,win,p0)\n        x0n=popt[0]; g=popt[1]\n        new_win=3.0*g\n        if abs(new_win-win)<0.5*g:\n            win=new_win; break\n        win=new_win; x0=x0n\n    popt,xc,yc=fit_peak(x0,win,p0)\n    model=lor(xc,*popt)\n    rms=np.sqrt(np.mean((model-yc)**2))\n    amp_above=popt[2]\n    print('%s: x0=%.3f gamma="]
[641.636318, "i", "%.3f amp=%.3f off=%.3f  rms=%.2f rms/amp=%.4f win=%.1f n=%d'%(name,*popt,rms,rms/max(amp_above,1e-9),win,len(xc)))\n    return popt\n\npg=do_fit('G ', 3747, 150, [3747,25,12500,1000])\np2=do_fit('2D', 19198, 1200, [19198,470,80000,10000])\n\nres={\n  'G':{'x0':float(pg[0]),'gamma':float(pg[1]),'amplitude':float(pg[2]),'offset':float(pg[3])},\n  '2D':{'x0':float(p2[0]),'gamma':float(p2[1]),'amplitude':float(p2[2]),'offset':float(p2[3])}\n}\nwith open('/app/results.json','w') as f:\n    json.dump(res,f,indent=2)\nprint('WROTE /app/results.json')\nprint(json.dumps(res,indent=2))\nEOF\npython3 /app/final_fit.py\n"]
[641.636703, "o", "cat > /app/final_fit.py << 'EOF'"]
