[30.724625, "o", "def parse_date(s):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.726328, "o", "    s = s.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     s = re.sub(r'\\s+\\d{2}:\\d{2}:\\d{2}.*$', '', s)\r\n\u001b[?2004l\r\u001b[?2004h>     for fmt in ('%Y-%m-%d', '%m/%d/%Y', '%m-%d-%Y'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             return datetime.strptime(s, fmt).strftime('%Y-%m-%d')\r\n\u001b[?2004l\r\u001b[?2004h>         except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h>     raise ValueError('unparseable date: ' + s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> high, low = {}, {}\r\n\u001b[?2004l\r\u001b[?2004h> with open('daily_temp_sf_high.csv') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for row in csv.reader(f):\r\n\u001b[?2004l\r\u001b[?2004h>         if row and row[0]!='date':\r\n\u001b[?2004l\r\u001b[?2004h>             high[parse_date(row[0])] = float(row[1])"]
[30.736013, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> with open('daily_temp_sf_low.csv') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for row in csv.reader(f):\r\n\u001b[?2004l\r\u001b[?2004h>         if row and row[0]!='date':\r\n\u001b[?2004l\r\u001b[?2004h>             low[parse_date(row[0])] = float(row[1])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> diffs = [high[d]-low[d] for d in high if d in low]\r\n\u001b[?2004l\r\u001b[?2004h> avg = sum(diffs)/len(diffs)\r\n\u001b[?2004l\r\u001b[?2004h> print('matched', len(diffs), 'avg', avg)\r\n\u001b[?2004l\r\u001b[?2004h> with open('avg_temp.txt','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write(f'{avg}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
