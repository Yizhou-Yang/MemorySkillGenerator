[30.722568, "i", "python3 - <<'EOF'\nimport csv, re\nfrom datetime import datetime\n\ndef parse_date(s):\n    s = s.strip()\n    s = re.sub(r'\\s+\\d{2}:\\d{2}:\\d{2}.*$', '', s)\n    for fmt in ('%Y-%m-%d', '%m/%d/%Y', '%m-%d-%Y'):\n        try:\n            return datetime.strptime(s, fmt).strftime('%Y-%m-%d')\n        except ValueError:\n            pass\n    raise ValueError('unparseable date: ' + s)\n\nhigh, low = {}, {}\nwith open('daily_temp_sf_high.csv') as f:\n    for row in csv.reader(f):\n        if row and row[0]!='date':\n            high[parse_date(row[0])] = float(row[1])\nwith open('daily_temp_sf_low.csv') as f:\n    for row in csv.reader(f):\n        if row and row[0]!='date':\n            low[parse_date(row[0])] = float(row[1])\n\ndiffs = [high[d]-low[d] for d in high if d in low]\navg = sum(diffs)/len(diffs)\nprint('matched', len(diffs), 'avg', avg)\nwith open('avg_temp.txt','w') as f:\n    f.write(f'{avg}')\nEOF\n"]
[30.723286, "o", "python3 - <<'EOF'"]
