[848.109833, "o", "localhost:~# \u001b[6necho 'root:password123' | chpasswd; echo __OK__$?\r\r\nmodprobe e1000 2>/dev/null; true; echo __OK__$?\r\r\nip link set eth0 up; echo __OK__$?\r\r\nudhcpc -i eth0 -t 10 -n; echo __OK__$?\r\r\napk add openssh; echo __OK__$?\r\r\nssh-keygen -A; echo __OK__$?\r\r\n/usr/sbin/sshd -o PermitRootLogin=yes -o PasswordAuthentication=yes; echo __OK__$?\r\r\nip -4 addr show eth0; echo __OK__$?\r\r\nss -ltn 2>/dev/null | grep ':22 '; echo __OK__$?\r\r\n"]
