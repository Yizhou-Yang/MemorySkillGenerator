[399.504993, "i", "cat > /tmp/unpack.py << 'EOF'\nimport os, gzip, struct\nsrc='/app/extracted/initramfs_lts'\ndata=open(src,'rb').read()\nif data[:2]==b'\\x1f\\x8b':\n    data=gzip.decompress(data); print('gzip decompressed to',len(data))\nelse:\n    print('not gzip, using raw',len(data))\nos.makedirs('/tmp/ir',exist_ok=True)\ni=0\nwhile i < len(data):\n    if data[i:i+6] not in (b'070701',b'070702'):\n        # skip until magic\n        i+=1; continue\n    hdr=data[i:i+110]\n    names=['c_ino','c_mode','c_uid','c_gid','c_nlink','c_mtime','c_filesize','c_devmajor','c_devminor','c_rdevmajor','c_rdevminor','c_namesize','c_check']\n    vals={}; off=6\n    for n in names:\n        vals[n]=int(hdr[off:off+8],16); off+=8\n    name=data[i+110:i+110+vals['c_namesize']].rstrip(b'\\x00').decode('latin1')\n    dstart=i+110+vals['c_namesize']\n    dstart=(dstart+3)&~3\n    size=vals['c_filesize']\n    body=data[dstart:dstart+size]\n    nxt=dstart+((size+3)&~3)\n    if name=='TRAILER!!!':\n        break\n    if name:\n    "]
