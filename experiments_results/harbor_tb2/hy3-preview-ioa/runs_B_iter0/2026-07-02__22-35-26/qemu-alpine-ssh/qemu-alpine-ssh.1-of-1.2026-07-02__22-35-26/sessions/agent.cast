[559.606827, "i", "cat > /app/setup.exp << 'EOF'\n#!/usr/bin/expect -f\nset timeout 600\nspawn nc 127.0.0.1 4555\nlog_file /app/serial.log\nexpect {\n  -re \"login:\" { send \"root\\r\"; exp_continue }\n  -re \"# \" { }\n  timeout { puts \"NO PROMPT\"; exit 1 }\n}\nproc run {c} {\n  send \"$c; echo __OK__\\$?\\r\"\n  expect {\n    \"__OK__\" { }\n    timeout { puts \"TIMEOUT: $c\"; exit 1 }\n  }\n}\nrun \"echo 'root:password123' | chpasswd\"\nrun \"modprobe e1000 2>/dev/null; true\"\nrun \"ip link set eth0 up\"\nrun \"udhcpc -i eth0 -t 10 -n\"\nrun \"apk add openssh\"\nrun \"ssh-keygen -A\"\nrun \"/usr/sbin/sshd -o PermitRootLogin=yes -o PasswordAuthentication=yes\"\nrun \"ip -4 addr show eth0\"\nrun \"ss -ltn 2>/dev/null | grep ':22 '\"\nputs \"SETUP_COMPLETE\"\nexit 0\nEOF\n"]
