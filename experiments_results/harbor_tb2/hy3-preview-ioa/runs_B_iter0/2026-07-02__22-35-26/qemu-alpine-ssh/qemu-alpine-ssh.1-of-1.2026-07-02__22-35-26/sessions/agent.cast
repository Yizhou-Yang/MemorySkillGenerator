[291.161535, "i", "cat > /tmp/extract.py << 'EOF'\nimport sys, struct, os\nsys.setrecursionlimit(100000)\nSECTOR=2048\nISO='/app/alpine.iso'\ndef parse_dr(d):\n    if len(d)<34: return None\n    if d[0]==0: return None\n    ext=struct.unpack('<I',d[2:6])[0]; dlen=struct.unpack('<I',d[10:14])[0]\n    flags=d[25]; nl=d[32]; name=d[33:33+nl].split(b';')[0].decode('latin1')\n    return {'ext':ext,'dlen':dlen,'is_dir':bool(flags&2),'name':name}\ndef read_dir(f,lba,length):\n    recs=[]; off=0\n    while off<length:\n        f.seek(lba*SECTOR+off)\n        try: rl=f.read(1)[0]\n        except: break\n        if rl==0: off=(off//SECTOR+1)*SECTOR; continue\n        f.seek(lba*SECTOR+off); rec=f.read(rl); dr=parse_dr(rec)\n        if dr: recs.append(dr)\n        off+=rl\n    return recs\nf=open(ISO,'rb'); f.seek(16*SECTOR)\npvd=f.read(SECTOR); root=parse_dr(pvd[156:156+34])\nresults=[]; visited=set()\ndef walk(e,p):\n    for dr in e:\n        if dr['name'] in ('.','..') or dr['ext'] in visited: continue\n        full"]
