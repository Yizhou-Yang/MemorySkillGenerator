[744.77507, "o", "Welcome to Alpine Linux 3.19\r\r\r\n\rKernel 6.6.4-1-lts on an x86_64 (/dev/ttyS0)\r\r\r\n"]
[744.775344, "o", "\r\r\r\r\n"]
[744.869728, "o", "\r"]
[744.870268, "o", "localhost login: "]
[744.871246, "o", "root\r\r\n"]
[745.019356, "o", "root\r\r\r\n"]
[745.858667, "o", "Welcome to Alpine!\r\r\r\n\r\r\r\nThe Alpine Wiki contains a large amount of how-to guides and general\r\r\r\ninformation about administrating Alpine systems.\r\r\r\nSee <https://wiki.alpinelinux.org/>.\r\r\r\n\r\r\r\nYou can setup the system with the command: setup-alpine\r\r\r\n\r\r\r\nYou may change this message by editing /etc/motd.\r\r\r\n\r\r\r\n"]
[746.422729, "o", "localhost:~# \u001b[6necho 'root:password123' | chpasswd; echo __OK__$?\r\r\nmodprobe e1000 2>/dev/null; true; echo __OK__$?\r\r\nip link set eth0 up; echo __OK__$?\r\r\nudhcpc -i eth0 -t 10 -n; echo __OK__$?\r\r\napk add openssh; echo __OK__$?\r\r\nssh-keygen -A; echo __OK__$?\r\r\n/usr/sbin/sshd -o PermitRootLogin=yes -o PasswordAuthentication=yes; echo __OK__$?\r\r\nip -4 addr show eth0; echo __OK__$?\r\r\nss -ltn 2>/dev/null | grep ':22 '; echo __OK__$?\r\r\nSETUP_COMPLETE\r\r\n"]
