[559.400892, "i", "cat > /app/run_vm.sh << 'EOF'\n#!/bin/sh\ncd /app\nnohup qemu-system-x86_64 \\\n  -m 1536 -smp 1 \\\n  -kernel /app/extracted/vmlinuz_lts \\\n  -initrd /app/extracted/initramfs_lts \\\n  -append \"modules=loop,squashfs,sd-mod,usb-storage console=ttyS0 console=tty0\" \\\n  -cdrom /app/alpine.iso \\\n  -netdev user,id=net0,hostfwd=tcp::2222-:22 \\\n  -device e1000,netdev=net0 \\\n  -display none \\\n  -serial tcp:127.0.0.1:4555,server,nowait \\\n  -monitor none \\\n  > /app/qemu.log 2>&1 &\necho $! > /app/qemu.pid\necho \"qemu pid $(cat /app/qemu.pid)\"\nEOF\n"]
