[291.171499, "i", "=(p+'/'+dr['name']) if p else dr['name']\n        results.append((full,dr))\n        if dr['is_dir']:\n            visited.add(dr['ext']); walk(read_dir(f,dr['ext'],dr['dlen']),full)\nwalk(read_dir(f,root['ext'],root['dlen']),'')\nos.makedirs('/app/extracted',exist_ok=True)\ndef save(dr,label):\n    f.seek(dr['ext']*SECTOR); data=f.read(dr['dlen'])\n    out='/app/extracted/'+label\n    open(out,'wb').write(data); print('saved',out,dr['dlen'])\nfor suf in ('VMLINUZ_LTS.','INITRAMFS_LTS.'):\n    for full,dr in results:\n        if full.upper().endswith('/BOOT/'+suf):\n            save(dr,suf.lower().replace('.','')); break\nprint('--- openssh in ISO? ---')\nfor full,_ in results:\n    if 'OPENSSH' in full.upper(): print(full)\nprint('--- sshd? ---')\nfor full,_ in results:\n    if 'SSHD' in full.upper(): print(full)\nf.close()\nEOF\n"]
