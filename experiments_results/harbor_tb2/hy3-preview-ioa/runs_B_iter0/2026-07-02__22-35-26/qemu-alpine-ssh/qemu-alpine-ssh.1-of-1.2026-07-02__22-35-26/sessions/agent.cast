[848.445888, "i", "cat > /app/test_ssh.exp << 'EOF'\n#!/usr/bin/expect -f\nset timeout 40\nspawn ssh -p 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@localhost\nexpect {\n  -re \"assword:\" { send \"password123\\r\" }\n  timeout { puts \"NO PASSWORD PROMPT\"; exit 1 }\n}\nexpect {\n  -re \"# \" { send \"hostname; id; echo SSH_OK\\r\" }\n  timeout { puts \"NO SHELL\"; exit 1 }\n}\nexpect {\n  \"SSH_OK\" { }\n  timeout { puts \"NO COMMAND OUTPUT\"; exit 1 }\n}\nexit 0\nEOF\n"]
