[138.357683, "i", "cat > /tmp/readiso.py << 'EOF'\nimport sys, struct, os\nsys.setrecursionlimit(100000)\nSECTOR=2048\nISO='/app/alpine.iso'\ndef parse_dr(data):\n    if len(data)<34: return None\n    length=data[0]\n    if length==0: return None\n    ext=struct.unpack('<I',data[2:6])[0]\n    dlen=struct.unpack('<I',data[10:14])[0]\n    flags=data[25]\n    nl=data[32]\n    name=data[33:33+nl].split(b';')[0].decode('latin1')\n    return {'ext':ext,'dlen':dlen,'is_dir':bool(flags&2),'name':name}\ndef read_dir(f,lba,length):\n    recs=[]; off=0\n    while off<length:\n        f.seek(lba*SECTOR+off)\n        try: rl=f.read(1)[0]\n        except: break\n        if rl==0:\n            off=(off//SECTOR+1)*SECTOR\n            continue\n        f.seek(lba*SECTOR+off)\n        rec=f.read(rl)\n        dr=parse_dr(rec)\n        if dr: recs.append(dr)\n        off+=rl\n    return recs\ndef main():\n    f=open(ISO,'rb')\n    f.seek(16*SECTOR)\n    pvd=f.read(SECTOR)\n    root=parse_dr(pvd[156:156+34])\n    results=[]\n    visited=set()\n    def walk(entries,path):\n        for d"]
[138.357749, "i", "r in entries:\n            if dr['name'] in ('.','..'): continue\n            if dr['ext'] in visited: continue\n            full=(path+'/'+dr['name']) if path else dr['name']\n            results.append((full,dr))\n            if dr['is_dir']:\n                visited.add(dr['ext'])\n                walk(read_dir(f,dr['ext'],dr['dlen']),full)\n    walk(read_dir(f,root['ext'],root['dlen']),'')\n    with open('/tmp/tree.txt','w') as o:\n        for full,_ in results:\n            o.write(full+'\\n')\n    print('total',len(results))\n    for arg in sys.argv[1:]:\n        found=False\n        for full,dr in results:\n            if full.lower()==arg.lower():\n                f.seek(dr['ext']*SECTOR)\n                data=f.read(dr['dlen'])\n                os.makedirs('/app/extracted',exist_ok=True)\n                out='/app/extracted/'+full.replace('/','_')\n                with open(out,'wb') as o:\n                    o.write(data)\n                print('extracted',full,'->',out,dr['dlen'])\n                found=True; break\n      "]
[138.357882, "i", "  if not found: print('NOT FOUND',arg)\n    f.close()\nmain()\nEOF\n"]
