[498.882793, "o", "\u001b[?2004hroot@01ef974279f5:/app# "]
[734.298886, "i", "cat > /app/export_weights.py <<'PYEOF'\nimport pickle, zipfile, struct, json, collections, io\n\nZIP='model.pth'\nPREFIX='simple_mnist/'\n\nclass _Storage:\n    def __init__(self, raw): self.raw=raw\n\nclass _Up(pickle.Unpickler):\n    def find_class(self, module, name):\n        if module=='collections' and name=='OrderedDict': return collections.OrderedDict\n        if module=='torch._utils' and name=='_rebuild_tensor_v2': return _rebuild\n        if module=='torch' and name=='FloatStorage': return _Storage\n        raise pickle.UnpicklingError('unknown '+module+'.'+name)\n    def persistent_load(self, pid):\n        if isinstance(pid, tuple) and pid and pid[0]=='storage':\n            key=pid[2]\n            with zipfile.ZipFile(ZIP) as z: raw=z.read(PREFIX+'data/'+str(key))\n            return _Storage(raw)\n        raise pickle.UnpicklingError('bad pid')\n\ndef _rebuild(storage, offset, size, stride, requires_grad, ref_obj, *rest):\n    n=len(storage.raw)//4\n    vals=struct.unpac"]
[734.299423, "o", "cat > /app/export_weights.py <<'PYEOF'"]
[734.299544, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.299634, "o", "> "]
[734.3062, "o", "import pickle, zipfile, struct, json, collections, io\r\n\u001b[?2004l\r"]
[734.306257, "o", "\u001b[?2004h> \r\n"]
[734.306325, "i", "k('<%df'%n, storage.raw)\n    total=1\n    for s in size: total*=s\n    flat=vals[offset:offset+total]\n    if len(size)==1: return list(flat)\n    if len(size)==2:\n        r,c=size\n        return [list(flat[i*c:(i+1)*c]) for i in range(r)]\n    return list(flat)\n\ndef collect(obj, out):\n    if isinstance(obj, dict):\n        for k,v in obj.items():\n            if isinstance(v, list): out[k]=v\n            elif isinstance(v, dict): collect(v, out)\n    return out\n\ndef main():\n    with zipfile.ZipFile(ZIP) as z: pkl=z.read(PREFIX+'data.pkl')\n    state=_Up(io.BytesIO(pkl)).load()\n    params={}\n    collect(state, params)\n    json.dump({'params':params}, open('weights.json','w'))\n    for k,v in params.items():\n        shape=(len(v),len(v[0])) if v and isinstance(v[0],list) else len(v)\n        print(k, shape)\nmain()\nPYEOF\n"]
