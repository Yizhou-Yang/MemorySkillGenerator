[734.321512, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     with zipfile.ZipFile(ZIP) as z: pkl=z.read(PREFIX+'data.pkl')\r\n\u001b[?2004l\r\u001b[?2004h>     state=_Up(io.BytesIO(pkl)).load()\r\n\u001b[?2004l\r\u001b[?2004h>     params={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.321915, "o", "    collect(state, params)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.322282, "o", "    json.dump({'params':params}, open('weights.json','w'))\r\n\u001b[?2004l\r\u001b[?2004h>     for k,v in params.items():\r\n\u001b[?2004l\r\u001b[?2004h>         shape=(len(v),len(v[0])) if v and isinstance(v[0],list) else len(v)\r\n\u001b[?2004l\r\u001b[?2004h>         print(k, shape)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.322436, "o", "main()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[734.329434, "o", "\u001b[?2004h"]
[734.329996, "o", "root@01ef974279f5:/app# "]
[734.525999, "i", "cd /app && python3 export_weights.py\n"]
[734.526762, "o", "cd /app && python3 export_weights.py"]
