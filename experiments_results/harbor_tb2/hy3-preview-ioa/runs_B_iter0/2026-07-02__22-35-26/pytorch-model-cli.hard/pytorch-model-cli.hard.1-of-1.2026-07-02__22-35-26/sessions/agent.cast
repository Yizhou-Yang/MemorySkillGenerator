[734.733757, "o", "input_layer.weight (16, 784)\r\ninput_layer.bias 16\r\nhidden_layer.weight (16, 16)\r\nhidden_layer.bias 16\r\noutput_layer.weight (10, 16)\r\n"]
[734.734066, "o", "output_layer.bias 10\r\n"]
[734.752671, "o", "\u001b[?2004hroot@01ef974279f5:/app# "]
[769.069656, "i", "cat > /tmp/scratch.py <<'PYEOF'\nimport json, struct, zlib, sys\n\ndef paeth(a,b,c):\n    p=a+b-c; pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\n    return a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\n\ndef decode_png(path):\n    d=open(path,'rb').read()\n    assert d[:8]==b'\\x89PNG\\r\\n\\x1a\\n'\n    pos=8; w=h=bd=ct=None; idat=b''\n    while pos<len(d):\n        ln=struct.unpack('>I',d[pos:pos+4])[0]; typ=d[pos+4:pos+8]; data=d[pos+8:pos+8+ln]\n        if typ==b'IHDR': w,h,bd,ct=struct.unpack('>IIBB',data[:10])\n        elif typ==b'IDAT': idat+=data\n        elif typ==b'IEND': break\n        pos+=12+ln\n    raw=zlib.decompress(idat)\n    ch={0:1,2:3,3:1,4:2,6:4}[ct]\n    stride=w*ch\n    out=bytearray(); prev=bytearray(stride); p=0\n    for y in range(h):\n        f=raw[p]; p+=1; line=bytearray(raw[p:p+stride]); p+=stride\n        for i in range(stride):\n            a=line[i-ch] if i>=ch else 0\n            b=prev[i]; c=prev[i-ch] if i>=ch else 0\n            if f==0: v=line[i]\n         "]
[769.070371, "o", "cat > /tmp/scratch.py <<'PYEOF'"]
[769.074048, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import json, struct, zlib, sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def paeth(a,b,c):\r\n\u001b[?2004l\r\u001b[?2004h>     p=a+b-c; pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\r\n\u001b[?2004l\r\u001b[?2004h>     return a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def decode_png(path):\r\n\u001b[?2004l\r\u001b[?2004h>     d=open(path,'rb').read()\r\n\u001b[?2004l\r\u001b[?2004h>     assert d[:8]==b'\\x89PNG\\r\\n\\x1a\\n'\r\n\u001b[?2004l\r\u001b[?2004h>     pos=8; w=h=bd=ct=None; idat=b''\r\n\u001b[?2004l\r\u001b[?2004h>     while pos<len(d):\r\n\u001b[?2004l\r\u001b[?2004h>         ln=struct.unpack('>I',d[pos:pos+4])[0]; typ=d[pos+4:pos+8]; data=d[pos+8:pos+8+ln]\r\n\u001b[?2004l\r\u001b[?2004h>         if typ==b'IHDR': w,h,bd,ct=struct.unpack('>IIBB',data[:10])\r\n\u001b[?2004l\r\u001b[?2004h"]
[769.083908, "o", ">         elif typ==b'IDAT': idat+=data\r\n\u001b[?2004l\r\u001b[?2004h>         elif typ==b'IEND': break\r\n\u001b[?2004l\r\u001b[?2004h>         pos+=12+ln\r\n\u001b[?2004l\r\u001b[?2004h>     raw=zlib.decompress(idat)\r\n\u001b[?2004l\r\u001b[?2004h>     ch={0:1,2:3,3:1,4:2,6:4}[ct]\r\n\u001b[?2004l\r\u001b[?2004h>     stride=w*ch\r\n\u001b[?2004l\r\u001b[?2004h>     out=bytearray(); prev=bytearray(stride); p=0\r\n\u001b[?2004l\r\u001b[?2004h>     for y in range(h):\r\n\u001b[?2004l\r\u001b[?2004h>         f=raw[p]; p+=1; line=bytearray(raw[p:p+stride]); p+=stride\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(stride):\r\n\u001b[?2004l\r\u001b[?2004h>             a=line[i-ch] if i>=ch else 0\r\n\u001b[?2004l\r\u001b[?2004h>             b=prev[i]; c=prev[i-ch] if i>=ch else 0\r\n\u001b[?2004l\r\u001b[?2004h>             if f==0: v=line[i]\r\n\u001b[?2004l\r\u001b[?2004h>          "]
[769.084869, "i", "   elif f==1: v=line[i]+a\n            elif f==2: v=line[i]+b\n            elif f==3: v=line[i]+((a+b)>>1)\n            elif f==4: v=line[i]+paeth(a,b,c)\n            else: v=line[i]\n            line[i]=v&255\n        out+=line; prev=line\n    # to grayscale\n    if ct in (2,6): px=[out[i] for i in range(0,len(out),ch)]\n    elif ct==4: px=[out[i] for i in range(0,len(out),ch)]\n    else: px=list(out)\n    return w,h,px\n\ndef fwd(x, W1,b1,W2,b2,W3,b3):\n    def relu(v): return [max(0.0,t) for t in v]\n    def lin(W,b,v): return [sum(W[i][j]*v[j] for j in range(len(v)))+b[i] for i in range(len(b))]\n    z1=relu(lin(W1,b1,x)); z2=relu(lin(W2,b2,z1)); z3=lin(W3,b3,z2)\n    return z3\n\nw,h,px=decode_png('image.png')\nprint('img',w,h,'min',min(px),'max',max(px),'sum',sum(px))\nP=json.load(open('weights.json'))['params']\nW1,b1,W2,b2,W3,b3=[P[k] for k in ['input_layer.weight','input_layer.bias','hidden_layer.weight','hidden_layer.bias','output_layer.weight','output_layer.bias']]\nx_raw=[v/255.0 for v in px]\nfor name,x in [('raw/255',x"]
[769.084966, "i", "_raw),('norm',[(v-0.1307)/0.3081 for v in x_raw])]:\n    logits=fwd(x,*[W1,b1,W2,b2,W3,b3])\n    print(name,'argmax',logits.index(max(logits)),'logits',[round(v,2) for v in logits])\nPYEOF\npython3 /tmp/scratch.py\n"]
