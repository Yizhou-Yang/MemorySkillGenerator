[113.709683, "i", "python3 - <<'EOF'\nimport socket, urllib.request, sys\ntry:\n    r=urllib.request.urlopen('https://blockstream.info/api/blocks/tip/hash', timeout=8)\n    print('REST_OK', r.read()[:20])\nexcept Exception as e:\n    print('REST_FAIL', repr(e))\ntry:\n    s=socket.create_connection(('seed.bitcoin.sipa.be',8333), timeout=8)\n    s.close(); print('P2P_OK')\nexcept Exception as e:\n    print('P2P_FAIL', repr(e))\nEOF\n"]
