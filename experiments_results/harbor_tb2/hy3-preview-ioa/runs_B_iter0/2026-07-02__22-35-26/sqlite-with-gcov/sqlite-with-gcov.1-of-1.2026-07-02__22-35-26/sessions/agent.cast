[360.807181, "i", "python3 - <<'EOF'\nimport os, urllib.request, subprocess\nos.makedirs('/tmp/debs', exist_ok=True)\nout=subprocess.check_output(['apt-get','--print-uris','install','-y','gcc','make']).decode()\nurls=[]\nfor line in out.splitlines():\n    line=line.strip()\n    if line.startswith(\"'\"):\n        urls.append(line.split()[0].strip(\"'\"))\nprint('total',len(urls))\nhdr={'User-Agent':'Debian APT-HTTP/1.3 (2.7.14)'}\nfor u in urls:\n    fn=os.path.basename(u)\n    req=urllib.request.Request(u,headers=hdr)\n    try:\n        data=urllib.request.urlopen(req,timeout=60).read()\n        open('/tmp/debs/'+fn,'wb').write(data)\n        print('got',fn,len(data))\n    except Exception as e:\n        print('FAIL',fn,e)\nEOF\n"]
