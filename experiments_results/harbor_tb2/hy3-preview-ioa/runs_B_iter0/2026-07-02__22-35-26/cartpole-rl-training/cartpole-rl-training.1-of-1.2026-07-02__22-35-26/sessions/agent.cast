[524.833231, "i", "cat > /app/bench.py << 'EOF'\nimport time\nimport gymnasium as gym\nimport numpy as np\nimport torch\nfrom agent import QNetwork\n\nenv = gym.make('CartPole-v1')\nnet = QNetwork()\n\nt = time.time()\ns, _ = env.reset()\nfor _ in range(200):\n    s, r, d, tr, _ = env.step(env.action_space.sample())\n    if d or tr:\n        s, _ = env.reset()\nprint('env 200 steps:', time.time() - t)\n\nopt = torch.optim.Adam(net.parameters(), lr=1e-3)\nx = torch.randn(64, 4)\ny = torch.randn(64)\nt = time.time()\nfor _ in range(200):\n    opt.zero_grad()\n    loss = ((net(x).sum(1) - y) ** 2).mean()\n    loss.backward()\n    opt.step()\nprint('net fwd+bwd 200 batches:', time.time() - t)\nEOF\n"]
[524.833401, "o", "cat > /app/bench.py << 'EOF'\r\nimport time\r\nimport gymnasium as gym\r\nimport numpy as np\r\nimport torch\r\nfrom agent import QNetwork\r\n\r\nenv = gym.make('CartPole-v1')\r\nnet = QNetwork()\r\n\r\nt = time.time()\r\ns, _ = env.reset()\r\nfor _ in range(200):\r\n    s, r, d, tr, _ = env.step(env.action_space.sample())\r\n    if d or tr:\r\n        s, _ = env.reset()\r\nprint('env 200 steps:', time.time() - t)\r\n\r\nopt = torch.optim.Adam(net.parameters(), lr=1e-3)\r\nx = torch.randn(64, 4)\r\ny = torch.randn(64)\r\nt = time.time()\r\nfor _ in range(200):\r\n    opt.zero_grad()\r\n    loss = ((net(x).sum(1) - y) ** 2).mean()\r\n    loss.backward()\r\n    opt.step()\r\nprint('net fwd+bwd 200 batches:', time.time() - t)\r\nEOF\r\n"]
