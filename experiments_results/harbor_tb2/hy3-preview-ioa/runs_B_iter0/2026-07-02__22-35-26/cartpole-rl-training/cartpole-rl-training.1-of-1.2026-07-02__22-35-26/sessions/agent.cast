[184.234786, "o", "\u001b[?2004l\r"]
[184.236029, "o", "\u001b[?2004h"]
[184.236066, "o", ">                 if len(self.buffer) >= batch_size:\r\n\u001b[?2004l\r\u001b[?2004h>                     transitions = self.buffer.sample(batch_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.236221, "o", "                    states = torch.as_tensor(np.asarray([tr[0] for tr in transitions]), dtype=torch.float32)\r\n\u001b[?2004l\r"]
[184.23636, "o", "\u001b[?2004h> "]
[184.236618, "o", "                    actions = torch.as_tensor([tr[1] for tr in transitions], dtype=torch.int64)\r\n\u001b[?2004l\r"]
[184.237448, "o", "\u001b[?2004h"]
[184.238073, "o", "> "]
[184.238341, "o", "                    rewards = torch.as_tensor([tr[2] for tr in transitions], dtype=torch.float32)"]
[184.238387, "o", "\r\n"]
[184.238435, "o", "\u001b[?2004l\r"]
[184.238516, "o", "\u001b[?2004h"]
[184.238568, "o", "> "]
[184.238909, "o", "                    next_states = torch.as_tensor(np.asarray([tr[3] for tr in transitions]), dtype=torch.float32)"]
[184.238959, "o", "\r\n"]
[184.239013, "o", "\u001b[?2004l\r"]
[184.23908, "o", "\u001b[?2004h"]
[184.239129, "o", "> "]
[184.239405, "o", "                    dones = torch.as_tensor([tr[4] for tr in transitions], dtype=torch.float32)"]
[184.239455, "o", "\r\n"]
[184.239498, "o", "\u001b[?2004l\r"]
[184.239559, "o", "\u001b[?2004h"]
[184.239607, "o", "> "]
[184.239891, "o", "                    q_values = self.policy_net(states).gather(1, actions.unsqueeze(1)).squeeze(1)"]
[184.239936, "o", "\r\n"]
[184.23998, "o", "\u001b[?2004l\r"]
[184.240042, "o", "\u001b[?2004h"]
[184.24009, "o", "> "]
[184.240226, "o", "                    with torch.no_grad():"]
[184.24035, "o", "\r\n"]
[184.240396, "o", "\u001b[?2004l\r"]
[184.24046, "o", "\u001b[?2004h"]
[184.240511, "o", "> "]
[184.240704, "o", "                        next_q = target_net(next_states).max(1)[0]"]
[184.240766, "o", "\r\n"]
[184.240932, "o", "\u001b[?2004l\r"]
[184.241001, "o", "\u001b[?2004h"]
[184.241057, "o", "> "]
[184.241266, "o", "                        target = rewards + gamma * next_q * (1 - dones)"]
[184.241312, "o", "\r\n"]
[184.241357, "o", "\u001b[?2004l\r"]
[184.241423, "o", "\u001b[?2004h"]
[184.241476, "o", "> "]
[184.241656, "o", "                    loss = F.smooth_l1_loss(q_values, target)"]
[184.2417, "o", "\r\n"]
[184.24176, "o", "\u001b[?2004l\r"]
[184.241829, "o", "\u001b[?2004h"]
[184.241894, "o", "> "]
[184.242051, "o", "                    optimizer.zero_grad()"]
[184.242099, "o", "\r\n"]
[184.242145, "o", "\u001b[?2004l\r"]
[184.242208, "o", "\u001b[?2004h"]
[184.242256, "o", "> "]
[184.242707, "o", "                    loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>                     optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.243149, "o", "                if done:\r\n\u001b[?2004l\r\u001b[?2004h>                     break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.243311, "o", "            episode_rewards.append(ep_reward)"]
[184.248575, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.248676, "o", "            if ep % update_target_every == 0:"]
[184.248836, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.249074, "o", "                target_net.load_state_dict(self.policy_net.state_dict())\r\n"]
[184.249094, "o", "\u001b[?2004l\r"]
[184.249148, "o", "\u001b[?2004h> "]
[184.249346, "o", "            print(f'Episode {ep+1}, Reward {ep_reward}', end='\\r')\r\n"]
[184.249371, "o", "\u001b[?2004l\r"]
[184.249399, "o", "\u001b[?2004h> "]
[184.249548, "o", "            if len(episode_rewards) >= 100:\r\n\u001b[?2004l\r"]
[184.249584, "o", "\u001b[?2004h> "]
[184.24976, "o", "                avg = np.mean(episode_rewards[-100:])\r\n\u001b[?2004l\r"]
[184.249815, "o", "\u001b[?2004h> "]
[184.249937, "o", "                if avg >= 450:\r\n"]
[184.249963, "o", "\u001b[?2004l\r"]
[184.249989, "o", "\u001b[?2004h"]
[184.25, "o", "> "]
[184.250245, "o", "                    print(f'\\nSolved at episode {ep+1}, avg last 100 = {avg:.1f}')\r\n\u001b[?2004l\r"]
[184.250264, "o", "\u001b[?2004h> "]
[184.25036, "o", "                    break\r\n"]
[184.250423, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.250533, "o", "        self.policy_net.eval()\r\n\u001b[?2004l\r"]
[184.250553, "o", "\u001b[?2004h> "]
[184.250776, "o", "        target_net.load_state_dict(self.policy_net.state_dict())"]
[184.250825, "o", "\r\n"]
