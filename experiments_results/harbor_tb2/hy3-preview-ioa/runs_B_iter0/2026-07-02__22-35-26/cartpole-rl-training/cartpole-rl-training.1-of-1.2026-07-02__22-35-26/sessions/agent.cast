[184.178688, "i", "cat > /app/agent.py << 'EOF'\nimport os\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n\nSTATE_DIM = 4\nACTION_DIM = 2\nHIDDEN = 64\n\n\nclass QNetwork(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.fc1 = nn.Linear(STATE_DIM, HIDDEN)\n        self.fc2 = nn.Linear(HIDDEN, ACTION_DIM)\n\n    def forward(self, x):\n        x = torch.relu(self.fc1(x))\n        return self.fc2(x)\n\n\nclass ReplayBuffer:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.buffer = []\n        self.pos = 0\n\n    def push(self, state, action, reward, next_state, done):\n        if len(self.buffer) < self.capacity:\n            self.buffer.append(None)\n        self.buffer[self.pos] = (state, action, reward, next_state, done)\n        self.pos = (self.pos + 1) % self.capacity\n\n    def sample(self, batch_size):\n        idx = np.random.choice(len(self.buffer), batch_size, replace=False)\n        return [self.buffer[i] for i in idx]\n\n    def __len__(self):\n      "]
[184.178779, "i", "  return len(self.buffer)\n\n\nclass Agent:\n    def __init__(self):\n        self.policy_net = QNetwork()\n        self.buffer = ReplayBuffer(20000)\n\n    def select_action(self, current_observation, epsilon=0.0):\n        obs = torch.as_tensor(np.asarray(current_observation), dtype=torch.float32).unsqueeze(0)\n        if np.random.rand() < epsilon:\n            return int(np.random.randint(0, ACTION_DIM))\n        with torch.no_grad():\n            q = self.policy_net(obs)\n            return int(q.argmax(dim=1).item())\n\n    def train(self, env, num_episodes=1000):\n        self.policy_net.train()\n        target_net = QNetwork()\n        target_net.load_state_dict(self.policy_net.state_dict())\n        target_net.eval()\n        optimizer = torch.optim.Adam(self.policy_net.parameters(), lr=5e-4)\n        gamma = 0.99\n        epsilon_start = 1.0\n        epsilon_end = 0.05\n        epsilon_decay = 8000\n        batch_size = 64\n        update_target_every = 100\n        steps = 0\n        episode_rewards = []\n        for ep in rang"]
[184.178795, "i", "e(num_episodes):\n            state, _ = env.reset()\n            ep_reward = 0\n            for t in range(500):\n                epsilon = epsilon_end + (epsilon_start - epsilon_end) * np.exp(-steps / epsilon_decay)\n                steps += 1\n                action = self.select_action(state, epsilon)\n                next_state, reward, terminated, truncated, _ = env.step(action)\n                done = terminated or truncated\n                self.buffer.push(state, action, reward, next_state, done)\n                state = next_state\n                ep_reward += reward\n                if len(self.buffer) >= batch_size:\n                    transitions = self.buffer.sample(batch_size)\n                    states = torch.as_tensor(np.asarray([tr[0] for tr in transitions]), dtype=torch.float32)\n                    actions = torch.as_tensor([tr[1] for tr in transitions], dtype=torch.int64)\n                    rewards = torch.as_tensor([tr[2] for tr in transitions], dtype=torch.float32)\n                    next_states "]
[184.178809, "i", "= torch.as_tensor(np.asarray([tr[3] for tr in transitions]), dtype=torch.float32)\n                    dones = torch.as_tensor([tr[4] for tr in transitions], dtype=torch.float32)\n                    q_values = self.policy_net(states).gather(1, actions.unsqueeze(1)).squeeze(1)\n                    with torch.no_grad():\n                        next_q = target_net(next_states).max(1)[0]\n                        target = rewards + gamma * next_q * (1 - dones)\n                    loss = F.smooth_l1_loss(q_values, target)\n                    optimizer.zero_grad()\n                    loss.backward()\n                    optimizer.step()\n                if done:\n                    break\n            episode_rewards.append(ep_reward)\n            if ep % update_target_every == 0:\n                target_net.load_state_dict(self.policy_net.state_dict())\n            print(f'Episode {ep+1}, Reward {ep_reward}', end='\\r')\n            if len(episode_rewards) >= 100:\n                avg = np.mean(episode_rewards[-100:])\n         "]
[184.17883, "i", "       if avg >= 450:\n                    print(f'\\nSolved at episode {ep+1}, avg last 100 = {avg:.1f}')\n                    break\n        self.policy_net.eval()\n        target_net.load_state_dict(self.policy_net.state_dict())\n\n    def save(self, directory):\n        os.makedirs(directory, exist_ok=True)\n        torch.save(self.policy_net.state_dict(), os.path.join(directory, 'model.pt'))\n\n    def load(self, directory):\n        path = os.path.join(directory, 'model.pt')\n        self.policy_net.load_state_dict(torch.load(path, map_location='cpu'))\n        self.policy_net.eval()\n\n\ndef main():\n    import gymnasium as gym\n    env = gym.make('CartPole-v1')\n    agent = Agent()\n    agent.train(env, num_episodes=1000)\n    agent.save('/app/trained_model')\n    env.close()\n\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
