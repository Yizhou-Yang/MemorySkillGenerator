[487.519287, "i", "cat > /app/extract.py <<'EOF'\nimport pickle, zipfile, struct, sys, json, types\n\nz = zipfile.ZipFile('/app/model.pth')\n\nclass FakeStorage:\n    def __init__(self, key, numel):\n        self.key = key\n        self.numel = numel\n\ndef rebuild_tensor_v2(storage, offset, size, stride, requires_grad, backward_hooks):\n    return {'key': storage.key, 'numel': storage.numel, 'offset': offset,\n            'size': list(size), 'stride': list(stride)}\n\ntorch = types.ModuleType('torch')\ntorch._utils = types.ModuleType('torch._utils')\ntorch._utils._rebuild_tensor_v2 = rebuild_tensor_v2\ntorch.FloatStorage = type('FloatStorage', (), {})\nsys.modules['torch'] = torch\nsys.modules['torch._utils'] = torch._utils\n\nclass MyUnpickler(pickle.Unpickler):\n    def find_class(self, module, name):\n        if module == 'torch._utils' and name == '_rebuild_tensor_v2':\n            return rebuild_tensor_v2\n        if module == 'torch' and name == 'FloatStorage':\n            return torch.FloatStorage"]
[487.520444, "o", "cat > /app/extract.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pickle, zipfile, struct, sys, json, types"]
