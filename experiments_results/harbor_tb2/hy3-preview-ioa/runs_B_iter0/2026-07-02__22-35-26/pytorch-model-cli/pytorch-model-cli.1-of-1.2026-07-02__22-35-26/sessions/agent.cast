[487.568111, "o", "    assert len(raw) == numel*4, (name, len(raw), numel*4)\r\n\u001b[?2004l\r\u001b[?2004h>     vals = list(struct.unpack('<%df' % numel, raw))\r\n\u001b[?2004l\r\u001b[?2004h>     if name.endswith('.weight'):\r\n\u001b[?2004l\r\u001b[?2004h>         # size = [out, in], row-major\r\n\u001b[?2004l\r\u001b[?2004h>         out, in_feat = size[0], size[1]\r\n\u001b[?2004l\r\u001b[?2004h>         w = [vals[i*in_feat + j] for i in range(out) for j in range(in_feat)]\r\n\u001b[?2004l\r\u001b[?2004h>         layers.append({name[:-7]: {'in': in_feat, 'out': out, 'w': w, 'b': None}})\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         layers[-1][name[:-5]]['b'] = vals\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> out = {'layers': []}\r\n\u001b[?2004l\r\u001b[?2004h> for ld in layers:\r\n\u001b[?2004l\r\u001b[?2004h>     for lname, v in ld.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[487.56862, "o", "        out['layers'].append({'name': lname, 'in': v['in'], 'out': v['out'], 'w': v['w'], 'b': v['b']})\r\n\u001b[?2004l\r\u001b[?2004h> "]
