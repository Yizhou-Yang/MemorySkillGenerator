[487.524475, "i", "\n        return super().find_class(module, name)\n    def persistent_load(self, pid):\n        if isinstance(pid, tuple) and len(pid) >= 5 and pid[0] == 'storage':\n            return FakeStorage(pid[2], pid[4])\n        if isinstance(pid, dict):\n            return FakeStorage(pid.get('key'), pid.get('numel'))\n        if isinstance(pid, tuple) and len(pid) >= 4 and isinstance(pid[0], str) and pid[0] != 'storage':\n            return FakeStorage(pid[1], pid[3])\n        raise pickle.UnpicklingError('cannot handle persistent id %r' % (pid,))\n\nd = z.read('simple_mnist/data.pkl')\nstate = MyUnpickler(io.BytesIO(d)).load()\n\nlayers = []\nfor name in state:\n    t = state[name]\n    key = t['key']; numel = t['numel']; size = t['size']\n    raw = z.read('simple_mnist/data/' + key)\n    assert len(raw) == numel*4, (name, len(raw), numel*4)\n    vals = list(struct.unpack('<%df' % numel, raw))\n    if name.endswith('.weight'):\n        # size = [out, in], row-major\n        out, in_feat = size[0], size[1]\n        w = [vals[i*in_feat + "]
[487.524624, "o", "\u001b[?2004h> "]
