[18.613526, "o", "class MnistModel(nn.Module):\r"]
[18.61367, "o", "\r\n"]
[18.613802, "o", "    def __init__(\r"]
[18.614197, "o", "\r\n"]
[18.614403, "o", "        self,\r"]
[18.614577, "o", "\r\n"]
[18.614767, "o", "        input_dim: int,\r"]
[18.614997, "o", "\r\n"]
[18.615174, "o", "        hidden_dim: int,\r"]
[18.61537, "o", "\r\n"]
[18.61565, "o", "        num_classes: int,\r"]
[18.615858, "o", "\r\n"]
[18.616068, "o", "    ) -> torch.nn.Module:\r"]
[18.616256, "o", "\r\n"]
[18.616582, "o", "        super().__init__()\r\r\n\r\r\n        self.input_layer = nn.Linear(input_dim, hidden_dim)\r\r\n        self.hidden_layer = nn.Linear(hidden_dim, hidden_dim)\r\r\n        self.output_layer = nn.Linear(hidden_dim, num_classes)\r\r\n        self.activation = nn.ReLU()\r\r\n\r\r\n    def forward(self, x):\r\r\n        x = self.input_layer(x)\r\r\n        x = self.activation(x)\r\r\n\r\r\n        x = self.hidden_layer(x)\r\r\n        x = self.activation(x)\r\r\n\r\r\n        x = self.output_layer(x)\r\r\n        return x\r\r\n"]
