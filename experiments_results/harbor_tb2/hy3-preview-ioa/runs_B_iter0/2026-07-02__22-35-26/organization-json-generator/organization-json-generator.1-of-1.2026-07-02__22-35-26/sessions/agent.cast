[74.668256, "o", "\u001b[?2004h"]
[74.668272, "o", "> "]
[74.66848, "o", "projectStatusDistribution = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.66859, "o", "for p in projects:\r\n"]
[74.668604, "o", "\u001b[?2004l\r"]
[74.668722, "o", "\u001b[?2004h> "]
[74.669076, "o", "    projectStatusDistribution[p['status']] = projectStatusDistribution.get(p['status'], 0) + 1\r\n\u001b[?2004l\r"]
