[74.666885, "o", "    for s in e['skills'].split(';'):"]
[74.666937, "o", "\r\n"]
[74.667, "o", "\u001b[?2004l\r"]
[74.667089, "o", "\u001b[?2004h> "]
[74.667155, "o", "        s = s.strip()\r\n\u001b[?2004l\r"]
[74.667217, "o", "\u001b[?2004h> "]
[74.667311, "o", "        if s:\r\n"]
[74.667328, "o", "\u001b[?2004l\r"]
[74.667439, "o", "\u001b[?2004h> "]
[74.667672, "o", "            skillDistribution[s] = skillDistribution.get(s, 0) + 1\r\n"]
[74.667795, "o", "\u001b[?2004l\r"]
[74.667836, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.66812, "o", "departmentSizes = {d['name']: len(dept_emps.get(d['id'], [])) for d in departments}\r\n"]
