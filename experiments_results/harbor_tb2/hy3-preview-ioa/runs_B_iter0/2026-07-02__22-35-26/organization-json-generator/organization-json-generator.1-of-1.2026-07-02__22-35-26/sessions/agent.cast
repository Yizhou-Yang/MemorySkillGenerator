[74.666412, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.666434, "o", "\u001b[?2004h> # Statistics\r\n\u001b[?2004l\r\u001b[?2004h> budgets = [float(d['budget']) for d in departments]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.666524, "o", "averageDepartmentBudget = sum(budgets) / len(budgets) if budgets else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.666696, "o", "totalEmployees = len(employees)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> skillDistribution = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
