[784.043832, "i", "cat > /app/dl.py << 'EOF'\nimport urllib.request, re, sys\nout='/app/debs/'\nd = open('/app/uris.txt').read().splitlines()\nn=0\nfor line in d:\n    line=line.strip()\n    if not line.startswith(\"'http\"): continue\n    # parse 'url' filename ...\n    m = re.match(r\"'(\\S+)'\\s+(\\S+)\", line)\n    if not m: continue\n    url, fn = m.group(1), m.group(2)\n    url = url.replace('%2b','+').replace('%3a',':')\n    fn = fn.replace('%2b','+').replace('%3a',':')\n    try:\n        urllib.request.urlretrieve(url, out+fn)\n        n+=1\n    except Exception as e:\n        print('FAIL', fn, e)\nprint('downloaded', n)\nEOF\npython3 /app/dl.py\n"]
[784.044397, "o", "cat > /app/dl.py << 'EOF'"]
