[581.930556, "o", "\u001b[?2004hroot@efee5c6aa36b:/app# "]
[595.884955, "i", "cat > /tmp/extract2.py << 'PYEOF'\nimport re\nSECTOR=2048\nf=open('/app/alpine.iso','rb')\ndef rd(lba,n):\n    f.seek(lba*SECTOR); return f.read(n*SECTOR)\npvd=rd(16,1)\ndef parse(rec):\n    L=rec[0]\n    if L==0: return None\n    loc=int.from_bytes(rec[2:6],'little')\n    dlen=int.from_bytes(rec[10:14],'little')\n    flags=rec[25]; nl=rec[32]; name=rec[33:33+nl]\n    return dict(loc=loc,dlen=dlen,is_dir=bool(flags&2),length=L)\nroot=parse(pvd[156:156+34])\nfound={}\ndef walk(rec,path):\n    data=rd(rec['loc'],max(1,(rec['dlen']+SECTOR-1)//SECTOR)); off=0\n    while off < len(data):\n        L=data[off]\n        if L==0:\n            off+=SECTOR-(off%SECTOR); continue\n        nl=data[off+32]; nm=data[off+33:off+33+nl]\n        e=parse(data[off:off+L]); off+=L\n        if e is None: continue\n        try: n=nm.decode('ascii').strip()\n        except: n=repr(nm)\n        if ';' in n: n=n.split(';')[0]\n        fp=path+'/'+n\n        if not e['is_dir']: found[fp.upper()]=e\n        if e['is_dir'] and nm not in (b'\\x00',b'\\x01'): walk(e,fp)\n"]
[595.885141, "i", "walk(root,'')\nfor key in found:\n    if key.endswith('/VMLINUZ_LTS') or key.endswith('VMLINUZ_LTS'):\n        e=found[key]\n        d=rd(e['loc'],(e['dlen']+SECTOR-1)//SECTOR)[:e['dlen']]\n        open('/tmp/vmlinuz','wb').write(d); print('kernel',key,len(d))\n    if key.endswith('/INITRAMFS_LTS') or key.endswith('INITRAMFS_LTS'):\n        e=found[key]\n        d=rd(e['loc'],(e['dlen']+SECTOR-1)//SECTOR)[:e['dlen']]\n        open('/tmp/initramfs','wb').write(d); print('initrd',key,len(d))\nfor k in found:\n    if k.endswith('SYSLINUX.CFG'):\n        e=found[k]\n        d=rd(e['loc'],(e['dlen']+SECTOR-1)//SECTOR)[:e['dlen']]\n        print('=== %s ==='%k); print(d.decode('latin1'))\nPYEOF\npython3 /tmp/extract2.py\n"]
[595.885225, "o", "cat > /tmp/extract2.py << 'PYEOF'"]
