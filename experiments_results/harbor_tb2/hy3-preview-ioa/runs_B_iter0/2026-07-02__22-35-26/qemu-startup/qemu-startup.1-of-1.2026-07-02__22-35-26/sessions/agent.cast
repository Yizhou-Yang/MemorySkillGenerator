[256.249532, "i", "cat > /tmp/wait_login.py << 'PYEOF'\nimport socket, time, sys\nfor i in range(120):\n    try:\n        s = socket.create_connection(('127.0.0.1',6665), timeout=2)\n        s.settimeout(2)\n        data = b''\n        try:\n            data += s.recv(4096)\n        except Exception:\n            pass\n        try:\n            s.sendall(b'\\r\\n')\n        except Exception:\n            pass\n        time.sleep(0.6)\n        try:\n            data += s.recv(4096)\n        except Exception:\n            pass\n        s.close()\n        if b'login' in data.lower():\n            print('READY after %d tries' % i)\n            sys.exit(0)\n    except Exception:\n        pass\n    time.sleep(3)\nprint('NOTREADY')\nsys.exit(1)\nPYEOF\n"]
[256.255835, "o", "cat > /tmp/wait_login.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import socket, time, sys\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(120):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         s = socket.create_connection(('127.0.0.1',6665), timeout=2)\r\n\u001b[?2004l\r\u001b[?2004h>         s.settimeout(2)\r\n\u001b[?2004l\r\u001b[?2004h>         data = b''\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             data += s.recv(4096)\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             s.sendall(b'\\r\\n')\r\n\u001b[?2004l\r"]
