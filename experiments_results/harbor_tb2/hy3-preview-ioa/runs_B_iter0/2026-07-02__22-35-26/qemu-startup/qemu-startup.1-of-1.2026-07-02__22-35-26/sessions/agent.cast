[256.414948, "i", "cat > /tmp/extract.py << 'PYEOF'\nimport sys\nSECTOR=2048\nf=open('/app/alpine.iso','rb')\ndef rd(lba,n):\n    f.seek(lba*SECTOR); return f.read(n*SECTOR)\npvd=rd(16,1)\nassert pvd[1:6]==b'CD001', 'no iso'\ndef parse(rec):\n    L=rec[0]\n    if L==0: return None\n    loc=int.from_bytes(rec[2:6],'little')\n    dlen=int.from_bytes(rec[10:14],'little')\n    flags=rec[25]\n    nl=rec[32]\n    name=rec[33:33+nl]\n    return dict(loc=loc,dlen=dlen,is_dir=bool(flags&2),name=name,length=L)\nroot=parse(pvd[156:156+34])\nresults=[]\ndef walk(rec, path):\n    data=rd(rec['loc'], max(1,(rec['dlen']+SECTOR-1)//SECTOR))\n    off=0\n    while off < len(data):\n        L=data[off]\n        if L==0:\n            rem=SECTOR-(off%SECTOR)\n            off+=rem\n            continue\n        nl=data[off+32]\n        nm=data[off+33:off+33+nl]\n        entry=parse(data[off:off+L])\n        off+=L\n        if entry is None: continue\n        try:\n            nmstr=nm.decode('ascii').strip()\n        except:\n            nmstr=repr(nm)\n        if ';' in nmstr:\n       "]
[256.415111, "i", "     nmstr=nmstr.split(';')[0]\n        full=path+'/'+nmstr\n        results.append((full,entry['loc'],entry['dlen'],entry['is_dir']))\n        if entry['is_dir'] and nm not in (b'\\x00',b'\\x01'):\n            walk(entry,full)\nwalk(root,'')\nkernels=[(p,l,d) for (p,l,d,idr) in results if (not idr) and 'VMLINUZ' in p.upper()]\ninitrds=[(p,l,d) for (p,l,d,idr) in results if (not idr) and 'INITRAM' in p.upper()]\ncfgs=[(p,l,d,idr) for (p,l,d,idr) in results if (not idr) and (p.upper().endswith('.CFG') or 'ISOLINUX' in p.upper() or 'SYSLINUX' in p.upper())]\nprint('KERNELS:')\nfor k in kernels: print('  ',k[0],k[1],k[2])\nprint('INITRDS:')\nfor k in initrds: print('  ',k[0],k[1],k[2])\nprint('CFGS:')\nfor k in cfgs: print('  ',k[0],k[1],k[2])\ndef ext(p):\n    return p.rsplit('.',1)[-1].upper() if '.' in p else ''\nkext={ext(p):(p,l,d) for p,l,d in kernels}\niext={ext(p):(p,l,d) for p,l,d in initrds}\nchosen=None\nfor tag in ['VRT','LTS','EDG']:\n    if tag in kext and tag in iext:\n        chosen=tag; break\nif chosen is None and kern"]
[256.415156, "i", "els and initrds:\n    chosen=ext(kernels[0][0])\nprint('CHOSEN TAG', chosen)\nif chosen:\n    kp,kl,kd=kext[chosen]\n    ip,il,id_=iext[chosen]\n    kdata=rd(kl, (kd+SECTOR-1)//SECTOR)[:kd]\n    idata=rd(il, (id_+SECTOR-1)//SECTOR)[:id_]\n    open('/tmp/vmlinuz','wb').write(kdata)\n    open('/tmp/initramfs','wb').write(idata)\n    print('wrote /tmp/vmlinuz (%d) /tmp/initramfs (%d)'%(kd,id_))\n    if cfgs:\n        cp,cl,cd,_=cfgs[0]\n        cfgdata=rd(cl,(cd+SECTOR-1)//SECTOR)[:cd]\n        open('/tmp/cfg.txt','wb').write(cfgdata)\n        print('=== CFG ===')\n        print(cfgdata.decode('latin1'))\nPYEOF\n"]
[256.415314, "o", "cat > /tmp/extract.py << 'PYEOF'"]
