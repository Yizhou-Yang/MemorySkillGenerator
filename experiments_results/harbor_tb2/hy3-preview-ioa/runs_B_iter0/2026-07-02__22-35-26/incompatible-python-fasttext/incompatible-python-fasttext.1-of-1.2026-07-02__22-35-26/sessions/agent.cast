[60.361371, "o", "class _Meter:"]
[60.361953, "o", "\r\n"]
[60.362183, "o", "    def __init__(self, fasttext_model, meter):"]
[60.362451, "o", "\r\n"]
[60.363508, "o", "        self.f = fasttext_model"]
[60.363805, "o", "\r\n"]
[60.364056, "o", "        self.m = meter"]
[60.364321, "o", "\r\n"]
[60.36454, "o", "\r\n"]
[60.364759, "o", "    def score_vs_true(self, label):"]
[60.364997, "o", "\r\n"]
[60.365226, "o", "        \"\"\"Return scores and the gold of each sample for a specific label\"\"\""]
[60.36554, "o", "\r\n"]
[60.36577, "o", "        label_id = self.f.get_label_id(label)"]
[60.366015, "o", "\r\n"]
[60.366254, "o", "        pair_list = self.m.scoreVsTrue(label_id)"]
[60.366519, "o", "\r\n\r\n        if pair_list:\r\n            y_scores, y_true = zip(*pair_list)\r\n        else:\r\n            y_scores, y_true = ([], ())\r\n\r\n"]
[60.366808, "o", "        return np.array(y_scores, copy=False), np.array(y_true, copy=False)"]
[60.367203, "o", "\r\n"]
[60.367564, "o", "\r\n"]
[60.368071, "o", "    def precision_recall_curve(self, label=None):"]
[60.368824, "o", "\r\n"]
[60.369228, "o", "        \"\"\"Return precision/recall curve\"\"\""]
[60.369509, "o", "\r\n"]
[60.369763, "o", "        if label:"]
[60.370415, "o", "\r\n"]
[60.371256, "o", "            label_id = self.f.get_label_id(label)"]
[60.371622, "o", "\r\n"]
[60.371907, "o", "            pair_list = self.m.precisionRecallCurveLabel(label_id)"]
[60.373833, "o", "\r\n"]
[60.374016, "o", "        else:\r\n            pair_list = self.m.precisionRecallCurve()\r\n\r\n        if pair_list:\r\n            precision, recall = zip(*pair_list)\r\n"]
[60.374148, "o", "        else:\r\n            precision, recall = ([], ())\r\n\r\n        return np.array(precision, copy=False), np.array(recall, copy=False)\r\n\r\n    def precision_at_recall(self, recall, label=None):\r\n        \"\"\"Return precision for a given recall\"\"\"\r\n        if label:\r\n            label_id = self.f.get_label_id(label)\r\n            precision = self.m.precisionAtRecallLabel(label_id, recall)\r\n        else:"]
[60.374214, "o", "\r\n            precision = self.m.precisionAtRecall(recall)\r\n\r\n        return precision\r\n\r\n    def recall_at_precision(self, precision, label=None):\r\n        \"\"\"Return recall for a given precision\"\"\"\r\n        if label:\r\n            label_id = self.f.get_label_id(label)\r\n            recall = self.m.recallAtPrecisionLabel(label_id, precision)\r\n"]
[60.374382, "o", "        else:\r\n            recall = self.m.recallAtPrecision(precision)\r\n\r\n        return recall\r\n\r\n\r\nclass _FastText:\r\n    \"\"\"\r\n"]
