[163.837551, "o", "     1\t#!/bin/bash\r\n     2\tunset GIT_DIR\r\n     3\tREPO=/git/project\r\n     4\tWEB=/var/www/html\r\n     5\tdeploy() {\r\n     6\t  local branch=$1; local target=$2\r\n     7\t  if git --git-dir=\"$REPO\" rev-parse --verify \"$branch\" >/dev/null 2>&1; then\r\n     8\t    mkdir -p \"$target\"\r\n     9\t    git --git-dir=\"$REPO\" --work-tree=\"$target\" checkout -f \"$branch\"\r\n    10\t    chmod -R a+rX \"$target\"\r\n    11\t  fi\r\n    12\t}\r\n    13\tdeploy main \"$WEB\"\r\n    14\tdeploy dev \"$WEB/dev\"\r\n"]
