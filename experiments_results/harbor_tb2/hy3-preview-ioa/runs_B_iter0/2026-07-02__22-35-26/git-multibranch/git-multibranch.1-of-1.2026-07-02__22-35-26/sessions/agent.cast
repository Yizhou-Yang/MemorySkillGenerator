[805.223365, "i", "cat > /tmp/sshpush.sh <<'EOF'\n#!/bin/bash\ncd /app\nrm -rf /tmp/sw; mkdir -p /tmp/sw; cd /tmp/sw\ngit init -q -b main\ngit config user.email t@t.com; git config user.name t\necho '<h1>MAIN</h1>' > index.html; git add -A; git commit -qm main\ngit checkout -q -b dev\necho '<h1>DEV</h1>' > index.html; git add -A; git commit -qm dev\ngit remote add origin git@localhost:/git/project\ngit push -v origin main dev\necho \"SSH_PUSH_EXIT=$?\"\nEOF\nssh -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null git@localhost 'echo SSH_OK' 2>&1\nbash /tmp/sshpush.sh > /tmp/sshpush.out 2>&1; echo DONE\n"]
