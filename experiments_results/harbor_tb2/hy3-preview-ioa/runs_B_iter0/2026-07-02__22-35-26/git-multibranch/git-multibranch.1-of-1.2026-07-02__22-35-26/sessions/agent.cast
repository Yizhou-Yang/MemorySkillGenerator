[785.625138, "i", "cat > /tmp/loc2.sh <<'EOF'\ncd /tmp\nrm -rf lt\ngit init -q -b main lt\ncd lt\ngit config user.email x@x.com; git config user.name x\necho a > index.html; git add -A; git commit -qm m\ngit checkout -q -b dev; echo b > index.html; git add -A; git commit -qm d\ngit push /git/project main dev\necho \"LOCAL_PUSH_EXIT=$?\"\nEOF\nsu git -c 'bash /tmp/loc2.sh' > /tmp/loc2.out 2>&1; cat /tmp/loc2.out\n"]
