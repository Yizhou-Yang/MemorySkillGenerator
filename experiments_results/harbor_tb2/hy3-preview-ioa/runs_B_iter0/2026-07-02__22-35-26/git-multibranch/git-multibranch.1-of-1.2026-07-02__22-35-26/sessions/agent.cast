[262.176778, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nunset GIT_DIR\nREPO=/git/project\nWEB=/var/www/html\ndeploy() {\n  local branch=$1; local target=$2\n  if git --git-dir=\"$REPO\" rev-parse --verify \"$branch\" >/dev/null 2>&1; then\n    mkdir -p \"$target\"\n    git --git-dir=\"$REPO\" archive \"$branch\" | tar -x -C \"$target\"\n    chmod -R a+rX \"$target\"\n  fi\n}\ndeploy main \"$WEB\"\ndeploy dev \"$WEB/dev\"\nEOF\nchmod +x /git/project/hooks/post-receive\nchown git:git /git/project/hooks/post-receive\n"]
[262.178393, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> unset GIT_DIR\r\n\u001b[?2004l\r\u001b[?2004h> REPO=/git/project\r\n\u001b[?2004l\r\u001b[?2004h> WEB=/var/www/html\r\n\u001b[?2004l\r\u001b[?2004h> deploy() {\r\n\u001b[?2004l\r\u001b[?2004h>   local branch=$1; local target=$2\r\n\u001b[?2004l\r\u001b[?2004h>   if git --git-dir=\"$REPO\" rev-parse --verify \"$branch\" >/dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h>     mkdir -p \"$target\"\r\n\u001b[?2004l\r\u001b[?2004h>     git --git-dir=\"$REPO\" archive \"$branch\" | tar -x -C \"$target\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[262.178824, "o", "    chmod -R a+rX \"$target\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[262.178852, "o", ">   fi\r\n\u001b[?2004l\r"]
