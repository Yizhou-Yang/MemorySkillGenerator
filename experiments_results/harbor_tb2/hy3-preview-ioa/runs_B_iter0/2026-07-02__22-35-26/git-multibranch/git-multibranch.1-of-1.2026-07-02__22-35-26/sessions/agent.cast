[360.979439, "i", "cat > /tmp/test.sh <<'EOF'\n#!/bin/bash\nrm -rf /tmp/work; mkdir -p /tmp/work; cd /tmp/work\ngit init -q -b main\ngit config user.email t@t.com; git config user.name t\necho '<h1>MAIN</h1>' > index.html; git add -A; git commit -qm main\ngit checkout -q -b dev\necho '<h1>DEV</h1>' > index.html; git add -A; git commit -qm dev\ngit remote add origin git@localhost:/git/project\nexport GIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null'\nexport SSH_ASKPASS=/tmp/askpass.sh; export SSH_ASKPASS_REQUIRE=force; export DISPLAY=:0\nsetsid git push -q origin main dev; echo \"PUSH_EXIT=$?\"\nsleep 1\necho '--- main ---'; curl -sk https://localhost:8443/index.html\necho '--- dev ---'; curl -sk https://localhost:8443/dev/index.html\nEOF\nbash /tmp/test.sh\n"]
