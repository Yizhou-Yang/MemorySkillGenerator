[146.05438, "i", "cat > /tmp/setup.sh <<'SETUP_EOF'\n#!/bin/bash\nset -e\n\n# 1. git user with password\nid git >/dev/null 2>&1 || useradd -m -s /bin/bash git\necho 'git:password' | chpasswd\n\n# 2. bare repo + post-receive hook\nmkdir -p /git\nrm -rf /git/project\ngit init --bare /git/project >/dev/null\ncat > /git/project/hooks/post-receive <<'HOOK_EOF'\n#!/bin/bash\nunset GIT_DIR\nREPO=/git/project\nWEB=/var/www/html\ndeploy() {\n  local branch=$1; local target=$2\n  if git --git-dir=\"$REPO\" rev-parse --verify \"$branch\" >/dev/null 2>&1; then\n    mkdir -p \"$target\"\n    git --git-dir=\"$REPO\" --work-tree=\"$target\" checkout -f \"$branch\"\n    chmod -R a+rX \"$target\"\n  fi\n}\ndeploy main \"$WEB\"\ndeploy dev \"$WEB/dev\"\nHOOK_EOF\nchmod +x /git/project/hooks/post-receive\nchown -R git:git /git\n\n# 3. web root\nmkdir -p /var/www/html\nchown -R git:git /var/www/html\n\n# 4. self-signed cert\nmkdir -p /etc/nginx/ssl\nopenssl req -x509 -newkey rsa:2048 -nodes -keyout /etc/nginx/ssl/nginx.key -out /etc/nginx/ssl/nginx.crt -days 365 -subj \"/CN=localhost\" >/dev/null 2>&1\n\n# 5. nginx server block\ncat > /etc/nginx/conf.d/git.conf <<'NGINX_EOF'\nserver {\n    listen 8443 ssl;\n    server_name localhost;\n    ssl_certificate /etc/nginx/ssl/nginx.crt;\n    ssl_certificate_key /etc/nginx/ssl/nginx.key;\n    root /var/www/html;\n    index index.html;\n}\nNGINX_EOF\n\n# 6. sshd password auth\nmkdir -p /etc/ssh/sshd_config.d\necho 'PasswordAuthentication yes' > /etc/ssh/sshd_config.d/99-local.conf\nsed -i 's/^#\\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config\ngrep -q '^PasswordAuthentication yes' /etc/ssh/sshd_config || echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config\nmkdir -p /run/sshd\nssh-keygen -A >/dev/null 2>&1\n\necho SETUP_DONE\nSETUP_EOF\n"]
[146.056458, "o", "cat > /tmp/setup.sh <<'SETUP_EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> set -e\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 1. git user with password\r\n\u001b[?2004l\r\u001b[?2004h> id git >/dev/null 2>&1 || useradd -m -s /bin/bash git\r\n\u001b[?2004l\r\u001b[?2004h> echo 'git:password' | chpasswd\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 2. bare repo + post-receive hook\r\n\u001b[?2004l\r\u001b[?2004h> mkdir -p /git\r\n\u001b[?2004l\r\u001b[?2004h> rm -rf /git/project\r\n\u001b[?2004l\r\u001b[?2004h> git init --bare /git/project >/dev/null\r\n\u001b[?2004l\r\u001b[?2004h> "]
[146.056505, "o", "cat > /git/project/hooks/post-receive <<'HOOK_EOF'\r\n\u001b[?2004l\r"]
[146.057314, "o", "\u001b[?2004h"]
