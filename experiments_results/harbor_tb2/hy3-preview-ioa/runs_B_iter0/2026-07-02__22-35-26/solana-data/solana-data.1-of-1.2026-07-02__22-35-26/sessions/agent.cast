[660.552926, "i", "python3 - << 'EOF'\nimport urllib.request, json, ssl\ntests=[\"https://api.devnet.solana.com\",\"https://solana-mainnet.g.alchemy.com/v2/demo\",\"https://rpc.ankr.com/solana\",\"https://solana-api.projectserum.com\"]\nfor u in tests:\n    try:\n        req=urllib.request.Request(u, data=json.dumps({'jsonrpc':'2.0','id':1,'method':'getHealth'}).encode(), headers={'Content-Type':'application/json'})\n        r=urllib.request.urlopen(req, timeout=8)\n        print(u,'OK', r.read().decode()[:60])\n    except Exception as e:\n        print(u,'ERR', str(e)[:80])\nEOF\n"]
[660.553263, "o", "python3 - << 'EOF'\r\nimport urllib.request, json, ssl\r\ntests=[\"https://api.devnet.solana.com\",\"https://solana-mainnet.g.alchemy.com/v2/demo\",\"https://rpc.ankr.com/solana\",\"https://solana-api.projectserum.com\"]\r\nfor u in tests:\r\n    try:\r\n        req=urllib.request.Request(u, data=json.dumps({'jsonrpc':'2.0','id':1,'method':'getHealth'}).encode(), headers={'Content-Type':'application/json'})\r\n        r=urllib.request.urlopen(req, timeout=8)\r\n        print(u,'OK', r.read().decode()[:60])\r\n    except Exception as e:\r\n        print(u,'ERR', str(e)[:80])\r\nEOF\r\n"]
