[315.537251, "i", "python3 - << 'EOF'\nimport socket\nfor host in [\"api.devnet.solana.com\"]:\n    try:\n        s=socket.create_connection((host,443),timeout=6)\n        s.settimeout(3)\n        try:\n            data=s.recv(200)\n            print(repr(data[:160]))\n        except Exception as e:\n            print(\"recv:\",e)\n        s.close()\n    except Exception as e:\n        print(\"conn:\",e)\nEOF\n"]
