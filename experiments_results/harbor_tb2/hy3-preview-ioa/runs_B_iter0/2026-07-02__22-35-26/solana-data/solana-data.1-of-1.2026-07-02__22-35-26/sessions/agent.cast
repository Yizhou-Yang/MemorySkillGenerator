[477.83832, "i", "cat > /app/server.py << 'PYEOF'\n#!/usr/bin/env python3\nimport os\nimport requests\nfrom flask import Flask, jsonify, request\n\napp = Flask(__name__)\n\nRPC_URL = os.environ.get(\"SOLANA_RPC_URL\", \"https://api.devnet.solana.com\").strip()\nNETWORK = os.environ.get(\"SOLANA_NETWORK\", \"devnet\").strip()\n\nsession = requests.Session()\n\n\nclass RpcError(Exception):\n    pass\n\n\nclass NetworkError(Exception):\n    pass\n\n\ndef rpc_call(method, params=None, timeout=60):\n    payload = {\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": method}\n    if params is not None:\n        payload[\"params\"] = params\n    try:\n        resp = session.post(RPC_URL, json=payload, timeout=timeout)\n        resp.raise_for_status()\n    except requests.RequestException as e:\n        raise NetworkError(\"network error: %s\" % e)\n    try:\n        data = resp.json()\n    except ValueError:\n        raise NetworkError(\"invalid JSON response from RPC\")\n    err = data.get(\"error\")\n    if err:\n        msg = err.get(\"message\") if isinstance(err, dict) else str(err)\n        raise R"]
[477.838686, "o", "cat > /app/server.py << 'PYEOF'"]
[477.838889, "i", "pcError(msg)\n    return data.get(\"result\")\n\n\ndef extract_token_transfers(tx):\n    meta = tx.get(\"meta\") or {}\n    pre = meta.get(\"preTokenBalances\") or []\n    post = meta.get(\"postTokenBalances\") or []\n    pre_by = {b[\"accountIndex\"]: b for b in pre}\n    post_by = {b[\"accountIndex\"]: b for b in post}\n    transfers = []\n    for idx, pb in post_by.items():\n        if idx in pre_by:\n            pre_b = pre_by[idx]\n            pre_amt = int((pre_b.get(\"uiTokenAmount\") or {}).get(\"amount\") or 0)\n            post_amt = int((pb.get(\"uiTokenAmount\") or {}).get(\"amount\") or 0)\n            delta = post_amt - pre_amt\n            if delta != 0:\n                transfers.append({\n                    \"account\": pre_b.get(\"owner\") or pb.get(\"owner\"),\n                    \"mint\": pb.get(\"mint\"),\n                    \"amount\": abs(delta),\n                })\n    return transfers\n\n\n@app.route(\"/status\")\ndef status():\n    try:\n        try:\n            rpc_call(\"getHealth\")\n            online = \"online\"\n        except Exception:\n  "]
[477.838959, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[477.839154, "i", "          online = \"offline\"\n        try:\n            slot = rpc_call(\"getSlot\")\n        except Exception:\n            slot = None\n        try:\n            nodes = rpc_call(\"getClusterNodes\")\n            node_count = len(nodes) if isinstance(nodes, list) else None\n        except Exception:\n            node_count = None\n        try:\n            ver = rpc_call(\"getVersion\")\n            version = ver.get(\"solana-core\") if isinstance(ver, dict) else None\n        except Exception:\n            version = None\n        return jsonify({\n            \"status\": online,\n            \"network\": NETWORK,\n            \"current_slot\": slot,\n            \"node_count\": node_count,\n            \"version\": version,\n        })\n    except Exception as e:\n        return jsonify({\"error\": str(e)})\n\n\n@app.route(\"/block/<int:slot>\")\ndef block(slot):\n    try:\n        res = rpc_call(\"getBlock\", [slot, {\"encoding\": \"json\",\n                                          \"transactionDetails\": \"none\",\n                                          \"rewards"]
[477.839245, "i", "\": False}])\n        if res is None:\n            return jsonify({\"error\": \"block not found at slot %d\" % slot}), 404\n        return jsonify({\n            \"blockhash\": res.get(\"blockhash\"),\n            \"parent_slot\": res.get(\"parentSlot\"),\n            \"previous_blockhash\": res.get(\"previousBlockhash\"),\n            \"block_height\": res.get(\"blockHeight\"),\n            \"block_time\": res.get(\"blockTime\"),\n        })\n    except (RpcError, NetworkError) as e:\n        return jsonify({\"error\": str(e)}), 404\n    except Exception as e:\n        return jsonify({\"error\": str(e)})\n\n\n@app.route(\"/transaction/<signature>\")\ndef transaction(signature):\n    try:\n        res = rpc_call(\"getTransaction\",\n                       [signature, {\"encoding\": \"json\",\n                                    \"maxSupportedTransactionVersion\": 0}])\n        if res is None:\n            return jsonify({\"error\": \"transaction not found\"}), 404\n        meta = res.get(\"meta\") or {}\n        err = meta.get(\"err\")\n        return jsonify({\n            \"signat"]
[477.839414, "o", "> "]
