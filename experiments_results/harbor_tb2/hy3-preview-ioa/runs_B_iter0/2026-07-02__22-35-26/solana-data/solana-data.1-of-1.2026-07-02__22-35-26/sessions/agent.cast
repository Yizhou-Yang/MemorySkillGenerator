[521.979774, "i", "python3 - << 'EOF'\nimport urllib.request, json\ndef get(path):\n    try:\n        r=urllib.request.urlopen('http://127.0.0.1:5000'+path, timeout=90)\n        print(path, '->', r.status, r.read().decode()[:300])\n    except urllib.error.HTTPError as e:\n        print(path, '-> HTTP', e.code, e.read().decode()[:300])\n    except Exception as e:\n        print(path, '-> ERR', repr(e))\nget('/status')\nget('/block/1')\nget('/transaction/abc')\nget('/account/11111111111111111111111111111111')\nget('/program/Vote111111111111111111111111111111111111111/accounts')\nget('/program/Vote111111111111111111111111111111111111111/accounts?limit=5&offset=0')\nEOF\n"]
