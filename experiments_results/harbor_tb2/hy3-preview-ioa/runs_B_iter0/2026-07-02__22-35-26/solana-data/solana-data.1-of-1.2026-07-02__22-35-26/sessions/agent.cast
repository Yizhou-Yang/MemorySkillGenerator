[164.491291, "i", "cat > /tmp/probe.py << 'EOF'\nimport socket, json\nhosts = [(\"localhost\",8899,\"http\"),(\"localhost\",80,\"http\"),(\"127.0.0.1\",5000,\"http\")]\nfor h,p,t in hosts:\n    try:\n        s=socket.create_connection((h,p),timeout=2)\n        print(f\"OPEN {h}:{p}\")\n        s.close()\n    except Exception as e:\n        print(f\"CLOSED {h}:{p} {e}\")\nEOF\npython3 /tmp/probe.py\n"]
