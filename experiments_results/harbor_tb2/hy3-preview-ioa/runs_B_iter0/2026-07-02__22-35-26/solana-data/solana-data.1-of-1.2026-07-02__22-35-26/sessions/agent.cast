[477.966165, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"error\": str(e)})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.route(\"/program/<program_id>/accounts\")\r\n\u001b[?2004l\r\u001b[?2004h> def program_accounts(program_id):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         limit = request.args.get(\"limit\", default=10, type=int)\r\n\u001b[?2004l\r\u001b[?2004h>         offset = request.args.get(\"offset\", default=0, type=int)\r\n\u001b[?2004l\r\u001b[?2004h>         if limit is None or limit < 0:\r\n\u001b[?2004l\r\u001b[?2004h>             limit = 10\r\n\u001b[?2004l\r\u001b[?2004h>         if offset is None or offset < 0:\r\n\u001b[?2004l\r\u001b[?2004h>             offset = 0\r\n\u001b[?2004l\r\u001b[?2004h>         accounts = rpc_call(\"getProgramAccounts\",\r\n\u001b[?2004l\r\u001b[?2004h>                             [program_id, {\"encoding\": \"base64\",\r\n\u001b[?2004l\r\u001b[?2004h>                                           \"commitment\": \"confirmed\"}]) or []\r\n\u001b[?2004l\r\u001b[?2004h>         total = len(accounts)\r\n\u001b[?2004l\r\u001b[?2004h>         page = accounts[offset:offset + limit]\r\n\u001b"]
[477.966317, "o", "[?2004l\r\u001b[?2004h>         out = []\r\n\u001b[?2004l\r\u001b[?2004h>         for a in page:\r\n\u001b[?2004l\r\u001b[?2004h>             acc = a.get(\"account\", {}) or {}\r\n\u001b[?2004l\r\u001b[?2004h>             out.append({\r\n\u001b[?2004l\r\u001b[?2004h>                 \"pubkey\": a.get(\"pubkey\"),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"account\": {\r\n\u001b[?2004l\r"]
[477.966463, "o", "\u001b[?2004h> "]
[477.966652, "o", "                    \"executable\": acc.get(\"executable\"),\r\n\u001b[?2004l\r"]
[477.96668, "o", "\u001b[?2004h"]
[477.966832, "o", "> "]
[477.967144, "o", "                    \"lamports\": acc.get(\"lamports\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[477.967868, "o", "                    \"owner\": acc.get(\"owner\"),\r\n\u001b[?2004l\r\u001b[?2004h>                     \"rent_epoch\": acc.get(\"rentEpoch\"),\r\n\u001b[?2004l\r\u001b[?2004h>                 },\r\n\u001b[?2004l\r\u001b[?2004h>             })\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[477.968051, "o", "            \"program_id\": program_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[477.968303, "o", "            \"total_accounts\": total,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[477.969451, "o", "            \"limit\": limit,\r\n\u001b[?2004l\r\u001b[?2004h>             \"offset\": offset,\r\n\u001b[?2004l\r\u001b[?2004h>             \"accounts\": out,\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     except (RpcError, NetworkError) as e:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"error\": str(e)})\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"error\": str(e)})\r\n\u001b[?2004l\r\u001b[?2004h"]
[477.969491, "o", "> "]
