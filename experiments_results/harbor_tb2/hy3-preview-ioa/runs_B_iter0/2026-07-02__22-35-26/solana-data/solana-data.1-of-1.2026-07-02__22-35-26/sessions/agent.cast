[208.888964, "i", "cat > /tmp/r.py << 'EOF'\nimport urllib.request,json,time\nurls=[\"https://api.devnet.solana.com\",\"https://api.testnet.solana.com\",\"https://api.mainnet-beta.solana.com\"]\nfor u in urls:\n    ok=False\n    for i in range(4):\n        try:\n            req=urllib.request.Request(u,data=json.dumps({'jsonrpc':'2.0','id':1,'method':'getHealth'}).encode(),headers={'Content-Type':'application/json'})\n            r=urllib.request.urlopen(req,timeout=8)\n            print(u,\"OK\",r.read().decode()[:80]); ok=True; break\n        except Exception as e:\n            time.sleep(1)\n    if not ok: print(u,\"FAILED all retries\")\nEOF\npython3 /tmp/r.py\n"]
