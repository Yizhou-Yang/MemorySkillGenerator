[695.164007, "i", "cat > /tmp/parse.py << 'EOF'\nimport struct\n\ndef readnum(buf, pos):\n    result = 0; shift = 0\n    while True:\n        b = buf[pos]; pos += 1\n        result |= (b & 0x7f) << shift\n        if not (b & 0x80):\n            break\n        shift += 7\n    return result, pos\n\ndata = open('/app/secrets.7z','rb').read()\nL = len(data)\nst = data[L-20:]\nnho = struct.unpack('<Q', st[0:8])[0]\nnhs = struct.unpack('<I', st[8:12])[0]\nnhc = struct.unpack('<I', st[12:16])[0]\nprint('nho',nho,'nhs',nhs,'nhc',hex(nhc))\nhdr_off = L - 32 - nho\nprint('hdr_off', hdr_off)\nheader = data[hdr_off:hdr_off+nhs]\nprint('header', header.hex())\nprint('header len', len(header))\nprint('packed region:', 32, '..', L-32, 'len', (L-32)-32)\nEOF\npython3 /tmp/parse.py\n"]
[695.165171, "o", "cat > /tmp/parse.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def readnum(buf, pos):\r\n\u001b[?2004l\r\u001b[?2004h>     result = 0; shift = 0\r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\n\u001b[?2004l\r\u001b[?2004h>         b = buf[pos]; pos += 1\r\n\u001b[?2004l\r\u001b[?2004h>         result |= (b & 0x7f) << shift"]
