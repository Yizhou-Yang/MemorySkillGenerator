[1182.279571, "o", "usage: mteb run [-h] [-m MODEL] [--task_types TASK_TYPES [TASK_TYPES ...]]\r\n                [--categories CATEGORIES [CATEGORIES ...]]\r\n                [-t TASKS [TASKS ...]] [-l [LANGUAGES ...]]\r\n                [-b BENCHMARKS [BENCHMARKS ...]] [--device DEVICE]\r\n                [--output_folder OUTPUT_FOLDER] [-v VERBOSITY]\r\n                [--co2_tracker CO2_TRACKER]\r\n                [--eval_splits EVAL_SPLITS [EVAL_SPLITS ...]]\r\n                [--model_revision MODEL_REVISION] [--batch_size BATCH_SIZE]\r\n                [--overwrite] [--save_predictions]\r\n\r\noptions:\r\n  -h, --help            show this help message and exit\r\n  -m MODEL, --model MODEL\r\n                        Model to use. Will priotize model implementation in\r\n                        MTEB's model registry, but default to loading the\r\n                        model using sentence-transformers.\r\n  --task_types TASK_TYPES [TASK_TYPES ...]\r\n                        List of task types (Clustering, Retrieval..) to be\r\n                        evalua"]
[1182.279749, "o", "ted. If None, the filter is not applied\r\n  --categories CATEGORIES [CATEGORIES ...]\r\n                        List of task categories (s2s, p2p..) to be evaluated.\r\n                        If None the filter is not applied\r\n  -t TASKS [TASKS ...], --tasks TASKS [TASKS ...]\r\n                        List of tasks to be evaluated. If specified, the other\r\n                        arguments are ignored.\r\n  -l [LANGUAGES ...], --languages [LANGUAGES ...]\r\n                        List of languages to be evaluated. if not set, all\r\n                        languages will be evaluated. Specified as ISO 639-3\r\n                        codes (e.g. eng, deu, fra).\r\n  -b BENCHMARKS [BENCHMARKS ...], --benchmarks BENCHMARKS [BENCHMARKS ...]\r\n                        List of benchmark to be evaluated.\r\n  --device DEVICE       Device to use for computation\r\n  --output_folder OUTPUT_FOLDER\r\n                        Output directory for results. Will default to\r\n                        `results` if not set.\r\n  -v VERBOSITY, --verbo"]
[1182.279817, "o", "sity VERBOSITY\r\n                        Verbosity level\r\n  --co2_tracker CO2_TRACKER\r\n                        Enable CO₂ tracker, disabled by default\r\n  --eval_splits EVAL_SPLITS [EVAL_SPLITS ...]\r\n                        Evaluation splits to use (train, dev, test..). If\r\n                        None, all splits will be used\r\n  --model_revision MODEL_REVISION\r\n                        Revision of the model to be loaded. Revisions are\r\n                        automatically read if the model is loaded from\r\n                        huggingface.\r\n  --batch_size BATCH_SIZE\r\n                        Batch size of the encode. Will be passed to the MTEB\r\n                        as MTEB.evaluate(model, encode_kwargs = {'batch_size':\r\n                        value}).\r\n  --overwrite           Overwrite the output file if it already exists\r\n  --save_predictions    For retrieval tasks. Saves the predictions file in\r\n                        output_folder.\r\n"]
