[88.608444, "i", "ayload, p)\n            types.append(t)\n        values = []\n        pos = hdr_len\n        for t in types:\n            if t == 0: v = None\n            elif t == 1: v = int.from_bytes(payload[pos:pos+1],'big',signed=True); pos+=1\n            elif t == 2: v = int.from_bytes(payload[pos:pos+2],'big',signed=True); pos+=2\n            elif t == 3: v = int.from_bytes(payload[pos:pos+3],'big',signed=True); pos+=3\n            elif t == 4: v = int.from_bytes(payload[pos:pos+4],'big',signed=True); pos+=4\n            elif t == 5: v = int.from_bytes(payload[pos:pos+6],'big',signed=True); pos+=6\n            elif t == 6: v = int.from_bytes(payload[pos:pos+8],'big',signed=True); pos+=8\n            elif t == 7: v = struct.unpack('>d', payload[pos:pos+8])[0]; pos+=8\n            elif t == 8: v = 0\n            elif t == 9: v = 1\n            elif t >= 12:\n                if t % 2 == 0:\n                    n = (t-12)//2; v = payload[pos:pos+n]; pos+=n\n                else:\n                    n = (t-13)//2; v = payload[pos:pos+n].decode('utf-8','replace'); pos+=n\n            else: v = None\n            values.append(v)\n        print(i, 'rowid', rowid, 'values', values)\n        rows.append({'word': values[0], 'value': values[1]})\n    except Exception as e:\n        fails += 1\n        print('cell', i, 'FAILED:', e)\n\nprint('recovered', len(rows), 'failed', fails)\nwith open('/app/recover.json','w') as f:\n    json.dump(rows, f)\nEOF\npython3 /app/parse.py\n"]
