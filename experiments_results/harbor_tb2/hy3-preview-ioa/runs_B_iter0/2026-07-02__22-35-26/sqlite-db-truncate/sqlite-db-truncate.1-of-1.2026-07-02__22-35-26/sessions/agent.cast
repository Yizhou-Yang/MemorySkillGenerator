[88.602262, "i", "cat > /app/parse.py << 'EOF'\nimport struct, json\n\nd = open('/app/trunc.db','rb').read()\n\ndef read_varint(buf, off):\n    result = 0\n    for i in range(9):\n        b = buf[off+i]\n        if i == 8:\n            result = (result << 8) | b\n            return result, off+9\n        result = (result << 7) | (b & 0x7f)\n        if not (b & 0x80):\n            return result, off+i+1\n    return result, off+9\n\npage_type = d[0]\nprint('page type byte:', hex(page_type))\ncell_count = int.from_bytes(d[3:5],'big')\ncell_start = int.from_bytes(d[5:7],'big')\nprint('cell_count', cell_count, 'cell_start', cell_start)\n\nrows = []\nfails = 0\nfor i in range(cell_count):\n    ptr = int.from_bytes(d[8+2*i:10+2*i],'big')\n    try:\n        off = ptr\n        payload_len, off = read_varint(d, off)\n        rowid, off = read_varint(d, off)\n        payload = d[off:off+payload_len]\n        hdr_len, p = read_varint(payload, 0)\n        types = []\n        while p < hdr_len:\n            t, p = read_varint(p"]
