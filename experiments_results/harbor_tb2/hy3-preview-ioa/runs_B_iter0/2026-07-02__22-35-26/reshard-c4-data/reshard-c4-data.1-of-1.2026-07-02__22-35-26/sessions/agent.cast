[256.708106, "i", "cat > /tmp/build_reshard.py << 'PYEOF'\nimport os, shutil, glob\n\nSRC = \"/app/c4_sample\"\nDST = \"/app/c4_reshard\"\nMAXF = 30\n\nos.makedirs(DST, exist_ok=True)\nfiles = sorted(os.path.basename(f) for f in glob.glob(os.path.join(SRC, \"*\"))\n               if os.path.isfile(os.path.join(SRC, f)))\n\nfolders = []\ndef get_folder(i):\n    fi = i // MAXF\n    while len(folders) <= fi:\n        p = os.path.join(DST, \"part_%04d\" % len(folders))\n        os.makedirs(p, exist_ok=True)\n        folders.append(p)\n    return folders[fi]\n\nfor i, name in enumerate(files):\n    src = os.path.join(SRC, name)\n    dst = os.path.join(get_folder(i), name)\n    shutil.copy2(src, dst)\n\nprint(\"files:\", len(files), \"folders:\", len(folders))\nPYEOF\n"]
