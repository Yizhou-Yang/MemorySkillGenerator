[307.230655, "i", "cat > findpeaks.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('/tmp/graphene_conv.txt')\nx = data[:,0]; y = data[:,1]\norder = np.argsort(x)\nx = x[order]; y = y[order]\nw = 15\nker = np.ones(w)/w\nys = np.convolve(y, ker, mode='same')\nmaxs = []\nfor i in range(1, len(x)-1):\n    if ys[i] > ys[i-1] and ys[i] >= ys[i+1]:\n        maxs.append((ys[i], x[i], i))\nmaxs.sort(reverse=True)\nprint('Baseline rough (median y):', np.median(y))\nprint('Top smoothed local maxima:')\nfor v, xx, i in maxs[:20]:\n    print('x=%.2f y=%.1f' % (xx, v))\nEOF\npython3 findpeaks.py\n"]
