[175.704851, "i", "cat > explore.py << 'EOF'\nimport numpy as np\nwith open('graphene.dat') as f:\n    txt = f.read().replace(',', '.')\nwith open('/tmp/graphene_conv.txt','w') as f:\n    f.write(txt)\ndata = np.loadtxt('/tmp/graphene_conv.txt')\nx = data[:,0]; y = data[:,1]\nprint('n =', len(x))\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\norder = np.argsort(x)\nx = x[order]; y = y[order]\nidx = np.argsort(y)[::-1][:10]\nfor i in idx:\n    print('x=%.3f y=%.3f' % (x[i], y[i]))\nEOF\npython3 explore.py\n"]
