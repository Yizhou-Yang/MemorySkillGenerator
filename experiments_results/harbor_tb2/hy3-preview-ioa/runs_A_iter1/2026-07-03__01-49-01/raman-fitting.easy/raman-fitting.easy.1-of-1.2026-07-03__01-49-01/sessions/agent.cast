[197.506506, "i", "cat > scan.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('/tmp/graphene_conv.txt')\nx = data[:,0]; y = data[:,1]\norder = np.argsort(x)\nx = x[order]; y = y[order]\n# local maxima\nmaxs = []\nfor i in range(1, len(x)-1):\n    if y[i] > y[i-1] and y[i] >= y[i+1]:\n        maxs.append((y[i], x[i], i))\nmaxs.sort(reverse=True)\nprint('Top local maxima by intensity:')\nfor yy, xx, i in maxs[:15]:\n    print('x=%.3f y=%.3f' % (xx, yy))\nprint('--- peaks with y>10000 ---')\nfor yy, xx, i in maxs:\n    if yy > 10000:\n        print('x=%.3f y=%.3f' % (xx, yy))\nEOF\npython3 scan.py\n"]
[197.506565, "o", "cat > scan.py << 'EOF'"]
