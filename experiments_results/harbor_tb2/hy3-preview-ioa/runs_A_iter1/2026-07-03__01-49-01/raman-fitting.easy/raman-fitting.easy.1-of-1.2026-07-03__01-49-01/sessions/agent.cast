[308.082851, "o", "\u001b[?2004hroot@1e3fed7d83ee:/app# "]
[331.550648, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.loadtxt('/tmp/graphene_conv.txt')\nx = data[:,0]; y = data[:,1]\norder = np.argsort(x)\nx = x[order]; y = y[order]\n\ndef lor(x, x0, gamma, amp, offset):\n    return offset + amp / (1.0 + ((x - x0)/gamma)**2)\n\ndef fit_peak(xmin, xmax, name):\n    m = (x >= xmin) & (x <= xmax)\n    xw, yw = x[m], y[m]\n    imax = np.argmax(yw)\n    x0g = xw[imax]\n    offg = np.percentile(yw, 10)\n    ampg = yw[imax] - offg\n    gammag = 80.0\n    p0 = [x0g, gammag, ampg, offg]\n    popt, pcov = curve_fit(lor, xw, yw, p0=p0, maxfev=100000)\n    resid = np.sum((lor(xw, *popt) - yw)**2)\n    print('%s: x0=%.3f gamma=%.3f amp=%.3f offset=%.3f (resid=%.2e)' % (name, *popt, resid))\n    return popt\n\npG = fit_peak(17000, 21000, 'G')\np2D = fit_peak(31000, 37000, '2D')\n\nresults = {\n    'G':  {'x0': float(pG[0]), 'gamma': float(abs(pG[1])), 'amplitude': float(pG[2]), 'offset': float(pG[3])},\n    '2D': {'x0': float(p2D[0]), 'gamma': float(abs(p2D[1])), 'a"]
[331.55073, "i", "mplitude': float(p2D[2]), 'offset': float(p2D[3])},\n}\nwith open('results.json','w') as f:\n    json.dump(results, f, indent=2)\nprint('--- results.json ---')\nprint(open('results.json').read())\nEOF\npython3 fit.py\n"]
[331.553467, "o", "cat > fit.py << 'EOF'\r\n\u001b[?2004l\r"]
[331.553818, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[331.55399, "o", "> "]
[331.554154, "o", "data = np.loadtxt('/tmp/graphene_conv.txt')\r\n\u001b[?2004l\r\u001b[?2004h> x = data[:,0]; y = data[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.554278, "o", "order = np.argsort(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.554425, "o", "x = x[order]; y = y[order]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.554457, "o", "def lor(x, x0, gamma, amp, offset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.554612, "o", "    return offset + amp / (1.0 + ((x - x0)/gamma)**2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.557903, "o", "def fit_peak(xmin, xmax, name):\r\n\u001b[?2004l\r\u001b[?2004h>     m = (x >= xmin) & (x <= xmax)\r\n\u001b[?2004l\r\u001b[?2004h>     xw, yw = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     imax = np.argmax(yw)\r\n\u001b[?2004l\r\u001b[?2004h>     x0g = xw[imax]\r\n\u001b[?2004l\r\u001b[?2004h>     offg = np.percentile(yw, 10)\r\n\u001b[?2004l\r\u001b[?2004h>     ampg = yw[imax] - offg\r\n\u001b[?2004l\r\u001b[?2004h>     gammag = 80.0\r\n\u001b[?2004l\r\u001b[?2004h>     p0 = [x0g, gammag, ampg, offg]\r\n\u001b[?2004l\r\u001b[?2004h>     popt, pcov = curve_fit(lor, xw, yw, p0=p0, maxfev=100000)\r\n\u001b[?2004l\r\u001b[?2004h>     resid = np.sum((lor(xw, *popt) - yw)**2)\r\n\u001b[?2004l\r\u001b[?2004h>     print('%s: x0=%.3f gamma=%.3f amp=%.3f offset=%.3f (resid=%.2e)' % (name, *popt, resid))\r\n\u001b[?2004l\r\u001b[?2004h>     return popt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pG = fit_peak(17000, 21000, 'G')\r\n\u001b[?2004l\r\u001b[?2004h> p2D = fit_peak(31000, 37000, '2D')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results = {\r\n\u001b[?2004l\r\u001b[?2004h>     'G':  {'x0': float(pG[0]), 'gamma': float(abs(pG[1])), 'amplitude': float(pG[2]), 'offset': float(pG[3])},\r\n\u001b[?2004"]
[331.557955, "o", "l\r\u001b[?2004h> "]
