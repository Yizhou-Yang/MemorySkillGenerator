[164.670506, "i", "cat > explore.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('graphene.dat', delimiter=' ', converters={0: lambda s: float(s.decode().replace(',','.')), 1: lambda s: float(s.decode().replace(',','.'))})\nx = data[:,0]; y = data[:,1]\nprint('n =', len(x))\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\norder = np.argsort(x)\nx = x[order]; y = y[order]\n# top 10 intensity points\nidx = np.argsort(y)[::-1][:10]\nfor i in idx:\n    print('x=%.3f y=%.3f' % (x[i], y[i]))\nEOF\npython3 explore.py\n"]
