[490.699772, "o", "\u001b[?2004hroot@9ad5ea85488f:/app# "]
[492.672786, "i", "cat > /app/verify.py << 'PYEOF'\nimport struct, csv\n\ndef read_uv(buf, pos):\n    shift=0; result=0\n    while True:\n        b=buf[pos]; pos+=1\n        result |= (b & 0x7f) << shift\n        if not (b & 0x80): break\n        shift+=7\n    return result, pos\n\ndef read_zv(buf, pos):\n    u,pos = read_uv(buf,pos)\n    return (u >> 1) ^ -(u & 1), pos\n\ndef read_value(buf, pos, ttype):\n    if ttype in (5,6):\n        return read_zv(buf, pos)\n    if ttype == 3:\n        return buf[pos], pos+1\n    if ttype == 7:\n        return struct.unpack('<d', buf[pos:pos+8])[0], pos+8\n    if ttype == 8:\n        l,pos = read_uv(buf,pos)\n        return buf[pos:pos+l], pos+l\n    if ttype == 12:\n        return read_struct(buf,pos)\n    if ttype == 9:\n        b=buf[pos]; pos+=1\n        if b & 0xF0 == 0xF0:\n            size,pos = read_uv(buf,pos)\n            etype = buf[pos]; pos+=1\n        else:\n            size = b>>4; etype = b&0x0F\n        elems=[]\n        for _ in range(size):\n            v,pos "]
[492.678551, "o", "cat > /app/verify.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct, csv"]
[492.680211, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.681793, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.683569, "o", "> def read_uv(buf, pos):"]
[492.685337, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[492.685414, "o", "> "]
[492.685568, "o", "    shift=0; result=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.685628, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[492.685649, "i", "= read_value(buf,pos,etype)\n            elems.append(v)\n        return elems, pos\n    raise ValueError('unknown ttype %d' % ttype)\n\ndef read_struct(buf, pos):\n    fields={}; last=0\n    while True:\n        b=buf[pos]; pos+=1\n        if b==0: break\n        delta=(b>>4)&0x0F; ttype=b&0x0F\n        if delta==0:\n            fid,pos=read_zv(buf,pos)\n        else:\n            fid=last+delta\n        last=fid\n        v,pos=read_value(buf,pos,ttype)\n        fields[fid]=v\n    return fields,pos\n\nwith open('/app/data.parquet','rb') as f:\n    data=f.read()\nassert data[:4]==b'PAR1' and data[-4:]==b'PAR1', 'bad magic'\nfooter_len=int.from_bytes(data[-8:-4],'little')\nfooter=data[len(data)-8-footer_len:len(data)-8]\nfm,_=read_struct(footer,0)\nprint('num_rows =', fm[3])\nschema=fm[2]\nprint('schema: %d elements' % len(schema))\nfor s in schema:\n    print('   name=%s type=%s rep=%s children=%s conv=%s' % (s[1], s.get(2), s.get(4), s.get(5), s.get(6)))\nrg=fm[4][0]\ncols=rg[1]\nprint('row group: %d cols, %d rows' % (len(cols), rg[3]))\nrows=list(csv.reader(open('/app/data.csv', newline='')))\nheader=rows[0]; data_rows=rows[1:]\nallok=True\nfor idx,col in enumerate(cols):\n    meta=col[2]; offset=col[1]\n    type_=meta[1]; path=meta[3]\n    name=path[0].decode() if isinstance(path[0],bytes) else path[0]\n    comp=meta[6]\n    ph,pend=read_struct(data, offset)\n    dph=ph[5]; body=data[offset+pend:offset+pend+comp]\n    vals=[]; p=0\n    if type_==1:\n        while p<len(body): vals.append(struct.unpack('<i',body[p:p+4])[0]); p+=4\n    elif type_==2:\n        while p<len(body): vals.append(struct.unpack('<q',body[p:p+8])[0]); p+=8\n    elif type_==5:\n        while p<len(body): vals.append(struct.unpack('<d',body[p:p+8])[0]); p+=8\n    elif type_==6:\n        while p<len(body):\n            l=int.from_bytes(body[p:p+4],'little'); p+=4\n            vals.append(body[p:p+l].decode()); p+=l\n    else:\n        raise ValueError('type %d'%type_)\n    expected=[(r[idx] if idx<len(r) else '') for r in data_rows]\n    ok=[str(v) for v in vals]==expected\n    allok=allok and ok\n    print('col %d %s type=%s n=%s -> %s %s' % (idx,name,type_,dph[1],vals,'OK' if ok else 'MISMATCH %s'%expected))\nprint('RESULT: ALL OK' if allok else 'RESULT: MISMATCH')\nPYEOF\n"]
