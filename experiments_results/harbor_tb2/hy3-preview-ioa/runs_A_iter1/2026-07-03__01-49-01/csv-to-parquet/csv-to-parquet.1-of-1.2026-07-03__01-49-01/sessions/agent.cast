[578.070365, "i", "cat > /app/dbg.py << 'PYEOF'\nimport struct\ndef read_uv(buf,pos):\n    shift=0;result=0\n    while True:\n        b=buf[pos];pos+=1\n        result|=(b&0x7f)<<shift\n        if not (b&0x80):break\n        shift+=7\n    return result,pos\ndef read_zv(buf,pos):\n    u,pos=read_uv(buf,pos)\n    return (u>>1)^-(u&1),pos\ndef read_value(buf,pos,t):\n    if t in (5,6):return read_zv(buf,pos)\n    if t==3:return buf[pos],pos+1\n    if t==7:return struct.unpack('<d',buf[pos:pos+8])[0],pos+8\n    if t==8:\n        l,pos=read_uv(buf,pos);return buf[pos:pos+l],pos+l\n    if t==12:return read_struct(buf,pos)\n    if t==9:\n        b=buf[pos];pos+=1\n        if b&0xF0==0xF0:\n            size,pos=read_uv(buf,pos);etype=buf[pos];pos+=1\n        else:size=b>>4;etype=b&0x0F\n        elems=[]\n        for _ in range(size):\n            v,pos=read_value(buf,pos,etype);elems.append(v)\n        return elems,pos\n    return ('raw_t%d'%t,buf[pos]),pos+1\ndef read_struct(buf,pos):\n    f={};last=0\n    while True:\n"]
[578.070797, "i", "        b=buf[pos];pos+=1\n        if b==0:break\n        d=(b>>4)&0x0F;tt=b&0x0F\n        if d==0:fid,pos=read_zv(buf,pos)\n        else:fid=last+d\n        last=fid\n        v,pos=read_value(buf,pos,tt);f[fid]=v\n    return f,pos\nwith open('/app/data.parquet','rb') as fh:\n    data=fh.read()\nfl=int.from_bytes(data[-8:-4],'little')\nfooter=data[len(data)-8-fl:len(data)-8]\nfm,_=read_struct(footer,0)\nrg=fm[4][0]\nfor i,c in enumerate(rg[1]):\n    off=c.get(1)\n    print('col',i,'file_offset=',off,'first16=',data[off:off+16].hex())\n    # manual page header walk\n    p=off\n    b=data[p];p+=1\n    print('  first byte 0x%02x (delta=%d ttype=%d)'%(b,(b>>4)&0x0F,b&0x0F))\nPYEOF\npython3 /app/dbg.py\n"]
[578.071145, "o", "cat > /app/dbg.py << 'PYEOF'"]
