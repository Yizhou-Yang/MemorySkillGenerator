[422.106408, "i", "cat > /app/convert.py << 'PYEOF'\nimport csv, struct, sys\n\ndef write_uv(buf, n):\n    while True:\n        b = n & 0x7f\n        n >>= 7\n        if n:\n            buf.append(b | 0x80)\n        else:\n            buf.append(b)\n            break\n\ndef write_zv(buf, n):\n    z = (n << 1) ^ (n >> 63)\n    write_uv(buf, z)\n\nclass T:\n    def __init__(self):\n        self.buf = bytearray()\n        self.last = 0\n    def fh(self, fid, t):\n        if 0 < fid - self.last <= 15:\n            self.buf.append(((fid - self.last) << 4) | t)\n        else:\n            self.buf.append(0xF0 | t)\n            write_zv(self.buf, fid)\n        self.last = fid\n    def i32(self, fid, v):\n        self.fh(fid, 5); write_zv(self.buf, v)\n    def i64(self, fid, v):\n        self.fh(fid, 6); write_zv(self.buf, v)\n    def byte(self, fid, v):\n        self.fh(fid, 3); self.buf.append(v & 0xff)\n    def dbl(self, fid, v):\n        self.fh(fid, 7); self.buf += struct.pack('<d', v)\n    def bin(self, fid, b):\n        self.fh(fid, 8); write_uv(self.buf, len(b)); self.buf += b\n    def stri(self, fid, s):\n        self.bin(fid, s.encode('utf-8'))\n    def struct(self, fid, child):\n        self.fh(fid, 12); self.buf += child.buf; self.buf.append(0x00)\n    def list(self, fid, etype, count):\n        self.fh(fid, 9)\n        if count < 15:\n            self.buf.append((count << 4) | etype)\n        else:\n            self.buf.append(0xF0 | etype)\n            write_uv(self.buf, count)\n\ndef build_page(values):\n    int_ok = True\n    for v in values:\n        try:\n            int(v)\n        except Exception:\n            int_ok = False; break\n    if int_ok:\n        ints = [int(v) for v in values]\n        if all(-2**31 <= x < 2**31 for x in ints):\n            data = b''.join(struct.pack('<i', x) for x in ints)\n            return 1, None, data\n        else:\n            data = b''.join(struct.pack('<q', x) for x in ints)\n            return 2, None, data\n    float_ok = True\n    for v in values:\n        try:\n            float(v)\n        except Exception:\n            float_ok = False; break\n    if float_ok:\n        data = b''.join(struct.pack('<d', float(v)) for v in values)\n        return 5, None, data\n    data = bytearray()\n    for v in values:\n        b = v.encode('utf-8')\n        data += struct.pack('<i', len(b))\n        data += b\n    return 6, 0, data\n\ndef data_page_header(num_values):\n    s = T()\n    s.i32(1, num_values)\n    s.i32(2, 0)\n    s.i32(3, 3)\n    s.i32(4, 3)\n    return s\n\ndef page_header(uncompressed, compressed, dph):\n    s = T()\n    s.i32(1, 0)\n    s.i32(2, uncompressed)\n    s.i32(3, compressed)\n    s.struct(5, dph)\n    return s\n\ndef column_meta(type_code, path, num_values, total_un, total_co, offset):\n    s = T()\n    s.i32(1, type_code)\n    s.list(2, 5, 2)\n    write_zv(s.buf, 0)\n    write_zv(s.buf, 3)\n    s.list(3, 8, 1)\n    pb = path.encode('utf-8')\n    write_uv(s.buf, len(pb)); s.buf += pb\n    s.i32(4, 0)\n    s.i64(5, num_values)\n    s.i64(6, total_un)\n    s.i64(7, total_co)\n    s.i64(9, offset)\n    return s\n\ndef column_chunk(file_offset, meta):\n    s = T()\n    s.i64(1, file_offset)\n    s.struct(2, meta)\n    return s\n\ndef row_group(column_structs, total_bytes, num_rows):\n    s = T()\n    s.list(1, 12, len(column_structs))\n    for cc in column_structs:\n        s.buf += cc.buf; s.buf.append(0x00)\n    s.i64(2, total_bytes)\n    s.i64(3, num_rows)\n    return s\n\ndef schema_element(name, type_code, converted, rep_type, num_children):\n    s = T()\n    s.stri(1, name)\n    if type_code is not None:\n        s.i32(2, type_code)\n    s.i32(4, rep_type)\n    if num_children is not None:\n        s.i32(5, num_children)\n    if converted is not None:\n        s.i32(6, converted)\n    return s\n\ndef file_meta(schema_elems, num_rows, row_groups_structs):\n    s = T()\n    s.i32(1, 1)\n    s.list(2, 12, len(schema_elems))\n    for e in schema_elems:\n        s.buf += e.buf; s.buf.append(0x00)\n    s.i64(3, num_rows)\n    s.list(4, 12, len(row_groups_structs))\n    for rg in row_groups_structs:\n        s.buf += rg.buf; s.buf.append(0x00)\n    s.stri(6, 'parquet-csv-converter')\n    return s\n\ndef try_pyarrow():\n    "]
[422.106569, "i", "try:\n        import pyarrow as pa\n        import pyarrow.csv as pac\n    except Exception:\n        return False\n    try:\n        table = pac.read_csv('/app/data.csv')\n        pa.parquet.write_table(table, '/app/data.parquet')\n        print('wrote /app/data.parquet via pyarrow')\n        return True\n    except Exception as e:\n        print('pyarrow failed, fallback:', e)\n        return False\n\ndef main():\n    with open('/app/data.csv', newline='') as f:\n        rows = list(csv.reader(f))\n    if not rows:\n        raise SystemExit('empty csv')\n    header = rows[0]\n    data_rows = rows[1:]\n    nrows = len(data_rows)\n    ncols = len(header)\n    cols = []\n    for j in range(ncols):\n        vals = [(row[j] if j < len(row) else '') for row in data_rows]\n        cols.append(build_page(vals))\n    out = bytearray(b'PAR1')\n    offsets = []\n    ph_bufs = []\n    pages = []\n    for j in range(ncols):\n        offset = len(out)\n        offsets.append(offset)\n        dph = data_page_header(nrows)\n        ph = page_header(len(cols[j][2]), len(cols[j][2]), dph)\n        ph_bufs.append(bytes(ph.buf))\n        pages.append(cols[j][2])\n        out += ph.buf\n        out += cols[j][2]\n    column_structs = []\n    total = 0\n    for j in range(ncols):\n        chunk_size = len(ph_bufs[j]) + len(pages[j])\n        total += chunk_size\n        meta = column_meta(cols[j][0], header[j], nrows, chunk_size, chunk_size, offsets[j])\n        column_structs.append(column_chunk(offsets[j], meta))\n    rg = row_group(column_structs, total, nrows)\n    schema_elems = [schema_element('schema', None, None, 1, ncols)]\n    for j in range(ncols):\n        schema_elems.append(schema_element(header[j], cols[j][0], cols[j][1], 1, 0))\n    fm = file_meta(schema_elems, nrows, [rg])\n    footer = bytes(fm.buf) + b'\\x00'\n    out += footer\n    out += struct.pack('<I', len(footer))\n    out += b'PAR1'\n    with open('/app/data.parquet', 'wb') as f:\n        f.write(out)\n    with open('/app/data.parquet', 'rb') as f:\n        data = f.read()\n    assert data[:4] == b'PAR1' and data[-4:] == b'PAR1'\n    flen = int.from_bytes(data[-8:-4], 'little')\n    assert flen == len(data) - 8, (flen, len(data))\n    print('wrote /app/data.parquet', len(out), 'bytes, rows=', nrows, 'cols=', ncols, 'footer_len=', flen)\n\nif __name__ == '__main__':\n    if not try_pyarrow():\n        main()\nPYEOF\n"]
