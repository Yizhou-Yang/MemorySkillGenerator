[563.465403, "i", "cat > /app/dbg.py << 'PYEOF'\nimport struct\nfrom verify import read_struct, read_uv, read_zv\nwith open('/app/data.parquet','rb') as f:\n    data=f.read()\nfooter_len=int.from_bytes(data[-8:-4],'little')\nfooter=data[len(data)-8-footer_len:len(data)-8]\nfm,_=read_struct(footer,0)\nrg=fm[4][0]\ncols=rg[1]\nfor i,c in enumerate(cols):\n    print('col',i,'file_offset=',c.get(1),'meta_keys=',sorted(c.get(2,{}).keys()))\n    off=c.get(1)\n    print('  bytes at off:', data[off:off+16].hex())\nPYEOF\npython3 /app/dbg.py\n"]
