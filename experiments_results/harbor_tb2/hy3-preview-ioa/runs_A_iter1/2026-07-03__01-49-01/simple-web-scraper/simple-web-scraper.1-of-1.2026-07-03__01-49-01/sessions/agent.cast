[56.747935, "i", "cat > /app/scraper.py << 'EOF'\nimport re\nimport requests\nfrom bs4 import BeautifulSoup\nimport pandas as pd\n\nURL = \"http://server:8000\"\n\n\ndef main():\n    resp = requests.get(URL, timeout=15)\n    resp.raise_for_status()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n\n    books = []\n    for book in soup.find_all(\"div\", class_=\"book\"):\n        title_tag = book.find(\"div\", class_=\"book-title\")\n        author_tag = book.find(\"div\", class_=\"book-author\")\n        year_tag = book.find(\"span\", class_=\"book-year\")\n        rating_tag = book.find(\"span\", class_=\"book-rating\")\n        price_tag = book.find(\"span\", class_=\"book-price\")\n\n        title = title_tag.get_text(strip=True) if title_tag else \"\"\n        author = \"\"\n        if author_tag:\n            author = re.sub(r\"^by\\s+\", \"\", author_tag.get_text(strip=True))\n        year = int(re.search(r\"\\d{4}\", year_tag.get_text())) if year_tag and re.search(r\"\\d{4}\", year_tag.get_text()) else None\n        rating = float(re.search(r\"[\\d.]+\\s*/\\s*5\", rating_tag.get_text())."]
[56.74799, "i", "group().split(\"/\")[0].strip()) if rating_tag and re.search(r\"[\\d.]+\\s*/\\s*5\", rating_tag.get_text()) else None\n        price = float(re.sub(r\"[^\\d.]\", \"\", price_tag.get_text())) if price_tag else None\n\n        books.append({\n            \"title\": title,\n            \"author\": author,\n            \"year\": year,\n            \"rating\": rating,\n            \"price\": price,\n        })\n\n    df = pd.DataFrame(books, columns=[\"title\", \"author\", \"year\", \"rating\", \"price\"])\n    df.to_csv(\"/app/books.csv\", index=False)\n\n    total = len(df)\n    avg_price = df[\"price\"].mean()\n    highest = df.loc[df[\"rating\"].idxmax()]\n\n    lines = []\n    lines.append(\"Book Store Scraping Summary Report\")\n    lines.append(\"=\" * 40)\n    lines.append(f\"Total number of books scraped: {total}\")\n    lines.append(f\"Average book price: ${avg_price:.2f}\")\n    lines.append(f\"Highest rated book: {highest['title']} by {highest['author']} (Rating: {highest['rating']}/5)\")\n\n    with open(\"/app/report.txt\", \"w\") as f:\n        f.write(\"\\n\".join(lines) + \"\\n\""]
[56.748017, "i", ")\n\n    print(\"\\n\".join(lines))\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
