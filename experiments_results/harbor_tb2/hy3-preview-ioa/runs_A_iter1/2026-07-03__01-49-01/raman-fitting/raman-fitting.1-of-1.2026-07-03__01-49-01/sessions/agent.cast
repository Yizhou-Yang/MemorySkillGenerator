[119.547388, "i", "cat > /tmp/explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        parts = line.split()\n        if len(parts) < 2:\n            continue\n        xs.append(float(parts[0].replace(',', '.')))\n        ys.append(float(parts[1].replace(',', '.')))\nx = np.array(xs); y = np.array(ys)\nidx = np.argsort(x); x = x[idx]; y = y[idx]\nprint('n=', len(x), 'x', x.min(), x.max(), 'y', y.min(), y.max())\npk, props = find_peaks(y, prominence=0.05*(y.max()-y.min()), distance=10)\nprint('num peaks', len(pk))\nfor i, p in enumerate(pk):\n    print(f'x={x[p]:.2f} y={y[p]:.1f} prom={props[\"prominences\"][i]:.1f}')\nEOF\npython3 /tmp/explore.py\n"]
