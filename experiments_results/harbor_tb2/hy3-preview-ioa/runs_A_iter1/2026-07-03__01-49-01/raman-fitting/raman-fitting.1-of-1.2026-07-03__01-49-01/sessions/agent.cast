[560.783311, "i", "cat > /tmp/fit.py << 'EOF'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p = line.split()\n        if len(p) < 2: continue\n        xs.append(float(p[0].replace(',', '.')))\n        ys.append(float(p[1].replace(',', '.')))\nx = np.array(xs); y = np.array(ys)\nidx = np.argsort(x); x = x[idx]; y = y[idx]\n\ndef lor(x, x0, g, a):\n    return a*g*g/((x-x0)**2 + g*g)\n\ndef model(x, c0, c1, x0, g, a):\n    return c0 + c1*x + lor(x, x0, g, a)\n\ndef fit(lo, hi, x0g, gg, ag, c0g, c1g):\n    m = (x>=lo)&(x<=hi)\n    xf, yf = x[m], y[m]\n    p0 = [c0g, c1g, x0g, gg, ag]\n    popt, _ = curve_fit(model, xf, yf, p0=p0, maxfev=200000,\n                        bounds=([0,-5,x0g-3000,1,0],[1e6,5,x0g+3000,5000,1e6]))\n    c0,c1,x0,g,a = popt\n    fitv = model(xf,*popt)\n    ss = np.sum((yf-fitv)**2); sst = np.sum((yf-np.mean(yf))**2)\n    r2 = 1-ss/sst\n    off = c0 + c1*x0\n    return dict(x0=float(x0), gamma=float(g), amplitude=float(a), offset=float("]
[560.78337, "i", "off)), r2\n\ng, r2g = fit(18100, 19900, 19139, 530, 60000, 30000, 0.0)\nd, r2d = fit(31200, 35400, 33245, 850, 2500, 19000, 0.0)\nprint('G :', g, 'R2=%.5f'%r2g)\nprint('2D:', d, 'R2=%.5f'%r2d)\n\nres = {'G': g, '2D': d}\nwith open('/app/results.json','w') as f:\n    json.dump(res, f, indent=2)\nprint('written')\nEOF\npython3 /tmp/fit.py\n"]
[560.783677, "o", "cat > /tmp/fit.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np, json\r\n\u001b[?2004l\r\u001b[?2004h"]
[560.790439, "o", "> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> xs, ys = [], []\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         p = line.split()\r\n\u001b[?2004l\r\u001b[?2004h>         if len(p) < 2: continue\r\n\u001b[?2004l\r\u001b[?2004h>         xs.append(float(p[0].replace(',', '.')))\r\n\u001b[?2004l\r\u001b[?2004h>         ys.append(float(p[1].replace(',', '.')))\r\n\u001b[?2004l\r\u001b[?2004h> x = np.array(xs); y = np.array(ys)\r\n\u001b[?2004l\r\u001b[?2004h> idx = np.argsort(x); x = x[idx]; y = y[idx]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lor(x, x0, g, a):\r\n\u001b[?2004l\r\u001b[?2004h>     return a*g*g/((x-x0)**2 + g*g)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def model(x, c0, c1, x0, g, a):\r\n\u001b[?2004l\r\u001b[?2004h>     return c0 + c1*x + lor(x, x0, g, a)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fit(lo, hi, x0g, gg, ag, c0g, c1g):\r\n\u001b[?2004l\r\u001b[?2004h>     m = (x>=lo)&(x<=hi)\r\n\u001b[?2004l\r\u001b[?2004h>     xf, yf = x[m], y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     p0 = [c0g, c1g, x0g, gg, ag]\r\n\u001b[?2"]
[560.790483, "o", "004l\r\u001b[?2004h>     popt, _ = curve_fit(model, xf, yf, p0=p0, maxfev=200000,\r\n\u001b[?2004l\r\u001b[?2004h>                         bounds=([0,-5,x0g-3000,1,0],[1e6,5,x0g+3000,5000,1e6]))\r\n\u001b[?2004l\r\u001b[?2004h>     c0,c1,x0,g,a = popt\r\n\u001b[?2004l\r\u001b[?2004h>     fitv = model(xf,*popt)\r\n\u001b[?2004l\r\u001b[?2004h>     ss = np.sum((yf-fitv)**2); sst = np.sum((yf-np.mean(yf))**2)\r\n\u001b[?2004l\r\u001b[?2004h>     r2 = 1-ss/sst\r\n\u001b[?2004l\r\u001b[?2004h>     off = c0 + c1*x0\r\n\u001b[?2004l\r\u001b[?2004h>     return dict(x0=float(x0), gamma=float(g), amplitude=float(a), offset=float(off)), r2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> g, r2g = fit(18100, 19900, 19139, 530, 60000, 30000, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> d, r2d = fit(31200, 35400, 33245, 850, 2500, 19000, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> print('G :', g, 'R2=%.5f'%r2g)\r\n\u001b[?2004l\r\u001b[?2004h> print('2D:', d, 'R2=%.5f'%r2d)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> res = {'G': g, '2D': d}\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/results.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(res, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print('w"]
[560.790493, "o", "ritten')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
