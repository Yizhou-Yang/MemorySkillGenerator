[297.419994, "i", "cat > /tmp/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p = line.split()\n        if len(p) < 2: continue\n        xs.append(float(p[0].replace(',', '.')))\n        ys.append(float(p[1].replace(',', '.')))\nx = np.array(xs); y = np.array(ys)\nidx = np.argsort(x); x = x[idx]; y = y[idx]\n\n# print raw points in windows around candidate peaks\nfor cx in [3745, 6329, 10289, 19139]:\n    m = (x>cx-60)&(x<cx+60)\n    seg = np.array(sorted(zip(x[m], y[m])))\n    print(f'--- around x={cx} (n={m.sum()}) ---')\n    print(np.round(seg[:6],1))\n    print(np.round(seg[-6:],1))\n\ndef lor(x, x0, g, a):\n    return a*g*g/((x-x0)**2 + g*g)\n\ndef modelN(x, *p):\n    c0, c1 = p[0], p[1]\n    out = c0 + c1*x\n    for i in range((len(p)-2)//3):\n        x0, g, a = p[2+3*i], p[3+3*i], p[4+3*i]\n        out = out + lor(x, x0, g, a)\n    return out\n\npeaks = [(3745,12000,50),(6329,13000,50),(10289,18000,50),(19139,79000,200)]\nfor N in [2,3,4]:\n   "]
[297.42093, "i", " p0 = [y.min(), 0.0]\n    for i in range(N):\n        x0,g,a = peaks[i]\n        p0 += [x0, g, a]\n    try:\n        popt, _ = curve_fit(modelN, x, y, p0=p0, maxfev=200000)\n        resid = y - modelN(x, *popt)\n        rss = np.sum(resid**2)\n        dof = len(x) - len(p0)\n        rchi = rss/dof\n        print(f'N={N}: reduced_chi2={rchi:.1f}')\n        for i in range(N):\n            x0,g,a = popt[2+3*i], popt[3+3*i], popt[4+3*i]\n            print(f'   peak{i}: x0={x0:.1f} gamma={g:.1f} amp={a:.1f}')\n        print(f'   baseline c0={popt[0]:.1f} c1={popt[1]:.3e}')\n    except Exception as e:\n        print(f'N={N} FAILED: {e}')\nEOF\npython3 /tmp/diag.py\n"]
