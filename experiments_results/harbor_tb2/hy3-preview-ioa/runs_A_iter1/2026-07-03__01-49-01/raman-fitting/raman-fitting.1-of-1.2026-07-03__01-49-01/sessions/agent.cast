[427.014384, "i", "cat > /tmp/zoom.py << 'EOF'\nimport numpy as np\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p = line.split()\n        if len(p) < 2: continue\n        xs.append(float(p[0].replace(',', '.')))\n        ys.append(float(p[1].replace(',', '.')))\nx = np.array(xs); y = np.array(ys)\nidx = np.argsort(x); x = x[idx]; y = y[idx]\nfor lo, hi, nm in [(17000,20000,'G region'), (31500,35000,'2D region')]:\n    m = (x>=lo)&(x<=hi)\n    seg = np.array(sorted(zip(x[m], y[m])))\n    print(f'=== {nm}  x in [{lo},{hi}]  n={m.sum()} ===')\n    for a,b in seg:\n        print(f'  x={a:9.2f}  y={b:9.2f}')\nEOF\npython3 /tmp/zoom.py\n"]
[427.01507, "o", "cat > /tmp/zoom.py << 'EOF'\r\n"]
