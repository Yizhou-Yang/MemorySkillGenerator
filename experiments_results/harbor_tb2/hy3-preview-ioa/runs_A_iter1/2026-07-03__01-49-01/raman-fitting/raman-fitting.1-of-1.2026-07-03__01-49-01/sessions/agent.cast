[173.235641, "i", "cat > /tmp/view.py << 'EOF'\nimport numpy as np\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p = line.split()\n        if len(p) < 2: continue\n        xs.append(float(p[0].replace(',', '.')))\n        ys.append(float(p[1].replace(',', '.')))\nx = np.array(xs); y = np.array(ys)\nidx = np.argsort(x); x = x[idx]; y = y[idx]\n# coarse view: 70 bins\nnb = 70\nedges = np.linspace(x.min(), x.max(), nb+1)\nfor i in range(nb):\n    m = (x>=edges[i]) & (x<edges[i+1])\n    if m.sum()==0: continue\n    print(f'{edges[i]:9.1f}-{edges[i+1]:9.1f}  ymax={y[m].max():9.1f}  n={m.sum()}')\nEOF\npython3 /tmp/view.py\n"]
[173.237028, "o", "cat > /tmp/view.py << 'EOF'"]
