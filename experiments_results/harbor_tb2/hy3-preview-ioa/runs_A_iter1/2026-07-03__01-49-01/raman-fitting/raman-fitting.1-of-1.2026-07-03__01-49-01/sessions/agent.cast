[97.780924, "i", "cat > /tmp/explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nd = np.loadtxt('/app/graphene.dat', delimiter=' ', converters={0: lambda s: float(s.decode().replace(',','.')), 1: lambda s: float(s.decode().replace(',','.'))})\nx = d[:,0]; y = d[:,1]\nprint('n=', len(x), 'x range', x.min(), x.max(), 'y range', y.min(), y.max())\n# sort ascending by x\nidx = np.argsort(x)\nx = x[idx]; y = y[idx]\n# peaks\npk, props = find_peaks(y, prominence=0.05*(y.max()-y.min()), distance=10)\nprint('num peaks', len(pk))\nfor p in pk:\n    print(f'x={x[p]:.2f} y={y[p]:.1f} prom={props[\"prominences\"][list(pk).index(p)]:.1f}')\nEOF\npython3 /tmp/explore.py\n"]
