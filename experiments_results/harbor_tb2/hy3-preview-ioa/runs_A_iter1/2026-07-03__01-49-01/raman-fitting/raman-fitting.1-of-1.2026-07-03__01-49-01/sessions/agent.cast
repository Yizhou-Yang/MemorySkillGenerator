[359.677634, "i", "cat > /tmp/diag2.py << 'EOF'\nimport numpy as np\nfrom scipy.interpolate import UnivariateSpline\nfrom scipy.signal import find_peaks\n\nxs, ys = [], []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p = line.split()\n        if len(p) < 2: continue\n        xs.append(float(p[0].replace(',', '.')))\n        ys.append(float(p[1].replace(',', '.')))\nx = np.array(xs); y = np.array(ys)\nidx = np.argsort(x); x = x[idx]; y = y[idx]\n\nfor s in [2e7, 5e7, 1e8]:\n    spl = UnivariateSpline(x, y, k=4, s=s)\n    bg = spl(x)\n    r = y - bg\n    pk, props = find_peaks(r, prominence=0.02*r.max(), distance=5)\n    print(f's={s}: bg_rms={np.sqrt(np.mean((y-bg)**2)):.0f}  num_resid_peaks={len(pk)}')\n    for i, p in enumerate(pk):\n        print(f'   x={x[p]:9.1f} rmax={r[p]:9.1f} bg={bg[p]:9.1f} prom={props[\"prominences\"][i]:9.1f}')\nEOF\npython3 /tmp/diag2.py\n"]
[359.686389, "o", "cat > /tmp/diag2.py << 'EOF'"]
