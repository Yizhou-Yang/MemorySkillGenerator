[79.751415, "o", "BUFFER_CAPACITY = 10000\r\n\u001b[?2004l\r"]
[79.751446, "o", "\u001b[?2004h> "]
[79.751501, "o", "TARGET_UPDATE = 100\r\n\u001b[?2004l\r"]
[79.751524, "o", "\u001b[?2004h> "]
[79.751614, "o", "EPS_START = 1.0"]
