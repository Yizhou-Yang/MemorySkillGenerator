[79.779783, "o", "\u001b[?2004h"]
[79.780021, "o", "> "]
[79.780297, "o", "            loss.backward()"]
[79.780508, "o", "\r\n"]
[79.780709, "o", "\u001b[?2004l\r"]
[79.780974, "o", "\u001b[?2004h"]
[79.781207, "o", "> "]
