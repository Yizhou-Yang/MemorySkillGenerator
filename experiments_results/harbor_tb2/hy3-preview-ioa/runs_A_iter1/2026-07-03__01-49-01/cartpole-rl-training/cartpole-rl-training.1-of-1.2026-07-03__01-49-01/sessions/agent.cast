[79.541284, "o", "\u001b[?2004hroot@8a86d14240fd:/app# "]
[79.749996, "i", "cat > /app/train_agent.py << 'EOF'\nimport random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport gymnasium as gym\nfrom agent import Agent, DQN\n\nBATCH_SIZE = 128\nGAMMA = 0.99\nLR = 1e-3\nBUFFER_CAPACITY = 10000\nTARGET_UPDATE = 100\nEPS_START = 1.0\nEPS_END = 0.05\nEPS_DECAY = 5000\nNUM_STEPS = 50000\n\n\ndef evaluate(agent, env, n=20):\n    total = 0.0\n    for _ in range(n):\n        o, _ = env.reset()\n        r = 0.0\n        while True:\n            a = agent.select_action(o)\n            o, rew, term, trunc, _ = env.step(a)\n            r += rew\n            if term or trunc:\n                break\n        total += r\n    return total / n\n\n\ndef train():\n    env = gym.make(\"CartPole-v1\")\n    agent = Agent()\n    target_net = DQN(128).to(agent.device)\n    target_net.load_state_dict(agent.policy_net.state_dict())\n    target_net.eval()\n\n    optimizer = optim.Adam(agent.policy_net.parameters(), lr=LR)\n    criterion = nn.SmoothL1Loss()\n\n    rep"]
[79.750195, "o", "cat > /app/train_agent.py << 'EOF'"]
[79.750252, "o", "\r\n"]
[79.750576, "o", "\u001b[?2004l\r\u001b[?2004h> import random\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.750705, "i", "lay = []\n    steps_done = 0\n\n    def select_epsilon(obs):\n        nonlocal steps_done\n        eps = EPS_END + (EPS_START - EPS_END) * np.exp(-steps_done / EPS_DECAY)\n        steps_done += 1\n        if random.random() > eps:\n            return agent.select_action(obs)\n        return env.action_space.sample()\n\n    state, _ = env.reset()\n    for step in range(NUM_STEPS):\n        action = select_epsilon(state)\n        next_state, reward, terminated, truncated, _ = env.step(action)\n        done = terminated or truncated\n        replay.append((state, action, reward, next_state, done))\n        if len(replay) > BUFFER_CAPACITY:\n            replay.pop(0)\n        state = next_state\n        if done:\n            state, _ = env.reset()\n\n        if len(replay) >= BATCH_SIZE:\n            batch = random.sample(replay, BATCH_SIZE)\n            states = torch.as_tensor(np.array([b[0] for b in batch], dtype=np.float32), device=agent.device)\n            actions = torch.as_tensor([b[1] for b in batch], dtype=torch.int64, device=ag"]
[79.751092, "o", "> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.751155, "i", "ent.device).unsqueeze(1)\n            rewards = torch.as_tensor([b[2] for b in batch], dtype=torch.float32, device=agent.device).unsqueeze(1)\n            next_states = torch.as_tensor(np.array([b[3] for b in batch], dtype=np.float32), device=agent.device)\n            dones = torch.as_tensor([b[4] for b in batch], dtype=torch.float32, device=agent.device).unsqueeze(1)\n\n            q_values = agent.policy_net(states).gather(1, actions)\n            with torch.no_grad():\n                next_q = target_net(next_states).max(1)[0].unsqueeze(1)\n                target = rewards + GAMMA * next_q * (1 - dones)\n            loss = criterion(q_values, target)\n            optimizer.zero_grad()\n            loss.backward()\n            optimizer.step()\n\n        if step % TARGET_UPDATE == 0:\n            target_net.load_state_dict(agent.policy_net.state_dict())\n\n        if step % 2500 == 0:\n            print(f\"step {step} eval mean {evaluate(agent, env):.1f}\")\n\n    agent.save(\"/app"]
