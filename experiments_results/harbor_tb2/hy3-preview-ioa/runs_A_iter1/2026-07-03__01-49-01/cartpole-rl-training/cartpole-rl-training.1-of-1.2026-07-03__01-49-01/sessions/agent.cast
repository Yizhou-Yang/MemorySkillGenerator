[79.759307, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.759615, "o", "    optimizer = optim.Adam(agent.policy_net.parameters(), lr=LR)\r\n\u001b[?2004l\r\u001b[?2004h>     criterion = nn.SmoothL1Loss()\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.75966, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[79.759717, "o", "> "]
[79.75973, "o", "    replay = []"]
[79.759839, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     steps_done = 0\r\n\u001b[?2004l\r"]
[79.759876, "o", "\u001b[?2004h> \r\n"]
[79.759892, "o", "\u001b[?2004l\r"]
[79.759933, "o", "\u001b[?2004h"]
[79.760025, "o", "> "]
[79.760189, "o", "    def select_epsilon(obs):"]
[79.760273, "o", "\r\n"]
[79.760349, "o", "\u001b[?2004l\r"]
[79.760437, "o", "\u001b[?2004h"]
[79.760536, "o", "> "]
[79.760674, "o", "        nonlocal steps_done"]
[79.760746, "o", "\r\n"]
[79.76082, "o", "\u001b[?2004l\r"]
[79.760914, "o", "\u001b[?2004h"]
[79.760996, "o", "> "]
[79.761256, "o", "        eps = EPS_END + (EPS_START - EPS_END) * np.exp(-steps_done / EPS_DECAY)"]
[79.761327, "o", "\r\n"]
[79.761398, "o", "\u001b[?2004l\r"]
[79.761503, "o", "\u001b[?2004h"]
[79.761582, "o", "> "]
[79.761716, "o", "        steps_done += 1"]
[79.761792, "o", "\r\n"]
[79.761941, "o", "\u001b[?2004l\r"]
[79.76208, "o", "\u001b[?2004h"]
[79.762164, "o", "> "]
[79.762312, "o", "        if random.random() > eps:"]
[79.762385, "o", "\r\n"]
[79.762457, "o", "\u001b[?2004l\r"]
[79.762566, "o", "\u001b[?2004h"]
[79.762647, "o", "> "]
[79.762818, "o", "            return agent.select_action(obs)"]
[79.762893, "o", "\r\n"]
[79.763008, "o", "\u001b[?2004l\r"]
[79.763118, "o", "\u001b[?2004h"]
[79.763199, "o", "> "]
[79.763365, "o", "        return env.action_space.sample()"]
[79.763438, "o", "\r\n"]
[79.76353, "o", "\u001b[?2004l\r"]
[79.763624, "o", "\u001b[?2004h"]
[79.763707, "o", "> "]
[79.763783, "o", "\r\n"]
[79.763857, "o", "\u001b[?2004l\r"]
[79.76395, "o", "\u001b[?2004h"]
[79.764033, "o", "> "]
[79.764192, "o", "    state, _ = env.reset()"]
[79.76428, "o", "\r\n"]
[79.764361, "o", "\u001b[?2004l\r"]
[79.764449, "o", "\u001b[?2004h"]
[79.764546, "o", "> "]
[79.764701, "o", "    for step in range(NUM_STEPS):"]
[79.764784, "o", "\r\n"]
[79.764862, "o", "\u001b[?2004l\r"]
[79.764953, "o", "\u001b[?2004h"]
[79.765032, "o", "> "]
[79.765211, "o", "        action = select_epsilon(state)"]
[79.765284, "o", "\r\n"]
[79.765356, "o", "\u001b[?2004l\r"]
[79.765445, "o", "\u001b[?2004h"]
[79.765547, "o", "> "]
[79.765784, "o", "        next_state, reward, terminated, truncated, _ = env.step(action)"]
[79.76587, "o", "\r\n"]
[79.765945, "o", "\u001b[?2004l\r"]
[79.766058, "o", "\u001b[?2004h"]
[79.76614, "o", "> "]
[79.766304, "o", "        done = terminated or truncated"]
[79.766377, "o", "\r\n"]
[79.766454, "o", "\u001b[?2004l\r"]
[79.766563, "o", "\u001b[?2004h"]
[79.76665, "o", "> "]
[79.766867, "o", "        replay.append((state, action, reward, next_state, done))"]
[79.766951, "o", "\r\n"]
[79.767027, "o", "\u001b[?2004l\r"]
[79.767136, "o", "\u001b[?2004h"]
[79.767215, "o", "> "]
[79.767387, "o", "        if len(replay) > BUFFER_CAPACITY:"]
[79.767464, "o", "\r\n"]
[79.767562, "o", "\u001b[?2004l\r"]
[79.767659, "o", "\u001b[?2004h"]
[79.767748, "o", "> "]
[79.76789, "o", "            replay.pop(0)"]
[79.767974, "o", "\r\n"]
[79.768078, "o", "\u001b[?2004l\r"]
[79.768176, "o", "\u001b[?2004h"]
[79.768667, "o", "> "]
[79.769304, "o", "        state = next_state\r\n\u001b[?2004l\r"]
[79.769443, "o", "\u001b[?2004h"]
[79.769579, "o", "> "]
[79.769759, "o", "        if done:"]
[79.769834, "o", "\r\n"]
[79.769912, "o", "\u001b[?2004l\r"]
[79.770005, "o", "\u001b[?2004h"]
[79.770106, "o", "> "]
[79.77028, "o", "            state, _ = env.reset()\r\n\u001b[?2004l\r"]
[79.770397, "o", "\u001b[?2004h> "]
[79.770516, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.770687, "o", "> "]
[79.770875, "o", "        if len(replay) >= BATCH_SIZE:\r\n\u001b[?2004l\r"]
[79.770965, "o", "\u001b[?2004h> "]
[79.771369, "o", "            batch = random.sample(replay, BATCH_SIZE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.771749, "o", "            states = torch.as_tensor(np.array([b[0] for b in batch], dtype=np.float32), device=agent.device)\r\n\u001b[?2004l\r"]
[79.771852, "o", "\u001b[?2004h> "]
[79.772227, "o", "            actions = torch.as_tensor([b[1] for b in batch], dtype=torch.int64, device=agent.device).unsqueeze(1)\r\n\u001b[?2004l\r"]
[79.772416, "o", "\u001b[?2004h> "]
[79.772875, "o", "            rewards = torch.as_tensor([b[2] for b in batch], dtype=torch.float32, device=agent.device).unsqueeze(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.773546, "o", "            next_states = torch.as_tensor(np.array([b[3] for b in batch], dtype=np.float32), device=agent.device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.77497, "o", "            dones = torch.as_tensor([b[4] for b in batch], dtype=torch.float32, device=agent.device).unsqueeze(1)\r\n\u001b[?2004l\r"]
[79.775362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             q_values = agent.policy_net(states).gather(1, actions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.775891, "o", "            with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.776104, "o", "                next_q = target_net(next_states).max(1)[0].unsqueeze(1)"]
[79.776187, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.776463, "o", "> "]
[79.776829, "o", "                target = rewards + GAMMA * next_q * (1 - dones)"]
[79.777017, "o", "\r\n"]
[79.777223, "o", "\u001b[?2004l\r"]
[79.777426, "o", "\u001b[?2004h"]
[79.777645, "o", "> "]
[79.77794, "o", "            loss = criterion(q_values, target)"]
