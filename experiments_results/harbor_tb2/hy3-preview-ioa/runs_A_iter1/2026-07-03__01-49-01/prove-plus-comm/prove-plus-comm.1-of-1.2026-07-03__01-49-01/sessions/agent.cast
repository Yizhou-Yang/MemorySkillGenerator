[165.137173, "o", "plus_n_Sm =\r\nfun n m : nat =>\r\nnat_ind (fun n0 : nat => S (n0 + m) = n0 + S m)\r\n  (eq_refl : S (0 + m) = 0 + S m)\r\n  (fun (n0 : nat) (IHn : S (n0 + m) = n0 + S m) =>\r\n   f_equal_nat nat S (S (n0 + m)) (n0 + S m) IHn : S (S n0 + m) = S n0 + S m)\r\n  n\r\n     : forall n m : nat, S (n + m) = n + S m\r\n\r\nArguments plus_n_Sm (n m)%nat_scope\r\n"]
[165.137605, "o", "plus_n_O =\r\nfun n : nat =>\r\nnat_ind (fun n0 : nat => n0 = n0 + 0) (eq_refl : 0 = 0 + 0)\r\n  (fun (n0 : nat) (IHn : n0 = n0 + 0) =>\r\n   f_equal_nat nat S n0 (n0 + 0) IHn : S n0 = S n0 + 0) n\r\n     : forall n : nat, n = n + 0\r\n\r\nArguments plus_n_O n%nat_scope\r\n"]
[165.167865, "m", "Episode 8: 2 commands"]
