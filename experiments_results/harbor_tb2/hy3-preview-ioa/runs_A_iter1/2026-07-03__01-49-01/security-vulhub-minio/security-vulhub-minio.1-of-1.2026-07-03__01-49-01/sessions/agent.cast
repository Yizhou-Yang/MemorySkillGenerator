[581.26775, "i", "cat > /tmp/rt.py << 'EOF'\ndef hexip(h):\n    b=bytes.fromhex(h)\n    return '.'.join(str(x) for x in b[::-1])\nimport struct\nfor line in open('/proc/net/route'):\n    f=line.split()\n    if f[1]=='00000000':\n        print('GATEWAY', hexip(f[2]))\nEOF\npython3 /tmp/rt.py\n"]
