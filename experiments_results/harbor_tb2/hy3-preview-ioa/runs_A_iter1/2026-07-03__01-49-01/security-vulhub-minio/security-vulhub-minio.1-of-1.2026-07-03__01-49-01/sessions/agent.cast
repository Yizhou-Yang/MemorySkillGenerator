[435.608601, "i", "cat > /tmp/probe2.py << 'EOF'\nimport urllib.request as u\nfor url in ['http://node1:9001/','http://node1:9001/login','http://node1:9000/minio/health/live','http://node1:9000/minio/health/ready','http://node1:9000/minio/health/cluster']:\n    req=u.Request(url)\n    try:\n        r=u.urlopen(req,timeout=4)\n        print('===',url,'STATUS',r.status)\n        print('HEADERS',dict(r.headers))\n        print('BODY',r.read()[:300])\n    except Exception as e:\n        print('===',url,'ERR',repr(e))\nEOF\npython3 /tmp/probe2.py\n"]
