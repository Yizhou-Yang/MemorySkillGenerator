[515.071505, "i", "cat > /tmp/boot.py << 'EOF'\nimport urllib.request as u, json\nfor h in ['node1','192.168.144.1','192.168.144.3','192.168.144.4']:\n    for ep in ['/minio/bootstrap/v2','/minio/bootstrap/v1']:\n        url='http://%s:9000%s'%(h,ep)\n        try:\n            r=u.urlopen(url,timeout=4)\n            print('===',h,ep,'STATUS',r.status)\n            data=r.read().decode('utf-8','replace')\n            print(data[:1200])\n        except Exception as e:\n            print('===',h,ep,'ERR',repr(e))\nEOF\npython3 /tmp/boot.py\n"]
