[581.494338, "i", "cat > /tmp/s3.py << 'EOF'\nimport socket\nfound=[]\nfor i in range(1,255):\n    h='192.168.144.%d'%i\n    for p in (2375,2376,2377,2222):\n        s=socket.socket(); s.settimeout(0.15)\n        try:\n            s.connect((h,p)); found.append((h,p))\n        except Exception: pass\n        s.close()\nprint('DOCKER-LIKE:',found)\nEOF\npython3 /tmp/s3.py\n"]
