[475.123312, "i", "cat > /tmp/scan2.py << 'EOF'\nimport socket\ncands=['192.168.144.1','192.168.144.254','172.17.0.1','host.docker.internal','192.168.144.3','192.168.144.4']\nports=[2375,2376,9000,9001]\nfor h in cands:\n    for p in ports:\n        s=socket.socket(); s.settimeout(0.3)\n        try:\n            s.connect((h,p)); print('OPEN',h,p)\n        except Exception: pass\n        s.close()\nprint('done')\nEOF\npython3 /tmp/scan2.py\n"]
