[193.64619, "i", "cat > /app/server.py << 'PYEOF'\nimport requests\nfrom flask import Flask, request, jsonify\n\napp = Flask(__name__)\n\nRPC_URL = \"https://api.devnet.solana.com\"\nPROGRAM_ID = \"Vote111111111111111111111111111111111111111\"\nSYS_ID = \"11111111111111111111111111111111\"\n\ndef rpc(method, params):\n    payload = {\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": method, \"params\": params}\n    r = requests.post(RPC_URL, json=payload, timeout=30)\n    r.raise_for_status()\n    data = r.json()\n    if data.get(\"error\") is not None:\n        raise Exception(str(data[\"error\"]))\n    return data[\"result\"]\n\n@app.route(\"/status\")\ndef status():\n    try:\n        v = rpc(\"getVersion\", [])\n        slot = rpc(\"getSlot\", [])\n        nodes = rpc(\"getClusterNodes\", [])\n        health = rpc(\"getHealth\", [])\n        return jsonify({\n            \"status\": \"online\" if health == \"ok\" else \"offline\",\n            \"network\": \"devnet\",\n            \"current_slot\": slot,\n            \"node_count\": len(nodes),\n            \"version\": v.get(\"solana-core\", \"unknown\"),\n     "]
[193.646358, "i", "   })\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n\n@app.route(\"/block/<int:slot_number>\")\ndef block(slot_number):\n    try:\n        b = rpc(\"getBlock\", [slot_number, {\"encoding\": \"json\", \"transactionDetails\": \"none\", \"rewards\": False}])\n        if b is None:\n            return jsonify({\"error\": \"Block not found\"}), 404\n        return jsonify({\n            \"blockhash\": b[\"blockhash\"],\n            \"parent_slot\": b[\"parentSlot\"],\n            \"previous_blockhash\": b[\"previousBlockhash\"],\n            \"block_height\": b.get(\"blockHeight\"),\n            \"block_time\": b.get(\"blockTime\"),\n        })\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 404 if \"404\" in str(e) else 500\n\n@app.route(\"/transaction/<signature>\")\ndef transaction(signature):\n    try:\n        tx = rpc(\"getTransaction\", [signature, {\"encoding\": \"jsonParsed\", \"maxSupportedTransactionVersion\": 0}])\n        if tx is None:\n            return jsonify({\"error\": \"Transaction not found\"}), 404\n        meta = t"]
[193.64638, "i", "x.get(\"meta\") or {}\n        pre = meta.get(\"preTokenBalances\") or []\n        post = meta.get(\"postTokenBalances\") or []\n        transfers = []\n        for pb in pre:\n            idx = pb.get(\"accountIndex\")\n            p = next((x for x in post if x.get(\"accountIndex\") == idx), None)\n            if p is None:\n                continue\n            pa = int((pb.get(\"uiTokenAmount\") or {}).get(\"amount\") or 0)\n            po = int((p.get(\"uiTokenAmount\") or {}).get(\"amount\") or 0)\n            d = pa - po\n            if d != 0:\n                transfers.append({\"account\": pb.get(\"owner\"), \"mint\": pb.get(\"mint\"), \"amount\": abs(d)})\n        txn = tx.get(\"transaction\") or {}\n        sigs = txn.get(\"signatures\") if isinstance(txn, dict) else None\n        sig = sigs[0] if sigs else signature\n        return jsonify({\n            \"signature\": sig,\n            \"slot\": tx.get(\"slot\"),\n            \"block_time\": tx.get(\"blockTime\"),\n            \"success\": meta.get(\"err\") is None,\n            \"fee\": meta.get(\"fee\"),\n          "]
[193.646432, "i", "  \"token_transfers\": transfers,\n        })\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 404 if \"404\" in str(e) else 500\n\n@app.route(\"/account/<address>\")\ndef account(address):\n    try:\n        info = rpc(\"getAccountInfo\", [address, {\"encoding\": \"jsonParsed\"}])\n        if not info or info.get(\"value\") is None:\n            return jsonify({\"error\": \"Account not found\"}), 404\n        val = info[\"value\"]\n        return jsonify({\n            \"address\": address,\n            \"executable\": val.get(\"executable\", False),\n            \"lamports\": val.get(\"lamports\", 0),\n            \"owner\": val.get(\"owner\"),\n            \"rent_epoch\": val.get(\"rentEpoch\"),\n        })\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n\n@app.route(\"/program/<program_id>/accounts\")\ndef program_accounts(program_id):\n    try:\n        try:\n            limit = int(request.args.get(\"limit\", 10))\n        except Exception:\n            limit = 10\n        try:\n            offset = int(request.args.get(\"o"]
[193.646487, "i", "ffset\", 0))\n        except Exception:\n            offset = 0\n        if limit < 1 or limit > 1000:\n            limit = 10\n        if offset < 0:\n            offset = 0\n        res = rpc(\"getProgramAccounts\", [program_id, {\"encoding\": \"jsonParsed\", \"dataSlice\": {\"offset\": 0, \"length\": 0}}])\n        total = len(res)\n        page = res[offset:offset+limit]\n        accounts = []\n        for a in page:\n            v = a.get(\"account\") or {}\n            accounts.append({\"pubkey\": a.get(\"pubkey\"), \"account\": {\"executable\": v.get(\"executable\", False), \"lamports\": v.get(\"lamports\", 0), \"owner\": v.get(\"owner\"), \"rent_epoch\": v.get(\"rentEpoch\")}})\n        return jsonify({\"program_id\": program_id, \"total_accounts\": total, \"limit\": limit, \"offset\": offset, \"accounts\": accounts})\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=5000)\nPYEOF\n"]
