[422.303752, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nSQ=80\nimg=Image.open('/app/chess_puzzle.png').convert('RGB')\ngray=np.asarray(img).astype(np.float64).mean(axis=2)\ndef sq(r,c): return gray[r*SQ:(r+1)*SQ, c*SQ:(c+1)*SQ]\n# occupancy + brightness\nocc=[]\nfor r in range(8):\n  row=[]\n  for c in range(8):\n    s=sq(r,c)\n    corner=np.median(np.concatenate([s[4:12,4:12].ravel(),s[4:12,68:76].ravel(),s[68:76,4:12].ravel(),s[68:76,68:76].ravel()]))\n    m=np.abs(s-corner)>30\n    if m.sum()>150:\n      pv=s[m]; row.append((round(float(pv.mean()),1),'W' if pv.mean()>corner else 'B'))\n    else:\n      row.append(None)\n  occ.append(row)\nprint('median-brightness / color per square (rank8 top):')\nfor r in range(8):\n  cells=[]\n  for c in range(8):\n    v=occ[r][c]\n    if v is None: cells.append('   .   ')\n    else: cells.append('%s%3.0f'%(v[1],v[0]))\n  print(''.join('%8s'%x for x in cells), '  rank%d'%(8-r))\ndef render(square):\n  r=8-int(square[1]); c=ord(square[0])-97\n  s=sq(r,c); corner=np.median(np.concatenate([s[4:12,4:12].ravel(),s[68:76,68:76].ravel()]))\n  m=np.abs(s-corner)>30\n  ys,xs=np.where(m); y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\n  cr=(m[y0:y1,x0:x1]*255).astype(np.uint8); cr=Image.fromarray(cr).resize((40,40))\n  a=np.asarray(cr)>100\n  print('--- square',square)\n  for y in range(40): print(''.join('#' if a[y,x] else ' ' for x in range(40)))\nfor sqr in ['e1','g2','h5','f5']:\n  render(sqr)\nEOF\npython3 /app/diag.py\n"]
