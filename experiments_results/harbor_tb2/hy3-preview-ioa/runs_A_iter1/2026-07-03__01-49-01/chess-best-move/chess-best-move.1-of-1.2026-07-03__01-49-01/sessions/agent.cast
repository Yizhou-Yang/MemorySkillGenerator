[493.285333, "i", "cat > /app/clust.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nSQ=80\nimg=Image.open('/app/chess_puzzle.png').convert('RGB')\ngray=np.asarray(img).astype(np.float64).mean(axis=2)\ndef sq(r,c): return gray[r*SQ:(r+1)*SQ, c*SQ:(c+1)*SQ]\nocc={}; col={}; feat={}\nfor r in range(8):\n  for c in range(8):\n    s=sq(r,c)\n    corner=np.median(np.concatenate([s[4:12,4:12].ravel(),s[4:12,68:76].ravel(),s[68:76,4:12].ravel(),s[68:76,68:76].ravel()]))\n    m=np.abs(s-corner)>30\n    if m.sum()>150:\n      pv=s[m]; bright=pv.mean()\n      col[(r,c)]='W' if bright>corner else 'B'\n      occ[(r,c)]=True\n      ys,xs=np.where(m); y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\n      cr=(m[y0:y1,x0:x1]*255).astype(np.uint8)\n      cr=Image.fromarray(cr).resize((34,34))\n      feat[(r,c)]=np.asarray(cr).astype(np.float64)/255.0\ndef name(r,c): return '%s%d'%(chr(97+c),8-r)\nclusters=[]\ndef d(f,g): return np.abs(f-g).sum()\nfor (r,c),f in occ.items():\n  cc=col[(r,c)]; best=None;bd=1e9\n  for cl in clusters:\n    if cl['c']!=cc: continue\n    dd=d(f,cl['f'])\n    if dd<bd: bd=dd;best=cl\n  if best is not None and bd<70:\n    best['m'].append((r,c))\n  else:\n    clusters.append({'c':cc,'f':f,'m':[(r,c)]})\nprint('clusters:',len(clusters))\ndef show(f):\n  for y in range(34): print(''.join('#' if f[y,x]>0.5 else ' ' for x in range(34)))\nfor i,cl in enumerate(clusters):\n  mem=sorted([name(*p) for p in cl['m']])\n  print('### cluster %d color=%s n=%d %s'%(i,cl['c'],len(cl['m']),mem))\n  show(cl['f'])\nEOF\npython3 /app/clust.py > /tmp/cl.txt 2>&1; sed -n '1,120p' /tmp/cl.txt\n"]
[493.30174, "o", "cat > /app/clust.py << 'EOF'\r\n\u001b[?2004l\r"]
[493.302043, "o", "\u001b[?2004h> "]
[493.302086, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image"]
[493.302182, "o", "\r\n"]
