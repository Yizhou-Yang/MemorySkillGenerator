[631.349529, "i", "cat > /app/solve.py << 'EOF'\nimport chess\nfen='r1bq1r2/1p3pp1/p1n1p3/3nPkbQ/8/N1N5/1P2NPQ1/R1B1K2R w KQ - 0 1'\nb=chess.Board(fen)\nprint('status', b.status())\nprint('valid', b.is_valid())\nprint(b)\n# find all mate in 1\nmates=[]\nfor m in b.legal_moves:\n    b.push(m)\n    if b.is_checkmate():\n        mates.append(m.uci())\n    b.pop()\nprint('MATE IN 1 moves:', mates)\nEOF\npython3 /app/solve.py\n"]
