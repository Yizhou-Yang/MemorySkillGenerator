[595.579366, "i", "cat > /tmp/fit.py << 'PYEOF'\nimport numpy as np, math\ndef load_ppm(path):\n    with open(path,'rb') as f: data=f.read()\n    arr=np.frombuffer(data,dtype=np.uint8,offset=15).reshape(600,800,3).astype(np.float64)\n    return arr\nfull=load_ppm('/app/image.ppm')\ndef downsample(img,nw,nh):\n    h,w=img.shape[:2]\n    xs=np.linspace(0,w,nw+1).astype(int); ys=np.linspace(0,h,nh+1).astype(int)\n    out=np.zeros((nh,nw,3))\n    for j in range(nh):\n        for i in range(nw):\n            out[j,i]=img[ys[j]:ys[j+1], xs[i]:xs[i+1]].mean((0,1))\n    return out\nFW,FH=200,150\ntarget=downsample(full,FW,FH)\nlightc=np.array([152.,152.,152.]); darkc=np.array([67.,67.,67.])\ndef render(p,W,H):\n    eye=p['eye']; camz=p['camz']; fov=p['fov']; sx=p['sx']; sz=p['sz']; R=p['R']\n    scol=np.array([p['sr'],p['sg'],p['sb']]); la=p['la']; le=p['le']; cs=p['cs']\n    amb=p['amb']; lint=p['lint']; sdark=p['sdark']\n    zen=np.array([p['zr'],p['zg'],p['zb']]); hor=np.array([p['hr'],p['hg'],p['hb']])\n    L=np.array([math.cos(le)*math.sin(la), math.sin(le), math.cos(le)*math.cos(la)])\n    fwd=np.array([0.,0.,-1.]); rt=np.array([1.,0.,0.]); up=np.array([0.,1.,0.])\n    half_h=math.tan(fov/2.0); aspect=W/H; half_w=half_h*aspect\n    i=np.arange(W); j=np.arange(H)\n    su=((i+0.5)/W-0.5)*2*half_w; sv=((j+0.5)/H-0.5)*2*half_h\n    dirs=np.zeros((H,W,3))\n    dirs[...,0]=su[None,:]*rt[0]+sv[:,None]*up[0]\n    dirs[...,1]=su[None,:]*rt[1]+sv[:,None]*up[1]\n    dirs[...,2]=-1.0+su[None,:]*rt[2]+sv[:,None]*up[2]\n    dn=np.sqrt((dirs**2).sum(-1,keepdims=True)); dirs/=dn\n    orig=np.array([0.,eye,camz]); sc=np.array([sx,R,sz])\n    oc=orig-sc; b=(dirs*oc).sum(-1); c=(oc*oc).sum()-R*R\n    disc=np.maximum(b*b-c,0.0); sq=np.sqrt(disc)\n    t_sph=np.where(disc>1e-9,-b-sq,np.inf)\n    t_pl=np.where(dirs[...,1]<0,-orig[1]/dirs[...,1],np.inf)\n    sph=np.isfinite(t_sph)&(t_sph>0)&(t_sph<t_pl)\n    pln=np.isfinite(t_pl)&(t_pl>0)&(~sph)\n    dy=dirs[...,1]; tsky=np.clip(dy,0.0,1.0)\n    col=hor[None,None,:]*(1-tsky)[...,None]+zen[None,None,:]*tsky[...,None]\n    if sph.any():\n        P=orig[None,None,:]+t_sph[:,:,None]*dirs\n        n=(P-sc)/R\n        diff=np.clip((n*L).sum(-1),0,1)\n        col[sph]=scol[None,None,:]*(amb+diff[...,None]*lint)\n    if pln.any():\n        P=orig[None,None,:]+t_pl[:,:,None]*dirs\n        X=P[...,0]; Z=P[...,2]\n        ch=((np.floor(X/cs)+np.floor(Z/cs)).astype(int)&1)\n        basecol=np.where(ch[...,None]==0,lightc[None,None,:],darkc[None,None,:])\n        diff=L[1]\n        oc2=P-sc; bb=(oc2*L).sum(-1); cc=(oc2*oc2).sum(-1)-R*R\n        d2=np.maximum(bb*bb-cc,0.0); sq2=np.sqrt(d2)\n        tsh=np.where(d2>1e-9,-bb-sq2,np.inf)\n        inshadow=tsh>1e-3\n        lit=amb+(1-inshadow.astype(float))*diff*lint\n        col[pln]=basecol[pln]*lit[pln][...,None]\n    return np.clip(col,0,255)\ndef err(p):\n    c=render(p,FW,FH); d=c-target; return math.sqrt((d*d).sum())/math.sqrt((target*target).sum())\nkeys=['eye','camz','fov','sx','sz','R','sr','sg','sb','la','le','cs','amb','lint','sdark','zr','zg','zb','hr','hg','hb']\nstart=dict(eye=2.0,camz=8.0,fov=1.0,sx=0.0,sz=-4.0,R=1.0,sr=200.,sg=25.,sb=25.,la=0.4,le=0.7,cs=2.0,amb=0.15,lint=1.0,sdark=0.25,zr=158,zg=197,zb=255,hr=190,hg=216,hb=255)\nstep=dict(eye=0.5,camz=1.0,fov=0.15,sx=0.5,sz=1.0,R=0.2,sr=20.,sg=5.,sb=5.,la=0.2,le=0.2,cs=0.5,amb=0.05,lint=0.2,sdark=0.1,zr=10,zg=10,zb=10,hr=10,hg=10,hb=10)\nbest=dict(start); be=err(best); print('start',round(be,4))\nfor sweep in range(25):\n    improved=False\n    for k in keys:\n        cur=best[k]; beste=be; bestv=cur\n        for v in [cur,cur+step[k],cur-step[k],cur+2*step[k],cur-2*step[k]]:\n            best[k]=v; e=err(best)\n            if e<beste: beste=e; bestv=v; improved=True\n        best[k]=bestv; be=beste\n    print('sweep',sweep,'err',round(be,4))\n    for k in keys: step[k]*=0.7\n    if not improved: break\nprint('FINAL',round(be,4))\nfor k in keys: print(k,round(best[k],4))\nPYEOF\n"]
[595.579698, "o", "cat > /tmp/fit.py << 'PYEOF'"]
