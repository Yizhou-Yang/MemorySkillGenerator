[314.718992, "i", "cat > /tmp/an3.py << 'EOF'\nimport numpy as np\ndef read_ppm(path):\n    with open(path,'rb') as f:\n        data=f.read()\n    p=2; fields=[]\n    while len(fields)<3:\n        while p<len(data) and data[p] in b' \\t\\n\\r':\n            p+=1\n        start=p\n        while p<len(data) and data[p] not in b' \\t\\n\\r':\n            p+=1\n        fields.append(data[start:p])\n    w=int(fields[0]); h=int(fields[1])\n    while p<len(data) and data[p] in b' \\t\\n\\r':\n        p+=1\n    arr=np.frombuffer(data, dtype=np.uint8, offset=p).astype(np.int32)\n    return w,h,arr[:w*h*3].reshape(h,w,3)\nw,h,img=read_ppm('/app/image.ppm')\nR=img[:,:,0]; G=img[:,:,1]; B=img[:,:,2]\n# sphere detection\nred=(R>90)&(R>2.2*G)&(B<100)\nys,xs=np.where(red)\nif len(xs):\n    print('SPHERE bbox x[%d,%d] y[%d,%d] count=%d'%(xs.min(),xs.max(),ys.min(),ys.max(),len(xs)))\n    sub=img[ys.min():ys.max()+1, xs.min():xs.max()+1]\n    print('  min rgb',sub.reshape(-1,3).min(0),'max rgb',sub.reshape(-1,3).max(0))\n# sky gradi"]
