[265.198149, "i", "cat > /tmp/an2.py << 'EOF'\nimport numpy as np\ndef read_ppm(path):\n    with open(path,'rb') as f:\n        data=f.read()\n    assert data[:2]==b'P6'\n    p=2; fields=[]\n    while len(fields)<3:\n        while p<len(data) and data[p] in b' \\t\\n\\r':\n            p+=1\n        start=p\n        while p<len(data) and data[p] not in b' \\t\\n\\r':\n            p+=1\n        fields.append(data[start:p])\n    w=int(fields[0]); h=int(fields[1]); mx=int(fields[2])\n    while p<len(data) and data[p] in b' \\t\\n\\r':\n        p+=1\n    arr=np.frombuffer(data, dtype=np.uint8, offset=p).astype(np.int32)\n    arr=arr[:w*h*3].reshape(h,w,3)\n    return w,h,arr\nw,h,img=read_ppm('/app/image.ppm')\nprint('dims',w,h)\n# background using edge columns x in [0,80] and [w-80,w)\nxs=np.concatenate([np.arange(0,80), np.arange(w-80,w)])\nbg=img[:,xs,:].reshape(h,-1,3).mean(axis=1)  # avg over edge columns\nprint('--- background R,G,B per row (step 20) ---')\nfor y in range(0,h,20):\n    r,g,b=bg[y]\n    print(f'y={y:3d} rgb=({r:3.0f},{g:3.0f},{b:3.0f})')\nEOF\n/app/.venv/bin/python /tmp/an2.py\n"]
