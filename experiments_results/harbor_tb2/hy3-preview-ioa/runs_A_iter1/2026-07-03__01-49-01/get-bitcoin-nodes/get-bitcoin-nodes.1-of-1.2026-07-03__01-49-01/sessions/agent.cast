[206.917677, "o", "\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.917837, "o", "import requests\r\n"]
[206.917904, "o", "\u001b[?2004l\r"]
[206.918026, "o", "\u001b[?2004h"]
[206.91811, "o", "> "]
[206.918543, "o", "from flask import Flask, jsonify\r\n\u001b[?2004l\r"]
[206.918766, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> try:\r\n\u001b[?2004l\rid\u001b[?2004h> "]
[206.919009, "o", "    from bitcoinlib.encoding import hex_to_bytes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.91912, "o", "    HAVE_BITCOINLIB = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[206.919184, "o", "> except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.919394, "o", "    HAVE_BITCOINLIB = False\r\n\u001b[?2004l\r"]
[206.91942, "o", "\u001b[?2004h"]
[206.919493, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.919637, "o", "app = Flask(__name__)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[206.919742, "o", "\u001b[?2004h> "]
[206.919801, "o", "CONF_PATHS = [\r\n\u001b[?2004l\r"]
[206.919874, "o", "\u001b[?2004h> "]
[206.921853, "o", "    os.environ.get(\"BITCOIN_CONF\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.921897, "o", "    os.path.expanduser(\"~/.bitcoin/bitcoin.conf\"),\r\n\u001b[?2004l\r\u001b[?2004h>     \"/etc/bitcoin/bitcoin.conf\",\r\n\u001b[?2004l\r{\u001b[?2004h>     \"/app/bitcoin.conf\",\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> \r\n\u001b[?2004l\ru\u001b[?2004h> def _parse_conf(path):\r\n\u001b[?2004l\r\u001b[?2004h>     cfg = {}\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         with open(path) as fh:\r\n\u001b[?2004l\r\u001b[?2004h>             for line in fh:\r\n\u001b[?2004l\r\u001b[?2004h>                 line = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.922292, "o", "                if not line or line.startswith(\"#\") or \"=\" not in line:\r\n\u001b[?2004l\r\u001b[?2004h>                     continue\r\n\u001b[?2004l\r"]
[206.92239, "o", "\u001b[?2004h> "]
[206.922568, "o", "                k, v = line.split(\"=\", 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.922776, "o", "                k = k.strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.92311, "o", "                v = v.strip().strip('\"').strip(\"'\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.923568, "o", "                if k in (\"rpcuser\", \"rpcpassword\", \"rpcport\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.9237, "o", "                    cfg[k] = v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.923825, "o", "    except OSError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.924339, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h>     return cfg\r\n\u001b[?2004l\r(\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rh\u001b[?2004h> "]
[206.924365, "o", "def get_rpc_config():\r\n\u001b[?2004l\r\u001b[?2004h>     conf = {}\r\n\u001b[?2004l\r \u001b[?2004h> "]
[206.92488, "o", "    for p in CONF_PATHS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.925117, "o", "        if p and os.path.exists(p):\r\n\u001b[?2004l\r(\u001b[?2004h> "]
[206.925264, "o", "            conf = _parse_conf(p)"]
[206.92529, "o", "\r\n\u001b[?2004l\r"]
[206.925588, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\rame"]
[206.925627, "o", "\u001b[?2004h> "]
[206.926043, "o", "    host = os.environ.get(\"BITCOIN_RPC_HOST\", \"127.0.0.1\")"]
[206.926373, "o", "\r\n"]
