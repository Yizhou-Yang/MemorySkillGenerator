[206.933308, "o", "    def _url(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.933365, "o", "        return \"http://%s:%d/\" % (self.cfg[\"host\"], self.cfg[\"port\"])\r\n\u001b[?2004l\r"]
[206.933405, "o", "\u001b[?2004h> \r\n"]
