[206.916966, "i", "cat > /app/bitcoin_service.py << 'PYEOF'\n#!/usr/bin/env python3\nimport os\nimport requests\nfrom flask import Flask, jsonify\n\ntry:\n    from bitcoinlib.encoding import hex_to_bytes\n    HAVE_BITCOINLIB = True\nexcept Exception:\n    HAVE_BITCOINLIB = False\n\napp = Flask(__name__)\n\nCONF_PATHS = [\n    os.environ.get(\"BITCOIN_CONF\", \"\"),\n    os.path.expanduser(\"~/.bitcoin/bitcoin.conf\"),\n    \"/etc/bitcoin/bitcoin.conf\",\n    \"/app/bitcoin.conf\",\n]\n\n\ndef _parse_conf(path):\n    cfg = {}\n    try:\n        with open(path) as fh:\n            for line in fh:\n                line = line.strip()\n                if not line or line.startswith(\"#\") or \"=\" not in line:\n                    continue\n                k, v = line.split(\"=\", 1)\n                k = k.strip().lower()\n                v = v.strip().strip('\"').strip(\"'\")\n                if k in (\"rpcuser\", \"rpcpassword\", \"rpcport\"):\n                    cfg[k] = v\n    except OSError:\n        pass\n    return cfg\n\n\ndef get_rpc_config():\n    conf = {}\n    for p in CONF_PATHS:\n   "]
[206.917028, "i", "     if p and os.path.exists(p):\n            conf = _parse_conf(p)\n            break\n    host = os.environ.get(\"BITCOIN_RPC_HOST\", \"127.0.0.1\")\n    port = os.environ.get(\"BITCOIN_RPC_PORT\", conf.get(\"rpcport\", \"8332\"))\n    user = os.environ.get(\"BITCOIN_RPC_USER\", conf.get(\"rpcuser\", \"\"))\n    pwd = os.environ.get(\"BITCOIN_RPC_PASS\", conf.get(\"rpcpassword\", \"\"))\n    try:\n        port = int(port)\n    except ValueError:\n        port = 8332\n    return {\"host\": host, \"port\": port, \"user\": user, \"password\": pwd, \"timeout\": float(os.environ.get(\"BITCOIN_RPC_TIMEOUT\", \"10\"))}\n\n\nclass RpcError(Exception):\n    def __init__(self, msg, connection=False):\n        super().__init__(msg)\n        self.connection = connection\n\n\nclass BitcoinRPC:\n    def __init__(self, cfg=None):\n        self.cfg = cfg or get_rpc_config()\n\n    def _url(self):\n        return \"http://%s:%d/\" % (self.cfg[\"host\"], self.cfg[\"port\"])\n\n    def call(self, method, params=None):\n        payload = {\"jsonrpc\": \"1.0\", \"id\": \"svc\", \"method\": method, \"params\""]
[206.917049, "i", ": params or []}\n        try:\n            resp = requests.post(self._url(), json=payload, auth=(self.cfg[\"user\"], self.cfg[\"password\"]) or None, timeout=self.cfg[\"timeout\"])\n        except requests.exceptions.RequestException as exc:\n            raise RpcError(\"Unable to connect to Bitcoin node: %s\" % exc, connection=True)\n        try:\n            data = resp.json()\n        except ValueError:\n            raise RpcError(\"Invalid response from Bitcoin node\", connection=True)\n        if isinstance(data, dict) and data.get(\"error\"):\n            raise RpcError(data[\"error\"].get(\"message\", \"RPC error\"))\n        return data.get(\"result\")\n\n\ndef _rpc():\n    return BitcoinRPC()\n\n\ndef _validate_hex(value, length=None):\n    if not isinstance(value, str):\n        return False\n    v = value.strip()\n    if length is not None and len(v) != length:\n        return False\n    try:\n        if HAVE_BITCOINLIB:\n            hex_to_bytes(v)\n        else:\n            bytes.fromhex(v)\n        return True\n    except Exception:\n        re"]
[206.917066, "i", "turn False\n\n\ndef _not_connected():\n    return jsonify({\"status\": \"Not connected to the Bitcoin network\"}), 503\n\n\n@app.route(\"/\")\ndef index():\n    return jsonify({\"service\": \"bitcoin-service\", \"endpoints\": [\"/block/<hash>\", \"/transaction/<txid>\", \"/status\"]})\n\n\n@app.route(\"/status\")\ndef status():\n    try:\n        info = _rpc().call(\"getblockchaininfo\")\n        return jsonify({\"status\": \"online\", \"blocks\": info.get(\"blocks\"), \"chain\": info.get(\"chain\")})\n    except RpcError:\n        return _not_connected()\n\n\n@app.route(\"/block/<block_hash>\")\ndef get_block(block_hash):\n    if not _validate_hex(block_hash, 64):\n        return jsonify({\"error\": \"Invalid block hash\"}), 404\n    try:\n        block = _rpc().call(\"getblock\", [block_hash, 1])\n    except RpcError as exc:\n        if exc.connection:\n            return _not_connected()\n        return jsonify({\"error\": \"Block not found\"}), 404\n    return jsonify({\"hash\": block.get(\"hash\"), \"height\": block.get(\"height\"), \"merkleroot\": block.get(\"merkleroot\"), \"time\": block.ge"]
[206.917082, "i", "t(\"time\"), \"nonce\": block.get(\"nonce\"), \"tx\": block.get(\"tx\", [])})\n\n\n@app.route(\"/transaction/<txid>\")\ndef get_transaction(txid):\n    if not _validate_hex(txid, 64):\n        return jsonify({\"error\": \"Invalid transaction id\"}), 404\n    try:\n        tx = _rpc().call(\"getrawtransaction\", [txid, 1])\n    except RpcError as exc:\n        if exc.connection:\n            return _not_connected()\n        return jsonify({\"error\": \"Transaction not found\"}), 404\n    vin = []\n    for vi in tx.get(\"vin\", []):\n        item = {\"sequence\": vi.get(\"sequence\")}\n        if \"coinbase\" in vi:\n            item[\"coinbase\"] = vi[\"coinbase\"]\n        if \"txid\" in vi:\n            item[\"txid\"] = vi[\"txid\"]\n            item[\"vout\"] = vi.get(\"vout\")\n        vin.append(item)\n    vout = []\n    for v in tx.get(\"vout\", []):\n        spk = v.get(\"scriptPubKey\", {})\n        vout.append({\"value\": v.get(\"value\"), \"n\": v.get(\"n\"), \"scriptPubKey\": {\"asm\": spk.get(\"asm\"), \"hex\": spk.get(\"hex\"), \"type\": spk.get(\"type\")}})\n    return jsonify({\"txid\": tx.g"]
[206.917097, "i", "et(\"txid\"), \"blockhash\": tx.get(\"blockhash\"), \"vin\": vin, \"vout\": vout})\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=5000, threaded=True)\nPYEOF\n"]
