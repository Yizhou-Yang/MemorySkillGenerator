[376.114146, "o", "\u001b[?2004l\r"]
[376.114339, "o", "\u001b[?2004h"]
[376.114543, "o", "> "]
[376.114795, "o", "tokenizer = AutoTokenizer.from_pretrained(MODEL_DIR)"]
