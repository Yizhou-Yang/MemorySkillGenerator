[376.116246, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[376.116692, "o", "> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Model loaded.\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> app = Flask(__name__)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[376.120767, "o", "> LABELS = {0: \"negative\", 1: \"positive\"}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def softmax(logits):\r\n\u001b[?2004l\r\u001b[?2004h>     probs = torch.softmax(logits, dim=-1)\r\n\u001b[?2004l\r\u001b[?2004h>     return probs.detach().cpu().numpy()[0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.route(\"/sentiment\", methods=[\"POST\"])\r\n\u001b[?2004l\r\u001b[?2004h> def sentiment():\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         data = request.get_json(silent=True)\r\n\u001b[?2004l\r\u001b[?2004h>         if not data or \"text\" not in data:\r\n\u001b[?2004l\r\u001b[?2004h>             return jsonify({\"error\": \"Missing 'text' field in request body\"}), 400\r\n\u001b[?2004l\r\u001b[?2004h>         text = data[\"text\"]\r\n\u001b[?2004l\r\u001b[?2004h>         if not isinstance(text, str) or not text.strip():\r\n\u001b[?2004l\r\u001b[?2004h>             return jsonify({\"error\": \"'text' must be a non-empty string\"}), 400\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"error\": f\"Invalid JSON: {e}\"}), 400\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[376.120806, "o", "\u001b[?2004h>         inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\r\n\u001b[?2004l\r\u001b[?2004h>         with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>             logits = model(**inputs).logits\r\n\u001b[?2004l\r\u001b[?2004h>         probs = softmax(logits)\r\n\u001b[?2004l\r\u001b[?2004h>         pos = float(probs[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[376.121253, "o", "        neg = float(probs[0])\r\n\u001b[?2004l\r\u001b[?2004h>         pred = int(probs.argmax())\r\n"]
[376.121276, "o", "\u001b[?2004l\r"]
[376.12144, "o", "\u001b[?2004h> "]
[376.121606, "o", "        sentiment_label = LABELS[pred]"]
[376.121725, "o", "\r\n"]
[376.121875, "o", "\u001b[?2004l\r"]
[376.122079, "o", "\u001b[?2004h> "]
[376.123556, "o", "        return jsonify({"]
