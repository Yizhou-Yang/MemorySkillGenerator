[416.71057, "i", "cat > /app/test_api.py << 'EOF'\nimport json\nimport requests\n\nURL = \"http://127.0.0.1:5000/sentiment\"\n\nsamples = [\n    \"I absolutely loved this movie, it was fantastic!\",\n    \"This was the worst experience I have ever had, totally terrible.\",\n    \"The book was okay, nothing special but not bad either.\",\n]\n\nfor i, text in enumerate(samples, 1):\n    try:\n        resp = requests.post(URL, json={\"text\": text}, timeout=30)\n        print(f\"--- Sample {i} ---\")\n        print(\"Request:\", json.dumps({\"text\": text}))\n        print(\"Status:\", resp.status_code)\n        print(\"Response:\", json.dumps(resp.json(), indent=2))\n    except Exception as e:\n        print(f\"--- Sample {i} ---\")\n        print(\"Error:\", e)\n    print()\nEOF\n"]
