[11.123429, "o", "\u001b[?2004hroot@71d3453864ca:/app# "]
[405.869783, "i", "cat > /tmp/recon.py << 'EOF'\nimport sys\nout = bytearray()\nwith open('/app/data.hex') as f:\n    for line in f:\n        parts = line.split()\n        if not parts:\n            continue\n        for tok in parts[1:]:\n            v = int(tok, 8)\n            out.append(v & 0xFF)\n            out.append((v >> 8) & 0xFF)\nwith open('/app/data.bin','wb') as f:\n    f.write(out)\nprint('wrote', len(out), 'bytes')\nEOF\n"]
[405.86987, "o", "cat > /tmp/recon.py << 'EOF'"]
