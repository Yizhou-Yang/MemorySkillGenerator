[407.300025, "o", "\u001b[?2004hroot@71d3453864ca:/app# "]
[582.839676, "i", "cat > /tmp/analyze.py << 'PYEOF'\nimport sys\ndata=open('/app/data.bin','rb').read()\nprint('len',len(data))\nmagic=int.from_bytes(data[0:2],'little')\nprint('magic',oct(magic))\na_text=int.from_bytes(data[2:4],'little')\na_data=int.from_bytes(data[4:6],'little')\na_bss=int.from_bytes(data[6:8],'little')\na_syms=int.from_bytes(data[8:10],'little')\na_entry=int.from_bytes(data[10:12],'little')\na_tr=int.from_bytes(data[12:14],'little')\na_dr=int.from_bytes(data[14:16],'little')\nprint('text',a_text,'data',a_data,'bss',a_bss,'syms',a_syms,'entry',a_entry,'tr',a_tr,'dr',a_dr)\ndef runs(b):\n    res=[];cur=[];start=-1\n    for i,v in enumerate(b):\n        if 32<=v<127:\n            if not cur: start=i\n            cur.append(chr(v))\n        else:\n            if len(cur)>=4: res.append((start,''.join(cur)))\n            cur=[]\n    if len(cur)>=4: res.append((start,''.join(cur)))\n    return res\nfor off,s in runs(data):\n    print(hex(off),repr(s))\nPYEOF\n"]
[582.839792, "o", "cat > /tmp/analyze.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> data=open('/app/data.bin','rb').read()\r\n\u001b[?2004l\r\u001b[?2004h> print('len',len(data))\r\n\u001b[?2004l\r\u001b[?2004h> magic=int.from_bytes(data[0:2],'little')\r\n\u001b[?2004l\r\u001b[?2004h> print('magic',oct(magic))\r\n\u001b[?2004l\r\u001b[?2004h> a_text=int.from_bytes(data[2:4],'little')\r\n\u001b[?2004l\r\u001b[?2004h> a_data=int.from_bytes(data[4:6],'little')\r\n\u001b[?2004l\r\u001b[?2004h> a_bss=int.from_bytes(data[6:8],'little')\r\n\u001b[?2004l\r\u001b[?2004h> a_syms=int.from_bytes(data[8:10],'little')\r\n\u001b[?2004l\r\u001b[?2004h> a_entry=int.from_bytes(data[10:12],'little')\r\n\u001b[?2004l\r\u001b[?2004h> a_tr=int.from_bytes(data[12:14],'little')\r\n\u001b[?2004l\r\u001b[?2004h> a_dr=int.from_bytes(data[14:16],'little')\r\n\u001b[?2004l\r\u001b[?2004h> print('text',a_text,'data',a_data,'bss',a_bss,'syms',a_syms,'entry',a_entry,'tr',a_tr,'dr',a_dr)\r\n\u001b[?2004l\r\u001b[?2004h> def runs(b):\r\n\u001b[?2004l\r\u001b[?2004h>     res=[];cur=[];start=-1\r\n\u001b[?2004l\r\u001b[?2004h>     for i,v in enumerate(b):\r\n\u001b[?2004l\r\u001b[?2004h>         if 32<=v<127:\r\n\u001b[?2004l\r\u001b[?2004h>       "]
