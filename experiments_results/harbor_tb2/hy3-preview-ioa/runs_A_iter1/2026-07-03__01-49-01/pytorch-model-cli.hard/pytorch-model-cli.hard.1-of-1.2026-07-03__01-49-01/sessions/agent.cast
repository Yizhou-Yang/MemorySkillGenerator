[242.2638, "o", "\u001b[?2004hroot@d7188015bae8:/app# "]
[338.175657, "i", "cat > /tmp/convert.py << 'PYEOF'\nimport zipfile, pickle, io, array, json\n\nPATH='/app/model.pth'\n\nclass Loader:\n    def __init__(self, z):\n        self.z=z\n    def persistent_load(self, pid):\n        assert pid[0]=='storage', 'unexpected pid'\n        key=pid[2]; numel=pid[4]\n        raw=self.z.read('simple_mnist/data/'+str(key))\n        arr=array.array('f')\n        arr.frombytes(raw)\n        return arr\n    def rebuild(self, storage, offset, size, stride, requires_grad, hooks):\n        numel=1\n        for s in size:\n            numel*=s\n        flat=list(storage[offset:offset+numel])\n        return to_nested(flat, tuple(size))\n    def find_class(self, mod, name):\n        if (mod,name)==('torch._utils','_rebuild_tensor_v2'):\n            return self.rebuild\n        if (mod,name)==('collections','OrderedDict'):\n            return dict\n        if name.endswith('Storage'):\n            return float\n        raise pickle.UnpicklingError('unknown global %s.%s' % (mod,name)"]
