[684.510057, "i", "tStorage':\n            return float\n        return super().find_class(mod,name)\n    def persistent_load(self, pid):\n        a=self.loader.persistent_load(pid)\n        try:\n            bo=self.z.read('simple_mnist/byteorder').decode().strip()\n        except KeyError:\n            bo='little'\n        if bo!='little':\n            a.byteswap()\n        return a\n\ndef to_nested(flat, size):\n    if len(size)==1:\n        return list(flat)\n    n=size[0]; sub=size[1:]\n    per=len(flat)//n\n    return [to_nested(flat[i*per:(i+1)*per], sub) for i in range(n)]\n\ndef main():\n    z=zipfile.ZipFile(PATH)\n    loader=Loader(z)\n    sd=MyUnpickler(z, loader).load()\n    out=dict(sd)\n    with open('/app/weights.json','w') as f:\n        json.dump(out,f)\n    print('written /app/weights.json')\n    for k,v in out.items():\n        if isinstance(v,list):\n            print(k,'rows=',len(v),'row0 len=',len(v[0]) if isinstance(v[0],list) else 1, 'sample=',round(v[0][0] if isinstance(v[0],list) else v[0],4))\n        else:\n            print(k,v)"]
