[684.50738, "i", "cat > /tmp/convert.py << 'PYEOF'\nimport zipfile, pickle, io, array, json\n\nPATH='/app/model.pth'\n\nclass Loader:\n    def __init__(self, z):\n        self.z=z\n    def persistent_load(self, pid):\n        assert pid[0]=='storage', 'unexpected pid'\n        key=pid[2]\n        raw=self.z.read('simple_mnist/data/'+str(key))\n        arr=array.array('f')\n        arr.frombytes(raw)\n        return arr\n    def rebuild(self, storage, offset, size, stride, requires_grad, hooks):\n        numel=1\n        for s in size:\n            numel*=s\n        flat=list(storage[offset:offset+numel])\n        return to_nested(flat, tuple(size))\n\nclass MyUnpickler(pickle.Unpickler):\n    def __init__(self, z, loader):\n        super().__init__(io.BytesIO(z.read('simple_mnist/data.pkl')))\n        self.z=z; self.loader=loader\n    def find_class(self, mod, name):\n        if (mod,name)==('torch._utils','_rebuild_tensor_v2'):\n            return self.loader.rebuild\n        if mod=='torch' and name=='Floa"]
