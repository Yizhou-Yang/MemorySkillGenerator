[231.558039, "i", "cat > /tmp/explore2.py << 'PYEOF'\nimport zipfile, pickle, io\n\npath='/app/model.pth'\nz=zipfile.ZipFile(path)\nprint('NAMES:', z.namelist())\ndata=z.read('archive/data.pkl')\n\nrec={'cls':[], 'pid':[], 'reb':[]}\n\ndef rebuild(*args):\n    rec['reb'].append(args)\n    return ('TENSOR', args)\n\nclass U(pickle.Unpickler):\n    def find_class(self, mod, name):\n        rec['cls'].append((mod,name))\n        if (mod,name)==('torch._utils','_rebuild_tensor_v2'):\n            return rebuild\n        if (mod,name)==('torch','_rebuild_tensor'):\n            return rebuild\n        if (mod,name)==('collections','OrderedDict'):\n            return dict\n        if mod=='torch.storage' and name=='_load_from_bytes':\n            return lambda b: ('SB', b)\n        if name.endswith('Storage'):\n            return lambda *a, **k: ('STG', name, a, k)\n        return lambda *a, **k: ('STUB', mod, name, a, k)\n    def persistent_load(self, pid):\n        rec['pid'].append(pid)\n        return ('PID', pid)"]
[231.558598, "o", "cat > /tmp/explore2.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import zipfile, pickle, io\r\n\u001b[?2004l\r\u001b[?2004h"]
