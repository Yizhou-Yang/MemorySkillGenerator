[662.434894, "i", "cat > /tmp/convert.py << 'PYEOF'\nimport zipfile, pickle, io, array, json\n\nPATH='/app/model.pth'\n\nclass Loader:\n    def __init__(self, z):\n        self.z=z\n    def persistent_load(self, pid):\n        assert pid[0]=='storage', 'unexpected pid'\n        key=pid[2]\n        raw=self.z.read('simple_mnist/data/'+str(key))\n        arr=array.array('f')\n        arr.frombytes(raw)\n        return arr\n    def rebuild(self, storage, offset, size, stride, requires_grad, hooks):\n        numel=1\n        for s in size:\n            numel*=s\n        flat=list(storage[offset:offset+numel])\n        return to_nested(flat, tuple(size))\n\nclass MyUnpickler(pickle.Unpickler):\n    def __init__(self, z, loader):\n        super().__init__(io.BytesIO(z.read('simple_mnist/data.pkl')))\n        self.z=z; self.loader=loader\n    def find_class(self, mod, name):\n        if (mod,name)==('torch._utils','_rebuild_tensor_v2'):\n            return self.loader.rebuild\n        return super().find_class(mod,n"]
[662.434969, "i", "ame)\n    def persistent_load(self, pid):\n        a=self.loader.persistent_load(pid)\n        try:\n            bo=self.z.read('simple_mnist/byteorder').decode().strip()\n        except KeyError:\n            bo='little'\n        if bo!='little':\n            a.byteswap()\n        return a\n\ndef to_nested(flat, size):\n    if len(size)==1:\n        return list(flat)\n    n=size[0]; sub=size[1:]\n    per=len(flat)//n\n    return [to_nested(flat[i*per:(i+1)*per], sub) for i in range(n)]\n\ndef main():\n    z=zipfile.ZipFile(PATH)\n    loader=Loader(z)\n    sd=MyUnpickler(z, loader).load()\n    out=dict(sd)\n    with open('/app/weights.json','w') as f:\n        json.dump(out,f)\n    print('written /app/weights.json')\n    for k,v in out.items():\n        if isinstance(v,list):\n            print(k,'rows=',len(v),'row0 len=',len(v[0]) if isinstance(v[0],list) else 1)\n        else:\n            print(k,v)\n\nmain()\nPYEOF\n"]
[662.43513, "o", "cat > /tmp/convert.py << 'PYEOF'"]
