[737.802773, "o", "def to28(src,sw,sh):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[737.803094, "o", "    if sw==T and sh==T: return src[:]\r\n\u001b[?2004l\r\u001b[?2004h>     out=[]\r\n\u001b[?2004l\r"]
[737.803289, "o", "\u001b[?2004h> "]
[737.803441, "o", "    for y in range(T):"]
[737.804186, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         sy=int(y*sh/T)\r\n\u001b[?2004l\r\u001b[?2004h>         for x in range(T):\r\n\u001b[?2004l\r\u001b[?2004h>             sx=int(x*sw/T)\r\n\u001b[?2004l\r\u001b[?2004h>             out.append(src[sy*sw+sx])\r\n\u001b[?2004l\r\u001b[?2004h>     return out\r\n\u001b[?2004l\r\u001b[?2004h"]
