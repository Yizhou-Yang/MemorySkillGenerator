[737.788928, "i", "cat > /tmp/experiment.py << 'PYEOF'\nimport sys, json, math\nfrom png import decode\nsys.path.insert(0,'/tmp')\nw,h,ct,ch,px=decode('/app/image.png')\nprint('IHDR width=%d height=%d color_type=%d ch=%d total_bytes=%d'%(w,h,ct,ch,len(px)))\ngray=[]\nif ch==1:\n    gray=list(px)\nelif ch in (3,4):\n    for i in range(0,len(px),ch):\n        r=px[i]; g=px[i+1]; b=px[i+2]\n        gray.append(int(0.299*r+0.587*g+0.114*b))\nelif ch==2:\n    for i in range(0,len(px),ch):\n        gray.append(int(0.5*(px[i]+px[i+1])))\nmn=min(gray); mx=max(gray); mean=sum(gray)/len(gray)\nprint('gray min=%d max=%d mean=%.2f'%(mn,mx,mean))\n# build 28x28 vector (resize via nearest if needed)\nT=28\ndef to28(src,sw,sh):\n    if sw==T and sh==T: return src[:]\n    out=[]\n    for y in range(T):\n        sy=int(y*sh/T)\n        for x in range(T):\n            sx=int(x*sw/T)\n            out.append(src[sy*sw+sx])\n    return out\nvec=to28(gray,w,h)\nW=json.load(open('/app/weights.json'))\ndef lin(Wmat,b,x):\n    return [s"]
[737.789019, "i", "um(x[j]*Wmat[i][j] for j in range(len(x)))+b[i] for i in range(len(Wmat))]\ndef relu(v): return [max(0.0,vv) for vv in v]\ndef fwd(x):\n    h1=relu(lin(W['input_layer.weight'],W['input_layer.bias'],x))\n    h2=relu(lin(W['hidden_layer.weight'],W['hidden_layer.bias'],h1))\n    return lin(W['output_layer.weight'],W['output_layer.bias'],h2)\nopts={'raw':lambda g:g/255.0,\n      'norm':lambda g:(g/255.0-0.1307)/0.3081,\n      'inv_raw':lambda g:1.0-g/255.0,\n      'inv_norm':lambda g:(1.0-g/255.0-0.1307)/0.3081}\nfor name,f in opts.items():\n    x=[f(v) for v in vec]\n    out=fwd(x)\n    order=sorted(range(10), key=lambda i:-out[i])\n    top=order[0]; second=order[1]\n    print('%-9s pred=%d  logits_top2=(%d:%.3f, %d:%.3f)  all=%-60s'%(name,top,top,out[top],second,out[second],' '.join('%.2f'%o for o in out)))\nPYEOF\n"]
