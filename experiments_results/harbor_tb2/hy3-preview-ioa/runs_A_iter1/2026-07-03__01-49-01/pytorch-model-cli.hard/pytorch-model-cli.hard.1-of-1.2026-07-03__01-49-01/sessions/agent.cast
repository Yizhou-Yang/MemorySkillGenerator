[737.591471, "i", "cat > /tmp/png.py << 'PYEOF'\nimport struct, zlib\n\ndef decode(path):\n    with open(path,'rb') as f: data=f.read()\n    assert data[:8]==b'\\x89PNG\\r\\n\\x1a\\n', 'not png'\n    pos=8; width=height=bit_depth=color_type=None; idat=b''\n    while pos < len(data):\n        length=struct.unpack('>I', data[pos:pos+4])[0]; pos+=4\n        ctype=data[pos:pos+4]; pos+=4\n        cdata=data[pos:pos+length]; pos+=length; pos+=4\n        if ctype==b'IHDR':\n            width,height,bit_depth,color_type=struct.unpack('>IIBB', cdata[:10])\n        elif ctype==b'IDAT': idat+=cdata\n        elif ctype==b'IEND': break\n    raw=zlib.decompress(idat)\n    ch={2:3,6:4,0:1,4:2}.get(color_type)\n    bpp=ch; stride=width*ch\n    out=bytearray(); prev=bytearray(stride); pos=0\n    for y in range(height):\n        ft=raw[pos]; pos+=1\n        line=bytearray(raw[pos:pos+stride]); pos+=stride\n        for i in range(stride):\n            x=line[i]\n            a=line[i-bpp] if i>=bpp else 0\n            b=prev[i]; c=prev[i-bpp] if i>=bpp else 0\n            if f"]
[737.591697, "o", "cat > /tmp/png.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[737.591897, "i", "t==0: pass\n            elif ft==1: x=(x+a)&255\n            elif ft==2: x=(x+b)&255\n            elif ft==3: x=(x+((a+b)//2))&255\n            elif ft==4:\n                p=a+b-c; pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\n                pr=a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\n                x=(x+pr)&255\n            line[i]=x\n        out+=line; prev=line\n    return width,height,color_type,ch,bytes(out)\nPYEOF\n"]
