[338.275367, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class Loader:\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, z):\r\n\u001b[?2004l\r\u001b[?2004h>         self.z=z\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.27665, "i", ")\n\ndef to_nested(flat, size):\n    if len(size)==1:\n        return list(flat)\n    n=size[0]; sub=size[1:]\n    per=len(flat)//n\n    return [to_nested(flat[i*per:(i+1)*per], sub) for i in range(n)]\n\ndef main():\n    z=zipfile.ZipFile(PATH)\n    bo='little'\n    try:\n        bo=z.read('simple_mnist/byteorder').decode().strip()\n    except KeyError:\n        pass\n    print('byteorder=', bo)\n    store=Loader(z)\n    class U(pickle.Unpickler):\n        def __init__(self):\n            super().__init__(io.BytesIO(z.read('simple_mnist/data.pkl')))\n        def find_class(self, mod, name):\n            return store.find_class(mod,name)\n        def persistent_load(self, pid):\n            a=store.persistent_load(pid)\n            if bo!='little':\n                a.byteswap()\n            return a\n    sd=U().load()\n    out={}\n    for k,v in sd.items():\n        out[k]=v\n    with open('/app/weights.json','w') as f:\n        json.dump(out,f)\n    print('written /app/weights.json')\n    for k,v in out.items():\n        if isinstance(v,list):"]
[338.276945, "i", "\n            print(k,'rows=',len(v),'row0 len=',len(v[0]) if isinstance(v[0],list) else 1)\n        else:\n            print(k,v)\n\nmain()\nPYEOF\n"]
