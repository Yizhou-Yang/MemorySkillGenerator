[189.706818, "i", "5rem;\n}\nnav.main a:hover,nav.main a.active{color:var(--accent);}\nmain{max-width:var(--max-width);margin:0 auto;padding:2.5rem 1.25rem 4rem;}\nh1,h2,h3{font-family:Georgia,'Times New Roman',serif;color:#1a202c;line-height:1.25;}\nh1{font-size:2.2rem;margin-top:0;}\nh2{font-size:1.45rem;margin-top:2.4rem;border-bottom:1px solid var(--border);padding-bottom:.35rem;}\nh3{font-size:1.15rem;}\n.lead{font-size:1.12rem;color:var(--muted);}\na{color:var(--accent-light);}\np{margin:.6rem 0;}\nul,ol{padding-left:1.3rem;}\nli{margin:.3rem 0;}\n.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.8rem;color:var(--accent-light);font-weight:700;margin:0 0 .4rem;}\n.hero{margin-bottom:1rem;}\n.cards{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:1rem;}\n.cards li{background:#f7fafc;border:1px solid var(--border);border-radius:8px;padding:1rem 1.1rem;font-size:.98rem;}\n.links{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:.5rem;}\n.card-link{display:flex;flex-direction:column;background:#fff;border:1px solid var(--border);border-left:4px solid var(--accent);border-radius:8px;padding:1rem;text-decoration:none;color:var(--fg);transition:.15s;}\n.card-link:hover{box-shadow:0 2px 10px rgba(0,0,0,.06);transform:translateY(-2px);}\n.card-link span{font-family:Georgia,serif;font-weight:700;font-size:1.1rem;color:var(--accent);}\n.card-link small{color:var(--muted);margin-top:.2rem;}\n.post{border:1px solid var(--border);border-radius:8px;padding:1.2rem 1.4rem;margin:1.2rem 0;background:#f7fafc;}\n.post h3{margin-top:0;}\n.meta{color:var(--muted);font-size:.85rem;margin:0 0 .4rem;text-transform:uppercase;letter-spacing:.05em;}\n.pubs li{margin:.7rem 0;}\n.site-footer{border-top:1px solid var(--border);margin-top:2rem;}\n.site-footer .inner{max-width:var(--max-width);margin:0 auto;padding:1.5rem 1.25rem;color:var(--muted);font-size:.9rem;}\n.site-footer p{margin:.2rem 0;}\n.muted{color:var(--muted);}\n@media(max-width:680px){\n  .cards,.links{grid-template-columns:1fr;}\n  nav.main a{margin-left:.8rem;}\n}\nCSSEOF\n"]
