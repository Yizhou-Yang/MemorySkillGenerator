[191.016877, "o", "\u001b[?2004l\r"]
[191.017334, "o", "\u001b[?2004h"]
[191.021872, "o", "> "]
[191.023053, "o", "      <p>Lessons from applying GNNs to electron-microscopy reconstructions at scale, including memory and sampling tricks.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     </article>\r\n\u001b[?2004l\r\u001b[?2004h>   </main>\r\n\u001b[?2004l\r\u001b[?2004h>   <footer class=\"site-footer\">\r\n\u001b[?2004l\r\u001b[?2004h> "]
