[190.978686, "o", "\u001b[?2004l\r"]
[190.978925, "o", "\u001b[?2004h"]
[190.983568, "o", ">         <a href=\"about.html\">About Me</a>\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"publications.html\">Publications</a>\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"blog.html\" class=\"active\">Blog</a>\r\n\u001b[?2004l\r\u001b[?2004h>       </nav>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </header>\r\n\u001b[?2004l\r\u001b[?2004h>   <main>\r\n\u001b[?2004l\r\u001b[?2004h>     <h1>Blog</h1>\r\n\u001b[?2004l\r\u001b[?2004h>     <p class=\"lead\">Notes, essays, and insights from the lab.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     <article class=\"post\">\r\n\u001b[?2004l\r\u001b[?2004h>       <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\r\n\u001b[?2004l\r\u001b[?2004h>       <p class=\"meta\">March 2025</p>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.984799, "o", "      <p>A look at how we make black-box models transparent enough for neuroscientists to trust — feature attributions, decision-boundary probing, and what it buys us.</p>\r\n\u001b[?2004l\r"]
[190.985306, "o", "\u001b[?2004h"]
[190.985588, "o", "> "]
[190.985852, "o", "    </article>"]
[190.990119, "o", "\r\n"]
[190.990559, "o", "\u001b[?2004l\r"]
[190.990843, "o", "\u001b[?2004h"]
[190.991116, "o", "> "]
[190.991421, "o", "    <article class=\"post\">"]
[190.991693, "o", "\r\n"]
[190.99193, "o", "\u001b[?2004l\r"]
[190.993415, "o", "\u001b[?2004h"]
[190.993678, "o", "> "]
[190.994064, "o", "      <h3>Bridging Machine Learning and Single-Cell Genomics</h3>"]
[190.996833, "o", "\r\n"]
[190.997218, "o", "\u001b[?2004l\r"]
[190.998354, "o", "\u001b[?2004h"]
[190.998622, "o", "> "]
[190.998956, "o", "      <p class=\"meta\">January 2025</p>"]
[190.999209, "o", "\r\n"]
[190.999438, "o", "\u001b[?2004l\r"]
[190.999721, "o", "\u001b[?2004h"]
[190.999982, "o", "> "]
[191.000549, "o", "      <p>Why representation learning is quietly reshaping how we think about cell-type hierarchies, and where the pitfalls are.</p>"]
[191.0008, "o", "\r\n"]
[191.001021, "o", "\u001b[?2004l\r"]
[191.001279, "o", "\u001b[?2004h"]
[191.0015, "o", "> "]
