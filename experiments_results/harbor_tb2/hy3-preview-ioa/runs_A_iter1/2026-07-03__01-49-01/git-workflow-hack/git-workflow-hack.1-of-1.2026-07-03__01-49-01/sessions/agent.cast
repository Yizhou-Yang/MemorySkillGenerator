[190.936584, "i", "cat > blog.html <<'HTMLEOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Blog — Dr. Lydia Moreno</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"inner\">\n      <a class=\"brand\" href=\"index.html\">Lydia Moreno, Ph.D.</a>\n      <nav class=\"main\">\n        <a href=\"index.html\">Home</a>\n        <a href=\"about.html\">About Me</a>\n        <a href=\"publications.html\">Publications</a>\n        <a href=\"blog.html\" class=\"active\">Blog</a>\n      </nav>\n    </div>\n  </header>\n  <main>\n    <h1>Blog</h1>\n    <p class=\"lead\">Notes, essays, and insights from the lab.</p>\n    <article class=\"post\">\n      <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\n      <p class=\"meta\">March 2025</p>\n      <p>A look at how we make black-box models transparent enough for neuroscientists to trust — feature attributions, decision-boundary probing, and what it buys us.</p>\n    </article>\n    <article class=\"post\">\n      <h3>Bridging Machine Learning and Single-Cell Genomics</h3>\n      <p class=\"meta\">January 2025</p>\n      <p>Why representation learning is quietly reshaping how we think about cell-type hierarchies, and where the pitfalls are.</p>\n    </article>\n    <article class=\"post\">\n      <h3>Scaling Graph Neural Networks for Connectomics</h3>\n      <p class=\"meta\">November 2024</p>\n      <p>Lessons from applying GNNs to electron-microscopy reconstructions at scale, including memory and sampling tricks.</p>\n    </article>\n  </main>\n  <footer class=\"site-footer\">\n    <div class=\"inner\">\n      <p>© 2025 Dr. Lydia Moreno · Riverbend University</p>\n    </div>\n  </footer>\n</body>\n</html>\nHTMLEOF\n"]
[190.937312, "o", "cat > blog.html <<'HTMLEOF'"]
