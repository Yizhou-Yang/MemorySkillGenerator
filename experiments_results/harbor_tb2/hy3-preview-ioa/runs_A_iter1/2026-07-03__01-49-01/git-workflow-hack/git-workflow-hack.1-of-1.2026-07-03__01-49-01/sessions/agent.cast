[189.898861, "i", "cat > build.js <<'JSEOF'\nconst fs = require('fs');\nconst path = require('path');\nconst src = ['index.html', 'about.html', 'blog.html', 'publications.html', 'styles.css', 'info.md'];\nif (!fs.existsSync('public')) fs.mkdirSync('public');\nfor (const f of src) {\n  if (fs.existsSync(f)) fs.copyFileSync(f, path.join('public', f));\n}\nconsole.log('Build complete: copied files to ./public');\nJSEOF\n"]
