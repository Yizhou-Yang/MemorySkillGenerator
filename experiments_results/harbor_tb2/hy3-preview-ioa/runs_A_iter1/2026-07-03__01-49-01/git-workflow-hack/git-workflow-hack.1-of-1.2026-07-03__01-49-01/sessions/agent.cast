[190.298957, "i", "cat > index.html <<'HTMLEOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Dr. Lydia Moreno — Research Profile</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"inner\">\n      <a class=\"brand\" href=\"index.html\">Lydia Moreno, Ph.D.</a>\n      <nav class=\"main\">\n        <a href=\"index.html\" class=\"active\">Home</a>\n        <a href=\"about.html\">About Me</a>\n        <a href=\"publications.html\">Publications</a>\n        <a href=\"blog.html\">Blog</a>\n      </nav>\n    </div>\n  </header>\n  <main>\n    <section class=\"hero\">\n      <p class=\"eyebrow\">Research Profile</p>\n      <h1>Dr. Lydia Moreno</h1>\n      <p class=\"lead\">Associate Professor of Computational Neuroscience, Riverbend University</p>\n      <p>My research sits at the intersection of machine learning, systems neuroscience, and bioinformatics — building int"]
[190.299187, "i", "erpretable models to understand how neural circuits encode and process complex sensory information.</p>\n    </section>\n    <h2>Research Interests</h2>\n    <ul class=\"cards\">\n      <li><strong>Neural Encoding &amp; Decoding</strong> — interpretable models translating spike-train data into behavioral predictions.</li>\n      <li><strong>Machine Learning for Biomedical Imaging</strong> — CNNs and GNNs for MRI and two-photon microscopy.</li>\n      <li><strong>Single-Cell Omics</strong> — scalable pipelines for multi-modal single-cell genomics.</li>\n      <li><strong>Explainable AI in Neuroscience</strong> — probing decision boundaries of black-box models.</li>\n    </ul>\n    <h2>Explore</h2>\n    <div class=\"links\">\n      <a class=\"card-link\" href=\"about.html\"><span>About Me</span><small>Bio, education &amp; contact</small></a>\n      <a class=\"card-link\" href=\"publications.html\"><span>Publications</span><small>Peer-reviewed articles</small></a>\n      <a class=\"card-link\" href=\"blog.html\"><span>Blog</span><small>Notes &amp; insights</small></a>\n    </div>\n  </main>\n  <footer class=\"site-footer\">\n    <div class=\"inner\">\n      <p>© 2025 Dr. Lydia Moreno · Riverbend University</p>\n      <p class=\"muted\">Built as a static research profile site.</p>\n    </div>\n  </footer>\n</body>\n</html>\nHTMLEOF\n"]
