[190.311423, "o", ">   <link rel=\"stylesheet\" href=\"styles.css\">\r\n\u001b[?2004l\r\u001b[?2004h> </head>\r\n\u001b[?2004l\r\u001b[?2004h> <body>\r\n\u001b[?2004l\r\u001b[?2004h>   <header class=\"site\">\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"inner\">\r\n\u001b[?2004l\r\u001b[?2004h>       <a class=\"brand\" href=\"index.html\">Lydia Moreno, Ph.D.</a>\r\n\u001b[?2004l\r\u001b[?2004h>       <nav class=\"main\">\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"index.html\" class=\"active\">Home</a>\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"about.html\">About Me</a>\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"publications.html\">Publications</a>\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"blog.html\">Blog</a>\r\n\u001b[?2004l\r\u001b[?2004h>       </nav>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </header>\r\n\u001b[?2004l\r\u001b[?2004h>   <main>"]
[190.312445, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     <section class=\"hero\">\r\n\u001b[?2004l\r\u001b[?2004h>       <p class=\"eyebrow\">Research Profile</p>\r\n\u001b[?2004l\r\u001b[?2004h>       <h1>Dr. Lydia Moreno</h1>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.312692, "o", "      <p class=\"lead\">Associate Professor of Computational Neuroscience, Riverbend University</p>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.31516, "o", "      <p>My research sits at the intersection of machine learning, systems neuroscience, and bioinformatics — building interpretable models to understand how neural circuits encode and process complex sensory information.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     </section>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Research Interests</h2>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.32005, "o", "    <ul class=\"cards\">\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>Neural Encoding &amp; Decoding</strong> — interpretable models translating spike-train data into behavioral predictions.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>Machine Learning for Biomedical Imaging</strong> — CNNs and GNNs for MRI and two-photon microscopy.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>Single-Cell Omics</strong> — scalable pipelines for multi-modal single-cell genomics.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>Explainable AI in Neuroscience</strong> — probing decision boundaries of black-box models.</li>\r\n\u001b[?2004l\r\u001b[?2004h>     </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Explore</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"links\">\r\n\u001b[?2004l\r\u001b[?2004h>       <a class=\"card-link\" href=\"about.html\"><span>About Me</span><small>Bio, education &amp; contact</small></a>\r\n\u001b[?2004l\r\u001b[?2004h>       <a class=\"card-link\" href=\"publications.html\"><span>Publications</span><small>Peer-reviewed articles</small></a>\r\n\u001b[?2004l\r\u001b[?2004h>       <a class=\"card-link\" href=\"blog.html\"><span>Blog</span><small>Notes &amp; insights</small></a>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </main>\r\n\u001b[?2004l\r\u001b[?2004h>   <footer class=\"site-footer\">\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"inner\">\r\n\u001b[?2004l\r\u001b[?2004h>       <p>© 2025 Dr. Lydia Moreno · Riverbend University</p>\r\n\u001b[?2004l\r\u001b[?2004h>       <p class=\"muted\">Built as a static research profile site.</p>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.322472, "o", "    </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </footer>\r\n\u001b[?2004l\r\u001b[?2004h> </body>\r\n\u001b[?2004l\r\u001b[?2004h> </html>\r\n\u001b[?2004l\r\u001b[?2004h> HTMLEOF\r\n\u001b[?2004l\r"]
[190.325473, "o", "\u001b[?2004hroot@4ec515b5ff20:/app/my_website# "]
[190.521355, "i", "cat > about.html <<'HTMLEOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>About Me — Dr. Lydia Moreno</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"inner\">\n      <a class=\"brand\" href=\"index.html\">Lydia Moreno, Ph.D.</a>\n      <nav class=\"main\">\n        <a href=\"index.html\">Home</a>\n        <a href=\"about.html\" class=\"active\">About Me</a>\n        <a href=\"publications.html\">Publications</a>\n        <a href=\"blog.html\">Blog</a>\n      </nav>\n    </div>\n  </header>\n  <main>\n    <h1>About Me</h1>\n    <p class=\"lead\">Associate Professor, Computational Neuroscience — Riverbend University, School of Biological Sciences.</p>\n    <p>I received my Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center. My work bridges machine learning, systems neuroscience, and bioinformatics to unravel how neural circuits encode and process complex sensory information.</p>\n    <h2>Education</h2>\n    <ul>\n      <li><strong>Ph.D., Computational Biology</strong> — Baywood Institute of Technology, 2014–2019. Dissertation: “Deep Learning Models for Decoding Neural Population Activity”.</li>\n      <li><strong>M.Sc., Bioinformatics</strong> — Riverbend University, 2012–2014. Thesis: “Statistical Methods for Single-Cell RNA-Seq Analysis”.</li>\n      <li><strong>B.Sc., Computer Science</strong> — Crestfield College of Engineering, 2008–2012. Magna cum laude; President, Data Science Club.</li>\n    </ul>\n    <h2>Selected Projects</h2>\n    <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\n    <p><em>Role: Lead Developer &amp; Project Coordinator</em></p>\n    <ul>\n      <li>Designed a PyTorch-based pipeline to segment two-photon images of mouse visual cortex.</li>\n      <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium-imaging traces.</li>\n      <li>Deployed a Dockerized microservice with Cascade Imaging Lab.</li>\n    </ul>\n    <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\n    <p><em>Role: Principal Investigator</em></p>\n    <ul>\n      <li>Constructed graph representations of reconstructed neuron meshes from electron-microscopy.</li>\n      <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\n      <li>Published an open-source toolkit in the NeuroTools suite, adopted by 12 labs.</li>\n    </ul>\n    <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\n    <p><em>Role: Co-Principal Investigator</em></p>\n    <ul>\n      <li>Developed a Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH.</li>\n      <li>Implemented Bayesian clustering for cell-type hierarchies in human cortical organoids.</li>\n      <li>Presented at ICSCG 2023.</li>\n    </ul>\n    <h2>Teaching &amp; Mentorship</h2>\n    <ul>\n      <li>Undergraduate Course: “Introduction to Computational Neuroscience” (Spring 2025).</li>\n      <li>Graduate Seminar: “Advanced Machine Learning Methods in Biology” (Fall 2024).</li>\n      <li>Mentorship: supervised 8 Ph.D. students and 12 Master's theses.</li>\n    </ul>\n    <h2>Skills &amp; Tools</h2>\n    <p><strong>Languages:</strong> Python, R, C++ · <strong>Frameworks:</strong> PyTorch, TensorFlow, scikit-learn, NetworkX · <strong>Data tools:</strong> Nextflow, Snakemake, Docker, Kubernetes · <strong>Analysis:</strong> MATLAB, Jupyter, Seurat, Scanpy · <strong>Visualization:</strong> D3.js, Plotly, Matplotlib</p>\n    <h2>Contact</h2>\n    <ul>\n      <li>Email: <a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></li>\n      <li>Office: Blakely Hall, Room 312, Riverbend University</li>\n      <li>Twitter: <a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></li>\n      <li>GitHub: <a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></li>\n    </ul>\n  </main>\n  <footer class=\"site-footer\">\n    <div class=\"inner\">\n"]
[190.521412, "i", "      <p>© 2025 Dr. Lydia Moreno · Riverbend University</p>\n    </div>\n  </footer>\n</body>\n</html>\nHTMLEOF\n"]
[190.528596, "o", "cat > about.html <<'HTMLEOF'\r\n\u001b[?2004l\r\u001b[?2004h> <!DOCTYPE html>\r\n\u001b[?2004l\r\u001b[?2004h> <html lang=\"en\">\r\n\u001b[?2004l\r\u001b[?2004h> <head>\r\n\u001b[?2004l\r\u001b[?2004h>   <meta charset=\"UTF-8\">\r\n\u001b[?2004l\r\u001b[?2004h>   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\u001b[?2004l\r\u001b[?2004h>   <title>About Me — Dr. Lydia Moreno</title>\r\n\u001b[?2004l\r\u001b[?2004h>   <link rel=\"stylesheet\" href=\"styles.css\">\r\n\u001b[?2004l\r\u001b[?2004h> </head>\r\n\u001b[?2004l\r\u001b[?2004h> <body>\r\n\u001b[?2004l\r\u001b[?2004h>   <header class=\"site\">\r\n\u001b[?2004l\r\u001b[?2004h>     <div class=\"inner\">\r\n\u001b[?2004l\r\u001b[?2004h>       <a class=\"brand\" href=\"index.html\">Lydia Moreno, Ph.D.</a>\r\n\u001b[?2004l\r\u001b[?2004h>       <nav class=\"main\">\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"index.html\">Home</a>\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"about.html\" class=\"active\">About Me</a>\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"publications.html\">Publications</a>\r\n\u001b[?2004l\r\u001b[?2004h>         <a href=\"blog.html\">Blog</a>\r\n\u001b[?2004l\r\u001b[?2004h>       </nav>\r\n\u001b[?2004l\r\u001b[?2004h>     </div>\r\n\u001b[?2004l\r\u001b[?2004h>   </header>\r\n\u001b[?2004l\r\u001b[?2004h>   <main>\r\n\u001b[?2004l\r\u001b[?2004h>     <h1>About Me</h1>\r\n\u001b[?2004l\r\u001b[?2004h>     <p class=\"lead\">Associate Professor, Computational Neuroscience — Riverbend University, School of Biological Sciences.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     <p>I received my Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center. My work bridges machine learning, systems neuroscience, and bioinformatics to unravel how neural circuits encode and process complex sensory information.</p>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Education</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <ul>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>Ph.D., Computational Biology</strong> — Baywood Institute of Technology, 2014–2019. Dissertation: “Deep Learning Models for Decoding Neural Population Activity”.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>M.Sc., Bioinformatics</strong> — Riverbend University, 2012–2014. Thesis: “Statistical Methods for Single-Cell RNA-Seq Analysis”.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>B.Sc., Computer Science</strong> — Crestfield College of Engineering, 2008–2012. Magna cum laude; President, Data Science Club.</li>\r\n\u001b[?2004l\r\u001b[?2004h>     </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Selected Projects</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\r\n\u001b[?2004l\r\u001b[?2004h>     <p><em>Role: Lead Developer &amp; Project Coordinator</em></p>\r\n\u001b[?2004l\r\u001b[?2004h>     <ul>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Designed a PyTorch-based pipeline to segment two-photon images of mouse visual cortex.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Integrated temporal convolutional networks to predict stimulus orient"]
[190.530622, "o", "ation from calcium-imaging traces.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Deployed a Dockerized microservice with Cascade Imaging Lab.</li>\r\n\u001b[?2004l\r\u001b[?2004h>     </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\r\n\u001b[?2004l\r\u001b[?2004h>     <p><em>Role: Principal Investigator</em></p>\r\n\u001b[?2004l\r\u001b[?2004h>     <ul>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Constructed graph representations of reconstructed neuron meshes from electron-microscopy.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Published an open-source toolkit in the NeuroTools suite, adopted by 12 labs.</li>\r\n\u001b[?2004l\r\u001b[?2004h>     </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>"]
[190.531715, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     <p><em>Role: Co-Principal Investigator</em></p>\r\n\u001b[?2004l\r\u001b[?2004h>     <ul>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Developed a Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Implemented Bayesian clustering for cell-type hierarchies in human cortical organoids.</li>"]
[190.531936, "o", "\r\n"]
[190.532492, "o", "\u001b[?2004l\r"]
[190.532626, "o", "\u001b[?2004h"]
[190.532726, "o", "> "]
[190.532909, "o", "      <li>Presented at ICSCG 2023.</li>"]
[190.533127, "o", "\r\n"]
[190.5333, "o", "\u001b[?2004l\r"]
[190.535673, "o", "\u001b[?2004h>     </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Teaching &amp; Mentorship</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <ul>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Undergraduate Course: “Introduction to Computational Neuroscience” (Spring 2025).</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Graduate Seminar: “Advanced Machine Learning Methods in Biology” (Fall 2024).</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Mentorship: supervised 8 Ph.D. students and 12 Master's theses.</li>\r\n\u001b[?2004l\r\u001b[?2004h>     </ul>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Skills &amp; Tools</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <p><strong>Languages:</strong> Python, R, C++ · <strong>Frameworks:</strong> PyTorch, TensorFlow, scikit-learn, NetworkX · <strong>Data tools:</strong> Nextflow, Snakemake, Docker, Kubernetes · <strong>Analysis:</strong> MATLAB, Jupyter, Seurat, Scanpy · <strong>Visualization:</strong> D3.js, Plotly, Matplotlib</p>"]
[190.535843, "o", "\r\n"]
[190.535998, "o", "\u001b[?2004l\r"]
