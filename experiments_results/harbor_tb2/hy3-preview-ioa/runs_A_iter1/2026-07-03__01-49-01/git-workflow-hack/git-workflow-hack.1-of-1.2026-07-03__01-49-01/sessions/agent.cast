[190.536366, "o", "> "]
[190.537123, "o", "    <h2>Contact</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <ul>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Email: <a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li>Office: Blakely Hall, Room 312, Riverbend University</li>"]
