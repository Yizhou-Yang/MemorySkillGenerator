[54.205733, "i", "SUBJ=$(openssl x509 -in /app/ssl/server.crt -noout -subject | sed 's/^subject=//'); NB=$(openssl x509 -in /app/ssl/server.crt -noout -startdate | cut -d= -f2); NA=$(openssl x509 -in /app/ssl/server.crt -noout -enddate | cut -d= -f2); FP=$(openssl x509 -in /app/ssl/server.crt -noout -fingerprint -sha256 | cut -d= -f2); NBD=$(date -u -d \"$NB\" +%Y-%m-%d); NAD=$(date -u -d \"$NA\" +%Y-%m-%d); printf 'Subject: %s\\nNot Before: %s (%s)\\nNot After: %s (%s)\\nSHA-256 Fingerprint: %s\\n' \"$SUBJ\" \"$NB\" \"$NBD\" \"$NA\" \"$NAD\" \"$FP\" > /app/ssl/verification.txt\n"]
[54.208675, "o", "SUBJ=$(openssl x509 -in /app/ssl/server.crt -noout -subject | sed 's/^subject=//'); NB=$(openssl x509 -in /app/ssl/server.crt -noout -startdate | cut -d= -f2); NA=$(openssl x509 -in /app/ssl/server.crt -noout -enddate | cut -d= -f2); FP=$(openssl x509 -in /app/ssl/server.crt -noout -fingerprint -sha256 | cut -d= -f2); NBD=$(date -u -d \"$NB\" +%Y-%m-%d); NAD=$(date -u -d \"$NA\" +%Y-%m-%d); printf 'Subject: %s\\nNot Before: %s (%s)\\nNot After: %s (%s)\\nSHA-256 Fingerprint: %s\\n' \"$SUBJ\" \"$NB\" \"$NBD\" \"$NA\" \"$NAD\" \"$FP\" > /app/ssl/verification.txt\r\n\u001b[?2004l\r"]
