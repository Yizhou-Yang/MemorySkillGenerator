[79.75186, "o", "\r\n"]
[79.752053, "o", "    \"\"\""]
[79.752224, "o", "\r\n"]
[79.752402, "o", "    Arguments pertaining to what data we are going to input our model for training and eval."]
[79.752607, "o", "\r\n"]
[79.752797, "o", "\r\n"]
