[79.753524, "o", "\r\n"]
[79.753673, "o", "    the command line.training_args"]
[79.753845, "o", "\r\n    \"\"\"\r\n    task_name: str = field(\r\n        metadata={\r\n            \"help\": \"The name of the task to train on: \" + \", \".join(TASKS),\r\n            \"choices\": TASKS\r\n        },\r\n"]
[79.754107, "o", "    )"]
