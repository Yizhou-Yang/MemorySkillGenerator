[381.257626, "o", "# add by wjn\r\ndef random_sampling(raw_datasets: load_dataset, data_type: str=\"train\", num_examples_per_label: Optional[int]=16):\r\n    assert data_type in [\"train\", \"validation\", \"test\"]\r\n    label_list = raw_datasets[data_type][\"label\"] # [0, 1, 0, 0, ...]"]
[381.257872, "o", "\r\n    label_dict = dict()\r\n    # 记录每个label对应的样本索引\r\n    for ei, label in enumerate(label_list):"]
[381.258097, "o", "\r\n"]
[381.258273, "o", "        if label not in label_dict.keys():"]
[381.258444, "o", "\r\n"]
[381.258615, "o", "            label_dict[label] = list()"]
[381.258822, "o", "\r\n"]
[381.259033, "o", "        label_dict[label].append(ei)"]
[381.259198, "o", "\r\n"]
[381.25937, "o", "    # 对于每个类别，随机采样k个样本"]
[381.25956, "o", "\r\n"]
[381.259752, "o", "    few_example_ids = list()"]
[381.259928, "o", "\r\n"]
[381.260571, "o", "    for label, eid_list in label_dict.items():"]
[381.260789, "o", "\r\n"]
[381.265612, "o", "        # examples = deepcopy(eid_list)"]
[381.26584, "o", "\r\n"]
[381.265997, "o", "        # shuffle(examples)"]
[381.266166, "o", "\r\n"]
[381.266313, "o", "        idxs = np.random.choice(len(eid_list), size=num_examples_per_label, replace=False)"]
[381.266443, "o", "\r\n"]
[381.266574, "o", "        selected_eids = [eid_list[i] for i in idxs]"]
[381.266724, "o", "\r\n        few_example_ids.extend(selected_eids)\r\n    # 保存没有被选中的example id\r\n    num_examples = len(label_list)"]
[381.266891, "o", "\r\n    un_selected_examples_ids = [idx for idx in range(num_examples) if idx not in few_example_ids]\r\n    return few_example_ids, un_selected_examples_ids\r\n\r\ntask_to_test_key = {\r\n    \"boolq\": \"accuracy\",\r\n"]
[381.267099, "o", "    \"cb\": \"accuracy\",\r\n    \"rte\": \"accuracy\",\r\n    \"wic\": \"accuracy\",\r\n    \"wsc\": \"accuracy\","]
[381.26724, "o", "\r\n"]
[381.267371, "o", "    \"copa\": \"accuracy\","]
[381.267673, "o", "\r\n"]
[381.26782, "o", "    \"record\": \"f1\","]
[381.267943, "o", "\r\n"]
[381.268081, "o", "    \"multirc\": \"f1\""]
[381.268205, "o", "\r\n"]
[381.26833, "o", "}"]
