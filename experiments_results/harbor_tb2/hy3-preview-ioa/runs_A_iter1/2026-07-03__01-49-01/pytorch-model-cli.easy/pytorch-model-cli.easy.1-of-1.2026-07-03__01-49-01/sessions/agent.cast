[11.188499, "o", "import torch\r"]
[11.188981, "o", "\r\n"]
[11.189157, "o", "import torch.nn as nn\r"]
[11.189336, "o", "\r\n"]
[11.18953, "o", "\r"]
[11.189721, "o", "\r\n"]
[11.189898, "o", "\r"]
[11.190071, "o", "\r\n"]
[11.190244, "o", "class MnistModel(nn.Module):\r"]
[11.190459, "o", "\r\n"]
[11.190632, "o", "    def __init__(\r"]
[11.190828, "o", "\r\n"]
[11.191008, "o", "        self,\r"]
[11.191185, "o", "\r\n"]
[11.191366, "o", "        input_dim: int,\r"]
[11.191575, "o", "\r\n"]
[11.191769, "o", "        hidden_dim: int,\r"]
[11.191954, "o", "\r\n"]
[11.192137, "o", "        num_classes: int,\r"]
[11.192313, "o", "\r\n"]
[11.192512, "o", "    ) -> torch.nn.Module:\r"]
[11.192676, "o", "\r\n"]
[11.193154, "o", "        super().__init__()\r"]
[11.193316, "o", "\r\n"]
[11.193503, "o", "\r"]
[11.19366, "o", "\r\n"]
[11.193857, "o", "        self.input_layer = nn.Linear(input_dim, hidden_dim)\r"]
[11.194044, "o", "\r\n"]
[11.194216, "o", "        self.hidden_layer = nn.Linear(hidden_dim, hidden_dim)\r"]
[11.194415, "o", "\r\n"]
[11.194588, "o", "        self.output_layer = nn.Linear(hidden_dim, num_classes)\r"]
[11.194786, "o", "\r\n"]
[11.194965, "o", "        self.activation = nn.ReLU()\r"]
[11.195143, "o", "\r\n"]
[11.195331, "o", "\r"]
[11.195525, "o", "\r\n"]
[11.195714, "o", "    def forward(self, x):\r"]
[11.195894, "o", "\r\n"]
[11.196066, "o", "        x = self.input_layer(x)\r"]
[11.196245, "o", "\r\n"]
[11.196444, "o", "        x = self.activation(x)\r"]
[11.196619, "o", "\r\n"]
[11.196812, "o", "\r"]
[11.196991, "o", "\r\n"]
[11.197243, "o", "        x = self.hidden_layer(x)\r"]
[11.197443, "o", "\r\n"]
[11.197615, "o", "        x = self.activation(x)\r"]
[11.197807, "o", "\r\n"]
[11.197981, "o", "\r"]
[11.198151, "o", "\r\n"]
[11.198628, "o", "        x = self.output_layer(x)\r"]
[11.200066, "o", "\r\n"]
[11.204451, "o", "        return x\r"]
[11.204652, "o", "\r\n"]
