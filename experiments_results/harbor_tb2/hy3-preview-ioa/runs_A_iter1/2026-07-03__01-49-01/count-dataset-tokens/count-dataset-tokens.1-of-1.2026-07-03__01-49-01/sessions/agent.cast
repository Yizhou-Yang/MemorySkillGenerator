[647.059466, "o", "</a>"]
[647.059604, "o", "\r\n"]
[647.059761, "o", "\r\n"]
[647.059894, "o", "# Open-Thoughts-114k"]
[647.060034, "o", "\r\n"]
[647.06017, "o", "\r\n"]
[647.060325, "o", "## Dataset Description"]
[647.060457, "o", "\r\n"]
[647.060583, "o", "\r\n"]
[647.060746, "o", "- **Homepage:** https://www.open-thoughts.ai/"]
[647.060871, "o", "\r\n"]
[647.061001, "o", "- **Repository:** https://github.com/open-thoughts/open-thoughts"]
[647.061131, "o", "\r\n"]
[647.061337, "o", "- **Point of Contact:** [Open Thoughts Team](contact@open-thoughts.ai)"]
[647.061462, "o", "\r\n"]
[647.061588, "o", "\r\n"]
[647.061785, "o", "Open synthetic reasoning dataset with 114k high-quality examples covering math, science, code, and puzzles!"]
[647.061915, "o", "\r\n"]
[647.062041, "o", "\r\n"]
[647.062173, "o", "Inspect the content with rich formatting with [Curator Viewer](https://curator.bespokelabs.ai/datasets/1389c194254c4ead96daaf145505c3d1)."]
[647.06232, "o", "\r\n"]
[647.062449, "o", "\r\n"]
[647.062582, "o", "### Available Subsets"]
[647.062734, "o", "\r\n"]
[647.062874, "o", "\r\n"]
[647.063006, "o", "**default** subset containing ready-to-train data used to finetune the [OpenThinker-7B](https://h"]
[647.063156, "o", "uggingface.co/open-thoughts/OpenThinker-7B) and [OpenThinker-32B](https://huggingface.co/open-thoughts/OpenThinker-32B) models:"]
[647.063279, "o", "\r\n"]
[647.063426, "o", "```"]
[647.063549, "o", "\r\n"]
[647.063701, "o", "ds = load_dataset(\"open-thoughts/OpenThoughts-114k\", split=\"train\")"]
[647.063854, "o", "\r\n"]
[647.063985, "o", "```"]
[647.064119, "o", "\r\n"]
[647.064251, "o", "**metadata** subset containing extra columns used in dataset construction:"]
[647.064389, "o", "\r\n"]
[647.064513, "o", "- `problem`"]
[647.064657, "o", "\r\n"]
[647.064784, "o", "- `ground_truth_solution`"]
[647.064909, "o", "\r\n"]
[647.065039, "o", "- `deepseek_reasoning`"]
[647.065168, "o", "\r\n"]
[647.065312, "o", "- `deepseek_solution`"]
[647.065448, "o", "\r\n"]
[647.065575, "o", "- `domain`"]
[647.065724, "o", "\r\n"]
[647.065844, "o", "- `source`"]
[647.06597, "o", "\r\n"]
[647.0661, "o", "- `test_cases` (code only)"]
[647.066223, "o", "\r\n"]
[647.066369, "o", "- `starter_code`(code only)"]
[647.066497, "o", "\r\n"]
[647.066653, "o", "\r\n"]
[647.066772, "o", "```"]
[647.066939, "o", "\r\n"]
[647.067068, "o", "ds = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\")"]
[647.067197, "o", "\r\n"]
[647.067335, "o", "```"]
[647.067461, "o", "\r\n"]
[647.067589, "o", "\r\n"]
[647.067739, "o", "# OpenThinker Models"]
[647.06786, "o", "\r\n"]
[647.067986, "o", "\r\n"]
[647.068161, "o", "The numbers reported in the tables below are evaluated with our open-source tool [Evalchemy](https://github.com/mlfoundations/Evalchemy)."]
[647.06829, "o", "\r\n"]
[647.068426, "o", "\r\n"]
[647.068555, "o", "|                             | AIME24   | MATH500 | GPQA-Diamond | LCBv2 Easy  | LCBv2 Medium  | LCBv2 Hard  | LCBv2 All  |"]
[647.068732, "o", "\r\n"]
[647.06887, "o", "| --------------------------- | -------- | ------- | ------------ | ----------- | ------------- | ----------- | ---------- |"]
[647.069005, "o", "\r\n"]
[647.069142, "o", "| [OpenThinker-32B](https://huggingface.co/open-thoughts/OpenThinker-32B)             | 66       | 90.6    | 61.6         | 95.1        | 70.9          | 26.8        | 68.9       |"]
[647.069276, "o", "\r\n"]
[647.069436, "o", "| [OpenThinker-7B](https://huggingface.co/open-thoughts/OpenThinker-7B)              | 31.3     | 83.0    | 42.4         | 75.3        | 28.6          | 6.5         | 39.9       |"]
[647.069572, "o", "\r\n"]
[647.069817, "o", "| Bespoke-Stratos-7B          | 22.7     | 79.6    | 38.9         | 71.4        | 25.2          | 0.8         | 35.8       |"]
[647.069952, "o", "\r\n"]
[647.070091, "o", "| DeepSeek-R1-Distill-Qwen-7B | 60       | 88.2    | 46.9         | 79.7        | 45.1          | 14.6        | 50.1       |"]
[647.070226, "o", "\r\n"]
