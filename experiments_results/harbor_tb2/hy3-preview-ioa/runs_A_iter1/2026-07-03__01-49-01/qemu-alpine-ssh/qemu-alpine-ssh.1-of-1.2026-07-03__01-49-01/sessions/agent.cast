[540.407073, "o", "        if nm in ('.','..'): continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.407197, "o", "        out.append((nm.rstrip('.').split(';')[0], r))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.407219, "o", "    return out\r\n\u001b[?2004l\r"]
[540.4073, "o", "\u001b[?2004h> pvd=read(16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.407394, "o", "root=pvd[156:156+34]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.40757, "o", "rootdir=walk(rec_lba(root),rec_len(root))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.407595, "o", "boot=None\r\n\u001b[?2004l\r"]
[540.407608, "o", "\u001b[?2004h> "]
[540.407691, "o", "for nm,r in rootdir:\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.407715, "o", "> "]
[540.407963, "o", "    if rec_isdir(r) and nm.upper()=='BOOT':\r\n\u001b[?2004l\r\u001b[?2004h>         boot=r; break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.408807, "o", "bootfiles=walk(rec_lba(boot),rec_len(boot))\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('/app/boot',exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> for nm,r in bootfiles:\r\n\u001b[?2004l\r\u001b[?2004h>     u=nm.upper()\r\n"]
[540.408848, "o", "\u001b[?2004l\r"]
[540.409808, "o", "\u001b[?2004h>     if u.startswith('VMLINUZ_LTS'): dst='/app/boot/vmlinuz'\r\n\u001b[?2004l\r\u001b[?2004h>     elif u.startswith('INITRAMFS_LTS'): dst='/app/boot/initramfs'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.41077, "o", "    else: continue\r\n\u001b[?2004l\r\u001b[?2004h>     print('extract', nm, dst, rec_len(r))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.412713, "o", "    data=read(rec_lba(r), (rec_len(r)+2047)//2048)\r\n\u001b[?2004l\r\u001b[?2004h>     open(dst,'wb').write(data[:rec_len(r)])\r\n\u001b[?2004l\r\u001b[?2004h> print('done')\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
