[143.581463, "i", "cat > /app/iso_read.py << 'EOF'\nimport struct, os\n\nISO = '/app/alpine.iso'\n\ndef read_sector(lba, count=1):\n    with open(ISO, 'rb') as f:\n        f.seek(lba*2048)\n        return f.read(count*2048)\n\ndef rec_lba(rec):\n    return struct.unpack('<I', rec[2:6])[0]\ndef rec_len(rec):\n    return struct.unpack('<I', rec[10:14])[0]\ndef rec_isdir(rec):\n    return rec[25] & 2\n\ndef read_dir(lba, length):\n    size = (length + 2047)//2048 * 2048\n    data = read_sector(lba, size//2048)\n    entries = []\n    off = 0\n    while off < length:\n        reclen = data[off]\n        if reclen == 0:\n            off = (off + 2047)//2048 * 2048\n            continue\n        rec = data[off:off+reclen]\n        name_len = rec[32]\n        name = rec[33:33+name_len].decode('latin-1')\n        entries.append((name, rec))\n        off += reclen\n    return entries\n\npvd = read_sector(16)\nassert pvd[1:6] == b'CD001' and pvd[0] == 1, 'no PVD'\nroot = pvd[156:156+34]\nprint('ROOT dir LBA', rec_lba(root), 'le"]
[143.582059, "i", "n', rec_len(root))\n\ndef walk(lba, length, indent=0):\n    for name, rec in read_dir(lba, length):\n        if name in ('.', '..'):\n            continue\n        nm = name.split(';')[0]\n        print('  '*indent + nm + ('/ ' if rec_isdir(rec) else '  ') + ('dir' if rec_isdir(rec) else str(rec_len(rec))))\n        if rec_isdir(rec) and indent < 3:\n            walk(rec_lba(rec), rec_len(rec), indent+1)\n\nwalk(rec_lba(root), rec_len(root))\nEOF\npython3 /app/iso_read.py\n"]
[143.582364, "o", "cat > /app/iso_read.py << 'EOF'"]
