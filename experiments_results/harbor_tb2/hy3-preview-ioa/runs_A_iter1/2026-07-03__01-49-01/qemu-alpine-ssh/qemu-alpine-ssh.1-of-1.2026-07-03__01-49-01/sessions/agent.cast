[144.207198, "o", "\u001b[?2004hroot@88975f2109d1:/app# "]
[540.398481, "i", "cat > /app/extract.py << 'PYEOF'\nimport struct, os\nISO='/app/alpine.iso'\ndef read(lba,count=1):\n    with open(ISO,'rb') as f:\n        f.seek(lba*2048)\n        return f.read(count*2048)\ndef rec_lba(r): return struct.unpack('<I',r[2:6])[0]\ndef rec_len(r): return struct.unpack('<I',r[10:14])[0]\ndef rec_isdir(r): return r[25]&2\ndef read_dir(lba,length):\n    size=(length+2047)//2048*2048\n    data=read(lba,size//2048)\n    entries=[]; off=0\n    while off<length:\n        rl=data[off]\n        if rl==0:\n            off=(off+2047)//2048*2048\n            continue\n        rec=data[off:off+rl]\n        nm=rec[33:33+rec[32]].decode('latin-1')\n        entries.append((nm,rec)); off+=rl\n    return entries\ndef walk(lba,length):\n    out=[]\n    for nm,r in read_dir(lba,length):\n        if nm in ('.','..'): continue\n        out.append((nm.rstrip('.').split(';')[0], r))\n    return out\npvd=read(16)\nroot=pvd[156:156+34]\nrootdir=walk(rec_lba(root),rec_len(root))\nboot=None\nfor nm,r in rootdir:\n    if rec_isdir(r) and nm.upper()=='BOOT':"]
[540.398669, "i", "\n        boot=r; break\nbootfiles=walk(rec_lba(boot),rec_len(boot))\nos.makedirs('/app/boot',exist_ok=True)\nfor nm,r in bootfiles:\n    u=nm.upper()\n    if u.startswith('VMLINUZ_LTS'): dst='/app/boot/vmlinuz'\n    elif u.startswith('INITRAMFS_LTS'): dst='/app/boot/initramfs'\n    else: continue\n    print('extract', nm, dst, rec_len(r))\n    data=read(rec_lba(r), (rec_len(r)+2047)//2048)\n    open(dst,'wb').write(data[:rec_len(r)])\nprint('done')\nPYEOF\npython3 /app/extract.py\n"]
[540.398719, "o", "cat > /app/extract.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
