[584.769855, "o", "kill 501 2>/dev/null; sleep 0.5; sed -i 's/6665/6666/' /app/run-qemu.sh; grep serial /app/run-qemu.sh"]
[584.772362, "o", "\r\n"]
[584.77274, "o", "\u001b[?2004l\r"]
[585.345607, "o", "  -serial telnet:127.0.0.1:6666,server,nowait \\\r\n"]
[585.346548, "o", "\u001b[?2004hroot@e7b935aa5229:/app# "]
[585.682453, "i", "cat > /app/serial-proxy.py << 'PYEOF'\nimport socket, select, threading\n\nQEMU_HOST, QEMU_PORT = \"127.0.0.1\", 6666\nLISTEN_PORT = 6665\n\ndef bridge(client):\n    try:\n        up = socket.create_connection((QEMU_HOST, QEMU_PORT), timeout=5)\n    except Exception:\n        try: client.close()\n        except Exception: pass\n        return\n    try:\n        up.sendall(b\"\\r\\n\")\n    except Exception:\n        pass\n    client.setblocking(False)\n    up.setblocking(False)\n    polled = [client, up]\n    while True:\n        try:\n            r, _, _ = select.select(polled, [], [], 0.5)\n        except Exception:\n            break\n        if not r:\n            continue\n        for src, dst in ((client, up), (up, client)):\n            if src not in r:\n                continue\n            try:\n                data = src.recv(4096)\n            except (BlockingIOError, OSError):\n                continue\n            if not data:\n                try: client.close()\n                except Exception: pass\n                try: up.close()\n   "]
[585.683325, "o", "cat > /app/serial-proxy.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import socket, select, threading\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> QEMU_HOST, QEMU_PORT = \"127.0.0.1\", 6666\r\n\u001b[?2004l\r\u001b[?2004h> LISTEN_PORT = 6665\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def bridge(client):"]
[585.68356, "i", "             except Exception: pass\n                return\n            try:\n                dst.sendall(data)\n            except OSError:\n                try: client.close()\n                except Exception: pass\n                try: up.close()\n                except Exception: pass\n                return\n\ndef main():\n    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n    srv.bind((\"127.0.0.1\", LISTEN_PORT))\n    srv.listen(1)\n    while True:\n        try:\n            client, _ = srv.accept()\n        except Exception:\n            continue\n        t = threading.Thread(target=bridge, args=(client,), daemon=True)\n        t.start()\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
