[292.513413, "o", "  -initrd /app/extracted/INTEL_UCODE.IMG,/app/extracted/AMD_UCODE.IMG,/app/extracted/INITRAMFS_LTS \\\r\n\u001b[?2004l\r"]
[292.513909, "o", "\u001b[?2004h>   -append \"modules=loop,squashfs,sd-mod,usb-storage console=ttyS0 quiet\" \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
