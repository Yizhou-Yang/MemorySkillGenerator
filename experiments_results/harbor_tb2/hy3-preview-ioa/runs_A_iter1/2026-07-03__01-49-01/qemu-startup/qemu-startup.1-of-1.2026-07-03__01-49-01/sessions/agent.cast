[187.432459, "o", "\u001b[?2004l\r\u001b[?2004h>         found=None\r\n\u001b[?2004l\r\u001b[?2004h>         for e in listdir(cur[0],cur[1]):\r\n\u001b[?2004l\r\u001b[?2004h>             if e[3].lower()==p.lower():\r\n\u001b[?2004l\r\u001b[?2004h>                 found=e; break\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.432494, "o", "> "]
[187.432647, "o", "        if not found: raise SystemExit(\"not found: \"+p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.432718, "o", "        cur=found\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.433192, "o", "    return cur\r\n\u001b[?2004l\r\u001b[?2004h> def extract(ent):\r\n\u001b[?2004l\r\u001b[?2004h>     data=read(ent[0]*2048,ent[1])\r\n\u001b[?2004l\r\u001b[?2004h>     dest=os.path.join(OUT,ent[3])\r\n\u001b[?2004l\r\u001b[?2004h>     open(dest,\"wb\").write(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.433452, "o", "    print(\"extracted\",ent[3],len(data))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.433518, "o", "sd=walk(\"/BOOT/SYSLINUX\")\r\n\u001b[?2004l\r"]
[187.433535, "o", "\u001b[?2004h"]
[187.433578, "o", "> "]
[187.433732, "o", "for e in listdir(sd[0],sd[1]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.433914, "o", "    print(\"  \",repr(e[3]),\"dir\" if e[2] else \"file\")\r\n\u001b[?2004l\r"]
[187.433995, "o", "\u001b[?2004h> "]
[187.434133, "o", "    if e[3].lower().endswith(\".cfg\"):\r\n\u001b[?2004l\r"]
[187.435623, "o", "\u001b[?2004h>         print(\"---- cfg:\",e[3],\"----\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(read(e[0]*2048,e[1]).decode(\"latin-1\",\"replace\"))\r\n\u001b[?2004l\r\u001b[?2004h> for nm in [\"VMLINUZ_LTS\",\"INITRAMFS_LTS\",\"MODLOOP_LTS\",\"CONFIG_LTS\",\"AMD_UCODE.IMG\",\"INTEL_UCODE.IMG\"]:\r\n\u001b[?2004l\r\u001b[?2004h>     for e in listdir(*walk(\"/BOOT\")[:2]):\r\n\u001b[?2004l\r\u001b[?2004h>         if e[3]==nm:\r\n\u001b[?2004l\r\u001b[?2004h>             extract(e); break\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"MISSING\",nm)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[187.438494, "o", "\u001b[?2004hroot@e7b935aa5229:/app# "]
