[162.058502, "i", "cat > /app/extract.py << 'PYEOF'\nimport struct, os\nISO=\"/app/alpine.iso\"\nOUT=\"/app/extracted\"\nos.makedirs(OUT, exist_ok=True)\nf=open(ISO,\"rb\")\ndef read(off,n):\n    f.seek(off); return f.read(n)\npvd=None\nfor s in range(16,100):\n    d=read(s*2048,2048)\n    if d and d[0]==1:\n        pvd=d; break\ndef rec_info(r):\n    loc=struct.unpack(\"<I\",r[2:6])[0]\n    dl=struct.unpack(\"<I\",r[10:14])[0]\n    isdir=(r[25]&2)!=0\n    nl=r[32]\n    nm=r[33:33+nl].decode(\"latin-1\").rstrip(\";\").rstrip(\".\")\n    return loc,dl,isdir,nm\ndef listdir(loc,dl):\n    data=read(loc*2048, ((dl+2047)//2048)*2048)\n    out=[]; off=0\n    while off<dl:\n        L=data[off]\n        if L==0:\n            off=(off+2048)//2048*2048; continue\n        r=data[off:off+L]\n        if len(r)<33: break\n        out.append(rec_info(r)); off+=L\n    return out\ndef walk(path):\n    parts=[p for p in path.strip(\"/\").split(\"/\") if p]\n    cur=rec_info(pvd[156:156+34])\n    for p in parts:\n        found=None\n        for e in list"]
[162.059083, "o", "cat > /app/extract.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct, os\r\n\u001b[?2004l\r\u001b[?2004h> ISO=\"/app/alpine.iso\""]
[162.059191, "i", "dir(cur[0],cur[1]):\n            if e[3].lower()==p.lower():\n                found=e; break\n        if not found: raise SystemExit(\"not found: \"+p)\n        cur=found\n    return cur\ndef extract(ent):\n    data=read(ent[0]*2048,ent[1])\n    dest=os.path.join(OUT,ent[3])\n    open(dest,\"wb\").write(data)\n    print(\"extracted\",ent[3],len(data))\nprint(\"SYSLINUX DIR:\")\nsd=walk(\"/BOOT/SYSLINUX\")\nfor e in listdir(sd[0],sd[1]):\n    print(\"  \",e[3],\"dir\" if e[2] else \"file\")\n    if e[3].lower().endswith(\".cfg\"):\n        print(\"----\",e[3],\"----\")\n        print(read(e[0]*2048,e[1]).decode(\"latin-1\",\"replace\"))\nprint(\"EXTRACT KERNEL/INITRD:\")\nfor nm in [\"VMLINUZ_LTS\",\"INITRAMFS_LTS\",\"MODLOOP_LTS\",\"CONFIG_LTS\",\"AMD_UCODE.IMG\",\"INTEL_UCODE.IMG\"]:\n    for e in listdir(*walk(\"/BOOT\")[:2]):\n        if e[3]==nm:\n            extract(e); break\nPYEOF\n"]
