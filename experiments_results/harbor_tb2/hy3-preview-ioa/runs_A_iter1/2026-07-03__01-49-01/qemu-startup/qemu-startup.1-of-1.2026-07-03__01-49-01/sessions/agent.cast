[140.148448, "i", "cat > /app/extract.py << 'PYEOF'\nimport struct, os, sys\nISO=\"/app/alpine.iso\"\nOUT=\"/app/extracted\"\nos.makedirs(OUT, exist_ok=True)\nf=open(ISO,\"rb\")\ndef read(off,n):\n    f.seek(off); return f.read(n)\npvd=None\nfor s in range(16,100):\n    d=read(s*2048,2048)\n    if d and d[0]==1:\n        pvd=d; break\ndef rec_info(r):\n    loc=struct.unpack(\"<I\",r[2:6])[0]\n    dl=struct.unpack(\"<I\",r[10:14])[0]\n    isdir=(r[25]&2)!=0\n    nl=r[32]\n    nm=r[33:33+nl].decode(\"latin-1\").split(\";\")[0]\n    return loc,dl,isdir,nm\ndef listdir(loc,dl):\n    n=((dl+2047)//2048)\n    data=read(loc*2048,n*2048)\n    out=[]; off=0\n    while off<dl:\n        L=data[off]\n        if L==0:\n            off=(off+2048)//2048*2048; continue\n        r=data[off:off+L]\n        if len(r)<33: break\n        out.append(rec_info(r))\n        off+=L\n    return out\ndef walk(path):\n    parts=[p for p in path.strip(\"/\").split(\"/\") if p]\n    loc,dl,isdir,nm=rec_info(pvd[156:156+34])\n    for p in parts:\n        found=None\n"]
[140.149294, "o", "cat > /app/extract.py << 'PYEOF'"]
[140.149458, "o", "\r\n"]
[140.149539, "o", "\u001b[?2004l\r"]
[140.149696, "o", "\u001b[?2004h"]
[140.149793, "i", "        for e in listdir(loc,dl):\n            if e[3].lower()==p.lower():\n                found=e; break\n        if not found:\n            raise SystemExit(\"not found: \"+p)\n        loc,dl,isdir,nm=found\n    return loc,dl,isdir,nm\ndef extract(path):\n    loc,dl,isdir,nm=walk(path)\n    data=read(loc*2048,dl)\n    dest=os.path.join(OUT,path.strip(\"/\").replace(\"/\",\"_\"))\n    open(dest,\"wb\").write(data)\n    print(\"extracted\",path,\"->\",dest,dl)\nprint(\"ROOT:\")\nfor e in listdir(*rec_info(pvd[156:156+34])[:2]):\n    print(\"  \",e[3],\"dir\" if e[2] else \"file\")\nprint(\"BOOT:\")\nfor e in listdir(*walk(\"/boot\")[:2]):\n    print(\"  \",e[3],\"dir\" if e[2] else \"file\")\nextract(\"/boot/vmlinuz-lts\")\nextract(\"/boot/initramfs-lts\")\nfor c in [\"/isolinux/isolinux.cfg\",\"/boot/isolinux/isolinux.cfg\",\"/boot/syslinux/syslinux.cfg\",\"/syslinux/syslinux.cfg\"]:\n    try:\n        loc,dl,_,_=walk(c)\n        print(\"====\",c,\"====\")\n        print(read(loc*2048,dl).decode(\"latin-1\",\"replace\"))\n    except BaseException:\n        pass\nPYEOF\n"]
