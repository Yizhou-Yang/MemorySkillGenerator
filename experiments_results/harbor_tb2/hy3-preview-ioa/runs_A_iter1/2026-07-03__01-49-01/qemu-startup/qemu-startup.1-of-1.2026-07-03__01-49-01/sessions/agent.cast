[292.512034, "i", "cat > /app/run-qemu.sh << 'EOF'\n#!/bin/bash\nnohup qemu-system-x86_64 \\\n  -m 2048 \\\n  -kernel /app/extracted/VMLINUZ_LTS \\\n  -initrd /app/extracted/INTEL_UCODE.IMG,/app/extracted/AMD_UCODE.IMG,/app/extracted/INITRAMFS_LTS \\\n  -append \"modules=loop,squashfs,sd-mod,usb-storage console=ttyS0 quiet\" \\\n  -cdrom /app/alpine.iso \\\n  -display none \\\n  -serial telnet:127.0.0.1:6665,server,nowait \\\n  -monitor none \\\n  > /app/qemu.log 2>&1 &\necho \"qemu pid $!\"\nEOF\nchmod +x /app/run-qemu.sh\n"]
[292.512302, "o", "cat > /app/run-qemu.sh << 'EOF'"]
