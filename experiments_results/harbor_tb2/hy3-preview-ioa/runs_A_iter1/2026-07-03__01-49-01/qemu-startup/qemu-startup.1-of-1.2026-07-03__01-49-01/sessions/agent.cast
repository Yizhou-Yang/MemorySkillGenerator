[292.920815, "i", "cat > /app/wait-ready.py << 'PYEOF'\nimport socket, sys, time\nHOST, PORT = \"127.0.0.1\", 6665\ndeadline = time.time() + 30\nwhile time.time() < deadline:\n    try:\n        s = socket.create_connection((HOST, PORT), timeout=5)\n        break\n    except Exception:\n        time.sleep(1)\nelse:\n    print(\"FAILED: cannot connect to telnet port\")\n    sys.exit(1)\ns.settimeout(3)\nbuf = b\"\"\nstart = time.time()\nwhile time.time() - start < 280:\n    try:\n        d = s.recv(4096)\n    except socket.timeout:\n        continue\n    if not d:\n        time.sleep(1)\n        continue\n    buf += d\n    if b\"login\" in buf.lower():\n        sys.stdout.write(buf.decode(\"latin-1\", \"replace\")[-800:])\n        print(\"\\n\\nREADY: login prompt detected on telnet 6665\")\n        s.close()\n        sys.exit(0)\nprint(\"TIMEOUT. Last received data:\")\nprint(buf.decode(\"latin-1\", \"replace\")[-800:])\nsys.exit(2)\nPYEOF\n"]
