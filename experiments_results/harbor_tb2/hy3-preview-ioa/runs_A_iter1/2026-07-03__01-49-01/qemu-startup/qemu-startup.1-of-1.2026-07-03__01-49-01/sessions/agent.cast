[187.80765, "o", "   '\\x00' dir\r\n   '\\x01' dir\r\n   'BOOT.CAT' file\r\n   'ISOHDPFX.BIN' file\r\n   'ISOLINUX.BIN' file\r\n   'LDLINUX.C32' file\r\n   'LIBCOM32.C32' file\r\n   'LIBUTIL.C32' file\r\n   'MBOOT.C32' file\r\n   'SYSLINUX.CFG' file\r\n---- cfg: SYSLINUX.CFG ----\r\nTIMEOUT 10\r\nPROMPT 1\r\nDEFAULT lts\r\n\r\nLABEL lts\r\nMENU LABEL Linux lts\r\nKERNEL /boot/vmlinuz-lts\r\nINITRD /boot/intel-ucode.img,/boot/amd-ucode.img,/boot/initramfs-lts\r\nFDTDIR /boot/dtbs-lts\r\nAPPEND modules=loop,squashfs,sd-mod,usb-storage quiet \r\n\r\n"]
