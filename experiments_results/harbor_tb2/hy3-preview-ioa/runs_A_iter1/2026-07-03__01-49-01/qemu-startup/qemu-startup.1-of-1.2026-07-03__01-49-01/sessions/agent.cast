[611.593673, "i", "cat > /app/verify.py << 'PYEOF'\nimport socket, sys, time\nHOST, PORT = \"127.0.0.1\", 6665\ndl = time.time()+30\nwhile time.time()<dl:\n    try:\n        s=socket.create_connection((HOST,PORT),timeout=5); break\n    except Exception:\n        time.sleep(1)\nelse:\n    print('CNX FAIL'); sys.exit(1)\ns.settimeout(3); buf=b\"\"; st=time.time()\nwhile time.time()-st<240:\n    try: d=s.recv(4096)\n    except socket.timeout: continue\n    if not d: time.sleep(1); continue\n    buf+=d\n    if b'login' in buf.lower():\n        print('VERIFIED: login prompt received on 6665')\n        sys.stdout.write(buf.decode('latin-1','replace')[-400:])\n        s.close(); sys.exit(0)\nprint('NO PROMPT. tail:'); print(buf.decode('latin-1','replace')[-400:]); sys.exit(2)\nPYEOF\npython3 /app/verify.py\n"]
[611.593737, "o", "cat > /app/verify.py << 'PYEOF'"]
