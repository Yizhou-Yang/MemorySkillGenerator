[637.470247, "i", "python3 - <<'PY'\nimport json,urllib.request,os,sys,tarfile\nidx=json.load(urllib.request.urlopen('https://nodejs.org/dist/index.json',timeout=30))\nv=None\nfor e in idx:\n    if e['version'].startswith('v20'):\n        v=e['version']; break\nif not v:\n    v=idx[0]['version']\nbase='https://nodejs.org/dist/%s/node-%s-linux-x64.tar.xz'%(v,v)\nprint('downloading',base)\nos.makedirs('/opt/node',exist_ok=True)\nurllib.request.urlretrieve(base,'/opt/node/node.tar.xz')\nprint('downloaded')\nPY\n"]
