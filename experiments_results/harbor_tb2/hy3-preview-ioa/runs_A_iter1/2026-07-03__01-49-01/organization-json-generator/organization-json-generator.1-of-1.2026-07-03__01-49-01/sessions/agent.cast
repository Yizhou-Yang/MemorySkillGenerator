[49.514391, "i", "cat > /app/build.py << 'PYEOF'\nimport csv, json, os\nfrom datetime import datetime, timezone\nfrom collections import defaultdict\n\nDATA = '/app/data'\n\ndef read_csv(name):\n    with open(os.path.join(DATA, name), newline='', encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\ndepartments = read_csv('departments.csv')\nemployees = read_csv('employees.csv')\nprojects = read_csv('projects.csv')\n\ndept_by_id = {d['id']: d for d in departments}\nemp_by_id = {e['id']: e for e in employees}\n\n# group employees by department\nemps_by_dept = defaultdict(list)\nfor e in employees:\n    emps_by_dept[e['department_id']].append(e)\n\nprojs_by_dept = defaultdict(list)\nfor p in projects:\n    projs_by_dept[p['department_id']].append(p)\n\ndef build_employee(e):\n    return {\n        'id': e['id'],\n        'name': e['name'],\n        'position': e['position'],\n        'skills': [s.strip() for s in e['skills'].split(';') if s.strip()],\n        'years_of_service': int(e['years_of_service']),\n    }\n\ndef build_project(p):\n    return {\n"]
[49.514445, "i", "        'name': p['name'],\n        'status': p['status'],\n        'members': [m.strip() for m in p['member_ids'].split(';') if m.strip()],\n        'deadline': p['deadline'],\n    }\n\n# statistics\nbudgets = [float(d['budget']) for d in departments]\naverage_dept_budget = round(sum(budgets) / len(budgets), 2)\ntotal_employees = len(employees)\n\nskill_dist = defaultdict(int)\nfor e in employees:\n    for s in e['skills'].split(';'):\n        s = s.strip()\n        if s:\n            skill_dist[s] += 1\n\ndept_sizes = {}\nfor d in departments:\n    dept_sizes[d['name']] = len(emps_by_dept.get(d['id'], []))\n\nstatus_dist = defaultdict(int)\nfor p in projects:\n    status_dist[p['status']] += 1\n\navg_years = round(sum(int(e['years_of_service']) for e in employees) / total_employees, 2)\n\norg_departments = []\nfor d in departments:\n    did = d['id']\n    org_departments.append({\n        'id': did,\n        'name': d['name'],\n        'budget': float(d['budget']),\n        'employees': [build_employee(e) for e in emps_by_dept.get(did, [])],"]
[49.514453, "i", "\n        'projects': [build_project(p) for p in projs_by_dept.get(did, [])],\n    })\n\noutput = {\n    'metadata': {\n        'version': '1.0',\n        'timestamp': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),\n        'generator': 'CSV to JSON Processor',\n    },\n    'organization': {\n        'name': 'Global Tech Organization',\n        'founded': '2000-01-01',\n        'departments': org_departments,\n    },\n    'statistics': {\n        'averageDepartmentBudget': average_dept_budget,\n        'totalEmployees': total_employees,\n        'skillDistribution': dict(skill_dist),\n        'departmentSizes': dept_sizes,\n        'projectStatusDistribution': dict(status_dist),\n        'averageYearsOfService': avg_years,\n    },\n}\n\nwith open('/app/organization.json', 'w', encoding='utf-8') as f:\n    json.dump(output, f, indent=2, ensure_ascii=False)\n\nprint('Wrote /app/organization.json')\nprint('Departments:', len(org_departments), 'Employees:', total_employees, 'Projects:', len(projects))\nprint('avgBudget:', average_"]
[49.51447, "i", "dept_budget, 'avgYears:', avg_years)\nPYEOF\n"]
[49.514627, "o", "cat > /app/build.py << 'PYEOF'"]
