[121.168293, "o", "\u001b[?2004hroot@67d6d66d2a99:/app# "]
[121.896099, "i", "git init --bare /git/project >/dev/null && chown -R git:git /git/project && chmod -R u+rwx /git/project\n"]
[121.896996, "o", "git init --bare /git/project >/dev/null && chown -R git:git /git/project && chmod -R u+rwx /git/project\r\n\u001b[?2004l\r"]
[122.168318, "o", "\u001b[33mhint: Using 'master' as the name for the initial branch. This default branch name\u001b[m\r\n\u001b[33mhint: will change to \"main\" in Git 3.0. To configure the initial branch name\u001b[m\r\n\u001b[33mhint: to use in all of your new repositories, which will suppress this warning,\u001b[m\r\n\u001b[33mhint: call:\u001b[m\r\n\u001b[33mhint:\u001b[m\r\n\u001b[33mhint: \tgit config --global init.defaultBranch <name>\u001b[m\r\n\u001b[33mhint:\u001b[m\r\n\u001b[33mhint: Names commonly chosen instead of 'master' are 'main', 'trunk' and\u001b[m\r\n\u001b[33mhint: 'development'. The just-created branch can be renamed via this command:\u001b[m\r\n\u001b[33mhint:\u001b[m\r\n\u001b[33mhint: \tgit branch -m <name>\u001b[m\r\n\u001b[33mhint:\u001b[m\r\n"]
[122.168398, "o", "\u001b[33mhint: Disable this message with \"git config set advice.defaultBranchName false\"\u001b[m\r\n"]
[122.2575, "o", "\u001b[?2004hroot@67d6d66d2a99:/app# "]
[122.431466, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nset -e\nwhile read oldrev newrev refname; do\n  branch=\"${refname#refs/heads/}\"\n  case \"$branch\" in\n    main) dest=/srv/www ;;\n    dev)  dest=/srv/www/dev ;;\n    *) continue ;;\n  esac\n  mkdir -p \"$dest\"\n  git archive \"$newrev\" | tar -x -C \"$dest\"\n  find \"$dest\" -type f -exec chmod 644 {} \\;\n  find \"$dest\" -type d -exec chmod 755 {} \\;\ndone\nEOF\n"]
[122.432839, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n\u001b[?2004l\r"]
[122.432985, "o", "\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> set -e\r\n\u001b[?2004l\r\u001b[?2004h> while read oldrev newrev refname; do\r\n\u001b[?2004l\r\u001b[?2004h>   branch=\"${refname#refs/heads/}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.433034, "o", "  case \"$branch\" in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.433266, "o", "    main) dest=/srv/www ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.433424, "o", "    dev)  dest=/srv/www/dev ;;\r\n\u001b[?2004l\r\u001b[?2004h>     *) continue ;;\r\n\u001b[?2004l\r\u001b[?2004h>   esac"]
[122.434248, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.434302, "o", "  mkdir -p \"$dest\"\r\n\u001b[?2004l\r\u001b[?2004h>   git archive \"$newrev\" | tar -x -C \"$dest\"\r\n\u001b[?2004l\r"]
[122.434327, "o", "\u001b[?2004h> "]
[122.434462, "o", "  find \"$dest\" -type f -exec chmod 644 {} \\;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.435339, "o", "  find \"$dest\" -type d -exec chmod 755 {} \\;\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[122.443818, "o", "\u001b[?2004hroot@67d6d66d2a99:/app# "]
[122.641733, "i", "chmod +x /git/project/hooks/post-receive && chown git:git /git/project/hooks/post-receive\n"]
[122.642468, "o", "chmod +x /git/project/hooks/post-receive && chown git:git /git/project/hooks/post-receive\r\n\u001b[?2004l\r"]
