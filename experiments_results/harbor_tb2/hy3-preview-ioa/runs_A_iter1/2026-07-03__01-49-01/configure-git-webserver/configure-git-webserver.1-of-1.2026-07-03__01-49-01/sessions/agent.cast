[691.39719, "i", "cat > /tmp/setup.sh <<'OUTER'\n#!/bin/bash\n# 1. host alias\ngrep -q ' server$' /etc/hosts || echo '127.0.0.1 server' >> /etc/hosts\n\n# 2. user account\nid user >/dev/null 2>&1 || useradd -m -s /bin/bash user\n\n# 3. sshd setup\nmkdir -p /run/sshd\n[ -f /root/.ssh/id_ed25519 ] || ssh-keygen -t ed25519 -N '' -f /root/.ssh/id_ed25519\nmkdir -p /home/user/.ssh\ncat /root/.ssh/id_ed25519.pub >> /home/user/.ssh/authorized_keys\nchmod 700 /home/user/.ssh\nchmod 600 /home/user/.ssh/authorized_keys\nchown -R user:user /home/user/.ssh\n\ncat > /root/.ssh/config <<'CFG'\nHost server\n    StrictHostKeyChecking no\n    UserKnownHostsFile /dev/null\n    LogLevel ERROR\nCFG\nchmod 600 /root/.ssh/config\n\nmkdir -p /etc/ssh/sshd_config.d\necho 'PubkeyAuthentication yes' > /etc/ssh/sshd_config.d/99-git.conf\n\nif ! pgrep -x sshd >/dev/null 2>&1; then\n    /usr/sbin/sshd\nfi\n\n# 4. bare repo\nmkdir -p /git\nchown user:user /git\nsu user -c 'git init --bare /git/server'\n\n# 5. web root\nmkdir -p /srv/web\nchown user:user /srv/web\n\n# 6. post-receive hook\ncat > /git/server/hooks/post-receive <<'HOOK'\n#!/bin/bash\nwhile read oldrev newrev refname; do\n    if [ \"$refname\" = \"refs/heads/webserver\" ]; then\n        GIT_WORK_TREE=/srv/web git checkout -f webserver\n    fi\ndone\nHOOK\nchmod +x /git/server/hooks/post-receive\nchown user:user /git/server/hooks/post-receive\n\n# 7. TLS cert (trusted system-wide)\nmkdir -p /etc/web\nopenssl req -x509 -newkey rsa:2048 -nodes -keyout /etc/web/key.pem -out /etc/web/cert.pem -days 3650 -subj '/CN=server' -addext 'subjectAltName = DNS:server,IP:127.0.0.1' 2>/dev/null\ncp /etc/web/cert.pem /usr/local/share/ca-certificates/server.crt\nupdate-ca-certificates >/dev/null 2>&1\n\n# 8. HTTPS web server on 8080\ncat > /usr/local/bin/webserver.py <<'PY'\nimport http.server, ssl, os\nos.chdir('/srv/web')\nhttpd = http.server.HTTPServer(('0.0.0.0', 8080), http.server.SimpleHTTPRequestHandler)\nctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\nctx.load_cert_chain('/etc/web/cert.pem', '/etc/web/key.pem')\nhttpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)\nhttpd.serve_forever()\nPY\n\nif ! pgrep -f webserver.py >/dev/null 2>&1; then\n    nohup python3 /usr/local/bin/webserver.py >/var/log/webserver.log 2>&1 &\nfi\n\necho SETUP_DONE\nOUTER\n"]
