[478.008118, "i", "cat > /tmp/dl.py <<'EOF'\nimport subprocess, os, urllib.request\nout = subprocess.check_output(['apt-get','install','--print-uris','-y','--no-install-recommends','git','openssh-server','curl']).decode()\nurls=[]\nfor line in out.splitlines():\n    if line.startswith(\"'\"):\n        urls.append(line.split(\"'\")[1])\nd='/var/cache/apt/archives'\nreq=urllib.request.Request\nfor u in urls:\n    fn=os.path.join(d, u.rsplit('/',1)[-1])\n    print('downloading', fn)\n    r=req(u, headers={'User-Agent':'Debian APT-HTTP/1.3'})\n    with urllib.request.urlopen(r) as fp, open(fn,'wb') as f:\n        f.write(fp.read())\nprint('done', len(urls))\nEOF\npython3 /tmp/dl.py\n"]
