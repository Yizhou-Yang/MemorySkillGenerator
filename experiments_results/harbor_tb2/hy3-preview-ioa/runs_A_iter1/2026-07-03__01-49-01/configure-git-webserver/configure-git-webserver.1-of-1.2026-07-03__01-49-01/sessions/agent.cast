[691.427531, "o", "> "]
[691.427821, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.42801, "o", "> mkdir -p /etc/ssh/sshd_config.d"]
[691.428427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.428627, "o", "> echo 'PubkeyAuthentication yes' > /etc/ssh/sshd_config.d/99-git.conf"]
[691.428818, "o", "\r\n"]
[691.42902, "o", "\u001b[?2004l\r"]
[691.429809, "o", "\u001b[?2004h"]
[691.430126, "o", "> \r\n"]
[691.430305, "o", "\u001b[?2004l\r\u001b[?2004h> if ! pgrep -x sshd >/dev/null 2>&1; then"]
[691.430516, "o", "\r\n"]
[691.430849, "o", "\u001b[?2004l\r\u001b[?2004h"]
[691.431057, "o", ">     /usr/sbin/sshd"]
[691.431278, "o", "\r\n\u001b[?2004l\r"]
[691.431519, "o", "\u001b[?2004h> fi"]
[691.431737, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.43613, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.436516, "o", "# 4. bare repo"]
[691.436744, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.437014, "o", "> mkdir -p /git"]
[691.437195, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.441025, "o", "> "]
[691.441382, "o", "chown user:user /git"]
[691.441691, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.441925, "o", "su user -c 'git init --bare /git/server'"]
[691.4422, "o", "\r\n\u001b[?2004l\r"]
[691.442422, "o", "\u001b[?2004h> "]
[691.442657, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.44287, "o", "# 5. web root"]
[691.443144, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.443398, "o", "mkdir -p /srv/web"]
[691.443686, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.443889, "o", "> chown user:user /srv/web"]
[691.444144, "o", "\r\n"]
[691.444435, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[691.444651, "o", "\u001b[?2004h> # 6. post-receive hook"]
[691.445436, "o", "\r\n\u001b[?2004l\r"]
[691.445642, "o", "\u001b[?2004h> cat > /git/server/hooks/post-receive <<'HOOK'"]
[691.445842, "o", "\r\n"]
[691.446098, "o", "\u001b[?2004l\r"]
[691.446306, "o", "\u001b[?2004h> #!/bin/bash"]
[691.446507, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.446762, "o", "> "]
[691.446931, "o", "while read oldrev newrev refname; do"]
[691.447363, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.44758, "o", ">     if [ \"$refname\" = \"refs/heads/webserver\" ]; then"]
[691.44779, "o", "\r\n"]
[691.449203, "o", "\u001b[?2004l\r\u001b[?2004h"]
[691.449392, "o", ">         GIT_WORK_TREE=/srv/web git checkout -f webserver"]
[691.449628, "o", "\r\n"]
[691.450459, "o", "\u001b[?2004l\r\u001b[?2004h"]
[691.45072, "o", ">     fi"]
[691.450939, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> done"]
[691.45131, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.451513, "o", "HOOK\r\n\u001b[?2004l\r\u001b[?2004h> chmod +x /git/server/hooks/post-receive"]
[691.45172, "o", "\r\n"]
[691.452205, "o", "\u001b[?2004l\r"]
[691.452544, "o", "\u001b[?2004h> chown user:user /git/server/hooks/post-receive"]
[691.452834, "o", "\r\n"]
[691.453109, "o", "\u001b[?2004l\r"]
[691.454123, "o", "\u001b[?2004h"]
[691.454903, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[691.455127, "o", "> # 7. TLS cert (trusted system-wide)"]
[691.455361, "o", "\r\n"]
[691.455674, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[691.45591, "o", "mkdir -p /etc/web"]
[691.456541, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.45675, "o", "openssl req -x509 -newkey rsa:2048 -nodes -keyout /etc/web/key.pem -out /etc/web/cert.pem -days 3650 -subj '/CN=server' -addext 'subjectAltName = DNS:server,IP:127.0.0.1' 2>/dev/null"]
[691.457006, "o", "\r\n"]
[691.457231, "o", "\u001b[?2004l\r"]
[691.457496, "o", "\u001b[?2004h"]
[691.45773, "o", "> "]
[691.458166, "o", "cp /etc/web/cert.pem /usr/local/share/ca-certificates/server.crt"]
[691.458388, "o", "\r\n"]
[691.458627, "o", "\u001b[?2004l\r"]
[691.458866, "o", "\u001b[?2004h"]
[691.459102, "o", "> "]
[691.459433, "o", "update-ca-certificates >/dev/null 2>&1"]
[691.459618, "o", "\r\n"]
[691.459823, "o", "\u001b[?2004l\r\u001b[?2004h"]
[691.460023, "o", "> "]
[691.460204, "o", "\r\n"]
[691.460456, "o", "\u001b[?2004l\r"]
[691.460864, "o", "\u001b[?2004h> "]
[691.461043, "o", "# 8. HTTPS web server on 8080\r\n\u001b[?2004l\r\u001b[?2004h> cat > /usr/local/bin/webserver.py <<'PY'"]
[691.461192, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.46132, "o", "> "]
[691.461534, "o", "import http.server, ssl, os"]
[691.46165, "o", "\r\n"]
[691.461757, "o", "\u001b[?2004l\r"]
[691.461993, "o", "\u001b[?2004h"]
[691.462075, "o", "> os.chdir('/srv/web')"]
[691.462196, "o", "\r\n"]
[691.462594, "o", "\u001b[?2004l\r\u001b[?2004h"]
[691.462679, "o", "> httpd = http.server.HTTPServer(('0.0.0.0', 8080), http.server.SimpleHTTPRequestHandler)"]
[691.46277, "o", "\r\n"]
[691.46287, "o", "\u001b[?2004l\r"]
[691.463014, "o", "\u001b[?2004h"]
[691.463136, "o", "> "]
[691.463572, "o", "ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.463605, "o", "ctx.load_cert_chain('/etc/web/cert.pem', '/etc/web/key.pem')\r\n"]
[691.464204, "o", "\u001b[?2004l\r\u001b[?2004h> httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.468595, "o", "httpd.serve_forever()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.470508, "o", "if ! pgrep -f webserver.py >/dev/null 2>&1; then\r\n\u001b[?2004l\r\u001b[?2004h>     nohup python3 /usr/local/bin/webserver.py >/var/log/webserver.log 2>&1 &\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> echo SETUP_DONE\r\n\u001b[?2004l\r\u001b[?2004h> OUTER\r\n\u001b[?2004l\r"]
[691.475368, "o", "\u001b[?2004hroot@76a65199b158:/app# "]
[691.673237, "i", "bash /tmp/setup.sh\n"]
[691.67466, "o", "bash /tmp/setup.sh\r\n\u001b[?2004l\r"]
[691.88541, "o", "Generating public/private ed25519 key pair.\r\n"]
[691.891796, "o", "Created directory '/root/.ssh'.\r\r\nYour identification has been saved in /root/.ssh/id_ed25519\r\nYour public key has been saved in /root/.ssh/id_ed25519.pub\r\nThe key fingerprint is:\r\nSHA256:6U6uH5WFacvmaHveJrZ3s8+teAVdDaMwpUsT+UfCQAs root@76a65199b158\r\nThe key's randomart image is:\r\n+--[ED25519 256]--+\r\n|        E.*=. o..|\r\n|         ..Oo...o|\r\n|          O.oo ..|\r\n|         = *. o .|\r\n|        S B  . . |\r\n|       . =      .|\r\n|        * .    . |\r\n|       = o+.o.+..|\r\n|      .o=+o=ooo=+|\r\n+----[SHA256]-----+\r\n"]
[692.495085, "o", "\u001b[33mhint: Using 'master' as the name for the initial branch. This default branch name\u001b[m\r\n\u001b[33mhint: is subject to change. To configure the initial branch name to use in all\u001b[m\r\n\u001b[33mhint: of your new repositories, which will suppress this warning, call:\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: \tgit config --global init.defaultBranch <name>\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: Names commonly chosen instead of 'master' are 'main', 'trunk' and\u001b[m\r\n\u001b[33mhint: 'development'. The just-created branch can be renamed via this command:\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: \tgit branch -m <name>\u001b[m\r\n"]
[692.506418, "o", "Initialized empty Git repository in /git/server/"]
[692.506847, "o", "\r\n"]
