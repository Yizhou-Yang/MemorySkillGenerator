[438.657108, "i", "cat > /tmp/dl.py <<'EOF'\nimport subprocess, os, urllib.request\nout = subprocess.check_output(['apt-get','install','--print-uris','-y','--no-install-recommends','git','openssh-server','curl']).decode()\nurls=[]\nfor line in out.splitlines():\n    if line.startswith(\"'\"):\n        urls.append(line.split(\"'\")[1])\nd='/var/cache/apt/archives'\nfor u in urls:\n    fn=os.path.join(d, u.rsplit('/',1)[-1])\n    print('downloading', fn)\n    urllib.request.urlretrieve(u, fn)\nprint('done', len(urls))\nEOF\npython3 /tmp/dl.py\n"]
