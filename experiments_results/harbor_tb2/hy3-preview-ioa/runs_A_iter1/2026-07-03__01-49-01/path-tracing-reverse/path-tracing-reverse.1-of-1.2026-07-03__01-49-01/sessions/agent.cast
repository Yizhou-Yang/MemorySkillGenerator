[300.39988, "i", "python3 - <<'EOF'\nimport re\nlines=open('/tmp/disasm.txt').read().splitlines()\ncur=None\nout={}\nfor ln in lines:\n    m=re.match(r'^([0-9a-f]+) <([^>]+)>:',ln)\n    if m:\n        cur=m.group(2)\n        out[cur]=[]\n    if cur is not None:\n        out[cur].append(ln)\nfor k,v in out.items():\n    open('/tmp/fn_%s.txt'%k,'w').write('\\n'.join(v)+'\\n')\nprint('\\n'.join(sorted(out.keys())))\nEOF\n"]
