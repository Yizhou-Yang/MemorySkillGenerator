[147.58024, "m", "Episode 8: 1 commands"]
[147.58024, "o", "\u001b[?2004hroot@1e5f4dd76c75:/app# "]
[222.671033, "i", "python3 - <<'EOF'\nimport struct\ndata=open('mystery','rb').read()\n# find .rodata vaddr 0x3000; file offset unknown, parse via readelf later. Instead read /tmp/rodata.txt hex.\nimport re\nlines=open('/tmp/rodata.txt').read().splitlines()\nfor ln in lines:\n    m=re.match(r'\\s*([0-9a-f]+) ((?:[0-9a-f]{2,8}\\s?){1,4})',ln)\n    if m:\n        addr=int(m.group(1),16)\n        b=m.group(2).replace(' ','')\n        bs=bytes.fromhex(b)\n        for i in range(0,len(bs)-3,4):\n            f=struct.unpack('<f',bs[i:i+4])[0]\n            print(hex(addr+i), f)\nEOF\n"]
[222.676934, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct\r\n\u001b[?2004l\r\u001b[?2004h> data=open('mystery','rb').read()\r\n\u001b[?2004l\r\u001b[?2004h> # find .rodata vaddr 0x3000; file offset unknown, parse via readelf later. Instead read /tmp/rodata.txt hex.\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> lines=open('/tmp/rodata.txt').read().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> for ln in lines:\r\n\u001b[?2004l\r\u001b[?2004h>     m=re.match(r'\\s*([0-9a-f]+) ((?:[0-9a-f]{2,8}\\s?){1,4})',ln)\r\n\u001b[?2004l\r\u001b[?2004h>     if m:\r\n\u001b[?2004l\r\u001b[?2004h>         addr=int(m.group(1),16)\r\n\u001b[?2004l\r\u001b[?2004h>         b=m.group(2).replace(' ','')\r\n\u001b[?2004l\r\u001b[?2004h>         bs=bytes.fromhex(b)\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(0,len(bs)-3,4):\r\n\u001b[?2004l\r\u001b[?2004h>             f=struct.unpack('<f',bs[i:i+4])[0]\r\n\u001b[?2004l\r\u001b[?2004h>             print(hex(addr+i), f)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
