[418.569222, "i", "cat > /tmp/dl.py << 'EOF'\nimport urllib.request, os\nurls=[l.strip() for l in open('/tmp/urls.txt') if l.strip()]\nhdr={'User-Agent':'Debian APT-HTTP/1.3 (2.7.14)'}\nfail=[]\nfor i,u in enumerate(urls):\n    fn=os.path.join('/tmp/debs', os.path.basename(u.split('?')[0]))\n    if os.path.exists(fn) and os.path.getsize(fn)>0:\n        continue\n    ok=False\n    for attempt in range(4):\n        try:\n            req=urllib.request.Request(u, headers=hdr)\n            with urllib.request.urlopen(req, timeout=60) as r:\n                data=r.read()\n            open(fn,'wb').write(data)\n            ok=True\n            break\n        except Exception as e:\n            print('retry', os.path.basename(u), e)\n    if not ok:\n        fail.append(u)\n    if i%30==0:\n        print('proc',i,'/',len(urls))\nprint('FAILED', len(fail))\nfor f in fail: print(f)\nEOF\necho written\n"]
[418.569702, "o", "cat > /tmp/dl.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request, os"]
[418.569913, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.576573, "o", "urls=[l.strip() for l in open('/tmp/urls.txt') if l.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> hdr={'User-Agent':'Debian APT-HTTP/1.3 (2.7.14)'}\r\n\u001b[?2004l\r\u001b[?2004h> fail=[]\r\n\u001b[?2004l\r\u001b[?2004h> for i,u in enumerate(urls):\r\n\u001b[?2004l\r\u001b[?2004h>     fn=os.path.join('/tmp/debs', os.path.basename(u.split('?')[0]))\r\n\u001b[?2004l\r\u001b[?2004h>     if os.path.exists(fn) and os.path.getsize(fn)>0:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     ok=False\r\n\u001b[?2004l\r\u001b[?2004h>     for attempt in range(4):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             req=urllib.request.Request(u, headers=hdr)\r\n\u001b[?2004l\r\u001b[?2004h>             with urllib.request.urlopen(req, timeout=60) as r:\r\n\u001b[?2004l\r\u001b[?2004h>                 data=r.read()\r\n\u001b[?2004l\r\u001b[?2004h>             open(fn,'wb').write(data)\r\n\u001b[?2004l\r\u001b[?2004h>             ok=True\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             print('retry', os.path.basename(u), e)\r\n\u001b[?2004l\r\u001b[?2004h>     if not ok:\r\n\u001b[?2004l\r\u001b[?2004h>         fail.append(u)\r\n\u001b[?2004l\r\u001b[?2004h>     if i%30==0:\r\n\u001b[?2004l\r\u001b[?2004h>         print('proc',i,'/',len(urls))\r\n\u001b[?2004l\r\u001b[?2004h> print('FAILED', len(fail))\r\n\u001b[?2004l\r\u001b[?2004h> for f in fail: print(f)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
