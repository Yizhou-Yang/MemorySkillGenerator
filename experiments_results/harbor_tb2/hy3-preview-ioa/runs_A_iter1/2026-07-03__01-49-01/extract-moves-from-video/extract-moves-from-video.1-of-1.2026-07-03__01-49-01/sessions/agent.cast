[273.514678, "i", "mkdir -p /tmp/debs; cat > /tmp/dl.py << 'EOF'\nimport urllib.request, sys, os\nurls=[l.strip() for l in open('/tmp/urls.txt') if l.strip()]\nfail=[]\nfor i,u in enumerate(urls):\n    fn=os.path.join('/tmp/debs', os.path.basename(u.split('?')[0]))\n    if os.path.exists(fn) and os.path.getsize(fn)>0:\n        continue\n    ok=False\n    for attempt in range(3):\n        try:\n            urllib.request.urlretrieve(u, fn)\n            ok=True\n            break\n        except Exception as e:\n            print('retry', u, e)\n    if not ok:\n        fail.append(u)\n    if i%20==0:\n        print(i, len(urls))\nprint('FAILED', len(fail))\nfor f in fail: print(f)\nEOF\necho written\n"]
