[393.653286, "i", "cat > /tmp/dl.py <<'PY'\nimport urllib.request\nout='/tmp/debs/'\nurls=[]\nfor line in open('/tmp/uris.txt'):\n    line=line.strip()\n    if line.startswith(\"'\"):\n        parts=line.split()\n        urls.append((parts[0].strip(\"'\"), parts[1]))\nhdr={'User-Agent':'Debian APT-HTTP/1.3 (2.7.14)'}\nfor i,(u,f) in enumerate(urls):\n    try:\n        req=urllib.request.Request(u, headers=hdr)\n        with urllib.request.urlopen(req, timeout=60) as r:\n            data=r.read()\n        open(out+f,'wb').write(data)\n        print('ok',i,f,len(data))\n    except Exception as e:\n        print('FAIL',i,f,e)\nPY\npython3 /tmp/dl.py 2>&1 | head -8\n"]
