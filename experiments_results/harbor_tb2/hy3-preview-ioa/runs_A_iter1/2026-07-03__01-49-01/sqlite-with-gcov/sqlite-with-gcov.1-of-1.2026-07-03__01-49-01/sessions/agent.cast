[351.920963, "i", "mkdir -p /tmp/debs; cat > /tmp/dl.py <<'PY'\nimport sys, urllib.request, re\nout='/tmp/debs/'\nurls=[]\nfor line in open('/tmp/uris.txt'):\n    line=line.strip()\n    if line.startswith(\"'\"):\n        parts=line.split()\n        url=parts[0].strip(\"'\")\n        fname=parts[1]\n        urls.append((url,fname))\nprint('total',len(urls))\nfor i,(u,f) in enumerate(urls):\n    try:\n        urllib.request.urlretrieve(u, out+f)\n        print('ok',i,f)\n    except Exception as e:\n        print('FAIL',i,f,e)\nPY\npython3 /tmp/dl.py\n"]
