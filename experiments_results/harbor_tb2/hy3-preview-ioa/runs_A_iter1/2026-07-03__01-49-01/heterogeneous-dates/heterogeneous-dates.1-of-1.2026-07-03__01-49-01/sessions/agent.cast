[19.025691, "m", "Episode 2: 2 commands"]
[19.025691, "o", "\u001b[?2004hroot@d65a35bcd6ce:/app# "]
[30.657402, "i", "python3 - <<'EOF'\nimport csv, datetime\n\ndef norm(s):\n    s = s.strip().split()[0]  # drop time\n    for fmt in ('%Y-%m-%d', '%m/%d/%Y', '%m-%d-%Y'):\n        try:\n            return datetime.datetime.strptime(s, fmt).strftime('%Y-%m-%d')\n        except ValueError:\n            pass\n    raise ValueError('bad date: '+s)\n\nhigh = {}\nwith open('daily_temp_sf_high.csv') as f:\n    for row in csv.reader(f):\n        if row[0] == 'date': continue\n        high[norm(row[0])] = float(row[1])\n\nlow = {}\nwith open('daily_temp_sf_low.csv') as f:\n    for row in csv.reader(f):\n        if row[0] == 'date': continue\n        low[norm(row[0])] = float(row[1])\n\ndiffs = [high[d] - low[d] for d in high if d in low]\navg = sum(diffs) / len(diffs)\nprint('matched days:', len(diffs))\nprint('avg:', avg)\nwith open('avg_temp.txt', 'w') as f:\n    f.write(str(avg))\nEOF\n"]
