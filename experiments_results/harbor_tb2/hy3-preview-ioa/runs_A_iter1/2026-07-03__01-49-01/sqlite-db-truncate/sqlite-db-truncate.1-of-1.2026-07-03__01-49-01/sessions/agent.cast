[75.28523, "i", "cat > /tmp/parse.py << 'EOF'\nimport json, struct\n\nd = open('/app/trunc.db','rb').read()\n\ndef read_varint(data, off):\n    result = 0\n    for i in range(9):\n        b = data[off+i]\n        if i == 8:\n            result = (result << 8) | b\n            return result, off+9\n        result = (result << 7) | (b & 0x7f)\n        if (b & 0x80) == 0:\n            return result, off+i+1\n    return result, off+9\n\npage_type = d[0]\nfirst_freeblock = int.from_bytes(d[1:3],'big')\nnum_cells = int.from_bytes(d[3:5],'big')\ncell_content_start = int.from_bytes(d[5:7],'big')\nfrag = d[7]\nprint('type', page_type, 'cells', num_cells, 'ccs', hex(cell_content_start), 'frag', frag)\n\ncell_ptr_off = 8\ncells = []\nfor i in range(num_cells):\n    ptr = int.from_bytes(d[cell_ptr_off+i*2:cell_ptr_off+i*2+2],'big')\n    cells.append(ptr)\nprint('cell ptrs', [hex(x) for x in cells])\n\ndef parse_record(payload):\n    hlen, off = read_varint(payload, 0)\n    types = []\n    p = off\n    while p < hlen:\n        t, p = read_varint(payload, p)\n        types.append(t)\n    body = p\n    values = []\n    for t in types:\n        if t == 0:\n            values.append(None)\n        elif t == 1:\n            values.append(int.from_bytes(payload[body:body+1],'big',signed=True)); body+=1\n        elif t == 2:\n            values.append(int.from_bytes(payload[body:body+2],'big',signed=True)); body+=2\n        elif t == 3:\n            values.append(int.from_bytes(payload[body:body+3],'big',signed=True)); body+=3\n        elif t == 4:\n            values.append(int.from_bytes(payload[body:body+4],'big',signed=True)); body+=4\n        elif t == 5:\n            values.append(int.from_bytes(payload[body:body+6],'big',signed=True)); body+=6\n        elif t == 6:\n            values.append(int.from_bytes(payload[body:body+8],'big',signed=True)); body+=8\n        elif t == 7:\n            values.append(struct.unpack('>d', payload[body:body+8])[0]); body+=8\n        elif t == 8:\n            values.append(0)\n        elif t == 9:\n            values.append(1)\n        elif t >= 12 and t % 2 == 0:\n            n = (t-12)//2\n            values.append(payload[body:body+n]); body+=n\n        elif t >= 13 and t % 2 == 1:\n            n = (t-13)//2\n            values.append(payload[body:body+n].decode('utf-8','replace')); body+=n\n        else:\n            values.append(None)\n    return values\n\nrecords = []\nfor ptr in cells:\n    payload_len, off = read_varint(d, ptr)\n    rowid, off = read_varint(d, off)\n    payload = d[off:off+payload_len]\n    vals = parse_record(payload)\n    records.append((rowid, vals))\n    print('rowid', rowid, 'vals', vals)\n\nout = [{\"word\": r[1][0], \"value\": r[1][1]} for r in records]\njson.dump(out, open('/app/recover.json','w'), indent=2)\nprint('---')\nprint(json.dumps(out, indent=2))\nEOF\npython3 /tmp/parse.py\n"]
