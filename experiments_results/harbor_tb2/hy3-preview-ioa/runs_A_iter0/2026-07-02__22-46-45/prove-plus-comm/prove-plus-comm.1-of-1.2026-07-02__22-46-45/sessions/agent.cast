[36.060426, "i", "cat > plus_comm.v <<'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [|n' IHn'].\n  - simpl.\n    apply plus_n_O.\n  - simpl.\n    rewrite IHn'.\n    apply plus_n_Sm.\nQed.\nEOF\n"]
[36.060928, "o", "cat > plus_comm.v <<'EOF'"]
