[768.49642, "i", "cat > /app/scope.py << 'EOF'\nimport struct\nfrom collections import Counter\nd=open('/app/data.bin','rb').read()\ndef w(off): return struct.unpack_from('<H',d,off)[0]\na_text=w(2); a_data=w(4); a_bss=w(6); a_syms=w(8)\ntext_off=16\ntext=d[text_off:text_off+a_text]\nwords=[int.from_bytes(text[i:i+2],'little') for i in range(0,len(text),2)]\nhb=Counter(x>>8 for x in words)\nprint('text words:', len(words))\nprint('high byte histogram:')\nfor k in sorted(hb): print('  %s : %d'%(hex(k), hb[k]))\nprint('sys instructions (opcode 0x89xx):')\nfor i,x in enumerate(words):\n    if (x & 0xFF00)==0x8900:\n        n=x&0x7F\n        after=[hex(words[i+1+j]) for j in range(min(5,len(words)-i-1))]\n        print('  textidx %4d (file %04x) sys %d  after: %s'%(i, text_off+2*i, n, after))\nEOF\npython3 /app/scope.py\n"]
[768.496645, "o", "cat > /app/scope.py << 'EOF'"]
