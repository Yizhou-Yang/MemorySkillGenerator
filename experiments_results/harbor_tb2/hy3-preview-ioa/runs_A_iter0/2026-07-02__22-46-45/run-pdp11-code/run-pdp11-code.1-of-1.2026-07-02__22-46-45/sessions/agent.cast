[198.337037, "i", "cat > /app/analyze.py << 'EOF'\nimport struct, re\nd = open('/app/data.bin','rb').read()\ndef w(off): return struct.unpack_from('<H', d, off)[0]\nprint('len', len(d))\nfor i,n in enumerate(['magic','a_text','a_data','a_bss','a_syms','a_entry','a_trsize','a_drsize']):\n    print(n, oct(w(2*i)))\n# strings\nprint('--- strings ---')\nfor m in re.finditer(rb'[\\x20-\\x7e]{3,}', d):\n    print(m.start(), m.group())\n# data segment (try both interpretations)\nfor label, tstart in [('hdr=16',16), ('text after header', 16+w(2))]:\n    ds = w(2)\n    seg = d[tstart:tstart+ds]\n    print(label, 'data@',tstart,'hex', seg.hex(), 'ascii', seg)\nEOF\npython3 /app/analyze.py\n"]
