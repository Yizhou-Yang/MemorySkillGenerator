[118.900759, "i", "cat > /app/verify.py << 'EOF'\nlines=open('/app/data.hex').read().split('\\n')\nfor ln in lines:\n    ln=ln.rstrip()\n    if not ln.strip(): continue\n    parts=ln.split()\n    off=int(parts[0],8)\n    words=parts[1:]\n    recon=''.join('%07o'%(int(w,8)) for w in words)\n    # rebuild bytes\n    b=b''.join(int(w,8).to_bytes(2,'little') for w in words)\n    print(ln)\nEOF\npython3 /app/verify.py | diff - /app/data.hex && echo ROUNDTRIP_OK || echo ROUNDTRIP_FAIL\n"]
