[?2004h>         diffpix=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for yy in range(S):\r\n\u001b[?2004l\r\u001b[?2004h>             for xx in range(S):\r\n\u001b[?2004l\r\u001b[?2004h>                 p=px[x0+xx,y0+yy]\r\n\u001b[?2004l\r\u001b[?2004h>                 d=dist(p,bg)\r\n\u001b[?2004l\r\u001b[?2004h>                 ni=yy*N//S; nj=xx*N//S\r\n\u001b[?2004l\r\u001b[?2004h>                 cnt[ni][nj]+=1\r\n\u001b[?2004l\r\u001b[?2004h>                 if d>45:"]
