[257.730715, "i", "cat > /app/diag.py << 'EOF'\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\nW,H = im.size\npx = im.load()\nS = W//8\nfiles='abcdefgh'\ndef lum(p): return 0.299*p[0]+0.587*p[1]+0.114*p[2]\ndef bg_of(r,c):\n    xs=[]\n    x0,y0=c*S,r*S\n    for i in range(S):\n        for (sx,sy) in [(x0+i,y0+2),(x0+i,y0+S-3),(x0+2,y0+i),(x0+S-3,y0+i)]:\n            xs.append(px[sx,sy])\n    xsr=sorted(x[0] for x in xs); xsg=sorted(x[1] for x in xs); xsb=sorted(x[2] for x in xs)\n    n=len(xs)\n    return (xsr[n//2],xsg[n//2],xsb[n//2])\ndef dist(a,b): return sum((a[i]-b[i])**2 for i in range(3))**0.5\nfor r in range(8):\n    for c in range(8):\n        bg=bg_of(r,c); x0,y0=c*S,r*S\n        ink=0; sumink=0\n        for yy in range(S):\n            for xx in range(S):\n                p=px[x0+xx,y0+yy]\n                if dist(p,bg)>45:\n                    ink+=1; sumink+=lum(p)\n        if ink<30: continue\n        inklum = sumink/ink\n        side='W' if (inklum > lum(bg)) else 'B'\n        print('%s%d side=%s ink=%4d bgL=%6.1f inkL=%6.1f'%(files[c],8-r,side,ink,lum(bg),inklum))\nEOF\npython3 /app/diag.py\n"]
[257.73186, "o", "cat > /app/diag.py << 'EOF'"]
