[148.710604, "i", "cat > /app/analyze.py << 'EOF'\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\nW,H = im.size\npx = im.load()\n# coarse brightness ascii\nstep = 8\nchars = ' .:-=+*#%@'\nfor y in range(0,H,step):\n    line=''\n    for x in range(0,W,step):\n        r,g,b = px[x,y]\n        lum = 0.299*r+0.587*g+0.114*b\n        idx = int(lum/256*len(chars))\n        if idx>=len(chars): idx=len(chars)-1\n        line+=chars[idx]\n    print(line)\nEOF\npython3 /app/analyze.py\n"]
