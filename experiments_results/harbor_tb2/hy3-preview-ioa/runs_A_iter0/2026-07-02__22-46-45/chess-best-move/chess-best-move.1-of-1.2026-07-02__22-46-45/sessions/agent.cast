[148.902175, "o", "\u001b[?2004hroot@6011adc3f64a:/app# "]
[193.929537, "i", "cat > /app/recog.py << 'EOF'\nfrom PIL import Image\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\nW,H = im.size\npx = im.load()\nS = W//8  # 80\n\ndef bg_of(r,c):\n    # sample border ring pixels of this square\n    xs=[]\n    x0,y0 = c*S, r*S\n    for i in range(S):\n        for (sx,sy) in [((x0+i),y0+2),((x0+i),y0+S-3), (x0+2,y0+i),(x0+S-3,y0+i)]:\n            xs.append(px[sx,sy])\n    # median\n    xsr = sorted(x[0] for x in xs)\n    xsg = sorted(x[1] for x in xs)\n    xsb = sorted(x[2] for x in xs)\n    n=len(xs)\n    return (xsr[n//2], xsg[n//2], xsb[n//2])\n\ndef dist(a,b):\n    return sum((a[i]-b[i])**2 for i in range(3))**0.5\n\nN=32\nmasks={}\ninfo={}\nfor r in range(8):\n    for c in range(8):\n        bg = bg_of(r,c)\n        x0,y0=c*S,r*S\n        # build mask at NxN, downsample average\n        mask=[[0]*N for _ in range(N)]\n        cnt=[[0]*N for _ in range(N)]\n        diffpix=[]\n        for yy in range(S):\n            for xx in range(S):\n                p=px[x0+xx,y0+yy]\n                d=dist(p,bg)\n                ni=yy*N//S; nj=xx*N//S\n                cnt[ni][nj]+=1\n                if d>45:\n                    mask[ni][nj]+=1\n                    diffpix.append(p)\n        tot=sum(sum(rr) for rr in cnt)\n        pp=sum(sum(rr) for rr in mask)\n        if pp < 30:  # mostly background -> empty\n            continue\n        frac=[[ (1.0 if mask[i][j]*2>=cnt[i][j] else 0.0) for j in range(N)] for i in range(N)]\n        # piece color: avg brightness of diff pix vs bg brightness\n        if diffpix:\n            avgr=sum(p[0] for p in diffpix)/len(diffpix)\n            avgg=sum(p[1] for p in diffpix)/len(diffpix)\n            avgb=sum(p[2] for p in diffpix)/len(diffpix)\n            apix=(avgr,avgg,avgb)\n        else:\n            apix=bg\n        side = 'W' if dist(apix,bg) and apix[0]+apix[1]+apix[2] > bg[0]+bg[1]+bg[2] else 'B'\n        # actually compare brightness\n        bpix = bg[0]+bg[1]+bg[2]\n        cpix = apix[0]+apix[1]+apix[2]\n        side = 'W' if cpix > bpix else 'B'\n        masks[(r,c)]=frac\n        info[(r,c)]=(side,pp,cpix,bpix)\n\n# cluster\nreps=[]\nlabels={}\ndef diffmask(a,b):\n    d=0\n    for i in range(N):\n        for j in range(N):\n            if a[i][j]!=b[i][j]: d+=1\n    return d/(N*N)\nfor sq,m in masks.items():\n    best=-1;bestd=1\n    for k,rm in enumerate(reps):\n        dd=diffmask(m,rm)\n        if dd<bestd: bestd=dd;best=k\n    if bestd<0.12:\n        labels[sq]=best\n    else:\n        labels[sq]=len(reps)\n        reps.append(m)\n\nprint('num clusters', len(reps))\n# print board grid\nfor r in range(8):\n    row=''\n    for c in range(8):\n        if (r,c) in labels:\n            row+= '%d%s '%(labels[(r,c)], info[(r,c)][0])\n        else:\n            row+='  .  '\n    print(row)\n\n# print representative ascii per cluster\nfor k,rm in enumerate(reps):\n    print('=== cluster',k,'===')\n    for i in range(N):\n        print(''.join('#' if rm[i][j]>0.5 else '.' for j in range(N)))\nEOF\npython3 /app/recog.py\n"]
