[257.788538, "o", "\u001b[?2004l\r"]
[257.795742, "o", "\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> im = Image.open('/app/chess_puzzle.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> W,H = im.size\r\n\u001b[?2004l\r\u001b[?2004h> px = im.load()\r\n\u001b[?2004l\r\u001b[?2004h> S = W//8\r\n\u001b[?2004l\r\u001b[?2004h> files='abcdefgh'\r\n\u001b[?2004l\r\u001b[?2004h> def lum(p): return 0.299*p[0]+0.587*p[1]+0.114*p[2]\r\n\u001b[?2004l\r\u001b[?2004h> def bg_of(r,c):"]
[257.821066, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.821143, "o", ">     xs=[]\r\n\u001b[?2004l\r\u001b[?2004h>     x0,y0=c*S,r*S\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(S):\r\n\u001b[?2004l\r\u001b[?2004h>         for (sx,sy) in [(x0+i,y0+2),(x0+i,y0+S-3),(x0+2,y0+i),(x0+S-3,y0+i)]:\r\n\u001b[?2004l\r\u001b[?2004h>             xs.append(px[sx,sy])\r\n\u001b[?2004l\r\u001b[?2004h>     xsr=sorted(x[0] for x in xs); xsg=sorted(x[1] for x in xs); xsb=sorted(x[2] for x in xs)\r\n\u001b[?2004l\r\u001b[?2004h>     n=len(xs)\r\n\u001b[?2004l\r\u001b[?2004h>     return (xsr[n//2],xsg[n//2],xsb[n//2])\r\n\u001b[?2004l\r\u001b[?2004h> def dist(a,b): return sum((a[i]-b[i])**2 for i in range(3))**0.5\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>     for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>         bg=bg_of(r,c); x0,y0=c*S,r*S\r\n\u001b[?2004l\r\u001b[?2004h>         ink=0; sumink=0\r\n\u001b[?2004l\r\u001b[?2004h>         for yy in range(S):\r\n\u001b[?2004l\r\u001b[?2004h>             for xx in range(S):\r\n\u001b[?2004l\r\u001b[?2004h>                 p=px[x0+xx,y0+yy]\r\n\u001b[?2004l\r\u001b[?2004h>                 if dist(p,bg)>45:\r\n\u001b[?2004l\r\u001b[?2004h>                     ink+=1; sumink+=lum(p)\r\n\u001b[?2004l\r\u001b[?2004h>         if ink<30: continue\r\n\u001b[?2004l\r\u001b[?2004h>         inklum = sumink/ink\r\n\u001b[?2004l\r\u001b[?2004h>         side='W' if (inklum > lum(bg)) else 'B'\r\n\u001b[?2004l\r\u001b[?2004h>         print('%s%d side=%s ink=%4d bgL=%6.1f inkL=%6.1f'%(files[c],8-r,side,ink,lum(bg),inklum))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
