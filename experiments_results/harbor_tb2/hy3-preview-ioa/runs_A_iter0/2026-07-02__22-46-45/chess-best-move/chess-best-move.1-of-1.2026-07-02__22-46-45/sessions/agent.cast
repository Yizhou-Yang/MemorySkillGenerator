[387.269891, "i", "cat > /app/sil2.py << 'EOF'\nfrom PIL import Image\nfrom collections import deque\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\nW,H=im.size; px=im.load(); S=W//8\nfiles='abcdefgh'\ndef lum(p): return 0.299*p[0]+0.587*p[1]+0.114*p[2]\ndef bg_lum_of(r,c):\n    xs=[]; x0,y0=c*S,r*S\n    for i in range(S):\n        for (sx,sy) in [(x0+i,y0+2),(x0+i,y0+S-3),(x0+2,y0+i),(x0+S-3,y0+i)]:\n            xs.append(lum(px[sx,sy]))\n    xs.sort(); return xs[len(xs)//2]\n\nsquares=[]; sil={}; col={}\nfor r in range(8):\n    for c in range(8):\n        bl=bg_lum_of(r,c); x0,y0=c*S,r*S\n        m=[[0]*S for _ in range(S)]\n        for yy in range(S):\n            for xx in range(S):\n                if abs(lum(px[x0+xx,y0+yy])-bl)>50: m[yy][xx]=1\n        if sum(sum(row) for row in m)<40: continue\n        # largest connected component\n        seen=[[False]*S for _ in range(S)]\n        best=[]\n        for yy in range(S):\n            for xx in range(S):\n                if m[yy][xx] and not "]
[387.271016, "o", "cat > /app/sil2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.271278, "o", "from collections import deque"]
[387.271643, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.271823, "o", "> im = Image.open('/app/chess_puzzle.png').convert('RGB')"]
[387.272022, "o", "\r\n"]
[387.272312, "o", "\u001b[?2004l\r\u001b[?2004h"]
[387.272582, "o", "> "]
[387.272747, "o", "W,H=im.size; px=im.load(); S=W//8"]
[387.273291, "o", "\r\n\u001b[?2004l\r"]
[387.273591, "o", "\u001b[?2004h"]
[387.273844, "o", "> files='abcdefgh'"]
[387.274208, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.274686, "o", "> "]
[387.274735, "i", "seen[yy][xx]:\n                    comp=[]; dq=deque([(yy,xx)]); seen[yy][xx]=True\n                    while dq:\n                        a,b=dq.popleft(); comp.append((a,b))\n                        for dy,dx in((1,0),(-1,0),(0,1),(0,-1)):\n                            na,nb=a+dy,b+dx\n                            if 0<=na<S and 0<=nb<S and m[na][nb] and not seen[na][nb]:\n                                seen[na][nb]=True; dq.append((na,nb))\n                    if len(comp)>len(best): best=comp\n        mm=[[0]*S for _ in range(S)]\n        for (a,b) in best: mm[a][b]=1\n        squares.append((r,c)); sil[(r,c)]=mm\n        # color: avg lum of piece pixels vs bg\n        pl=sum(lum(px[x0+a,y0+b]) for (a,b) in best)/len(best)\n        col[(r,c)]= 'W' if pl>bl else 'B'\n\nN=32\ndef norm(m):\n    out=[[0]*N for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            out[i][j]=m[i*S//N][j*S//N]\n    return out\nnorm={sq:norm(sil[sq]) for sq in squares}\ndef dm(a,b):\n    return sum(1 for i in range(N) for j in range(N) if a[i][j]!=b[i][j])\nreps=[]; lab={}\nfor sq in squares:\n    best=-1; bd=1e9\n    for k,rm in enumerate(reps):\n        dd=dm(norm[sq],rm)\n        if dd<bd: bd=dd; best=k\n    if bd<N*N*0.12: lab[sq]=best\n    else: lab[sq]=len(reps); reps.append(norm[sq])\nprint('clusters',len(reps))\nfor k,rm in enumerate(reps):\n    members=[(files[c]+str(8-r),col[(r,c)]) for (r,c) in squares if lab[(r,c)]==k]\n    print('=== cluster',k,'members:',members)\n    for i in range(N):\n        print(''.join('#' if rm[i][j] else '.' for j in range(N)))\nEOF\npython3 /app/sil2.py\n"]
