[328.144625, "i", "cat > /app/sil.py << 'EOF'\nfrom PIL import Image\nfrom collections import deque\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\nW,H=im.size; px=im.load(); S=W//8\nfiles='abcdefgh'\ndef lum(p): return 0.299*p[0]+0.587*p[1]+0.114*p[2]\ndef bg_of(r,c):\n    xs=[]; x0,y0=c*S,r*S\n    for i in range(S):\n        for (sx,sy) in [(x0+i,y0+2),(x0+i,y0+S-3),(x0+2,y0+i),(x0+S-3,y0+i)]:\n            xs.append(px[sx,sy])\n    xsr=sorted(x[0] for x in xs); xsg=sorted(x[1] for x in xs); xsb=sorted(x[2] for x in xs)\n    n=len(xs)\n    return (xsr[n//2],xsg[n//2],xsb[n//2])\ndef dist(a,b): return sum((a[i]-b[i])**2 for i in range(3))**0.5\n\nsquares=[]\nsil={}\nfor r in range(8):\n    for c in range(8):\n        bg=bg_of(r,c); x0,y0=c*S,r*S\n        # background mask\n        bgmask=[[False]*S for _ in range(S)]\n        for yy in range(S):\n            for xx in range(S):\n                if dist(px[x0+xx,y0+yy],bg)<=45: bgmask[yy][xx]=True\n        # flood fill background from border\n        seen=[[False]*S for _ in range(S)]\n        dq=deque()\n        for i in range(S):\n            for (yy,xx) in [(0,i),(S-1,i),(i,0),(i,S-1)]:\n                if bgmask[yy][xx] and not seen[yy][xx]:\n                    seen[yy][xx]=True; dq.append((yy,xx))\n        while dq:\n            yy,xx=dq.popleft()\n            for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                ny,nx=yy+dy,xx+dx\n                if 0<=ny<S and 0<=nx<S and not seen[ny][nx] and bgmask[ny][nx]:\n                    seen[ny][nx]=True; dq.append((ny,nx))\n        # silhouette = not background-reachable\n        m=[[ (1 if not seen[yy][xx] else 0) for xx in range(S)] for yy in range(S)]\n        ink=sum(sum(row) for row in m)\n        if ink<40: continue\n        squares.append((r,c)); sil[(r,c)]=m\n\nprint('occupied:', [files[c]+str(8-r) for (r,c) in squares])\n\n# downsample to 30x30\nN=30\ndef normalize(m):\n    out=[[0]*N for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            yy=i*S//N; xx=j*S//N\n            out[i][j]=m[yy][xx]\n    return out\n\nnorm={sq:normalize(sil[sq]) for sq in squares}\n\ndef dm(a,b):\n    d=0\n    for i in range(N):\n        for j in range(N):\n            if a[i][j]!=b[i][j]: d+=1\n    return d\n\nreps=[]; lab={}\nfor sq in squares:\n    best=-1; bd=1e9\n    for k,rm in enumerate(reps):\n        dd=dm(norm[sq],rm)\n        if dd<bd: bd=dd; best=k\n    if bd< N*N*0.10:\n        lab[sq]=best\n    else:\n        lab[sq]=len(reps); reps.append(norm[sq])\nprint('clusters',len(reps))\nfor k,rm in enumerate(reps):\n    members=[files[c]+str(8-r) for (r,c) in squares if lab[(r,c)]==k]\n    print('--- cluster',k,'members:',members)\n    for i in range(N):\n        print(''.join('#' if rm[i][j] else '.' for j in range(N)))\nEOF\npython3 /app/sil.py\n"]
[328.145108, "o", "cat > /app/sil.py << 'EOF'"]
