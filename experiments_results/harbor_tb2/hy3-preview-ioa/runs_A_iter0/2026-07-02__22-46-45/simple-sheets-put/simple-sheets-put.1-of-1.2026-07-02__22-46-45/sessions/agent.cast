[13.764002, "o", "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Sheets Clone API\",\"description\":\"\\n    A RESTful API for managing spreadsheets and their data. \\n    Supports creating and managing spreadsheets, sheets, and cell data with features \\n    like pagination and batch operations.\\n    \\n    ## Features\\n    * Create and manage spreadsheets\\n    * Create multiple sheets within a spreadsheet\\n    * Update cell values individually or in batch\\n    * Paginated listing of spreadsheets and sheets\\n    * Cell validation with A1 notation support\\n    \",\"version\":\"1.0.0\"},\"paths\":{\"/docs/json\":{\"get\":{\"summary\":\"Get API documentation in JSON format\",\"description\":\"Returns the API documentation in a structured JSON format.\",\"operationId\":\"get_api_docs_docs_json_get\",\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{}}}}}}},\"/docs/simple\":{\"get\":{\"summary\":\"Get simplified API documentation\",\"description\":\"Returns a simplified version of the API documentation.\",\"operationId\":\"get_simple_docs_d"]
[13.764132, "o", "ocs_simple_get\",\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{}}}}}}},\"/spreadsheets/\":{\"post\":{\"summary\":\"Create a new spreadsheet\",\"description\":\"Creates a new spreadsheet with the given title.\",\"operationId\":\"create_spreadsheet_spreadsheets__post\",\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/SpreadsheetCreate\"}}}},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/Spreadsheet\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}},\"get\":{\"summary\":\"List all spreadsheets\",\"description\":\"Returns a paginated list of all spreadsheets.\",\"operationId\":\"list_spreadsheets_spreadsheets__get\",\"parameters\":[{\"name\":\"page\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"description\":\"Page number, starting from 1\",\"default\":1"]
[13.764808, "o", ",\"title\":\"Page\"},\"description\":\"Page number, starting from 1\"},{\"name\":\"size\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"maximum\":100,\"exclusiveMinimum\":0,\"description\":\"Number of items per page (max 100)\",\"default\":10,\"title\":\"Size\"},\"description\":\"Number of items per page (max 100)\"}],\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/PaginatedSpreadsheets\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/spreadsheets/{spreadsheet_id}\":{\"get\":{\"summary\":\"Get Spreadsheet\",\"operationId\":\"get_spreadsheet_spreadsheets__spreadsheet_id__get\",\"parameters\":[{\"name\":\"spreadsheet_id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\",\"title\":\"Spreadsheet Id\"}}],\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/Spreadsheet\"}}}},\"422\":{\"description\":\"Validati"]
