[17.724519, "o", "\u001b[?2004hroot@073671a31b26:/app# "]
[32.989472, "i", "cd /app && python3 -c \"\nimport csv, re\nfrom datetime import datetime\n\ndef parse_date(s):\n    s=s.strip()\n    for fmt in ('%Y-%m-%d','%m/%d/%Y %H:%M:%S','%m-%d-%Y %H:%M:%S'):\n        try:\n            return datetime.strptime(s, fmt).strftime('%Y-%m-%d')\n        except ValueError:\n            pass\n    return None\n\nhigh={}\nwith open('daily_temp_sf_high.csv') as f:\n    for row in csv.reader(f):\n        if row[0]=='date': continue\n        d=parse_date(row[0]); high[d]=int(row[1])\nlow={}\nwith open('daily_temp_sf_low.csv') as f:\n    for row in csv.reader(f):\n        if row[0]=='date': continue\n        d=parse_date(row[0]); low[d]=int(row[1])\n\ndiffs=[high[d]-low[d] for d in high if d in low]\navg=sum(diffs)/len(diffs)\nwith open('avg_temp.txt','w') as f:\n    f.write(str(avg))\nprint('avg=',avg,'n=',len(diffs))\n\"\n"]
[32.990005, "o", "cd /app && python3 -c \""]
[32.990176, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.991815, "o", "> "]
