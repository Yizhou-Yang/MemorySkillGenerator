[712.120305, "i", "python3 - <<'EOF'\nimport re\nlines = open('/tmp/disasm.txt').read().splitlines()\ndef get(start,end):\n    out=[]; inc=False\n    for l in lines:\n        m=re.match(r'\\s*([0-9a-f]+):',l)\n        if m:\n            a=int(m.group(1),16)\n            if a==start: inc=True\n            if a>end: inc=False\n        if inc: out.append(l)\n    return out\nfor r in [(0x12db,0x14b2),(0x1bf5,0x1f6d),(0x22c9,0x2518)]:\n    print('==== '+hex(r[0]))\n    print('\\n'.join(get(*r)))\nEOF\n"]
