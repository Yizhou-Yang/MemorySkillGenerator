[62.990941, "o", "        env = gym.make(\u001b[33m\"\u001b[39;49;00m\u001b[33mCartPole-v1\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        agent = Agent()\u001b[90m\u001b[39;49;00m\r\n        agent.load(model_dir)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        env.reset(seed=\u001b[94m42\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        rewards = []\u001b[90m\u001b[39;49;00m\r\n"]
[62.990966, "o", "        \u001b[94mfor\u001b[39;49;00m episode \u001b[95min\u001b[39;49;00m \u001b[96mrange\u001b[39;49;00m(num_episodes):\u001b[90m\u001b[39;49;00m\r\n            current_observation, _ = env.reset()\u001b[90m\u001b[39;49;00m\r\n            total_reward = \u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[94mwhile\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                action = agent.select_action(current_observation)\u001b[90m\u001b[39;49;00m\r\n                next_observation, reward, terminated, truncated, _ = env.step(action)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                total_reward += reward\u001b[90m\u001b[39;49;00m\r\n                current_observation = next_observation\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m terminated \u001b[95mor\u001b[39;49;00m truncated:\u001b[90m\u001b[39;49;00m\r\n                    rewards.append(total_reward)\u001b[90m\u001b[39;49;00m\r\n"]
