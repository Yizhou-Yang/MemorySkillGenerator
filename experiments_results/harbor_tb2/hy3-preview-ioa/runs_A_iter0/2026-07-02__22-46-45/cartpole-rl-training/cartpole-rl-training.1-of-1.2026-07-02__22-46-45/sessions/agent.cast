[599.818502, "o", "cat > /app/train.py << 'PYEOF'\r\nimport os, random, math\r\nimport numpy as np\r\nimport torch\r\nimport torch.nn as nn\r\nimport torch.optim as optim\r\nfrom collections import deque\r\nimport gymnasium as gym\r\nfrom agent import Agent, DQN\r\n\r\nSEED = 0\r\nrandom.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\r\n\r\ngamma = 0.99\r\nlr = 5e-4\r\nbatch_size = 128\r\nbuffer_size = 50000\r\nlearning_starts = 500\r\ntrain_freq = 1\r\ntarget_update = 300\r\neps_start = 1.0\r\neps_end = 0.02\r\neps_decay = 3000\r\nmax_episodes = 4000\r\nmax_steps = 500\r\nbest_dir = \"/app/trained_model\"\r\n\r\nenv = gym.make(\"CartPole-v1\")\r\nenv.reset(seed=SEED)\r\n\r\nagent = Agent()\r\noptimizer = optim.Adam(agent.net.parameters(), lr=lr)\r\ntarget_net = DQN().to(agent.device)\r\ntarget_net.load_state_dict(agent.net.state_dict())\r\ntarget_net.eval()\r\n\r\nreplay = deque(maxlen=buffer_size)\r\nsteps_done = 0\r\n\r\ndef select_epsilon_action(obs):\r\n    global steps_done\r\n    eps = eps_end + (eps_start - eps_end) * math.exp(-steps_done / eps_decay)\r\n    steps_done += 1\r\n    if random.r"]
[599.822103, "i", "andom() < eps:\n        return env.action_space.sample()\n    return agent.select_action(obs)\n\ndef optimize():\n    if len(replay) < batch_size:\n        return\n    batch = random.sample(replay, batch_size)\n    obs, acts, rewards, next_obs, dones = zip(*batch)\n    obs = torch.as_tensor(np.array(obs), dtype=torch.float32)\n    acts = torch.as_tensor(acts, dtype=torch.int64).unsqueeze(1)\n    rewards = torch.as_tensor(rewards, dtype=torch.float32).unsqueeze(1)\n    next_obs = torch.as_tensor(np.array(next_obs), dtype=torch.float32)\n    dones = torch.as_tensor(dones, dtype=torch.float32).unsqueeze(1)\n    q_vals = agent.net(obs).gather(1, acts)\n    with torch.no_grad():\n        next_q = target_net(next_obs).max(1)[0].unsqueeze(1)\n        target = rewards + gamma * next_q * (1 - dones)\n    loss = nn.functional.smooth_l1_loss(q_vals, target)\n    optimizer.zero_grad(); loss.backward(); optimizer.step()\n\ndef evaluate(n=30):\n    rs = []\n    for _ in range(n):\n        obs, _ = env.reset()\n        tot = 0\n        for _ in rang"]
[599.822573, "o", "andom() < eps:\r\n        return env.action_space.sample()\r\n    return agent.select_action(obs)\r\n\r\ndef optimize():\r\n    if len(replay) < batch_size:\r\n        return\r\n    batch = random.sample(replay, batch_size)\r\n    obs, acts, rewards, next_obs, dones = zip(*batch)\r\n    obs = torch.as_tensor(np.array(obs), dtype=torch.float32)\r\n    acts = torch.as_tensor(acts, dtype=torch.int64).unsqueeze(1)\r\n    rewards = torch.as_tensor(rewards, dtype=torch.float32).unsqueeze(1)\r\n    next_obs = torch.as_tensor(np.array(next_obs), dtype=torch.float32)\r\n    dones = torch.as_tensor(dones, dtype=torch.float32).unsqueeze(1)\r\n    q_vals = agent.net(obs).gather(1, acts)\r\n    with torch.no_grad():\r\n        next_q = target_net(next_obs).max(1)[0].unsqueeze(1)\r\n        target = rewards + gamma * next_q * (1 - dones)\r\n    loss = nn.functional.smooth_l1_loss(q_vals, target)\r\n    optimizer.zero_grad(); loss.backward(); optimizer.step()\r\n\r\ndef evaluate(n=30):\r\n    rs = []\r\n    for _ in range(n):\r\n        obs, _ = env.reset()\r\n        tot "]
[599.822745, "i", "e(max_steps):\n            a = agent.select_action(obs)\n            obs, r, term, trunc, _ = env.step(a)\n            tot += r\n            if term or trunc: break\n        rs.append(tot)\n    return sum(rs)/len(rs)\n\nbest_avg = -1\nfor ep in range(max_episodes):\n    obs, _ = env.reset()\n    for t in range(max_steps):\n        a = select_epsilon_action(obs)\n        no, r, term, trunc, _ = env.step(a)\n        replay.append((obs, a, r, no, term or trunc))\n        obs = no\n        if steps_done > learning_starts and steps_done % train_freq == 0:\n            optimize()\n        if steps_done > learning_starts and steps_done % target_update == 0:\n            target_net.load_state_dict(agent.net.state_dict())\n        if term or trunc: break\n    if steps_done > learning_starts and ep % 25 == 0:\n        avg = evaluate(30)\n        print(f\"Episode {ep}, steps {steps_done}, eval_avg {avg:.1f}\", flush=True)\n        if avg > best_avg:\n            best_avg = avg\n            agent.save"]
[599.822778, "o", "= 0\r\n        for _ in range(max_steps):\r\n            a = agent.select_action(obs)\r\n            obs, r, term, trunc, _ = env.step(a)\r\n            tot += r\r\n            if term or trunc: break\r\n        rs.append(tot)\r\n    return sum(rs)/len(rs)\r\n\r\nbest_avg = -1\r\nfor ep in range(max_episodes):\r\n    obs, _ = env.reset()\r\n    for t in range(max_steps):\r\n        a = select_epsilon_action(obs)\r\n        no, r, term, trunc, _ = env.step(a)\r\n        replay.append((obs, a, r, no, term or trunc))\r\n        obs = no\r\n        if steps_done > learning_starts and steps_done % train_freq == 0:\r\n            optimize()\r\n        if steps_done > learning_starts and steps_done % target_update == 0:\r\n            target_net.load_state_dict(agent.net.state_dict())\r\n        if term or trunc: break\r\n    if steps_done > learning_starts and ep % 25 == 0:\r\n        avg = evaluate(30)\r\n        print(f\"Episode {ep}, steps {steps_done}, eval_avg {avg:.1f}\", flush=True)\r\n        if avg > best_avg:\r\n            best_avg = avg\r\n            agent."]
