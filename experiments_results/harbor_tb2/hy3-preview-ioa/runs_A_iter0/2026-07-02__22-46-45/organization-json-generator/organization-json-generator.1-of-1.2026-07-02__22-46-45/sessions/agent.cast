[64.291394, "i", "cat > process.py << 'EOF'\nimport csv, json, os\nfrom datetime import datetime, timezone\n\nDATA = \"data\"\n\ndepartments = {}\nwith open(os.path.join(DATA, \"departments.csv\")) as f:\n    for row in csv.DictReader(f):\n        departments[row[\"id\"]] = {\n            \"id\": row[\"id\"],\n            \"name\": row[\"name\"],\n            \"budget\": float(row[\"budget\"]),\n            \"employees\": [],\n            \"projects\": []\n        }\n\nemployees = {}\nwith open(os.path.join(DATA, \"employees.csv\")) as f:\n    for row in csv.DictReader(f):\n        emp = {\n            \"id\": row[\"id\"],\n            \"name\": row[\"name\"],\n            \"position\": row[\"position\"],\n            \"skills\": [s.strip() for s in row[\"skills\"].split(\";\") if s.strip()],\n            \"years_of_service\": int(row[\"years_of_service\"])\n        }\n        employees[row[\"id\"]] = emp\n        departments[row[\"department_id\"]][\"employees\"].append(emp)\n\nwith open(os.path.join(DATA, \"projects.csv\")) as f:\n    for row in csv.DictReader(f):\n        members = [m.strip() for m in row[\"m"]
[64.291961, "i", "ember_ids\"].split(\";\") if m.strip()]\n        proj = {\n            \"name\": row[\"name\"],\n            \"status\": row[\"status\"],\n            \"members\": members,\n            \"deadline\": row[\"deadline\"]\n        }\n        departments[row[\"department_id\"]][\"projects\"].append(proj)\n\norg_departments = [departments[k] for k in departments]\n\norg = {\n    \"name\": \"Acme Corporation\",\n    \"founded\": \"2000-01-01\",\n    \"departments\": org_departments\n}\n\nbudgets = [d[\"budget\"] for d in org_departments]\naverageDepartmentBudget = sum(budgets) / len(budgets)\ntotalEmployees = len(employees)\n\nskillDistribution = {}\nfor e in employees.values():\n    for s in e[\"skills\"]:\n        skillDistribution[s] = skillDistribution.get(s, 0) + 1\n\ndepartmentSizes = {d[\"name\"]: len(d[\"employees\"]) for d in org_departments}\n\nprojectStatusDistribution = {}\nfor d in org_departments:\n    for p in d[\"projects\"]:\n        projectStatusDistribution[p[\"status\"]] = projectStatusDistribution.get(p[\"status\"], 0) + 1\n\ntotal_years = sum(e[\"years_of_service\"] for e "]
[64.292267, "i", "in employees.values())\naverageYearsOfService = total_years / totalEmployees\n\nstats = {\n    \"averageDepartmentBudget\": averageDepartmentBudget,\n    \"totalEmployees\": totalEmployees,\n    \"skillDistribution\": skillDistribution,\n    \"departmentSizes\": departmentSizes,\n    \"projectStatusDistribution\": projectStatusDistribution,\n    \"averageYearsOfService\": averageYearsOfService\n}\n\noutput = {\n    \"metadata\": {\n        \"version\": \"1.0\",\n        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n        \"generator\": \"csv-to-json-processor\"\n    },\n    \"organization\": org,\n    \"statistics\": stats\n}\n\nwith open(\"organization.json\", \"w\") as f:\n    json.dump(output, f, indent=2)\nprint(\"wrote organization.json\")\nEOF\n"]
