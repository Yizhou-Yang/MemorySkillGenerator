[64.350966, "o", "averageYearsOfService = total_years / totalEmployees\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> stats = {\r\n\u001b[?2004l\r\u001b[?2004h>     \"averageDepartmentBudget\": averageDepartmentBudget,\r\n\u001b[?2004l\r\u001b[?2004h>     \"totalEmployees\": totalEmployees,\r\n\u001b[?2004l\r\u001b[?2004h>     \"skillDistribution\": skillDistribution,\r\n\u001b[?2004l\r\u001b[?2004h>     \"departmentSizes\": departmentSizes,\r\n\u001b[?2004l\r\u001b[?2004h>     \"projectStatusDistribution\": projectStatusDistribution,\r\n\u001b[?2004l\r\u001b[?2004h>     \"averageYearsOfService\": averageYearsOfService\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.351094, "o", "    \"metadata\": {\r\n\u001b[?2004l\r\u001b[?2004h>         \"version\": \"1.0\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.356323, "o", "        \"timestamp\": datetime.now(timezone.utc).isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h>         \"generator\": \"csv-to-json-processor\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.356385, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[64.356651, "o", "    \"organization\": org,\r\n\u001b[?2004l\r"]
[64.356716, "o", "\u001b[?2004h> "]
[64.356771, "o", "    \"statistics\": stats\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.356794, "o", "> }"]
[64.356855, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[64.356876, "o", "\u001b[?2004h> "]
[64.35948, "o", "with open(\"organization.json\", \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(output, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"wrote organization.json\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
