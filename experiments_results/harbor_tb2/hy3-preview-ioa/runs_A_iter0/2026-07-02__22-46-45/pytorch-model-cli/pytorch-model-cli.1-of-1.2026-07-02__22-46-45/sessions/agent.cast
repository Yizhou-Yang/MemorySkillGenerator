[123.122634, "i", "cat > /app/convert.py << 'PYEOF'\nimport pickle, io, zipfile, array, json\n\nARCHIVE = '/app/model.pth'\nzf = zipfile.ZipFile(ARCHIVE)\n\ndef read_storage(key):\n    for cand in ['simple_mnist/' + key, 'simple_mnist/data/' + key]:\n        try:\n            return zf.read(cand)\n        except KeyError:\n            pass\n    raise KeyError('no storage for %r' % key)\n\nclass Unpickler(pickle.Unpickler):\n    def find_class(self, module, name):\n        if module == 'collections' and name == 'OrderedDict':\n            return dict\n        if module == 'torch._utils' and name == '_rebuild_tensor_v2':\n            def rebuild(storage, offset, size, stride, requires_grad, backward_hooks, metadata=None):\n                n = 1\n                for s in size:\n                    n *= s\n                sub = list(storage[offset:offset+n])\n                return {'size': list(size), 'stride': list(stride), 'data': sub}\n            return rebuild\n        return name\n    def persistent_load(self, pid):\n        if isinstance(pid, tuple) a"]
[123.122713, "i", "nd len(pid) >= 5 and pid[0] == 'storage':\n            _, storage_cls, key, location, numel = pid[:5]\n            b = read_storage(key)\n            arr = array.array('f')\n            arr.frombytes(b)\n            if len(arr) != numel:\n                raise ValueError('numel mismatch %d vs %d for %s' % (len(arr), numel, key))\n            return arr\n        raise ValueError('unexpected persistent id: %r' % (pid,))\n\ndata = zf.read('simple_mnist/data.pkl')\nsd = Unpickler(io.BytesIO(data)).load()\n\nout = {}\nfor k, v in sd.items():\n    print(k, v['size'])\n    out[k] = {'size': v['size'], 'data': v['data']}\n\nwith open('/app/weights.json', 'w') as f:\n    json.dump(out, f)\nprint('wrote weights.json')\nPYEOF\n"]
