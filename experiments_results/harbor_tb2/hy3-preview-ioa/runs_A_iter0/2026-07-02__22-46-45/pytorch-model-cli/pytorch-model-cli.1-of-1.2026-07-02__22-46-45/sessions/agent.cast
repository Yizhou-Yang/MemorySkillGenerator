[217.308815, "i", "cat > /app/test_pp.py << 'PYEOF'\nimport json, struct, zlib\n\nwith open('/app/weights.json') as f:\n    Wraw = json.load(f)\n\n# reshape flat data to 2D list [out][inp]\ndef to2d(k):\n    t=Wraw[k]; s=t['size']; d=t['data']\n    rows=[]; off=0\n    for i in range(s[0]):\n        rows.append(d[off:off+s[1]]); off+=s[1]\n    return rows\n\nW={k:to2d(k) for k in Wraw}\n\ndef load_png(path):\n    with open(path,'rb') as f:\n        data=f.read()\n    pos=8; w=h=None\n    idat=b''\n    while pos < len(data):\n        ln=struct.unpack('>I', data[pos:pos+4])[0]\n        typ=data[pos+4:pos+8]; chunk=data[pos+8:pos+8+ln]\n        if typ==b'IHDR':\n            w,h,bd,ct=struct.unpack('>IIBB', chunk[:10])\n        elif typ==b'IDAT':\n            idat+=chunk\n        elif typ==b'IEND':\n            break\n        pos+=12+ln\n    raw=zlib.decompress(idat)\n    p=0; rows=[]\n    for y in range(h):\n        p+=1; rows.append(list(raw[p:p+w])); p+=w\n    return w,h,rows\n\nw,h,rows=load_png('/app/image.png')\nprin"]
[217.309004, "i", "t('img',w,h)\npix=[rows[y][x] for y in range(h) for x in range(w)]\n\ndef matvec(Wm,b,x):\n    n=len(b); m=len(Wm[0])\n    return [sum(Wm[i][j]*x[j] for j in range(m))+b[i] for i in range(n)]\n\ndef relu(v):\n    return [max(0.0,vv) for vv in v]\n\ndef predict(x):\n    h1=relu(matvec(W['input_layer.weight'],W['input_layer.bias'],x))\n    h2=relu(matvec(W['hidden_layer.weight'],W['hidden_layer.bias'],h1))\n    o=matvec(W['output_layer.weight'],W['output_layer.bias'],h2)\n    return max(range(len(o)), key=lambda i:o[i]), o\n\nxa=[p/255.0 for p in pix]\nprint('A /255 digit', predict(xa)[0])\nxb=[(p/255.0-0.1307)/0.3081 for p in pix]\nprint('B norm  digit', predict(xb)[0])\nPYEOF\n"]
