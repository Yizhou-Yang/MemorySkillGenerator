[623.103098, "i", "cat > /app/cli_tool.c << 'CEOF'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include \"cJSON.h\"\n#include \"lodepng.h\"\n\nstatic char* read_file(const char* path){\n    FILE* f = fopen(path, \"rb\");\n    if(!f){ fprintf(stderr, \"cannot open %s\\n\", path); exit(1); }\n    fseek(f, 0, SEEK_END);\n    long n = ftell(f);\n    fseek(f, 0, SEEK_SET);\n    char* buf = (char*)malloc(n + 1);\n    if(fread(buf, 1, n, f) != (size_t)n){ fprintf(stderr, \"read error\\n\"); exit(1); }\n    buf[n] = 0;\n    fclose(f);\n    return buf;\n}\n\nstatic double* get_tensor(cJSON* root, const char* key, int* rows, int* cols){\n    cJSON* obj = cJSON_GetObjectItem(root, key);\n    if(!obj){ fprintf(stderr, \"missing tensor %s\\n\", key); exit(1); }\n    cJSON* size = cJSON_GetObjectItem(obj, \"size\");\n    cJSON* data = cJSON_GetObjectItem(obj, \"data\");\n    int d0 = cJSON_GetArrayItem(size, 0)->valueint;\n    int d1 = (cJSON_GetArraySize(size) > 1) ? cJSON_GetArrayItem(size, 1)->value"]
