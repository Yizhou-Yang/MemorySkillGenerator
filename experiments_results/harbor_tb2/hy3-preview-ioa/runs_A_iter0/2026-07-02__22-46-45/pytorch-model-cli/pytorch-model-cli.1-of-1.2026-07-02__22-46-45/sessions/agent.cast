[623.24581, "o", "\u001b[?2004l\r\u001b[?2004h>     if(!obj){ fprintf(stderr, \"missing tensor %s\\n\", key); exit(1); }\r\n\u001b[?2004l\r\u001b[?2004h>     cJSON* size = cJSON_GetObjectItem(obj, \"size\");\r\n\u001b[?2004l\r\u001b[?2004h>     cJSON* data = cJSON_GetObjectItem(obj, \"data\");\r\n\u001b[?2004l\r\u001b[?2004h>     int d0 = cJSON_GetArrayItem(size, 0)->valueint;\r\n\u001b[?2004l\r\u001b[?2004h>     int d1 = (cJSON_GetArraySize(size) > 1) ? cJSON_GetArrayItem(size, 1)->valueint : 1;\r\n\u001b[?2004l\r\u001b[?2004h>     int total = cJSON_GetArraySize(data);\r\n\u001b[?2004l\r\u001b[?2004h>     double* arr = (double*)malloc(sizeof(double) * total);\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i = 0; i < total; i++) arr[i] = cJSON_GetArrayItem(data, i)->valuedouble;\r\n\u001b[?2004l\r\u001b[?2004h>     *rows = d0; *cols = d1;\r\n\u001b[?2004l\r\u001b[?2004h>     return arr;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static void matvec(double* W, double* b, double* x, int rows, int cols, double* out){\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i = 0; i < rows; i++){\r\n\u001b[?2004l\r\u001b[?2004h>         double s = b[i];\r\n\u001b[?2004l\r\u001b[?2004h>         co"]
[623.262288, "o", "nst double* wr = W + (size_t)i * cols;\r\n\u001b[?2004l\r\u001b[?2004h>         for(int j = 0; j < cols; j++) s += wr[j] * x[j];\r\n\u001b[?2004l\r\u001b[?2004h>         out[i] = s;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static void relu(double* v, int n){\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i = 0; i < n; i++) if(v[i] < 0) v[i] = 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main(int argc, char** argv){\r\n\u001b[?2004l\r\u001b[?2004h>     if(argc < 3){\r\n\u001b[?2004l\r\u001b[?2004h> "]
