[555.218921, "i", "cat > /app/test_pp.py << 'PYEOF'\nimport json, struct, zlib\n\nwith open('/app/weights.json') as f:\n    Wraw = json.load(f)\n\ndef to2d(k):\n    t=Wraw[k]; s=t['size']; d=t['data']\n    rows=[]; off=0\n    for i in range(s[0]):\n        rows.append(d[off:off+s[1]]); off+=s[1]\n    return rows\n\ndef flat(k):\n    return Wraw[k]['data']\n\nW2={k:to2d(k) for k in Wraw if len(Wraw[k]['size'])==2}\nB={k:flat(k) for k in Wraw if len(Wraw[k]['size'])==1}\n\ndef load_png(path):\n    with open(path,'rb') as f:\n        data=f.read()\n    pos=8; w=h=None; idat=b''\n    while pos < len(data):\n        ln=struct.unpack('>I', data[pos:pos+4])[0]\n        typ=data[pos+4:pos+8]; chunk=data[pos+8:pos+8+ln]\n        if typ==b'IHDR':\n            w,h,bd,ct=struct.unpack('>IIBB', chunk[:10])\n        elif typ==b'IDAT':\n            idat+=chunk\n        elif typ==b'IEND':\n            break\n        pos+=12+ln\n    raw=zlib.decompress(idat)\n    p=0; rows=[]\n    for y in range(h):\n        p+=1; rows.append(list(raw[p:p+w])); p+=w\n    return w,h,rows\n\nw,h,rows="]
[555.218991, "i", "load_png('/app/image.png')\nprint('img',w,h)\npix=[rows[y][x] for y in range(h) for x in range(w)]\n\ndef matvec(Wm,b,x):\n    n=len(b); m=len(Wm[0])\n    return [sum(Wm[i][j]*x[j] for j in range(m))+b[i] for i in range(n)]\n\ndef relu(v):\n    return [max(0.0,vv) for vv in v]\n\ndef predict(x):\n    h1=relu(matvec(W2['input_layer.weight'],B['input_layer.bias'],x))\n    h2=relu(matvec(W2['hidden_layer.weight'],B['hidden_layer.bias'],h1))\n    o=matvec(W2['output_layer.weight'],B['output_layer.bias'],h2)\n    return max(range(len(o)), key=lambda i:o[i])\n\nxa=[p/255.0 for p in pix]\nprint('A /255 digit', predict(xa))\nxb=[(p/255.0-0.1307)/0.3081 for p in pix]\nprint('B norm  digit', predict(xb))\nPYEOF\n"]
