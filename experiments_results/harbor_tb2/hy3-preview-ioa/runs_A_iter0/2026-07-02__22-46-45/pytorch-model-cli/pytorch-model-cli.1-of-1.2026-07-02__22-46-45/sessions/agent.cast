[623.344784, "o", "\u001b[?2004h>     double* out = (double*)malloc(sizeof(double) * r3);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     matvec(W1, b1, x, r1, c1, h1); relu(h1, r1);\r\n\u001b[?2004l\r\u001b[?2004h>     matvec(W2, b2, h1, r2, c2, h2); relu(h2, r2);\r\n\u001b[?2004l\r\u001b[?2004h>     matvec(W3, b3, h2, r3, c3, out);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int best = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i = 1; i < r3; i++) if(out[i] > out[best]) best = i;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"%d\\n\", best);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     FILE* pf = fopen(\"prediction.txt\", \"w\");\r\n\u001b[?2004l\r\u001b[?2004h>     if(pf){ fprintf(pf, \"%d\\n\", best); fclose(pf); }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     free(png);\r\n\u001b[?2004l\r\u001b[?2004h>     cJSON_Delete(root);\r\n\u001b[?2004l\r\u001b[?2004h>     free(json_text);\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> CEOF\r\n\u001b[?2004l\r"]
