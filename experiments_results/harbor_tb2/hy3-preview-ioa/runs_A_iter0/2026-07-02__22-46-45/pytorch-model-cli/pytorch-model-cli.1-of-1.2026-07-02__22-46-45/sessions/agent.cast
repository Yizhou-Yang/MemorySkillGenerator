[623.303278, "o", "    if(error){ fprintf(stderr, \"png decode error %u\\n\", error); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int N = (int)w * (int)h;\r\n\u001b[?2004l\r\u001b[?2004h>     double* x = (double*)malloc(sizeof(double) * N);\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i = 0; i < N; i++){\r\n\u001b[?2004l\r\u001b[?2004h>         unsigned char pixel = png[i * 4 + 0];\r\n\u001b[?2004l\r\u001b[?2004h>         x[i] = ((double)pixel / 255.0 - 0.1307) / 0.3081;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     double* h1 = (double*)malloc(sizeof(double) * r1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
