[623.109598, "i", "int : 1;\n    int total = cJSON_GetArraySize(data);\n    double* arr = (double*)malloc(sizeof(double) * total);\n    for(int i = 0; i < total; i++) arr[i] = cJSON_GetArrayItem(data, i)->valuedouble;\n    *rows = d0; *cols = d1;\n    return arr;\n}\n\nstatic void matvec(double* W, double* b, double* x, int rows, int cols, double* out){\n    for(int i = 0; i < rows; i++){\n        double s = b[i];\n        const double* wr = W + (size_t)i * cols;\n        for(int j = 0; j < cols; j++) s += wr[j] * x[j];\n        out[i] = s;\n    }\n}\n\nstatic void relu(double* v, int n){\n    for(int i = 0; i < n; i++) if(v[i] < 0) v[i] = 0;\n}\n\nint main(int argc, char** argv){\n    if(argc < 3){\n        fprintf(stderr, \"usage: %s weights.json image.png\\n\", argv[0]);\n        return 1;\n    }\n    const char* weights_path = argv[1];\n    const char* image_path = argv[2];\n\n    char* json_text = read_file(weights_path);\n    cJSON* root = cJSON_Parse(json_text);\n    if(!root){ fprintf(stderr, \"JSON parse error\\n\"); return 1; }\n\n    int r1,c1,r2,c2,r3,c3"]
[623.10977, "i", ",rb1,rb2,rb3;\n    double* W1 = get_tensor(root, \"input_layer.weight\", &r1, &c1);\n    double* b1 = get_tensor(root, \"input_layer.bias\", &rb1, &c2);\n    double* W2 = get_tensor(root, \"hidden_layer.weight\", &r2, &c2);\n    double* b2 = get_tensor(root, \"hidden_layer.bias\", &rb2, &c2);\n    double* W3 = get_tensor(root, \"output_layer.weight\", &r3, &c3);\n    double* b3 = get_tensor(root, \"output_layer.bias\", &rb3, &c3);\n\n    unsigned char* png = NULL;\n    unsigned w = 0, h = 0;\n    unsigned error = lodepng_decode32_file(&png, &w, &h, image_path);\n    if(error){ fprintf(stderr, \"png decode error %u\\n\", error); return 1; }\n\n    int N = (int)w * (int)h;\n    double* x = (double*)malloc(sizeof(double) * N);\n    for(int i = 0; i < N; i++){\n        unsigned char pixel = png[i * 4 + 0];\n        x[i] = ((double)pixel / 255.0 - 0.1307) / 0.3081;\n    }\n\n    double* h1 = (double*)malloc(sizeof(double) * r1);\n    double* h2 = (double*)malloc(sizeof(double) * r2);\n    double* out = "]
[623.110336, "i", "(double*)malloc(sizeof(double) * r3);\n\n    matvec(W1, b1, x, r1, c1, h1); relu(h1, r1);\n    matvec(W2, b2, h1, r2, c2, h2); relu(h2, r2);\n    matvec(W3, b3, h2, r3, c3, out);\n\n    int best = 0;\n    for(int i = 1; i < r3; i++) if(out[i] > out[best]) best = i;\n\n    printf(\"%d\\n\", best);\n\n    FILE* pf = fopen(\"prediction.txt\", \"w\");\n    if(pf){ fprintf(pf, \"%d\\n\", best); fclose(pf); }\n\n    free(png);\n    cJSON_Delete(root);\n    free(json_text);\n    return 0;\n}\nCEOF\n"]
