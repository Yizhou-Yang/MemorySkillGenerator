[38.161277, "o", "\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:35: AssertionError\r\n"]
[38.161526, "o", "\u001b[31m\u001b[1m___________________________________________________________________ test_sentiment_endpoint ____________________________________________________________________\u001b[0m\r\n"]
[38.161588, "o", "\r\n"]
[38.162672, "o", "self = <HTTPConnection(host='localhost', port=5000) at 0x7f534b0cb230>\r\n"]
[38.162874, "o", "\r\n"]
[38.164397, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_new_conn\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m) -> socket.socket:\u001b[90m\u001b[39;49;00m"]
[38.164552, "o", "\r\n"]
[38.164618, "o", "    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Establish a socket connection and set nodelay settings on it.\u001b[39;49;00m"]
[38.16474, "o", "\r\n"]
[38.16532, "o", "    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    :return: New socket connection.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n>           sock = connection.create_connection(\u001b[90m\u001b[39;49;00m\r\n                (\u001b[96mself\u001b[39;49;00m._dns_host, \u001b[96mself\u001b[39;49;00m.port),\u001b[90m\u001b[39;49;00m\r\n                \u001b[96mself\u001b[39;49;00m.timeout,\u001b[90m\u001b[39;49;00m\r\n                source_address=\u001b[96mself\u001b[39;49;00m.source_address,\u001b[90m\u001b[39;49;00m\r\n                socket_options=\u001b[96mself\u001b[39;49;00m.socket_options,\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n\r\n\u001b[1m\u001b[31m/usr/local/lib/python3.13/site-packages/urllib3/connection.py\u001b[0m:204: \r\n"]
[38.165395, "o", "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ "]
[38.165526, "o", "\r\n"]
[38.16568, "o", "\u001b[1m\u001b[31m/usr/local/lib/python3.13/site-packages/urllib3/util/connection.py\u001b[0m:85: in create_connection"]
[38.165805, "o", "\r\n"]
[38.166235, "o", "    \u001b[0m\u001b[94mraise\u001b[39;49;00m err\u001b[90m\u001b[39;49;00m"]
[38.166306, "o", "\r\n"]
[38.166571, "o", "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ "]
[38.166633, "o", "\r\n"]
[38.166691, "o", "\r\n"]
[38.166846, "o", "address = ('localhost', 5000), timeout = None, source_address = None, socket_options = [(6, 1, 1)]"]
[38.166887, "o", "\r\n"]
[38.166943, "o", "\r\n"]
[38.172646, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mcreate_connection\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\r\n        address: \u001b[96mtuple\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m, \u001b[96mint\u001b[39;49;00m],\u001b[90m\u001b[39;49;00m"]
[38.17281, "o", "\r\n        timeout: _TYPE_TIMEOUT = _DEFAULT_TIMEOUT,\u001b[90m\u001b[39;49;00m\r\n"]
[38.172934, "o", "        source_address: \u001b[96mtuple\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m, \u001b[96mint\u001b[39;49;00m] | \u001b[94mNone\u001b[39;49;00m = \u001b[94mNone\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        socket_options: _TYPE_SOCKET_OPTIONS | \u001b[94mNone\u001b[39;49;00m = \u001b[94mNone\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[38.173011, "o", "\r\n"]
[38.173131, "o", "    ) -> socket.socket:\u001b[90m\u001b[39;49;00m\r\n"]
[38.173306, "o", "    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Connect to *address* and return the socket object.\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n"]
[38.173339, "o", "    \u001b[33m    Convenience function.  Connect to *address* (a 2-tuple ``(host,\u001b[39;49;00m\r\n    \u001b[33m    port)``) and return the socket object.  Passing the optional\u001b[39;49;00m\r\n    \u001b[33m    *timeout* parameter will set the timeout on the socket instance\u001b[39;49;00m\r\n"]
[38.173416, "o", "    \u001b[33m    before attempting to connect.  If no *timeout* is supplied, the\u001b[39;49;00m\r\n    \u001b[33m    global default timeout setting returned by :func:`socket.getdefaulttimeout`\u001b[39;49;00m\r\n    \u001b[33m    is used.  If *source_address* is set it must be a tuple of (host, port)\u001b[39;49;00m\r\n"]
[38.173452, "o", "    \u001b[33m    for the socket to bind as a source address before making the connection.\u001b[39;49;00m\r\n    \u001b[33m    An host of '' or port 0 tells the OS to use the default.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[38.173461, "o", "    \u001b[90m\u001b[39;49;00m\r\n"]
[38.173658, "o", "        host, port = address\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m host.startswith(\u001b[33m\"\u001b[39;49;00m\u001b[33m[\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n            host = host.strip(\u001b[33m\"\u001b[39;49;00m\u001b[33m[]\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        err = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Using the value from allowed_gai_family() in the context of getaddrinfo lets\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# us select whether to work with IPv4 DNS records, IPv6 records, or both.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# The original create_connection function always returns all records.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        family = allowed_gai_family()\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            host.encode(\u001b[33m\"\u001b[39;49;00m\u001b[33midna\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n"]
[38.173688, "o", "        \u001b[94mexcept\u001b[39;49;00m \u001b[96mUnicodeError\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n"]
[38.173763, "o", "            \u001b[94mraise\u001b[39;49;00m LocationParseError(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mhost\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m, label empty or too long\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mfrom\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n"]
[38.173811, "o", "        \u001b[94mfor\u001b[39;49;00m res \u001b[95min\u001b[39;49;00m socket.getaddrinfo(host, port, family, socket.SOCK_STREAM):\u001b[90m\u001b[39;49;00m\r\n            af, socktype, proto, canonname, sa = res\u001b[90m\u001b[39;49;00m\r\n            sock = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                sock = socket.socket(af, socktype, proto)\u001b[90m\u001b[39;49;00m\r\n"]
[38.173828, "o", "    \u001b[90m\u001b[39;49;00m\r\n                \u001b[90m# If provided, set socket level options before connecting.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[38.17394, "o", "                _set_socket_options(sock, socket_options)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m timeout \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m _DEFAULT_TIMEOUT:\u001b[90m\u001b[39;49;00m\r\n                    sock.settimeout(timeout)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m source_address:\u001b[90m\u001b[39;49;00m\r\n"]
[38.17398, "o", "                    sock.bind(source_address)\u001b[90m\u001b[39;49;00m\r\n>               sock.connect(sa)\u001b[90m\u001b[39;49;00m\r\n"]
[38.174051, "o", "\u001b[1m\u001b[31mE               ConnectionRefusedError: [Errno 111] Connection refused\u001b[0m\r\n\r\n"]
