[38.174091, "o", "\r\n"]
[38.174353, "o", "\u001b[33mThe above exception was the direct cause of the following exception:\u001b[0m\r\n\r\nself = <urllib3.connectionpool.HTTPConnectionPool object at 0x7f534b0cae40>, method = 'POST', url = '/sentiment'\r\nbody = b'{\"text\": \"I really enjoyed this movie, it was amazing!\"}'\r\nheaders = {'User-Agent': 'python-requests/2.34.2', 'Accept-Encoding': 'gzip, deflate', 'Accept': '*/*', 'Connection': 'keep-alive', 'Content-Length': '56', 'Content-Type': 'application/json'}\r\n"]
[38.174476, "o", "retries = Retry(total=0, connect=None, read=False, redirect=None, status=None), redirect = False, assert_same_host = False\r\n"]
[38.174566, "o", "timeout = Timeout(connect=None, read=None, total=None), pool_timeout = None, release_conn = False, chunked = False, body_pos = None, preload_content = False\r\n"]
