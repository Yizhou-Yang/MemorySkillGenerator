[40.602046, "i", "cat > /app/check_cert.py << 'PYEOF'\n#!/usr/bin/env python3\nimport ssl\nimport subprocess\nimport os\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\ndef main():\n    if not os.path.exists(CERT_PATH):\n        print(f\"Certificate not found at {CERT_PATH}\")\n        return\n\n    with open(CERT_PATH) as f:\n        cert_data = f.read()\n\n    # Load/verify the certificate can be parsed via the ssl module\n    der = ssl.PEM_cert_to_DER_cert(cert_data)\n\n    result = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\", \"-enddate\"],\n        capture_output=True, text=True,\n    )\n    if result.returncode != 0:\n        print(\"Failed to load certificate\")\n        return\n\n    subject = \"\"\n    enddate = \"\"\n    for line in result.stdout.splitlines():\n        line = line.strip()\n        if line.startswith(\"subject=\"):\n            subject = line[len(\"subject=\"):].strip()\n        elif line.startswith(\"notAfter=\"):\n            enddate = line["]
[40.602525, "o", "cat > /app/check_cert.py << 'PYEOF'"]
[40.611762, "o", "\r\n\u001b[?2004l\r"]
[40.611904, "o", "\u001b[?2004h"]
[40.616883, "o", "> "]
[40.617324, "o", "#!/usr/bin/env python3"]
[40.61748, "i", "len(\"notAfter=\"):].strip()\n\n    cn = \"Unknown\"\n    for part in subject.split(\",\"):\n        part = part.strip()\n        if part.startswith(\"CN\"):\n            cn = part.split(\"=\", 1)[1].strip()\n\n    # Convert expiration date to YYYY-MM-DD (drop timezone token)\n    dt = datetime.strptime(enddate.rsplit(\" \", 1)[0], \"%b %d %H:%M:%S %Y\")\n    expiration = dt.strftime(\"%Y-%m-%d\")\n\n    print(f\"Common Name: {cn}\")\n    print(f\"Expiration date: {expiration}\")\n    print(\"Certificate verification successful\")\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
