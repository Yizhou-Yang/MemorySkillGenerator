[403.412694, "i", "cat > /app/count.py << 'EOF'\nimport sys, os\nfrom collections import Counter\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\n\ntok = AutoTokenizer.from_pretrained(\"Qwen/Qwen2.5-1.5B-Instruct\")\n\nds = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\", streaming=True)\n\ndomains = Counter()\nbatch = []\ntotal = 0\nscience = 0\nn = 0\nfor ex in ds:\n    d = ex.get('domain')\n    domains[d] += 1\n    if d == 'science':\n        science += 1\n        r = ex.get('deepseek_reasoning') or ''\n        s = ex.get('deepseek_solution') or ''\n        if r: batch.append(r)\n        if s: batch.append(s)\n        if len(batch) >= 2000:\n            enc = tok(batch, add_special_tokens=False)['input_ids']\n            for ids in enc:\n                total += len(ids)\n            batch = []\n    n += 1\n    if n % 20000 == 0:\n        print(\"progress\", n, \"domains\", dict(domains), flush=True)\n\nif batch:\n    enc = tok(batch, add_special_tokens=False)['input_ids']\n    for ids in enc:\n        total += le"]
[403.413262, "o", "cat > /app/count.py << 'EOF'"]
[403.413325, "i", "n(ids)\n\nwith open('/app/result.txt','w') as f:\n    f.write(str(total))\nprint(\"domains:\", dict(domains))\nprint(\"science_examples:\", science)\nprint(\"TOTAL_DEEPSEEK_TOKENS_SCIENCE:\", total)\nsys.stdout.flush()\nos._exit(0)\nEOF\necho written\n"]
