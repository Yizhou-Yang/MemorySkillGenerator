[281.621596, "i", "cat > /app/explore.py << 'EOF'\nfrom datasets import load_dataset\n\nds = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\", streaming=True)\nfrom collections import Counter\ndomains = Counter()\nsample = None\nn = 0\nfor ex in ds:\n    domains[ex['domain']] += 1\n    if sample is None:\n        sample = ex\n    n += 1\n    if n >= 2000:\n        break\nprint(\"domains (first 2000):\", domains)\nif sample:\n    print(\"keys:\", list(sample.keys()))\n    print(\"deepseek_reasoning[:200]:\", repr(sample['deepseek_reasoning'][:200]))\n    print(\"deepseek_solution[:200]:\", repr(sample['deepseek_solution'][:200]))\nEOF\npython3 /app/explore.py\n"]
[281.622149, "o", "cat > /app/explore.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from datasets import load_dataset\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ds = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\", streaming=True)\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> domains = Counter()\r\n\u001b[?2004l\r\u001b[?2004h> sample = None\r\n\u001b[?2004l\r\u001b[?2004h> n = 0\r\n\u001b[?2004l\r\u001b[?2004h> for ex in ds:\r\n\u001b[?2004l\r\u001b[?2004h>     domains[ex['domain']] += 1\r\n\u001b[?2004l\r\u001b[?2004h>     if sample is None:\r\n\u001b[?2004l\r\u001b[?2004h>         sample = ex\r\n\u001b[?2004l\r\u001b[?2004h>     n += 1\r\n\u001b[?2004l\r\u001b[?2004h>     if n >= 2000:\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> print(\"domains (first 2000):\", domains)\r\n\u001b[?2004l\r\u001b[?2004h> if sample:\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"keys:\", list(sample.keys()))\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"deepseek_reasoning[:200]:\", repr(sample['deepseek_reasoning'][:200]))\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"deepseek_solution[:200]:\", repr(sample['deepseek_solution'][:200]))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?"]
