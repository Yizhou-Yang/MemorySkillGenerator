[47.300247, "i", "cat > /app/check_cert.py << 'PYEOF'\n#!/usr/bin/env python3\nimport ssl\nimport subprocess\nimport os\nimport sys\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\n\ndef main():\n    if not os.path.exists(CERT_PATH):\n        print(f\"Certificate not found at {CERT_PATH}\")\n        sys.exit(1)\n\n    result = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\", \"-dates\"],\n        capture_output=True, text=True,\n    )\n    if result.returncode != 0 or not result.stdout.strip():\n        print(\"Failed to load certificate\")\n        sys.exit(1)\n\n    cn = None\n    exp_date = None\n    for line in result.stdout.splitlines():\n        if line.startswith(\"subject\") and \"CN=\" in line:\n            cn = line.split(\"CN=\")[1].strip().rstrip(\",\")\n        if line.startswith(\"notAfter\"):\n            date_str = line.split(\"=\", 1)[1].strip()\n            parts = date_str.rsplit(None, 1)\n            if len(parts) == 2 and parts[1] in (\"GMT\", \"UTC\"):\n "]
