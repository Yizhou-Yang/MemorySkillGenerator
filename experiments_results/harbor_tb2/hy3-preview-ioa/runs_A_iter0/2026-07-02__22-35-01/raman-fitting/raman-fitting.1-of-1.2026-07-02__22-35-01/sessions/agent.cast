[340.217227, "i", "cat > /app/peaks.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nfrom scipy.signal import find_peaks\nx=[]; y=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            x.append(float(p[0])); y.append(float(p[1]))\nx=np.array(x); y=np.array(y)\nidx=np.argsort(x); x=x[idx]; y=y[idx]\npeaks, props = find_peaks(y, prominence=2000, distance=30)\ncand = x[peaks]\nprint('candidates x:', cand)\n\ndef lor(x,x0,gamma,amp):\n    return amp*gamma**2/((x-x0)**2+gamma**2)\n\nfor cx in cand:\n    i = np.argmin(np.abs(x-cx))\n    lo = max(0,i-400); hi = min(len(x),i+400)\n    xs=x[lo:hi]; ys=y[lo:hi]\n    # local baseline from outer 20%\n    nb=max(20,len(xs)//10)\n    bx=np.concatenate([xs[:nb],xs[-nb:]]); by=np.concatenate([ys[:nb],ys[-nb:]])\n    b=np.polyfit(bx,by,1)\n    ys_b = ys - np.polyval(b,xs)\n    mask = ys_b>0\n    try:\n        p0=[xs[np.argmax(ys_b)], 50, ys_b.max()]\n        popt,_=curve_fit(lor,xs[mask],ys_b[mask],p0=p0,maxfev=10000)\n   "]
[340.217422, "o", "cat > /app/peaks.py << 'EOF'"]
[340.217502, "i", "     print('x0=%.1f gamma=%.1f amp=%.1f base=%.1f+%.3f*x'%(popt[0],popt[1],popt[2],b[1],b[0]))\n    except Exception as e:\n        print('fit fail at',cx,e)\nEOF\npython3 /app/peaks.py\n"]
