[160.840608, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\n\nx=[]; y=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.replace(',','.').split()\n        if len(line)>=2:\n            x.append(float(line[0])); y.append(float(line[1]))\nx=np.array(x); y=np.array(y)\nprint('n', len(x))\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\n# is x monotonic?\nprint('x monotonic decreasing?', np.all(np.diff(x)<0))\n# find local maxima\nfrom scipy.signal import argrelmax\ndy=np.diff(y)\n# peaks\nmx, = argrelmax(y, order=20)\nfor i in mx:\n    print('peak x=%.1f y=%.1f'%(x[i], y[i]))\nEOF\npython3 /app/explore.py\n"]
[160.840847, "o", "cat > /app/explore.py << 'EOF'"]
