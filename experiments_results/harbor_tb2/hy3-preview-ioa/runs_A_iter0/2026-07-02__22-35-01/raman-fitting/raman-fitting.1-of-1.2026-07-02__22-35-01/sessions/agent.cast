[602.270348, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nx=[]; y=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            x.append(float(p[0])); y.append(float(p[1]))\nx=np.array(x); y=np.array(y)\nidx=np.argsort(x); x=x[idx]; y=y[idx]\n\ndef L(x,x0,g,a): return a*g**2/((x-x0)**2+g**2)\n\ndef fit(cx,dx,model,npar):\n    m=(x>cx-dx)&(x<cx+dx); xs=x[m]; ys=y[m]\n    if model=='const':\n        f=lambda x,x0,g,a,c: c+L(x,x0,g,a)\n        p0=[cx,300,ys.max()-ys.min(),ys.min()]\n    else:\n        f=lambda x,x0,g,a,c,sl: c+sl*x+L(x,x0,g,a)\n        p0=[cx,300,ys.max()-ys.min(),ys.mean(),0.0]\n    popt,_=curve_fit(f,xs,ys,p0=p0,maxfev=200000)\n    yf=f(xs,*popt); r2=1-((ys-yf)**2).sum()/((ys-ys.mean())**2).sum()\n    return popt,r2\n\nfor name,cx,dx in [('G',10289,1600),('2D',19139,2200)]:\n    pc,rc=fit(cx,dx,'const',4)\n    pl,rl=fit(cx,dx,'lin',5)\n    print(name,'CONST: x0=%.1f g=%.1f a=%.1f off=%.1f R2=%.4f'%(pc[0],pc[1],pc[2],pc"]
[602.280291, "i", "[3],rc))\n    if len(pl)==5:\n        off_at_peak=pl[3]+pl[4]*pl[0]\n        print('     LIN : x0=%.1f g=%.1f a=%.1f off@peak=%.1f slope=%.4f R2=%.4f'%(pl[0],pl[1],pl[2],off_at_peak,pl[4],rl))\nEOF\npython3 /app/diag.py\n"]
[602.280524, "o", "cat > /app/diag.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> x=[]; y=[]\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         p=line.replace(',','.').split()\r\n\u001b[?2004l\r\u001b[?2004h>         if len(p)>=2:\r\n\u001b[?2004l\r\u001b[?2004h>             x.append(float(p[0])); y.append(float(p[1]))\r\n\u001b[?2004l\r\u001b[?2004h> x=np.array(x); y=np.array(y)\r\n\u001b[?2004l\r\u001b[?2004h> idx=np.argsort(x); x=x[idx]; y=y[idx]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def L(x,x0,g,a): return a*g**2/((x-x0)**2+g**2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fit(cx,dx,model,npar):\r\n\u001b[?2004l\r\u001b[?2004h>     m=(x>cx-dx)&(x<cx+dx); xs=x[m]; ys=y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     if model=='const':\r\n\u001b[?2004l\r\u001b[?2004h>         f=lambda x,x0,g,a,c: c+L(x,x0,g,a)\r\n\u001b[?2004l\r\u001b[?2004h>         p0=[cx,300,ys.max()-ys.min(),ys.min()]\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         f=lambda x,x0,g,a,c,sl: c+sl*x+L(x,"]
[602.280576, "o", "x0,g,a)\r\n\u001b[?2004l\r\u001b[?2004h>         p0=[cx,300,ys.max()-ys.min(),ys.mean(),0.0]\r\n\u001b[?2004l\r\u001b[?2004h>     popt,_=curve_fit(f,xs,ys,p0=p0,maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h>     yf=f(xs,*popt); r2=1-((ys-yf)**2).sum()/((ys-ys.mean())**2).sum()\r\n\u001b[?2004l\r\u001b[?2004h>     return popt,r2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for name,cx,dx in [('G',10289,1600),('2D',19139,2200)]:\r\n\u001b[?2004l\r\u001b[?2004h>     pc,rc=fit(cx,dx,'const',4)\r\n\u001b[?2004l\r\u001b[?2004h>     pl,rl=fit(cx,dx,'lin',5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
