[513.223487, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\n\nx=[]; y=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            x.append(float(p[0])); y.append(float(p[1]))\nx=np.array(x); y=np.array(y)\nidx=np.argsort(x); x=x[idx]; y=y[idx]\n\ndef lor(x,x0,gamma,amp,offset):\n    return offset + amp*gamma**2/((x-x0)**2+gamma**2)\n\ndef fit_window(xc, dx, p0):\n    m=(x>xc-dx)&(x<xc+dx)\n    xs=x[m]; ys=y[m]\n    popt,pcov=curve_fit(lor,xs,ys,p0=p0,\n        bounds=([xc-3000,1,0,0],[xc+3000,2000,5e5,1e5]),maxfev=200000)\n    yfit=lor(xs,*popt)\n    ss=1-((ys-yfit)**2).sum()/((ys-ys.mean())**2).sum()\n    return popt, ss\n\np2d,r2d=fit_window(19139,2200,[19139,450,72000,15000])\npG,rG=fit_window(10289,1800,[10289,350,10000,10000])\nprint('2D x0=%.2f gamma=%.2f amp=%.2f offset=%.2f  R2=%.5f'%(p2d[0],p2d[1],p2d[2],p2d[3],r2d))\nprint('G  x0=%.2f gamma=%.2f amp=%.2f offset=%.2f  R2=%"]
[513.223882, "o", "cat > /app/fit.py << 'EOF'"]
