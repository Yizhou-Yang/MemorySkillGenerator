[176.424809, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\nx=[]; y=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.replace(',','.').split()\n        if len(line)>=2:\n            x.append(float(line[0])); y.append(float(line[1]))\nx=np.array(x); y=np.array(y)\nprint('global max y=%.1f at x=%.1f'%(y.max(), x[y.argmax()]))\npeaks, props = find_peaks(y, prominence=2000, distance=30)\nprint('num peaks', len(peaks))\nfor p in peaks:\n    print('x=%.1f y=%.1f prom=%.1f'%(x[p], y[p], props['prominences'][list(peaks).index(p)]))\nEOF\npython3 /app/explore2.py\n"]
[176.425181, "o", "cat > /app/explore2.py << 'EOF'"]
