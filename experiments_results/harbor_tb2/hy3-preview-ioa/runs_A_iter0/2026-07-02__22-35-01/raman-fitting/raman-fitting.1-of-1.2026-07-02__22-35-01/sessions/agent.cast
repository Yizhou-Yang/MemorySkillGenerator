[282.265672, "i", "cat > /app/analyze.py << 'EOF'\nimport numpy as np\nx=[]; y=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        p=line.replace(',','.').split()\n        if len(p)>=2:\n            x.append(float(p[0])); y.append(float(p[1]))\nx=np.array(x); y=np.array(y)\nidx=np.argsort(x)\nxs=x[idx]; ys=y[idx]\nn=len(xs)\nprint('coarse trace (x ascending):')\nfor i in range(0,n,71):\n    print('x=%8.1f  y=%8.1f'%(xs[i],ys[i]))\nEOF\npython3 /app/analyze.py\n"]
