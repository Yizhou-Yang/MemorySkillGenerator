[339.310501, "i", "cat > /app/revert.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"Revert the reshaped dataset back to its original flat layout.\n\nThis undoes the reshaping produced when preparing c4_reshard/ for upload.\nIt flattens the per-shard folders (shard_NNN) inside c4_reshard/ back into\nthe original flat directory c4_sample/, preserving the original filenames\nand contents so the result matches what was originally in c4_sample/.\n\nThe script lives in the parent directory of c4_sample/ and derives the\nlocations of c4_sample/ and c4_reshard/ relative to its own location, so it\nworks no matter the current working directory.\n\nRun:  python3 revert.py\n\"\"\"\nimport os\nimport shutil\nimport sys\n\n\ndef main():\n    base_dir = os.path.dirname(os.path.abspath(__file__))\n    original_dir = os.path.join(base_dir, 'c4_sample')\n    reshaped_dir = os.path.join(base_dir, 'c4_reshard')\n\n    if not os.path.isdir(reshaped_dir):\n        sys.exit('ERROR: c4_reshard/ not found at %s' % reshaped_dir)\n\n    os.makedirs(original_dir, exist_ok=True)\n\n    count = 0\n    for entry in sorted(os.listdir(reshaped_dir)):\n        shard_path = os.path.join(reshaped_dir, entry)\n        if not os.path.isdir(shard_path):\n            # Skip anything that is not a shard folder (e.g. stray files).\n            continue\n        for fname in sorted(os.listdir(shard_path)):\n            src = os.path.join(shard_path, fname)\n            if not os.path.isfile(src):\n                continue\n            dst = os.path.join(original_dir, fname)\n            shutil.copy2(src, dst)\n            count += 1\n\n    print('Restored %d files into %s' % (count, original_dir))\n    # Sanity check: report the number of files expected vs restored.\n    if os.path.isdir(original_dir):\n        restored = sum(\n            1 for _ in os.listdir(original_dir)\n            if os.path.isfile(os.path.join(original_dir, _))\n        )\n        print('c4_sample/ now contains %d files.' % restored)\n\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
