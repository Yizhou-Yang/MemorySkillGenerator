[93.423338, "i", "python3 << 'PYEOF'\nimport os, shutil\nsrc='/app/c4_sample'\ndst='/app/c4_reshard'\nos.makedirs(dst, exist_ok=True)\nfiles=sorted(f for f in os.listdir(src) if os.path.isfile(os.path.join(src,f)))\nper=30\nfor i in range(0,len(files),per):\n    d=os.path.join(dst,'shard_%03d'%(i//per))\n    os.makedirs(d, exist_ok=True)\n    for f in files[i:i+per]:\n        shutil.copy2(os.path.join(src,f), os.path.join(d,f))\nprint('files',len(files),'shards',(len(files)+per-1)//per)\nPYEOF\n"]
