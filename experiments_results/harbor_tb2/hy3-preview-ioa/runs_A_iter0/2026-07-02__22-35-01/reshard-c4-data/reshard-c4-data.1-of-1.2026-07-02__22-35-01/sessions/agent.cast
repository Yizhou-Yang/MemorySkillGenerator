[429.32146, "o", "\u001b[?2004h> "]
[429.321546, "o", "            src = os.path.join(shard_path, fname)\r\n\u001b[?2004l\r"]
[429.3216, "o", "\u001b[?2004h> "]
[429.321681, "o", "            if not os.path.isfile(src):\r\n\u001b[?2004l\r"]
[429.321716, "o", "\u001b[?2004h> "]
[429.321779, "o", "                continue\r\n\u001b[?2004l\r"]
[429.321815, "o", "\u001b[?2004h> "]
[429.321931, "o", "            dst = os.path.join(reshaped_dir, fname)\r\n\u001b[?2004l\r"]
[429.321967, "o", "\u001b[?2004h> "]
[429.322035, "o", "            shutil.move(src, dst)\r\n\u001b[?2004l\r"]
[429.322071, "o", "\u001b[?2004h> "]
[429.322122, "o", "            moved += 1\r\n\u001b[?2004l\r"]
[429.322155, "o", "\u001b[?2004h> "]
[429.322311, "o", "        # Remove the shard folder now that it should be empty.\r\n\u001b[?2004l\r"]
[429.322356, "o", "\u001b[?2004h> "]
[429.32241, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.322483, "o", "            os.rmdir(shard_path)\r\n\u001b[?2004l\r"]
[429.322518, "o", "\u001b[?2004h> "]
[429.322565, "o", "            removed_shards += 1\r\n\u001b[?2004l\r"]
[429.322614, "o", "\u001b[?2004h> "]
[429.322666, "o", "        except OSError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.322875, "o", "            print('WARNING: could not remove %s (not empty)' % shard_path)\r\n\u001b[?2004l\r"]
[429.322936, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.322991, "o", "    # Report results.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.323042, "o", "    top_files = [\r\n\u001b[?2004l\r"]
[429.323074, "o", "\u001b[?2004h> "]
[429.323193, "o", "        f for f in os.listdir(reshaped_dir)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.32336, "o", "        if os.path.isfile(os.path.join(reshaped_dir, f))\r\n\u001b[?2004l\r"]
[429.323414, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.323621, "o", "    print('Reverted c4_reshard/: moved %d files out of %d shard folders.'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.3237, "o", "          % (moved, removed_shards))\r\n\u001b[?2004l\r"]
[429.323765, "o", "\u001b[?2004h> "]
[429.323946, "o", "    print('c4_reshard/ is now flat with %d files, matching the original c4_sample/.'"]
[429.32429, "o", "\r\n"]
[429.324435, "o", "\u001b[?2004l\r"]
[429.324612, "o", "\u001b[?2004h"]
[429.324783, "o", "> "]
[429.324984, "o", "          % len(top_files))"]
[429.325123, "o", "\r\n"]
[429.32526, "o", "\u001b[?2004l\r"]
[429.325454, "o", "\u001b[?2004h"]
[429.325606, "o", "> "]
[429.32577, "o", "\r\n"]
[429.325925, "o", "\u001b[?2004l\r"]
[429.326092, "o", "\u001b[?2004h"]
[429.326241, "o", "> "]
[429.326611, "o", "    # Optional sanity check against the original c4_sample/ if it is present."]
[429.326775, "o", "\r\n"]
[429.326923, "o", "\u001b[?2004l\r"]
[429.327089, "o", "\u001b[?2004h"]
[429.327245, "o", "> "]
[429.327549, "o", "    original_dir = os.path.join(base_dir, 'c4_sample')"]
[429.327718, "o", "\r\n"]
[429.327868, "o", "\u001b[?2004l\r"]
[429.328003, "o", "\u001b[?2004h"]
[429.328309, "o", ">     if os.path.isdir(original_dir):"]
[429.328552, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.328727, "o", "        orig_files = set("]
[429.328957, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.329212, "o", "            f for f in os.listdir(original_dir)"]
[429.329459, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.329719, "o", "            if os.path.isfile(os.path.join(original_dir, f))"]
[429.329853, "o", "\r\n"]
[429.329959, "o", "\u001b[?2004l\r"]
[429.330083, "o", "\u001b[?2004h"]
[429.330191, "o", "> "]
[429.330344, "o", "        )"]
[429.331053, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         if set(top_files) == orig_files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.331307, "o", "            print('Verification OK: c4_reshard/ contents match c4_sample/ (%d files).'"]
[429.331419, "o", "\r\n"]
[429.331523, "o", "\u001b[?2004l\r"]
[429.331644, "o", "\u001b[?2004h"]
[429.331894, "o", "> "]
[429.332133, "o", "                  % len(orig_files))\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.332368, "o", "            missing = orig_files - set(top_files)\r\n\u001b[?2004l\r"]
[429.332453, "o", "\u001b[?2004h> "]
[429.332628, "o", "            extra = set(top_files) - orig_files"]
[429.332805, "o", "\r\n"]
[429.332974, "o", "\u001b[?2004l\r"]
[429.333159, "o", "\u001b[?2004h"]
[429.333351, "o", "> "]
[429.333798, "o", "            print('WARNING: mismatch with c4_sample/ -- missing %d, unexpected %d'"]
[429.334049, "o", "\r\n"]
[429.334283, "o", "\u001b[?2004l\r"]
[429.334516, "o", "\u001b[?2004h> "]
[429.334762, "o", "                  % (len(missing), len(extra)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[429.334852, "o", "> "]
[429.334969, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[429.335256, "o", "\u001b[?2004h> "]
[429.335304, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.335415, "o", "    main()\r\n\u001b[?2004l\r"]
[429.335447, "o", "\u001b[?2004h"]
[429.335571, "o", "> "]
