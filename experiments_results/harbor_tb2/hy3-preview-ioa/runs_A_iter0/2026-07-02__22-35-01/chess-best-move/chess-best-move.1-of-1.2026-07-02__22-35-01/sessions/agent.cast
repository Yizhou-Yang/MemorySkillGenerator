[301.374841, "i", "cat > /tmp/glyph.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\nocc=[]\nfor r in range(8):\n    for c in range(8):\n        cell=a[r*S:(r+1)*S, c*S:(c+1)*S]\n        bg=cell[3,3]\n        diff=np.abs(cell-bg).sum(axis=2)\n        mask=diff>40\n        cnt=mask.sum()\n        if cnt>150:\n            occ.append((r,c,mask))\nprint('num occupied', len(occ))\nfor (r,c,mask) in occ:\n    ys,xs=np.where(mask)\n    fg=a[r*S:(r+1)*S, c*S:(c+1)*S][mask]\n    print('--- r%d c%d  fgmean=%s'%(r,c, tuple(fg.mean(axis=0).astype(int))))\n    # normalize bbox to 16x16\n    sub=mask[ys.min():ys.max()+1, xs.min():xs.max()+1]\n    img=Image.fromarray((sub*255).astype('uint8')).resize((16,16))\n    arr=np.array(img)>80\n    for row in arr:\n        print(''.join('#' if v else '.' for v in row))\nEOF\npython3 /tmp/glyph.py 2>&1 | head -80\n"]
