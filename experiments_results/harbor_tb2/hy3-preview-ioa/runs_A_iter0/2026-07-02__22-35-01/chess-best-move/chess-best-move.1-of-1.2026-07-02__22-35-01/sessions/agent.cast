[274.746142, "i", "cat > /tmp/ascii.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\ncells=[(0,0),(0,2),(0,3),(0,5),(1,1),(1,4),(1,5),(2,0),(2,2),(2,4),(3,0),(3,3),(3,4),(3,5),(3,6),(3,7),(5,0),(5,2),(6,1),(6,4),(6,5),(6,6),(7,0),(7,2),(7,4),(7,7)]\nfor (r,c) in cells[:6]:\n    cell=a[r*S:(r+1)*S, c*S:(c+1)*S]\n    bg=cell[3,3]\n    diff=np.abs(cell-bg).sum(axis=2)\n    mask=diff>40\n    print('=== r%d c%d ==='%(r,c))\n    # downsample to 20x20\n    for yy in range(0,80,4):\n        line=''\n        for xx in range(0,80,4):\n            line += '#' if mask[yy:yy+4,xx:xx+4].any() else '.'\n        print(line)\nEOF\npython3 /tmp/ascii.py\n"]
