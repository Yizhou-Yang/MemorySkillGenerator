[330.549518, "i", "cat > /tmp/cluster.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\ndef cellglyph(r,c):\n    cell=a[r*S:(r+1)*S, c*S:(c+1)*S]\n    bg=cell[3,3]\n    diff=np.abs(cell-bg).sum(axis=2)\n    mask=diff>40\n    if mask.sum()<150: return None\n    ys,xs=np.where(mask)\n    fg=cell[mask].mean(axis=0)\n    sub=mask[ys.min():ys.max()+1, xs.min():xs.max()+1]\n    img=Image.fromarray((sub*255).astype('uint8')).resize((16,16))\n    arr=(np.array(img)>80).astype(int)\n    return arr, tuple(fg.astype(int))\nocc=[]\nfor r in range(8):\n    for c in range(8):\n        g=cellglyph(r,c)\n        if g: occ.append((r,c)+g)\nprint('total', len(occ))\n# cluster\nclusters=[]\nfor item in occ:\n    r,c,arr,fg=item\n    placed=False\n    for cl in clusters:\n        rep=cl[0][2]\n        if (rep==arr).mean()>0.90:\n            cl.append(item); placed=True; break\n    if not placed:\n        clusters.append([item])\nprint('num clusters', len(clusters))\nfor i,cl in enumerate(clusters):\n    print('=== cluster',i,'members:',[(m[0],m[1]) for m in cl],'fgmeans:',[m[3] for m in cl])\n    rep=cl[0][2]\n    for row in rep:\n        print(''.join('#' if v else '.' for v in row))\nEOF\npython3 /tmp/cluster.py\n"]
