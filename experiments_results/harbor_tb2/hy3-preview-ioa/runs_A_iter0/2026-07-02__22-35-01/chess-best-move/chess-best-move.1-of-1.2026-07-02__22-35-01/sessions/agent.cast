[330.937741, "o", "\u001b[?2004hroot@4cd8215db1e1:/app# "]
[470.661921, "i", "cat > /tmp/match.py << 'EOF'\nfrom PIL import Image, ImageFont, ImageDraw\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nS=80\nfont = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 64)\nchars = {'K':0x2654,'Q':0x2655,'R':0x2656,'B':0x2657,'N':0x2658,'P':0x2659,\n         'k':0x265A,'q':0x265B,'r':0x265C,'b':0x265D,'n':0x265E,'p':0x265F}\nwhite_syms = 'KQRBNP'\ndef norm_from_mask(mask):\n    ys,xs=np.where(mask)\n    sub=mask[ys.min():ys.max()+1, xs.min():xs.max()+1]\n    img=Image.fromarray((sub*255).astype('uint8')).resize((32,32))\n    return (np.array(img)>80).astype(int)\ndef render(ch):\n    img=Image.new('L',(80,80),0)\n    d=ImageDraw.Draw(img)\n    d.text((40,40),chr(ch),fill=255,font=font,anchor='mm')\n    arr=np.array(img)>80\n    if arr.sum()<20: return None\n    return norm_from_mask(arr)\ntempl={}\nfor name,c in chars.items():\n    t=render(c)\n    templ[name]=t\n    print('tmpl',name,'ok' if t is not None else 'MISSING')\ndef cellnorm(r,c):\n    cell=a[r*S:(r+1)*S, c*S:(c+1)*S]\n    bg=cell[3,3]\n    diff=np.abs(cell-bg).sum(axis=2)\n    mask=diff>40\n    if mask.sum()<150: return None\n    fg=cell[mask].mean(axis=0)\n    return norm_from_mask(mask), tuple(fg.astype(int))\nfor r in range(8):\n    for c in range(8):\n        res=cellnorm(r,c)\n        if not res: continue\n        arr,fg=res\n        iswhite = fg[0]>150\n        cand = white_syms if iswhite else white_syms.lower()\n        best=None;bd=1e9\n        for name in cand:\n            t=templ[name]\n            if t is None: continue\n            d=int((t!=arr).sum())\n            if d<bd: bd=d;best=name\n        print('r%d c%d  fg=%s  -> %s (dist=%d)'%(r,c,tuple(fg),best,bd))\nEOF\npython3 /tmp/match.py\n"]
[470.662192, "o", "cat > /tmp/match.py << 'EOF'\r\n\u001b[?2004l\r"]
