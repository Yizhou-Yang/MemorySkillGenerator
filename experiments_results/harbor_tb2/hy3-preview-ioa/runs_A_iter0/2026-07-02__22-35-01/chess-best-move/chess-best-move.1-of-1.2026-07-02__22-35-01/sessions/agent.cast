[658.697886, "i", "cat > /tmp/solve.py << 'EOF'\nimport chess\nfen = \"r1bq1r2/1p3pp1/p1n1p3/3nPkbP/8/N1N5/1P2QPP1/R1B1K2R w KQ - 0 1\"\nb = chess.Board(fen)\nprint('FEN:', fen)\nprint('is_valid:', b.is_valid())\nprint('turn white:', b.turn==chess.WHITE)\nmates=[]\nfor m in b.legal_moves:\n    b.push(m)\n    cm = b.is_checkmate()\n    b.pop()\n    if cm:\n        mates.append(m)\nprint('num checkmates:', len(mates))\nfor m in mates:\n    print('  ', m.uci(), b.san(m))\nEOF\npython3 /tmp/solve.py\n"]
