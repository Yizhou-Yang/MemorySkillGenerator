[183.742934, "i", "cat > /tmp/analyze.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im)\nprint('shape', a.shape)\nS=80\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        cell = a[r*S:(r+1)*S, c*S:(c+1)*S]\n        # background = corner pixel\n        bg = cell[2,2]\n        diff = np.abs(cell.astype(int)-bg.astype(int)).sum(axis=2)\n        mask = diff>40\n        cnt = mask.sum()\n        row.append(cnt)\n    print(r, row)\nEOF\npython3 /tmp/analyze.py\n"]
