[181.330838, "i", "cat > /app/my_website/publications.html << 'HTMLEOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Publications - Dr. Lydia Moreno</title>\n<link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n<header class=\"site-header\">\n<nav class=\"nav\">\n<a class=\"brand\" href=\"index.html\">Lydia Moreno</a>\n<ul class=\"nav-links\">\n<li><a href=\"index.html\">About</a></li>\n<li><a href=\"publications.html\" class=\"active\">Publications</a></li>\n<li><a href=\"blog.html\">Blog</a></li>\n</ul>\n</nav>\n</header>\n<main class=\"container\">\n<section>\n<h2>Publications</h2>\n<div class=\"card\">\n<p><strong>Moreno, L., &amp; Patel, A. (2024).</strong> Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals. <em>Journal of Computational Neuroscience</em>, 45(2), 123-137.</p>\n</div>\n<div class=\"card\">\n<p><strong>Moreno, L., Zhang, W., &amp; Singh, R. (2023).</strong> Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets. <em>Neuroinformatics</em>, 21(4), 299-312.</p>\n</div>\n<div class=\"card\">\n<p><strong>Moreno, L. et al. (2022).</strong> Integrative Single-Cell Atlas of Human Cerebral Organoids. <em>Cell Systems</em>, 9(1), 67-82.</p>\n</div>\n<div class=\"card\">\n<p><strong>Chen, J., Moreno, L., &amp; Russo, M. (2021).</strong> Explainable AI Techniques in Neural Decoding. <em>Frontiers in Neuroscience</em>, 15, 756843.</p>\n</div>\n</section>\n\n<section>\n<h2>Selected Projects</h2>\n<div class=\"card\">\n<h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\n<p class=\"meta\">Role: Lead Developer &amp; Project Coordinator</p>\n<p>A PyTorch pipeline to segment two-photon images of mouse visual cortex with temporal convolutional networks predicting stimulus orientation; deployed as a Dockerized microservice with Cascade Imaging Lab.</p>\n</div>\n<div class=\"card\">\n<h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\n<p class=\"meta\">Role: Principal Investigator</p>\n<p>Graph representations of reconstructed neuron meshes from EM; GNNs classify synapse types. Open-source toolkit in the NeuroTools suite, adopted by 12 labs.</p>\n</div>\n<div class=\"card\">\n<h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\n<p class=\"meta\">Role: Co-Principal Investigator</p>\n<p>Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH; Bayesian clustering of human cortical organoids. Presented at ICSCG 2023.</p>\n</div>\n</section>\n</main>\n<footer>\n<p>(c) 2025 Dr. Lydia Moreno</p>\n</footer>\n</body>\n</html>\nHTMLEOF\n"]
