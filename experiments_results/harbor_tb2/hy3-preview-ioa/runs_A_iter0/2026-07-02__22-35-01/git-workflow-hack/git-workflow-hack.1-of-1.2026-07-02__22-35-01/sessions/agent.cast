[181.341195, "o", "<p>Graph representations of reconstructed neuron meshes from EM; GNNs classify synapse types. Open-source toolkit in the NeuroTools suite, adopted by 12 labs.</p>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[181.343588, "o", "</div>\r\n\u001b[?2004l\r\u001b[?2004h> <div class=\"card\">\r\n\u001b[?2004l\r\u001b[?2004h> <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\r\n\u001b[?2004l\r\u001b[?2004h> <p class=\"meta\">Role: Co-Principal Investigator</p>\r\n\u001b[?2004l\r\u001b[?2004h> <p>Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH; Bayesian clustering of human cortical organoids. Presented at ICSCG 2023.</p>\r\n\u001b[?2004l\r\u001b[?2004h> </div>\r\n\u001b[?2004l\r\u001b[?2004h> </section>\r\n\u001b[?2004l\r\u001b[?2004h> </main>\r\n\u001b[?2004l\r\u001b[?2004h> <footer>\r\n\u001b[?2004l\r\u001b[?2004h> <p>(c) 2025 Dr. Lydia Moreno</p>\r\n\u001b[?2004l\r\u001b[?2004h> </footer>\r\n\u001b[?2004l\r\u001b[?2004h> </body>\r\n\u001b[?2004l\r\u001b[?2004h> </html>\r\n\u001b[?2004l\r\u001b[?2004h> HTMLEOF\r\n\u001b[?2004l\r"]
[181.3457, "o", "\u001b[?2004hroot@156003cd3533:/app# "]
[181.493548, "i", "cat > /app/my_website/blog.html << 'HTMLEOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Blog - Dr. Lydia Moreno</title>\n<link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n<header class=\"site-header\">\n<nav class=\"nav\">\n<a class=\"brand\" href=\"index.html\">Lydia Moreno</a>\n<ul class=\"nav-links\">\n<li><a href=\"index.html\">About</a></li>\n<li><a href=\"publications.html\">Publications</a></li>\n<li><a href=\"blog.html\" class=\"active\">Blog</a></li>\n</ul>\n</nav>\n</header>\n<main class=\"container\">\n<section>\n<h2>Latest Posts</h2>\n<div class=\"card\">\n<h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\n<p class=\"meta\">March 2025</p>\n<p>Reflections on designing models whose decisions neuroscientists can actually trust and audit.</p>\n</div>\n<div class=\"card\">\n<h3>Bridging Machine Learning and Single-Cell Genomics</h3>\n<p class=\"meta\">January 2025</p>\n<p>Lessons from integrating multi-modal single-cell data into scalable analysis pipelines.</p>\n</div>\n<div class=\"card\">\n<h3>Scaling Graph Neural Networks for Connectomics</h3>\n<p class=\"meta\">November 2024</p>\n<p>How we scaled GNN training across large electron-microscopy connectomics datasets.</p>\n</div>\n</section>\n</main>\n<footer>\n<p>(c) 2025 Dr. Lydia Moreno</p>\n</footer>\n</body>\n</html>\nHTMLEOF\n"]
