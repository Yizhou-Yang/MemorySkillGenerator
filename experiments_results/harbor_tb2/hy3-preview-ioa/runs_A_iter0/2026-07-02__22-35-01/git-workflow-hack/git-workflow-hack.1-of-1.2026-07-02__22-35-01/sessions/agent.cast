[181.162862, "o", "<li><strong>Single-Cell Omics</strong> - scalable pipelines integrating multi-modal single-cell genomics.</li>\r\n\u001b[?2004l\r\u001b[?2004h> <li><strong>Explainable AI in Neuroscience</strong> - probing decision boundaries and feature attributions.</li>\r\n\u001b[?2004l\r\u001b[?2004h> </ul>\r\n\u001b[?2004l\r\u001b[?2004h> </div>\r\n\u001b[?2004l\r\u001b[?2004h> </section>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> <section>\r\n\u001b[?2004l\r\u001b[?2004h> <h2>Skills &amp; Tools</h2>\r\n\u001b[?2004l\r\u001b[?2004h> <div class=\"card\">\r\n\u001b[?2004l\r\u001b[?2004h> <p><span class=\"tag\">Python</span><span class=\"tag\">R</span><span class=\"tag\">C++</span><span class=\"tag\">PyTorch</span><span class=\"tag\">TensorFlow</span><span class=\"tag\">scikit-learn</span><span class=\"tag\">NetworkX</span><span class=\"tag\">Nextflow</span><span class=\"tag\">Docker</span><span class=\"tag\">Kubernetes</span><span class=\"tag\">MATLAB</span><span class=\"tag\">Seurat</span><span class=\"tag\">Scanpy</span><span class=\"tag\">D3.js</span><span class=\"tag\">Plotly</span></p>\r\n\u001b[?2004l\r\u001b[?2004h> </div>\r\n\u001b[?2004l\r\u001b[?2004h> </section>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> <section>\r\n\u001b[?2004l\r\u001b[?2004h> <h2>Contact</h2>\r\n\u001b[?2004l\r\u001b[?2004h> <div class=\"card\">\r\n\u001b[?2004l\r\u001b[?2004h> <ul class=\"clean\">\r\n\u001b[?2004l\r\u001b[?2004h> <li>Email: <a class=\"link\" href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></li>\r\n\u001b[?2004l\r\u001b[?2004h> <li>Office: Blakely Hall, Room 312, Riverbend University</li>\r\n\u001b[?2004l\r\u001b[?2004h> "]
