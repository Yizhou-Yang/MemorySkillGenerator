[181.141937, "i", "cat > /app/my_website/index.html << 'HTMLEOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Dr. Lydia Moreno - Research Profile</title>\n<link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n<header class=\"site-header\">\n<nav class=\"nav\">\n<a class=\"brand\" href=\"index.html\">Lydia Moreno</a>\n<ul class=\"nav-links\">\n<li><a href=\"index.html\" class=\"active\">About</a></li>\n<li><a href=\"publications.html\">Publications</a></li>\n<li><a href=\"blog.html\">Blog</a></li>\n</ul>\n</nav>\n</header>\n<main class=\"container\">\n<section class=\"profile\">\n<h1>Dr. Lydia Moreno</h1>\n<p class=\"subtitle\">Associate Professor of Computational Neuroscience<br>Riverbend University | School of Biological Sciences</p>\n<p class=\"bio\">Her research sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n</section>\n\n<section>\n<h2>Education</h2>\n<div class=\"card\">\n<h3>Ph.D., Computational Biology</h3>\n<p class=\"meta\">Baywood Institute of Technology | 2014-2019</p>\n<p>Dissertation: Deep Learning Models for Decoding Neural Population Activity.</p>\n</div>\n<div class=\"card\">\n<h3>M.Sc., Bioinformatics</h3>\n<p class=\"meta\">Riverbend University | 2012-2014</p>\n<p>Thesis: Statistical Methods for Single-Cell RNA-Seq Analysis.</p>\n</div>\n<div class=\"card\">\n<h3>B.Sc., Computer Science</h3>\n<p class=\"meta\">Crestfield College of Engineering | 2008-2012</p>\n<p>Graduated magna cum laude; President, Data Science Club.</p>\n</div>\n</section>\n\n<section>\n<h2>Research Interests</h2>\n<div class=\"card\">\n<ul class=\"clean\">\n<li><strong>Neural Encoding &amp; Decoding</strong> - interpretable models translating spike-train data into behavioral predictions.</li>\n<li><strong>Machine Learning for Biomedical Imaging</strong> - CNNs and GNNs applied to MRI and two-photon microscopy.</li>\n<li><strong>Single-Cell Omics</strong> - scalable pipelines integrating multi-modal single-cell genomics.</li>\n<li><strong>Explainable AI in Neuroscience</strong> - probing decision boundaries and feature attributions.</li>\n</ul>\n</div>\n</section>\n\n<section>\n<h2>Skills &amp; Tools</h2>\n<div class=\"card\">\n<p><span class=\"tag\">Python</span><span class=\"tag\">R</span><span class=\"tag\">C++</span><span class=\"tag\">PyTorch</span><span class=\"tag\">TensorFlow</span><span class=\"tag\">scikit-learn</span><span class=\"tag\">NetworkX</span><span class=\"tag\">Nextflow</span><span class=\"tag\">Docker</span><span class=\"tag\">Kubernetes</span><span class=\"tag\">MATLAB</span><span class=\"tag\">Seurat</span><span class=\"tag\">Scanpy</span><span class=\"tag\">D3.js</span><span class=\"tag\">Plotly</span></p>\n</div>\n</section>\n\n<section>\n<h2>Contact</h2>\n<div class=\"card\">\n<ul class=\"clean\">\n<li>Email: <a class=\"link\" href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></li>\n<li>Office: Blakely Hall, Room 312, Riverbend University</li>\n<li>Twitter: <a class=\"link\" href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></li>\n<li>GitHub: <a class=\"link\" href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></li>\n</ul>\n</div>\n</section>\n</main>\n<footer>\n<p>(c) 2025 Dr. Lydia Moreno | Built as a static research profile site.</p>\n</footer>\n</body>\n</html>\nHTMLEOF\n"]
