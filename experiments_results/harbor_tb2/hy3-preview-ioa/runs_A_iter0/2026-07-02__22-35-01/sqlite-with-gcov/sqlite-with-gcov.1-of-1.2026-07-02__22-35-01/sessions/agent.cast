[461.17912, "o", "\u001b[?2004hroot@7584242aff73:/tmp/debs# "]
[483.756077, "i", "cat > /tmp/dl.py << 'EOF'\nimport urllib.request\nwith open('/tmp/url_list.txt') as f:\n    urls = [l.strip() for l in f if l.strip()]\nfor u in urls:\n    name = u.split('/')[-1]\n    try:\n        req = urllib.request.Request(u, headers={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64)'})\n        with urllib.request.urlopen(req, timeout=60) as r:\n            data = r.read()\n        with open('/tmp/debs/' + name, 'wb') as o:\n            o.write(data)\n        print('OK', name, len(data))\n    except Exception as e:\n        print('FAIL', name, e)\nEOF\n"]
[483.757114, "o", "cat > /tmp/dl.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.761523, "o", "import urllib.request"]
[483.768427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> with open('/tmp/url_list.txt') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     urls = [l.strip() for l in f if l.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> for u in urls:\r\n\u001b[?2004l\r\u001b[?2004h>     name = u.split('/')[-1]\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         req = urllib.request.Request(u, headers={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64)'})\r\n\u001b[?2004l\r\u001b[?2004h>         with urllib.request.urlopen(req, timeout=60) as r:\r\n\u001b[?2004l\r\u001b[?2004h>             data = r.read()\r\n\u001b[?2004l\r\u001b[?2004h>         with open('/tmp/debs/' + name, 'wb') as o:\r\n\u001b[?2004l\r\u001b[?2004h>             o.write(data)\r\n\u001b[?2004l\r\u001b[?2004h>         print('OK', name, len(data))\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print('FAIL', name, e)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[483.774169, "o", "\u001b[?2004hroot@7584242aff73:/tmp/debs# "]
