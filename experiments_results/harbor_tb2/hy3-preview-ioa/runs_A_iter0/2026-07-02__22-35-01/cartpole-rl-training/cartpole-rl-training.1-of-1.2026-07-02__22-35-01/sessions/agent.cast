[90.719931, "i", "cat > /app/train.py << 'EOF'\nimport os\nimport random\nfrom collections import deque\n\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nimport gymnasium as gym\n\nfrom agent import Agent\n\n\ndef train():\n    env = gym.make(\"CartPole-v1\")\n    agent = Agent()\n    device = agent.device\n\n    capacity = 20000\n    batch_size = 128\n    gamma = 0.99\n    lr = 1e-3\n    target_update = 200\n    num_episodes = 1200\n    epsilon_start = 1.0\n    epsilon_end = 0.02\n    epsilon_decay = 1000\n\n    buffer = deque(maxlen=capacity)\n    optimizer = torch.optim.Adam(agent.policy_net.parameters(), lr=lr)\n    agent.optimizer = optimizer\n\n    steps_done = 0\n    best_avg = -1\n\n    def epsilon_by_frame(f):\n        return epsilon_end + (epsilon_start - epsilon_end) * np.exp(-f / epsilon_decay)\n\n    def optimize():\n        if len(buffer) < batch_size:\n            return\n        batch = random.sample(buffer, batch_size)\n        states, actions, rewards, nexts, dones = zip(*batch)\n        states = torch.as_tensor(np.array(states, dtyp"]
[90.720119, "i", "e=np.float32), device=device)\n        actions = torch.as_tensor(np.array(actions, dtype=np.int64), device=device).unsqueeze(1)\n        rewards = torch.as_tensor(np.array(rewards, dtype=np.float32), device=device).unsqueeze(1)\n        nexts = torch.as_tensor(np.array(nexts, dtype=np.float32), device=device)\n        dones = torch.as_tensor(np.array(dones, dtype=np.float32), device=device).unsqueeze(1)\n\n        q_vals = agent.policy_net(states).gather(1, actions)\n        with torch.no_grad():\n            next_actions = agent.policy_net(nexts).argmax(1, keepdim=True)\n            next_q = agent.target_net(nexts).gather(1, next_actions)\n            target = rewards + gamma * next_q * (1 - dones)\n        loss = F.smooth_l1_loss(q_vals, target)\n        optimizer.zero_grad()\n        loss.backward()\n        torch.nn.utils.clip_grad_norm_(agent.policy_net.parameters(), 10)\n        optimizer.step()\n\n    for ep in range(num_episodes):\n        obs, _ = env.reset()\n        total = 0\n        eps = epsilon_by_frame(steps_done"]
[90.720248, "o", "cat > /app/train.py << 'EOF'\r\n\u001b[?2004l\r"]
[90.72031, "i", ")\n        while True:\n            steps_done += 1\n            if np.random.rand() < eps:\n                action = int(env.action_space.sample())\n            else:\n                action = agent.select_action(obs)\n            nxt, reward, terminated, truncated, _ = env.step(action)\n            done = terminated or truncated\n            buffer.append((obs, action, reward, nxt, done))\n            obs = nxt\n            total += reward\n            optimize()\n            if done:\n                break\n        if ep % target_update == 0:\n            agent.target_net.load_state_dict(agent.policy_net.state_dict())\n\n        if ep % 25 == 0:\n            rew = evaluate(agent, env)\n            print(f\"Ep {ep}, eps {eps:.3f}, train {total:.0f}, eval {rew:.1f}\")\n            if rew > best_avg and rew >= 400:\n                best_avg = rew\n                agent.save(\"/app/trained_model\")\n    agent.save(\"/app/trained_model\")\n    env.close()\n\n\ndef evaluate(agent, env, n=25):\n    tot = 0\n    for _ in range(n):\n        obs, _ = e"]
