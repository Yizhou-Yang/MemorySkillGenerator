[90.720442, "i", "nv.reset()\n        ep = 0\n        while True:\n            action = agent.select_action(obs)\n            obs, r, term, trunc, _ = env.step(action)\n            ep += r\n            if term or trunc:\n                break\n        tot += ep\n    return tot / n\n\n\nif __name__ == \"__main__\":\n    train()\nEOF\n"]
