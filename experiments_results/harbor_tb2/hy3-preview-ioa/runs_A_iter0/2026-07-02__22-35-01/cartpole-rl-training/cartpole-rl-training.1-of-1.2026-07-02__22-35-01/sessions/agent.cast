[75.94087, "i", "cat > /app/agent.py << 'EOF'\nimport os\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n\nclass DQN(nn.Module):\n    def __init__(self, n_state=4, n_hidden=128, n_action=2):\n        super().__init__()\n        self.fc1 = nn.Linear(n_state, n_hidden)\n        self.fc2 = nn.Linear(n_hidden, n_hidden)\n        self.fc3 = nn.Linear(n_hidden, n_action)\n\n    def forward(self, x):\n        x = F.relu(self.fc1(x))\n        x = F.relu(self.fc2(x))\n        return self.fc3(x)\n\n\nclass Agent:\n    def __init__(self):\n        self.n_state = 4\n        self.n_action = 2\n        self.device = torch.device(\"cpu\")\n        self.policy_net = DQN().to(self.device)\n        self.target_net = DQN().to(self.device)\n        self.target_net.load_state_dict(self.policy_net.state_dict())\n        self.target_net.eval()\n        self.optimizer = torch.optim.Adam(self.policy_net.parameters(), lr=1e-3)\n\n    def select_action(self, current_observation, epsilon=0.0):\n        obs = np.asarray(current_observation, dty"]
[75.941139, "i", "pe=np.float32)\n        if np.random.rand() < epsilon:\n            return int(np.random.randint(self.n_action))\n        with torch.no_grad():\n            state = torch.as_tensor(obs, dtype=torch.float32, device=self.device).unsqueeze(0)\n            q = self.policy_net(state)\n            return int(q.argmax(dim=1).item())\n\n    def save(self, directory):\n        os.makedirs(directory, exist_ok=True)\n        path = os.path.join(directory, \"policy_net.pt\")\n        torch.save(self.policy_net.state_dict(), path)\n\n    def load(self, directory):\n        path = os.path.join(directory, \"policy_net.pt\")\n        state = torch.load(path, map_location=self.device)\n        self.policy_net.load_state_dict(state)\n        self.target_net.load_state_dict(state)\n        self.policy_net.eval()\n        self.target_net.eval()\nEOF\n"]
[75.941162, "o", "cat > /app/agent.py << 'EOF'\r\n\u001b[?2004l\rpe=np.float32)\r\n        if np.random.rand() < epsilon:\r\n            return int(np.random.randint(self.n_action))\r\n        with torch.no_grad():\r\n            state = torch.as_tensor(obs, dtype=torch.float32, device=self.device).unsqueeze(0)\r\n            q = self.policy_net(state)\r\n            return int(q.argmax(dim=1).item())\r\n\r\n    def save(self, directory):\r\n        os.makedirs(directory, exist_ok=True)\r\n        path = os.path.join(directory, \"policy_net.pt\")\r\n        torch.save(self.policy_net.state_dict(), path)\r\n\r\n    def load(self, directory):\r\n        path = os.path.join(directory, \"policy_net.pt\")\r\n        state = torch.load(path, map_location=self.device)\r\n        self.policy_net.load_state_dict(state)\r\n        self.target_net.load_state_dict(state)\r\n        self.policy_net.eval()\r\n        self.target_net.eval()\r\nEOF\r\n"]
