[90.722729, "o", "    epsilon_end = 0.02\r\n\u001b[?2004l\r"]
[90.722746, "o", "\u001b[?2004h> "]
[90.722783, "o", "    epsilon_decay = 1000\r\n\u001b[?2004l\r"]
[90.722813, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.722945, "o", "\u001b[?2004h>     buffer = deque(maxlen=capacity)\r\n"]
[90.722975, "o", "\u001b[?2004l\r\u001b[?2004h"]
[90.722984, "o", "> "]
[90.725657, "o", "    optimizer = torch.optim.Adam(agent.policy_net.parameters(), lr=lr)\r\n\u001b[?2004l\r\u001b[?2004h>     agent.optimizer = optimizer\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     steps_done = 0\r\n\u001b[?2004l\r\u001b[?2004h>     best_avg = -1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def epsilon_by_frame(f):\r\n\u001b[?2004l\r\u001b[?2004h>         return epsilon_end + (epsilon_start - epsilon_end) * np.exp(-f / epsilon_decay)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def optimize():\r\n\u001b[?2004l\r\u001b[?2004h>         if len(buffer) < batch_size:\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h>         batch = random.sample(buffer, batch_size)\r\n\u001b[?2004l\r\u001b[?2004h>         states, actions, rewards, nexts, dones = zip(*batch)\r\n\u001b[?2004l\r\u001b[?2004h>         states = torch.as_tensor(np.array(states, dtype=np.float32), device=device)\r\n\u001b[?2004l\r\u001b[?2004h>         actions = torch.as_tensor(np.array(actions, dtype=np.int64), device=device).unsqueeze(1)\r\n\u001b[?2004l\r\u001b[?2004h>         rewards = torch.as_tensor(np.array(rewards, dtype=np.float32), devic"]
[90.725718, "o", "e=device).unsqueeze(1)\r\n\u001b[?2004l\r\u001b[?2004h>         nexts = torch.as_tensor(np.array(nexts, dtype=np.float32), device=device)\r\n\u001b[?2004l\r\u001b[?2004h>         dones = torch.as_tensor(np.array(dones, dtype=np.float32), device=device).unsqueeze(1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[90.725914, "o", "\u001b[?2004l\r"]
[90.726043, "o", "\u001b[?2004h> "]
[90.726213, "o", "        q_vals = agent.policy_net(states).gather(1, actions)\r\n\u001b[?2004l\r"]
[90.72635, "o", "\u001b[?2004h> "]
[90.72639, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.726409, "o", "> "]
[90.726726, "o", "            next_actions = agent.policy_net(nexts).argmax(1, keepdim=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.726857, "o", "            next_q = agent.target_net(nexts).gather(1, next_actions)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.726975, "o", "> "]
[90.727156, "o", "            target = rewards + gamma * next_q * (1 - dones)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.727174, "o", "        loss = F.smooth_l1_loss(q_vals, target)\r\n\u001b[?2004l\r"]
[90.727332, "o", "\u001b[?2004h> "]
[90.727383, "o", "        optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h>         loss.backward()\r\n\u001b[?2004l\r"]
[90.727571, "o", "\u001b[?2004h> "]
[90.727709, "o", "        torch.nn.utils.clip_grad_norm_(agent.policy_net.parameters(), 10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.72774, "o", "        optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.727893, "o", "    for ep in range(num_episodes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.72805, "o", "        obs, _ = env.reset()\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.728183, "o", "> "]
[90.728401, "o", "        total = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.728629, "o", "        eps = epsilon_by_frame(steps_done)\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.728925, "o", "            steps_done += 1\r\n\u001b[?2004l\r\u001b[?2004h>             if np.random.rand() < eps:\r\n\u001b[?2004l\r\u001b[?2004h>                 action = int(env.action_space.sample())\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.729167, "o", "                action = agent.select_action(obs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.729371, "o", "            nxt, reward, terminated, truncated, _ = env.step(action)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.729619, "o", "            done = terminated or truncated\r\n\u001b[?2004l\r\u001b[?2004h>             buffer.append((obs, action, reward, nxt, done))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.729867, "o", "            obs = nxt\r\n\u001b[?2004l\r\u001b[?2004h>             total += reward\r\n\u001b[?2004l\r\u001b[?2004h>             optimize()\r\n\u001b[?2004l\r"]
[90.730076, "o", "\u001b[?2004h>             if done:\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.730306, "o", "        if ep % target_update == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.730525, "o", "            agent.target_net.load_state_dict(agent.policy_net.state_dict())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         if ep % 25 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.730772, "o", "            rew = evaluate(agent, env)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.731037, "o", "            print(f\"Ep {ep}, eps {eps:.3f}, train {total:.0f}, eval {rew:.1f}\")\r\n\u001b[?2004l\r\u001b[?2004h>             if rew > best_avg and rew >= 400:\r\n\u001b[?2004l\r\u001b[?2004h>                 best_avg = rew\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.731337, "o", "                agent.save(\"/app/trained_model\")\r\n\u001b[?2004l\r\u001b[?2004h>     agent.save(\"/app/trained_model\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.731666, "o", "    env.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.731898, "o", "def evaluate(agent, env, n=25):\r\n\u001b[?2004l\r\u001b[?2004h>     tot = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.731929, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h>         obs, _ = env.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.732751, "o", "        ep = 0\r\n\u001b[?2004l\r"]
[90.732782, "o", "\u001b[?2004h> "]
[90.732854, "o", "        while True:\r\n\u001b[?2004l\r"]
[90.732871, "o", "\u001b[?2004h> "]
[90.733016, "o", "            action = agent.select_action(obs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.733037, "o", "> "]
[90.733327, "o", "            obs, r, term, trunc, _ = env.step(action)\r\n\u001b[?2004l\r"]
[90.733345, "o", "\u001b[?2004h>             ep += r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.733557, "o", "            if term or trunc:\r\n"]
[90.733593, "o", "\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>         tot += ep\r\n\u001b[?2004l\r"]
[90.73361, "o", "\u001b[?2004h> "]
[90.733683, "o", "    return tot / n\r\n\u001b[?2004l\r"]
[90.733712, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.733725, "o", "> \r\n\u001b[?2004l\r"]
[90.733743, "o", "\u001b[?2004h> "]
[90.73381, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[90.733829, "o", "\u001b[?2004h> "]
[90.733873, "o", "    train()\r\n\u001b[?2004l\r"]
[90.733891, "o", "\u001b[?2004h> "]
[90.733906, "o", "EOF\r\n\u001b[?2004l\r"]
