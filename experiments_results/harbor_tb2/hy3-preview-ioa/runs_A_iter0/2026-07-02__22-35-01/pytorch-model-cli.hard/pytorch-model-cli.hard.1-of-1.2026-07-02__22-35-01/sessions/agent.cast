[725.029427, "o", "    out = bytearray()"]
[725.031189, "o", "\r\n"]
[725.033527, "o", "\u001b[?2004l\r\u001b[?2004h>     idx=0\r\n\u001b[?2004l\r"]
[725.037513, "o", "\u001b[?2004h"]
[725.054667, "o", "> "]
[725.055085, "o", "    for y in range(height):\r\n\u001b[?2004l\r\u001b[?2004h"]
[725.055425, "o", "> "]
[725.062448, "o", "        f = raw[idx]; idx+=1"]
[725.067385, "o", "\r\n"]
[725.085916, "o", "\u001b[?2004l\r\u001b[?2004h>         row = raw[idx:idx+stride]; idx+=stride\r\n\u001b[?2004l\r\u001b[?2004h>         out+=row\r\n\u001b[?2004l\r\u001b[?2004h>     return width,height,bytes(out)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> w,h,px = read_png('/app/image.png')\r\n\u001b[?2004l\r\u001b[?2004h> print('png', w, h, len(px))\r\n\u001b[?2004l\r\u001b[?2004h> pix = [float(b)/255.0 for b in px]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run(name, vec):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[725.099643, "o", "    x = torch.tensor(vec, dtype=torch.float32).unsqueeze(0)\r\n\u001b[?2004l\r\u001b[?2004h>     with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>         logits = model(x)\r\n\u001b[?2004l\r\u001b[?2004h>         probs = F.softmax(logits, dim=1)[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[725.103898, "o", "    pred = int(probs.argmax())"]
[725.111371, "o", "\r\n"]
[725.122796, "o", "\u001b[?2004l\r\u001b[?2004h"]
[725.142395, "o", ">     conf = float(probs[pred])\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{name}: pred={pred} conf={conf:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> run('raw/255', pix)\r\n\u001b[?2004l\r\u001b[?2004h> run('norm(m=0.1307,s=0.3081)', [(v-0.1307)/0.3081 for v in pix])\r\n\u001b[?2004l\r\u001b[?2004h> run('inv/255', [1.0-v for v in pix])\r\n\u001b[?2004l\r\u001b[?2004h> run('inv_norm', [(1.0-v-0.1307)/0.3081 for v in pix])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[725.148247, "o", "run('scale_only_*256', [v*256 for v in pix][:1]+pix) if False else None"]
[725.154987, "o", "\r\n\u001b[?2004l\r"]
