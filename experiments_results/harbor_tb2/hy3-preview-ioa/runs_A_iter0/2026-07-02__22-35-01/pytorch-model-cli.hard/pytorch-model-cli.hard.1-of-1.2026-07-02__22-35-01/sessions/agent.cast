[724.98187, "i", "cat > /tmp/test_preproc.py << 'EOF'\nimport torch, math\nfrom model import MnistModel\nfrom torch.nn import functional as F\n\nsd = torch.load('model.pth', map_location='cpu')\nmodel = MnistModel(784, 16, 10)\nmodel.load_state_dict(sd)\nmodel.eval()\n\n# load PNG grayscale\ndef read_png(path):\n    import struct, zlib\n    d = open(path,'rb').read()\n    assert d[:8]==b'\\x89PNG\\r\\n\\x1a\\n'\n    pos=8; width=height=None; bitd=colt=None; idat=b''\n    while pos < len(d):\n        ln = struct.unpack('>I', d[pos:pos+4])[0]; typ=d[pos+4:pos+8]; data=d[pos+8:pos+8+ln]\n        if typ==b'IHDR':\n            width,height,bitd,colt = struct.unpack('>IIBB', data[:10])\n        elif typ==b'IDAT':\n            idat+=data\n        elif typ==b'IEND':\n            break\n        pos += 12+ln\n    raw = zlib.decompress(idat)\n    # colortype 0 grayscale 8-bit, no filter per scanline: bpp=1, each row has 1 filter byte\n    stride = width\n    out = bytearray()\n    idx=0\n    for y in range(height):\n        f = raw[idx]; idx+=1\n        row = raw[idx:idx+st"]
[724.982395, "o", "cat > /tmp/test_preproc.py << 'EOF'"]
[724.982451, "i", "ride]; idx+=stride\n        out+=row\n    return width,height,bytes(out)\n\nw,h,px = read_png('/app/image.png')\nprint('png', w, h, len(px))\npix = [float(b)/255.0 for b in px]\n\ndef run(name, vec):\n    x = torch.tensor(vec, dtype=torch.float32).unsqueeze(0)\n    with torch.no_grad():\n        logits = model(x)\n        probs = F.softmax(logits, dim=1)[0]\n    pred = int(probs.argmax())\n    conf = float(probs[pred])\n    print(f'{name}: pred={pred} conf={conf:.4f}')\n\nrun('raw/255', pix)\nrun('norm(m=0.1307,s=0.3081)', [(v-0.1307)/0.3081 for v in pix])\nrun('inv/255', [1.0-v for v in pix])\nrun('inv_norm', [(1.0-v-0.1307)/0.3081 for v in pix])\nrun('scale_only_*256', [v*256 for v in pix][:1]+pix) if False else None\n# try pixel as 0-255 raw\nrun('raw0-255', [float(b) for b in px])\nEOF\npython3 /tmp/test_preproc.py\n"]
