[788.901043, "i", "cat > /app/export_weights.py << 'EOF'\nimport torch, json\nfrom model import MnistModel\n\nsd = torch.load('/app/model.pth', map_location='cpu')\nmodel = MnistModel(784, 16, 10)\nmodel.load_state_dict(sd)\nmodel.eval()\n\ndef t2l(t):\n    return t.detach().cpu().reshape(-1).tolist()\n\ndef t2m(t):\n    return t.detach().cpu().tolist()  # row-major [out][in]\n\nW1 = sd['input_layer.weight']; b1 = sd['input_layer.bias']\nW2 = sd['hidden_layer.weight']; b2 = sd['hidden_layer.bias']\nW3 = sd['output_layer.weight']; b3 = sd['output_layer.bias']\n\nout = {\n    'input_dim': W1.shape[1],\n    'hidden_dim': W2.shape[1],\n    'num_classes': W3.shape[0],\n    'preprocess': {'mean': 0.1307, 'std': 0.3081},\n    'input_layer': {'weight': t2m(W1), 'bias': t2l(b1)},\n    'hidden_layer': {'weight': t2m(W2), 'bias': t2l(b2)},\n    'output_layer': {'weight': t2m(W3), 'bias': t2l(b3)},\n}\nwith open('/app/weights.json','w') as f:\n    json.dump(out, f)\nprint('wrote weights.json')\nprint('shapes', W1.shape, W2"]
[788.901505, "o", "cat > /app/export_weights.py << 'EOF'"]
