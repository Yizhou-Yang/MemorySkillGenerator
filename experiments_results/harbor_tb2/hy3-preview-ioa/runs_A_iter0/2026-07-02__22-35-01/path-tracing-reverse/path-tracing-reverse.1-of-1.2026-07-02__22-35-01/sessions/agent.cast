[657.955941, "i", "cat > /tmp/strings.py << 'EOF'\nimport re\ndata={}\nwith open('/tmp/rodata.txt') as f:\n    for line in f:\n        m=re.match(r'\\s*([0-9a-f]+)\\s+((?:[0-9a-f]{8}\\s*)*)',line)\n        if not m: continue\n        addr=int(m.group(1),16); hexs=m.group(2).replace(' ',''); b=bytes.fromhex(hexs)\n        for i in range(len(b)): data[addr+i]=b[i]\naddrs=sorted(data)\nlo,hi=addrs[0],addrs[-1]\nbuf=bytes(data[a] for a in range(lo,hi+1))\nbase=lo\ni=0\nwhile i<len(buf):\n    c=buf[i]\n    if 32<=c<127:\n        j=i\n        while j<len(buf) and (32<=buf[j]<127):\n            j+=1\n        if j-i>=3:\n            s=buf[i:j]\n            esc=s.replace(b'\\r',b'<CR>').replace(b'\\n',b'<LF>')\n            print(f'{base+i:#x}: {esc.decode()!r}')\n        i=j\n    else:\n        i+=1\nEOF\npython3 /tmp/strings.py\n"]
[657.958429, "o", "cat > /tmp/strings.py << 'EOF'\r\n\u001b[?2004l\r"]
