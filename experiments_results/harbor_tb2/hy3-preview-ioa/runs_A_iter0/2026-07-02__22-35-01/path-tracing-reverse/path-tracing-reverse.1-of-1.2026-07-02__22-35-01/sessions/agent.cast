[125.761263, "o", "\u001b[?2004hroot@f7af256768ff:/app# "]
[180.68015, "i", "cat > /tmp/decode.py << 'EOF'\nimport re, struct\ndata = {}\nwith open('/tmp/rodata.txt') as f:\n    for line in f:\n        m = re.match(r'\\s*([0-9a-f]+)\\s+((?:[0-9a-f]{8}\\s*)*)', line)\n        if not m: continue\n        addr = int(m.group(1),16)\n        hexs = m.group(2).replace(' ','')\n        b = bytes.fromhex(hexs)\n        for i in range(0,len(b),1):\n            data[addr+i] = b[i]\nbase = 0x3000\nallb = bytes(data[a] for a in range(base, base+0x200))\nprint('Doubles from 0x3008 (8-byte):')\nfor off in range(8, len(allb)-7, 8):\n    d = struct.unpack('<d', allb[off:off+8])[0]\n    print(f'  +{off:#x}: {d!r}')\nprint('Floats from 0x3000 (4-byte):')\nfor off in range(0, len(allb)-3, 4):\n    fv = struct.unpack('<f', allb[off:off+4])[0]\n    print(f'  +{off:#x}: {fv!r}')\nEOF\npython3 /tmp/decode.py\n"]
[180.680889, "o", "cat > /tmp/decode.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
