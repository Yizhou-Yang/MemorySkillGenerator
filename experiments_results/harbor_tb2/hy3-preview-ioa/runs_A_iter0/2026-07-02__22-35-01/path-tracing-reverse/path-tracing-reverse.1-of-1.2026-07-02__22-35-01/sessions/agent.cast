[194.261142, "i", "cat > /tmp/decode.py << 'EOF'\nimport re, struct\ndata = {}\nwith open('/tmp/rodata.txt') as f:\n    for line in f:\n        m = re.match(r'\\s*([0-9a-f]+)\\s+((?:[0-9a-f]{8}\\s*)*)', line)\n        if not m: continue\n        addr = int(m.group(1),16)\n        hexs = m.group(2).replace(' ','')\n        b = bytes.fromhex(hexs)\n        for i in range(len(b)):\n            data[addr+i] = b[i]\naddrs = sorted(data)\nmin_a, max_a = addrs[0], addrs[-1]\nallb = bytes(data[a] for a in range(min_a, max_a+1))\nbase = min_a\nprint(f'range {min_a:#x}..{max_a:#x}')\nprint('Doubles:')\nfor off in range(0, len(allb)-7, 8):\n    a = base+off\n    d = struct.unpack('<d', allb[off:off+8])[0]\n    print(f'  {a:#x}: {d!r}')\nprint('Floats:')\nfor off in range(0, len(allb)-3, 4):\n    a = base+off\n    fv = struct.unpack('<f', allb[off:off+4])[0]\n    print(f'  {a:#x}: {fv!r}')\nEOF\npython3 /tmp/decode.py\n"]
