[255.175214, "i", "cat > /tmp/split.py << 'EOF'\nimport re\nwith open('/tmp/dis.txt') as f:\n    lines = f.readlines()\ncur=None\nout=None\nfor line in lines:\n    m = re.match(r'^([0-9a-f]+) <([^>]+)>:', line)\n    if m:\n        cur = m.group(2)\n        if out: out.close()\n        out = open(f'/tmp/fun_{cur}.txt','w')\n    if out is not None:\n        out.write(line)\nif out: out.close()\nimport glob\nprint('\\n'.join(sorted(glob.glob('/tmp/fun_*.txt'))))\nEOF\npython3 /tmp/split.py\n"]
[255.185685, "o", "cat > /tmp/split.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> with open('/tmp/dis.txt') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h> cur=None\r\n\u001b[?2004l\r\u001b[?2004h> out=None\r\n\u001b[?2004l\r\u001b[?2004h> for line in lines:\r\n\u001b[?2004l\r\u001b[?2004h> "]
