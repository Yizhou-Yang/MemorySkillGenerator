[112.33598, "o", "\u001b[?2004hroot@8f11c9b1977b:/app# "]
[113.769365, "i", "cat > /etc/nginx/conf.d/git.conf <<'EOF'\nserver {\n    listen 8443 ssl;\n    server_name localhost;\n    ssl_certificate /etc/nginx/ssl/git.crt;\n    ssl_certificate_key /etc/nginx/ssl/git.key;\n    root /var/www/main;\n    index index.html;\n    location /dev/ {\n        alias /var/www/dev/;\n    }\n}\nEOF\n"]
[113.770154, "o", "cat > /etc/nginx/conf.d/git.conf <<'EOF'\r\n\u001b[?2004l\r"]
[113.770415, "o", "\u001b[?2004h> server {\r\n\u001b[?2004l\r\u001b[?2004h>     listen 8443 ssl;\r\n\u001b[?2004l\r\u001b[?2004h>     server_name localhost;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.770646, "o", "    ssl_certificate /etc/nginx/ssl/git.crt;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.770858, "o", "    ssl_certificate_key /etc/nginx/ssl/git.key;\r\n"]
[113.771141, "o", "\u001b[?2004l\r\u001b[?2004h>     root /var/www/main;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.771369, "o", "    index index.html;\r\n\u001b[?2004l\r\u001b[?2004h>     location /dev/ {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.771598, "o", "        alias /var/www/dev/;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[113.777168, "o", "\u001b[?2004hroot@8f11c9b1977b:/app# "]
[114.046868, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nGIT_DIR=/git/project\nwhile read oldrev newrev refname; do\n  branch=\"${refname#refs/heads/}\"\n  case \"$branch\" in\n    main)\n      git --git-dir=\"$GIT_DIR\" archive main | tar -x -C /var/www/main\n      ;;\n    dev)\n      git --git-dir=\"$GIT_DIR\" archive dev | tar -x -C /var/www/dev\n      ;;\n  esac\ndone\nEOF\n"]
[114.049028, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> GIT_DIR=/git/project\r\n\u001b[?2004l\r\u001b[?2004h> while read oldrev newrev refname; do\r\n\u001b[?2004l\r\u001b[?2004h>   branch=\"${refname#refs/heads/}\"\r\n\u001b[?2004l\r\u001b[?2004h>   case \"$branch\" in\r\n\u001b[?2004l\r\u001b[?2004h>     main)\r\n\u001b[?2004l\r\u001b[?2004h>       git --git-dir=\"$GIT_DIR\" archive main | tar -x -C /var/www/main\r\n\u001b[?2004l\r\u001b[?2004h>       ;;\r\n\u001b[?2004l\r\u001b[?2004h>     dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.049423, "o", "      git --git-dir=\"$GIT_DIR\" archive dev | tar -x -C /var/www/dev\r\n\u001b[?2004l\r\u001b[?2004h>       ;;\r\n\u001b[?2004l\r\u001b[?2004h>   esac\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[114.066992, "o", "\u001b[?2004hroot@8f11c9b1977b:/app# "]
[114.335769, "i", "chmod +x /git/project/hooks/post-receive && chown git:git /git/project/hooks/post-receive\n"]
[114.336502, "o", "chmod +x /git/project/hooks/post-receive && chown git:git /git/project/hooks/post-receive\r\n\u001b[?2004l\r"]
