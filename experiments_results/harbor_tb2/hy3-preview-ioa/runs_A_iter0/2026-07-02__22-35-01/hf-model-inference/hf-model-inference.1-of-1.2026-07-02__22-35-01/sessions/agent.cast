[343.500136, "i", "cat > /app/app.py << 'EOF'\nimport os\nimport traceback\nfrom flask import Flask, request, jsonify\nfrom transformers import pipeline\n\nMODEL_PATH = \"/app/model_cache/sentiment_model\"\n\napp = Flask(__name__)\n\nprint(\"Loading sentiment model from\", MODEL_PATH, flush=True)\nclassifier = pipeline(\n    \"sentiment-analysis\",\n    model=MODEL_PATH,\n    tokenizer=MODEL_PATH,\n)\nprint(\"Model loaded.\", flush=True)\n\n\n@app.route(\"/sentiment\", methods=[\"POST\"])\ndef sentiment():\n    try:\n        data = request.get_json(silent=True)\n        if not data or not isinstance(data, dict):\n            return jsonify({\"error\": \"Invalid JSON body\"}), 400\n        text = data.get(\"text\")\n        if text is None or not isinstance(text, str) or text.strip() == \"\":\n            return jsonify({\"error\": \"Missing or empty 'text' field\"}), 400\n\n        results = classifier(text)\n        if isinstance(results, list):\n            results = results[0]\n\n        label = results[\"label\"].lower()\n        score"]
[343.500685, "o", "cat > /app/app.py << 'EOF'"]
