[343.505075, "i", " = float(results[\"score\"])\n\n        # Normalize labels: POSITIVE -> positive, NEGATIVE -> negative\n        is_positive = \"positive\" in label\n        confidence = {\n            \"positive\": score if is_positive else round(1.0 - score, 6),\n            \"negative\": round(1.0 - score, 6) if is_positive else score,\n        }\n        sentiment_label = \"positive\" if is_positive else \"negative\"\n\n        return jsonify({\n            \"sentiment\": sentiment_label,\n            \"confidence\": confidence,\n        })\n    except Exception as e:\n        traceback.print_exc()\n        return jsonify({\"error\": str(e)}), 500\n\n\n@app.route(\"/health\", methods=[\"GET\"])\ndef health():\n    return jsonify({\"status\": \"ok\"})\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=5000)\nEOF\n"]
