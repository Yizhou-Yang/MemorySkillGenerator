[186.512856, "i", "cat > /app/convert.py << 'EOF'\nimport zipfile, struct, io, json, collections, pickle\nfrom types import SimpleNamespace\n\ndef get_flat(storage, offset, size, stride):\n    size = tuple(size); stride = tuple(stride)\n    if len(size) == 1:\n        return [storage[offset + i*stride[0]] for i in range(size[0])]\n    result = []\n    for i in range(size[0]):\n        result.extend(get_flat(storage, offset + i*stride[0], size[1:], stride[1:]))\n    return result\n\nclass MyUnpickler(pickle.Unpickler):\n    def __init__(self, file, zf):\n        super().__init__(file)\n        self.zf = zf\n    def find_class(self, module, name):\n        if module == 'torch._utils' and name == '_rebuild_tensor_v2':\n            def f(storage, offset, size, stride, requires_grad=False, *rest):\n                t = SimpleNamespace()\n                t.size = tuple(size)\n                t.flat = get_flat(storage, offset, size, stride)\n                return t\n            return f\n        if module.startswith('torch'):\n            return lambda *a, **k"]
[186.513434, "i", ": None\n        return super().find_class(module, name)\n    def persistent_load(self, pid):\n        # ('storage', storage_cls, key, 'cpu', numel)\n        kind, cls, key, device, numel = pid\n        k = 'simple_mnist/data/' + key\n        data = self.zf.read(k)\n        vals = list(struct.unpack('<%df' % (len(data)//4), data))\n        return vals\n\nzf = zipfile.ZipFile('/app/model.pth')\ndata = zf.read('simple_mnist/data.pkl')\nsd = MyUnpickler(io.BytesIO(data), zf).load()\nfor k, v in sd.items():\n    print(k, v.size, len(v.flat))\n\norder = ['input_layer','hidden_layer','output_layer']\nlayer_list = []\nfor name in order:\n    w = sd[name + '.weight'].flat\n    b = sd[name + '.bias'].flat\n    rows = sd[name + '.weight'].size[0]\n    cols = sd[name + '.weight'].size[1]\n    layer_list.append({'rows':rows,'cols':cols,'w':w,'b':b})\n\ninput_dim = layer_list[0]['cols']\nhidden_dim = layer_list[0]['rows']\nnum_classes = layer_list[2]['rows']\nout = {'input_dim':input_dim,'hidden_dim':hidden_dim,'num_classes':num_classes,'layers':laye"]
[186.513594, "i", "r_list}\nwith open('/app/weights.json','w') as fo:\n    json.dump(out, fo)\nprint('written weights.json input=%d hidden=%d classes=%d' % (input_dim,hidden_dim,num_classes))\nEOF\npython3 /app/convert.py\n"]
