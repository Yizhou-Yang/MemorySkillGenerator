[219.042628, "o", "int)*nlayers);\r\n\u001b[?2004l\r\u001b[?2004h>     double **W = (double**)malloc(sizeof(double*)*nlayers);\r\n\u001b[?2004l\r\u001b[?2004h>     double **B = (double**)malloc(sizeof(double*)*nlayers);\r\n\u001b[?2004l\r\u001b[?2004h>     for (int l = 0; l < nlayers; l++) {\r\n\u001b[?2004l\r\u001b[?2004h>         cJSON *layer = cJSON_GetArrayItem(layers, l);\r\n\u001b[?2004l\r\u001b[?2004h>         rows[l] = cJSON_GetObjectItem(layer, \"rows\")->valueint;\r\n\u001b[?2004l\r\u001b[?2004h>         cols[l] = cJSON_GetObjectItem(layer, \"cols\")->valueint;\r\n\u001b[?2004l\r\u001b[?2004h>         W[l] = parse_vec(cJSON_GetObjectItem(layer, \"w\"), NULL);\r\n\u001b[?2004l\r\u001b[?2004h>         B[l] = parse_vec(cJSON_GetObjectItem(layer, \"b\"), NULL);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     unsigned char *img = NULL;\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned w, h;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.042822, "o", "    unsigned err = lodepng_decode32_file(&img, &w, &h, img_path);"]
[219.042965, "o", "\r\n"]
[219.042994, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[219.043357, "o", "    if (err) { fprintf(stderr, \"png error %u\\n\", err); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
