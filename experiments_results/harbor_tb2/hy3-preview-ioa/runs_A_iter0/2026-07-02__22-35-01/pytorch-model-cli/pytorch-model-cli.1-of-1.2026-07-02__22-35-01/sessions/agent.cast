[219.043998, "o", "\u001b[?2004h> "]
[219.044367, "o", "    double *x = (double*)malloc(sizeof(double)*input_dim);\r\n\u001b[?2004l\r\u001b[?2004h>     for (int p = 0; p < input_dim; p++) {\r\n\u001b[?2004l\r\u001b[?2004h>         unsigned char r = img[p*4];"]
