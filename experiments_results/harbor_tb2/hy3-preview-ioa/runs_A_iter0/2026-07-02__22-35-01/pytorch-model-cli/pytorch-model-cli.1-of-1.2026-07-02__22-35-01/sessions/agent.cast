[12.502031, "o", "import torch\r"]
[12.503005, "o", "\r\n"]
[12.504282, "o", "import torch.nn as nn\r"]
[12.504524, "o", "\r\n\r\r\n\r\r\nclass MnistModel(nn.Module):\r\r\n    def __init__(\r\r\n        self,\r\r\n        input_dim: int,\r\r\n        hidden_dim: int,\r\r\n        num_classes: int,\r\r\n    ) -> torch.nn.Module:\r\r\n        super().__init__()\r\r\n\r\r\n        self.input_layer = nn.Linear(input_dim, hidden_dim)\r\r\n        self.hidden_layer = nn.Linear(hidden_dim, hidden_dim)\r\r\n        self.output_layer = nn.Linear(hidden_dim, num_classes)\r"]
[12.509887, "m", "Episode 1: 2 commands"]
[12.509887, "o", "\r\n        self.activation = nn.ReLU()\r\r\n\r\r\n    def forward(self, x):\r\r\n        x = self.input_layer(x)\r\r\n        x = self.activation(x)\r\r\n\r\r\n        x = self.hidden_layer(x)\r\r\n        x = self.activation(x)\r\r\n\r\r\n        x = self.output_layer(x)\r\r\n        return x\r\r\n\u001b[?2004hroot@13028e079751:/app# "]
