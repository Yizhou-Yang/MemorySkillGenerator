[168.6123, "i", "cat > /app/conv2.py << 'EOF'\nimport zipfile, struct, io, pickle\nfrom types import SimpleNamespace\n\nclass MyUnpickler(pickle.Unpickler):\n    def __init__(self, file, zf):\n        super().__init__(file)\n        self.zf = zf\n    def find_class(self, module, name):\n        if module.startswith('torch'):\n            return lambda *a, **k: None\n        return super().find_class(module, name)\n    def persistent_load(self, pid):\n        print('PERSISTENT_ID:', repr(pid))\n        return None\n\nzf = zipfile.ZipFile('/app/model.pth')\ndata = zf.read('simple_mnist/data.pkl')\ntry:\n    MyUnpickler(io.BytesIO(data), zf).load()\nexcept Exception as e:\n    print('done:', e)\nEOF\npython3 /app/conv2.py\n"]
