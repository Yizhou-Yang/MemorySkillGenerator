[219.032157, "i", "GetObjectItem(layer, \"b\"), NULL);\n    }\n\n    unsigned char *img = NULL;\n    unsigned w, h;\n    unsigned err = lodepng_decode32_file(&img, &w, &h, img_path);\n    if (err) { fprintf(stderr, \"png error %u\\n\", err); return 1; }\n    if ((int)(w*h) != input_dim) {\n        fprintf(stderr, \"image size %ux%u != %d\\n\", w, h, input_dim);\n        return 1;\n    }\n\n    double *x = (double*)malloc(sizeof(double)*input_dim);\n    for (int p = 0; p < input_dim; p++) {\n        unsigned char r = img[p*4];\n        x[p] = (double)r / 255.0;\n    }\n\n    double *y = NULL;\n    for (int l = 0; l < nlayers; l++) {\n        int r = rows[l], c = cols[l];\n        y = (double*)malloc(sizeof(double)*r);\n        for (int i = 0; i < r; i++) {\n            double s = B[l][i];\n            double *wr = W[l] + (size_t)i * c;\n            for (int j = 0; j < c; j++) s += wr[j] * x[j];\n            if (l != nlayers - 1) { if (s < 0) s = 0; }\n            y[i] = s;\n        }\n        free(x);\n        x = y;\n    }\n\n    int best = 0;\n    double bestv = x[0];"]
