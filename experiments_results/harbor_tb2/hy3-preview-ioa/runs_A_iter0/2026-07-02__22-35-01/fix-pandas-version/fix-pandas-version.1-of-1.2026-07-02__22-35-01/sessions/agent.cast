[354.491132, "o", "cat /app/src/data_processor.py"]
[354.491346, "o", "\r\n\u001b[?2004l\r"]
[354.523492, "o", "from typing import Any, Dict, Tuple"]
[354.523959, "o", "\r\n"]
[354.524177, "o", "\r\n"]
[354.524366, "o", "import numpy as np  # type: ignore"]
[354.524593, "o", "\r\n"]
[354.524779, "o", "import pandas as pd  # type: ignore"]
[354.524956, "o", "\r\n"]
[354.525162, "o", "\r\n"]
[354.525356, "o", "from .data_loader import load_sample_transactions"]
[354.525558, "o", "\r\n"]
[354.525701, "o", "\r\n"]
[354.525813, "o", "\r\n"]
[354.525955, "o", "def load_and_process_data(filepath) -> pd.DataFrame:"]
[354.526106, "o", "\r\n"]
[354.526311, "o", "    \"\"\"Load CSV data with optimized dtypes using Arrow and handle mixed date formats.\r\n\r\n    Args:\r\n        filepath: Path to the CSV file containing transaction data\r\n\r\n    Returns:"]
[354.526522, "o", "\r\n"]
[354.52669, "o", "        DataFrame with properly typed columns using Arrow backend"]
[354.526889, "o", "\r\n"]
[354.527106, "o", "    \"\"\""]
[354.527305, "o", "\r\n    # This requires pandas >= 2.0.0 for date_format and dtype_backend\r\n    pd.options.mode.copy_on_write = True\r\n\r\n    df = pd.read_csv(\r\n        filepath,\r\n        dtype_backend=\"pyarrow\",\r\n        date_format=\"mixed\",\r\n    )\r\n\r\n    # Convert date columns using the new mixed format parser\r\n    date_cols = [\"transaction_date\", \"processing_date\"]\r\n    for col in date_cols:\r\n        if col in df.columns:\r\n            df[col] = pd.to_datetime(df[col], format=\"mixed\")"]
[354.527625, "o", "\r\n\r\n"]
[354.527727, "o", "    return df\r\n\r\n\r\ndef process_transactions(df: pd.DataFrame) -> Tuple[pd.DataFrame, Dict[str, Any]]:\r\n    \"\"\"Process transaction data using pandas 2.0 features.\r\n\r\n    Args:\r\n        df: Input DataFrame with transaction data\r\n\r\n    Returns:\r\n        Tuple containing:\r\n        - Summary DataFrame with transaction statistics\r\n        - Dictionary with metadata about boolean columns\r\n    \"\"\"\r\n    # Get boolean columns using pyarrow dtypes\r\n    bool_cols = df.select_dtypes(include=[\"boolean[pyarrow]\"]).columns.tolist()\r\n\r\n    # Calculate summary statistics\r\n    # Using Copy-on-Write, this won't create unnecessary copies\r\n    summary = pd.DataFrame(\r\n        {\r\n            \"amount\": [df[\"amount\"].sum(), df[\"amount\"].mean()],\r\n            \"approval_rate\": [df[bool_cols[0]].mean() if bool_cols else np.nan] * 2,\r\n        },\r\n        index=[\"sum\", \"mean\"],\r\n    )\r\n\r\n    return summary, {\"bool_columns\": bool_cols}\r\n\r\n\r\ndef analyze_customer_segments(df: pd.DataFrame) -> Tuple[pd.DataFrame, list]:"]
[354.527868, "o", "\r\n"]
[354.527979, "o", "    \"\"\"Analyze customer segments with advanced pandas 2.0 features."]
[354.528108, "o", "\r\n"]
[354.528216, "o", "\r\n"]
[354.528323, "o", "    Args:"]
[354.528448, "o", "\r\n"]
[354.528745, "o", "        df: Input DataFrame with transaction data\r\n\r\n    Returns:\r\n        Tuple containing:\r\n        - DataFrame with segment statistics\r\n        - List of boolean column names\r\n    \"\"\"\r\n\r\n    bool_cols = [col for col in df.columns if str(df[col].dtype) == \"bool[pyarrow]\"]\r\n\r\n    # Group by customer segment and calculate statistics\r\n    # Copy-on-Write ensures efficient operations\r\n    stats = df.groupby(\"segment\").agg(\r\n        {\r\n            \"amount\": [\"sum\", \"mean\"],\r\n            \"category\": lambda x: x.mode()[0] if not x.empty else None,\r\n            **{col: \"mean\" for col in bool_cols},\r\n        }\r\n    )\r\n    return stats, bool_cols\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    df = load_sample_transactions()\r\n    print(df.head())\r\n"]
[354.529315, "m", "Episode 5: 2 commands"]
[354.529315, "o", "\u001b[?2004hroot@4fb3cd09063d:/app# "]
[362.420487, "i", "cat /app/src/data_loader.py\n"]
[362.42485, "o", "cat /app/src/data_loader.py\r\n\u001b[?2004l\r"]
[362.443202, "o", "import io\r\n\r\nimport pandas as pd  # type: ignore\r\n\r\n\r\ndef load_sample_transactions() -> pd.DataFrame:\r\n    \"\"\"Load sample transaction data with various pandas 2.0 features.\r\n\r\n    Returns:\r\n        DataFrame with sample transaction data using pyarrow dtypes\r\n    \"\"\"\r\n    # Create sample data with mixed date formats and types\r\n    data = io.StringIO(\r\n        \"\"\"\r\ntransaction_id,customer_id,amount,is_approved,category,segment,transaction_date,processing_date\r\n1,101,100.50,true,food,1,2023-01-15,Jan 15 2023\r\n2,102,75.25,false,travel,2,2023/02/20,20-Feb-2023\r\n3,103,50.75,true,electronics,3,2023.03.25,25 March 2023\r\n4,101,150.00,true,food,1,2023-04-10,10 Apr 2023\r\n5,102,200.00,false,travel,2,2023/05/15,15-May-2023\r\n6,103,300.00,true,electronics,3,2023.06.20,20 June 2023\r\n\"\"\".strip()\r\n    )\r\n\r\n    # Use pandas 2.0 features for loading\r\n    df = pd.read_csv(\r\n        data,\r\n        dtype_backend=\"pyarrow\",\r\n        date_format=\"mixed\",  # New in pandas 2.0: handles multiple date formats\r\n    )\r\n\r\n    # Convert date"]
[362.443563, "o", " columns using the new mixed format parser\r\n    date_cols = [\"transaction_date\", \"processing_date\"]\r\n    for col in date_cols:\r\n        if col in df.columns:\r\n            df[col] = pd.to_datetime(df[col], format=\"mixed\")\r\n\r\n    return df\r\n\r\n\r\ndata = io.StringIO(\r\n    \"\"\"\r\nid,name,value,valid\r\n1,John,10.5,true\r\n2,Jane,20.3,false\r\n3,,30.1,\r\n\"\"\".strip()\r\n)\r\n\r\ndf = pd.read_csv(data)\r\n\r\nprint(df)\r\n"]
