[24.377067, "o", "\r\n"]
[24.377443, "o", "\r\n"]
[24.377724, "o", "name = 'pyarrow', extra = '', errors = 'raise', min_version = None"]
[24.377926, "o", "\r\n"]
[24.378127, "o", "\r\n"]
[24.378983, "o", "    def import_optional_dependency("]
[24.379187, "o", "\r\n"]
[24.379415, "o", "        name: str,"]
[24.379599, "o", "\r\n"]
[24.379806, "o", "        extra: str = \"\","]
[24.38001, "o", "\r\n"]
[24.380213, "o", "        errors: str = \"raise\","]
[24.380419, "o", "\r\n"]
[24.380622, "o", "        min_version: str | None = None,"]
[24.380803, "o", "\r\n"]
[24.381028, "o", "    ):"]
[24.381208, "o", "\r\n"]
[24.381451, "o", "        \"\"\""]
[24.38164, "o", "\r\n"]
[24.381877, "o", "        Import an optional dependency."]
[24.382153, "o", "\r\n"]
[24.382375, "o", "    "]
[24.382561, "o", "\r\n"]
[24.382771, "o", "        By default, if a dependency is missing an ImportError with a nice"]
[24.383016, "o", "\r\n"]
[24.38322, "o", "        message will be raised. If a dependency is present, but too old,"]
[24.383385, "o", "\r\n"]
[24.383591, "o", "        we raise."]
[24.383734, "o", "\r\n"]
[24.383958, "o", "    "]
[24.384162, "o", "\r\n"]
[24.384386, "o", "        Parameters"]
[24.386382, "o", "\r\n"]
[24.386701, "o", "        ----------"]
[24.386901, "o", "\r\n"]
[24.387112, "o", "        name : str"]
[24.387319, "o", "\r\n"]
[24.387529, "o", "            The module name."]
[24.387716, "o", "\r\n"]
[24.387942, "o", "        extra : str"]
[24.388124, "o", "\r\n"]
[24.388353, "o", "            Additional text to include in the ImportError message."]
[24.388541, "o", "\r\n"]
[24.388756, "o", "        errors : str {'raise', 'warn', 'ignore'}"]
[24.38896, "o", "\r\n"]
[24.389169, "o", "            What to do when a dependency is not found or its version is too old."]
[24.389382, "o", "\r\n"]
[24.389588, "o", "    "]
[24.389777, "o", "\r\n"]
[24.39, "o", "            * raise : Raise an ImportError"]
[24.390185, "o", "\r\n"]
[24.390667, "o", "            * warn : Only applicable when a module's version is to old."]
[24.391364, "o", "\r\n"]
[24.391613, "o", "              Warns that the version is too old and returns None"]
[24.392121, "o", "\r\n"]
[24.392658, "o", "            * ignore: If the module is not installed, return None, otherwise,"]
[24.39304, "o", "\r\n"]
[24.394058, "o", "              return the module, even if the version is too old."]
[24.394455, "o", "\r\n"]
[24.395044, "o", "              It's expected that users validate the version locally when"]
[24.395227, "o", "\r\n"]
[24.397372, "o", "              using ``errors=\"ignore\"`` (see. ``io/html.py``)"]
[24.397663, "o", "\r\n"]
[24.397916, "o", "        min_version : str, default None"]
[24.398102, "o", "\r\n"]
[24.398331, "o", "            Specify a minimum version that is different from the global pandas"]
[24.398866, "o", "\r\n"]
[24.399203, "o", "            minimum version required."]
[24.399411, "o", "\r\n"]
[24.39962, "o", "        Returns"]
[24.399767, "o", "\r\n"]
[24.399991, "o", "        -------"]
[24.400182, "o", "\r\n"]
[24.400427, "o", "        maybe_module : Optional[ModuleType]\r\n"]
[24.400627, "o", "            The imported module, when found and the version is correct."]
[24.400823, "o", "\r\n"]
[24.401053, "o", "            None is returned when the package is not found and `errors`"]
[24.401237, "o", "\r\n"]
[24.401475, "o", "            is False, or when the package's version is too old and `errors`"]
[24.401664, "o", "\r\n"]
[24.40189, "o", "            is ``'warn'``."]
[24.403225, "o", "\r\n"]
[24.409745, "o", "        \"\"\""]
[24.409955, "o", "\r\n"]
[24.410161, "o", "    "]
[24.41037, "o", "\r\n"]
[24.410596, "o", "        assert errors in {\"warn\", \"raise\", \"ignore\"}"]
[24.410791, "o", "\r\n"]
[24.411013, "o", "    "]
[24.411203, "o", "\r\n"]
[24.411443, "o", "        package_name = INSTALL_MAPPING.get(name)"]
[24.413317, "o", "\r\n"]
[24.41382, "o", "        install_name = package_name if package_name is not None else name"]
[24.414022, "o", "\r\n"]
[24.414226, "o", "    "]
[24.414434, "o", "\r\n"]
[24.414642, "o", "        msg = ("]
[24.414879, "o", "\r\n"]
[24.415333, "o", "            f\"Missing optional dependency '{install_name}'. {extra} \""]
[24.415522, "o", "\r\n"]
[24.415733, "o", "            f\"Use pip or conda to install {install_name}.\""]
[24.415937, "o", "\r\n"]
[24.416173, "o", "        )"]
[24.41637, "o", "\r\n"]
[24.416547, "o", "        try:"]
[24.416732, "o", "\r\n"]
[24.416921, "o", "            module = importlib.import_module(name)"]
[24.417082, "o", "\r\n"]
[24.41723, "o", "        except ImportError:"]
[24.419383, "o", "\r\n"]
[24.419589, "o", "            if errors == \"raise\":"]
[24.419672, "o", "\r\n"]
[24.419875, "o", "                raise ImportError(msg)\r\n"]
[24.42034, "o", "            return None\r\n    \r\n        # Handle submodules: if we have submodule, grab parent module from sys.modules\r\n        parent = name.split(\".\")[0]\r\n        if parent != name:\r\n            install_name = parent\r\n            module_to_get = sys.modules[install_name]\r\n        else:\r\n            module_to_get = module\r\n        minimum_version = min_version if min_version is not None else VERSIONS.get(parent)\r\n        if minimum_version:\r\n            version = get_version(module_to_get)\r\n            if version and Version(version) < Version(minimum_version):\r\n                msg = (\r\n                    f\"Pandas requires version '{minimum_version}' or newer of '{parent}' \"\r\n"]
