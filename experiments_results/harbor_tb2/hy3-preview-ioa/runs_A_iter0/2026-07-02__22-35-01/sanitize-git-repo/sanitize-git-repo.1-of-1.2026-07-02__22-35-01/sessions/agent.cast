[163.908307, "o", "    'hf_abcdefghijklmnopqrstuvwxyz123456': '<your-huggingface-token>',\r\n\u001b[?2004l\r"]
[163.908481, "o", "\u001b[?2004h> "]
[163.908556, "o", "}\r\n\u001b[?2004l\r"]
[163.908764, "o", "\u001b[?2004h"]
[163.90883, "o", "> "]
[163.909295, "o", "files = ['ray_processing/process.py', 'ray_processing/ray_cluster.yaml']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.909387, "o", "for f in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.909527, "o", "    with open(f) as fh:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.90962, "o", "        s = fh.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.909929, "o", "    for k, v in replacements.items():"]
[163.910079, "o", "\r\n"]
[163.910231, "o", "\u001b[?2004l\r"]
[163.910366, "o", "\u001b[?2004h"]
[163.910516, "o", "> "]
[163.910558, "o", "        s = s.replace(k, v)\r\n\u001b[?2004l\r"]
[163.910566, "o", "\u001b[?2004h"]
[163.910715, "o", "> "]
[163.911278, "o", "    with open(f, 'w') as fh:"]
[163.911415, "o", "\r\n\u001b[?2004l\r"]
[163.911549, "o", "\u001b[?2004h> "]
[163.911678, "o", "        fh.write(s)\r\n\u001b[?2004l\r"]
[163.911809, "o", "\u001b[?2004h"]
[163.911955, "o", "> "]
[163.912229, "o", "    print('processed', f)\r\n"]
[163.912587, "o", "\u001b[?2004l\r"]
[163.914347, "o", "\u001b[?2004h"]
[163.914596, "o", "> "]
