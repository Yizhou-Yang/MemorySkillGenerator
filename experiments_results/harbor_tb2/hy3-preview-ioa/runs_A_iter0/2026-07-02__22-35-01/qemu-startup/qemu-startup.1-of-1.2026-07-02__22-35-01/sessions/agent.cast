[455.839591, "i", "cat > /app/probe.py << 'PYEOF'\nimport socket\ns = socket.create_connection(('127.0.0.1', 6665), timeout=5)\ns.settimeout(3.0)\ndata = b''\ntry:\n    while True:\n        d = s.recv(4096)\n        if not d: break\n        data += d\nexcept Exception:\n    pass\nprint('RECV_BYTES', len(data))\nprint(repr(data[-800:]))\ns.close()\nPYEOF\npython3 /app/probe.py; echo PROBE_DONE\n"]
