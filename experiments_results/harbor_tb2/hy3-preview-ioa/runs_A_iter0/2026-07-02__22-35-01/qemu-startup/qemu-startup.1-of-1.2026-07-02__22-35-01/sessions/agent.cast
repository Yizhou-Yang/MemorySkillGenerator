[251.801526, "i", "cat > /app/serial_proxy.py << 'PYEOF'\nimport socket, threading, time\n\nQEMU_SOCK = '/tmp/qemu-serial.sock'\nHOST = '127.0.0.1'\nPORT = 6665\nLOG = '/app/serial.log'\n\nlogf = open(LOG, 'ab', buffering=0)\nbuf = bytearray()\nbuf_lock = threading.Lock()\nclients = []\nqemu = None\n\ndef connect_qemu():\n    while True:\n        try:\n            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n            s.connect(QEMU_SOCK)\n            return s\n        except Exception:\n            time.sleep(0.2)\n\ndef qemu_reader():\n    global qemu\n    qemu = connect_qemu()\n    while True:\n        try:\n            data = qemu.recv(4096)\n        except Exception:\n            break\n        if not data:\n            break\n        with buf_lock:\n            buf.extend(data)\n        try:\n            logf.write(data)\n        except Exception:\n            pass\n        for c in list(clients):\n            try:\n                c.sendall(data)\n            except Exception:\n                pass\n\ndef handle_client(conn):\n    global qemu\n    with bu"]
[251.801773, "i", "f_lock:\n        hist = bytes(buf)\n    try:\n        conn.sendall(hist)\n    except Exception:\n        return\n    while qemu is None:\n        time.sleep(0.1)\n    while True:\n        try:\n            d = conn.recv(4096)\n        except Exception:\n            break\n        if not d:\n            break\n        try:\n            qemu.sendall(d)\n        except Exception:\n            break\n\ndef server():\n    ls = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n    ls.bind((HOST, PORT))\n    ls.listen(5)\n    while True:\n        conn, addr = ls.accept()\n        clients.append(conn)\n        threading.Thread(target=handle_client, args=(conn,), daemon=True).start()\n\nthreading.Thread(target=qemu_reader, daemon=True).start()\nserver()\nPYEOF\n"]
