[68.935527, "i", "cat > /app/processor.py << 'PYEOF'\nimport csv\nimport json\nfrom datetime import datetime\n\nBASE = \"/app/data\"\n\ndepartments = {}\nwith open(BASE + \"/departments.csv\", newline=\"\") as f:\n    for row in csv.DictReader(f):\n        departments[row[\"id\"]] = {\n            \"id\": row[\"id\"],\n            \"name\": row[\"name\"],\n            \"budget\": float(row[\"budget\"]),\n            \"employees\": [],\n            \"projects\": []\n        }\n\nwith open(BASE + \"/employees.csv\", newline=\"\") as f:\n    for row in csv.DictReader(f):\n        emp = {\n            \"id\": row[\"id\"],\n            \"name\": row[\"name\"],\n            \"position\": row[\"position\"],\n            \"skills\": [s.strip() for s in row[\"skills\"].split(\";\") if s.strip()],\n            \"years_of_service\": int(row[\"years_of_service\"])\n        }\n        dep = departments.get(row[\"department_id\"])\n        if dep:\n            dep[\"employees\"].append(emp)\n\nwith open(BASE + \"/projects.csv\", newline=\"\") as f:\n    for row in csv.DictReader(f)"]
[68.93606, "o", "cat > /app/processor.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.936163, "o", "> "]
[68.936245, "o", "from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.936338, "i", ":\n        proj = {\n            \"name\": row[\"name\"],\n            \"status\": row[\"status\"],\n            \"members\": [m.strip() for m in row[\"member_ids\"].split(\";\") if m.strip()],\n            \"deadline\": row[\"deadline\"]\n        }\n        dep = departments.get(row[\"department_id\"])\n        if dep:\n            dep[\"projects\"].append(proj)\n\ndepts_list = list(departments.values())\n\nbudgets = [d[\"budget\"] for d in depts_list]\naverageDepartmentBudget = round(sum(budgets) / len(budgets), 2)\ntotalEmployees = sum(len(d[\"employees\"]) for d in depts_list)\n\nskillDistribution = {}\nfor d in depts_list:\n    for e in d[\"employees\"]:\n        for s in e[\"skills\"]:\n            skillDistribution[s] = skillDistribution.get(s, 0) + 1\n\ndepartmentSizes = {}\nfor d in depts_list:\n    departmentSizes[d[\"name\"]] = len(d[\"employees\"])\n\nprojectStatusDistribution = {}\nfor d in depts_list:\n    for p in d[\"projects\"]:\n        projectStatusDistribution[p[\"status\"]] = projectStatusDistribution.get(p[\"status\"], 0) + 1\n\nall_years = [e[\"years_of_serv"]
[68.936958, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> BASE = \"/app/data\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.937084, "i", "ice\"] for d in depts_list for e in d[\"employees\"]]\naverageYearsOfService = round(sum(all_years) / len(all_years), 2)\n\noutput = {\n    \"metadata\": {\n        \"version\": \"1.0\",\n        \"timestamp\": datetime.now().isoformat(),\n        \"generator\": \"CSV-to-JSON Processor\"\n    },\n    \"organization\": {\n        \"name\": \"Acme Corporation\",\n        \"founded\": \"2000-01-01\",\n        \"departments\": depts_list\n    },\n    \"statistics\": {\n        \"averageDepartmentBudget\": averageDepartmentBudget,\n        \"totalEmployees\": totalEmployees,\n        \"skillDistribution\": skillDistribution,\n        \"departmentSizes\": departmentSizes,\n        \"projectStatusDistribution\": projectStatusDistribution,\n        \"averageYearsOfService\": averageYearsOfService\n    }\n}\n\nwith open(\"/app/organization.json\", \"w\") as f:\n    json.dump(output, f, indent=2)\n\nprint(\"Done\")\nPYEOF\n"]
