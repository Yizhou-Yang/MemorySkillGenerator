[54.243721, "i", "cat > scraper.py << 'EOF'\nimport re\nimport requests\nfrom bs4 import BeautifulSoup\nimport pandas as pd\n\nURL = \"http://server:8000\"\n\ndef extract_number(text):\n    m = re.search(r\"[-+]?\\d+(?:\\.\\d+)?\", text)\n    return m.group() if m else None\n\ndef scrape():\n    resp = requests.get(URL, timeout=30)\n    resp.raise_for_status()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n    books = []\n    for book in soup.select(\"div.book\"):\n        title_el = book.select_one(\"div.book-title\")\n        author_el = book.select_one(\"div.book-author\")\n        year_el = book.select_one(\"span.book-year\")\n        rating_el = book.select_one(\"span.book-rating\")\n        price_el = book.select_one(\"span.book-price\")\n\n        title = title_el.get_text(strip=True) if title_el else \"\"\n        author = \"\"\n        if author_el:\n            author = re.sub(r\"^by\\s+\", \"\", author_el.get_text(strip=True))\n\n        year = int(extract_number(year_el.get_text())) if year_el else None\n        rating"]
[54.243868, "o", "cat > scraper.py << 'EOF'"]
[54.243916, "o", "\r\n"]
[54.243974, "o", "\u001b[?2004l\r"]
[54.2442, "o", "\u001b[?2004h"]
[54.24423, "o", "> import re\r\n"]
[54.244269, "o", "\u001b[?2004l\r"]
[54.244336, "o", "\u001b[?2004h"]
[54.24439, "o", "> "]
[54.244991, "o", "import requests\r\n\u001b[?2004l\r\u001b[?2004h> from bs4 import BeautifulSoup\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> URL = \"http://server:8000\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def extract_number(text):"]
[54.245021, "i", " = float(extract_number(rating_el.get_text())) if rating_el else None\n        price = float(extract_number(price_el.get_text())) if price_el else None\n\n        books.append({\n            \"title\": title,\n            \"author\": author,\n            \"year\": year,\n            \"rating\": rating,\n            \"price\": price,\n        })\n    return books\n\ndef main():\n    books = scrape()\n    df = pd.DataFrame(books, columns=[\"title\", \"author\", \"year\", \"rating\", \"price\"])\n    df.to_csv(\"books.csv\", index=False)\n\n    total = len(df)\n    avg_price = df[\"price\"].mean()\n    highest = df.loc[df[\"rating\"].idxmax()]\n\n    lines = []\n    lines.append(\"Book Store Scraper - Summary Report\")\n    lines.append(\"=\" * 40)\n    lines.append(f\"Total number of books scraped: {total}\")\n    lines.append(f\"Average book price: ${avg_price:.2f}\")\n    lines.append(f\"Highest rated book: {highest['title']} by {highest['author']} (Rating: {highest['rating']}/5)\")\n\n    with open(\"report.txt\", \"w\") as f:\n        f.write(\"\\n\".join(lines) + \"\\n\")\n\n    pr"]
[54.24506, "i", "int(\"\\n\".join(lines))\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
