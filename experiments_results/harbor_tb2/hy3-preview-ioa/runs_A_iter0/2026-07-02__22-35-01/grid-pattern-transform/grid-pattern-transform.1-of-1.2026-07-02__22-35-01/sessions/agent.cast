[71.423734, "o", "):\r\n\u001b[?2004l\r\u001b[?2004h>         # Even block-rows use the input; odd block-rows use the input\r\n\u001b[?2004l\r\u001b[?2004h>         # rotated 90 degrees clockwise.\r\n\u001b[?2004l\r\u001b[?2004h>         block = rotate90(input_grid) if br % 2 == 1 else input_grid\r\n\u001b[?2004l\r\u001b[?2004h>         for bc in range(n_blocks):\r\n\u001b[?2004l\r\u001b[?2004h>             for i in range(height):\r\n\u001b[?2004l\r\u001b[?2004h>                 for j in range(width):\r\n\u001b[?2004l\r\u001b[?2004h>                     output_grid[br * height + i][bc * width + j] = block[i][j]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return output_grid\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
