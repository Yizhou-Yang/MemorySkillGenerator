[71.422018, "i", "cat > /app/grid_transform.py << 'EOF'\nimport numpy as np\n\n\ndef solve(input_grid):\n    \"\"\"\n    Transform the input grid according to the pattern.\n    \"\"\"\n    height = len(input_grid)\n    width = len(input_grid[0])\n\n    # Output is 3x3 tiling of 2x2 blocks (2x2 input -> 6x6 output)\n    n_blocks = 3\n\n    output_grid = [[0 for _ in range(width * n_blocks)]\n                   for _ in range(height * n_blocks)]\n\n    def rotate90(grid):\n        h = len(grid)\n        w = len(grid[0])\n        return [[grid[h - 1 - j][i] for j in range(w)] for i in range(w)]\n\n    for br in range(n_blocks):\n        # Even block-rows use the input; odd block-rows use the input\n        # rotated 90 degrees clockwise.\n        block = rotate90(input_grid) if br % 2 == 1 else input_grid\n        for bc in range(n_blocks):\n            for i in range(height):\n                for j in range(width):\n                    output_grid[br * height + i][bc * width + j] = block[i][j]\n\n    return output_grid\nEOF\n"]
