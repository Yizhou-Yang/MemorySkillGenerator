[455.755846, "i", "cat > /app/count.py << 'EOF'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\nimport sys\n\ntok = AutoTokenizer.from_pretrained(\"Qwen/Qwen2.5-1.5B-Instruct\", use_fast=True)\n\nds = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\", streaming=True)\n\ntotal = 0\nn = 0\nreason_total = 0\nsol_total = 0\nfor ex in ds:\n    if ex.get(\"domain\") == \"science\":\n        r = ex.get(\"deepseek_reasoning\") or \"\"\n        s = ex.get(\"deepseek_solution\") or \"\"\n        if r:\n            reason_total += len(tok(r, add_special_tokens=False)[\"input_ids\"])\n        if s:\n            sol_total += len(tok(s, add_special_tokens=False)[\"input_ids\"])\n        n += 1\n    total += 1\n    if total % 10000 == 0:\n        print(f\"processed {total} rows, science so far={n}, combined={reason_total+sol_total}\", flush=True)\n\ncombined = reason_total + sol_total\nprint(\"TOTAL rows:\", total, flush=True)\nprint(\"science rows:\", n, flush=True)\nprint(\"reasoning tokens:\", reason_total, flush=True)\nprint(\"solution tokens:"]
[455.756145, "o", "cat > /app/count.py << 'EOF'"]
[455.756269, "i", "\", sol_total, flush=True)\nprint(\"COMBINED deepseek tokens:\", combined, flush=True)\n\nwith open(\"/app/answer.txt\", \"w\") as f:\n    f.write(str(combined))\n    f.flush()\nprint(\"WROTE answer.txt\", flush=True)\nsys.exit(0)\nEOF\necho done\n"]
