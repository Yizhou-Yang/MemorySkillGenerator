[259.009098, "i", "cat > /app/inspect.py << 'EOF'\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\n\ntok = AutoTokenizer.from_pretrained(\"Qwen/Qwen2.5-1.5B-Instruct\", use_fast=True)\nprint(\"tokenizer loaded, vocab\", len(tok))\n\nds = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\", streaming=True)\nfor i, ex in enumerate(ds):\n    if i == 0:\n        print(\"KEYS:\", list(ex.keys()))\n        print(\"DOMAIN:\", ex.get(\"domain\"))\n        print(\"reasoning[:200]:\", repr(ex.get(\"deepseek_reasoning\")[:200]))\n        print(\"solution[:200]:\", repr(ex.get(\"deepseek_solution\")[:200]))\n    if i < 5:\n        print(\"row\", i, \"domain=\", ex.get(\"domain\"))\n    if i >= 5:\n        break\nEOF\npython3 /app/inspect.py\n"]
