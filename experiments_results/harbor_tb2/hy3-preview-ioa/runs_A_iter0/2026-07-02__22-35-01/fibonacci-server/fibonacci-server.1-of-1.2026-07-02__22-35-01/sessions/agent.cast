[44.23917, "i", "python3 -c \"\nimport urllib.request, urllib.error, json\ndef test(q):\n    try:\n        r=urllib.request.urlopen('http://localhost:3000'+q)\n        print(q, r.status, r.read().decode())\n    except urllib.error.HTTPError as e:\n        print(q, e.code, e.read().decode())\nfor q in ['/fib?n=10','/fib','/fib?n=abc','/fib?n=0','/fib?n=1']:\n    test(q)\n\"\n"]
[44.246749, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request, urllib.error, json\r\n\u001b[?2004l\r\u001b[?2004h> def test(q):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         r=urllib.request.urlopen('http://localhost:3000'+q)\r\n\u001b[?2004l\r\u001b[?2004h>         print(q, r.status, r.read().decode())\r\n\u001b[?2004l\r\u001b[?2004h>     except urllib.error.HTTPError as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(q, e.code, e.read().decode())\r\n\u001b[?2004l\r\u001b[?2004h> for q in ['/fib?n=10','/fib','/fib?n=abc','/fib?n=0','/fib?n=1']:\r\n\u001b[?2004l\r\u001b[?2004h>     test(q)\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
