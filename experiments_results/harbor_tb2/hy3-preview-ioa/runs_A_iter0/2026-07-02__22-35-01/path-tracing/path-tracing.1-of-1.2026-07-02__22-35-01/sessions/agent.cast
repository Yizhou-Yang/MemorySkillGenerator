[184.899611, "i", "cat > /tmp/grid.py << 'EOF'\nimport sys\nf=open('image.ppm','rb')\nf.read(15)\ndata=f.read()\nw,h=800,600\nGW,GH=80,60\ndef cell(cx,cy):\n    # sum over a GWxGH block\n    xs=cx*GW; ys=cy*GH\n    R=G=B=0;n=0\n    for y in range(ys,min(ys+GH,h)):\n        for x in range(xs,min(xs+GW,w)):\n            o=(y*w+x)*3\n            R+=data[o];G+=data[o+1];B+=data[o+2];n+=1\n    return R//n,G//n,B//n\nfor cy in range(GH):\n    row=[]\n    for cx in range(GW):\n        r,g,b=cell(cx,cy)\n        # encode as letter by luminance\n        L=(r+g+b)//3\n        row.append('%3d'%(L))\n    print(''.join(row))\nEOF\npython3 /tmp/grid.py\n"]
