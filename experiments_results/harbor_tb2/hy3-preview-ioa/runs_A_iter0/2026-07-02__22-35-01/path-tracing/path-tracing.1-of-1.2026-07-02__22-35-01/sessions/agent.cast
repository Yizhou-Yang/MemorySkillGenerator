[414.050894, "i", "cat > /tmp/m3.py << 'EOF'\nimport sys\nf=open('image.ppm','rb'); f.read(15)\ndata=f.read(); w,h=800,600\ndef px(x,y):\n    o=(y*w+x)*3; return data[o],data[o+1],data[o+2]\n# horizon at several columns: first non-sky pixel\ndef is_sky(r,g,b):\n    return b>245 and r<210 and g<210 and (r-g)<40 and (g-b)<-40\ndef horizon(x):\n    for y in range(h):\n        r,g,b=px(x,y)\n        if not is_sky(r,g,b): return y\n    return -1\nfor x in [10,200,400,600,790]:\n    print('col',x,'horizon y=',horizon(x))\n# sphere shading across center row y=312\nprint('sphere horiz at y=312:')\nfor x in range(375,461,5):\n    print(x,px(x,312))\n# checkerboard at bottom row y=560\nprint('checker y=560 (luminance):')\nl=[(r+g+b)//3 for (r,g,b) in (px(x,560) for x in range(0,800,4))]\nprint(l)\nEOF\npython3 /tmp/m3.py\n"]
[414.055696, "o", "cat > /tmp/m3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> f=open('image.ppm','rb'); f.read(15)\r\n\u001b[?2004l\r\u001b[?2004h> data=f.read(); w,h=800,600\r\n\u001b[?2004l\r\u001b[?2004h> def px(x,y):\r\n\u001b[?2004l\r\u001b[?2004h>     o=(y*w+x)*3; return data[o],data[o+1],data[o+2]\r\n\u001b[?2004l\r\u001b[?2004h> # horizon at several columns: first non-sky pixel\r\n\u001b[?2004l\r\u001b[?2004h> def is_sky(r,g,b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[414.05623, "o", "    return b>245 and r<210 and g<210 and (r-g)<40 and (g-b)<-40"]
[414.056434, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
