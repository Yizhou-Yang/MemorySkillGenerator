[31.296692, "i", "cat > /tmp/analyze.py << 'EOF'\nimport struct\nf=open('image.ppm','rb')\nhdr=f.read(15)\ndata=f.read()\nprint('header',hdr)\nw,h=800,600\n# reshape\npx=[data[i:i+3] for i in range(0,len(data),3)]\nprint('npix',len(px))\n# row means\nfor r in range(0,600,50):\n    row=px[r*800:(r+1)*800]\n    rs=sum(p[0] for p in row)/800\n    gs=sum(p[1] for p in row)/800\n    bs=sum(p[2] for p in row)/800\n    print('row',r,'R',round(rs,1),'G',round(gs,1),'B',round(bs,1))\nEOF\npython3 /tmp/analyze.py\n"]
