[535.906984, "i", "cat > /tmp/m4.py << 'EOF'\nimport sys\nf=open('image.ppm','rb'); f.read(15)\ndata=f.read(); w,h=800,600\ndef px(x,y):\n    o=(y*w+x)*3; return data[o],data[o+1],data[o+2]\ndef is_sky(r,g,b):\n    return b==255 and r<g and g<255 and r>100\n# horizon curve at all columns (skip sphere x-range 360-480)\nhz={}\nfor x in range(0,800):\n    hz[x]=-1\n    for y in range(h):\n        r,g,b=px(x,y)\n        if not is_sky(r,g,b):\n            hz[x]=y; break\n# print sampled\nprint('x  horizonY')\nfor x in range(0,800,40):\n    print(x,hz[x])\n# dir.y check at column 10\nprint('col10 sky dir.y:')\nfor y in range(0,200,20):\n    r,g,b=px(10,y)\n    t=(255-r)/127.5\n    print(y,'R',r,'t',round(t,3),'diry',round(2*t-1,3))\n# sphere box precise\nminx=miny=999;maxx=maxy=-1\nfor y in range(h):\n    for x in range(w):\n        r,g,b=px(x,y)\n        if r>80 and r-b>40 and g<80:\n            minx=min(minx,x);maxx=max(maxx,x);miny=min(miny,y);maxy=max(maxy,y)\nprint('sphere box x',minx,maxx,'y',miny,maxy)\nprint('ce"]
