[234.664944, "o", "....................................................................................................\r\n....................................................................................................\r\n....................................................................................................\r\n....................................................................................................\r\n....................................................................................................\r\n....................................................................................................\r\n....................................................................................................\r\n?????............................................??...........................................??????\r\n????????????????????????????..................?RRRRRR?..................????????????????????????????\r\n?????????????????????????????????????????????RRRRRRRRRR?????????????????????????????????????????????\r\n????????????????????????????????????????????RRRRRRRRRRRR????????????????????????????????????????????\r\n:::::#:::::::::::::::::::::::::::::::::::::RRRRRRRRRRRRRR::::::::::::::::::::::::::::::::::::::#::::\r\n:::::::::#::#::#:::::::::::::::::::::::::::RRRRRRRRRRRRRR:::::::::::::::::::::::::::::#::#::::::::::\r\n:#::#::::#::#::#::::#::#::#::::::::::#::::?RRRRRRRRRRRRRR:::::::::#::#:::::::#::#::#::::#::#::#::::#\r\n#:::#:::#:::#:::#:::#:::#:::#:::##::##::##RRRRRRRRRRRRRRRR::##::##::##:::#:::#:::#:::#:::#:::#:::#::\r\n:##::::##:::##:::###:::##:::###:::##:::###RRRRRRRRRRRRRRRR:::##:::###:::##:::###:::##::::##:::##::::\r\n:::###::::###::::##::::###::::###::::###::RRRRRRRRRRRRRRR?##:::####:::###::::###::::###::::##::::###\r\n::###:::::###:::::###:::::####::::####::::#RRRRRRRRRRRRRR:####::::####::::####::::####:::::###:::::#\r\n::::::::::::#:::#::::::::::::::::::#:::::::RRRRRRRRRRRRRR::#::::::::::::::::::::::::::::#:::::::::::\r\n::::::::::::#::::::::::::::::::::::::::::::?RRRRRRRRRRRR#:::::::::::::::::::::::::::::::::::::::::::\r\n#:::::::######::::::######::::::######::::::RRRRRRRRRRRR######::::::######::::::######::::::######::\r\n###:::::::######:::::::#######:::::::######::RRRRRRRRR?##::::::#######:::::::######:::::::#######:::\r\n::::::#######::::::::#######:::::::######::::::RRRRRR####::::::::#######::::::::#######:::::::######\r\n##::::::::########::::::::########::::::::::::::::::::::::########::::::::########::::::::########::\r\n:::::::########:::::::::########:::::::::::::::::::::::::::########:::::::::#########:::::::::######\r\n::::::::::::#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::\r\n::::::::::##########:::::::::::::::::::::::::::::::#########::::::::::##########::::::::::##########\r\n:::::::###########::::::::::::::::::::::::::::::::###########::::::::::###########:::::::::::#######\r\n:::::###########::::::::::::::::::::::::::::::::::###########::::::::::::###########::::::::::::####\r\n::############::::::::::::::::::::::::::::::::::::############::::::::::::############::::::::::::##\r\n::::::::::::########:::::::::::::::::::::#########:::::::::::::############:::::::::::::############\r\n::::::::::##########:::::::::::::::::#############:::::::::::::##############:::::::::::::##########\r\n::::::::#############:::::::::::::::##############::::::::::::::##############::::::::::::::########\r\n::::::##############:::::::::::::::###############:::::::::::::::##############:::::::::::::::######\r\n::::###############::::::::::::::::###############:::::::::::::::################:::::::::::::::####\r\n::################::::::::::::::::################::::::::::::::::################::::::::::::::::##\r\n################:::::::::::::::::#################:::::::::::::::::################:::::::::::::::::\r\n###############::::::::::::::::::#################:::::::::::::::::##################:::::::::::::::\r\n##############::::::::::::::::::##################::::::::::::::::::##################::::::::::::::\r\n############:::::::::::::::::::###################:::::::::::::::::::##################:::::::::::::\r\n:::::::::::####"]
