[319.926131, "i", "cat > /tmp/meas.py << 'EOF'\nimport sys\nf=open('image.ppm','rb')\nf.read(15)\ndata=f.read()\nw,h=800,600\ndef px(x,y):\n    o=(y*w+x)*3\n    return data[o],data[o+1],data[o+2]\n# find red sphere box\nx0=y0=x1=y1=-1\nfor y in range(h):\n    for x in range(w):\n        r,g,b=px(x,y)\n        if r>80 and r-b>40 and g<80:\n            if x0<0: x0=x0\n            if x0<0: x0=x\n            x0=min(x0,x) if x0>=0 else x\n# simpler:\nminx=miny=999; maxx=maxy=-1\ncnt=0\nfor y in range(h):\n    for x in range(w):\n        r,g,b=px(x,y)\n        if r>80 and r-b>40 and g<80:\n            minx=min(minx,x);maxx=max(maxx,x)\n            miny=min(miny,y);maxy=max(maxy,y)\n            cnt+=1\nprint('sphere box x',minx,maxx,'y',miny,maxy,'count',cnt)\nprint('center',(minx+maxx)/2,(miny+maxy)/2,'rx',(maxx-minx)/2,'ry',(maxy-miny)/2)\n# horizon at column 200\ndef is_sky(r,g,b):\n    return b>240 and abs(r-g)<40 and r<230\nyh=-1\nfor y in range(h):\n    r,g,b=px(200,y)\n    if not is_sky(r,g,b):\n        yh=y;break\npr"]
[319.929235, "o", "cat > /tmp/meas.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> f=open('image.ppm','rb')\r\n\u001b[?2004l\r\u001b[?2004h> f.read(15)\r\n\u001b[?2004l\r\u001b[?2004h> data=f.read()\r\n\u001b[?2004l\r\u001b[?2004h> w,h=800,600\r\n\u001b[?2004l\r\u001b[?2004h> def px(x,y):\r\n\u001b[?2004l\r\u001b[?2004h>     o=(y*w+x)*3\r\n\u001b[?2004l\r\u001b[?2004h>     return data[o],data[o+1],data[o+2]\r\n\u001b[?2004l\r\u001b[?2004h> # find red sphere box\r\n\u001b[?2004l\r\u001b[?2004h> x0=y0=x1=y1=-1\r\n\u001b[?2004l\r\u001b[?2004h> for y in range(h):\r\n\u001b[?2004l\r\u001b[?2004h>     for x in range(w):\r\n\u001b[?2004l\r\u001b[?2004h>         r,g,b=px(x,y)\r\n\u001b[?2004l\r\u001b[?2004h>         if r>80 and r-b>40 and g<80:\r\n\u001b[?2004l\r\u001b[?2004h>             if x0<0: x0=x0\r\n\u001b[?2004l\r\u001b[?2004h>             if x0<0: x0=x\r\n\u001b[?2004l\r\u001b[?2004h>             x0=min(x0,x) if x0>=0 else x\r\n\u001b[?2004l\r\u001b[?2004h> # simpler:\r\n\u001b[?2004l\r\u001b[?2004h> minx=miny=999; maxx=maxy=-1\r\n\u001b[?2004l\r\u001b[?2004h> cnt=0\r\n\u001b[?2004l\r\u001b[?2004h> for y in range(h):\r\n\u001b[?2004l\r\u001b[?2004h>     for x in range(w):\r\n\u001b[?2004l\r\u001b[?2004h>         r,g,b=px(x,y)\r\n\u001b[?2004l\r\u001b[?2004h>         if r>80 and r-b>40 and g<80:\r\n\u001b[?2004l\r\u001b[?2004h"]
