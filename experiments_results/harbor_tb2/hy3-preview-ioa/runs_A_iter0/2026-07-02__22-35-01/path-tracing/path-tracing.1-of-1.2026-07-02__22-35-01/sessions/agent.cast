[234.551605, "i", "cat > /tmp/cat.py << 'EOF'\nimport sys\nf=open('image.ppm','rb')\nf.read(15)\ndata=f.read()\nw,h=800,600\nGW,GH=100,75\ncw,ch=w//GW,h//GH\ndef cat(x,y):\n    o=(y*w+x)*3\n    r,g,b=data[o],data[o+1],data[o+2]\n    if b>=250 and r<215 and g<215: return '.'   # sky\n    if r>40 and b<60 and r-b>30: return 'R'      # red sphere\n    mx=max(r,g,b); mn=min(r,g,b)\n    if mx-mn<12:                                  # grayish\n        if mx>130: return '#'  # bright\n        return ':'\n    return '?'\nfor cy in range(GH):\n    s=''\n    for cx in range(GW):\n        # sample center of cell\n        xs=cx*cw+cw//2; ys=cy*ch+ch//2\n        s+=cat(xs,ys)\n    print(s)\nEOF\npython3 /tmp/cat.py\n"]
[234.552087, "o", "cat > /tmp/cat.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
