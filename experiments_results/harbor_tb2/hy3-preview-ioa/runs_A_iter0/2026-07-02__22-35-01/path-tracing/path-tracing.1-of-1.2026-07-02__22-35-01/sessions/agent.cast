[199.029589, "i", "cat > /tmp/grid.py << 'EOF'\nimport sys\nf=open('image.ppm','rb')\nf.read(15)\ndata=f.read()\nw,h=800,600\nGW,GH=80,60\ncw,ch=w//GW,h//GH\ndef cell(cx,cy):\n    xs=cx*cw; ys=cy*ch\n    R=G=B=0;n=0\n    for y in range(ys,ys+ch):\n        for x in range(xs,xs+cw):\n            o=(y*w+x)*3\n            R+=data[o];G+=data[o+1];B+=data[o+2];n+=1\n    return R//n,G//n,B//n\nfor cy in range(GH):\n    row=[]\n    for cx in range(GW):\n        r,g,b=cell(cx,cy)\n        L=(r+g+b)//3\n        row.append('%3d'%(L))\n    print(''.join(row))\nEOF\npython3 /tmp/grid.py\n"]
[199.034496, "o", "cat > /tmp/grid.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> f=open('image.ppm','rb')\r\n\u001b[?2004l\r\u001b[?2004h> f.read(15)\r\n\u001b[?2004l\r\u001b[?2004h> data=f.read()\r\n\u001b[?2004l\r\u001b[?2004h> w,h=800,600\r\n\u001b[?2004l\r\u001b[?2004h> GW,GH=80,60\r\n\u001b[?2004l\r\u001b[?2004h> cw,ch=w//GW,h//GH\r\n\u001b[?2004l\r\u001b[?2004h> def cell(cx,cy):\r\n\u001b[?2004l\r\u001b[?2004h>     xs=cx*cw; ys=cy*ch\r\n\u001b[?2004l\r\u001b[?2004h>     R=G=B=0;n=0\r\n\u001b[?2004l\r\u001b[?2004h>     for y in range(ys,ys+ch):\r\n\u001b[?2004l\r\u001b[?2004h>         for x in range(xs,xs+cw):\r\n\u001b[?2004l\r\u001b[?2004h>             o=(y*w+x)*3\r\n\u001b[?2004l\r\u001b[?2004h>             R+=data[o];G+=data[o+1];B+=data[o+2];n+=1\r\n\u001b[?2004l\r\u001b[?2004h>     return R//n,G//n,B//n\r\n\u001b[?2004l\r\u001b[?2004h> for cy in range(GH):\r\n\u001b[?2004l\r\u001b[?2004h>     row=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for cx in range(GW):\r\n\u001b[?2004l\r\u001b[?2004h>         r,g,b=cell(cx,cy)\r\n\u001b[?2004l\r\u001b[?2004h>         L=(r+g+b)//3\r\n\u001b[?2004l\r\u001b[?2004h>         row.append('%3d'%(L))\r\n\u001b[?2004l\r\u001b[?2004h>     print(''.join(row))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
