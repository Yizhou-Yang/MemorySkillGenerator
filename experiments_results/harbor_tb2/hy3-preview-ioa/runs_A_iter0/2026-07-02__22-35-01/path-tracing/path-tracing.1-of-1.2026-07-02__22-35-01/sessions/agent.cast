[44.107542, "i", "cat > /tmp/analyze2.py << 'EOF'\nimport sys\nf=open('image.ppm','rb')\nhdr=f.read(15)\ndata=f.read()\nw,h=800,600\ndef px(x,y):\n    o=(y*w+x)*3\n    return data[o],data[o+1],data[o+2]\n# Check first row gradient across columns\nprint('row0 left..right sample R,G,B')\nfor x in [0,200,400,599,799]:\n    print(x, px(x,0))\n# Check vertical at center column x=400\nprint('col400 top..bottom')\nfor y in range(0,600,30):\n    print(y, px(400,y))\nEOF\npython3 /tmp/analyze2.py\n"]
