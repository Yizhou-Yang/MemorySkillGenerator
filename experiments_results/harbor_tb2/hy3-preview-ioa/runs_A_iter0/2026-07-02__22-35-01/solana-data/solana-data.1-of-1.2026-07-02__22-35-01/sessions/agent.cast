[605.822975, "i", "cat > /tmp/datatest.py << 'EOF'\nimport requests, json\nURL='https://mainnet.helius-rpc.com'\ndef call(method, params=None):\n    r=requests.post(URL, json={'jsonrpc':'2.0','id':1,'method':method,'params':params or []}, timeout=30)\n    return r.json()\nslot=call('getSlot')['result']\nprint('slot', slot)\nver=call('getVersion')['result']\nprint('version', ver)\nnodes=call('getClusterNodes')['result']\nprint('node_count', len(nodes))\nblk=call('getBlock',[slot,{'transactionDetails':'signatures','rewards':False}])\nprint('block keys', list(blk.get('result',{}).keys()) if blk.get('result') else blk.get('error'))\ntxsig=None\nif blk.get('result') and blk['result'].get('transactions'):\n    txsig=blk['result']['transactions'][0].get('signature')\n    print('sample sig', txsig)\nif txsig:\n    tx=call('getTransaction',[txsig,{'encoding':'json','maxSupportedTransactionVersion':0}])\n    print('tx keys', list(tx.get('result',{}).keys()) if tx.get('result') else tx.get('error'))\nacc=call('getAccountInfo',['1111111111111111111111111111111"]
[605.823031, "i", "1',{'encoding':'jsonParsed'}])\nprint('sys acc', acc.get('result',{}).get('value',{}) if acc.get('result') else acc.get('error'))\npa=call('getProgramAccounts',['Vote111111111111111111111111111111111111111',{'encoding':'jsonParsed','dataSlice':{'offset':0,'length':0},'limit':3}])\nprint('prog accounts', len(pa.get('result',[]) or []), pa.get('error'))\nEOF\npython3 /tmp/datatest.py\n"]
[605.823228, "o", "cat > /tmp/datatest.py << 'EOF'\r\n"]
