[529.835252, "i", "cat > /tmp/nettest.py << 'EOF'\nimport requests\nfor url in ['https://api.mainnet-beta.solana.com','https://api.devnet.solana.com','https://solana-mainnet.g.alchemy.com','https://mainnet.helius-rpc.com']:\n    try:\n        r = requests.post(url, json={'jsonrpc':'2.0','id':1,'method':'getHealth'}, timeout=20)\n        print(url, r.status_code, r.text[:120])\n    except Exception as e:\n        print(url, 'ERR', repr(e)[:200])\nEOF\npython3 /tmp/nettest.py\n"]
