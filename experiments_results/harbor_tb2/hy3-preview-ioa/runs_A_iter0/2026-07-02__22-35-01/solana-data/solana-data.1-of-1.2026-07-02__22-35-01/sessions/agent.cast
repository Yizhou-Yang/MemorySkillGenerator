[605.823423, "o", "\u001b[?2004h> "]
[605.823508, "o", "import requests, json\r\n\u001b[?2004l\r"]
[605.823525, "o", "\u001b[?2004h> "]
[605.823625, "o", "URL='https://mainnet.helius-rpc.com'\r\n\u001b[?2004l\r"]
[605.823635, "o", "\u001b[?2004h> "]
[605.823956, "o", "def call(method, params=None):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.824431, "o", "    r=requests.post(URL, json={'jsonrpc':'2.0','id':1,'method':method,'params':params or []}, timeout=30)\r\n\u001b[?2004l\r\u001b[?2004h"]
[605.824655, "o", ">     return r.json()"]
[605.824753, "o", "\r\n"]
[605.825503, "o", "\u001b[?2004l\r"]
[605.825805, "o", "\u001b[?2004h"]
[605.825998, "o", "> "]
[605.827052, "o", "slot=call('getSlot')['result']\r\n\u001b[?2004l\r"]
[605.8284, "o", "\u001b[?2004h"]
[605.828799, "o", "> print('slot', slot)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.829018, "o", "ver=call('getVersion')['result']"]
[605.82918, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.829491, "o", "print('version', ver)\r\n"]
[605.832558, "o", "\u001b[?2004l\r"]
[605.832856, "o", "\u001b[?2004h"]
[605.832911, "o", "> "]
[605.833058, "o", "nodes=call('getClusterNodes')['result']\r\n\u001b[?2004l\r\u001b[?2004h"]
[605.833107, "o", "> "]
[605.833161, "o", "print('node_count', len(nodes))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.833379, "o", "blk=call('getBlock',[slot,{'transactionDetails':'signatures','rewards':False}])"]
[605.833724, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.833801, "o", "print('block keys', list(blk.get('result',{}).keys()) if blk.get('result') else blk.get('error'))\r\n\u001b[?2004l\r"]
[605.833819, "o", "\u001b[?2004h> "]
[605.833871, "o", "txsig=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.833998, "o", "if blk.get('result') and blk['result'].get('transactions'):\r\n\u001b[?2004l\r"]
[605.834019, "o", "\u001b[?2004h> "]
[605.834168, "o", "    txsig=blk['result']['transactions'][0].get('signature')\r\n\u001b[?2004l\r"]
[605.834241, "o", "\u001b[?2004h> "]
[605.834309, "o", "    print('sample sig', txsig)\r\n\u001b[?2004l\r"]
[605.834378, "o", "\u001b[?2004h> "]
[605.834463, "o", "if txsig:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.834616, "o", "    tx=call('getTransaction',[txsig,{'encoding':'json','maxSupportedTransactionVersion':0}])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.834846, "o", "    print('tx keys', list(tx.get('result',{}).keys()) if tx.get('result') else tx.get('error'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[605.835039, "o", "acc=call('getAccountInfo',['11111111111111111111111111111111',{'encoding':'jsonParsed'}])"]
