[1372.148964, "i", "cat > /app/sitecustomize.py << 'PYEOF'\nimport ctypes as _ctypes\nimport os as _os\n\n# ---------------------------------------------------------------------------\n# Workaround 1: torch import hangs because dlopen of a CUDA/nvidia .so blocks.\n# We only need CPU, so skip loading those shared libs during startup.\n# ---------------------------------------------------------------------------\n_orig_CDLL = _ctypes.CDLL\n\n_CUDA_PREFIXES = (\n    \"libcublaslt\", \"libcublas\", \"libcudnn\", \"libnvrtc\", \"libnvrtc-builtins\",\n    \"libcudart\", \"libcupti\", \"libcufft\", \"libcurand\", \"libnvjitlink\",\n    \"libcusparse\", \"libcusparselt\", \"libcusolver\", \"libnccl\", \"libnvshmem\",\n    \"libcufile\", \"libnvtoolsext\", \"libnvidia-ml\",\n)\n\n\ndef _is_cuda_lib(path):\n    if not path:\n        return False\n    p = str(path).lower()\n    if \"nvidia\" in p:\n        return True\n    base = _os.path.basename(p)\n    return any(base.startswith(pre) for pre in _CUDA_PREFIXES)\n\n\nclass _NoopCDLL:\n    def __init__(self, *a, **k):\n        pass\n    def __getattr__(self"]
[1372.149039, "i", ", n):\n        raise AttributeError(n)\n\n\ndef _patched_CDLL(*args, **kwargs):\n    path = args[0] if args else kwargs.get(\"name\")\n    if _is_cuda_lib(path):\n        return _NoopCDLL()\n    return _orig_CDLL(*args, **kwargs)\n\n\n_ctypes.CDLL = _patched_CDLL\n\n# ---------------------------------------------------------------------------\n# Workaround 2: mteb 1.36.8 imports AutoModelForVision2Seq from transformers,\n# which transformers >= 5.x removed. We only use text models, so add a harmless\n# placeholder to the already-imported transformers module.\n# ---------------------------------------------------------------------------\ntry:\n    import transformers\n    if not hasattr(transformers, \"AutoModelForVision2Seq\"):\n        class AutoModelForVision2Seq:\n            \"\"\"Placeholder; gme vision models are not used by this task.\"\"\"\n            pass\n        transformers.AutoModelForVision2Seq = AutoModelForVision2Seq\nexcept Exception:\n    pass\nPYEOF\n"]
