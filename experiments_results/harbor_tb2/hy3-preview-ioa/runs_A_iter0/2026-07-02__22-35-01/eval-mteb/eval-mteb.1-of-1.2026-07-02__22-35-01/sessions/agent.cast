[1299.645874, "i", "cat > /app/sitecustomize.py << 'PYEOF'\nimport sys\nimport ctypes as _ctypes\nimport os as _os\nimport importlib.abc\n\n# ---------------------------------------------------------------------------\n# 1) Workaround: torch import hangs because dlopen of a CUDA/nvidia .so blocks.\n#    We only need CPU. Skip loading those shared libs during interpreter startup.\n# ---------------------------------------------------------------------------\n_orig_CDLL = _ctypes.CDLL\n\n_CUDA_PREFIXES = (\n    \"libcublaslt\", \"libcublas\", \"libcudnn\", \"libnvrtc\", \"libnvrtc-builtins\",\n    \"libcudart\", \"libcupti\", \"libcufft\", \"libcurand\", \"libnvjitlink\",\n    \"libcusparse\", \"libcusparselt\", \"libcusolver\", \"libnccl\", \"libnvshmem\",\n    \"libcufile\", \"libnvtoolsext\", \"libnvidia-ml\",\n)\n\n\ndef _is_cuda_lib(path):\n    if not path:\n        return False\n    p = str(path).lower()\n    if \"nvidia\" in p:\n        return True\n    base = _os.path.basename(p)\n    for pre in _CUDA_PREFIXES:\n        if base.startswith(p"]
