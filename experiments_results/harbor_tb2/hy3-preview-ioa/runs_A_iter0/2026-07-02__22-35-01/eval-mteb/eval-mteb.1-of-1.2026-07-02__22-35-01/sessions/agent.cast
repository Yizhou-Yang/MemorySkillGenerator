[824.266674, "o", "311:def _preload_cuda_lib(lib_folder: str, lib_name: str, required: bool = True) -> None:  # type: ignore[valid-type]\r\n329:def _preload_cuda_deps(err: OSError | None = None) -> None:\r\n361:        _preload_cuda_lib(lib_folder, lib_name)\r\n364:    _preload_cuda_lib(\"nvtx\", \"libnvToolsExt.so.*[0-9]\", required=False)\r\n368:def _load_global_deps() -> None:\r\n394:            _preload_cuda_deps()\r\n401:        _preload_cuda_deps(err)\r\n443:        _load_global_deps()\r\n\u001b[?2004hroot@60a81b02434b:/app# "]
