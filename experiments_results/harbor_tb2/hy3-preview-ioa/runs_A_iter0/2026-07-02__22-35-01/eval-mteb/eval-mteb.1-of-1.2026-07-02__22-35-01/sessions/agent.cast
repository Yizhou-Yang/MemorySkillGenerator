[1299.662224, "i", "re):\n            return True\n    return False\n\n\nclass _NoopCDLL:\n    def __init__(self, *a, **k):\n        pass\n    def __getattr__(self, n):\n        raise AttributeError(n)\n\n\ndef _patched_CDLL(*args, **kwargs):\n    path = args[0] if args else kwargs.get(\"name\")\n    if _is_cuda_lib(path):\n        return _NoopCDLL()\n    return _orig_CDLL(*args, **kwargs)\n\n\n_ctypes.CDLL = _patched_CDLL\n\n\n# ---------------------------------------------------------------------------\n# 2) Workaround: mteb 1.36.8 imports AutoModelForVision2Seq from transformers,\n#    which transformers >= 5.x removed. We only use text models, so inject a\n#    harmless placeholder after transformers is loaded.\n# ---------------------------------------------------------------------------\nclass _WrappedLoader(importlib.abc.Loader):\n    def __init__(self, real):\n        self._real = real\n\n    def create_module(self, spec):\n        return self._real.create_module(spec)\n\n    def exec_module(self, module):\n        self._real.exec_module(module)\n        _pa"]
[1299.662244, "i", "tch_transformers(module)\n        return module\n\n\ndef _patch_transformers(module):\n    if not hasattr(module, \"AutoModelForVision2Seq\"):\n        class AutoModelForVision2Seq:\n            \"\"\"Placeholder; gme vision models are not used by this task.\"\"\"\n            pass\n        module.AutoModelForVision2Seq = AutoModelForVision2Seq\n\n\nclass _TFMetaFinder(importlib.abc.MetaPathFinder):\n    def find_spec(self, name, path, target=None):\n        if name != \"transformers\":\n            return None\n        for finder in sys.meta_path:\n            if finder is self:\n                continue\n            spec = finder.find_spec(name, path, target)\n            if spec is not None:\n                break\n        else:\n            return None\n        if spec.loader is not None:\n            spec.loader = _WrappedLoader(spec.loader)\n        return spec\n\n\nsys.meta_path.insert(0, _TFMetaFinder())\nPYEOF\n"]
