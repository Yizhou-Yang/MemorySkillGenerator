[1508.286963, "o", "\u001b[?2004l\r\u001b[?2004h> _ctypes.CDLL = _patched_CDLL\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> # Workaround 2: mteb 1.36.8 imports AutoModelForVision2Seq from transformers,\r\n\u001b[?2004l\r\u001b[?2004h> # which transformers >= 5.x removed. We only use text models, so inject a\r\n\u001b[?2004l\r\u001b[?2004h> # harmless placeholder onto the live transformers module as soon as it imports.\r\n\u001b[?2004l\r\u001b[?2004h> # ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1508.287093, "o", "class _AutoModelForVision2Seq:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Placeholder; gme vision models are not used by this task.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> _real_import = builtins.__import__\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _patched_import(name, *args, **kwargs):\r\n\u001b[?2004l\r\u001b[?2004h>     module = _real_import(name, *args, **kwargs)\r\n\u001b[?2004l\r\u001b[?2004h>     if name == \"transformers\" and \"transformers\" in sys.modules:\r\n\u001b[?2004l\r\u001b[?2004h>         mod = sys.modules[\"transformers\"]\r\n\u001b[?2004l\r\u001b[?2004h>         if not hasattr(mod, \"AutoModelForVision2Seq\"):\r\n\u001b[?2004l\r\u001b[?2004h>             mod.AutoModelForVision2Seq = _AutoModelForVision2Seq\r\n\u001b[?2004l\r\u001b[?2004h>     return module\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> builtins.__import__ = _patched_import\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
