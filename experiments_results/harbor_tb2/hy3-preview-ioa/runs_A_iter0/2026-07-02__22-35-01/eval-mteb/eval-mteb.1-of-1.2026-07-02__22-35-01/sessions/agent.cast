[1225.820477, "o", "        self.processor = processor\r\n        self.max_length = max_length\r\n        self.normalize = normalize\r\n        self.processor.tokenizer.padding_side = \"right\"\r\n        self.defualt_instruction = \"You are a helpful assistant.\"\r\n"]
