[316.193657, "i", "cat > /app/explore4.py << 'EOF'\nimport numpy as np, io\nfrom scipy.ndimage import uniform_filter1d\nwith open('/app/graphene.dat') as f:\n    txt = f.read().replace(',', '.')\ndata = np.loadtxt(io.StringIO(txt))\nx = data[:,0]; y = data[:,1]\nif x[0] > x[-1]:\n    x = x[::-1]; y = y[::-1]\ns = uniform_filter1d(y, size=25)\ngmax = s.max()\nprint('global smoothed max', gmax, 'at x', x[np.argmax(s)])\npeaks=[]\nfor i in range(2, len(s)-2):\n    if s[i]>s[i-1] and s[i]>=s[i+1] and s[i] > 0.3*gmax:\n        peaks.append((x[i], s[i], y[i]))\npeaks.sort()\nprint('significant peaks (x, smoothed_y, raw_y):')\nfor xi, si, yi in peaks:\n    print(f'  x={xi:9.2f}  sy={si:9.2f}  ry={yi:9.2f}')\nEOF\npython3 /app/explore4.py\n"]
