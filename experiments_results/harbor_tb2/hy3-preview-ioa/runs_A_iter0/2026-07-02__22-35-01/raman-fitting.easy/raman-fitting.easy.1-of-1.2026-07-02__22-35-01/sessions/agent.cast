[422.146331, "m", "Episode 10: 1 commands"]
[422.146331, "o", "\u001b[?2004hroot@4758e662acd5:/app# "]
[565.24813, "i", "cat > /app/profile.py << 'EOF'\nimport numpy as np, io\nfrom scipy.ndimage import uniform_filter1d\nfrom scipy.signal import find_peaks\nwith open('/app/graphene.dat') as f:\n    txt = f.read().replace(',', '.')\ndata = np.loadtxt(io.StringIO(txt))\nx = data[:,0]; y = data[:,1]\nif x[0] > x[-1]:\n    x = x[::-1]; y = y[::-1]\ns = uniform_filter1d(y, size=25)\nprint('=== coarse smoothed profile (every ~60 pts) ===')\nfor i in range(0, len(x), 60):\n    print(f'  x={x[i]:9.2f}  sy={s[i]:9.2f}  ry={y[i]:9.2f}')\nprint('=== find_peaks (prominence=0.05*gmax) ===')\ngmax=s.max()\npk,_=find_peaks(s, prominence=0.05*gmax)\nfor i in pk:\n    print(f'  x={x[i]:9.2f}  sy={s[i]:9.2f}  ry={y[i]:9.2f}')\nEOF\npython3 /app/profile.py\n"]
[565.256996, "o", "cat > /app/profile.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np, io\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.ndimage import uniform_filter1d\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.signal import find_peaks\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     txt = f.read().replace(',', '.')\r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt(io.StringIO(txt))\r\n\u001b[?2004l\r\u001b[?2004h> x = data[:,0]; y = data[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> if x[0] > x[-1]:\r\n\u001b[?2004l\r\u001b[?2004h>     x = x[::-1]; y = y[::-1]\r\n\u001b[?2004l\r\u001b[?2004h> s = uniform_filter1d(y, size=25)\r\n\u001b[?2004l\r\u001b[?2004h> print('=== coarse smoothed profile (every ~60 pts) ===')\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(0, len(x), 60):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'  x={x[i]:9.2f}  sy={s[i]:9.2f}  ry={y[i]:9.2f}')\r\n\u001b[?2004l\r\u001b[?2004h> print('=== find_peaks (prominence=0.05*gmax) ===')\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.277197, "m", "Episode 11: 1 commands"]
[565.277197, "o", "> gmax=s.max()\r\n\u001b[?2004l\r\u001b[?2004h> pk,_=find_peaks(s, prominence=0.05*gmax)\r\n\u001b[?2004l\r\u001b[?2004h> for i in pk:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'  x={x[i]:9.2f}  sy={s[i]:9.2f}  ry={y[i]:9.2f}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@4758e662acd5:/app# python3 /app/profile.py\r\n\u001b[?2004l\r"]
