[158.45917, "m", "Episode 6: 1 commands"]
[158.45917, "o", "\u001b[?2004hroot@4758e662acd5:/app# "]
[199.452992, "i", "cat > /app/explore3.py << 'EOF'\nimport numpy as np, io\nfrom scipy.ndimage import uniform_filter1d\nwith open('/app/graphene.dat') as f:\n    txt = f.read().replace(',', '.')\ndata = np.loadtxt(io.StringIO(txt))\nx = data[:,0]; y = data[:,1]\nif x[0] > x[-1]:\n    x = x[::-1]; y = y[::-1]\nprint('x range', x.min(), x.max())\nprint('global max y', y.max(), 'at x=', x[np.argmax(y)])\n# smooth\ns = uniform_filter1d(y, size=21)\n# find local maxima\npeaks = []\nfor i in range(1, len(s)-1):\n    if s[i] > s[i-1] and s[i] >= s[i+1]:\n        peaks.append((s[i], x[i]))\npeaks.sort(reverse=True)\nprint('top 15 smoothed maxima:')\nfor v, xi in peaks[:15]:\n    print(f'  x={xi:9.2f} y={v:10.2f}')\nEOF\npython3 /app/explore3.py\n"]
[199.453222, "o", "cat > /app/explore3.py << 'EOF'"]
