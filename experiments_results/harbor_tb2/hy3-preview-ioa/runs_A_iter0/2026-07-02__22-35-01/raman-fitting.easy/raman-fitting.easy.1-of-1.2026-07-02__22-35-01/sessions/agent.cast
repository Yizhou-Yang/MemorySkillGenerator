[158.116815, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np, io\nwith open('/app/graphene.dat') as f:\n    txt = f.read().replace(',', '.')\ndata = np.loadtxt(io.StringIO(txt))\nx = data[:,0]; y = data[:,1]\nif x[0] > x[-1]:\n    x = x[::-1]; y = y[::-1]\nprint('monotonic increasing:', np.all(np.diff(x)>0))\nprint('x[:5]', x[:5])\nprint('x[1670:1690]', x[1670:1690])\nprint('--- G region x<1800 ---')\nm = x < 1800\nfor xi, yi in zip(x[m], y[m]):\n    print(f'{xi:10.3f} {yi:10.3f}')\nEOF\npython3 /app/explore2.py\n"]
[158.117004, "o", "cat > /app/explore2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np, io\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     txt = f.read().replace(',', '.')\r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt(io.StringIO(txt))\r\n\u001b[?2004l\r\u001b[?2004h> x = data[:,0]; y = data[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> if x[0] > x[-1]:\r\n\u001b[?2004l\r\u001b[?2004h>     x = x[::-1]; y = y[::-1]\r\n\u001b[?2004l\r\u001b[?2004h> print('monotonic increasing:', np.all(np.diff(x)>0))\r\n\u001b[?2004l\r\u001b[?2004h> print('x[:5]', x[:5])\r\n\u001b[?2004l\r\u001b[?2004h> print('x[1670:1690]', x[1670:1690])\r\n\u001b[?2004l\r\u001b[?2004h> print('--- G region x<1800 ---')\r\n\u001b[?2004l\r\u001b[?2004h> m = x < 1800\r\n\u001b[?2004l\r\u001b[?2004h> for xi, yi in zip(x[m], y[m]):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{xi:10.3f} {yi:10.3f}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
