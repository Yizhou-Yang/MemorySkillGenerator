[420.572591, "i", "cat > /app/explore5.py << 'EOF'\nimport numpy as np, io\nfrom scipy.ndimage import uniform_filter1d\nwith open('/app/graphene.dat') as f:\n    txt = f.read().replace(',', '.')\ndata = np.loadtxt(io.StringIO(txt))\nx = data[:,0]; y = data[:,1]\nif x[0] > x[-1]:\n    x = x[::-1]; y = y[::-1]\ns = uniform_filter1d(y, size=15)\nthr = 0.05*s.max()\npeaks=[(x[i],s[i]) for i in range(1,len(s)-1) if s[i]>s[i-1] and s[i]>=s[i+1] and s[i]>thr]\npeaks.sort()\nprint('all smoothed local maxima above 5% gmax, sorted by x:')\nfor xi,si in peaks:\n    print(f'  x={xi:9.2f}  sy={si:9.2f}')\nprint('--- smoothed y near 1580 ---')\nm=(x>1500)&(x<1660)\nfor xi,si in zip(x[m],s[m]):\n    print(f'  x={xi:9.2f} sy={si:9.2f}')\nprint('--- smoothed y near 2700 ---')\nm=(x>2600)&(x<2800)\nfor xi,si in zip(x[m],s[m]):\n    print(f'  x={xi:9.2f} sy={si:9.2f}')\nEOF\npython3 /app/explore5.py\n"]
