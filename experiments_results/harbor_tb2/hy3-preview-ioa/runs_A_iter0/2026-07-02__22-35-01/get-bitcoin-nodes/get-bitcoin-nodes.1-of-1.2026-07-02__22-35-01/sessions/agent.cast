[298.481858, "i", "cat > /tmp/btest.py << 'EOF'\nfrom bitcoinlib.services.services import Service\ns = Service(network='bitcoin')\nprint('blockcount', s.getblockcount())\nb = s.getblock('000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f')\nprint('block hash', b.hash)\nprint('height', b.height)\nprint('txs', len(b.txs))\ntx = b.txs[0]\nprint('txid', tx.txid)\nprint('vin', tx.vin[0].coinbase, tx.vin[0].sequence)\nv = tx.vout[0]\nprint('vout value', v.value, 'n', v.n)\nspk = v.script_pubkey\nprint('spk type', spk.script_type, 'hex', spk.hex)\nEOF\npython3 /tmp/btest.py\n"]
