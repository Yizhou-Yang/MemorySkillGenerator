[311.705031, "i", "which wget; cd /tmp/debs && python3 - <<'EOF'\nimport urllib.request, re\nurls=[]\nfor line in open('/tmp/uris.txt'):\n    m=re.match(r\"'([^']+)'\", line.strip())\n    if m: urls.append(m.group(1))\nprint('urls', len(urls))\nfor u in urls:\n    fn=u.split('/')[-1].replace('%2b','+').replace('%3a',':')\n    urllib.request.urlretrieve(u, fn)\n    print('got', fn)\nEOF\n"]
