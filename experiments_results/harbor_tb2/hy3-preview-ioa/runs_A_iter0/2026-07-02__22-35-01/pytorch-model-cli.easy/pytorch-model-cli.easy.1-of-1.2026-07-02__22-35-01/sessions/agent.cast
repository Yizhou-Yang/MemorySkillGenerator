[11.929174, "o", "\r\ndrwxr-xr-x  2 root root   4096 Jul  2 13:59 .\r\ndrwxr-xr-x 19 root root   4096 Jul  2 16:38 ..\r\n-rw-r--r--  1 root root  79506 Jul  2 13:59 cJSON.c\r\n-rw-r--r--  1 root root  16393 Jul  2 13:59 cJSON.h\r\n-rw-r--r--  1 root root    389 Jul  2 13:59 image.png\r\n-rw-r--r--  1 root root 311873 Jul  2 13:59 lodepng.cpp\r\n-rw-r--r--  1 root root 107788 Jul  2 13:59 lodepng.h\r\n-rw-r--r--  1 root root  54714 Jul  2 13:59 model.pth\r\n-rw-r--r--  1 root root    681 Jul  2 13:59 model.py\r\n"]
