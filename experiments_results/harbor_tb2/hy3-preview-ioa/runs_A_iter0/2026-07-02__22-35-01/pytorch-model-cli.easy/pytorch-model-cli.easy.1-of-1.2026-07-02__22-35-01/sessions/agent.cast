[604.618099, "i", "cd /app && python3 - <<'EOF'\nimport torch, json, numpy as np\nfrom collections import OrderedDict\nsd = torch.load('model.pth', map_location='cpu')\nprint('keys:', list(sd.keys()))\nout = OrderedDict()\nfor k in ['input_layer','hidden_layer','output_layer']:\n    out[k+'_weight'] = sd[k+'.weight'].detach().cpu().flatten().tolist()\n    out[k+'_bias']   = sd[k+'.bias'].detach().cpu().flatten().tolist()\njson.dump(out, open('weights.json','w'))\nprint('sizes', {k:len(v) for k,v in out.items()})\n# image stats\nimport struct, zlib\nimport png as _p\n# use PIL not available; decode via simple: use lodepng not in py. Use raw: read with python's zlib? simpler: use torch? no.\nprint('weights.json written')\nEOF\n"]
