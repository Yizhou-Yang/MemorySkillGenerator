[729.749076, "i", "python3 - <<'EOF'\nimport torch, numpy as np\nfrom PIL import Image\nsd = torch.load('model.pth', map_location='cpu')\nimg = Image.open('image.png')\nprint('mode', img.mode, 'size', img.size)\ng = img.convert('L')\na = np.asarray(g, dtype=np.float32)\nprint('shape', a.shape, 'min', a.min(), 'max', a.max(), 'mean', a.mean())\nprint('frac<pixel<64:', ((a<64).mean()), 'frac>192:', ((a>192).mean()))\n\ndef run(x):\n    x = torch.tensor(x, dtype=torch.float32)\n    h = torch.relu(x @ sd['input_layer.weight'].T + sd['input_layer.bias'])\n    h = torch.relu(h @ sd['hidden_layer.weight'].T + sd['hidden_layer.bias'])\n    o = h @ sd['output_layer.weight'].T + sd['output_layer.bias']\n    return o.detach().numpy()\n\nflat = a.reshape(-1)\ncands = {\n  'plain0-1': flat/255.0,\n  'plain_invert': 1.0 - flat/255.0,\n  'mnist_norm': (flat/255.0 - 0.1307)/0.3081,\n  'mnist_norm_inv': ((1.0-flat/255.0) - 0.1307)/0.3081,\n  'standardize': (flat-flat.mean())/flat.std(),\n  'standardize_inv': ((255.0-flat)-(255.0-flat).mean())/(255.0-flat).std(),\n}\nfor "]
[729.749127, "i", "name, x in cands.items():\n    o = run(x)\n    p = int(np.argmax(o))\n    print(f'{name:20s} pred={p}  maxlogit={o.max():.3f}  logits={np.round(o,2).tolist()}')\nEOF\n"]
