[136.273783, "i", "cat > /tmp/recon.py << 'EOF'\nout = bytearray()\nwith open('/app/data.hex') as f:\n    for line in f:\n        parts = line.split()\n        if not parts:\n            continue\n        for tok in parts[1:]:\n            v = int(tok, 8)\n            out.append(v & 0xFF)\n            out.append((v >> 8) & 0xFF)\nwith open('/tmp/data.bin', 'wb') as g:\n    g.write(out)\nprint('bytes:', len(out))\nEOF\npython3 /tmp/recon.py\n"]
[136.27709, "o", "cat > /tmp/recon.py << 'EOF'\r\n\u001b[?2004l\r"]
[136.277133, "o", "\u001b[?2004h> "]
