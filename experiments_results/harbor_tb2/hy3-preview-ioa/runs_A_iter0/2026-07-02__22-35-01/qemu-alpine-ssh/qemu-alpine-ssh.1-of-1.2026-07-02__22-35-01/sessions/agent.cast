[211.415588, "o", "    def walk(entries,path,depth):\r\n\u001b[?2004l\r"]
[211.415739, "o", "\u001b[?2004h> "]
[211.416212, "o", "        if depth>25: return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.418801, "o", "        for ext,length,flags,name in entries:\r\n\u001b[?2004l\r\u001b[?2004h>             if ext in seen: continue\r\n\u001b[?2004l\r\u001b[?2004h>             nm=nameof(name)\r\n\u001b[?2004l\r\u001b[?2004h>             if nm in ('.','..'): continue\r\n\u001b[?2004l\r\u001b[?2004h>             isdir=bool(flags & 0x2)\r\n\u001b[?2004l\r\u001b[?2004h>             full=path+'/'+nm\r\n\u001b[?2004l\r\u001b[?2004h>             if isdir and depth<25:\r\n\u001b[?2004l\r\u001b[?2004h>                 seen.add(ext)\r\n\u001b[?2004l\r\u001b[?2004h>                 try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.419689, "o", "                    walk(read_dir(ext,length),full,depth+1)\r\n\u001b[?2004l\r\u001b[?2004h>                 except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>                     pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.419969, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h>                 low=nm.lower()\r\n\u001b[?2004l\r"]
[211.420238, "o", "\u001b[?2004h>                 if 'vmlinuz' in low: cands['vmlinuz'].append((ext,length,full))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.420454, "o", "                if 'initramfs' in low: cands['initramfs'].append((ext,length,full))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.420594, "o", "    root=parse_dr(pvd[156:156+34])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.420766, "o", "    walk(read_dir(root[0],root[1]),'',0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.420855, "o", "    def pick(lst):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.420915, "o", "        if not lst: return None"]
