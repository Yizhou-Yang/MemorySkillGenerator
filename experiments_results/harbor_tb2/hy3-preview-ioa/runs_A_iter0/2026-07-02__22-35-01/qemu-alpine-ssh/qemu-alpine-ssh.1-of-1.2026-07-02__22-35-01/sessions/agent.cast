[211.397689, "o", "\u001b[?2004h>     f.seek(0)\r\n\u001b[?2004l\r\u001b[?2004h>     for s in range(16,16+200):\r\n\u001b[?2004l\r\u001b[?2004h>         buf=f.read(2048)\r\n\u001b[?2004l\r\u001b[?2004h>         if buf[1:6]==b'CD001' and buf[0]==1:\r\n\u001b[?2004l\r\u001b[?2004h>             pvd=buf; break\r\n\u001b[?2004l\r\u001b[?2004h>     assert pvd,'no PVD'\r\n\u001b[?2004l\r\u001b[?2004h>     def parse_dr(d):\r\n\u001b[?2004l\r\u001b[?2004h>         if len(d)<33: return None\r\n\u001b[?2004l\r\u001b[?2004h>         return (struct.unpack('<I',d[2:6])[0],struct.unpack('<I',d[10:14])[0],d[25],d[33:33+d[32]])\r\n\u001b[?2004l\r\u001b[?2004h>     def read_dir(ext,length):\r\n\u001b[?2004l\r\u001b[?2004h>         f.seek(ext*2048)\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.397939, "o", "> "]
[211.399035, "o", "        data=f.read(((length+2047)//2048)*2048)\r\n\u001b[?2004l\r\u001b[?2004h>         out=[]; off=0\r\n\u001b[?2004l\r\u001b[?2004h>         while off<length:\r\n\u001b[?2004l\r\u001b[?2004h>             lr=data[off]\r\n\u001b[?2004l\r\u001b[?2004h>             if lr==0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.399332, "o", "                off=((off//2048)+1)*2048; continue\r\n\u001b[?2004l\r\u001b[?2004h>             rec=data[off:off+lr]\r\n\u001b[?2004l\r\u001b[?2004h>             e=parse_dr(rec)\r\n\u001b[?2004l\r"]
[211.399719, "o", "\u001b[?2004h>             if e: out.append(e)\r\n\u001b[?2004l\r\u001b[?2004h>             off+=lr\r\n\u001b[?2004l\r\u001b[?2004h>         return out\r\n\u001b[?2004l\r\u001b[?2004h>     def nameof(b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
