[180.114957, "i", "cat > /tmp/extract.py << 'PYEOF'\nimport struct\nISO='/app/alpine.iso'\ndef rd(f,off,n):\n    f.seek(off); return f.read(n)\nwith open(ISO,'rb') as f:\n    pvd=None\n    for s in range(16,16+200):\n        buf=rd(f,s*2048,2048)\n        if buf[1:6]==b'CD001' and buf[0]==1:\n            pvd=buf; break\n    assert pvd,'no PVD'\n    def parse_dr(d):\n        if len(d)<33: return None\n        return (struct.unpack('<I',d[2:6])[0],struct.unpack('<I',d[10:14])[0],d[25],d[33:33+d[32]])\n    def read_dir(ext,length):\n        f.seek(ext*2048)\n        data=f.read(((length+2047)//2048)*2048)\n        out=[]; off=0\n        while off<length:\n            lr=data[off]\n            if lr==0:\n                off=((off//2048)+1)*2048; continue\n            rec=data[off:off+lr]\n            e=parse_dr(rec)\n            if e: out.append(e)\n            off+=lr\n        return out\n    def nameof(b):\n        s=b.decode('latin1')\n        if ';' in s: s=s.split(';')[0]\n        return s\n    cands={'vmlinuz'"]
