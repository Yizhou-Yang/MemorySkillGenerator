[180.122741, "i", ":[],'initramfs':[]}\n    def walk(entries,path):\n        for ext,length,flags,name in entries:\n            nm=nameof(name)\n            if nm in ('.','..'): continue\n            isdir=bool(flags & 0x2)\n            full=path+'/'+nm\n            if isdir:\n                walk(read_dir(ext,length),full)\n            else:\n                low=nm.lower()\n                if 'vmlinuz' in low: cands['vmlinuz'].append((ext,length,full))\n                if 'initramfs' in low: cands['initramfs'].append((ext,length,full))\n    root=parse_dr(pvd[156:156+34])\n    walk(read_dir(root[0],root[1]),'')\n    def pick(lst):\n        if not lst: return None\n        for x in lst:\n            if 'lts' in x[2].lower(): return x\n        return lst[0]\n    for k in ('vmlinuz','initramfs'):\n        x=pick(cands[k])\n        print(k,x)\n        if x:\n            ext,length,full=x\n            f.seek(ext*2048)\n            data=f.read(length)\n            open('/app/'+k,'wb').write(data)\n            print('wrote','/app/'+k,length)\nPYEOF\n"]
