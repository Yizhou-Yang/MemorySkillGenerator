[59.88167, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_service_process_running\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that the Bitcoin service process is running\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m proc \u001b[95min\u001b[39;49;00m psutil.process_iter([\u001b[33m\"\u001b[39;49;00m\u001b[33mpid\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mname\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mcmdline\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]):\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                cmdline = \u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.join(proc.info[\u001b[33m\"\u001b[39;49;00m\u001b[33mcmdline\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] \u001b[94mif\u001b[39;49;00m proc.info[\u001b[33m\"\u001b[39;49;00m\u001b[33mcmdline\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] \u001b[94melse\u001b[39;49;00m [])\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m (\u001b[90m\u001b[39;49;00m\r\n"]
