[284.372882, "i", "cat > /tmp/explore6.py << 'EOF'\nfrom bitcoinlib.services.services import Service\ns = Service(network='bitcoin')\n# recent block\nbh = s.getblock(s.blockcount())\nprint(\"recent block height\", bh.height, \"time\", bh.time)\nblk = s.getblock(s.blockcount())\ntxlist = blk.transactions\nprint(\"tx count via transactions:\", len(txlist))\n# try raw\nraw = s.getrawblock(bh.block_hash.hex())\nprint(\"raw type\", type(raw), \"len\", len(raw) if isinstance(raw,list) else '?')\n# pick a recent tx\nimport bitcoinlib\nrt = s.getrawtransaction('4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b')\nprint(\"rawtx type\", type(rt))\nprint(\"=== Script asm/hex test ===\")\ntx = s.gettransaction('4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b')\nout = tx.outputs[0]\nsp = out.script\nfor a in ['asm','script','hex','raw_bytes','raw']:\n    print(\" \", a, repr(getattr(sp,a,None))[:100])\nprint(\"sp script():\", repr(sp.script)[:120] if hasattr(sp,'script') else 'no')\nEOF\npython3 /tmp/explore6.py\n"]
[284.373142, "o", "cat > /tmp/explore6.py << 'EOF'\r\n"]
