[597.328098, "i", "cat > /tmp/explore11.py << 'EOF'\nimport hashlib\nfrom bitcoinlib.services.services import Service\n\ndef read_varint(buf, pos):\n    n = buf[pos]; pos += 1\n    if n < 0xfd: return n, pos\n    if n == 0xfd: size=2\n    elif n == 0xfe: size=4\n    else: size=8\n    val = int.from_bytes(buf[pos:pos+size], 'little'); return val, pos+size\n\ndef parse_block_txids(raw_hex):\n    b = bytes.fromhex(raw_hex)\n    pos = 80  # header\n    count, pos = read_varint(b, pos)\n    txids = []\n    for _ in range(count):\n        tx_start = pos\n        pos += 4  # version\n        n_in, pos = read_varint(b, pos)\n        for _ in range(n_in):\n            pos += 32 + 4\n            sl, pos = read_varint(b, pos); pos += sl; pos += 4\n        n_out, pos = read_varint(b, pos)\n        for _ in range(n_out):\n            pos += 8\n            sl, pos = read_varint(b, pos); pos += sl\n        pos += 4  # locktime\n        raw_tx = b[tx_start:pos]\n        d1 = hashlib.sha256(raw_tx).digest()\n        d2 = hashlib.sha256(d1).digest()\n        txids.append(d2[::"]
[597.328456, "i", "-1].hex())\n    return txids\n\ns = Service(network='bitcoin')\nfor h in ['000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f']:\n    raw = s.getrawblock(h)\n    ids = parse_block_txids(raw)\n    print(h[:12], \"->\", len(ids), \"txids\")\n    print(\"  \", ids[0])\nEOF\npython3 /tmp/explore11.py\n"]
[597.328509, "o", "cat > /tmp/explore11.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import hashlib\r\n\u001b[?2004l\r\u001b[?2004h> from bitcoinlib.services.services import Service\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[597.328662, "o", "\u001b[?2004l\r\u001b[?2004h> def read_varint(buf, pos):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[597.329157, "o", "    n = buf[pos]; pos += 1\r\n\u001b[?2004l\r\u001b[?2004h>     if n < 0xfd: return n, pos\r\n\u001b[?2004l\r\u001b[?2004h>     if n == 0xfd: size=2\r\n\u001b[?2004l\r\u001b[?2004h>     elif n == 0xfe: size=4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[597.332153, "o", "    else: size=8"]
[597.332245, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     val = int.from_bytes(buf[pos:pos+size], 'little'); return val, pos+size\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_block_txids(raw_hex):\r\n\u001b[?2004l\r\u001b[?2004h>     b = bytes.fromhex(raw_hex)\r\n\u001b[?2004l\r\u001b[?2004h>     pos = 80  # header\r\n\u001b[?2004l\r\u001b[?2004h>     count, pos = read_varint(b, pos)\r\n\u001b[?2004l\r\u001b[?2004h>     txids = []\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(count):\r\n\u001b[?2004l\r\u001b[?2004h>         tx_start = pos\r\n\u001b[?2004l\r\u001b[?2004h>         pos += 4  # version\r\n\u001b[?2004l\r\u001b[?2004h>         n_in, pos = read_varint(b, pos)\r\n\u001b[?2004l\r\u001b[?2004h>         for _ in range(n_in):\r\n\u001b[?2004l\r\u001b[?2004h>             pos += 32 + 4\r\n\u001b[?2004l\r\u001b[?2004h>             sl, pos = read_varint(b, pos); pos += sl; pos += 4\r\n\u001b[?2004l\r\u001b[?2004h>         n_out, pos = read_varint(b, pos)\r\n\u001b[?2004l\r\u001b[?2004h>         for _ in range(n_out):\r\n\u001b[?2004l\r\u001b[?2004h>             pos += 8\r\n\u001b[?2004l\r\u001b[?2004h>             sl, pos = read_varint(b, pos); pos += sl\r\n\u001b[?2004l\r\u001b[?2004h>         pos += 4  # locktime\r\n\u001b[?2004l\r\u001b[?200"]
[597.332257, "o", "4h>         raw_tx = b[tx_start:pos]\r\n\u001b[?2004l\r\u001b[?2004h>         d1 = hashlib.sha256(raw_tx).digest()\r\n\u001b[?2004l\r\u001b[?2004h>         d2 = hashlib.sha256(d1).digest()\r\n\u001b[?2004l\r\u001b[?2004h>         txids.append(d2[::-1].hex())\r\n\u001b[?2004l\r\u001b[?2004h>     return txids\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> s = Service(network='bitcoin')\r\n\u001b[?2004l\r\u001b[?2004h> for h in ['000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f']:\r\n\u001b[?2004l\r\u001b[?2004h>     raw = s.getrawblock(h)\r\n\u001b[?2004l\r\u001b[?2004h>     ids = parse_block_txids(raw)\r\n\u001b[?2004l\r\u001b[?2004h>     print(h[:12], \"->\", len(ids), \"txids\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
