[203.246724, "i", "cat > /tmp/explore4.py << 'EOF'\nfrom bitcoinlib.services.services import Service\ns = Service(network='bitcoin')\ntxid = '4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b'\ntx = s.gettransaction(txid)\nprint(\"=== TX attrs ===\")\nfor a in dir(tx):\n    if not a.startswith('__') and not callable(getattr(tx,a)):\n        print(\" \", a, \"=\", repr(getattr(tx,a))[:90])\nprint(\"=== raw vin ===\")\nprint(type(tx.vin), len(tx.vin))\nimport json\nfor v in tx.vin:\n    print({k:repr(getattr(v,k,None))[:60] for k in dir(v) if not k.startswith('__') and not callable(getattr(v,k))})\nprint(\"=== raw vout ===\")\nfor v in tx.vout:\n    print({k:repr(getattr(v,k,None))[:60] for k in dir(v) if not k.startswith('__') and not callable(getattr(v,k))})\nEOF\npython3 /tmp/explore4.py\n"]
