[363.407799, "i", "cat > /tmp/explore7.py << 'EOF'\nfrom bitcoinlib.services.services import Service\ns = Service(network='bitcoin')\nbh = s.blockcount()\nblk = s.getblock(bh)\ntx = blk.transactions[1]\nprint(\"tx txid\", tx.txid)\nprint(\"tx block_hash\", tx.block_hash, \"height\", tx.block_height)\nout = tx.outputs[0]\nsp = out.script\nprint(\"=== Script public methods ===\")\nfor a in dir(sp):\n    if not a.startswith('__'):\n        print(\" \", a, \"callable\" if callable(getattr(sp,a)) else repr(getattr(sp,a))[:60])\nprint(\"=== try getrawtransaction verbose ===\")\nrt = s.getrawtransaction(tx.txid, format='dict')\nprint(type(rt))\nif isinstance(rt, dict):\n    print(list(rt.keys()))\n    print(\"blockhash\", rt.get('blockhash'))\nEOF\npython3 /tmp/explore7.py\n"]
