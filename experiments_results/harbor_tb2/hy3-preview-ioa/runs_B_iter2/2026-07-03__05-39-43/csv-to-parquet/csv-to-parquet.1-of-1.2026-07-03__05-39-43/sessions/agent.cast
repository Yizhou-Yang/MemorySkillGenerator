[553.597166, "i", "cat > /app/read_parquet.py << 'PYEOF'\nimport struct\n\nclass Reader:\n    def __init__(self, b): self.b=b; self.i=0\n    def byte(self):\n        v=self.b[self.i]; self.i+=1; return v\n    def varint(self):\n        shift=0; res=0\n        while True:\n            v=self.byte()\n            res|=(v&0x7F)<<shift\n            if not (v&0x80): break\n            shift+=7\n        return res\n    def zigzag(self,n):\n        return (n>>1) ^ -(n&1)\n    def read(self):\n        t=self.byte()\n        ct=t&0x0F; delta=t>>4\n        if delta==0:\n            fid=self.zigzag(self.varint())\n        else:\n            fid=delta\n        return fid, ct\n\nENC={5:'i32',6:'i64',8:'bin',9:'lst',12:'st'}\n\ndef parse_struct(r):\n    out={}\n    while True:\n        fid,ct=r.read()\n        if ct==0: break\n        kind=ENC[ct]\n        if kind=='i32': v=r.zigzag(r.varint())\n        elif kind=='i64': v=r.zigzag(r.varint())\n        elif kind=='bin':\n            ln=r.varint(); v=r.b[fid*0:r.i+ln][-ln:]; r.i+=ln\n        elif kind=='lst':\n            h=r.byte(); elem=h&0x0F; n=h>>4\n            if n==15: n=r.varint()\n            v=[]\n            for _ in range(n):\n                if elem==5: v.append(r.zigzag(r.varint()))\n                elif elem==6: v.append(r.zigzag(r.varint()))\n                elif elem==8:\n                    ln=r.varint(); v.append(r.b[r.i:r.i+ln]); r.i+=ln\n                elif elem==12: v.append(parse_struct(r))\n        elif kind=='st': v=parse_struct(r)\n        out[fid]=v\n    return out\n\nwith open('/app/data.parquet','rb') as fh: data=fh.read()\nassert data[:4]==b'PAR1' and data[-4:]==b'PAR1'\nflen=struct.unpack('<I', data[-8:-4])[0]\nfooter=data[-8-flen:-8]\nfm=parse_struct(Reader(footer))\nschema=fm[2]\nroot=schema[0]\nncols=root[5]\ncols_meta=[schema[k] for k in range(1,ncols+1)]\nrg=fm[3][0]\nchunks=rg[1]\ncoltypes=[c[2] for c in cols_meta]\nnames=[c[1].decode() for c in cols_meta]\nntotal=rg[3]\nresult=[[] for _ in range(ncols)]\nfor j in range(ncols):\n    off=chunks[j][2][9]\n    ph=parse_struct(Reader(data[off:]))\n    phsize=ph[2]\n    start=off+phsize\n    body=data[start:start+ph[3]]\n    pos=0\n    if coltypes[j]==1:  # INT32\n        vals=[]\n        while pos+4<=len(body):\n            vals.append(struct.unpack('<i',body[pos:pos+4])[0]); pos+=4\n        result[j]=vals\n    else:  # BYTE_ARRAY\n        vals=[]\n        while pos+4<=len(body):\n            ln=struct.unpack('<i',body[pos:pos+4])[0]; pos+=4\n            vals.append(body[pos:pos+ln].decode('utf-8')); pos+=ln\n        result[j]=vals\n\nfor r in range(ntotal):\n    print(', '.join(str(result[c][r]) for c in range(ncols)))\nprint('cols:', names, 'rows:', ntotal)\nPYEOF\n"]
