[537.333498, "o", "            if isinstance(payload,str): payload=payload.encode()\r\n\u001b[?2004l\r\u001b[?2004h>             write_varint(buf, len(payload)); buf.extend(payload)\r\n\u001b[?2004l\r\u001b[?2004h>     elif kind=='l':\r\n\u001b[?2004l\r\u001b[?2004h>         elem,vals=payload; n=len(vals)\r\n\u001b[?2004l\r\u001b[?2004h>         if n<=14: buf.append((n<<4)|elem)\r\n\u001b[?2004l\r\u001b[?2004h>         else: buf.append(0xF0|elem); write_varint(buf,n)\r\n\u001b[?2004l\r\u001b[?2004h>         for v in vals:\r\n\u001b[?2004l\r\u001b[?2004h>             if elem==CT_I32: write_varint(buf, zigzag32(v))\r\n\u001b[?2004l\r\u001b[?2004h>             elif elem==CT_I64: write_varint(buf, zigzag64(v))\r\n\u001b[?2004l\r\u001b[?2004h>             elif elem==CT_BINARY:\r\n\u001b[?2004l\r\u001b[?2004h>                 vb=v if isinstance(v,bytes) else v.encode()\r\n\u001b[?2004l\r\u001b[?2004h>                 write_varint(buf,len(vb)); buf.extend(vb)\r\n\u001b[?2004l\r\u001b[?2004h>             elif elem==CT_STRUCT: write_struct(buf,v)\r\n\u001b[?2004l\r\u001b[?2004h>     elif kind=='t':\r\n\u001b[?2004l\r\u001b[?2004h>         write_struct(buf,payload)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def write_struct(buf,s):\r\n\u001b[?2004l\r\u001b[?2004h>     last=0\r\n\u001b[?2004l\r\u001b[?2004h>     for fid,ct,kind,payload in s.f:\r\n\u001b[?2004l\r\u001b[?2004h>         delta=fid-last\r\n\u001b[?2004l\r\u001b[?2004h>         if 0<delta<=15: buf.append((delta<<4)|ct)\r\n\u001b[?2004l\r\u001b[?2004h>         else: buf.append(ct); write_varint(buf, zigzag32(fid))\r\n\u001b[?2004l\r\u001b[?2004h>         last=fid\r\n\u001b[?2004l\r\u001b[?2004h>         write_value(buf,kind,ct,payload)\r\n\u001b[?2004l\r\u001b[?2004h>     buf.append(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/data.csv','r',encoding='utf-8') as fh:\r\n\u001b[?2004l\r\u001b[?2004h>     lines=[ln for ln in fh.read().splitlines() if ln.strip()!='']\r\n\u001b[?2004l\r\u001b[?2004h> header=lines[0].split(',')\r\n\u001b[?2004l\r\u001b[?2004h> rows=[ln.split(',') for ln in lines[1:]]\r\n\u001b[?2004l\r\u001b[?2004h> ncols=len(header); nrows=len(rows)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> col_types=[]\r\n\u001b[?2004l\r\u001b[?2004h> for j in range(ncols):\r\n\u001b[?2004l\r\u001b[?2004h>     isint=True\r\n\u001b[?2004l\r\u001b[?2004h>     for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>         try: int(r[j])\r\n\u001b[?2004l\r\u001b[?2004h>         except: isint=False; break\r\n\u001b[?2004l\r\u001b[?2004h>     col_types.append('INT32' if isint else 'BYTE_ARRAY')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def col_values(j):\r\n\u001b[?2004l\r\u001b[?2004h>     if col_types[j]=='INT32': return [int(rows[r][j]) for r in range(nrows)]\r\n\u001b[?2004l\r\u001b[?2004h>     return [rows[r][j].encode('utf-8') for r in range(nrows)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> file_data=bytearray(b'PAR1')\r\n\u001b[?2004l\r\u001b[?2004h> offsets=[]; meta=[]; total_sizes=[]\r\n\u001b[?2004l\r\u001b[?2004h> for j in range(ncols):\r\n\u001b[?2004l\r\u001b[?2004h>     vals=col_values(j)\r\n\u001b[?2004l\r\u001b[?2004h>     page=bytearray()\r\n\u001b[?2004l\r\u001b[?2004h>     if col_types[j]=='INT32':\r\n\u001b[?2004l\r\u001b[?2004h>         for v in vals: page+=struct.pack('<i',v)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         for v in vals: page+=struct.pack('<i',len(v))+v\r\n\u001b[?2004l\r\u001b[?2004h>     dph=S()\r\n\u001b[?2004l\r\u001b[?2004h>     dph.sc(1,CT_I32,0)        # DATA_PAGE\r\n\u001b[?2004l\r\u001b[?2004h>     dph.sc(2,CT_I32,nrows)\r\n\u001b[?2004l\r\u001b[?2004h>     dph.sc(3,CT_I32,0)        # PLAIN"]
