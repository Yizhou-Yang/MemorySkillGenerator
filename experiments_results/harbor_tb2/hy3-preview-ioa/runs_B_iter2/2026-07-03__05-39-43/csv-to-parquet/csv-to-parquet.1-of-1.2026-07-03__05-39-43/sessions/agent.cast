[553.968669, "o", "\u001b[?2004hroot@78f59cefca90:/app# "]
[622.131835, "i", "cat > /app/read_parquet.py << 'PYEOF'\nimport struct\n\nclass Reader:\n    def __init__(self, b): self.b=b; self.i=0\n    def byte(self):\n        v=self.b[self.i]; self.i+=1; return v\n    def varint(self):\n        shift=0; res=0\n        while True:\n            v=self.byte()\n            res|=(v&0x7F)<<shift\n            if not (v&0x80): break\n            shift+=7\n        return res\n    def zigzag(self,n):\n        return (n>>1) ^ -(n&1)\n    def read(self):\n        t=self.byte()\n        ct=t&0x0F; delta=t>>4\n        if delta==0:\n            fid=self.zigzag(self.varint())\n        else:\n            fid=delta\n        return fid, ct\n\nENC={3:'i08',4:'i16',5:'i32',6:'i64',7:'dbl',8:'bin',9:'lst',10:'set',11:'map',12:'st'}\n\ndef parse_struct(r, depth=0):\n    out={}\n    while True:\n        fid,ct=r.read()\n        if ct==0: break\n        if ct not in ENC:\n            print('UNKNOWN fid=%d ct=%d pos=%d bytes=%s' % (fid, ct, r.i-1, r.b[r.i-1:r.i+24].hex()))\n            return out\n        kind=ENC[ct]\n        if kind=='i32': v=r.zigzag(r.varint())\n        elif kind=='i64': v=r.zigzag(r.varint())\n        elif kind=='i16': v=r.zigzag(r.varint())\n        elif kind=='i08': v=r.byte()\n        elif kind=='dbl': v=struct.unpack('<d', r.b[r.i:r.i+8])[0]; r.i+=8\n        elif kind=='bin':\n            ln=r.varint(); v=r.b[r.i:r.i+ln]; r.i+=ln\n        elif kind in ('lst','set'):\n            h=r.byte(); elem=h&0x0F; n=h>>4\n            if n==15: n=r.varint()\n            v=[]\n            for _ in range(n):\n                if elem in (3,4,5,6): v.append(r.zigzag(r.varint()))\n                elif elem==7: v.append(struct.unpack('<d', r.b[r.i:r.i+8])[0]); r.i+=8\n                elif elem==8:\n                    ln=r.varint(); v.append(r.b[r.i:r.i+ln]); r.i+=ln\n                elif elem==12: v.append(parse_struct(r, depth+1))\n                else:\n                    print('UNK-ELEM elem=%d pos=%d bytes=%s' % (elem, r.i, r.b[r.i:r.i+24].hex())); break\n        elif kind=='st': v=parse_struct(r, depth+1)\n        out[fid]=v\n    return out\n\nwith open('/app/data.parquet','rb') as fh: data=fh.read()\nassert data[:4]==b'PAR1' and data[-4:]==b'PAR1'\nflen=struct.unpack('<I', data[-8:-4])[0]\nfooter=data[-8-flen:-8]\nprint('footer len', flen)\nfm=parse_struct(Reader(footer))\nprint('top keys', sorted(fm.keys()))\nprint('schema elems', len(fm.get(2,[])) if isinstance(fm.get(2),list) else 'n/a')\nPYEOF\n"]
[622.132872, "o", "cat > /app/read_parquet.py << 'PYEOF'"]
