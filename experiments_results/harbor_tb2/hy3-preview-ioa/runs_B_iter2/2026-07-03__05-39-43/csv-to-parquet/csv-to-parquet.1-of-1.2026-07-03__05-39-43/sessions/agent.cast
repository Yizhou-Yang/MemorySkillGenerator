[553.605684, "o", "\u001b[?2004h"]
[553.605761, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.60604, "o", "with open('/app/data.parquet','rb') as fh: data=fh.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.606157, "o", "assert data[:4]==b'PAR1' and data[-4:]==b'PAR1'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.606203, "o", "flen=struct.unpack('<I', data[-8:-4])[0]\r\n\u001b[?2004l\r"]
[553.606233, "o", "\u001b[?2004h> "]
[553.606348, "o", "footer=data[-8-flen:-8]\r\n\u001b[?2004l\r"]
[553.606383, "o", "\u001b[?2004h"]
[553.606569, "o", "> fm=parse_struct(Reader(footer))\r\n\u001b[?2004l\r"]
[553.606609, "o", "\u001b[?2004h> schema=fm[2]\r\n\u001b[?2004l\r"]
[553.606768, "o", "\u001b[?2004h> "]
[553.606803, "o", "root=schema[0]\r\n\u001b[?2004l\r"]
[553.606947, "o", "\u001b[?2004h> ncols=root[5]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.607163, "o", "cols_meta=[schema[k] for k in range(1,ncols+1)]\r\n\u001b[?2004l\r"]
[553.607207, "o", "\u001b[?2004h> "]
[553.607313, "o", "rg=fm[3][0]\r\n\u001b[?2004l\r"]
[553.607447, "o", "\u001b[?2004h> "]
[553.607521, "o", "chunks=rg[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.607619, "o", "coltypes=[c[2] for c in cols_meta]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.607742, "o", "names=[c[1].decode() for c in cols_meta]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.607815, "o", "ntotal=rg[3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.607922, "o", "result=[[] for _ in range(ncols)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.608026, "o", "for j in range(ncols):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.608075, "o", "    off=chunks[j][2][9]\r\n\u001b[?2004l\r"]
[553.608105, "o", "\u001b[?2004h> "]
[553.608239, "o", "    ph=parse_struct(Reader(data[off:]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.608482, "o", "    phsize=ph[2]\r\n\u001b[?2004l\r\u001b[?2004h>     start=off+phsize\r\n\u001b[?2004l\r\u001b[?2004h>     body=data[start:start+ph[3]]\r\n\u001b[?2004l\r"]
[553.608585, "o", "\u001b[?2004h>     pos=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.608685, "o", "    if coltypes[j]==1:  # INT32\r\n\u001b[?2004l\r\u001b[?2004h>         vals=[]\r\n\u001b[?2004l\r"]
[553.608732, "o", "\u001b[?2004h> "]
[553.60888, "o", "        while pos+4<=len(body):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.609054, "o", "            vals.append(struct.unpack('<i',body[pos:pos+4])[0]); pos+=4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.609107, "o", "        result[j]=vals\r\n\u001b[?2004l\r"]
[553.60914, "o", "\u001b[?2004h> "]
[553.609269, "o", "    else:  # BYTE_ARRAY\r\n\u001b[?2004l\r\u001b[?2004h>         vals=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.609466, "o", "        while pos+4<=len(body):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.609728, "o", "            ln=struct.unpack('<i',body[pos:pos+4])[0]; pos+=4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.609784, "o", "            vals.append(body[pos:pos+ln].decode('utf-8')); pos+=ln\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.610034, "o", "        result[j]=vals\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for r in range(ntotal):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.610115, "o", "    print(', '.join(str(result[c][r]) for c in range(ncols)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.610321, "o", "print('cols:', names, 'rows:', ntotal)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
