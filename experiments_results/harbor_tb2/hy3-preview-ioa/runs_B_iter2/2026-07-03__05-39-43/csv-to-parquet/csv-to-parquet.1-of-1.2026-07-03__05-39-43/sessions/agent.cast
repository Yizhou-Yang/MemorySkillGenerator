[459.843369, "o", "\u001b[?2004hroot@78f59cefca90:/app# "]
[460.195838, "i", "python3 /app/make_parquet.py\n"]
[460.198453, "o", "python3 /app/make_parquet.py\r\n\u001b[?2004l\r"]
[460.234583, "o", "wrote 352 bytes; 5 rows, 3 cols; types= ['BYTE_ARRAY', 'INT32', 'BYTE_ARRAY']\r\n"]
[460.240631, "m", "Episode 12: 2 commands"]
[460.240631, "o", "\u001b[?2004hroot@78f59cefca90:/app# "]
[537.319746, "i", "cat > /app/make_parquet.py << 'PYEOF'\nimport csv, struct\n\ndef write_varint(buf, n):\n    while True:\n        b = n & 0x7F\n        n >>= 7\n        if n:\n            buf.append(b | 0x80)\n        else:\n            buf.append(b); break\n\ndef zigzag32(n):\n    return ((n << 1) ^ (n >> 31)) & 0xFFFFFFFF\ndef zigzag64(n):\n    return ((n << 1) ^ (n >> 63)) & 0xFFFFFFFFFFFFFFFF\n\nCT_I32=5; CT_I64=6; CT_BINARY=8; CT_LIST=9; CT_STRUCT=12\n\nclass S:\n    def __init__(self): self.f=[]\n    def sc(self,fid,ct,v): self.f.append((fid,ct,'s',v))\n    def lst(self,fid,elem,vals): self.f.append((fid,CT_LIST,'l',(elem,vals)))\n    def st(self,fid,val): self.f.append((fid,CT_STRUCT,'t',val))\n\ndef write_value(buf,kind,ct,payload):\n    if kind=='s':\n        if ct==CT_I32: write_varint(buf, zigzag32(payload))\n        elif ct==CT_I64: write_varint(buf, zigzag64(payload))\n        elif ct==CT_BINARY:\n            if isinstance(payload,str): payload=payload.encode()\n            write_varint(buf, len(payload)); buf.extend(payload)\n    elif kind=='l':\n        elem,vals=payload; n=len(vals)\n        if n<=14: buf.append((n<<4)|elem)\n        else: buf.append(0xF0|elem); write_varint(buf,n)\n        for v in vals:\n            if elem==CT_I32: write_varint(buf, zigzag32(v))\n            elif elem==CT_I64: write_varint(buf, zigzag64(v))\n            elif elem==CT_BINARY:\n                vb=v if isinstance(v,bytes) else v.encode()\n                write_varint(buf,len(vb)); buf.extend(vb)\n            elif elem==CT_STRUCT: write_struct(buf,v)\n    elif kind=='t':\n        write_struct(buf,payload)\n\ndef write_struct(buf,s):\n    last=0\n    for fid,ct,kind,payload in s.f:\n        delta=fid-last\n        if 0<delta<=15: buf.append((delta<<4)|ct)\n        else: buf.append(ct); write_varint(buf, zigzag32(fid))\n        last=fid\n        write_value(buf,kind,ct,payload)\n    buf.append(0)\n\nwith open('/app/data.csv','r',encoding='utf-8') as fh:\n    lines=[ln for ln in fh.read().splitlines() if ln.strip()!='']\nheader=lines[0].split(',')\nrows=[ln.split(',') for ln in lines[1:]]\nncols=len(header); nrows=len(rows)\n\ncol_types=[]\nfor j in range(ncols):\n    isint=True\n    for r in rows:\n        try: int(r[j])\n        except: isint=False; break\n    col_types.append('INT32' if isint else 'BYTE_ARRAY')\n\ndef col_values(j):\n    if col_types[j]=='INT32': return [int(rows[r][j]) for r in range(nrows)]\n    return [rows[r][j].encode('utf-8') for r in range(nrows)]\n\nfile_data=bytearray(b'PAR1')\noffsets=[]; meta=[]; total_sizes=[]\nfor j in range(ncols):\n    vals=col_values(j)\n    page=bytearray()\n    if col_types[j]=='INT32':\n        for v in vals: page+=struct.pack('<i',v)\n    else:\n        for v in vals: page+=struct.pack('<i',len(v))+v\n    dph=S()\n    dph.sc(1,CT_I32,0)        # DATA_PAGE\n    dph.sc(2,CT_I32,nrows)\n    dph.sc(3,CT_I32,0)        # PLAIN\n    dph.sc(4,CT_I32,3)        # def_level RLE\n    dph.sc(5,CT_I32,3)        # rep_level RLE\n    ph=S()\n    ph.sc(1,CT_I32,0)         # PageHeader.type = DATA_PAGE\n    ph.sc(2,CT_I32,len(page))\n    ph.sc(3,CT_I32,len(page))\n    ph.st(6,dph)              # data_page_header is field 6\n    phb=bytearray(); write_struct(phb,ph)\n    off=len(file_data)\n    file_data+=phb; file_data+=page\n    offsets.append(off); total_sizes.append(len(phb)+len(page))\n    cm=S()\n    cm.sc(1,CT_I32,1 if col_types[j]=='INT32' else 6)\n    cm.lst(2,CT_I32,[0,3])    # PLAIN, RLE\n    cm.lst(3,CT_BINARY,[header[j]])\n    cm.sc(4,CT_I32,0)\n    cm.sc(5,CT_I64,nrows)\n    cm.sc(6,CT_I64,total_sizes[-1])\n    cm.sc(7,CT_I64,total_sizes[-1])\n    cm.sc(9,CT_I64,off)\n    meta.append(cm)\n\nroot=S(); root.sc(1,CT_BINARY,'schema'); root.sc(4,CT_I32,0); root.sc(5,CT_I32,ncols)\nschema=[root]\nfor j in range(ncols):\n    se=S(); se.sc(1,CT_BINARY,header[j]); se.sc(2,CT_I32,1 if col_types[j]=='INT32' else 6); se.sc(4,CT_I32,0)\n    if col_types[j]=='BYTE_ARRAY': se.sc(6,CT_I32,1)\n    schema.append(se)\n\ncols=[]\nfor j in range(ncols):\n    cc=S(); cc.sc(2,CT_I64,offsets[j]); cc.st(3,meta[j]); cols.append(cc)\nrg=S(); rg.lst(1,CT_STRUCT,cols); rg.sc(2,CT_I64,sum(total_sizes)); rg.sc(3,CT_I64,nrows)\n\nfm=S(); fm"]
[537.3199, "i", ".sc(1,CT_I32,1); fm.lst(2,CT_STRUCT,schema); fm.lst(3,CT_STRUCT,[rg]); fm.sc(5,CT_BINARY,'parquet-tools')\nfmb=bytearray(); write_struct(fmb,fm)\nout=bytearray(); out+=file_data; out+=fmb; out+=struct.pack('<I',len(fmb)); out+=b'PAR1'\nwith open('/app/data.parquet','wb') as fh: fh.write(out)\nprint('wrote', len(out), 'bytes;', nrows,'rows,',ncols,'cols; types=',col_types)\nPYEOF\n"]
