[29.443283, "o", "\r\n    \u001b[33msend \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mpassword\u001b[39;49;00m\u001b[33m\\\\\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexpect eof\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexit\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mEOF\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33mchmod +x git_push.exp\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m./git_push.exp\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m# Give nginx time to update\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33msleep 3\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33mMAIN=$(curl -sk https://localhost:8443/index.html)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mDEV=$(curl -sk https://localhost:8443/dev/index.html)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33mif [ \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m$MAIN\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m = \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mmain branch content\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m ] && [ \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m$DEV\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m = \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mdev branch content\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m ]; then\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m  echo \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mTEST PASSED\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33melse\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m  echo \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mTES