[210.79172, "i", "cat > /tmp/push_ssh.exp <<'EOF'\n#!/usr/bin/expect -f\nset timeout 30\nspawn bash -c {cd /tmp && rm -rf t && git init -q -b main t && cd t && git config user.email x@x && git config user.name x && echo '<h1>SSHMAIN</h1>' > index.html && git add -A && git commit -qm m && git remote add origin git@localhost:/git/project && time git push -q origin main}\nexpect {\n  -re {password:} { send \"password\\r\"; exp_continue }\n  eof { }\n}\nEOF\nchmod +x /tmp/push_ssh.exp; time /tmp/push_ssh.exp\n"]
