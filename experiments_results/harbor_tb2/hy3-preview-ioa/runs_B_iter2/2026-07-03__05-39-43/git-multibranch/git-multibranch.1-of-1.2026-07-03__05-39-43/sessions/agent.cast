[109.356249, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nwhile read oldrev newrev refname; do\n  [ \"$newrev\" = \"0000000000000000000000000000000000000000\" ] && continue\n  branch=\"${refname#refs/heads/}\"\n  case \"$branch\" in\n    main) target=/var/www/main ;;\n    dev) target=/var/www/dev ;;\n    *) continue ;;\n  esac\n  mkdir -p \"$target\"\n  find \"$target\" -mindepth 1 -delete\n  git --git-dir=/git/project archive \"$newrev\" | tar -x -C \"$target\"\ndone\nEOF\n"]
[109.356951, "o", "cat > /git/project/hooks/post-receive <<'EOF'"]
[109.357178, "o", "\r\n"]
