[517.878519, "i", "cat > /tmp/pushboth.exp <<'EOF'\n#!/usr/bin/expect -f\nset timeout 30\nspawn bash -c {cd /tmp && rm -rf tb && git init -q -b main tb && cd tb && git config user.email x@x && git config user.name x && echo '<h1>GMAIN</h1>' > index.html && git add -A && git commit -qm m && git checkout -q -b dev && echo '<h1>GDEV</h1>' > index.html && git add -A && git commit -qm d && git remote add origin git@localhost:/git/project && time git push -q origin main dev}\nexpect {\n  -re {password:} { send \"password\\r\"; exp_continue }\n  eof { }\n}\nEOF\nchmod +x /tmp/pushboth.exp; time /tmp/pushboth.exp\n"]
