[15.302531, "o", "<!DOCTYPE html><html><head><title>Book Store</title></head><body><h1>Simple Book Store</h1><div class='books-container'>"]
[15.303092, "o", "\r\n            <div class=\"book\">\r\n                <div class=\"book-title\">The Great Gatsby</div>\r\n                <div class=\"book-author\">by F. Scott Fitzgerald</div>\r\n                <div class=\"book-details\">\r\n                    <span class=\"book-year\">Published: 1925</span>\r\n                    <span class=\"book-rating\">Rating: 4.2/5</span>\r\n                    <span class=\"book-price\">$12.99</span>\r\n                </div>\r\n            </div>\r\n            \r\n            <div class=\"book\">\r\n                <div class=\"book-title\">To Kill a Mockingbird</div>\r\n                <div class=\"book-author\">by Harper Lee</div>\r\n                <div class=\"book-details\">\r\n                    <span class=\"book-year\">Published: 1960</span>\r\n                    <span class=\"book-rating\">Rating: 4.8/5</span>\r\n                    <span class=\"book-price\">$14.99</span>\r\n                </div>\r\n            </div>\r\n            \r\n            <div class=\"book\">\r\n                <div class=\"book-title\">1984</div>\r\n            "]
[15.303133, "o", "    <div class=\"book-author\">by George Orwell</div>\r\n                <div class=\"book-details\">\r\n                    <span class=\"book-year\">Published: 1949</span>\r\n                    <span class=\"book-rating\">Rating: 4.6/5</span>\r\n                    <span class=\"book-price\">$11.99</span>\r\n                </div>\r\n            </div>\r\n            \r\n            <div class=\"book\">\r\n"]
