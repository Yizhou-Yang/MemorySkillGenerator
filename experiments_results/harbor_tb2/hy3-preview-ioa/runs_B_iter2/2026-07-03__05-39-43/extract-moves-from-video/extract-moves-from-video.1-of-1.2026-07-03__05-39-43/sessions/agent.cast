[613.926456, "i", "cat > /tmp/dl.py <<'PYEOF'\nimport concurrent.futures, re, os, urllib.request\n\ndest = '/app/aptcache'\nos.makedirs(dest, exist_ok=True)\nuris = []\nwith open('/tmp/uris.txt') as f:\n    for line in f:\n        line = line.strip()\n        if not line.startswith(\"'http\"):\n            continue\n        m = re.match(r\"'([^']+)'\\s+(\\S+)\\s+(\\d+)\\s\", line)\n        if m:\n            uris.append((m.group(1), m.group(2), int(m.group(3))))\n\nprint('urls', len(uris))\n\ndef fetch(item):\n    url, name, size = item\n    path = os.path.join(dest, name)\n    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})\n    try:\n        data = urllib.request.urlopen(req, timeout=90).read()\n        with open(path, 'wb') as fh:\n            fh.write(data)\n        if len(data) != size:\n            return name, 'SIZEMISMATCH %d!=%d' % (len(data), size)\n        return name, 'ok'\n    except Exception as e:\n        return name, 'FAIL:%s' % e\n\nok = 0\nwith concurrent.futures.ThreadPoolExec"]
[613.926766, "o", "cat > /tmp/dl.py <<'PYEOF'\r\n\u001b[?2004l\r"]
[613.926823, "i", "utor(max_workers=12) as ex:\n    for name, status in ex.map(fetch, uris):\n        if status != 'ok':\n            print('FAILED', name, status)\n        else:\n            ok += 1\nprint('done ok=', ok)\nPYEOF\n"]
