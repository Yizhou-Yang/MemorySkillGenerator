[505.519728, "o", "root@64a18bc4bcc3:/app# "]
[516.752867, "i", "mkdir -p /app/debs\ncat > /app/dl.py <<'EOF'\nimport urllib.request, re, sys, os\nout='/app/debs'\nos.makedirs(out, exist_ok=True)\nurls=[]\nfor line in open('/app/uris.txt'):\n    line=line.strip()\n    if not line.startswith(\"'\"):\n        continue\n    url=line[1:line.index(\"'\",1)]\n    fn=line.split()[1]\n    urls.append((url,fn))\nprint('total',len(urls))\nhdr={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120 Safari/537.36','Accept':'*/*'}\nok=0\nfor i,(url,fn) in enumerate(urls):\n    dest=os.path.join(out,fn)\n    if os.path.exists(dest) and os.path.getsize(dest)>0:\n        ok+=1; continue\n    try:\n        req=urllib.request.Request(url,headers=hdr)\n        with urllib.request.urlopen(req,timeout=120) as r, open(dest,'wb') as f:\n            f.write(r.read())\n        ok+=1\n    except Exception as e:\n        print('FAIL',fn,e)\n    if (i+1)%50==0:\n        print('progress',i+1,ok)\nprint('done ok',ok,'of',len(urls))\nEOF\necho written\n"]
[516.756124, "o", "mkdir -p /app/debs\r\n\u001b[?2004l\r"]
