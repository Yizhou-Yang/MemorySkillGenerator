[2013.808505, "i", "python3 - <<'EOF'\nimport urllib.request, os\nout='/app/debs2'; os.makedirs(out, exist_ok=True)\nurls=[]\nfor line in open('/app/uris2.txt'):\n    line=line.strip()\n    if not line.startswith(\"'\"): continue\n    url=line[1:line.index(\"'\",1)]; fn=line.split()[1]\n    urls.append((url,fn))\nhdr={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120 Safari/537.36','Accept':'*/*'}\nok=0\nfor url,fn in urls:\n    dest=os.path.join(out,fn)\n    if os.path.exists(dest) and os.path.getsize(dest)>0:\n        ok+=1; continue\n    try:\n        req=urllib.request.Request(url,headers=hdr)\n        with urllib.request.urlopen(req,timeout=120) as r, open(dest,'wb') as f:\n            f.write(r.read())\n        ok+=1\n    except Exception as e:\n        print('FAIL',fn,e)\nprint('done',ok,'of',len(urls))\nEOF\n"]
[2013.811358, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request, os\r\n\u001b[?2004l\r\u001b[?2004h> out='/app/debs2'; os.makedirs(out, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> urls=[]\r\n\u001b[?2004l\r\u001b[?2004h> for line in open('/app/uris2.txt'):"]
[2013.812488, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     line=line.strip()\r\n\u001b[?2004l\r"]
[2013.815198, "o", "\u001b[?2004h> "]
