[1563.681069, "i", "python3 - <<'EOF'\np='/app/linux-6.9/init/main.c'\nlines=open(p).read().split('\\n')\n# find start_kernel line\nidx=None\nfor i,l in enumerate(lines):\n    if l.strip()=='void start_kernel(void)':\n        idx=i\n        break\nassert idx is not None, 'start_kernel not found'\n# find opening brace after idx\nb=None\nfor j in range(idx, idx+5):\n    if lines[j].strip()=='{':\n        b=j\n        break\nassert b is not None\nins='\\tprintk(KERN_INFO \"Hello, this is a custom kernel\\\");'\nlines.insert(b+1, ins)\nopen(p,'w').write('\\n'.join(lines))\nprint('inserted after line', b+1)\nEOF\n"]
[1563.681961, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1563.682117, "o", "> p='/app/linux-6.9/init/main.c'"]
