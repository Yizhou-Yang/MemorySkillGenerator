[33.144259, "i", "cat > /app/grid_transform.py << 'EOF'\ndef solve(input_grid):\n    \"\"\"\n    Transform a 2x2 input grid into a 6x6 output grid.\n\n    The output is a 3x3 tiling of the 2x2 input block. Odd block-rows are\n    horizontally mirrored versions of the input block; even block-rows are\n    the original block.\n\n    Args:\n        input_grid (List[List[int]]): 2D list of integers representing the input grid\n\n    Returns:\n        List[List[int]]: 2D list of integers representing the transformed grid\n    \"\"\"\n    h = len(input_grid)\n    w = len(input_grid[0]) if h else 0\n\n    output = []\n    for br in range(3):\n        for i in range(h):\n            row = []\n            for bc in range(3):\n                if br % 2 == 1:\n                    # horizontally mirrored block\n                    row.extend(reversed(input_grid[i]))\n                else:\n                    row.extend(input_grid[i])\n            output.append(row)\n    return output\nEOF\n"]
