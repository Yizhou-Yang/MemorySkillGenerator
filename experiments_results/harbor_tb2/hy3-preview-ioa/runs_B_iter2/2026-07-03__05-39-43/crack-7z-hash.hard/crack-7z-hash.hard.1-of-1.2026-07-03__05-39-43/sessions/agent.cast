001b[?2004h>                 t=r.read_byte()\r\n\u001b[?2004l\r\u001b[?2004h>                 if t==0x00: break\r\n\u001b[?2004l\r\u001b[?2004h>                 sz=r.read_num(); r.read(sz)\r\n\u001b[?2004l\r\u001b[?2004h>         elif id in (0x03,0x04):\r\n\u001b[?2004l\r\u001b[?2004h>             p=parse_packed_streams(r)\r\n\u001b[?2004l\r\u001b[?2004h>             res.update(p)\r\n\u001b[?2004l\r\u001b[?2004h>         elif id==0x05:\r\n\u001b[?2004l\r\u001b[?2004h>             res['files']=parse_files_info(r)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             raise Exception('unknown header id %02x'%id)\r\n\u001b[?2004l\r\u001b[?2004h>     return res\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lzma2_dict(prop):\r\n\u001b[?2004l\r\u001b[?2004h>     if prop<40: return (2|(prop&1))<<((prop>>1)+11)\r\n\u001b[?2004l\r\u001b[?2004h>     return (3|(prop&3))<<((prop>>2)+8)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def decompress(props, data, method):\r\n\u001b[?2004l\r\u001b[?2004h>     if method==0x00: return data\r\n\u001b[?2004l\r\u001b[?2004h>     if method==0x030101:\r\n\u001b[?2004l\r\u001b[?2004h>         prop=props[0]; ds=struct.unpack('<I',props[1:5])[0]\r\n\u001b[?2004l\r\u001b[?2004h>         lc=prop%9; rem=prop//9; lp=rem%5; pb=rem//5\r\n\u001b[?2004l\r\u001b[?2004h>         filt=[{'id':lzma.FILTER_LZMA1,'dict_size':ds,'lc':lc,'lp':lp,'pb':pb}]\r\n\u001b[?2004l\r\u001b[?2004h>     elif method==0x21:\r\n\u001b[?2004l\r\u001b[?2004h>         filt=[{'id':lzma.FILTER_LZMA2,'dict_size':lzma2_dict(props[0])}]\r\n\u001b[?2004l\r\u001b[?2004h>     else: raise Exception('unsupported method %x'%method)\r\n\u001b[?2004l\r\u001b[?2004h>     d=lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=filt)\r\n\u001b[?2004l\r\u001b[?2004h>     return d.decompress(data)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data=open('/app/secrets.7z','rb').read()\r\n\u001b[?2004l\r\u001b[?2004h> assert data[:6]==b'\\x37\\x7a\\xbc\\xaf\\x27\\x1c'\r\n\u001b[?2004l\r\u001b[?2004h> next_off=struct.unpack('<Q',data[12:20])[0]\r\n\u001b[?2004l\r\u001b[?2004h> next_size=struct.unpack('<Q',data[20:28])[0]\r\n\u001b[?2004l\r\u001b[?2004h> nh=data[32+next_off:32+next_off+next_size]\r\n\u001b[?2004l\r\u001b[?2004h> r=Reader(nh)\r\n\u001b[?2004l\r\u001b[?2004h> print('nh[0]=%02x nhsize=%d'%(r.peek_byte(),len(nh)))\r\n\u001b[?2004l\r\u001b[?2004h> if r.peek_byte()==0x17:\r\n\u001b[?2004l\r\u001b[?2004h>     r.read_byte()\r\n\u001b[?2004l\r\u001b[?2004h>     eh=parse_packed_streams(r)\r\n\u001b[?2004l\r\u001b[?2004h>     print('enc pack_pos=%d pack_sizes=%s'%(eh['pack_pos'],eh['pack_sizes']))\r\n\u001b[?2004l\r\u001b[?2004h>     f=eh['folders'][0]; c=f['coders'][0]\r\n\u001b[?2004l\r\u001b[?2004h>     print('enc coder id=%x props=%s'%(c['id'],c['props'].hex() if 'props' in c else None))\r\n\u001b[?2004l\r\u001b[?2004h>     estream=data[32+eh['pack_pos']:32+eh['pack_pos']+eh['pack_sizes'][0]]\r\n\u001b[?2004l\r\u001b[?2004h>"]
