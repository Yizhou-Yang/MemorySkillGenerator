[216.082511, "i", "cat > /tmp/decode7z.py << 'PYEOF'\nimport struct, lzma, sys\n\nclass Reader:\n    def __init__(self, data):\n        self.data = data; self.pos = 0\n    def read_byte(self):\n        b = self.data[self.pos]; self.pos += 1; return b\n    def peek_byte(self):\n        return self.data[self.pos]\n    def read(self, n):\n        d = self.data[self.pos:self.pos+n]; self.pos += n; return d\n    def read_num(self):\n        b = self.read_byte(); val = b & 0x7f; shift = 7\n        while b & 0x80:\n            b = self.read_byte(); val |= (b & 0x7f) << shift; shift += 7\n        return val\n    def eof(self):\n        return self.pos >= len(self.data)\n\ndef parse_folder(r):\n    f = {}; n = r.read_num(); coders = []; tin = 0; tout = 0\n    for _ in range(n):\n        b = r.read_byte(); complex_c = b & 1; has_attrs = (b & 2) != 0\n        idsize = (b >> 2) & 0x0F; mid = 0\n        for i in range(idsize):\n            mid |= r.read_byte() << (8*i)\n        c = {'id': mid}\n        if complex_c:\n            c['ni'] = r.read_num(); c['no'] = r.read_num()\n        else:\n            c['ni'] = 1; c['no'] = 1\n        tin += c['ni']; tout += c['no']\n        if has_attrs:\n            pl = r.read_num(); c['props'] = r.read(pl)\n        coders.append(c)\n    f['coders'] = coders; f['ni'] = tin; f['no'] = tout\n    if any(c.get('ni',1)!=1 or c.get('no',1)!=1 for c in coders):\n        nb = n - 1\n        for _ in range(nb):\n            r.read_num(); r.read_num()\n        for _ in range(tin - nb):\n            r.read_num()\n    return f\n\ndef parse_files_info(r):\n    num = r.read_num(); names = []\n    while not r.eof():\n        t = r.read_byte()\n        if t == 0x00: break\n        sz = r.read_num(); buf = r.read(sz)\n        if t == 0x11:\n            s = buf.decode('utf-16-le'); names = s.split('\\x00')[:num]\n    return {'num': num, 'names': names}\n\ndef parse_header_db(r):\n    db = {'pack_sizes': [], 'pack_pos': 0, 'folders': [], 'files': {'names': []}}\n    while not r.eof():\n        id = r.read_byte()\n        if id == 0x00: break\n        elif id == 0x06:\n            db['pack_pos'] = r.read_num(); num = r.read_num()\n            while True:\n                t = r.read_byte()\n                if t == 0x09: db['pack_sizes'] = [r.read_num() for _ in range(num)]\n                elif t == 0x0A: r.read(4*num)\n                elif t == 0x00: break\n                else: raise Exception('bad pack %02x'%t)\n        elif id == 0x07:\n            while True:\n                t = r.read_byte()\n                if t == 0x0B:\n                    nf = r.read_num(); ext = r.read_byte()\n                    if ext == 0: db['folders'] = [parse_folder(r) for _ in range(nf)]\n                    else: raise Exception('external folder')\n                elif t == 0x0C:\n                    for f in db['folders']:\n                        f['unpack_sizes'] = [r.read_num() for _ in range(f['no'])]\n                elif t == 0x0A:\n                    for f in db['folders']: r.read_num()\n                elif t == 0x00: break\n                else: raise Exception('bad unpack %02x'%t)\n        elif id == 0x08:\n            while True:\n                t = r.read_byte()\n                if t == 0x00: break\n                if t == 0x0D:\n                    for f in db['folders']: f['num_u'] = r.read_num()\n                elif t == 0x09:\n                    total = sum(f.get('num_u',1) for f in db['folders'])\n                    for _ in range(total): r.read_num()\n                elif t == 0x0A:\n                    total = sum(f.get('num_u',1) for f in db['folders'])\n                    for _ in range(total): r.read_num()\n                else: break\n        elif id == 0x05:\n            db['files'] = parse_files_info(r)\n        elif id == 0x02:\n            while True:\n                t = r.read_byte()\n                if t == 0x00: break\n                sz = r.read_num(); r.read(sz)\n        else:\n            raise Exception('unknown header id %02x'%id)\n    return db\n\ndef lzma2_dict(prop):\n    if prop < 40:\n        return (2 | (prop & 1)) << ((prop >> 1) + 11)\n    return (3 | (prop & 3)) << ((prop >> 2) + 8)\n\ndef decompress(props,"]
[216.082566, "i", " data, method):\n    if method == 0x00:\n        return data\n    if method == 0x030101:\n        prop = props[0]; ds = struct.unpack('<I', props[1:5])[0]\n        lc = prop % 9; rem = prop // 9; lp = rem % 5; pb = rem // 5\n        filt = [{'id': lzma.FILTER_LZMA1, 'dict_size': ds, 'lc': lc, 'lp': lp, 'pb': pb}]\n    elif method == 0x21:\n        filt = [{'id': lzma.FILTER_LZMA2, 'dict_size': lzma2_dict(props[0])}]\n    else:\n        raise Exception('unsupported method %x'%method)\n    d = lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=filt)\n    return d.decompress(data)\n\n# main\ndata = open('/app/secrets.7z','rb').read()\nassert data[:6] == b'\\x37\\x7a\\xbc\\xaf\\x27\\x1c', 'not 7z'\nnext_off = struct.unpack('<Q', data[12:20])[0]\nnext_size = struct.unpack('<Q', data[20:28])[0]\nnh = data[32+next_off: 32+next_off+next_size]\nr = Reader(nh)\nprint('nh first byte', hex(r.peek_byte()), 'nh size', len(nh))\nif r.peek_byte() == 0x17:\n    enc_db = parse_header_db(r)\n    enc_stream = nh[r.pos: r.pos + enc_db['pack_sizes'][0]]\n    f = enc_db['folders'][0]; c = f['coders'][0]\n    print('encoded coder id %x props' % c['id'], c['props'].hex())\n    dec = decompress(c['props'], enc_stream, c['id'])\n    print('decoded header len', len(dec), 'prefix', dec[:8].hex())\n    r2 = Reader(dec); db = parse_header_db(r2)\nelse:\n    db = parse_header_db(r)\n\nprint('main folders', len(db['folders']), 'pack_pos', db['pack_pos'], 'pack_sizes', db['pack_sizes'])\nf = db['folders'][0]; c = f['coders'][0]\nprint('main coder id %x props' % c['id'], (c['props'].hex() if 'props' in c else None))\nstream = data[32 + db['pack_pos']: 32 + db['pack_pos'] + db['pack_sizes'][0]]\ncontent = decompress(c['props'], stream, c['id'])\nprint('CONTENT len', len(content))\nprint('CONTENT:', repr(content))\nprint('NAMES:', db['files'].get('names'))\nopen('/app/solution.txt','wb').write(content.strip())\nprint('WROTE /app/solution.txt')\nPYEOF\n"]
