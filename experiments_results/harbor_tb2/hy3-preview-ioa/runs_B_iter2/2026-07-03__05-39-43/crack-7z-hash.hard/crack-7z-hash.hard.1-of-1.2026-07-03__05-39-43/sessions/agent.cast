[566.757559, "i", "cat > /tmp/explore.py << 'PYEOF'\nimport lzma\nfrom lzma import FILTER_LZMA1\n\ndata=open('/app/secrets.7z','rb').read()\nprint('file len', len(data))\n\ndef try_alone(start):\n    try:\n        d=lzma.LZMADecompressor(format=lzma.FORMAT_ALONE)\n        out=d.decompress(data[start:])\n        return out\n    except Exception as e:\n        return ('ERR',str(e))\n\ndef try_raw(start):\n    try:\n        filt=[{'id':FILTER_LZMA1,'dict_size':0x1000,'lc':3,'lp':0,'pb':2}]\n        d=lzma.LZMADecompressor(format=lzma.FORMAT_RAW,filters=filt)\n        out=d.decompress(data[start:])\n        return out\n    except Exception as e:\n        return ('ERR',str(e))\n\nhdr=b'\\x5d\\x00\\x10\\x00\\x00'\nprint('LZMA header occurrences:')\npos=0\nwhile True:\n    i=data.find(hdr,pos)\n    if i<0: break\n    print('  at offset', i)\n    pos=i+1\n\nprint('\\n--- FORMAT_ALONE trials at header positions ---')\npos=0\nwhile True:\n    i=data.find(hdr,pos)\n    if i<0: break\n    r=try_alone(i)\n    print('start',i,'->', repr(r)[:120] if not isinstance(r,tuple) else r)\n    pos=i+1\n\nprint('\\n--- FORMAT_RAW trials at header positions (skip 5-byte header) ---')\npos=0\nwhile True:\n    i=data.find(hdr,pos)\n    if i<0: break\n    r=try_raw(i+5)\n    print('start',i+5,'->', repr(r)[:120] if not isinstance(r,tuple) else r)\n    pos=i+1\n\nprint('\\n--- FORMAT_ALONE over whole packed region starting at 32 ---')\nprint(try_alone(32))\nPYEOF\n"]
