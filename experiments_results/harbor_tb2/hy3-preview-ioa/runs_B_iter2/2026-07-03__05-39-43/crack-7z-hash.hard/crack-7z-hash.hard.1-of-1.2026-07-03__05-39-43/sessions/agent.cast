[290.793711, "i", "      if has_attrs:\n            pl=r.read_num(); c['props']=r.read(pl)\n        cs.append(c)\n    f['coders']=cs; f['no']=tout\n    return f\n\ndef parse_packed_streams(r):\n    res={'pack_pos':0,'pack_sizes':[],'folders':[]}\n    while True:\n        if r.eof(): break\n        id=r.read_byte()\n        if id==0x00: break\n        elif id==0x06:\n            res['pack_pos']=r.read_num(); num=r.read_num()\n            while True:\n                t=r.read_byte()\n                if t==0x09: res['pack_sizes']=[r.read_num() for _ in range(num)]\n                elif t==0x0A: r.read(4*num)\n                elif t==0x00: break\n                else: raise Exception('bad pack %02x'%t)\n        elif id==0x07:\n            while True:\n                t=r.read_byte()\n                if t==0x0B:\n                    nf=r.read_num(); ext=r.read_byte()\n                    if ext==0: res['folders']=[parse_folder(r) for _ in range(nf)]\n                    else: raise Exception('external folder')\n                elif t==0x0C:\n                    for f in res['folders']: f['unpack_sizes']=[r.read_num() for _ in range(f['no'])]\n                elif t==0x0A:\n                    for f in res['folders']: f['num_u']=r.read_num()\n                elif t==0x00: break\n                else: raise Exception('bad unpack %02x'%t)\n        elif id==0x08:\n            while True:\n                t=r.read_byte()\n                if t==0x00: break\n                elif t==0x0D:\n                    for f in res['folders']:\n                        nu=r.read_num(); f['substreams']=nu\n                elif t==0x0C:\n                    for f in res['folders']:\n                        for _ in range((f.get('substreams',1))-1): r.read_num()\n                elif t==0x0A:\n                    while True:\n                        tt=r.read_byte()\n                        if tt==0x00: break\n                        elif (tt&0x80)!=0: r.read_num()\n                        else: r.read(4)\n                else: raise Exception('bad sub %02x'%t)\n        else:\n            raise Exception('unknown packed id %02x'%id)\n    return res\n\ndef parse_files_info(r):\n    num=r.read_num(); names=[]\n    while not r.eof():\n        t=r.read_byte()\n        if t==0x00: break\n        sz=r.read_num(); buf=r.read(sz)\n        if t==0x11:\n            s=buf.decode('utf-16-le'); names=s.split('\\x00')[:num]\n    return {'num':num,'names':names}\n\ndef parse_header(r):\n    res={'pack_pos':0,'pack_sizes':[],'folders':[],'files':{'names':[]}}\n    while not r.eof():\n        id=r.read_byte()\n        if id==0x00: break\n        elif id==0x01: pass\n        elif id==0x02:\n            while True:\n                t=r.read_byte()\n                if t==0x00: break\n                sz=r.read_num(); r.read(sz)\n        elif id in (0x03,0x04):\n            p=parse_packed_streams(r)\n            res.update(p)\n        elif id==0x05:\n            res['files']=parse_files_info(r)\n        else:\n            raise Exception('unknown header id %02x'%id)\n    return res\n\ndef lzma2_dict(prop):\n    if prop<40: return (2|(prop&1))<<((prop>>1)+11)\n    return (3|(prop&3))<<((prop>>2)+8)\n\ndef decompress(props, data, method):\n    if method==0x00: return data\n    if method==0x030101:\n        prop=props[0]; ds=struct.unpack('<I',props[1:5])[0]\n        lc=prop%9; rem=prop//9; lp=rem%5; pb=rem//5\n        filt=[{'id':lzma.FILTER_LZMA1,'dict_size':ds,'lc':lc,'lp':lp,'pb':pb}]\n    elif method==0x21:\n        filt=[{'id':lzma.FILTER_LZMA2,'dict_size':lzma2_dict(props[0])}]\n    else: raise Exception('unsupported method %x'%method)\n    d=lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=filt)\n    return d.decompress(data)\n\ndata=open('/app/secrets.7z','rb').read()\nassert data[:6]==b'\\x37\\x7a\\xbc\\xaf\\x27\\x1c'\nnext_off=struct.unpack('<Q',data[12:20])[0]\nnext_size=struct.unpack('<Q',data[20:28])[0]\nnh=data[32+next_off:32+next_off+next_size]\nr=Reader(nh)\nprint('nh[0]=%02x nhsize=%d'%(r.peek_byte(),len(nh)))\nif r.peek_byte()==0x17:\n    r.read_byte()\n    eh=parse_packed_streams(r)\n    print('enc pack_pos=%d pack_sizes=%s'%(eh['pack_pos'],eh['pack_sizes']))\n    f=eh['folders']["]
