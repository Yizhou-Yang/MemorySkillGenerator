[290.77657, "i", "cat > /tmp/decode7z.py << 'PYEOF'\nimport struct, lzma, sys\n\nclass Reader:\n    def __init__(self, data): self.data=data; self.pos=0\n    def read_byte(self):\n        b=self.data[self.pos]; self.pos+=1; return b\n    def peek_byte(self): return self.data[self.pos]\n    def read(self,n):\n        d=self.data[self.pos:self.pos+n]; self.pos+=n; return d\n    def read_num(self):\n        b=self.read_byte(); val=b&0x7f; shift=7\n        while b&0x80:\n            b=self.read_byte(); val|=(b&0x7f)<<shift; shift+=7\n        return val\n    def eof(self): return self.pos>=len(self.data)\n\ndef parse_folder(r):\n    f={}; n=r.read_num(); cs=[]; tin=0; tout=0\n    for _ in range(n):\n        b=r.read_byte(); complex_c=b&1; has_attrs=(b&2)!=0\n        idsize=(b>>2)&0x0F; mid=0\n        for i in range(idsize): mid|=r.read_byte()<<(8*i)\n        c={'id':mid}\n        if complex_c: c['ni']=r.read_num(); c['no']=r.read_num()\n        else: c['ni']=1; c['no']=1\n        tin+=c['ni']; tout+=c['no']\n  "]
