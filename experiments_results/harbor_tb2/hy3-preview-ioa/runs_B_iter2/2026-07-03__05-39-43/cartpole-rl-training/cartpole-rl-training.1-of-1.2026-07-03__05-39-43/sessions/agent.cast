[77.176242, "o", "        idxs = np.random.randint(0, self.size, size=batch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.176284, "o", "        return (self.s[idxs], self.a[idxs], self.r[idxs], self.s2[idxs], self.d[idxs])\r\n\u001b[?2004l\r"]
[77.176358, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.17639, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.176502, "o", "def evaluate(agent, episodes=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.176608, "o", "    env = gym.make(\"CartPole-v1\")\r\n\u001b[?2004l\r"]
[77.176661, "o", "\u001b[?2004h>     total = 0.0\r\n\u001b[?2004l\r"]
[77.176708, "o", "\u001b[?2004h> "]
[77.176796, "o", "    for _ in range(episodes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.176859, "o", "        o, _ = env.reset()\r\n\u001b[?2004l\r"]
[77.17689, "o", "\u001b[?2004h> "]
[77.177034, "o", "        ep = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.177112, "o", "        while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.177187, "o", "            a = agent.select_action(o)\r\n\u001b[?2004l\r"]
[77.177279, "o", "\u001b[?2004h> "]
[77.17733, "o", "            o2, r, term, trunc, _ = env.step(a)\r\n\u001b[?2004l\r"]
[77.177347, "o", "\u001b[?2004h> "]
[77.177413, "o", "            ep += r\r\n\u001b[?2004l\r"]
[77.177465, "o", "\u001b[?2004h> "]
[77.177479, "o", "            o = o2\r\n\u001b[?2004l\r"]
[77.177487, "o", "\u001b[?2004h> "]
[77.17758, "o", "            if term or trunc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.177655, "o", "> "]
[77.177684, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.177778, "o", "        total += ep\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.177847, "o", "    env.close()\r\n\u001b[?2004l\r"]
[77.177905, "o", "\u001b[?2004h> "]
[77.177938, "o", "    return total / episodes\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.177948, "o", "\r\n\u001b[?2004l\r"]
[77.178509, "o", "\u001b[?2004h"]
[77.178757, "o", "> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     env = gym.make(\"CartPole-v1\")\r\n\u001b[?2004l\r\u001b[?2004h>     agent = Agent()\r\n\u001b[?2004l\r\u001b[?2004h>     target = Agent()\r\n\u001b[?2004l\r\u001b[?2004h>     target.policy_net.load_state_dict(agent.policy_net.state_dict())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.178789, "o", "    opt = optim.Adam(agent.policy_net.parameters(), lr=1e-3)\r\n\u001b[?2004l\r\u001b[?2004h>     buf = ReplayBuffer(20000, 4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.179003, "o", "    gamma = 0.99\r\n\u001b[?2004l\r\u001b[?2004h>     batch = 128\r\n\u001b[?2004l\r\u001b[?2004h>     eps = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.179106, "o", "    eps_end = 0.05\r\n\u001b[?2004l\r\u001b[?2004h>     best = -1.0\r\n\u001b[?2004l\r"]
[77.179344, "o", "\u001b[?2004h> "]
[77.179477, "o", "    save_dir = \"/app/trained_model\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for ep in range(800):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.179502, "o", "        o, _ = env.reset()\r\n\u001b[?2004l\r\u001b[?2004h>         ep_reward = 0.0\r\n\u001b[?2004l\r"]
[77.179579, "o", "\u001b[?2004h>         while True:"]
[77.1796, "o", "\r\n\u001b[?2004l\r"]
[77.179713, "o", "\u001b[?2004h> "]
[77.179804, "o", "            if np.random.rand() < eps:\r\n\u001b[?2004l\r"]
[77.179839, "o", "\u001b[?2004h> "]
[77.179931, "o", "                a = env.action_space.sample()\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.180153, "o", "> "]
[77.180535, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h>                 a = agent.select_action(o)\r\n\u001b[?2004l\r\u001b[?2004h>             o2, r, term, trunc, _ = env.step(a)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.180658, "o", "            done = float(term or trunc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.18068, "o", "            buf.add(o, a, r, o2, done)\r\n\u001b[?2004l\r"]
[77.180784, "o", "\u001b[?2004h>             o = o2\r\n\u001b[?2004l\r"]
[77.180863, "o", "\u001b[?2004h> "]
[77.181504, "o", "            ep_reward += r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.181532, "o", "            if buf.size > batch:\r\n\u001b[?2004l\r\u001b[?2004h>                 s_b, a_b, r_b, s2_b, d_b = buf.sample(batch)\r\n\u001b[?2004l\r\u001b[?2004h>                 s_b = torch.as_tensor(s_b)\r\n\u001b[?2004l\r\u001b[?2004h>                 a_b = torch.as_tensor(a_b).unsqueeze(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.181761, "o", "                r_b = torch.as_tensor(r_b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.181854, "o", "                s2_b = torch.as_tensor(s2_b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.182924, "o", "                d_b = torch.as_tensor(d_b)\r\n\u001b[?2004l\r\u001b[?2004h>                 q = agent.policy_net(s_b).gather(1, a_b).squeeze(1)\r\n\u001b[?2004l\r\u001b[?2004h>                 with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>                     q_next = target.policy_net(s2_b).max(1)[0]\r\n\u001b[?2004l\r\u001b[?2004h>                     tgt = r_b + gamma * q_next * (1 - d_b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.183819, "o", ">                 loss = nn.functional.mse_loss(q, tgt)\r\n\u001b[?2004l\r\u001b[?2004h>                 opt.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h>                 loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>                 opt.step()\r\n\u001b[?2004l\r"]
[77.183988, "o", "\u001b[?2004h>             if term or trunc:\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.184357, "o", "        eps = max(eps_end, eps * 0.995)\r\n\u001b[?2004l\r\u001b[?2004h>         if ep % 10 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.184762, "o", "            target.policy_net.load_state_dict(agent.policy_net.state_dict())\r\n\u001b[?2004l\r\u001b[?2004h>         if ep % 25 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.184792, "o", "            score = evaluate(agent, 20)\r\n\u001b[?2004l\r\u001b[?2004h>             print(f\"ep {ep} reward {ep_reward:.0f} eps {eps:.3f} eval {score:.1f}\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h>             if score > best:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.185095, "o", "                best = score\r\n\u001b[?2004l\r\u001b[?2004h>                 agent.save(save_dir)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.185156, "o", "                print(f\"  -> saved best {best:.1f}\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.185242, "o", "    print(\"best eval:\", best)\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.185444, "o", "> \r\n\u001b[?2004l\r"]
[77.185486, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.185607, "o", "> "]
[77.186033, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.186066, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
