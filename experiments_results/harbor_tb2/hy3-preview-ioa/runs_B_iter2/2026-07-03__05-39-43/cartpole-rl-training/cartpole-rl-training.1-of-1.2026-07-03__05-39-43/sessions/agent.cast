[77.172071, "i", "cat > /app/train.py << 'EOF'\nimport os\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport gymnasium as gym\nfrom agent import Agent\n\n\nclass ReplayBuffer:\n    def __init__(self, cap, state_dim):\n        self.cap = cap\n        self.s = np.zeros((cap, state_dim), dtype=np.float32)\n        self.a = np.zeros((cap,), dtype=np.int64)\n        self.r = np.zeros((cap,), dtype=np.float32)\n        self.s2 = np.zeros((cap, state_dim), dtype=np.float32)\n        self.d = np.zeros((cap,), dtype=np.float32)\n        self.idx = 0\n        self.size = 0\n\n    def add(self, s, a, r, s2, d):\n        self.s[self.idx] = s\n        self.a[self.idx] = a\n        self.r[self.idx] = r\n        self.s2[self.idx] = s2\n        self.d[self.idx] = d\n        self.idx = (self.idx + 1) % self.cap\n        self.size = min(self.size + 1, self.cap)\n\n    def sample(self, batch):\n        idxs = np.random.randint(0, self.size, size=batch)\n        return (self.s[idxs], self.a[idxs], self.r[idxs], self.s2[idxs], self.d[id"]
[77.172248, "i", "xs])\n\n\ndef evaluate(agent, episodes=20):\n    env = gym.make(\"CartPole-v1\")\n    total = 0.0\n    for _ in range(episodes):\n        o, _ = env.reset()\n        ep = 0.0\n        while True:\n            a = agent.select_action(o)\n            o2, r, term, trunc, _ = env.step(a)\n            ep += r\n            o = o2\n            if term or trunc:\n                break\n        total += ep\n    env.close()\n    return total / episodes\n\n\ndef main():\n    env = gym.make(\"CartPole-v1\")\n    agent = Agent()\n    target = Agent()\n    target.policy_net.load_state_dict(agent.policy_net.state_dict())\n    opt = optim.Adam(agent.policy_net.parameters(), lr=1e-3)\n    buf = ReplayBuffer(20000, 4)\n    gamma = 0.99\n    batch = 128\n    eps = 1.0\n    eps_end = 0.05\n    best = -1.0\n    save_dir = \"/app/trained_model\"\n\n    for ep in range(800):\n        o, _ = env.reset()\n        ep_reward = 0.0\n        while True:\n            if np.random.rand() < eps:\n                a = env.action_space.sample()\n            else:\n                a = agent."]
[77.172283, "o", "cat > /app/train.py << 'EOF'\r\n\u001b[?2004l\r"]
[77.172289, "i", "select_action(o)\n            o2, r, term, trunc, _ = env.step(a)\n            done = float(term or trunc)\n            buf.add(o, a, r, o2, done)\n            o = o2\n            ep_reward += r\n            if buf.size > batch:\n                s_b, a_b, r_b, s2_b, d_b = buf.sample(batch)\n                s_b = torch.as_tensor(s_b)\n                a_b = torch.as_tensor(a_b).unsqueeze(1)\n                r_b = torch.as_tensor(r_b)\n                s2_b = torch.as_tensor(s2_b)\n                d_b = torch.as_tensor(d_b)\n                q = agent.policy_net(s_b).gather(1, a_b).squeeze(1)\n                with torch.no_grad():\n                    q_next = target.policy_net(s2_b).max(1)[0]\n                    tgt = r_b + gamma * q_next * (1 - d_b)\n                loss = nn.functional.mse_loss(q, tgt)\n                opt.zero_grad()\n                loss.backward()\n                opt.step()\n            if term or trunc:\n                break\n        eps = max(eps_end, eps * 0.995)\n        if ep % 10 == 0:\n            target.p"]
[77.172431, "o", "xs])\r\n\r\n\r\ndef evaluate(agent, episodes=20):\r\n    env = gym.make(\"CartPole-v1\")\r\n    total = 0.0\r\n    for _ in range(episodes):\r\n        o, _ = env.reset()\r\n        ep = 0.0\r\n        while True:\r\n            a = agent.select_action(o)\r\n            o2, r, term, trunc, _ = env.step(a)\r\n            ep += r\r\n            o = o2\r\n            if term or trunc:\r\n                break\r\n        total += ep\r\n    env.close()\r\n    return total / episodes\r\n\r\n\r\ndef main():\r\n    env = gym.make(\"CartPole-v1\")\r\n    agent = Agent()\r\n    target = Agent()\r\n    target.policy_net.load_state_dict(agent.policy_net.state_dict())\r\n    opt = optim.Adam(agent.policy_net.parameters(), lr=1e-3)\r\n    buf = ReplayBuffer(20000, 4)\r\n    gamma = 0.99\r\n    batch = 128\r\n    eps = 1.0\r\n    eps_end = 0.05\r\n    best = -1.0\r\n    save_dir = \"/app/trained_model\"\r\n\r\n    for ep in range(800):\r\n        o, _ = env.reset()\r\n        ep_reward = 0.0\r\n        while True:\r\n            if np.random.rand() < eps:\r\n                a = env.action_space.sample()\r\n   "]
