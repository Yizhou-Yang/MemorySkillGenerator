[614.554935, "o", "#include <math.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include \"cJSON.h\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.554967, "o", "> "]
[614.555064, "o", "#include \"lodepng.h\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.55509, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.555197, "o", "/* Model dims: 784 -> 16 -> 16 -> 10, ReLU */\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.555215, "o", "> "]
[614.555386, "o", "#define IN 784\r\n\u001b[?2004l\r\u001b[?2004h> #define HID 16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.55541, "o", "#define OUT 10\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.555427, "o", "> \r\n\u001b[?2004l\r"]
[614.555649, "o", "\u001b[?2004h> static double W0[HID*IN], b0[HID];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.5558, "o", "static double W1[HID*HID], b1[HID];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.557239, "o", "static double W2[OUT*HID], b2[OUT];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static char *read_file(const char *path){\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *f = fopen(path,\"rb\");\r\n\u001b[?2004l\r\u001b[?2004h>     if(!f){ fprintf(stderr,\"cannot open %s\\n\", path); return NULL; }\r\n\u001b[?2004l\r\u001b[?2004h>     fseek(f,0,SEEK_END); long n = ftell(f); fseek(f,0,SEEK_SET);\r\n\u001b[?2004l\r\u001b[?2004h>     char *buf = (char*)malloc(n+1);\r\n\u001b[?2004l\r\u001b[?2004h>     if(fread(buf,1,n,f)!=(size_t)n){ fprintf(stderr,\"read error\\n\"); free(buf); fclose(f); return NULL; }\r\n\u001b[?2004l\r\u001b[?2004h>     buf[n]=0; fclose(f); return buf;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.557266, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.557314, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.557913, "o", "static int fill_matrix(cJSON *arr, double *out, int rows, int cols){\r\n\u001b[?2004l\r\u001b[?2004h>     if(!cJSON_IsArray(arr) || cJSON_GetArraySize(arr)!=rows) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i=0;i<rows;i++){\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.558065, "o", "        cJSON *row = cJSON_GetArrayItem(arr,i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.558365, "o", "        if(!cJSON_IsArray(row) || cJSON_GetArraySize(row)!=cols) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>         cJSON *el = row->child;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.55842, "o", "        for(int j=0;j<cols;j++){\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.558452, "o", "> "]
[614.558634, "o", "            if(!el) return -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.558738, "o", "            out[i*cols+j] = el->valuedouble;\r\n\u001b[?2004l\r\u001b[?2004h>             el = el->next;\r\n\u001b[?2004l\r"]
[614.558764, "o", "\u001b[?2004h> "]
[614.558847, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[614.558898, "o", "\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.558916, "o", "}\r\n\u001b[?2004l\r"]
[614.558927, "o", "\u001b[?2004h"]
[614.558934, "o", "> \r\n\u001b[?2004l\r"]
[614.559002, "o", "\u001b[?2004h> "]
[614.55912, "o", "static int fill_vec(cJSON *arr, double *out, int n){\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.559329, "o", "    if(!cJSON_IsArray(arr) || cJSON_GetArraySize(arr)!=n) return -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.559527, "o", "    for(int i=0;i<n;i++) out[i]=cJSON_GetArrayItem(arr,i)->valuedouble;\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.559543, "o", "> "]
[614.559594, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.559626, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.559641, "o", "> \r\n\u001b[?2004l\r"]
[614.559653, "o", "\u001b[?2004h"]
[614.55969, "o", "> "]
[614.559774, "o", "int main(int argc, char **argv){\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.560064, "o", "    if(argc < 3){ fprintf(stderr,\"usage: %s weights.json image.png\\n\", argv[0]); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.560198, "o", "    const char *wpath = argv[1];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.560492, "o", "    const char *ipath = argv[2];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[614.560694, "o", "\u001b[?2004h> "]
[614.560828, "o", "    char *j = read_file(wpath);\r\n\u001b[?2004l\r"]
[614.560953, "o", "\u001b[?2004h> "]
[614.560981, "o", "    if(!j) return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.561099, "o", "    cJSON *root = cJSON_Parse(j);\r\n\u001b[?2004l\r\u001b[?2004h>     free(j);\r\n"]
[614.561223, "o", "\u001b[?2004l\r"]
[614.561255, "o", "\u001b[?2004h> "]
[614.561409, "o", "    if(!root){ fprintf(stderr,\"JSON parse error\\n\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[614.561518, "o", "\u001b[?2004h> "]
[614.561656, "o", "    if(fill_matrix(cJSON_GetObjectItem(root,\"input_layer.weight\"), W0, HID, IN) ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.561855, "o", "       fill_vec(cJSON_GetObjectItem(root,\"input_layer.bias\"), b0, HID) ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.56207, "o", "       fill_matrix(cJSON_GetObjectItem(root,\"hidden_layer.weight\"), W1, HID, HID) ||\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.562099, "o", "> "]
[614.5623, "o", "       fill_vec(cJSON_GetObjectItem(root,\"hidden_layer.bias\"), b1, HID) ||\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.562325, "o", "> "]
[614.562617, "o", "       fill_matrix(cJSON_GetObjectItem(root,\"output_layer.weight\"), W2, OUT, HID) ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.562757, "o", "       fill_vec(cJSON_GetObjectItem(root,\"output_layer.bias\"), b2, OUT)){\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.562783, "o", "> "]
[614.56299, "o", "        fprintf(stderr,\"weight shape error\\n\"); cJSON_Delete(root); return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.56301, "o", "    }\r\n\u001b[?2004l\r"]
[614.563022, "o", "\u001b[?2004h> "]
[614.563215, "o", "    cJSON_Delete(root);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.563334, "o", "    unsigned char *pixels = NULL; unsigned w,h;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.563514, "o", "    unsigned err = lodepng_decode32_file(&pixels, &w, &h, ipath);\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.563536, "o", "> "]
[614.563962, "o", "    if(err){ fprintf(stderr,\"png error %u: %s\\n\", err, lodepng_error_text(err)); return 1; }\r\n"]
[614.563985, "o", "\u001b[?2004l\r\u001b[?2004h"]
[614.564003, "o", "> "]
[614.564515, "o", "    if(w*h != IN){ fprintf(stderr,\"image must be 28x28, got %ux%u\\n\", w, h); free(pixels); return 1; }\r\n\u001b[?2004l\r"]
[614.564542, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.564687, "o", "    double input[IN];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.564786, "o", "    for(unsigned y=0;y<h;y++){\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.564837, "o", "        for(unsigned x=0;x<w;x++){\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.565004, "o", "            unsigned char v = pixels[4*(y*w+x)]; /* R (grayscale) */\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.565073, "o", "> "]
[614.565189, "o", "            double nrm = ((double)v/255.0 - 0.1307)/0.3081;\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.56532, "o", "> "]
[614.565476, "o", "            input[y*w+x] = nrm;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     free(pixels);\r\n\u001b[?2004l\r"]
[614.565519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[614.565533, "o", "> "]
[614.565633, "o", "    double h1[HID], h2[HID], out[OUT];\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.565709, "o", "> "]
[614.565918, "o", "    for(int i=0;i<HID;i++){ double s=b0[i]; for(int j=0;j<IN;j++) s+=W0[i*IN+j]*input[j]; h1[i]= s>0?s:0; }\r\n\u001b[?2004l\r"]
[614.565993, "o", "\u001b[?2004h> "]
[614.566217, "o", "    for(int i=0;i<HID;i++){ double s=b1[i]; for(int j=0;j<HID;j++) s+=W1[i*HID+j]*h1[j]; h2[i]= s>0?s:0; }\r\n\u001b[?2004l\r"]
[614.566273, "o", "\u001b[?2004h> "]
[614.566499, "o", "    for(int i=0;i<OUT;i++){ double s=b2[i]; for(int j=0;j<HID;j++) s+=W2[i*HID+j]*h2[j]; out[i]=s; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.566517, "o", "> \r\n\u001b[?2004l\r"]
[614.566605, "o", "\u001b[?2004h> "]
[614.566717, "o", "    int best=0; for(int i=1;i<OUT;i++) if(out[i]>out[best]) best=i;\r\n\u001b[?2004l\r"]
[614.566735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[614.566818, "o", "\u001b[?2004h> "]
[614.566881, "o", "    FILE *pf = fopen(\"prediction.txt\",\"w\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[614.566916, "o", "> "]
[614.567039, "o", "    if(pf){ fprintf(pf,\"%d\\n\", best); fclose(pf); }"]
[614.567115, "o", "\r\n\u001b[?2004l\r"]
[614.56724, "o", "\u001b[?2004h> "]
[614.567413, "o", "    printf(\"%d\\n\", best);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.567522, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[614.567588, "o", "EOF\r\n\u001b[?2004l\r"]
