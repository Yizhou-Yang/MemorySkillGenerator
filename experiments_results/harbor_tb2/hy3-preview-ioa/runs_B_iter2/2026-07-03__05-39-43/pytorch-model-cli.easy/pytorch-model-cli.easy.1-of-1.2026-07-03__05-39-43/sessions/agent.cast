[248.606958, "i", "cat > /app/ref.py <<'PYEOF'\nimport zlib, struct, json, math\n\ndef read_png(path):\n    d = open(path,'rb').read()\n    assert d[:8] == b'\\x89PNG\\r\\n\\x1a\\n'\n    pos = 8; w=h=bd=ct=None; idat=b''\n    while pos < len(d):\n        ln = struct.unpack('>I', d[pos:pos+4])[0]; typ = d[pos+4:pos+8]; data = d[pos+8:pos+8+ln]\n        if typ == b'IHDR':\n            w,h,bd,ct = struct.unpack('>IIBB', data[:10])\n        elif typ == b'IDAT':\n            idat += data\n        elif typ == b'IEND':\n            break\n        pos += 12+ln\n    raw = zlib.decompress(idat)\n    channels = {0:1,2:3,3:1,4:2,6:4}[ct]\n    bpp = channels*1\n    stride = w*channels\n    out = bytearray()\n    prev = bytearray(stride)\n    i = 0\n    for y in range(h):\n        f = raw[i]; i+=1\n        line = bytearray(raw[i:i+stride]); i+=stride\n        for x in range(stride):\n            a = line[x-bpp] if x>=bpp else 0\n            b = prev[x]\n            c = prev[x-bpp] if x>=bpp else 0\n            if f==0: v=line[x]\n            elif f==1: v=line[x]+a\n            "]
[248.607008, "i", "elif f==2: v=line[x]+b\n            elif f==3: v=line[x]+(a+b)//2\n            elif f==4:\n                p=a+b-c\n                pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\n                v=line[x]+(a if (pa<=pb and pa<=pc) else (b if pb<=pc else c))\n            else: raise ValueError('filter')\n            line[x]=v & 0xff\n        out += line\n        prev = line\n    return w,h,channels,out\n\ndef to_gray(w,h,ch,raw):\n    g=[]\n    for y in range(h):\n        row=[]\n        for x in range(w):\n            base=(y*w+x)*ch\n            if ch==1: v=raw[base]\n            elif ch==3: v=(raw[base]+raw[base+1]+raw[base+2])//3\n            elif ch==4: v=(raw[base]+raw[base+1]+raw[base+2])//3\n            else: v=raw[base]\n            row.append(v)\n        g.append(row)\n    return g\n\nw,h,ch,raw = read_png('/app/image.png')\nprint('wh',w,h,'ch',ch)\ng = to_gray(w,h,ch,raw)\n# print downsample preview\nmn=min(min(r) for r in g); mx=max(max(r) for r in g)\nprint('min',mn,'max',mx)\nfor r in g[::4]:\n    print(''.join('#' if v>128 else ('.' if"]
[248.607025, "i", " v>32 else ' ') for v in r[::4]))\n\nW=json.load(open('/app/weights.json'))\ndef mat(name): return W[name]\ndef vec(name): return W[name]\ndef lin(Wm,b,x):\n    return [sum(Wm[i][j]*x[j] for j in range(len(x)))+b[i] for i in range(len(b))]\ndef relu(x): return [v if v>0 else 0.0 for v in x]\n\ndef forward(pixels):\n    h1=relu(lin(mat('input_layer.weight'),vec('input_layer.bias'),pixels))\n    h2=relu(lin(mat('hidden_layer.weight'),vec('hidden_layer.bias'),h1))\n    out=lin(mat('output_layer.weight'),vec('output_layer.bias'),h2)\n    return out\n\nflat=[g[y][x] for y in range(h) for x in range(w)]\nfor name,fn in [('x/255', lambda v:v/255.0),('std', lambda v:(v/255.0-0.1307)/0.3081)]:\n    x=[fn(v) for v in flat]\n    out=forward(x)\n    am=max(range(10),key=lambda i:out[i])\n    print(name,'argmax',am,'logits',[round(o,3) for o in out])\nPYEOF\npython3 /app/ref.py\n"]
[248.607177, "o", "cat > /app/ref.py <<'PYEOF'\r\n\u001b[?2004l\r"]
