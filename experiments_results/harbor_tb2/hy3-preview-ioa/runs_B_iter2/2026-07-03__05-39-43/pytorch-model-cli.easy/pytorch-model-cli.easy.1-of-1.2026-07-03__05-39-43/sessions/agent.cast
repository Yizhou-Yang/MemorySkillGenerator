[100.858242, "o", "\u001b[?2004hroot@114e8bf2da3f:/app# "]
[181.561216, "i", "cat > /app/convert.py <<'PYEOF'\nimport zipfile, struct, pickle, io, json\n\nclass U(pickle.Unpickler):\n    def __init__(self, file, z):\n        super().__init__(file)\n        self.z = z\n    def persistent_load(self, pid):\n        _, cls, key, loc, numel = pid\n        raw = self.z.read('simple_mnist/data/%s' % key)\n        assert len(raw) == numel*4, (key, len(raw), numel)\n        return list(struct.unpack('<%df' % numel, raw))\n    def find_class(self, module, name):\n        if module == 'torch._utils' and name == '_rebuild_tensor_v2':\n            def rebuild(storage, offset, size, stride, requires_grad, hooks):\n                return {'size': list(size), 'data': storage}\n            return rebuild\n        if module == 'torch' and name == 'FloatStorage':\n            return object\n        if module == 'collections' and name == 'OrderedDict':\n            return dict\n        raise pickle.UnpicklingError('cannot load %s.%s' % (module, name))\n\ndef reshape(flat, shape):\n    if len(shape) == 1:\n        return flat[:sha"]
[181.561575, "i", "pe[0]]\n    step = 1\n    for d in shape[1:]:\n        step *= d\n    return [reshape(flat[i*step:(i+1)*step], shape[1:]) for i in range(shape[0])]\n\nz = zipfile.ZipFile('/app/model.pth')\nraw = z.read('simple_mnist/data.pkl')\nsd = U(io.BytesIO(raw), z).load()\nout = {}\nfor name, t in sd.items():\n    out[name] = reshape(t['data'], t['size'])\nwith open('/app/weights.json', 'w') as f:\n    json.dump(out, f)\nfor k, v in out.items():\n    def sh(x):\n        if isinstance(x, list):\n            return [len(x)] + sh(x[0]) if x else [0]\n        return []\n    print(k, sh(v))\nprint('written weights.json', len(json.dumps(out)))\nPYEOF\npython3 /app/convert.py\n"]
[181.561845, "o", "cat > /app/convert.py <<'PYEOF'"]
[181.56218, "o", "\r\n"]
[181.562382, "o", "\u001b[?2004l\r"]
[181.562614, "o", "\u001b[?2004h"]
[181.562799, "o", "> "]
