[614.554299, "i", "cat > /app/cli_tool.c <<'EOF'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include \"cJSON.h\"\n#include \"lodepng.h\"\n\n/* Model dims: 784 -> 16 -> 16 -> 10, ReLU */\n#define IN 784\n#define HID 16\n#define OUT 10\n\nstatic double W0[HID*IN], b0[HID];\nstatic double W1[HID*HID], b1[HID];\nstatic double W2[OUT*HID], b2[OUT];\n\nstatic char *read_file(const char *path){\n    FILE *f = fopen(path,\"rb\");\n    if(!f){ fprintf(stderr,\"cannot open %s\\n\", path); return NULL; }\n    fseek(f,0,SEEK_END); long n = ftell(f); fseek(f,0,SEEK_SET);\n    char *buf = (char*)malloc(n+1);\n    if(fread(buf,1,n,f)!=(size_t)n){ fprintf(stderr,\"read error\\n\"); free(buf); fclose(f); return NULL; }\n    buf[n]=0; fclose(f); return buf;\n}\n\nstatic int fill_matrix(cJSON *arr, double *out, int rows, int cols){\n    if(!cJSON_IsArray(arr) || cJSON_GetArraySize(arr)!=rows) return -1;\n    for(int i=0;i<rows;i++){\n        cJSON *row = cJSON_GetArrayItem(arr,i);\n        if(!cJSON_IsArray(row) || cJSON_GetArraySize(row)!=cols) ret"]
[614.554369, "i", "urn -1;\n        cJSON *el = row->child;\n        for(int j=0;j<cols;j++){\n            if(!el) return -1;\n            out[i*cols+j] = el->valuedouble;\n            el = el->next;\n        }\n    }\n    return 0;\n}\n\nstatic int fill_vec(cJSON *arr, double *out, int n){\n    if(!cJSON_IsArray(arr) || cJSON_GetArraySize(arr)!=n) return -1;\n    for(int i=0;i<n;i++) out[i]=cJSON_GetArrayItem(arr,i)->valuedouble;\n    return 0;\n}\n\nint main(int argc, char **argv){\n    if(argc < 3){ fprintf(stderr,\"usage: %s weights.json image.png\\n\", argv[0]); return 1; }\n    const char *wpath = argv[1];\n    const char *ipath = argv[2];\n\n    char *j = read_file(wpath);\n    if(!j) return 1;\n    cJSON *root = cJSON_Parse(j);\n    free(j);\n    if(!root){ fprintf(stderr,\"JSON parse error\\n\"); return 1; }\n\n    if(fill_matrix(cJSON_GetObjectItem(root,\"input_layer.weight\"), W0, HID, IN) ||\n       fill_vec(cJSON_GetObjectItem(root,\"input_layer.bias\"), b0, HID) ||\n       fill_matrix(cJSON_GetObjectItem(root,\"hidden_layer.weight\"), W1, HID, HID) ||\n   "]
[614.554425, "i", "    fill_vec(cJSON_GetObjectItem(root,\"hidden_layer.bias\"), b1, HID) ||\n       fill_matrix(cJSON_GetObjectItem(root,\"output_layer.weight\"), W2, OUT, HID) ||\n       fill_vec(cJSON_GetObjectItem(root,\"output_layer.bias\"), b2, OUT)){\n        fprintf(stderr,\"weight shape error\\n\"); cJSON_Delete(root); return 1;\n    }\n    cJSON_Delete(root);\n\n    unsigned char *pixels = NULL; unsigned w,h;\n    unsigned err = lodepng_decode32_file(&pixels, &w, &h, ipath);\n    if(err){ fprintf(stderr,\"png error %u: %s\\n\", err, lodepng_error_text(err)); return 1; }\n    if(w*h != IN){ fprintf(stderr,\"image must be 28x28, got %ux%u\\n\", w, h); free(pixels); return 1; }\n\n    double input[IN];\n    for(unsigned y=0;y<h;y++){\n        for(unsigned x=0;x<w;x++){\n            unsigned char v = pixels[4*(y*w+x)]; /* R (grayscale) */\n            double nrm = ((double)v/255.0 - 0.1307)/0.3081;\n            input[y*w+x] = nrm;\n        }\n    }\n    free(pixels);\n\n    double h1[HID], h2[HID], out[OUT];\n    for(int i=0;i<HID;i++){ double s=b0[i]; for(in"]
[614.554578, "i", "t j=0;j<IN;j++) s+=W0[i*IN+j]*input[j]; h1[i]= s>0?s:0; }\n    for(int i=0;i<HID;i++){ double s=b1[i]; for(int j=0;j<HID;j++) s+=W1[i*HID+j]*h1[j]; h2[i]= s>0?s:0; }\n    for(int i=0;i<OUT;i++){ double s=b2[i]; for(int j=0;j<HID;j++) s+=W2[i*HID+j]*h2[j]; out[i]=s; }\n\n    int best=0; for(int i=1;i<OUT;i++) if(out[i]>out[best]) best=i;\n\n    FILE *pf = fopen(\"prediction.txt\",\"w\");\n    if(pf){ fprintf(pf,\"%d\\n\", best); fclose(pf); }\n    printf(\"%d\\n\", best);\n    return 0;\n}\nEOF\necho wrote cli_tool.c\n"]
