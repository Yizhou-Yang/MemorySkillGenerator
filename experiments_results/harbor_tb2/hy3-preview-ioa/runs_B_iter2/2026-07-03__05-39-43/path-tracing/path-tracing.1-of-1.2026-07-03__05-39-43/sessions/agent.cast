[255.839277, "i", ".venv/bin/python - << 'EOF'\ndata=open('orig','rb').read()\nimport struct\ndoubles=[]\nfor i in range(0,len(data)-7,1):\n    try:\n        d=struct.unpack('<d',data[i:i+8])[0]\n    except: continue\n    if d==d and abs(d)<1e7 and ('%.6f'%d)!='-0.000000':\n        doubles.append((i,d))\n# print plausible scene constants: small-ish numbers\nfor off,d in doubles:\n    s='%.4f'%d\n    if -0.001<d<100 and ('0.' in s or d>=1):\n        print(off, s)\nEOF\n"]
