[567.381292, "i", "cat > /tmp/extract3.py << 'PYEOF'\nimport re, struct\ntxt=open('/tmp/dis.txt').read().splitlines()\nfuncs={}\nfor l in txt:\n    m=re.match(r'^([0-9a-f]+)\\s+<([A-Za-z_][\\w.]*)>:$', l)\n    if m: funcs[int(m.group(1),16)]=m.group(2)\norder=sorted(funcs)\ndef fname(a):\n    f=None\n    for fa in order:\n        if fa<=a: f=funcs[fa]\n    return f\nbinf=open('/app/orig','rb').read()\nres={}\nfor l in txt:\n    mi=re.match(r'^\\s*([0-9a-f]+):\\s', l)\n    if not mi: continue\n    a=int(mi.group(1),16)\n    if 'movss' in l: kind='f32'\n    elif any(k in l for k in ('movsd','movups','movaps','movupd','movapd')): kind='f64'\n    else: continue\n    m=re.search(r'#\\s*([0-9a-f]+)\\b', l)\n    if not m: continue\n    tgt=int(m.group(1),16)\n    try:\n        d=struct.unpack('<f', binf[tgt:tgt+4])[0] if kind=='f32' else struct.unpack('<d', binf[tgt:tgt+8])[0]\n    except: continue\n    res.setdefault(fname(a),[]).append((tgt,round(d,6),kind))\nfor fn in sorted(res):\n    print('=== %s ==='%fn)\n    seen=set()\n    for t,d,k in res[fn]:\n        if (t,d) not in seen:\n            seen.add((t,d)); print('  +%d  %r  %s'%(t-0x3000,d,k))\nPYEOF\n.venv/bin/python /tmp/extract3.py\n"]
