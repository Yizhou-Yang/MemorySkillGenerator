[49.127549, "i", ".venv/bin/python - << 'EOF'\nimport numpy as np\nfrom PIL import Image\nimg=np.array(Image.open('image.ppm')).astype(float)\nH,W,_=img.shape\nprint('corners')\nfor j in [0,H//2,H-1]:\n  for i in [0,W//2,W-1]:\n    print(j,i,img[j,i])\n# row means\nrm=img.mean(axis=1)\ncm=img.mean(axis=0)\nprint('row0',rm[0],'rowmid',rm[H//2],'rowlast',rm[-1])\nprint('col0',cm[0],'colmid',cm[W//2],'collast',cm[-1])\nEOF\n"]
