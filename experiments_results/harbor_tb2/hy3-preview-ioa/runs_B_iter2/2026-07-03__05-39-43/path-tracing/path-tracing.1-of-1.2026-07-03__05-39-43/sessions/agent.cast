[298.954489, "o", "\u001b[?2004hroot@03270641b450:/app# "]
[347.194909, "i", "cd /app && .venv/bin/python - << 'EOF'\nimport re,struct\ntxt=open('/tmp/dis.txt').read().splitlines()\n# parse instructions: lines like '  401234:  f2 0f ...  mnemonic ...'\ninst=[]\nfor ln in txt:\n    m=re.match(r'^\\s*([0-9a-f]+):\\s*(([0-9a-f]{2}\\s){1,15})?(.*)$',ln)\n    if not m: continue\n    addr=int(m.group(1),16)\n    bytestr=m.group(2) or ''\n    nbytes=len(bytestr.split())\n    rest=m.group(4)\n    inst.append((addr,nbytes,rest))\n# build map addr-> (nbytes,rest)\nbyaddr={a:(n,r) for a,n,r in inst}\n# find function names\nfuncmap={} # addr->name\nfor a,n,r in inst:\n    mm=re.match(r'<([\\w.]+)>:',r)\n    if mm: funcmap[a]=mm.group(1)\n# for each inst, find enclosing function (nearest preceding label)\nconsts={}\nfor a,n,r in inst:\n    fm=re.search(r'\\[rip\\+0x([0-9a-f]+)\\]',r)\n    if not fm: continue\n    if 'movsd' not in r and 'movss' not in r: continue\n    disp=int(fm.group(1),16)\n    if disp>=0x80000000: disp-=(1<<32)\n    tgt=a+n+disp\n    if 0x3000<=tgt<0x32c0:\n        # find function\n        fname=None\n        for fa in sorted(funcmap):\n            if fa<=a: fname=funcmap[fa]\n        consts.setdefault(tgt,set()).add(fname)\n# decode\nrodata=open('orig','rb').read()[0x3000:0x32c0]\nfor tgt in sorted(consts):\n    off=tgt-0x3000\n    d=struct.unpack('<d',rodata[off:off+8])[0]\n    if abs(d)<1e6 or d!=d:\n        print('rodata+%d = %.10g  used by %s'%(off,d,sorted(consts[tgt])))\nEOF\n"]
