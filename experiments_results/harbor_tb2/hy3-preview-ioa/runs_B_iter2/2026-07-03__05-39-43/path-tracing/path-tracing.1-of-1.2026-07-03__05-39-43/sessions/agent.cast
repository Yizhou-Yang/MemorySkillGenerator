[151.169518, "i", ".venv/bin/python - << 'EOF'\nimport numpy as np\nfrom PIL import Image\nimg=np.array(Image.open('image.ppm')).astype(float)\nH,W,_=img.shape\nlum=img.mean(axis=2)\nchars=' .:-=+*#%@'\nsh,sw=45,120\nfor j in range(sh):\n    line=''\n    for i in range(sw):\n        y0=int(j*H/sh); y1=int((j+1)*H/sh)\n        x0=int(i*W/sw); x1=int((i+1)*W/sw)\n        block=lum[y0:y1,x0:x1]\n        v=block.mean() if block.size else 0\n        line+=chars[min(len(chars)-1,int(v/255*(len(chars))))]\n    print(line)\nEOF\n"]
