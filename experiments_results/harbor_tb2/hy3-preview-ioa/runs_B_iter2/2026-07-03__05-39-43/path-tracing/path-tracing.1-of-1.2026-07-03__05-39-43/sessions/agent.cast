[207.08844, "i", ".venv/bin/python - << 'EOF'\nimport numpy as np\nfrom PIL import Image\nimg=np.array(Image.open('image.ppm')).astype(float)\nH,W,_=img.shape\n# low-rank\nflat=img.reshape(H*W,3)\nu,s,vt=np.linalg.svd(flat,full_matrices=False)\nprint('sing vals',s)\nprint('rank1 recon err (RMSE)', np.sqrt(((flat-flat.mean(0)-u[:,:1]*s[0]@vt[:1])**2).mean()))\n# grid for red sphere\nred=(img[:,:,0]-img[:,:,1])\nprint('max redness', red.max(), 'at', np.unravel_index(red.argmax(),red.shape))\n# print grid of redness\nfor y in range(0,H,40):\n    print(''.join('#' if red[y,x]>15 else '.' for x in range(0,W,20)))\nEOF\n"]
