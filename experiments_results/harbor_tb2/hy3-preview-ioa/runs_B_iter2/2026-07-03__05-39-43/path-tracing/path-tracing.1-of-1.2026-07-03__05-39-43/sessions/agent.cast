[550.461764, "i", "cat > /tmp/extract2.py << 'PYEOF'\nimport re, struct\ntxt=open('/tmp/dis.txt').read().splitlines()\nfuncs={}\ninst_addr=[]\nfor l in txt:\n    m=re.match(r'^([0-9a-f]+)\\s+<([A-Za-z_][\\w.]*)>:$', l)\n    if m:\n        funcs[int(m.group(1),16)]=m.group(2); continue\n    mi=re.match(r'^\\s*([0-9a-f]+):\\s', l)\n    if mi:\n        inst_addr.append(int(mi.group(1),16))\norder=sorted(funcs)\ndef fname(a):\n    f=None\n    for fa in order:\n        if fa<=a: f=funcs[fa]\n    return f\nbinf=open('/app/orig','rb').read()\nres={}\nfor l in txt:\n    mi=re.match(r'^\\s*([0-9a-f]+):\\s', l)\n    if not mi: continue\n    a=int(mi.group(1),16)\n    m=re.search(r'movss.*\\[rip\\+0x[0-9a-f]+\\].*#\\s*([0-9a-f]+)', l)\n    if m:\n        tgt=int(m.group(1),16); kind='f32'\n    else:\n        m=re.search(r'movs[dsd]|movup[sd]|movap[sd].*\\[rip\\+0x[0-9a-f]+\\].*#\\s*([0-9a-f]+)', l)\n        if not m: \n            m=re.search(r'\\[rip\\+0x[0-9a-f]+\\].*#\\s*([0-9a-f]+)', l)\n            if not m: continue\n            kind='f64'\n        else:\n            kind='f64'\n        tgt=int(m.group(1),16)\n    try:\n        if kind=='f32':\n            d=struct.unpack('<f', binf[tgt:tgt+4])[0]\n        else:\n            d=struct.unpack('<d', binf[tgt:tgt+8])[0]\n    except: continue\n    res.setdefault(fname(a),[]).append((hex(tgt),round(d,6),kind))\nfor fn in sorted(res):\n    print('=== %s ==='%fn)\n    seen=set();\n    for t,d,k in res[fn]:\n        if (t,d) not in seen:\n            seen.add((t,d)); print('  ',t,d,k)\nPYEOF\n.venv/bin/python /tmp/extract2.py\n"]
