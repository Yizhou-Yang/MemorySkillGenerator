[493.525846, "i", "cat > /tmp/fns.py << 'PYEOF'\nimport re\ntxt=open('/tmp/dis.txt').read().splitlines()\n# find function header lines\nidx=[]\nfor i,l in enumerate(txt):\n    m=re.match(r'^([0-9a-f]+)\\s+<([A-Za-z_][\\w.]*)>:$', l)\n    if m: idx.append((int(m.group(1),16), m.group(2), i))\nfor k in range(len(idx)):\n    start=idx[k][2]\n    end=idx[k+1][2] if k+1<len(idx) else len(txt)\n    if idx[k][1] in ('sky_color','sphere_intersect','plane_intersect','trace','main','write_image'):\n        print('==== '+idx[k][1]+' ====')\n        for l in txt[start:end]:\n            print(l)\nPYEOF\n.venv/bin/python /tmp/fns.py > /tmp/fns.txt 2>&1; wc -l /tmp/fns.txt\n"]
