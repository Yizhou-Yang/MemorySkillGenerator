[397.862692, "i", "cat > /tmp/extract.py << 'PYEOF'\nimport re, struct\ntxt=open('/tmp/dis.txt').read().splitlines()\ninst=[]\nfuncmap={}\nfor ln in txt:\n    mh=re.match(r'^([0-9a-f]+)\\s+<([A-Za-z_][\\w.]*)>:$', ln)\n    if mh:\n        funcmap[int(mh.group(1),16)]=mh.group(2); continue\n    mi=re.match(r'^\\s*([0-9a-f]+):\\s*(((?:[0-9a-f]{2}\\s+){1,15})(.*))$', ln)\n    if not mi: continue\n    addr=int(mi.group(1),16)\n    nbytes=len(mi.group(3).split())\n    rest=mi.group(4)\n    inst.append((addr,nbytes,rest))\nfuncstarts=sorted(funcmap)\ndef fname(a):\n    f=None\n    for fa in funcstarts:\n        if fa<=a: f=funcmap[fa]\n        else: break\n    return f\nro=open('/app/orig','rb').read()[0x3000:0x32c0]\nres={}\nfor a,n,r in inst:\n    m=re.search(r'rip\\+0x([0-9a-f]+)', r)\n    if not m: continue\n    if not ('movsd' in r or 'movss' in r or 'movups' in r or 'movaps' in r): continue\n    disp=int(m.group(1),16)\n    if disp>=0x80000000: disp-=(1<<32)\n    tgt=a+n+disp\n    if 0x3000<=tgt<0x32c0:\n        off=tgt-0x3000\n        try:\n            if 'movss' in r:\n                d=struct.unpack('<f', ro[off:off+4])[0]; k='f32'\n            else:\n                d=struct.unpack('<d', ro[off:off+8])[0]; k='f64'\n        except: continue\n        res.setdefault((fname(a),tgt),[]).append((round(d,6),k))\nfor (fn,tgt),vals in sorted(res.items()):\n    seen=set(); uniq=[]\n    for d,k in vals:\n        if (d,k) not in seen: seen.add((d,k)); uniq.append((d,k))\n    print('%-18s +%3d: %s'%(fn, tgt-0x3000, uniq[:5]))\nPYEOF\n.venv/bin/python /tmp/extract.py\n"]
