[249.673457, "o", "x = t(\"Hello, this is a test for offline use.\", return_tensors=\"pt\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.673532, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.673652, "o", "    out = m(**x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.673815, "o", "print(\"OFFLINE_OK\", out.last_hidden_state.shape)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
