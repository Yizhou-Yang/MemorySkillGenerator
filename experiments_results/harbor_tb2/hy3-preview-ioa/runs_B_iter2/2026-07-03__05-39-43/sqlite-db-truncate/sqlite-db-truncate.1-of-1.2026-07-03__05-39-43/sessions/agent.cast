[93.025964, "i", "cat > /app/parse.py << 'EOF'\nimport struct, json\n\nd = open('/app/trunc.db','rb').read()\n\ndef read_varint(data, pos):\n    result = 0\n    for i in range(9):\n        b = data[pos+i]\n        if i == 8:\n            result = (result << 8) | b\n            return result, pos+9\n        result = (result << 7) | (b & 0x7f)\n        if not (b & 0x80):\n            return result, pos+i+1\n    return result, pos+9\n\npage_type = d[0]\nnum_cells = int.from_bytes(d[3:5],'big')\ncell_start = int.from_bytes(d[5:7],'big')\nprint('page_type', page_type, 'num_cells', num_cells, 'cell_start', cell_start)\n\ncell_ptrs = []\nfor i in range(num_cells):\n    off = 8 + i*2\n    p = int.from_bytes(d[off:off+2],'big')\n    cell_ptrs.append(p)\nprint('cell_ptrs', [hex(x) for x in cell_ptrs])\n\ndef parse_record(payload):\n    hpos = 0\n    header_len, hpos = read_varint(payload, hpos)\n    serial_types = []\n    while hpos < header_len:\n        st, hpos = read_varint(payload, hpos)\n        serial_types.append(st)\n    dpos = header_len\n    values = []\n    for st in serial_types:\n        if st == 0:\n            values.append(None)\n        elif st == 1:\n            values.append(int.from_bytes(payload[dpos:dpos+1],'big',signed=True)); dpos+=1\n        elif st == 2:\n            values.append(int.from_bytes(payload[dpos:dpos+2],'big',signed=True)); dpos+=2\n        elif st == 3:\n            values.append(int.from_bytes(payload[dpos:dpos+3],'big',signed=True)); dpos+=3\n        elif st == 4:\n            values.append(int.from_bytes(payload[dpos:dpos+4],'big',signed=True)); dpos+=4\n        elif st == 5:\n            values.append(int.from_bytes(payload[dpos:dpos+6],'big',signed=True)); dpos+=6\n        elif st == 6:\n            values.append(int.from_bytes(payload[dpos:dpos+8],'big',signed=True)); dpos+=8\n        elif st == 7:\n            values.append(struct.unpack('>d', payload[dpos:dpos+8])[0]); dpos+=8\n        elif st == 8:\n            values.append(0)\n        elif st == 9:\n            values.append(1)\n        elif st >= 12 and st % 2 == 0:\n            n = (st-12)//2\n            values.append(payload[dpos:dpos+n]); dpos+=n\n        elif st >= 13 and st % 2 == 1:\n            n = (st-13)//2\n            values.append(payload[dpos:dpos+n].decode('utf-8','replace')); dpos+=n\n        else:\n            values.append(('UNKNOWN', st))\n    return values\n\nrows = []\nfor cp in cell_ptrs:\n    pos = cp\n    payload_len, pos = read_varint(d, pos)\n    rowid, pos = read_varint(d, pos)\n    payload = d[pos:pos+payload_len]\n    vals = parse_record(payload)\n    rows.append((rowid, vals))\n    print(rowid, vals)\nEOF\npython3 /app/parse.py\n"]
