[93.078463, "o", "\u001b[?2004hroot@53ee2ed0357c:/app# "]
[146.318119, "i", "cat > /app/recover.py << 'PYEOF'\nimport struct, json\n\nd = open('/app/trunc.db','rb').read()\n\ndef read_varint(data, pos):\n    result = 0\n    for i in range(9):\n        b = data[pos+i]\n        if i == 8:\n            result = (result << 8) | b\n            return result, pos+9\n        result = (result << 7) | (b & 0x7f)\n        if not (b & 0x80):\n            return result, pos+i+1\n    return result, pos+9\n\nnum_cells = int.from_bytes(d[3:5],'big')\ncell_ptrs = [int.from_bytes(d[8+i*2:10+i*2],'big') for i in range(num_cells)]\n\ndef parse_record(payload):\n    hpos = 0\n    header_len, hpos = read_varint(payload, hpos)\n    serial_types = []\n    while hpos < header_len:\n        st, hpos = read_varint(payload, hpos)\n        serial_types.append(st)\n    dpos = header_len\n    values = []\n    for st in serial_types:\n        if st == 0:\n            values.append(None)\n        elif st in (1,2,3,4,5,6):\n            n = {1:1,2:2,3:3,4:4,5:6,6:8}[st]\n            values.append(int.from_bytes(payload[dpos:dpos+n],'big',signed=True)); dpos+=n\n        elif st == 7:\n            values.append(struct.unpack('>d', payload[dpos:dpos+8])[0]); dpos+=8\n        elif st == 8:\n            values.append(0)\n        elif st == 9:\n            values.append(1)\n        elif st >= 12 and st % 2 == 0:\n            n = (st-12)//2; values.append(payload[dpos:dpos+n]); dpos+=n\n        elif st >= 13 and st % 2 == 1:\n            n = (st-13)//2; values.append(payload[dpos:dpos+n].decode('utf-8','replace')); dpos+=n\n        else:\n            values.append(('UNKNOWN', st))\n    return values\n\nrows = []\nfor cp in cell_ptrs:\n    pos = cp\n    payload_len, pos = read_varint(d, pos)\n    rowid, pos = read_varint(d, pos)\n    avail = len(d) - pos\n    truncated = avail < payload_len\n    payload = d[pos:pos+payload_len]\n    vals = parse_record(payload)\n    print('rowid', rowid, 'payload_len', payload_len, 'avail', avail, 'TRUNC' if truncated else 'ok', vals)\n    rows.append((rowid, vals, truncated))\n\nout = []\nfor rowid, vals, tr in rows:\n    if tr:\n        print('skipping truncated row', rowid)\n        continue\n    # vals = [None, word, value]\n    word = vals[1]\n    value = vals[2]\n    out.append({'word': word, 'value': value})\n\njson.dump(out, open('/app/recover.json','w'), indent=2)\nprint('WROTE', len(out), 'rows')\nprint(json.dumps(out, indent=2))\nPYEOF\npython3 /app/recover.py\n"]
