[52.914685, "o", "\u001b[36m@@ -38,7 +40,7 @@\u001b[m\r\n             <div class=\"jumbotron\">\u001b[m\r\n                 <div class=\"row\">\u001b[m\r\n                     <h3>\u001b[m\r\n\u001b[31m-                        PhD Student @ UW CSE\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                        Postdoc @ Stanford\u001b[m\r\n                     </h3>\u001b[m\r\n                 </div>\u001b[m\r\n                 <div class=\"row\">\u001b[m\r\n\u001b[36m@@ -88,7 +90,7 @@\u001b[m\r\n         <div class=\"row\">\u001b[m\r\n             <div class=\"col-md-12\">\u001b[m\r\n                 <h2>Publications</h2>\u001b[m\r\n\u001b[31m-                {% assign sorted_pubs = site.publications | sort: 'year' | reverse %} \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                {% assign sorted_pubs = site.publications | sort: 'year' | reverse %}\u001b[m\r\n                 {% for pub in sorted_pubs %}\u001b[m\r\n                 <div class=\"row\">\u001b[m\r\n                     <div class=\"col-md-3 hide-on-small\">\u001b[m\r\n\u001b[36m@@ -99,22 +101,22 @@\u001b[m\r\n                     <div class=\"col-md-9\">\u001b[m\r\n                         <p><b>{{pub.title}}</b></p>\u001b[m\r\n                         <p>\u001b[m\r\n\u001b[31m-     "]
