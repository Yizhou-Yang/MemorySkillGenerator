[316.994572, "o", "\u001b[?2004hroot@1bebe10bbd55:/app# "]
[362.67633, "i", "cat > /app/fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nx = np.array([float(s.replace(',', '.')) for s in d[:,0]])\ny = np.array([float(s.replace(',', '.')) for s in d[:,1]])\norder = np.argsort(x)\nx = x[order]; y = y[order]\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp * gamma**2 / ((x - x0)**2 + gamma**2)\n\ndef r2(xd, yd, p):\n    pred = lor(xd, *p)\n    return 1 - np.sum((yd-pred)**2)/np.sum((yd-yd.mean())**2)\n\ndef smooth(y, w):\n    k = np.ones(w)/w\n    return np.convolve(y, k, mode='same')\n\nys = smooth(y, 21)\n\ndef estimate(xmin, xmax):\n    m = (x>=xmin)&(x<=xmax)\n    xw, yw, ysw = x[m], y[m], ys[m]\n    i = np.argmax(ysw)\n    x0e = xw[i]\n    offe = np.median(ysw)\n    ampe = ysw[i]-offe\n    half = offe + ampe/2.0\n    above = np.where(ysw>half)[0]\n    if len(above)>1:\n        ge = (xw[above[-1]]-xw[above[0]])/2.0\n    else:\n        ge = 10.0\n    if ge<1: ge=10.0\n    print(f'  est: x0={x0e:.2f} gamma={ge:.2f} amp={a"]
[362.676389, "i", "mpe:.2f} off={offe:.2f}')\n    return xw, yw, [x0e, ge, ampe, offe]\n\nprint('G region estimate:')\nxG, yG, p0G = estimate(1640, 1700)\npG,_ = curve_fit(lor, xG, yG, p0=p0G, maxfev=2000000)\n\nprint('2D region estimate:')\nx2, y2, p02 = estimate(2650, 2950)\np2,_ = curve_fit(lor, x2, y2, p0=p02, maxfev=2000000)\n\nprint('G : x0=%.3f gamma=%.3f amp=%.3f off=%.3f  R2=%.4f' % (pG[0], pG[1], pG[2], pG[3], r2(xG,yG,pG)))\nprint('2D: x0=%.3f gamma=%.3f amp=%.3f off=%.3f  R2=%.4f' % (p2[0], p2[1], p2[2], p2[3], r2(x2,y2,p2)))\nEOF\npython3 /app/fit2.py\n"]
[362.676933, "o", "cat > /app/fit2.py << 'EOF'"]
