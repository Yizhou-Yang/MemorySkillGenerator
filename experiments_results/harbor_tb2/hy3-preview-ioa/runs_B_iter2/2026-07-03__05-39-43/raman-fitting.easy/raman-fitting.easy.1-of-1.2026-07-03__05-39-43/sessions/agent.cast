[488.78499, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nx = np.array([float(s.replace(',', '.')) for s in d[:,0]])\ny = np.array([float(s.replace(',', '.')) for s in d[:,1]])\norder = np.argsort(x)\nx = x[order]; y = y[order]\ndef smooth(y,w): return np.convolve(y, np.ones(w)/w, mode='same')\nys = smooth(y, 25)\nprint('=== G window smoothed (step ~5) ===')\nm=(x>=1635)&(x<=1700)\nxw,sw=x[m],ys[m]\nfor i in range(0,len(xw),4):\n    print(f'{xw[i]:.1f}  {sw[i]:.1f}')\nprint('=== 2D window smoothed (step ~10) ===')\nm=(x>=2650)&(x<=3000)\nxw,sw=x[m],ys[m]\nfor i in range(0,len(xw),8):\n    print(f'{xw[i]:.1f}  {sw[i]:.1f}')\nEOF\npython3 /app/diag.py\n"]
