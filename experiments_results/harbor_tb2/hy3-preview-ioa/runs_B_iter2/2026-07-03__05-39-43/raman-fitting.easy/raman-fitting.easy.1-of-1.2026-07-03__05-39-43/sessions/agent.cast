[408.765519, "i", "cat > /app/fit3.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\nd = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nx = np.array([float(s.replace(',', '.')) for s in d[:,0]])\ny = np.array([float(s.replace(',', '.')) for s in d[:,1]])\norder = np.argsort(x)\nx = x[order]; y = y[order]\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp * gamma**2 / ((x - x0)**2 + gamma**2)\n\ndef r2(xd, yd, p):\n    pred = lor(xd, *p)\n    return 1 - np.sum((yd-pred)**2)/np.sum((yd-yd.mean())**2)\n\ndef smooth(y, w):\n    k = np.ones(w)/w\n    return np.convolve(y, k, mode='same')\n\nys = smooth(y, 21)\n\n# G: window around 1654\nmG = (x>=1630)&(x<=1690)\nxG, yGs, yGr = x[mG], ys[mG], y[mG]\niG = np.argmax(yGs)\np0G = [xG[iG], 7, yGs[iG]-np.median(yGs), np.median(yGs)]\nprint('p0G', p0G)\npG,_ = curve_fit(lor, xG, yGs, p0=p0G, maxfev=2000000,\n                 bounds=([1600,0.1,0,0],[1700,100,1e5,1e5]))\n\n# 2D: window 2650-2980, peak ~2700-2900\nm2 = (x>=2650)&(x<=2980)\nx2, y2s, y2r = x[m2], ys[m2], y[m2]\ni2 = np.a"]
[408.765718, "i", "rgmax(y2s)\np02 = [x2[i2], 15, y2s[i2]-np.median(y2s), np.median(y2s)]\nprint('p02', p02)\np2,_ = curve_fit(lor, x2, y2s, p0=p02, maxfev=2000000,\n                 bounds=([2650,0.1,0,0],[2980,200,1e5,1e5]))\n\nprint('G : x0=%.3f gamma=%.3f amp=%.3f off=%.3f  R2sm=%.4f R2raw=%.4f' % (pG[0],pG[1],pG[2],pG[3], r2(xG,yGs,pG), r2(xG,yGr,pG)))\nprint('2D: x0=%.3f gamma=%.3f amp=%.3f off=%.3f  R2sm=%.4f R2raw=%.4f' % (p2[0],p2[1],p2[2],p2[3], r2(x2,y2s,p2), r2(x2,y2r,p2)))\nEOF\npython3 /app/fit3.py\n"]
[408.765814, "o", "cat > /app/fit3.py << 'EOF'\r\n\u001b[?2004l\rrgmax(y2s)\r\np02 = [x2[i2], 15, y2s[i2]-np.median(y2s), np.me"]
