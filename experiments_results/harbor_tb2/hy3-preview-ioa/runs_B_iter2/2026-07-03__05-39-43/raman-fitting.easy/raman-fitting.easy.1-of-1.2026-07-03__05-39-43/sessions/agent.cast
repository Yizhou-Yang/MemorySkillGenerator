[224.26687, "i", "cat > /app/explore2.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nx = np.array([float(s.replace(',', '.')) for s in d[:,0]])\ny = np.array([float(s.replace(',', '.')) for s in d[:,1]])\norder = np.argsort(x)\nxs = x[order]; ys = y[order]\nprint('=== G region x in [1640,1760] ===')\nm = (xs>=1640)&(xs<=1760)\nfor xi,yi in zip(xs[m],ys[m]):\n    print(f'{xi:.2f}  {yi:.2f}')\nprint('=== 2D region x in [2600,3000] ===')\nm = (xs>=2600)&(xs<=3000)\nfor xi,yi in zip(xs[m],ys[m]):\n    print(f'{xi:.2f}  {yi:.2f}')\nEOF\npython3 /app/explore2.py\n"]
