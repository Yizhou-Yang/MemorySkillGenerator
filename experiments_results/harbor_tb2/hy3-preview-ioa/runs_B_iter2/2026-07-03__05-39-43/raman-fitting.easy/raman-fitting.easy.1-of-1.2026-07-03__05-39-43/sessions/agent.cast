[315.615679, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\nd = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nx = np.array([float(s.replace(',', '.')) for s in d[:,0]])\ny = np.array([float(s.replace(',', '.')) for s in d[:,1]])\norder = np.argsort(x)\nx = x[order]; y = y[order]\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp * gamma**2 / ((x - x0)**2 + gamma**2)\n\ndef r2(xd, yd, p):\n    pred = lor(xd, *p)\n    ss_res = np.sum((yd - pred)**2)\n    ss_tot = np.sum((yd - yd.mean())**2)\n    return 1 - ss_res/ss_tot\n\n# G region\nmG = (x >= 1640) & (x <= 1720)\nxG, yG = x[mG], y[mG]\npG, _ = curve_fit(lor, xG, yG, p0=[1660, 5, 1500, 5000], maxfev=1000000)\n\n# 2D region\nm2 = (x >= 2650) & (x <= 2950)\nx2, y2 = x[m2], y[m2]\np2, _ = curve_fit(lor, x2, y2, p0=[2780, 15, 400, 300], maxfev=1000000)\n\nprint('G : x0=%.3f gamma=%.3f amp=%.3f off=%.3f  R2=%.4f' % (pG[0], pG[1], pG[2], pG[3], r2(xG,yG,pG)))\nprint('2D: x0=%.3f gamma=%."]
[315.615739, "o", "cat > /app/fit.py << 'EOF'"]
