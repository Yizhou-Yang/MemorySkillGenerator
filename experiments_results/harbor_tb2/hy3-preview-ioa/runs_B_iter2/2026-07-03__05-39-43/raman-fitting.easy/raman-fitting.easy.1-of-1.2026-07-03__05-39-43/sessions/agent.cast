[165.73952, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.signal import argrelextrema\r\n\u001b[?2004l\r\u001b[?2004h> d = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\r\n\u001b[?2004l\r\u001b[?2004h> x = np.array([float(s.replace(',', '.')) for s in d[:,0]])\r\n\u001b[?2004l\r\u001b[?2004h> y = np.array([float(s.replace(',', '.')) for s in d[:,1]])\r\n\u001b[?2004l\r\u001b[?2004h> print('x range', x.min(), x.max())\r\n\u001b[?2004l\r\u001b[?2004h> print('y range', y.min(), y.max())\r\n\u001b[?2004l\r\u001b[?2004h> order = np.argsort(x)\r\n\u001b[?2004l\r\u001b[?2004h> xs = x[order]; ys = y[order]\r\n\u001b[?2004l\r\u001b[?2004h> mx = argrelextrema(ys, np.greater, order=30)[0]\r\n\u001b[?2004l\r\u001b[?2004h> print('local maxima (x, y):')\r\n\u001b[?2004l\r\u001b[?2004h> for i in mx:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{xs[i]:.2f}  {ys[i]:.2f}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
