[651.792908, "i", "cat > /app/final.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nx = np.array([float(s.replace(',', '.')) for s in data[:,0]])\ny = np.array([float(s.replace(',', '.')) for s in data[:,1]])\nidx = np.argsort(x)\nx, y = x[idx], y[idx]\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp * gamma**2 / ((x - x0)**2 + gamma**2)\n\ndef smooth(y, w):\n    return np.convolve(y, np.ones(w)/w, mode='same')\n\nys = smooth(y, 11)\n\ndef clip(p, lo, hi):\n    return [min(max(v, l), h) for v, l, h in zip(p, lo, hi)]\n\n# G peak\nmG = (x >= 1640) & (x <= 1700)\nxG, yG, ysG = x[mG], y[mG], ys[mG]\niG = int(np.argmax(ysG))\np0G = [xG[iG], 8.0, max(ysG[iG]-np.median(yG), 1.0), np.median(yG)]\np0G = clip(p0G, [1600, 0.1, 0, 0], [1700, 200, 1e6, 1e6])\npG, _ = curve_fit(lor, xG, yG, p0=p0G, maxfev=2000000,\n                  bounds=([1600, 0.1, 0, 0], [1700, 200, 1e6, 1e6]))\n\n# 2D peak (centered near 2700 per task hint)\nm2 = (x >= 2650) & (x <= 2780"]
[651.796763, "i", ")\nx2, y2, ys2 = x[m2], y[m2], ys[m2]\ni2 = int(np.argmax(ys2))\np02 = [x2[i2], 20.0, max(ys2[i2]-np.median(y2), 1.0), np.median(y2)]\np02 = clip(p02, [2650, 0.1, 0, 0], [2780, 200, 1e6, 1e6])\np2, _ = curve_fit(lor, x2, y2, p0=p02, maxfev=2000000,\n                  bounds=([2650, 0.1, 0, 0], [2780, 200, 1e6, 1e6]))\n\ndef r2(xd, yd, p):\n    pred = lor(xd, *p)\n    return 1 - np.sum((yd-pred)**2)/np.sum((yd-yd.mean())**2)\n\nprint('G : x0=%.3f gamma=%.3f amp=%.3f off=%.3f  R2=%.4f' % (pG[0],pG[1],pG[2],pG[3], r2(xG,yG,pG)))\nprint('2D: x0=%.3f gamma=%.3f amp=%.3f off=%.3f  R2=%.4f' % (p2[0],p2[1],p2[2],p2[3], r2(x2,y2,p2)))\n\nres = {\n  'G':  {'x0': float(pG[0]), 'gamma': float(pG[1]), 'amplitude': float(pG[2]), 'offset': float(pG[3])},\n  '2D': {'x0': float(p2[0]), 'gamma': float(p2[1]), 'amplitude': float(p2[2]), 'offset': float(p2[3])},\n}\nwith open('/app/results.json', 'w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\npython3 /app/final.py\n"]
[651.796948, "o", "cat > /app/final.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\r\n\u001b[?2004l\r\u001b[?2004h> x = np.array([float(s.replace(',', '.')) for s in data[:,0]])\r\n\u001b[?2004l\r\u001b[?2004h> y = np.array([float(s.replace(',', '.')) for s in data[:,1]])\r\n\u001b[?2004l\r\u001b[?2004h> idx = np.argsort(x)\r\n\u001b[?2004l\r\u001b[?2004h> x, y = x[idx], y[idx]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def lor(x, x0, gamma, amp, off):\r\n\u001b[?2004l\r\u001b[?2004h>     return off + amp * gamma**2 / ((x - x0)**2 + gamma**2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def smooth(y, w):\r\n\u001b[?2004l\r\u001b[?2004h>     return np.convolve(y, np.ones(w)/w, mode='same')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ys = smooth(y, 11)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def clip(p, lo, hi):\r\n\u001b[?2004l\r\u001b[?2004h>     return [min(max(v, l), h) for v, l, h in zip(p, lo, hi)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2"]
[651.796978, "o", "004l\r\u001b[?2004h> # G peak\r\n\u001b[?2004l\r\u001b[?2004h> mG = (x >= 1640) & (x <= 1700)\r\n\u001b[?2004l\r\u001b[?2004h> xG, yG, ysG = x[mG], y[mG], ys[mG]\r\n\u001b[?2004l\r\u001b[?2004h> iG = int(np.argmax(ysG))\r\n\u001b[?2004l\r\u001b[?2004h> p0G = [xG[iG], 8.0, max(ysG[iG]-np.median(yG), 1.0), np.median(yG)]\r\n\u001b[?2004l\r\u001b[?2004h> p0G = clip(p0G, [1600, 0.1, 0, 0], [1700, 200, 1e6, 1e6])\r\n\u001b[?2004l\r\u001b[?2004h> pG, _ = curve_fit(lor, xG, yG, p0=p0G, maxfev=2000000,\r\n\u001b[?2004l\r\u001b[?2004h>                   bounds=([1600, 0.1, 0, 0], [1700, 200, 1e6, 1e6]))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 2D peak (centered near 2700 per task hint)\r\n\u001b[?2004l\r\u001b[?2004h> m2 = (x >= 2650) & (x <= 2780)\r\n\u001b[?2004l\r\u001b[?2004h> x2, y2, ys2 = x[m2], y[m2], ys[m2]\r\n\u001b[?2004l\r\u001b[?2004h> i2 = int(np.argmax(ys2))\r\n\u001b[?2004l\r\u001b[?2004h> p02 = [x2[i2], 20.0, max(ys2[i2]-np.median(y2), 1.0), np.median(y2)]\r\n\u001b[?2004l\r\u001b[?2004h> p02 = clip(p02, [2650, 0.1, 0, 0], [2780, 200, 1e6, 1e6])\r\n\u001b[?2004l\r\u001b[?2004h> p2, _ = curve_fit(lor, x2, y2, p0=p02, maxfev=2000000,\r\n\u001b[?2004l\r\u001b[?2004h>                   bo"]
