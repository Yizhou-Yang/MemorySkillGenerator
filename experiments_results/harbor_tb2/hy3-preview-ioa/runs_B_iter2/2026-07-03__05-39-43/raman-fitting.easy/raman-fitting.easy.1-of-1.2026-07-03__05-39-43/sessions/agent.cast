[165.735638, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import argrelextrema\nd = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nx = np.array([float(s.replace(',', '.')) for s in d[:,0]])\ny = np.array([float(s.replace(',', '.')) for s in d[:,1]])\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\norder = np.argsort(x)\nxs = x[order]; ys = y[order]\nmx = argrelextrema(ys, np.greater, order=30)[0]\nprint('local maxima (x, y):')\nfor i in mx:\n    print(f'{xs[i]:.2f}  {ys[i]:.2f}')\nEOF\npython3 /app/explore.py\n"]
[165.735904, "o", "cat > /app/explore.py << 'EOF'"]
