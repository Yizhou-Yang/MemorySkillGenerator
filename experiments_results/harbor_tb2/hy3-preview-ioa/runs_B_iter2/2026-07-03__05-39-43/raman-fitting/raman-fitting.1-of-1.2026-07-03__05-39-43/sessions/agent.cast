[117.125905, "i", "cat > viz.py << 'EOF'\nimport numpy as np\ndata=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        data.append((float(p[0]),float(p[1])))\nd=np.array(data); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\nN=70\nidx=np.linspace(0,len(x)-1,N).astype(int)\nfor i in idx:\n    print('%8.1f %8.1f' % (x[i], y[i]))\nEOF\npython3 viz.py\n"]
[117.127518, "o", "cat > viz.py << 'EOF'\r\n\u001b[?2004l\r"]
[117.12755, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r"]
[117.127661, "o", "\u001b[?2004h> data=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.130174, "o", "> with open('graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if not line: continue\r\n\u001b[?2004l\r\u001b[?2004h>         p=line.replace(',','.').split()\r\n\u001b[?2004l\r\u001b[?2004h>         if len(p)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>         data.append((float(p[0]),float(p[1])))\r\n\u001b[?2004l\r\u001b[?2004h> d=np.array(data); x=d[:,0]; y=d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> o=np.argsort(x); x=x[o]; y=y[o]\r\n\u001b[?2004l\r\u001b[?2004h> N=70\r\n\u001b[?2004l\r\u001b[?2004h> idx=np.linspace(0,len(x)-1,N).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> for i in idx:\r\n\u001b[?2004l\r\u001b[?2004h>     print('%8.1f %8.1f' % (x[i], y[i]))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
