[155.763056, "i", "cat > ident.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import argrelextrema\nfrom scipy.optimize import curve_fit\ndata=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        data.append((float(p[0]),float(p[1])))\nd=np.array(data); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\n\ndef lor(x,x0,g,a,off):\n    return off + a/(1.0+((x-x0)/g)**2)\n\nmx=argrelextrema(y, np.greater, order=20)[0]\nres=[]\nfor i in mx:\n    lo=max(0,i-60); hi=min(len(x),i+60)\n    xw=x[lo:hi]; yw=y[lo:hi]\n    if len(xw)<10: continue\n    off0=yw.min(); a0=yw.max()-off0; x0_0=xw[np.argmax(yw)]\n    g0=abs(xw[-1]-xw[0])/4\n    try:\n        popt,_=curve_fit(lor,xw,yw,p0=[x0_0,g0,a0,off0],maxfev=20000)\n        yp=lor(xw,*popt)\n        ss=((yw-yp)**2).sum(); sst=((yw-yw.mean())**2).sum()\n        r2=1-ss/sst if sst>0 else -1\n        res.append((r2,popt[0],popt[1],popt[2],popt[3],xw.min(),xw.max()))\n    except Exc"]
[155.763244, "i", "eption as e:\n        pass\nres.sort(reverse=True)\nfor r in res[:10]:\n    print('R2=%.4f x0=%.1f g=%.1f amp=%.1f off=%.1f xr=[%.0f,%.0f]'%(r[0],r[1],r[2],r[3],r[4],r[5],r[6]))\nEOF\npython3 ident.py\n"]
[155.763281, "o", "cat > ident.py << 'EOF'\r\n"]
