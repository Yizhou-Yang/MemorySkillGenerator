[267.171449, "i", "cat > verify.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\ndata=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        data.append((float(p[0]),float(p[1])))\nd=np.array(data); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\ndef lor(x,x0,g,a,off):\n    return off + a/(1.0+((x-x0)/g)**2)\nR=json.load(open('results.json'))\nfor name in ['G','2D']:\n    p=R[name]; x0,g,a,off=p['x0'],p['gamma'],p['amplitude'],p['offset']\n    m=(x>x0-4*g)&(x<x0+4*g); xw=x[m]; yw=y[m]\n    yp=lor(xw,x0,g,a,off)\n    r2=1-((yw-yp)**2).sum()/((yw-yw.mean())**2).sum()\n    print(name,'R2=%.4f'%r2,'npts=%d'%len(xw))\nEOF\npython3 verify.py\n"]
[267.172355, "o", "cat > verify.py << 'EOF'"]
