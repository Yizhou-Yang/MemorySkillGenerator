[212.6939, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        data.append((float(p[0]),float(p[1])))\nd=np.array(data); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\n\ndef lor(x,x0,g,a,off):\n    return off + a/(1.0+((x-x0)/g)**2)\n\ndef fit_peak(center, half0):\n    m=(x>center-half0)&(x<center+half0)\n    xw=x[m]; yw=y[m]\n    off0=yw.min(); a0=yw.max()-off0; x0_0=xw[np.argmax(yw)]; g0=half0/2\n    popt,_=curve_fit(lor,xw,yw,p0=[x0_0,g0,a0,off0],maxfev=40000)\n    x0,g,a,off=popt\n    # refine window to +-4*|gamma|\n    m=(x>x0-4*abs(g))&(x<x0+4*abs(g))\n    xw=x[m]; yw=y[m]\n    off0=yw.min(); a0=yw.max()-off0; g0=abs(g)\n    popt,_=curve_fit(lor,xw,yw,p0=[x0,g0,a0,off0],maxfev=40000)\n    x0,g,a,off=popt\n    return {'x0':float(x0),'gamma':float(abs(g)),'amplitude':float(a),'offset':float(off)}\n\nG=f"]
[212.694179, "i", "it_peak(3745,250)\nD=fit_peak(19139,5000)\nprint('G',G)\nprint('2D',D)\nout={'G':G,'2D':D}\nwith open('results.json','w') as f:\n    json.dump(out,f,indent=2)\nprint('written')\nEOF\npython3 fit.py\n"]
[212.694245, "o", "cat > fit.py << 'EOF'\r\n\u001b[?2004l\rit_peak(3745,250)\r\nD=fit_peak(19139,5000)\r\nprint('G',G)\r\nprint('2D',D)\r\nout={'G':G,'2D':D}\r\nwith open('results.json','w') as f:\r\n    json.dump(out,f,indent=2)\r\nprint('written')\r\nEOF\r\npython3 fit.py\r\n\u001b[?2004h> "]
