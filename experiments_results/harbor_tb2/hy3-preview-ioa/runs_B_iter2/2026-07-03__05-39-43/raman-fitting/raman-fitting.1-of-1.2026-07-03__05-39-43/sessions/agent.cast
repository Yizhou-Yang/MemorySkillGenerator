[267.182467, "o", "\r\n"]
[267.182975, "o", "\u001b[?2004l\r\u001b[?2004h"]
[267.183001, "o", "> with open('graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if not line: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.183204, "o", "        p=line.replace(',','.').split()\r\n\u001b[?2004l\r"]
[267.183275, "o", "\u001b[?2004h"]
[267.183369, "o", "> "]
[267.183449, "o", "        if len(p)<2: continue\r\n\u001b[?2004l\r"]
[267.183468, "o", "\u001b[?2004h> "]
[267.18361, "o", "        data.append((float(p[0]),float(p[1])))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.183719, "o", "d=np.array(data); x=d[:,0]; y=d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.183818, "o", "o=np.argsort(x); x=x[o]; y=y[o]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.183926, "o", "def lor(x,x0,g,a,off):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.184096, "o", "    return off + a/(1.0+((x-x0)/g)**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.184238, "o", "R=json.load(open('results.json'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.184391, "o", "for name in ['G','2D']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.184482, "o", "    p=R[name]; x0,g,a,off=p['x0'],p['gamma'],p['amplitude'],p['offset']\r\n\u001b[?2004l\r\u001b[?2004h"]
[267.184553, "o", "> "]
[267.184694, "o", "    m=(x>x0-4*g)&(x<x0+4*g); xw=x[m]; yw=y[m]\r\n\u001b[?2004l\r"]
[267.184803, "o", "\u001b[?2004h> "]
[267.184828, "o", "    yp=lor(xw,x0,g,a,off)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[267.18506, "o", "    r2=1-((yw-yp)**2).sum()/((yw-yw.mean())**2).sum()\r\n\u001b[?2004l\r"]
[267.185164, "o", "\u001b[?2004h"]
[267.185225, "o", "> "]
[267.185301, "o", "    print(name,'R2=%.4f'%r2,'npts=%d'%len(xw))\r\n\u001b[?2004l\r"]
[267.185381, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[267.187993, "o", "\u001b[?2004hroot@d4ea575e1a7f:/app# "]
[267.188686, "o", "python3 verify.py\r\n\u001b[?2004l\r"]
[268.164716, "o", "G R2=0.9931 npts=81\r\n2D R2=0.9444 npts=37\r\n"]
