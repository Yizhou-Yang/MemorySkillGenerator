[446.961197, "o", "weights.json written\r\nimage 28 28\r\n                            \r\n                            \r\n        .#@%#+=             \r\n        %@@@@@@%*           \r\n       :@+   =#@@#:         \r\n        =#     :#@@:        \r\n                 %@#        \r\n                 :@@=       \r\n                  *@#       \r\n                  -@#       \r\n                  -@#       \r\n                  -@#       \r\n                  =@#       \r\n                  #@#       \r\n       .+##*-.    #@+       \r\n      .%@@@@@@=  .@@:       \r\n     .@@%+::#@@* %@#        \r\n     =@%     -%@@@@-        \r\n     #@+      #@@@@- .      \r\n     #@@=====%@@@@@@#%#     \r\n     .#%@@@@@@*- -%@@@#     \r\n        +++++.     -%@*     \r\n                            \r\n                            \r\n                            \r\n                            \r\n                            \r\n                            \r\n"]
