[446.514306, "i", "cat > /app/extract.py <<'PYEOF'\nimport pickle, struct, zipfile, json, collections, io, zlib\n\nPTH='/app/model.pth'\nz=zipfile.ZipFile(PTH)\n\ndef rebuild(sb, off, size, stride, rg, bh):\n    n=1\n    for s in size: n*=s\n    fl=struct.unpack('<'+str(n)+'f', sb[off*4:(off+n)*4])\n    return {'size':list(size),'data':list(fl)}\n\nclass U(pickle.Unpickler):\n    def persistent_load(self, pid):\n        return z.read('simple_mnist/data/'+pid[2])\n    def find_class(self, mod, name):\n        if mod=='collections' and name=='OrderedDict': return collections.OrderedDict\n        if mod=='torch._utils' and name=='_rebuild_tensor_v2': return rebuild\n        if mod=='torch' and name=='FloatStorage': return object\n        raise pickle.UnpicklingError('no '+mod+'.'+name)\n\nod=U(io.BytesIO(z.read('simple_mnist/data.pkl'))).load()\n\ndef to2d(d):\n    r,c=d['size']; fl=d['data']\n    return [fl[i*c:(i+1)*c] for i in range(r)]\n\nW=to2d(od['input_layer.weight']); b=list(od['input_layer.bias']['data'])\nWh=to2d(od['hidden_layer.weight']); bh=list"]
[446.514354, "i", "(od['hidden_layer.bias']['data'])\nWo=to2d(od['output_layer.weight']); bo=list(od['output_layer.bias']['data'])\n\nout={'input':{'W':W,'b':b},'hidden':{'W':Wh,'b':bh},'output':{'W':Wo,'b':bo}}\njson.dump(out, open('/app/weights.json','w'))\nprint('weights.json written')\n\ndef decode_png(path):\n    data=open(path,'rb').read()\n    pos=8; idat=b''; w=h=ct=None\n    while pos<len(data):\n        ln=struct.unpack('>I', data[pos:pos+4])[0]\n        typ=data[pos+4:pos+8].decode('ascii')\n        cd=data[pos+8:pos+8+ln]\n        if typ=='IHDR': w,h,bd,ct=struct.unpack('>IIBB', cd[:10])\n        elif typ=='IDAT': idat+=cd\n        elif typ=='IEND': break\n        pos+=12+ln\n    raw=zlib.decompress(idat)\n    stride=w; prev=None; img=[]; idx=0\n    for y in range(h):\n        ft=raw[idx]; idx+=1\n        line=bytearray(raw[idx:idx+stride]); idx+=stride\n        r=bytearray(stride)\n        for i in range(stride):\n            x=line[i]\n            a=r[i-1] if i>=1 else 0\n            bb=prev[i] if prev is not None else 0\n            c=prev["]
[446.514385, "i", "i-1] if (prev is not None and i>=1) else 0\n            if ft==0: v=x\n            elif ft==1: v=x+a\n            elif ft==2: v=x+bb\n            elif ft==3: v=x+((a+bb)//2)\n            else:\n                p=a+bb-c\n                pa=abs(p-a); pb=abs(p-bb); pc=abs(p-c)\n                if pa<=pb and pa<=pc: pp=a\n                elif pb<=pc: pp=bb\n                else: pp=c\n                v=x+pp\n            r[i]=v & 255\n        img.append(r); prev=r\n    return w,h,[row[i] for row in img for i in range(w)]\n\ndef predict(W_in,b_in,W_h,b_h,W_o,b_o,pix,mean=None,std=None):\n    x=[]\n    for p in pix:\n        v=p/255.0\n        if mean is not None: v=(v-mean)/std\n        x.append(v)\n    def lay(W,b,inp):\n        res=[]\n        for i in range(len(b)):\n            s=b[i]; Wi=W[i]\n            for j in range(len(inp)): s+=Wi[j]*inp[j]\n            res.append(s)\n        return res\n    h=lay(W_in,b_in,x); h=[max(0.0,v) for v in h]\n    h=lay(W_h,b_h,h); h=[max(0.0,v) for v in h]\n    o=lay(W_o,b_o,h)\n    return max(range(len(o))"]
[446.514393, "i", ", key=lambda i:o[i])\n\nw,h,pix=decode_png('/app/image.png')\nprint('image', w, h)\nchars=' .:-=+*#%@'\nfor y in range(h):\n    row=''\n    for xx in range(w):\n        v=pix[y*w+xx]; row+=chars[min(9, v*10//256)]\n    print(row)\nprint('pred /255       :', predict(W,b,Wh,bh,Wo,bo,pix))\nprint('pred normalized :', predict(W,b,Wh,bh,Wo,bo,pix,0.1307,0.3081))\nPYEOF\n"]
