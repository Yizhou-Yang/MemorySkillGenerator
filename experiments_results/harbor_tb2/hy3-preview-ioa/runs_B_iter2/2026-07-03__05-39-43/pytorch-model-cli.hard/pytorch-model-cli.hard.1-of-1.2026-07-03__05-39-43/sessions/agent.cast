[446.530678, "o", " return w,h,[row[i] for row in img for i in range(w)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def predict(W_in,b_in,W_h,b_h,W_o,b_o,pix,mean=None,std=None):\r\n\u001b[?2004l\r\u001b[?2004h>     x=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for p in pix:\r\n\u001b[?2004l\r\u001b[?2004h>         v=p/255.0\r\n\u001b[?2004l\r\u001b[?2004h>         if mean is not None: v=(v-mean)/std\r\n\u001b[?2004l\r\u001b[?2004h>         x.append(v)\r\n\u001b[?2004l\r\u001b[?2004h>     def lay(W,b,inp):\r\n\u001b[?2004l\r\u001b[?2004h>         res=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(len(b)):\r\n\u001b[?2004l\r\u001b[?2004h>             s=b[i]; Wi=W[i]\r\n\u001b[?2004l\r\u001b[?2004h>             for j in range(len(inp)): s+=Wi[j]*inp[j]\r\n\u001b[?2004l\r\u001b[?2004h>             res.append(s)\r\n\u001b[?2004l\r\u001b[?2004h>         return res\r\n\u001b[?2004l\r\u001b[?2004h>     h=lay(W_in,b_in,x); h=[max(0.0,v) for v in h]\r\n\u001b[?2004l\r\u001b[?2004h>     h=lay(W_h,b_h,h); h=[max(0.0,v) for v in h]\r\n\u001b[?2004l\r\u001b[?2004h>     o=lay(W_o,b_o,h)\r\n\u001b[?2004l\r\u001b[?2004h>     return max(range(len(o)), key=lambda i:o[i])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> w,h,pix=decode_png('/app/image.p"]
[446.530765, "o", "ng')\r\n\u001b[?2004l\r\u001b[?2004h> print('image', w, h)\r\n\u001b[?2004l\r\u001b[?2004h> chars=' .:-=+*#%@'\r\n\u001b[?2004l\r\u001b[?2004h> for y in range(h):\r\n\u001b[?2004l\r\u001b[?2004h>     row=''\r\n\u001b[?2004l\r\u001b[?2004h>     for xx in range(w):\r\n\u001b[?2004l\r\u001b[?2004h>         v=pix[y*w+xx]; row+=chars[min(9, v*10//256)]\r\n\u001b[?2004l\r\u001b[?2004h>     print(row)\r\n\u001b[?2004l\r\u001b[?2004h> print('pred /255       :', predict(W,b,Wh,bh,Wo,bo,pix))\r\n\u001b[?2004l\r\u001b[?2004h> print('pred normalized :', predict(W,b,Wh,bh,Wo,bo,pix,0.1307,0.3081))\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
