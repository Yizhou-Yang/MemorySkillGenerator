[502.011704, "i", "cat > /app/cli_tool <<'PYEOF'\n#!/usr/bin/env python3\nimport sys, json, struct, zlib\n\ndef decode_png(path):\n    data = open(path, 'rb').read()\n    pos = 8; idat = b''; w = h = None\n    while pos < len(data):\n        ln = struct.unpack('>I', data[pos:pos+4])[0]\n        typ = data[pos+4:pos+8].decode('ascii')\n        cd = data[pos+8:pos+8+ln]\n        if typ == 'IHDR':\n            w, h, bd, ct = struct.unpack('>IIBB', cd[:10])\n        elif typ == 'IDAT':\n            idat += cd\n        elif typ == 'IEND':\n            break\n        pos += 12 + ln\n    if w is None:\n        raise SystemExit('invalid PNG')\n    raw = zlib.decompress(idat)\n    ch = 1\n    stride = w * ch\n    prev = None; pix = []; idx = 0\n    for y in range(h):\n        ft = raw[idx]; idx += 1\n        line = bytearray(raw[idx:idx+stride]); idx += stride\n        r = bytearray(stride)\n        for i in range(stride):\n            x = line[i]\n            a = r[i-ch] if i >= ch else 0\n            bv = prev[i] if prev is not None else 0\n            c = prev[i-ch"]
[502.011759, "i", "] if (prev is not None and i >= ch) else 0\n            if ft == 0: v = x\n            elif ft == 1: v = x + a\n            elif ft == 2: v = x + bv\n            elif ft == 3: v = x + ((a + bv) // 2)\n            else:\n                p = a + bv - c\n                pa, pb, pc = abs(p-a), abs(p-bv), abs(p-c)\n                if pa <= pb and pa <= pc: pp = a\n                elif pb <= pc: pp = bv\n                else: pp = c\n                v = x + pp\n            r[i] = v & 255\n        for i in range(0, stride, ch):\n            pix.append(r[i])\n        prev = r\n    return w, h, pix\n\ndef layer(W, b, inp):\n    n = len(b)\n    m = len(inp)\n    return [b[i] + sum(W[i][j]*inp[j] for j in range(m)) for i in range(n)]\n\ndef main():\n    if len(sys.argv) < 3:\n        sys.stderr.write('usage: cli_tool weights.json image.png\\n'); sys.exit(1)\n    M = json.load(open(sys.argv[1]))\n    w, h, pix = decode_png(sys.argv[2])\n    mean, std = 0.1307, 0.3081\n    x = [(p/255.0 - mean)/std for p in pix]\n    h1 = layer(M['input']['W'], M['inpu"]
[502.012143, "i", "t']['b'], x)\n    h1 = [max(0.0, v) for v in h1]\n    h2 = layer(M['hidden']['W'], M['hidden']['b'], h1)\n    h2 = [max(0.0, v) for v in h2]\n    o = layer(M['output']['W'], M['output']['b'], h2)\n    print(max(range(len(o)), key=lambda i: o[i]))\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
