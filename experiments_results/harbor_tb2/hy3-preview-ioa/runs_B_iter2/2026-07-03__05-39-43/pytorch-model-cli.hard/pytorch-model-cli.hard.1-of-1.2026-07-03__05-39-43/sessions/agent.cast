[30.066384, "o", "import torch\r"]
[30.066793, "o", "\r\n"]
[30.066965, "o", "import torch.nn as nn\r"]
[30.067134, "o", "\r\n"]
[30.067353, "o", "\r"]
[30.06754, "o", "\r\n"]
[30.067701, "o", "\r"]
[30.067863, "o", "\r\n"]
[30.068025, "o", "class MnistModel(nn.Module):\r"]
[30.068219, "o", "\r\n"]
[30.068532, "o", "    def __init__(\r"]
[30.0687, "o", "\r\n"]
[30.068864, "o", "        self,\r"]
[30.069026, "o", "\r\n"]
[30.069427, "o", "        input_dim: int,\r"]
[30.069622, "o", "\r\n"]
[30.069793, "o", "        hidden_dim: int,\r"]
[30.069961, "o", "\r\n"]
[30.070122, "o", "        num_classes: int,\r"]
[30.070296, "o", "\r\n"]
[30.070537, "o", "    ) -> torch.nn.Module:\r"]
[30.070699, "o", "\r\n"]
[30.07086, "o", "        super().__init__()\r"]
[30.071023, "o", "\r\n"]
[30.071541, "o", "\r"]
[30.071714, "o", "\r\n"]
[30.071875, "o", "        self.input_layer = nn.Linear(input_dim, hidden_dim)\r"]
[30.07204, "o", "\r\n"]
[30.072202, "o", "        self.hidden_layer = nn.Linear(hidden_dim, hidden_dim)\r"]
[30.072411, "o", "\r\n"]
[30.072582, "o", "        self.output_layer = nn.Linear(hidden_dim, num_classes)\r"]
[30.072787, "o", "\r\n"]
[30.072959, "o", "        self.activation = nn.ReLU()\r"]
[30.073131, "o", "\r\n"]
[30.073332, "o", "\r"]
[30.073532, "o", "\r\n"]
[30.073705, "o", "    def forward(self, x):\r"]
[30.073871, "o", "\r\n"]
[30.073998, "o", "        x = self.input_layer(x)\r"]
[30.074115, "o", "\r\n"]
[30.07423, "o", "        x = self.activation(x)\r"]
[30.074756, "o", "\r\n"]
[30.074881, "o", "\r"]
[30.074995, "o", "\r\n"]
[30.07511, "o", "        x = self.hidden_layer(x)\r"]
[30.075226, "o", "\r\n"]
[30.075359, "o", "        x = self.activation(x)\r"]
[30.075495, "o", "\r\n"]
[30.07561, "o", "\r"]
[30.075722, "o", "\r\n"]
[30.075865, "o", "        x = self.output_layer(x)\r"]
[30.075981, "o", "\r\n"]
[30.076105, "o", "        return x\r"]
[30.076222, "o", "\r\n"]
