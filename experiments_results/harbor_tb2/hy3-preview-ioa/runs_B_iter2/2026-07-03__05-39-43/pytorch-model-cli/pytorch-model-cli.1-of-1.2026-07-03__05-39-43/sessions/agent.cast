[510.269759, "o", "        const double* wrow = W + (size_t)i * in_dim;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.269953, "o", "        for (int j = 0; j < in_dim; j++) s += wrow[j] * x[j];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.270055, "o", "        out[i] = s;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[510.270087, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.270109, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[510.270118, "o", "> "]
[510.27031, "o", "static double relu(double v) { return v > 0.0 ? v : 0.0; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[510.270333, "o", "\u001b[?2004h> "]
[510.270452, "o", "int main(int argc, char** argv) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.270468, "o", "> "]
[510.270511, "o", "    if (argc < 3) {\r\n\u001b[?2004l\r"]
[510.270525, "o", "\u001b[?2004h> "]
[510.270736, "o", "        fprintf(stderr, \"usage: %s weights.json image.png\\n\", argv[0]);\r\n\u001b[?2004l\r"]
[510.270823, "o", "\u001b[?2004h"]
[510.270855, "o", "> "]
[510.27098, "o", "        return 1;\r\n\u001b[?2004l\r"]
[510.27108, "o", "\u001b[?2004h> "]
[510.271182, "o", "    }\r\n\u001b[?2004l\r"]
[510.271299, "o", "\u001b[?2004h> "]
[510.271485, "o", "    const char* wpath = argv[1];\r\n\u001b[?2004l\r"]
[510.27157, "o", "\u001b[?2004h> "]
[510.271742, "o", "    const char* ipath = argv[2];\r\n\u001b[?2004l\r"]
[510.271834, "o", "\u001b[?2004h> "]
[510.27191, "o", "\r\n"]
[510.271934, "o", "\u001b[?2004l\r\u001b[?2004h"]
[510.27201, "o", "> "]
[510.27213, "o", "    char* jtext = read_file(wpath);\r\n\u001b[?2004l\r"]
[510.272238, "o", "\u001b[?2004h> "]
[510.272511, "o", "    if (!jtext) { fprintf(stderr, \"cannot read %s\\n\", wpath); return 1; }"]
[510.272605, "o", "\r\n"]
[510.272717, "o", "\u001b[?2004l\r\u001b[?2004h"]
[510.272814, "o", "> "]
[510.272984, "o", "    cJSON* root = cJSON_Parse(jtext);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.273007, "o", "    free(jtext);\r\n\u001b[?2004l\r"]
[510.275222, "o", "\u001b[?2004h>     if (!root) { fprintf(stderr, \"json parse error\\n\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     double W1[16*784], b1[16], W2[16*16], b2[16], W3[10*16], b3[10];\r\n\u001b[?2004l\r\u001b[?2004h>     if (load_array(root, \"input_layer.weight\", W1, 16*784) ||\r\n\u001b[?2004l\r\u001b[?2004h>         load_array(root, \"input_layer.bias\", b1, 16) ||\r\n\u001b[?2004l\r\u001b[?2004h>         load_array(root, \"hidden_layer.weight\", W2, 16*16) ||\r\n\u001b[?2004l\r\u001b[?2004h>         load_array(root, \"hidden_layer.bias\", b2, 16) ||\r\n\u001b[?2004l\r\u001b[?2004h>         load_array(root, \"output_layer.weight\", W3, 10*16) ||\r\n\u001b[?2004l\r\u001b[?2004h>         load_array(root, \"output_layer.bias\", b3, 10)) {\r\n\u001b[?2004l\r\u001b[?2004h>         fprintf(stderr, \"weight load error\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>         cJSON_Delete(root);\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     cJSON_Delete(root);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<unsigned char> img;\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.275266, "o", "> "]
[510.27539, "o", "    unsigned w = 0, h = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.275616, "o", "    unsigned err = lodepng::decode(img, w, h, ipath);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.275674, "o", "    if (err) { fprintf(stderr, \"png decode error %u\\n\", err); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.275688, "o", "> \r\n\u001b[?2004l\r"]
[510.275725, "o", "\u001b[?2004h> "]
[510.275872, "o", "    const int S = 28;\r\n\u001b[?2004l\r\u001b[?2004h>     double x[784];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.275991, "o", "    for (int yy = 0; yy < S; yy++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.276012, "o", "> "]
[510.276146, "o", "        for (int xx = 0; xx < S; xx++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.276284, "o", "            int sx = (int)(xx * w / (double)S);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.276452, "o", "            int sy = (int)(yy * h / (double)S);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.276593, "o", "            if (sx >= (int)w) sx = (int)w - 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.276736, "o", "            if (sy >= (int)h) sy = (int)h - 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.276948, "o", "            unsigned char g = img[(size_t)((size_t)sy * w + sx) * 4 + 0];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.277066, "o", "            double v = g / 255.0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.277221, "o", "            v = (v - 0.1307) / 0.3081;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.277334, "o", "            x[yy * S + xx] = v;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[510.277369, "o", "\u001b[?2004h> "]
[510.277419, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[510.277435, "o", "\u001b[?2004h> "]
[510.277579, "o", "    double h1[16], h2[16], out[10];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.277695, "o", "    linear(W1, b1, x, 784, 16, h1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.277837, "o", "    for (int i = 0; i < 16; i++) h1[i] = relu(h1[i]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.27795, "o", "    linear(W2, b2, h1, 16, 16, h2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.278117, "o", "    for (int i = 0; i < 16; i++) h2[i] = relu(h2[i]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.278244, "o", "    linear(W3, b3, h2, 16, 10, out);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[510.278269, "o", "\u001b[?2004h> "]
[510.278322, "o", "    int pred = 0;\r\n\u001b[?2004l\r"]
[510.278335, "o", "\u001b[?2004h> "]
[510.278545, "o", "    for (int i = 1; i < 10; i++) if (out[i] > out[pred]) pred = i;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[510.278569, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[510.278693, "o", "    printf(\"%d\", pred);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.278802, "o", "    std::string wstr(wpath);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.278906, "o", "    size_t sl = wstr.find_last_of('/');\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.278929, "o", "> "]
[510.279176, "o", "    std::string dir = (sl == std::string::npos) ? std::string(\"./\") : wstr.substr(0, sl + 1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.279253, "o", "> "]
[510.279375, "o", "    std::string predp = dir + \"prediction.txt\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.279484, "o", "    FILE* pf = fopen(predp.c_str(), \"w\");\r\n\u001b[?2004l\r"]
[510.279507, "o", "\u001b[?2004h> "]
[510.279655, "o", "    if (pf) { fprintf(pf, \"%d\", pred); fclose(pf); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.279675, "o", "> \r\n\u001b[?2004l\r"]
[510.279689, "o", "\u001b[?2004h> "]
[510.279746, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[510.279757, "o", "> }\r\n"]
[510.279768, "o", "\u001b[?2004l\r"]
[510.279808, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[510.282865, "o", "\u001b[?2004hroot@cd63cf8efa91:/app# "]
[510.28307, "o", "echo done\r\n\u001b[?2004l\rdone\r\n"]
