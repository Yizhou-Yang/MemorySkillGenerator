[510.263049, "i", "cat > /app/cli_tool.cpp << 'EOF'\n#include <cstdio>\n#include <cstdlib>\n#include <cstring>\n#include <string>\n#include <vector>\n#include \"cJSON.h\"\n#include \"lodepng.h\"\n\nstatic char* read_file(const char* path) {\n    FILE* f = fopen(path, \"rb\");\n    if (!f) return nullptr;\n    fseek(f, 0, SEEK_END);\n    long n = ftell(f);\n    fseek(f, 0, SEEK_SET);\n    char* buf = (char*)malloc((size_t)n + 1);\n    if (!buf) { fclose(f); return nullptr; }\n    size_t r = fread(buf, 1, (size_t)n, f);\n    buf[r] = 0;\n    fclose(f);\n    return buf;\n}\n\nstatic int load_array(cJSON* root, const char* key, double* dst, int n) {\n    cJSON* a = cJSON_GetObjectItem(root, key);\n    if (!a || !cJSON_IsArray(a)) return -1;\n    if (cJSON_GetArraySize(a) != n) return -2;\n    for (int i = 0; i < n; i++) {\n        cJSON* e = cJSON_GetArrayItem(a, i);\n        dst[i] = cJSON_GetNumberValue(e);\n    }\n    return 0;\n}\n\nstatic void linear(const double* W, const double* b, const double* x, int in_dim, int out_dim, double* out) {\n    for (int i = 0; i < ou"]
[510.263122, "i", "t_dim; i++) {\n        double s = b[i];\n        const double* wrow = W + (size_t)i * in_dim;\n        for (int j = 0; j < in_dim; j++) s += wrow[j] * x[j];\n        out[i] = s;\n    }\n}\n\nstatic double relu(double v) { return v > 0.0 ? v : 0.0; }\n\nint main(int argc, char** argv) {\n    if (argc < 3) {\n        fprintf(stderr, \"usage: %s weights.json image.png\\n\", argv[0]);\n        return 1;\n    }\n    const char* wpath = argv[1];\n    const char* ipath = argv[2];\n\n    char* jtext = read_file(wpath);\n    if (!jtext) { fprintf(stderr, \"cannot read %s\\n\", wpath); return 1; }\n    cJSON* root = cJSON_Parse(jtext);\n    free(jtext);\n    if (!root) { fprintf(stderr, \"json parse error\\n\"); return 1; }\n\n    double W1[16*784], b1[16], W2[16*16], b2[16], W3[10*16], b3[10];\n    if (load_array(root, \"input_layer.weight\", W1, 16*784) ||\n        load_array(root, \"input_layer.bias\", b1, 16) ||\n        load_array(root, \"hidden_layer.weight\", W2, 16*16) ||\n        load_array(root, \"hidden_layer.bias\", b2, 16) ||\n        load_array(root,"]
[510.263494, "i", " \"output_layer.weight\", W3, 10*16) ||\n        load_array(root, \"output_layer.bias\", b3, 10)) {\n        fprintf(stderr, \"weight load error\\n\");\n        cJSON_Delete(root);\n        return 1;\n    }\n    cJSON_Delete(root);\n\n    std::vector<unsigned char> img;\n    unsigned w = 0, h = 0;\n    unsigned err = lodepng::decode(img, w, h, ipath);\n    if (err) { fprintf(stderr, \"png decode error %u\\n\", err); return 1; }\n\n    const int S = 28;\n    double x[784];\n    for (int yy = 0; yy < S; yy++) {\n        for (int xx = 0; xx < S; xx++) {\n            int sx = (int)(xx * w / (double)S);\n            int sy = (int)(yy * h / (double)S);\n            if (sx >= (int)w) sx = (int)w - 1;\n            if (sy >= (int)h) sy = (int)h - 1;\n            unsigned char g = img[(size_t)((size_t)sy * w + sx) * 4 + 0];\n            double v = g / 255.0;\n            v = (v - 0.1307) / 0.3081;\n            x[yy * S + xx] = v;\n        }\n    }\n\n    double h1[16], h2[16], out[10];\n    linear(W1, b1, x, 784, 16, h1);\n    for (int i = 0; i < 16; i++) h1"]
[510.263525, "o", "cat > /app/cli_tool.cpp << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include <cstdio>\r\n\u001b[?2004l\r\u001b[?2004h> #include <cstdlib>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[510.263537, "i", "[i] = relu(h1[i]);\n    linear(W2, b2, h1, 16, 16, h2);\n    for (int i = 0; i < 16; i++) h2[i] = relu(h2[i]);\n    linear(W3, b3, h2, 16, 10, out);\n\n    int pred = 0;\n    for (int i = 1; i < 10; i++) if (out[i] > out[pred]) pred = i;\n\n    printf(\"%d\", pred);\n\n    std::string wstr(wpath);\n    size_t sl = wstr.find_last_of('/');\n    std::string dir = (sl == std::string::npos) ? std::string(\"./\") : wstr.substr(0, sl + 1);\n    std::string predp = dir + \"prediction.txt\";\n    FILE* pf = fopen(predp.c_str(), \"w\");\n    if (pf) { fprintf(pf, \"%d\", pred); fclose(pf); }\n\n    return 0;\n}\nEOF\necho done\n"]
[510.263642, "o", "#include <cstring>\r\n\u001b[?2004l\r[i] = relu(h1[i]);\r\n    linear(W2, b2, h1, 16, 16, h2);\r\n    for (int i = 0; i < 16; i++) h2[i] = relu(h2[i]);\r\n    linear(W3, b3, h2, 16, 10, out);\r\n\r\n    int pred = 0;\r\n    for (int i = 1; i < 10; i++) if (out[i] > out[pred]) pred = i;\r\n\r\n    printf(\"%d\", pred);\r\n\r\n    std::string wstr(wpath);\r\n    size_t sl = wstr.find_last_of('/');\r\n    std::string dir = (sl == std::string::npos) ? std::string(\"./\") : wstr.substr(0, sl + 1);\r\n    std::string predp = dir + \"prediction.txt\";\r\n    FILE* pf = fopen(predp.c_str(), \"w\");\r\n    if (pf) { fprintf(pf, \"%d\", pred); fclose(pf); }\r\n\r\n    return 0;\r\n}\r\nEOF\r\necho done\r\n"]
