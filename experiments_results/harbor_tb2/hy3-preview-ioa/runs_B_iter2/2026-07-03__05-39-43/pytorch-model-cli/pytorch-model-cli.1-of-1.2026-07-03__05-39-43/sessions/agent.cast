[366.909761, "i", "cat > /app/explore.py << 'EOF'\nimport torch, numpy as np\nfrom PIL import Image\n\nsd = torch.load('model.pth', map_location='cpu')\nimg = Image.open('image.png').convert('L').resize((28,28))\na = np.asarray(img, dtype=np.float64)\nprint('shape', a.shape, 'min', a.min(), 'max', a.max(), 'mean', round(a.mean(),3))\n\nclass M(torch.nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.input_layer=torch.nn.Linear(784,16)\n        self.hidden_layer=torch.nn.Linear(16,16)\n        self.output_layer=torch.nn.Linear(16,10)\n    def forward(self,x):\n        x=torch.relu(self.input_layer(x))\n        x=torch.relu(self.hidden_layer(x))\n        return self.output_layer(x)\nm=M(); m.load_state_dict(sd); m.eval()\n\ndef infer(x):\n    x=torch.tensor(x, dtype=torch.float32).reshape(1,784)\n    with torch.no_grad():\n        return m(x).numpy()[0]\n\nfor name, x in [\n    ('x/255', a/255.0),\n    ('1-x/255', 1.0-a/255.0),\n    ('(x/255-0.1307)/0.3081', (a/255.0-0.1307)/0.3081),\n    ('(1-x/255-0.1307)/0.3081', ((1.0-a/255.0)-"]
[366.910077, "i", "0.1307)/0.3081),\n]:\n    logits=infer(x)\n    print(name, '-> pred', int(logits.argmax()), 'logits', np.round(logits,2).tolist())\nEOF\npython3 /app/explore.py 2>&1 | grep -v UserWarning | grep -v conversion_method\n"]
