[442.877309, "i", "cat > /tmp/dl.py << 'EOF'\nimport urllib.request, re, os, sys\nos.makedirs('/tmp/debs', exist_ok=True)\nurls=[]\nfor line in open('/tmp/urls.txt'):\n    line=line.strip()\n    if not line.startswith(\"'\"): continue\n    m=re.match(r\"'([^']+)'\\s+(\\S+)\", line)\n    if not m: continue\n    url, fn = m.group(1), m.group(2)\n    urls.append((url, fn))\nprint('urls:', len(urls))\nfor url, fn in urls:\n    dst='/tmp/debs/'+fn\n    try:\n        urllib.request.urlretrieve(url, dst)\n        print('OK', fn)\n    except Exception as e:\n        print('FAIL', fn, e)\nEOF\npython3 /tmp/dl.py 2>&1 | tail -20\n"]
