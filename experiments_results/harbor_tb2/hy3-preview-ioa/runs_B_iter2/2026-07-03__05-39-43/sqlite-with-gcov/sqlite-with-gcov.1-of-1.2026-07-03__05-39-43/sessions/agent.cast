[492.69891, "i", "cat > /tmp/dl.py << 'EOF'\nimport urllib.request, re, os\nos.makedirs('/tmp/debs', exist_ok=True)\nurls=[]\nfor line in open('/tmp/urls.txt'):\n    line=line.strip()\n    if not line.startswith(\"'\"): continue\n    m=re.match(r\"'([^']+)'\\s+(\\S+)\", line)\n    if not m: continue\n    urls.append((m.group(1), m.group(2)))\nprint('urls:', len(urls))\nopener=urllib.request.build_opener()\nopener.addheaders=[('User-Agent','Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36')]\nfor url, fn in urls:\n    dst='/tmp/debs/'+fn\n    try:\n        urllib.request.urlretrieve(url, dst)\n        print('OK', fn, os.path.getsize(dst))\n    except Exception as e:\n        print('FAIL', fn, e)\nEOF\npython3 /tmp/dl.py 2>&1 | tail -25\n"]
