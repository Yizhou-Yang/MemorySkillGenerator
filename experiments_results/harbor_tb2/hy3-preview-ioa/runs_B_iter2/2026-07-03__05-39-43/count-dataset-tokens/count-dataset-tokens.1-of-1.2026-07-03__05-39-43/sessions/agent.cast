[354.250091, "i", "cat > /app/probe.py <<'EOF'\nfrom huggingface_hub import hf_hub_download\nimport pyarrow.parquet as pq\nfrom collections import Counter\nREPO=\"open-thoughts/OpenThoughts-114k\"\nglob=Counter()\nfor i in range(12):\n    fn=f\"metadata/train-{i:05d}-of-00012.parquet\"\n    path=hf_hub_download(repo_id=REPO, filename=fn, repo_type=\"dataset\")\n    t=pq.read_table(path, columns=[\"domain\"])\n    c=Counter(t.column(\"domain\").to_pylist())\n    print(fn, dict(c), flush=True)\n    glob.update(c)\n    import os; os.remove(path)\nprint(\"GLOBAL\", dict(glob), flush=True)\nEOF\npython3 /app/probe.py > /app/probe.log 2>&1 &\n"]
