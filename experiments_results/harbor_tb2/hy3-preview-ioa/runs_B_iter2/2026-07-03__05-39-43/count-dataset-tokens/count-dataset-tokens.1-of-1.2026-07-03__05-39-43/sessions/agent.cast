[162.282746, "o", "\u001b[?2004hroot@eac41e6666da:/app# "]
[239.561017, "i", "cat > /app/count_tokens.py <<'EOF'\nimport os\nfrom huggingface_hub import hf_hub_download\nimport pyarrow.parquet as pq\nfrom transformers import AutoTokenizer\n\nREPO = \"open-thoughts/OpenThoughts-114k\"\nSCI = {\"biology\", \"physics\", \"chemistry\"}\nshards = [f\"metadata/train-{i:05d}-of-00012.parquet\" for i in range(12)]\n\nprint(\"loading tokenizer...\", flush=True)\ntok = AutoTokenizer.from_pretrained(\"Qwen/Qwen2.5-1.5B-Instruct\")\n\ntotal = 0\nnsci = 0\nfor sh in shards:\n    path = hf_hub_download(repo_id=REPO, filename=sh, repo_type=\"dataset\")\n    t = pq.read_table(path, columns=[\"domain\", \"deepseek_reasoning\", \"deepseek_solution\"])\n    dom = t.column(\"domain\").to_pylist()\n    reason = t.column(\"deepseek_reasoning\").to_pylist()\n    sol = t.column(\"deepseek_solution\").to_pylist()\n    rtxt = []\n    stxt = []\n    for d, r, s in zip(dom, reason, sol):\n        if d in SCI:\n            nsci += 1\n            rtxt.append(r if r is not None else \"\")\n            stxt.append(s if s is not None else \"\")\n    for i in range(0, len(rtxt)"]
[239.561397, "o", "cat > /app/count_tokens.py <<'EOF'"]
[239.561547, "i", ", 1000):\n        enc = tok(rtxt[i:i+1000], add_special_tokens=False)\n        for ids in enc[\"input_ids\"]:\n            total += len(ids)\n    for i in range(0, len(stxt), 1000):\n        enc = tok(stxt[i:i+1000], add_special_tokens=False)\n        for ids in enc[\"input_ids\"]:\n            total += len(ids)\n    print(f\"{sh} science_rows={len(rtxt)} running_total={total}\", flush=True)\n    del t, dom, reason, sol, rtxt, stxt\n    os.remove(path)\n\nprint(f\"FINAL total_tokens={total} science_examples={nsci}\", flush=True)\nwith open(\"/app/answer.txt\", \"w\") as f:\n    f.write(str(total))\nEOF\n"]
