[276.696227, "i", "cat > /tmp/wait_ready.py <<'PYEOF'\nimport socket, time, sys\nport=6665; deadline=time.time()+180; last=''\nwhile time.time()<deadline:\n    try:\n        s=socket.create_connection(('127.0.0.1',port),timeout=5)\n        s.settimeout(2.0)\n        buf=b''; t0=time.time()\n        while time.time()-t0<90:\n            try:\n                d=s.recv(4096)\n                if not d: break\n                buf+=d\n                if b'login:' in buf.lower() or b'welcome' in buf.lower():\n                    print('LOGIN_PROMPT_READY'); sys.stdout.flush(); s.close(); sys.exit(0)\n            except socket.timeout:\n                try: s.sendall(b'\\n')\n                except: break\n        print('LAST:',buf[-200:].decode('latin1','replace'))\n        s.close(); sys.exit(0)\n    except Exception as e:\n        time.sleep(2)\nprint('TIMEOUT_NO_CONNECT')\nsys.exit(1)\nPYEOF\n"]
