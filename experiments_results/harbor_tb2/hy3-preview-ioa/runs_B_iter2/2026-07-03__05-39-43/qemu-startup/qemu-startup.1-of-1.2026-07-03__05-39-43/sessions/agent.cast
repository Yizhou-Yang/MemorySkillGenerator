[236.865196, "i", "cat > /tmp/extract.py <<'PYEOF'\nimport struct\nISO='/app/alpine.iso'\nf=open(ISO,'rb')\nSEC=2048\ndef rd(lba,count=1):\n    f.seek(lba*SEC); return f.read(count*SEC)\npvd=None; lba=16\nfor _ in range(200):\n    s=rd(lba)\n    if s[1:6]!=b'CD001': break\n    if s[0]==1: pvd=s; break\n    if s[0]==255: break\n    lba+=1\nassert pvd, 'no PVD'\nroot=pvd[156:190]\ndef name_of(off,data):\n    fi=data[off+32]; name=data[off+33:off+33+fi]\n    rec=data[off]; sysuse=data[off+33+fi:off+rec]\n    i=0\n    while i+4<=len(sysuse):\n        sl=sysuse[i]\n        if sl==0: break\n        if sl+i>len(sysuse): break\n        if sysuse[i+1:i+3]==b'NM':\n            rr=sysuse[i+4:sl]\n            if rr.endswith(b'\\x00'): rr=rr[:-1]\n            return rr.decode('utf-8','replace')\n        i+=sl\n    if name in (b'\\x00',b'\\x01'): return '.' if name==b'\\x00' else '..'\n    if b';' in name: name=name.split(b';')[0]\n    return name.decode('latin1')\ndef parse_dir(lba,length):\n    data=rd(lba,(length+SEC-1)//SEC); "]
[236.866084, "o", "cat > /tmp/extract.py <<'PYEOF'"]
[236.866237, "o", "\r\n"]
[236.866396, "o", "\u001b[?2004l\r"]
[236.866853, "o", "\u001b[?2004h"]
[236.867227, "i", "out=[]; off=0\n    while off<length:\n        rl=data[off]\n        if rl==0:\n            off=(off+SEC)&~(SEC-1); continue\n        e_lba=struct.unpack('<I',data[off+2:off+6])[0]\n        e_size=struct.unpack('<I',data[off+10:off+14])[0]\n        flags=data[off+25]; nm=name_of(off,data)\n        out.append((nm,e_lba,e_size,bool(flags&2))); off+=rl\n    return out\ndef walk(lba,length,path,files):\n    for nm,el,es,isdir in parse_dir(lba,length):\n        if nm in ('.','..'): continue\n        full=(path+'/'+nm) if path else nm\n        if isdir: walk(el,es,full,files)\n        else: files.append((full,el,es))\nfiles=[]\nwalk(struct.unpack('<I',root[2:6])[0],struct.unpack('<I',root[10:14])[0],'',files)\nvl=[x for x in files if 'vmlinuz' in x[0].lower()]\ninr=[x for x in files if 'initramfs' in x[0].lower()]\ndef pick(c):\n    for suf in ('lts','virt'):\n        for x in c:\n            if suf in x[0].lower(): return x\n    return c[0] if c else None\nv=pick(vl); ii=pick(inr)\ndef extract(x,dst):\n    _,lba,size=x; f.seek(lba*SEC); open"]
[236.867483, "i", "(dst,'wb').write(f.read(size)); print('wrote',dst,size)\nif v: extract(v,'/tmp/vmlinuz')\nelse: print('NO VMLINUZ')\nif ii: extract(ii,'/tmp/initramfs')\nelse: print('NO INITRAMFS')\nprint('vmlinuz:',v[0] if v else None)\nprint('initramfs:',ii[0] if ii else None)\nPYEOF\n"]
