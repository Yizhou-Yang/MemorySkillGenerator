[352.158747, "i", "cat > /app/check_cert.py << 'EOF'\n#!/usr/bin/env python3\nimport os\nimport ssl\nimport subprocess\nimport datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\n\ndef main():\n    if not os.path.exists(CERT_PATH):\n        print(\"Certificate not found at \" + CERT_PATH)\n        return\n\n    result = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\", \"-dates\"],\n        capture_output=True, text=True,\n    )\n    if result.returncode != 0:\n        print(\"Failed to load certificate\")\n        print(result.stderr)\n        return\n\n    output = result.stdout\n\n    # Extract Common Name from subject\n    common_name = \"unknown\"\n    for line in output.splitlines():\n        if line.strip().startswith(\"subject=\"):\n            subj = line.split(\"subject=\", 1)[1]\n            for part in subj.split(\",\"):\n                if \"=\" in part:\n                    key, val = part.split(\"=\", 1)\n                    if key.strip() == \"CN\":\n                        common_name = val.strip()\n\n    # Extract expiration date\n    "]
[352.158998, "i", "not_after = \"unknown\"\n    for line in output.splitlines():\n        if line.strip().startswith(\"notAfter=\"):\n            date_str = line.split(\"notAfter=\", 1)[1].strip()\n            try:\n                dt = datetime.datetime.strptime(date_str, \"%b %d %H:%M:%S %Y %Z\")\n                not_after = dt.strftime(\"%Y-%m-%d\")\n            except ValueError:\n                not_after = date_str\n\n    ctx = ssl.create_default_context()\n    print(\"Certificate loaded successfully: \" + CERT_PATH)\n    print(\"Common Name: \" + common_name)\n    print(\"Expiration date: \" + not_after)\n    print(\"Certificate verification successful\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
