[416.189222, "i", "python3 - <<'EOF'\nimport socket\nfor ip in ('192.168.16.1','192.168.16.3'):\n    for port in (2375,2376):\n        s=socket.socket(); s.settimeout(1.5)\n        try:\n            s.connect((ip,port)); print('OPEN',ip,port)\n        except Exception as e:\n            print('closed',ip,port,type(e).__name__)\n        finally:\n            s.close()\nEOF\n"]
