[556.611752, "i", "python3 - <<'EOF'\nimport socket\ndef t(h,p,to=2):\n    s=socket.socket(); s.settimeout(to)\n    try:\n        s.connect((h,p)); return True\n    except Exception: return False\n    finally:\n        try: s.close()\n        except: pass\nfor h,p in [('192.168.16.1',22),('192.168.16.1',2375),('192.168.16.3',22),('192.168.16.3',2376),('192.168.16.3',9001)]:\n    print(h,p,'OPEN' if t(h,p) else 'closed')\nEOF\n"]
[556.612019, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r"]
