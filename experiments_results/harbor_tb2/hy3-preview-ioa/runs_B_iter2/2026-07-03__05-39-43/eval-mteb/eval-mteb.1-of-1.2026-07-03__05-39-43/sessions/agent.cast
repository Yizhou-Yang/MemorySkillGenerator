[191.172374, "i", "cat > /app/run_mteb.py << 'EOF'\nimport os, sys\n\n_orig_statvfs = os.statvfs\ndef _patched_statvfs(path):\n    try:\n        st = _orig_statvfs(path)\n    except Exception:\n        st = None\n    class Fake:\n        f_bsize = 4096\n        f_frsize = 4096\n        f_blocks = 100000000\n        f_bfree = 100000000\n        f_bavail = 100000000\n        f_files = 100000000\n        f_ffree = 100000000\n        f_favail = 100000000\n        f_flag = 0\n        f_namemax = 255\n    return Fake()\nos.statvfs = _patched_statvfs\n\nimport mteb\nmteb.cli.main()\nEOF\n"]
