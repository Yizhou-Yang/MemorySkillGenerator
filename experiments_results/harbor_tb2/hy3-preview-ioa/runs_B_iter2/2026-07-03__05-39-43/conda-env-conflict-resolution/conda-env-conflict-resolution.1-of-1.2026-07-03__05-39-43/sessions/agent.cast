[11.377312, "o", "#!/usr/bin/env python3\r\n\r\ndef test_environment():\r\n    \"\"\"\r\n    Test all the required packages can be successfully imported in the environment.\r\n    This will fail if any dependency issues exist.\r\n    \"\"\"\r\n"]
[11.377394, "o", "    print(\"Testing imports for all required packages...\")\r\n    \r\n    # Test core scientific packages"]
[11.377679, "o", "\r\n"]
[11.378002, "o", "    print(\"Testing numpy...\")"]
[11.378632, "o", "\r\n"]
[11.379069, "o", "    import numpy"]
[11.379339, "o", "\r\n"]
[11.379657, "o", "    print(f\"NumPy version: {numpy.__version__}\")"]
[11.379939, "o", "\r\n"]
[11.380158, "o", "    "]
[11.380353, "o", "\r\n"]
[11.380564, "o", "    print(\"Testing scipy...\")"]
[11.380785, "o", "\r\n"]
[11.380954, "o", "    import scipy"]
[11.381124, "o", "\r\n"]
[11.381292, "o", "    print(f\"SciPy version: {scipy.__version__}\")"]
[11.38155, "o", "\r\n"]
[11.381732, "o", "    "]
[11.381901, "o", "\r\n"]
[11.382068, "o", "    print(\"Testing pandas...\")"]
[11.382242, "o", "\r\n"]
[11.383633, "o", "    import pandas"]
[11.383863, "o", "\r\n"]
[11.38403, "o", "    print(f\"Pandas version: {pandas.__version__}\")"]
[11.384201, "o", "\r\n"]
[11.384365, "o", "    "]
[11.384573, "o", "\r\n"]
[11.385242, "o", "    print(\"Testing scikit-learn...\")"]
[11.389945, "o", "\r\n    import sklearn\r\n    print(f\"Scikit-learn version: {sklearn.__version__}\")\r\n    \r\n    # Test ML frameworks\r\n    print(\"Testing TensorFlow...\")\r\n    import tensorflow as tf\r\n    print(f\"TensorFlow version: {tf.__version__}\")\r\n    \r\n    print(\"Testing PyTorch...\")\r\n    import torch\r\n    print(f\"PyTorch version: {torch.__version__}\")\r\n    \r\n    # Test NLP packages\r\n    print(\"Testing transformers...\")\r\n    import transformers\r\n    print(f\"Transformers version: {transformers.__version__}\")\r\n    \r\n    print(\"All packages imported successfully!\")\r\n\r\nif __name__ == \"__main__\":\r\n    test_environment()"]
