[199.436655, "o", "\r\n"]
[199.436851, "o", "\r\n"]
[199.437039, "o", "def predict(trainer, predict_dataset=None):"]
[199.437228, "o", "\r\n"]
[199.437445, "o", "    if predict_dataset is None:"]
[199.437651, "o", "\r\n"]
[199.437849, "o", "        logger.info(\"No dataset is available for testing\")"]
[199.438035, "o", "\r\n"]
[199.438227, "o", "\r\n"]
[199.438424, "o", "    elif isinstance(predict_dataset, dict):"]
[199.438624, "o", "\r\n"]
[199.438807, "o", "        "]
[199.438985, "o", "\r\n"]
[199.439164, "o", "        for dataset_name, d in predict_dataset.items():"]
[199.439362, "o", "\r\n"]
[199.439561, "o", "            logger.info(\"*** Predict: %s ***\" % dataset_name)"]
[199.439743, "o", "\r\n"]
[199.439921, "o", "            predictions, labels, metrics = trainer.predict(d, metric_key_prefix=\"predict\")"]
[199.440102, "o", "\r\n"]
[199.440281, "o", "            predictions = np.argmax(predictions, axis=2)"]
[199.440494, "o", "\r\n"]
[199.440675, "o", "\r\n"]
[199.440855, "o", "            trainer.log_metrics(\"predict\", metrics)"]
[199.441032, "o", "\r\n"]
[199.44121, "o", "            trainer.save_metrics(\"predict\", metrics)"]
[199.441406, "o", "\r\n"]
[199.441611, "o", "\r\n"]
[199.441791, "o", "    else:"]
[199.441967, "o", "\r\n"]
[199.442146, "o", "        logger.info(\"*** Predict ***\")"]
[199.442336, "o", "\r\n"]
[199.442532, "o", "        predictions, labels, metrics = trainer.predict(predict_dataset, metric_key_prefix=\"predict\")"]
[199.442713, "o", "\r\n"]
[199.442892, "o", "        predictions = np.argmax(predictions, axis=2)"]
[199.443075, "o", "\r\n"]
[199.443254, "o", "\r\n"]
[199.445469, "o", "        trainer.log_metrics(\"predict\", metrics)"]
[199.445768, "o", "\r\n"]
[199.445895, "o", "        trainer.save_metrics(\"predict\", metrics)"]
