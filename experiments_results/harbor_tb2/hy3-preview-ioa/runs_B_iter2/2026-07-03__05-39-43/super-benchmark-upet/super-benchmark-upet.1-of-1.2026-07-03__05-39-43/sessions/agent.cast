[1552.610801, "i", "cat > /app/UPET/run_wrapped.py << 'PYEOF'\nimport shutil, os\nfrom collections import namedtuple\n\n# The container overlay reports 0 free blocks via statvfs even though writes\n# succeed. This breaks datasets/huggingface_hub disk-space pre-checks.\n# Patch them to report ample free space.\n_RealDiskUsage = shutil.disk_usage\n_DiskUsage = namedtuple('usage', ['total', 'used', 'free'])\ndef _patched_disk_usage(path):\n    u = _RealDiskUsage(path)\n    return _DiskUsage(u.total, u.used, u.total)\nshutil.disk_usage = _patched_disk_usage\n\n_RealStatvfs = os.statvfs\ndef _patched_statvfs(path):\n    st = _RealStatvfs(path)\n    big = 10 ** 12\n    return os.statvfs_result((st.f_bsize, st.f_frsize, big, big, big,\n                              st.f_files, st.f_ffree, st.f_favail,\n                              st.f_flag, st.f_namemax))\nos.statvfs = _patched_statvfs\n\nwith open('/app/UPET/run.py') as f:\n    src = f.read()\ng = {'__name__': '__main__', '__file__': '/app/UPET/run.py',\n     '"]
[1552.611133, "i", "__builtins__': __builtins__}\nexec(compile(src, '/app/UPET/run.py', 'exec'), g)\nPYEOF\necho done\n"]
[1552.612881, "o", "cat > /app/UPET/run_wrapped.py << 'PYEOF'\r\n"]
[1552.61535, "o", "\u001b[?2004l\r"]
[1552.615694, "o", "\u001b[?2004h> import shutil, os\r\n\u001b[?2004l\r\u001b[?2004h> from collections import namedtuple\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # The container overlay reports 0 free blocks via statvfs even though writes\r\n\u001b[?2004l\r\u001b[?2004h> # succeed. This breaks datasets/huggingface_hub disk-space pre-checks.\r\n\u001b[?2004l\r\u001b[?2004h> # Patch them to report ample free space.\r\n\u001b[?2004l\r\u001b[?2004h> _RealDiskUsage = shutil.disk_usage\r\n\u001b[?2004l\r\u001b[?2004h> _DiskUsage = namedtuple('usage', ['total', 'used', 'free'])\r\n\u001b[?2004l\r\u001b[?2004h> def _patched_disk_usage(path):\r\n\u001b[?2004l\r\u001b[?2004h>     u = _RealDiskUsage(path)\r\n\u001b[?2004l\r"]
