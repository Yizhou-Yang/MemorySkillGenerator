[208.694172, "o", "\u001b[?2004hroot@434cafda0b0a:/app# "]
[208.867171, "i", "cat > /app/reshard.py << 'PYEOF'\n#!/usr/bin/env python3\n'''reshard.py\n\nPrepare c4_sample/ for upload:\n  * at most 30 files per folder\n  * at most 15MB per file\n\nFiles are moved into c4_reshard/<bucket>/ (<=30 files per bucket). Any file\nlarger than 15MB is split into <=15MB chunks. A manifest.json records how to\nreconstruct each original file so revert.py can restore c4_sample/ exactly.\n'''\nimport json\nimport os\nimport shutil\n\nSAMPLE = '/app/c4_sample'\nRESHARD = '/app/c4_reshard'\nMAX_FILES = 30\nMAX_SIZE = 15 * 1024 * 1024\n\n\ndef main():\n    if os.path.exists(RESHARD):\n        shutil.rmtree(RESHARD)\n    os.makedirs(RESHARD)\n\n    files = sorted(\n        name for name in os.listdir(SAMPLE)\n        if os.path.isfile(os.path.join(SAMPLE, name))\n    )\n\n    manifest = []\n    bucket_idx = 0\n    count = 0\n\n    def new_bucket():\n        nonlocal bucket_idx, count\n        bucket_idx += 1\n        count = 0\n        os.makedirs(os.path.join(RESHARD, '%03d' % bucket_idx), exist_ok=True)\n\n    os.makedirs(os.path.join(RESHARD, '000'), exist_ok=True)\n\n    for name in files:\n        src = os.path.join(SAMPLE, name)\n        size = os.path.getsize(src)\n        parts = []\n        if size <= MAX_SIZE:\n            if count >= MAX_FILES:\n                new_bucket()\n            dst = os.path.join(RESHARD, '%03d' % bucket_idx, name)\n            shutil.move(src, dst)\n            parts.append('%03d/%s' % (bucket_idx, name))\n            count += 1\n        else:\n            with open(src, 'rb') as f:\n                part = 0\n                while True:\n                    chunk = f.read(MAX_SIZE)\n                    if not chunk:\n                        break\n                    if count >= MAX_FILES:\n                        new_bucket()\n                    chunkname = '%s.part%03d' % (name, part)\n                    dst = os.path.join(RESHARD, '%03d' % bucket_idx, chunkname)\n                    with open(dst, 'wb') as out:\n                        out.write(chunk)\n                    parts.append('%03d/%s' % (bucket_idx, chunkname))\n                    count += 1\n                    part += 1\n            os.remove(src)\n        manifest.append({'orig': name, 'parts': parts})\n\n    with open(os.path.join(RESHARD, 'manifest.json'), 'w') as f:\n        json.dump(manifest, f)\n\n    print('done: %d files -> %d buckets' % (len(files), bucket_idx + 1))\n\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
[208.867806, "o", "cat > /app/reshard.py << 'PYEOF'\r\n\u001b[?2004l\r"]
