[208.873994, "o", "\u001b[?2004h>     os.makedirs(os.path.join(RESHARD, '000'), exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[208.874021, "o", "> \r\n"]
[208.874367, "o", "\u001b[?2004l\r"]
[208.874896, "o", "\u001b[?2004h"]
[208.875051, "o", "> "]
[208.875241, "o", "    for name in files:\r\n\u001b[?2004l\r"]
[208.87527, "o", "\u001b[?2004h"]
[208.875446, "o", "> "]
[208.875649, "o", "        src = os.path.join(SAMPLE, name)\r\n\u001b[?2004l\r"]
[208.87577, "o", "\u001b[?2004h> "]
[208.876068, "o", "        size = os.path.getsize(src)\r\n\u001b[?2004l\r\u001b[?2004h>         parts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.876148, "o", "        if size <= MAX_SIZE:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.877658, "o", "            if count >= MAX_FILES:\r\n\u001b[?2004l\r\u001b[?2004h>                 new_bucket()\r\n\u001b[?2004l\r\u001b[?2004h>             dst = os.path.join(RESHARD, '%03d' % bucket_idx, name)\r\n\u001b[?2004l\r\u001b[?2004h>             shutil.move(src, dst)\r\n\u001b[?2004l\r\u001b[?2004h>             parts.append('%03d/%s' % (bucket_idx, name))\r\n\u001b[?2004l\r\u001b[?2004h>             count += 1\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             with open(src, 'rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>                 part = 0\r\n\u001b[?2004l\r\u001b[?2004h>                 while True:\r\n\u001b[?2004l\r\u001b[?2004h>                     chunk = f.read(MAX_SIZE)\r\n\u001b[?2004l\r\u001b[?2004h>                     if not chunk:\r\n\u001b[?2004l\r"]
[208.877764, "o", "\u001b[?2004h>                         break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.877794, "o", "                    if count >= MAX_FILES:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.877929, "o", "                        new_bucket()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.8781, "o", "                    chunkname = '%s.part%03d' % (name, part)\r\n\u001b[?2004l\r"]
[208.878162, "o", "\u001b[?2004h> "]
[208.878347, "o", "                    dst = os.path.join(RESHARD, '%03d' % bucket_idx, chunkname)\r\n\u001b[?2004l\r"]
[208.878493, "o", "\u001b[?2004h> "]
[208.878607, "o", "                    with open(dst, 'wb') as out:\r\n\u001b[?2004l\r\u001b[?2004h"]
[208.878788, "o", ">                         out.write(chunk)"]
[208.878954, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.879125, "o", "                    parts.append('%03d/%s' % (bucket_idx, chunkname))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.879297, "o", "                    count += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.879373, "o", "                    part += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.879413, "o", "            os.remove(src)\r\n\u001b[?2004l\r\u001b[?2004h"]
[208.879468, "o", "> "]
[208.879562, "o", "        manifest.append({'orig': name, 'parts': parts})\r\n\u001b[?2004l\r"]
[208.879578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.879591, "o", "\u001b[?2004h"]
[208.879654, "o", "> "]
[208.879786, "o", "    with open(os.path.join(RESHARD, 'manifest.json'), 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.88001, "o", "        json.dump(manifest, f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[208.880128, "o", "    print('done: %d files -> %d buckets' % (len(files), bucket_idx + 1))\r\n\u001b[?2004l\r"]
[208.880185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[208.880225, "o", "\u001b[?2004h> "]
[208.880272, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[208.880333, "o", "\u001b[?2004h> "]
[208.880347, "o", "    main()"]
