[208.679207, "i", "cat > /app/revert.py << 'PYEOF'\n#!/usr/bin/env python3\n'''revert.py\n\nRestore c4_sample/ from c4_reshard/.\n\nc4_reshard/ was produced by moving the files from c4_sample/ into bucket\nsubdirectories (at most 30 files per bucket), optionally splitting any file\nlarger than 15MB into chunks. This script moves them all back and removes the\nnow-empty c4_reshard/ tree, restoring c4_sample/ exactly as it was originally.\n'''\nimport json\nimport os\nimport shutil\n\nSAMPLE = '/app/c4_sample'\nRESHARD = '/app/c4_reshard'\nMANIFEST = os.path.join(RESHARD, 'manifest.json')\n\n\ndef main():\n    if not os.path.exists(MANIFEST):\n        raise SystemExit('manifest not found: ' + MANIFEST)\n    with open(MANIFEST) as f:\n        manifest = json.load(f)\n\n    os.makedirs(SAMPLE, exist_ok=True)\n\n    for entry in manifest:\n        orig = entry['orig']\n        parts = entry['parts']\n        dst = os.path.join(SAMPLE, orig)\n        if len(parts) == 1:\n            shutil.move(os.path.join(RESHARD, parts[0]), dst)\n        else:\n            with open(dst, 'wb') as out:\n                for rel in parts:\n                    src = os.path.join(RESHARD, rel)\n                    with open(src, 'rb') as inp:\n                        shutil.copyfileobj(inp, out)\n                    os.remove(src)\n\n    shutil.rmtree(RESHARD)\n\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
[208.679564, "o", "cat > /app/revert.py << 'PYEOF'"]
