[45.555835, "i", "cat > /workspace/plus_comm.v << 'EOF'\nRequire Import Arith.\n\nTheorem plus_comm : forall n m : nat,\n  n + m = m + n.\nProof.\n  intros n m.\n  induction n as [| n' IHn'].\n  - rewrite plus_O_n.\n    rewrite <- plus_n_O.\n    reflexivity.\n  - simpl.\n    rewrite plus_n_Sm.\n    rewrite IHn'.\n    reflexivity.\nQed.\nEOF\n"]
