[9.522473, "o", "Theorem plus_comm : forall n m : nat,"]
[9.522677, "o", "\r\n"]
[9.52289, "o", "  n + m = m + n."]
[9.523138, "o", "\r\n"]
[9.523367, "o", "Proof."]
[9.523572, "o", "\r\n"]
[9.523782, "o", "  intros n m."]
[9.524011, "o", "\r\n"]
[9.524231, "o", "  induction n as [|n' IHn']."]
[9.524452, "o", "\r\n"]
