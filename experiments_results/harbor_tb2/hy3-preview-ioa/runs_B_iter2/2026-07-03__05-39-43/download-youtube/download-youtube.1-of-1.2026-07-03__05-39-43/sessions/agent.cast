[672.516635, "i", "cat > /tmp/getdeno.py << 'EOF'\nimport urllib.request, json, zipfile, os, sys\nsys.stdout.reconfigure(encoding='utf-8')\napi='https://api.github.com/repos/denoland/deno/releases/latest'\nreq=urllib.request.Request(api, headers={'User-Agent':'Mozilla/5.0'})\ntag=json.load(urllib.request.urlopen(req, timeout=30))['tag_name']\nprint('tag', tag)\nurl=f'https://github.com/denoland/deno/releases/download/{tag}/deno-x86_64-unknown-linux-gnu.zip'\nprint('dl', url)\ndata=urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'}), timeout=120).read()\nopen('/tmp/deno.zip','wb').write(data)\nprint('size', len(data))\nz=zipfile.ZipFile('/tmp/deno.zip')\nz.extractall('/tmp/deno_x')\nb= '/tmp/deno_x/deno'\nos.chmod(b, 0o755)\nimport shutil\nshutil.move(b, '/usr/local/bin/deno')\nprint('done')\nEOF\npython3 /tmp/getdeno.py\n"]
