[522.220857, "i", "ot isinstance(ix, dict):\n                continue\n            if ix.get(\"program\") != \"spl-token\":\n                continue\n            parsed = ix.get(\"parsed\")\n            if not isinstance(parsed, dict):\n                continue\n            typ = parsed.get(\"type\")\n            if typ not in (\"transfer\", \"transferChecked\"):\n                continue\n            info = parsed.get(\"info\", {}) or {}\n            src = info.get(\"source\")\n            mint = info.get(\"mint\")\n            amt = info.get(\"amount\") or (info.get(\"tokenAmount\") or {}).get(\"amount\")\n            try:\n                amt_v = int(amt)\n            except (TypeError, ValueError):\n                amt_v = amt\n            out.append({\"account\": src, \"mint\": mint, \"amount\": amt_v})\n    return out\n\n\ndef account_summary(acc):\n    return {\n        \"executable\": bool(acc.get(\"executable\")),\n        \"lamports\": acc.get(\"lamports\"),\n        \"owner\": acc.get(\"owner\"),\n        \"rent_epoch\": acc.get(\"rentEpoch\"),\n    }\n\n\nclass Handler(BaseHTTPRequestHandle"]
[522.220912, "i", "r):\n    def _send(self, code, obj):\n        body = json.dumps(obj).encode()\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _send_ok(self, obj):\n        self._send(200, obj)\n\n    def _send_err(self, obj):\n        self._send(200, obj)\n\n    def _send_404(self, obj):\n        self._send(404, obj)\n\n    def log_message(self, *args):\n        pass\n\n    def do_GET(self):\n        try:\n            self.handle_route()\n        except Exception as e:\n            self._send_err({\"error\": str(e)})\n\n    def handle_route(self):\n        parsed = urlparse(self.path)\n        parts = [p for p in parsed.path.split(\"/\") if p != \"\"]\n        if not parts:\n            return self._send_err({\"error\": \"unknown endpoint\"})\n        head = parts[0]\n\n        if head == \"status\":\n            return self.route_status()\n        if head == \"block\" and len(parts) == 2:\n        "]
[522.220955, "i", "    return self.route_block(parts[1])\n        if head == \"transaction\" and len(parts) == 2:\n            return self.route_transaction(parts[1])\n        if head == \"account\" and len(parts) == 2:\n            return self.route_account(parts[1])\n        if head == \"program\" and len(parts) == 3 and parts[2] == \"accounts\":\n            return self.route_program(parts[1], parsed)\n        return self._send_err({\"error\": \"unknown endpoint: %s\" % self.path})\n\n    def route_status(self):\n        try:\n            url = _rpc_cache.get(\"url\") or list(candidate_urls()).__next__()\n        except Exception:\n            url = \"https://api.mainnet-beta.solana.com\"\n        network = _network_for(url)\n        try:\n            slot = rpc_call(\"getSlot\", [])\n        except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        version = \"unknown\"\n        try:\n            v = rpc_call(\"getVersion\", [])\n            version = v.get(\"solana-core\", \"unknown\") if isinstance(v, dict) else \"unknown\"\n        except Exce"]
[522.220977, "i", "ption:\n            pass\n        node_count = 0\n        try:\n            nodes = rpc_call(\"getClusterNodes\", [])\n            node_count = len(nodes) if isinstance(nodes, list) else 0\n        except Exception:\n            pass\n        self._send_ok({\n            \"status\": \"online\",\n            \"network\": network,\n            \"current_slot\": slot,\n            \"node_count\": node_count,\n            \"version\": version,\n        })\n\n    def route_block(self, slot):\n        try:\n            blk = get_block(slot)\n        except RPCError as e:\n            return self._send_404({\"error\": \"block not found: %s\" % str(e)})\n        except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        if blk is None:\n            return self._send_404({\"error\": \"block not found for slot %s\" % slot})\n        self._send_ok({\n            \"blockhash\": blk.get(\"blockhash\"),\n            \"parent_slot\": blk.get(\"parentSlot\"),\n            \"previous_blockhash\": blk.get(\"previousBlockhash\"),\n            \"block_height\": blk."]
[522.221032, "i", "get(\"blockHeight\"),\n            \"block_time\": blk.get(\"blockTime\"),\n        })\n\n    def route_transaction(self, sig):\n        try:\n            tx = get_tx(sig)\n        except RPCError as e:\n            return self._send_404({\"error\": \"transaction not found: %s\" % str(e)})\n        except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        if tx is None:\n            return self._send_404({\"error\": \"transaction not found: %s\" % sig})\n        meta = tx.get(\"meta\") or {}\n        self._send_ok({\n            \"signature\": sig,\n            \"slot\": tx.get(\"slot\"),\n            \"block_time\": (tx.get(\"blockTime\") if tx.get(\"blockTime\") is not None else meta.get(\"blockTime\")),\n            \"success\": (meta.get(\"err\") is None) if isinstance(meta, dict) else None,\n            \"fee\": meta.get(\"fee\"),\n            \"token_transfers\": extract_token_transfers(tx),\n        })\n\n    def route_account(self, address):\n        try:\n            res = rpc_call(\"getAccountInfo\", [address, {\"encoding\": \"jsonParsed\"}]"]
[522.221062, "i", ")\n        except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        info = (res or {}).get(\"value\")\n        if info is None:\n            return self._send_err({\"error\": \"account not found: %s\" % address})\n        self._send_ok({\n            \"address\": address,\n            \"executable\": bool(info.get(\"executable\")),\n            \"lamports\": info.get(\"lamports\"),\n            \"owner\": info.get(\"owner\"),\n            \"rent_epoch\": info.get(\"rentEpoch\"),\n        })\n\n    def route_program(self, program_id, parsed):\n        qs = parse_qs(parsed.query)\n        try:\n            limit = int(qs.get(\"limit\", [\"10\"])[0])\n        except Exception:\n            limit = 10\n        try:\n            offset = int(qs.get(\"offset\", [\"0\"])[0])\n        except Exception:\n            offset = 0\n        if limit < 0:\n            limit = 10\n        if offset < 0:\n            offset = 0\n        try:\n            all_accts = rpc_call(\n                \"getProgramAccounts\",\n                [\n                    progra"]
[522.221091, "i", "m_id,\n                    {\n                        \"encoding\": \"base64\",\n                        \"dataSlice\": {\"offset\": 0, \"length\": 0},\n                        \"limit\": 100000,\n                    },\n                ],\n            ) or []\n        except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        total = len(all_accts)\n        page = all_accts[offset : offset + limit]\n        accounts = []\n        for a in page:\n            acc = a.get(\"account\", {}) or {}\n            accounts.append({\n                \"pubkey\": a.get(\"pubkey\"),\n                \"account\": account_summary(acc),\n            })\n        self._send_ok({\n            \"program_id\": program_id,\n            \"total_accounts\": total,\n            \"limit\": limit,\n            \"offset\": offset,\n            \"accounts\": accounts,\n        })\n\n\ndef main():\n    port = int(os.environ.get(\"PORT\", \"5000\"))\n    server = ThreadingHTTPServer((\"0.0.0.0\", port), Handler)\n    print(\"serving on 0.0.0.0:%d\" % port, flush=True)\n    server.s"]
