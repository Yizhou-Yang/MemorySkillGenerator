[620.450978, "i", "python3 - <<'EOF'\nimport urllib.request, json\ndef get(path):\n    try:\n        r=urllib.request.urlopen('http://127.0.0.1:5000'+path, timeout=20)\n        return r.status, r.read().decode()\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode()\n    except Exception as e:\n        return 'CONN', repr(e)[:100]\nfor p in ['/status','/block/999999999','/transaction/abc','/account/11111111111111111111111111111111','/program/Vote111111111111111111111111111111111111111/accounts?limit=2&offset=0']:\n    code,body=get(p)\n    print('PATH',p)\n    print('CODE',code)\n    try:\n        print('JSON', json.dumps(json.loads(body))[:300])\n    except Exception as e:\n        print('RAW', body[:200])\n    print('-'*40)\nEOF\n"]
[620.451187, "o", "python3 - <<'EOF'"]
