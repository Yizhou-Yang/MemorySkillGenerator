[599.418058, "i", "ransaction\" and len(parts) == 2:\n            return self.route_transaction(parts[1])\n        if head == \"account\" and len(parts) == 2:\n            return self.route_account(parts[1])\n        if head == \"program\" and len(parts) == 3 and parts[2] == \"accounts\":\n            return self.route_program(parts[1], parsed)\n        return self._send_err({\"error\": \"unknown endpoint: %s\" % self.path})\n\n    def route_status(self):\n        try:\n            url = _rpc_cache.get(\"url\") or list(candidate_urls()).__next__()\n        except Exception:\n            url = \"https://api.mainnet-beta.solana.com\"\n        network = _network_for(url)\n        try:\n            slot = rpc_call(\"getSlot\", [])\n        except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        version = \"unknown\"\n        try:\n            v = rpc_call(\"getVersion\", [])\n            version = v.get(\"solana-core\", \"unknown\") if isinstance(v, dict) else \"unknown\"\n        except Exception:\n            pass\n        node_count = 0\n        try:"]
[599.418122, "o", "#!/usr/bin/env python3\r\n"]
[599.418137, "i", "\n            nodes = rpc_call(\"getClusterNodes\", [])\n            node_count = len(nodes) if isinstance(nodes, list) else 0\n        except Exception:\n            pass\n        self._send_ok({\n            \"status\": \"online\",\n            \"network\": network,\n            \"current_slot\": slot,\n            \"node_count\": node_count,\n            \"version\": version,\n        })\n\n    def route_block(self, slot):\n        try:\n            blk = get_block(slot)\n        except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        if blk is None:\n            return self._send_404({\"error\": \"block not found for slot %s\" % slot})\n        self._send_ok({\n            \"blockhash\": blk.get(\"blockhash\"),\n            \"parent_slot\": blk.get(\"parentSlot\"),\n            \"previous_blockhash\": blk.get(\"previousBlockhash\"),\n            \"block_height\": blk.get(\"blockHeight\"),\n            \"block_time\": blk.get(\"blockTime\"),\n        })\n\n    def route_transaction(self, sig):\n        try:\n            tx = get_tx(sig)\n      "]
