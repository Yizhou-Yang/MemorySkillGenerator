[599.418157, "i", "  except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        if tx is None:\n            return self._send_404({\"error\": \"transaction not found: %s\" % sig})\n        meta = tx.get(\"meta\") or {}\n        self._send_ok({\n            \"signature\": sig,\n            \"slot\": tx.get(\"slot\"),\n            \"block_time\": tx.get(\"blockTime\") if tx.get(\"blockTime\") is not None else meta.get(\"blockTime\"),\n            \"success\": (meta.get(\"err\") is None) if isinstance(meta, dict) else None,\n            \"fee\": meta.get(\"fee\"),\n            \"token_transfers\": extract_token_transfers(tx),\n        })\n\n    def route_account(self, address):\n        try:\n            res = rpc_call(\"getAccountInfo\", [address, {\"encoding\": \"jsonParsed\"}])\n        except Exception as e:\n            return self._send_err({\"error\": str(e)})\n        info = (res or {}).get(\"value\")\n        if info is None:\n            return self._send_err({\"error\": \"account not found: %s\" % address})\n        self._send_ok({\n            \"address\": add"]
[599.418169, "i", "ress,\n            \"executable\": bool(info.get(\"executable\")),\n            \"lamports\": info.get(\"lamports\"),\n            \"owner\": info.get(\"owner\"),\n            \"rent_epoch\": info.get(\"rentEpoch\"),\n        })\n\n    def route_program(self, program_id, parsed):\n        qs = parse_qs(parsed.query)\n        try:\n            limit = int(qs.get(\"limit\", [\"10\"])[0])\n        except Exception:\n            limit = 10\n        try:\n            offset = int(qs.get(\"offset\", [\"0\"])[0])\n        except Exception:\n            offset = 0\n        if limit < 0:\n            limit = 10\n        if offset < 0:\n            offset = 0\n        try:\n            all_accts = rpc_call(\n                \"getProgramAccounts\",\n                [\n                    program_id,\n                    {\n                        \"encoding\": \"base64\",\n                        \"dataSlice\": {\"offset\": 0, \"length\": 0},\n                        \"limit\": 100000,\n                    },\n                ],\n            ) or []\n        except Exception as e:\n        "]
[599.418275, "o", "\u001b[?2004h"]
[599.418304, "i", "    return self._send_err({\"error\": str(e)})\n        total = len(all_accts)\n        page = all_accts[offset : offset + limit]\n        accounts = []\n        for a in page:\n            acc = a.get(\"account\", {}) or {}\n            accounts.append({\n                \"pubkey\": a.get(\"pubkey\"),\n                \"account\": account_summary(acc),\n            })\n        self._send_ok({\n            \"program_id\": program_id,\n            \"total_accounts\": total,\n            \"limit\": limit,\n            \"offset\": offset,\n            \"accounts\": accounts,\n        })\n\n\ndef main():\n    port = int(os.environ.get(\"PORT\", \"5000\"))\n    server = ThreadingHTTPServer((\"0.0.0.0\", port), Handler)\n    print(\"serving on 0.0.0.0:%d\" % port, flush=True)\n    server.serve_forever()\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
