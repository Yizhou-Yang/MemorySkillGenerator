[522.203491, "i", "cat > /app/server.py <<'PYEOF'\n#!/usr/bin/env python3\nimport json\nimport os\nimport sys\nimport time\nimport urllib.request\nimport urllib.error\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nDEFAULT_RPCS = [\n    \"https://api.mainnet-beta.solana.com\",\n    \"https://solana-mainnet.public.blastapi.io\",\n    \"https://ssc-dao.genesysgo.net\",\n    \"https://rpc.ankr.com/solana\",\n    \"https://mainnet.helius-rpc.com\",\n]\n\nNETWORK_BY_URL = {\n    \"devnet\": \"devnet\",\n    \"testnet\": \"testnet\",\n    \"mainnet\": \"mainnet-beta\",\n}\n\n\nclass RPCError(Exception):\n    pass\n\n\n_rpc_cache = {\"url\": None}\n\n\ndef candidate_urls():\n    env = os.environ.get(\"SOLANA_RPC\", \"\").strip()\n    if env:\n        yield env\n    for u in DEFAULT_RPCS:\n        yield u\n\n\ndef _network_for(url):\n    low = url.lower()\n    for key, val in NETWORK_BY_URL.items():\n        if key in low:\n            return val\n    return \"mainnet-beta\"\n\n\ndef _post(url, pay"]
