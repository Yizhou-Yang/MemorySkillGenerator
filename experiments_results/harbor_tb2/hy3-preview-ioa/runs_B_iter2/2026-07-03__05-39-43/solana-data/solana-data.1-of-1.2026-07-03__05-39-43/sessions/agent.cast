[599.417755, "i", "cat > /app/server.py <<'PYEOF'\n#!/usr/bin/env python3\nimport json\nimport os\nimport time\nimport urllib.request\nimport urllib.error\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nDEFAULT_RPCS = [\n    \"https://api.mainnet-beta.solana.com\",\n    \"https://api.devnet.solana.com\",\n    \"https://api.testnet.solana.com\",\n    \"https://solana-mainnet.public.blastapi.io\",\n    \"https://ssc-dao.genesysgo.net\",\n    \"https://rpc.ankr.com/solana\",\n    \"https://mainnet.helius-rpc.com\",\n]\n\nNETWORK_BY_URL = {\n    \"devnet\": \"devnet\",\n    \"testnet\": \"testnet\",\n    \"mainnet\": \"mainnet-beta\",\n}\n\n\nclass RPCError(Exception):\n    pass\n\n\n_rpc_cache = {\"url\": None}\n\n\ndef candidate_urls():\n    env = os.environ.get(\"SOLANA_RPC\", \"\").strip()\n    if env:\n        yield env\n    for u in DEFAULT_RPCS:\n        yield u\n\n\ndef _network_for(url):\n    low = url.lower()\n    for key, val in NETWORK_BY_URL.items():\n        if key in low:\n            return val\n    return \"mainnet-beta\"\n\n\nde"]
[599.417828, "i", "f _post(url, payload):\n    data = json.dumps(payload).encode()\n    req = urllib.request.Request(\n        url, data=data, headers={\"Content-Type\": \"application/json\"}\n    )\n    with urllib.request.urlopen(req, timeout=8) as resp:\n        return json.loads(resp.read().decode())\n\n\ndef rpc_call(method, params=None, max_retry=1):\n    params = params if params is not None else []\n    last_err = None\n    urls = list(candidate_urls())\n    preferred = _rpc_cache.get(\"url\")\n    if preferred and preferred in urls:\n        urls.remove(preferred)\n        urls.insert(0, preferred)\n    for url in urls:\n        for attempt in range(max_retry):\n            try:\n                res = _post(\n                    url,\n                    {\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": method, \"params\": params},\n                )\n                if \"error\" in res and res.get(\"error\") is not None:\n                    raise RPCError(json.dumps(res[\"error\"]))\n                _rpc_cache[\"url\"] = url\n                return res.get(\"result\")\n    "]
[599.417837, "i", "        except RPCError:\n                raise\n            except Exception as e:\n                last_err = e\n                time.sleep(0.2)\n                continue\n    raise RPCError(\"%s: %s\" % (method, last_err or \"no endpoint reachable\"))\n\n\ndef get_block(slot):\n    return rpc_call(\n        \"getBlock\",\n        [int(slot), {\"encoding\": \"jsonParsed\", \"maxSupportedTransactionVersion\": 0}],\n    )\n\n\ndef get_tx(sig):\n    return rpc_call(\n        \"getTransaction\",\n        [sig, {\"encoding\": \"jsonParsed\", \"maxSupportedTransactionVersion\": 0}],\n    )\n\n\ndef extract_token_transfers(tx):\n    out = []\n    if not isinstance(tx, dict):\n        return out\n    msg = (tx.get(\"transaction\") or {}).get(\"message\", {}) or {}\n    ix_lists = [msg.get(\"instructions\", [])]\n    for inner in tx.get(\"meta\", {}).get(\"innerInstructions\", []) or []:\n        ix_lists.append(inner.get(\"instructions\", []) or [])\n    for ixs in ix_lists:\n        for ix in ixs or []:\n            if not isinstance(ix, dict):\n                continue\n        "]
[599.41785, "i", "    if ix.get(\"program\") != \"spl-token\":\n                continue\n            parsed = ix.get(\"parsed\")\n            if not isinstance(parsed, dict):\n                continue\n            typ = parsed.get(\"type\")\n            if typ not in (\"transfer\", \"transferChecked\"):\n                continue\n            info = parsed.get(\"info\", {}) or {}\n            src = info.get(\"source\")\n            mint = info.get(\"mint\")\n            amt = info.get(\"amount\") or (info.get(\"tokenAmount\") or {}).get(\"amount\")\n            try:\n                amt_v = int(amt)\n            except (TypeError, ValueError):\n                amt_v = amt\n            out.append({\"account\": src, \"mint\": mint, \"amount\": amt_v})\n    return out\n\n\ndef account_summary(acc):\n    return {\n        \"executable\": bool(acc.get(\"executable\")),\n        \"lamports\": acc.get(\"lamports\"),\n        \"owner\": acc.get(\"owner\"),\n        \"rent_epoch\": acc.get(\"rentEpoch\"),\n    }\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def _send(self, code, obj):\n        body = json.du"]
[599.418034, "i", "mps(obj).encode()\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _send_ok(self, obj):\n        self._send(200, obj)\n\n    def _send_err(self, obj):\n        self._send(200, obj)\n\n    def _send_404(self, obj):\n        self._send(404, obj)\n\n    def log_message(self, *args):\n        pass\n\n    def do_GET(self):\n        try:\n            self.handle_route()\n        except Exception as e:\n            self._send_err({\"error\": str(e)})\n\n    def handle_route(self):\n        parsed = urlparse(self.path)\n        parts = [p for p in parsed.path.split(\"/\") if p != \"\"]\n        if not parts:\n            return self._send_err({\"error\": \"unknown endpoint\"})\n        head = parts[0]\n        if head == \"status\":\n            return self.route_status()\n        if head == \"block\" and len(parts) == 2:\n            return self.route_block(parts[1])\n        if head == \"t"]
