[123.042629, "i", "python3 - <<'EOF'\nimport urllib.request, json\nfor url in ['https://api.devnet.solana.com','https://api.testnet.solana.com','https://api.mainnet-beta.solana.com']:\n    try:\n        req=urllib.request.Request(url, data=json.dumps({'jsonrpc':'2.0','id':1,'method':'getHealth','params':[]}).encode(), headers={'Content-Type':'application/json'})\n        r=urllib.request.urlopen(req, timeout=8)\n        print(url, r.status, r.read().decode()[:80])\n    except Exception as e:\n        print(url, 'ERR', repr(e)[:120])\nEOF\n"]
