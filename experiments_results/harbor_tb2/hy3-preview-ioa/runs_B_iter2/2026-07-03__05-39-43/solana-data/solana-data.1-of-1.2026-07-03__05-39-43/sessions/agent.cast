[300.118504, "i", "python3 - <<'EOF'\nimport urllib.request, json\nURL='https://mainnet.helius-rpc.com'\ndef call(method, params=None):\n    data=json.dumps({'jsonrpc':'2.0','id':1,'method':method,'params':params or []}).encode()\n    req=urllib.request.Request(URL, data=data, headers={'Content-Type':'application/json'})\n    r=urllib.request.urlopen(req, timeout=15)\n    return json.loads(r.read())\nfor m,p in [('getSlot',[]),('getVersion',[]),('getClusterNodes',[]),('getBlock',[313635500]),('getAccountInfo',['11111111111111111111111111111111',{'encoding':'jsonParsed'}])]:\n    try:\n        res=call(m,p)\n        print('===',m)\n        print(json.dumps(res, indent=1)[:500])\n    except Exception as e:\n        print(m,'ERR',repr(e)[:120])\nEOF\n"]
[300.120363, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.request, json\r\n\u001b[?2004l\r\u001b[?2004h> URL='https://mainnet.helius-rpc.com'\r\n\u001b[?2004l\r\u001b[?2004h> def call(method, params=None):\r\n\u001b[?2004l\r\u001b[?2004h>     data=json.dumps({'jsonrpc':'2.0','id':1,'method':method,'params':params or []}).encode()\r\n\u001b[?2004l\r\u001b[?2004h>     req=urllib.request.Request(URL, data=data, headers={'Content-Type':'application/json'})\r\n\u001b[?2004l\r\u001b[?2004h>     r=urllib.request.urlopen(req, timeout=15)"]
[300.120586, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[300.120716, "o", ">     return json.loads(r.read())"]
