[234.410906, "i", "python3 - <<'EOF'\nimport urllib.request, json, ssl\nurls=[\n 'https://rpc.ankr.com/solana',\n 'https://mainnet.helius-rpc.com',\n 'https://solana-mainnet.rpc.extrnode.com',\n 'https://api.mainnet-beta.solana.com',\n]\nfor url in urls:\n    for t in (12,):\n        try:\n            req=urllib.request.Request(url, data=json.dumps({'jsonrpc':'2.0','id':1,'method':'getHealth','params':[]}).encode(), headers={'Content-Type':'application/json'})\n            r=urllib.request.urlopen(req, timeout=t)\n            print(url, r.status, r.read().decode()[:60])\n        except Exception as e:\n            print(url,'ERR',repr(e)[:80])\nEOF\n"]
