[599.43872, "o", "\u001b[?2004h> "]
[599.438956, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.440526, "o", "            if ix.get(\"program\") != \"spl-token\":\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             parsed = ix.get(\"parsed\")\r\n\u001b[?2004l\r\u001b[?2004h>             if not isinstance(parsed, dict):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.440866, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h>             typ = parsed.get(\"type\")\r\n\u001b[?2004l\r"]
[599.440906, "o", "\u001b[?2004h> "]
[599.441166, "o", "            if typ not in (\"transfer\", \"transferChecked\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.441194, "o", "> "]
[599.441323, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.441406, "o", "> "]
[599.44217, "o", "            info = parsed.get(\"info\", {}) or {}\r\n\u001b[?2004l\r\u001b[?2004h>             src = info.get(\"source\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.442377, "o", "            mint = info.get(\"mint\")"]
[599.442449, "o", "\r\n"]
[599.442502, "o", "\u001b[?2004l\r"]
[599.442567, "o", "\u001b[?2004h"]
[599.44262, "o", "> "]
[599.443234, "o", "            amt = info.get(\"amount\") or (info.get(\"tokenAmount\") or {}).get(\"amount\")"]
[599.443281, "o", "\r\n"]
[599.443327, "o", "\u001b[?2004l\r"]
[599.443394, "o", "\u001b[?2004h"]
[599.443481, "o", "> "]
[599.446716, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h>                 amt_v = int(amt)\r\n\u001b[?2004l\r\u001b[?2004h>             except (TypeError, ValueError):\r\n\u001b[?2004l\rtx\u001b[?2004h>                 amt_v = amt\r\n\u001b[?2004l\r\u001b[?2004h>             out.append({\"account\": src, \"mint\": mint, \"amount\": amt_v})\r\n\u001b[?2004l\r\u001b[?2004h>     return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def account_summary(acc):\r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.449613, "o", "        \"executable\": bool(acc.get(\"executable\")),\r\n\u001b[?2004l\r"]
[599.449663, "o", "\u001b[?2004h> "]
[599.449958, "o", "        \"lamports\": acc.get(\"lamports\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.450094, "o", "        \"owner\": acc.get(\"owner\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.450285, "o", "        \"rent_epoch\": acc.get(\"rentEpoch\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.45031, "o", "    }\r\n\u001b[?2004l\rerr("]
[599.450375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r{\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[599.450401, "o", "> "]
[599.450604, "o", "class Handler(BaseHTTPRequestHandler):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.450782, "o", "    def _send(self, code, obj):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.451014, "o", "        body = json.dumps(obj).encode()\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.451038, "o", "> "]
[599.451322, "o", "        self.send_response(code)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.4516, "o", "        self.send_header(\"Content-Type\", \"application/json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.452173, "o", "        self.send_header(\"Content-Length\", str(len(body)))\r\n\u001b[?2004l\r"]
[599.452219, "o", "\u001b[?2004h> "]
[599.452315, "o", "        self.end_headers()\r\n\u001b[?2004l\r"]
[599.452325, "o", "\u001b[?2004h> "]
[599.452523, "o", "        self.wfile.write(body)\r\n\u001b[?2004l\r"]
[599.45254, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[599.452582, "o", "\u001b[?2004h> "]
[599.452754, "o", "    def _send_ok(self, obj):\r\n\u001b[?2004l\r"]
[599.452819, "o", "\u001b[?2004h> "]
[599.45289, "o", "        self._send(200, obj)\r\n\u001b[?2004l\r"]
[599.452913, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rq"]
[599.452923, "o", "\u001b[?2004h"]
[599.453021, "o", "> "]
[599.453168, "o", "    def _send_err(self, obj):\r\n\u001b[?2004l\r"]
[599.453218, "o", "\u001b[?2004h> "]
[599.453343, "o", "        self._send(200, obj)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[599.453387, "o", "\u001b[?2004h> "]
[599.453548, "o", "    def _send_404(self, obj):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.453644, "o", "        self._send(404, obj)\r\n\u001b[?2004l\r"]
[599.453673, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\r\n"]
[599.453717, "o", "\u001b[?2004h> "]
[599.454008, "o", "    def log_message(self, *args):\r\n\u001b[?2004l\r"]
[599.454056, "o", "\u001b[?2004h>         pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.454088, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[599.454116, "o", "> "]
[599.454236, "o", "    def do_GET(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.454252, "o", "        try:\r\n\u001b[?2004l\r"]
[599.454282, "o", "\u001b[?2004h"]
[599.454308, "o", "> "]
[599.45449, "o", "            self.handle_route()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.454576, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[599.454596, "o", "\u001b[?2004h"]
[599.454632, "o", "> "]
[599.454818, "o", "            self._send_err({\"error\": str(e)})\r\n\u001b[?2004l\r"]
[599.454845, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[599.454888, "o", "\u001b[?2004h> "]
[599.455061, "o", "    def handle_route(self):\r\n\u001b[?2004l\r"]
[599.455086, "o", "\u001b[?2004h> "]
[599.455276, "o", "        parsed = urlparse(self.path)\r\n\u001b[?2004l\r"]
[599.455298, "o", "\u001b[?2004h> "]
[599.455598, "o", "        parts = [p for p in parsed.path.split(\"/\") if p != \"\"]\r\n\u001b[?2004l\r"]
[599.455614, "o", "\u001b[?2004h> "]
[599.455731, "o", "        if not parts:\r\n\u001b[?2004l\r"]
[599.455758, "o", "\u001b[?2004h> "]
[599.456067, "o", "            return self._send_err({\"error\": \"unknown endpoint\"})\r\n\u001b[?2004l\r"]
[599.456084, "o", "\u001b[?2004h> "]
[599.456245, "o", "        head = parts[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.456643, "o", "        if head == \"status\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.456687, "o", "            return self.route_status()\r\n\u001b[?2004l\r"]
[599.456737, "o", "\u001b[?2004h> "]
[599.456985, "o", "        if head == \"block\" and len(parts) == 2:\r\n\u001b[?2004l\r"]
[599.457002, "o", "\u001b[?2004h> "]
[599.457236, "o", "            return self.route_block(parts[1])\r\n\u001b[?2004l\r"]
[599.457253, "o", "\u001b[?2004h> "]
[599.457548, "o", "        if head == \"transaction\" and len(parts) == 2:\r\n\u001b[?2004l\r"]
[599.457568, "o", "\u001b[?2004h> "]
[599.458468, "o", "            return self.route_transaction(parts[1])"]
[599.458574, "o", "\r\n"]
[599.458602, "o", "\u001b[?2004l\r"]
[599.458649, "o", "\u001b[?2004h> "]
[599.458918, "o", "        if head == \"account\" and len(parts) == 2:\r\n\u001b[?2004l\r"]
[599.458985, "o", "\u001b[?2004h> "]
[599.459244, "o", "            return self.route_account(parts[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.459625, "o", "        if head == \"program\" and len(parts) == 3 and parts[2] == \"accounts\":\r\n\u001b[?2004l\r"]
[599.459688, "o", "\u001b[?2004h> "]
[599.459886, "o", "            return self.route_program(parts[1], parsed)\r\n\u001b[?2004l\r"]
[599.45997, "o", "\u001b[?2004h> "]
[599.460251, "o", "        return self._send_err({\"error\": \"unknown endpoint: %s\" % self.path})\r\n\u001b[?2004l\r"]
[599.460298, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.460433, "o", "    def route_status(self):\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.460474, "o", "> "]
[599.460548, "o", "        try:\r\n\u001b[?2004l\r_\u001b[?2004h"]
[599.460597, "o", "> "]
[599.460906, "o", "            url = _rpc_cache.get(\"url\") or list(candidate_urls()).__next__()\r\n\u001b[?2004l\r"]
[599.460927, "o", "\u001b[?2004h> "]
[599.461094, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.465709, "o", "            url = \"https://api.mainnet-beta.solana.com\"\r\n\u001b[?2004l\r"]
[599.465786, "o", "\u001b[?2004h> "]
[599.465925, "o", "        network = _network_for(url)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.466206, "o", "        try:\r\n\u001b[?2004l\rP\u001b[?2004h> "]
[599.466238, "o", "            slot = rpc_call(\"getSlot\", [])\r\n\u001b[?2004l\r"]
[599.466319, "o", "\u001b[?2004h> "]
[599.466477, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.466678, "o", "            return self._send_err({\"error\": str(e)})\r\n\u001b[?2004l\re\u001b[?2004h> "]
[599.466865, "o", "        version = \"unknown\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.467012, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.467064, "o", "            v = rpc_call(\"getVersion\", [])\r\n\u001b[?2004l\r"]
[599.467077, "o", "\u001b[?2004h> "]
[599.467338, "o", "            version = v.get(\"solana-core\", \"unknown\") if isinstance(v, dict) else \"unknown\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.46749, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r"]
[599.467514, "o", "\u001b[?2004h"]
[599.467524, "o", "> "]
[599.467578, "o", "        node_count = 0\r\n\u001b[?2004l\r"]
[599.467592, "o", "\u001b[?2004h> "]
[599.467622, "o", "        try:\r\n\u001b[?2004l\r"]
[599.467634, "o", "\u001b[?2004h> "]
[599.467822, "o", "            nodes = rpc_call(\"getClusterNodes\", [])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.467999, "o", "            node_count = len(nodes) if isinstance(nodes, list) else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.468019, "o", "> "]
[599.468076, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[599.468094, "o", "\u001b[?2004h> "]
[599.468233, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h>         self._send_ok({\r\n\u001b[?2004l\r"]
[599.468253, "o", "\u001b[?2004h> "]
[599.468381, "o", "            \"status\": \"online\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.468484, "o", "            \"network\": network,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.468596, "o", "            \"current_slot\": slot,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.468707, "o", "            \"node_count\": node_count,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.468757, "o", "            \"version\": version,\r\n\u001b[?2004l\r"]
[599.468769, "o", "\u001b[?2004h> "]
[599.468874, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.468978, "o", "    def route_block(self, slot):\r\n\u001b[?2004l\r"]
[599.468996, "o", "\u001b[?2004h> "]
[599.469029, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.469055, "o", "> "]
[599.469149, "o", "            blk = get_block(slot)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.46925, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.469401, "o", "            return self._send_err({\"error\": str(e)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.469499, "o", "        if blk is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.469516, "o", "> "]
[599.469728, "o", "            return self._send_404({\"error\": \"block not found for slot %s\" % slot})\r\n\u001b[?2004l\r"]
[599.469802, "o", "\u001b[?2004h> "]
[599.469821, "o", "        self._send_ok({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.469963, "o", "            \"blockhash\": blk.get(\"blockhash\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.47011, "o", "            \"parent_slot\": blk.get(\"parentSlot\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.470287, "o", "            \"previous_blockhash\": blk.get(\"previousBlockhash\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.470446, "o", "            \"block_height\": blk.get(\"blockHeight\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.47053, "o", "> "]
[599.47059, "o", "            \"block_time\": blk.get(\"blockTime\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.4706, "o", "> "]
[599.470648, "o", "        })\r\n\u001b[?2004l\r"]
[599.470665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[599.470719, "o", "\u001b[?2004h> "]
[599.470814, "o", "    def route_transaction(self, sig):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.470873, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.470984, "o", "            tx = get_tx(sig)\r\n\u001b[?2004l\r"]
[599.471001, "o", "\u001b[?2004h> "]
[599.471077, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.471099, "o", "> "]
[599.471242, "o", "            return self._send_err({\"error\": str(e)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.471336, "o", "        if tx is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.471565, "o", "            return self._send_404({\"error\": \"transaction not found: %s\" % sig})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.471661, "o", "        meta = tx.get(\"meta\") or {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.471686, "o", "> "]
[599.471821, "o", "        self._send_ok({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.471851, "o", "            \"signature\": sig,\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.471863, "o", "> "]
[599.471981, "o", "            \"slot\": tx.get(\"slot\"),\r\n\u001b[?2004l\r"]
[599.472004, "o", "\u001b[?2004h> "]
[599.472268, "o", "            \"block_time\": tx.get(\"blockTime\") if tx.get(\"blockTime\") is not None else meta.get(\"blockTime\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.472503, "o", "            \"success\": (meta.get(\"err\") is None) if isinstance(meta, dict) else None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.472619, "o", "            \"fee\": meta.get(\"fee\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.472787, "o", "            \"token_transfers\": extract_token_transfers(tx),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.472872, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.472979, "o", "    def route_account(self, address):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.473032, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.473261, "o", "            res = rpc_call(\"getAccountInfo\", [address, {\"encoding\": \"jsonParsed\"}])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.473346, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.473371, "o", "> "]
[599.473523, "o", "            return self._send_err({\"error\": str(e)})\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.473544, "o", "> "]
[599.473634, "o", "        info = (res or {}).get(\"value\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.47366, "o", "> "]
[599.473736, "o", "        if info is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.473986, "o", "            return self._send_err({\"error\": \"account not found: %s\" % address})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.474061, "o", "        self._send_ok({\r\n\u001b[?2004l\r"]
[599.474072, "o", "\u001b[?2004h> "]
[599.474152, "o", "            \"address\": address,\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.474183, "o", "> "]
[599.474315, "o", "            \"executable\": bool(info.get(\"executable\")),\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.47434, "o", "> "]
[599.474495, "o", "            \"lamports\": info.get(\"lamports\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.474594, "o", "            \"owner\": info.get(\"owner\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.474723, "o", "            \"rent_epoch\": info.get(\"rentEpoch\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.47475, "o", "> "]
[599.474795, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[599.474809, "o", "\u001b[?2004h> "]
[599.474974, "o", "    def route_program(self, program_id, parsed):\r\n\u001b[?2004l\r\u001b[?2004h"]
[599.474994, "o", "> "]
[599.47508, "o", "        qs = parse_qs(parsed.query)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.475132, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.475285, "o", "            limit = int(qs.get(\"limit\", [\"10\"])[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[599.475366, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
