[1081.826289, "o", "\r\n651:install-dumb: install_dfrotz\r\n652:install-dfrotz: install_dfrotz\r\n653:install_dfrotz: $(DFROTZ_BIN)\r\n657:\tinstall -m 644 doc/dfrotz.6 $(DESTDIR)$(MANDIR)/man6/\r\n659:uninstall_dumb: uninstall_dfrotz\r\n660:uninstall-dumb: uninstall_dfrotz\r\n661:uninstall-dfrotz: uninstall_dfrotz\r\n662:uninstall_dfrotz:\r\n663:\trm -f $(DESTDIR)$(BINDIR)/dfrotz\r\n664:\trm -f $(DESTDIR)$(MANDIR)/man6/dfrotz.6\r\n713:install_all:\tinstall_frotz install_dfrotz install_sfrotz install_xfrotz\r\n716:uninstall_all:\tuninstall_frotz uninstall_dfrotz uninstall_sfrotz uninstall_xfrotz\r\n"]
