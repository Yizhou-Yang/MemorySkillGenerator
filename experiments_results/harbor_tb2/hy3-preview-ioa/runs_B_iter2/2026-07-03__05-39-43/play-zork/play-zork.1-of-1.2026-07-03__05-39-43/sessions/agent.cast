[1184.963749, "o", "\r\n"]
[1184.963991, "o", "\r\n"]
[1184.96423, "o", "West of House"]
[1184.964619, "o", "\r\n"]
[1184.964842, "o", "You are standing in an open field west of a white house, with a boarded front"]
[1184.965094, "o", "\r\n"]
[1184.965309, "o", "door."]
[1184.967899, "o", "\r\n"]
[1184.968405, "o", "There is a small mailbox here."]
[1184.968631, "o", "\r\n"]
[1184.973122, "o", "\r\n"]
[1184.973597, "o", ">"]
[1184.973891, "o", "\r\n"]
[1184.974219, "o", "\r\n"]
[1184.974448, "o", "Opening the small mailbox reveals a leaflet."]
[1184.974742, "o", "\r\n"]
[1184.974981, "o", "\r\n"]
[1184.975302, "o", ">"]
[1184.975598, "o", "\r\n"]
[1184.975897, "o", "\r\n"]
[1184.976179, "o", "(Taken)"]
[1184.976477, "o", "\r\n"]
[1184.976777, "o", "\"WELCOME TO ZORK!"]
[1184.977017, "o", "\r\n"]
[1184.977345, "o", "\r\n"]
[1184.979065, "o", "ZORK is a game of adventure, danger, and low cunning. In it you will explore"]
[1184.979596, "o", "\r\n"]
[1184.97992, "o", "some of the most amazing territory ever seen by mortals. No computer should be"]
[1184.980185, "o", "\r\n"]
[1184.980497, "o", "without one!\""]
[1184.980746, "o", "\r\n"]
[1184.980991, "o", "\r\n"]
[1184.981235, "o", ">"]
[1184.981462, "o", "\r\n"]
[1184.981788, "o", "\r\n"]
[1184.982127, "o", "You already have that!"]
[1184.982354, "o", "\r\n"]
[1184.982658, "o", "\r\n"]
[1184.98288, "o", ">"]
[1184.983146, "o", "\r\n"]
[1184.983366, "o", "\r\n"]
[1184.983592, "o", "The door is boarded and you can't remove the boards."]
[1184.983802, "o", "\r\n"]
[1184.984036, "o", "\r\n"]
[1184.984269, "o", ">"]
[1184.984579, "o", "\r\n"]
[1184.988994, "o", "\r\n"]
[1184.989278, "o", "You can't see any lantern here!"]
[1184.989521, "o", "\r\n"]
[1184.989726, "o", "\r\n"]
[1184.989927, "o", ">"]
[1184.990172, "o", "\r\n"]
[1184.990464, "o", "\r\n"]
[1184.990672, "o", "You are carrying:"]
