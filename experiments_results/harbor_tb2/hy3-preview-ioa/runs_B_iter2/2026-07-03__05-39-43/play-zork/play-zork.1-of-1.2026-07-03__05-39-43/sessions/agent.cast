[1411.113025, "o", "root@5304d2cd6bff:/app/frotz# "]
[1411.342121, "i", "./dfrotz 2>&1 | head -20\n"]
[1411.342908, "o", "./dfrotz 2>&1 | head -20\r\n"]
[1411.347105, "o", "FROTZ V2.54 - Dumb interface."]
[1411.347506, "o", "\r\n"]
[1411.347864, "o", "An interpreter for all Infocom and other Z-Machine games."]
[1411.348111, "o", "\r\n"]
[1411.34832, "o", "\r\n"]
[1411.348534, "o", "Syntax: dfrotz [options] story-file [blorb file]"]
[1411.348741, "o", "\r\n"]
[1411.348968, "o", "  -a   watch attribute setting    "]
[1411.349188, "o", "\t"]
[1411.349392, "o", " -q   quiet mode (no startup messages)"]
[1411.349595, "o", "\r\n"]
[1411.349853, "o", "  -A   watch attribute testing    "]
[1411.35009, "o", "\t"]
[1411.350314, "o", " -r <option> Set runtime options"]
[1411.350516, "o", "\r\n"]
[1411.350718, "o", "  -f <type> type of format codes  "]
[1411.350916, "o", "\t"]
[1411.351162, "o", " -R <path> restricted read/write"]
[1411.351362, "o", "\r\n"]
[1411.35157, "o", "  -h # screen height              "]
[1411.351763, "o", "\t"]
[1411.352001, "o", " -s # random number seed value"]
[1411.352216, "o", "\r\n"]
[1411.352413, "o", "  -i   ignore fatal errors        "]
[1411.352603, "o", "\t"]
[1411.352795, "o", " -S # transcript width"]
[1411.353009, "o", "\r\n"]
[1411.353229, "o", "  -I # interpreter number         "]
[1411.353418, "o", "\t"]
[1411.353617, "o", " -t   set Tandy bit"]
[1411.353808, "o", "\r\n"]
[1411.354032, "o", "  -o   watch object movement      "]
[1411.35425, "o", "\t"]
[1411.354481, "o", " -u # slots for multiple undo"]
[1411.354696, "o", "\r\n"]
[1411.35499, "o", "  -O   watch object locating      "]
[1411.355268, "o", "\t"]
[1411.355479, "o", " -v   show version information"]
[1411.355685, "o", "\r\n"]
[1411.355899, "o", "  -L <file> load this save file   "]
[1411.356143, "o", "\t"]
[1411.356356, "o", " -w # screen width"]
[1411.35657, "o", "\r\n"]
[1411.362405, "o", "  -m   turn off MORE prompts      "]
[1411.362832, "o", "\t"]
[1411.363092, "o", " -x   expand abbreviations g/x/z"]
[1411.363303, "o", "\r\n"]
[1411.363532, "o", "  -p   plain ASCII output only    "]
[1411.363732, "o", "\t"]
[1411.363958, "o", " -Z # error checking (see below)"]
[1411.364185, "o", "\r\n"]
[1411.364396, "o", "  -P   alter piracy opcode"]
[1411.364597, "o", "\r\n"]
[1411.364803, "o", "\r\n"]
[1411.365037, "o", "Error checking: 0 none, 1 first only (default), 2 all, 3 exit after any error."]
[1411.365266, "o", "\r\n"]
[1411.365533, "o", "For more options and explanations, please read the manual page."]
