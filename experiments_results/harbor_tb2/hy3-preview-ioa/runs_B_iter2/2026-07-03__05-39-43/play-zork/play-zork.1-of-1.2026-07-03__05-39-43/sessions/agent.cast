[1071.093137, "o", "\r\n"]
[1071.093834, "o", "\t"]
[1071.095495, "o", "$(AR) $(ARFLAGS) $@ $?"]
[1071.09731, "o", "\r\n"]
[1071.097544, "o", "\t"]
[1071.097733, "o", "$(RANLIB) $@"]
[1071.105294, "o", "\r\n"]
[1071.105716, "o", "\t@echo \"** Done with dumb interface.\"\r\n\r\nclean:\r\n\trm -f $(TARGET) $(OBJECTS)\r\n\r\n%.o: %.c\r\n\t$(CC) $(CFLAGS) -fPIC -fpic -o $@ -c $<\r\n"]
