[1071.075207, "o", "\r\n"]
[1071.077058, "o", ".PHONY: clean"]
[1071.080669, "o", "\r\n"]
[1071.08221, "o", ".DELETE_ON_ERROR:"]
[1071.08699, "o", "\r\n"]
[1071.089629, "o", "\r\n"]
