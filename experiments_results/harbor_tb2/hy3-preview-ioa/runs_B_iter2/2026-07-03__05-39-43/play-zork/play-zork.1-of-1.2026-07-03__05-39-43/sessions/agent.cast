[1071.072343, "o", "# Makefile for Unix Frotz"]
[1071.072659, "o", "\r\n"]
[1071.072842, "o", "# GNU make is required"]
[1071.07301, "o", "\r\n"]
[1071.073162, "o", "\r\n"]
[1071.073313, "o", "SOURCES = dblorb.c dinit.c dinput.c doutput.c dpic.c"]
[1071.073464, "o", "\r\n"]
[1071.073614, "o", "\r\n"]
[1071.073763, "o", "OBJECTS = $(SOURCES:.c=.o)"]
