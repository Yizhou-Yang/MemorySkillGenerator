[1217.595036, "o", "cat > /tmp/p2.txt <<'EOF'\r\n> open mailbox\r\n> read leaflet\r\n> take leaflet\r\n> north\r\n> west\r\n> south\r\n> east\r\n> north\r\n> take lantern\r\n> turn on lantern\r\n> move rug\r\n> open trap door\r\n> down\r\n> look\r\n> north\r\n> look\r\n> south\r\n> look\r\n> east\r\n> look\r\n> west\r\n> look\r\n> quit\r\n> y\r\n> EOF\r\n"]
