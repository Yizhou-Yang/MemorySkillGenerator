[27.743452, "i", "python3 -c \"\nimport csv\nfrom datetime import datetime\ndef norm(d):\n    d=d.split()[0]\n    for fmt in ('%Y-%m-%d','%m/%d/%Y','%m-%d-%Y'):\n        try:\n            return datetime.strptime(d,fmt).strftime('%Y-%m-%d')\n        except ValueError:\n            continue\n    return None\ndef load(fn):\n    m={}\n    with open(fn) as f:\n        r=csv.reader(f)\n        next(r)\n        for row in r:\n            if not row: continue\n            m[norm(row[0])]=float(row[1])\n    return m\nh=load('daily_temp_sf_high.csv')\nl=load('daily_temp_sf_low.csv')\ndiffs=[h[d]-l[d] for d in h if d in l]\navg=sum(diffs)/len(diffs)\nwith open('avg_temp.txt','w') as f:\n    f.write(str(avg))\nprint('count',len(diffs),'avg',avg)\n\"\n"]
[27.748268, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> def norm(d):\r\n\u001b[?2004l\r\u001b[?2004h>     d=d.split()[0]\r\n\u001b[?2004l\r\u001b[?2004h>     for fmt in ('%Y-%m-%d','%m/%d/%Y','%m-%d-%Y'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             return datetime.strptime(d,fmt).strftime('%Y-%m-%d')\r\n\u001b[?2004l\r\u001b[?2004h>         except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> def load(fn):\r\n\u001b[?2004l\r\u001b[?2004h>     m={}\r\n\u001b[?2004l\r\u001b[?2004h>     with open(fn) as f:\r\n\u001b[?2004l\r\u001b[?2004h>         r=csv.reader(f)\r\n\u001b[?2004l\r\u001b[?2004h>         next(r)\r\n\u001b[?2004l\r\u001b[?2004h>         for row in r:\r\n\u001b[?2004l\r\u001b[?2004h>             if not row: continue\r\n\u001b[?2004l\r\u001b[?2004h>             m[norm(row[0])]=float(row[1])\r\n\u001b[?2004l\r\u001b[?2004h>     return m\r\n\u001b[?2004l\r\u001b[?2004h> h=load('daily_temp_sf_high.csv')\r\n\u001b[?2004l\r\u001b[?2004h> l=load('daily_temp_sf_low.csv')\r\n\u001b[?2004l\r\u001b[?2004h> diffs=[h[d]-l[d] for d in h if d in l]\r\n\u001b[?"]
[27.748311, "o", "2004l\r\u001b[?2004h> avg=sum(diffs)/len(diffs)\r\n\u001b[?2004l\r\u001b[?2004h> with open('avg_temp.txt','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write(str(avg))\r\n\u001b[?2004l\r\u001b[?2004h> print('count',len(diffs),'avg',avg)\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
