[37.302613, "o", "    \u001b[33m            echo \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mGot: \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m$CONTENT\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m        fi\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    else\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m        echo \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m❌ TEST FAILED: Web server returned HTTP $HTTP_RESPONSE\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    fi\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33melse\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n"]
