[531.517552, "i", "cat > /git/server/hooks/post-receive <<'EOF'\n#!/bin/bash\nDEPLOY=/var/www/html\nwhile read oldrev newrev refname; do\n  branch=\"${refname#refs/heads/}\"\n  if [ \"$branch\" = \"webserver\" ]; then\n    rm -rf \"$DEPLOY\"/*\n    git archive \"$newrev\" | tar -x -C \"$DEPLOY\"\n  fi\ndone\nEOF\n"]
