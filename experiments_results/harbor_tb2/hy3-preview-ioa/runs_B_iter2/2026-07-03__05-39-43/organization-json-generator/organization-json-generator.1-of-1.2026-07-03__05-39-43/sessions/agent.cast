[43.848961, "i", "cat > /app/process.py << 'EOF'\nimport csv\nimport json\nimport datetime\nfrom collections import defaultdict\n\nDATA = '/app/data'\n\n# Load departments\ndepartments = []\nwith open(f'{DATA}/departments.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        departments.append({\n            'id': row['id'],\n            'name': row['name'],\n            'budget': float(row['budget']),\n        })\n\n# Load employees\nemployees = []\nwith open(f'{DATA}/employees.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        skills = [s.strip() for s in row['skills'].split(';') if s.strip()]\n        employees.append({\n            'id': row['id'],\n            'name': row['name'],\n            'position': row['position'],\n            'skills': skills,\n            'years_of_service': int(row['years_of_service']),\n            'department_id': row['department_id'],\n        })\n\n# Load projects\nprojects = []\nwith open(f'{DATA}/projects.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        members = [m.strip() "]
[43.849028, "i", "for m in row['member_ids'].split(';') if m.strip()]\n        projects.append({\n            'name': row['name'],\n            'status': row['status'],\n            'members': members,\n            'deadline': row['deadline'],\n            'department_id': row['department_id'],\n        })\n\n# Build departments with nested employees and projects\ndept_list = []\nfor d in departments:\n    emp = [e for e in employees if e['department_id'] == d['id']]\n    proj = [p for p in projects if p['department_id'] == d['id']]\n    dept_emp = [\n        {\n            'id': e['id'],\n            'name': e['name'],\n            'position': e['position'],\n            'skills': e['skills'],\n            'years_of_service': e['years_of_service'],\n        }\n        for e in emp\n    ]\n    dept_proj = [\n        {\n            'name': p['name'],\n            'status': p['status'],\n            'members': p['members'],\n            'deadline': p['deadline'],\n        }\n        for p in proj\n    ]\n    dept_list.append({\n        'id': d['id'],\n        'na"]
[43.849042, "i", "me': d['name'],\n        'budget': d['budget'],\n        'employees': dept_emp,\n        'projects': dept_proj,\n    })\n\n# Statistics\nskill_dist = defaultdict(int)\nfor e in employees:\n    for s in e['skills']:\n        skill_dist[s] += 1\n\ndept_sizes = {d['name']: len([e for e in employees if e['department_id'] == d['id']]) for d in departments}\n\nstatus_dist = defaultdict(int)\nfor p in projects:\n    status_dist[p['status']] += 1\n\nyears = [e['years_of_service'] for e in employees]\navg_years = sum(years) / len(years) if years else 0\navg_budget = sum(d['budget'] for d in departments) / len(departments) if departments else 0\n\nout = {\n    'metadata': {\n        'version': '1.0',\n        'timestamp': datetime.datetime.now().isoformat(),\n        'generator': 'csv-to-json-processor',\n    },\n    'organization': {\n        'name': 'TechCorp Organization',\n        'founded': '2000-01-01',\n        'departments': dept_list,\n    },\n    'statistics': {\n        'averageDepartmentBudget': round(avg_budget, 2),\n        'totalEmployees"]
[43.849054, "i", "': len(employees),\n        'skillDistribution': dict(skill_dist),\n        'departmentSizes': dept_sizes,\n        'projectStatusDistribution': dict(status_dist),\n        'averageYearsOfService': round(avg_years, 2),\n    },\n}\n\nwith open('/app/organization.json', 'w') as f:\n    json.dump(out, f, indent=2)\n\nprint('Wrote /app/organization.json')\nEOF\n"]
