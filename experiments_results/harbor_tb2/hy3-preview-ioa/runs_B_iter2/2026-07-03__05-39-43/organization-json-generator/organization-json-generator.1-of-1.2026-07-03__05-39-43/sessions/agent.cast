[43.863186, "o", "        skill_dist[s] += 1\r\n\u001b[?2004l\r"]
[43.863221, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.863417, "o", "\u001b[?2004h> "]
[43.863713, "o", "dept_sizes = {d['name']: len([e for e in employees if e['department_id'] == d['id']]) for d in departments}\r\n\u001b[?2004l\r"]
[43.86383, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[43.863848, "o", "> status_dist = defaultdict(int)\r\n\u001b[?2004l\r"]
[43.863906, "o", "\u001b[?2004h> "]
[43.863937, "o", "for p in projects:\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.86395, "o", "> "]
[43.864041, "o", "    status_dist[p['status']] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.864056, "o", "> \r\n\u001b[?2004l\r"]
[43.864065, "o", "\u001b[?2004h"]
[43.864075, "o", "> "]
[43.864219, "o", "years = [e['years_of_service'] for e in employees]\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.864236, "o", "> "]
[43.864358, "o", "avg_years = sum(years) / len(years) if years else 0\r\n\u001b[?2004l\r"]
[43.864373, "o", "\u001b[?2004h> "]
[43.864567, "o", "avg_budget = sum(d['budget'] for d in departments) / len(departments) if departments else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.864583, "o", "> \r\n\u001b[?2004l\r"]
[43.86463, "o", "\u001b[?2004h> out = {\r\n\u001b[?2004l\r"]
[43.864667, "o", "\u001b[?2004h> "]
[43.864726, "o", "    'metadata': {\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.86474, "o", "> "]
[43.864819, "o", "        'version': '1.0',\r\n\u001b[?2004l\r"]
[43.864834, "o", "\u001b[?2004h> "]
[43.864987, "o", "        'timestamp': datetime.datetime.now().isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.865232, "o", "        'generator': 'csv-to-json-processor',\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.86526, "o", "> "]
[43.865336, "o", "    },\r\n\u001b[?2004l\r"]
[43.865389, "o", "\u001b[?2004h> "]
[43.865571, "o", "    'organization': {\r\n\u001b[?2004l\r"]
[43.865687, "o", "\u001b[?2004h"]
[43.865713, "o", "> "]
[43.865872, "o", "        'name': 'TechCorp Organization',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.865934, "o", "        'founded': '2000-01-01',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.866056, "o", "        'departments': dept_list,\r\n\u001b[?2004l\r"]
[43.866124, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.866171, "o", "    'statistics': {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.866321, "o", "        'averageDepartmentBudget': round(avg_budget, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.866441, "o", "        'totalEmployees': len(employees),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.866698, "o", "        'skillDistribution': dict(skill_dist),\r\n\u001b[?2004l\r\u001b[?2004h>         'departmentSizes': dept_sizes,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.866831, "o", "        'projectStatusDistribution': dict(status_dist),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.86698, "o", "        'averageYearsOfService': round(avg_years, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.867107, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.867245, "o", "with open('/app/organization.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.867396, "o", "    json.dump(out, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.867503, "o", "print('Wrote /app/organization.json')\r\n\u001b[?2004l\r"]
[43.867526, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
