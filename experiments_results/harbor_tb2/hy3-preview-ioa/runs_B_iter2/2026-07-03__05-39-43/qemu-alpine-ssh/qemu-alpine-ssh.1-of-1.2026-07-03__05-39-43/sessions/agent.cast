[393.128802, "i", "cat > /app/test_ssh.exp <<'EOF'\n#!/usr/bin/expect -f\nset timeout 40\nspawn ssh -p 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@localhost\nexpect {\n    \"password:\" {\n        send \"password123\\r\"\n        exp_continue\n    }\n    \"# \" {\n        send \"echo SSH_OK_RESULT; exit\\r\"\n    }\n    timeout { puts \"NO_SHELL\"; exit 1 }\n}\nexpect \"SSH_OK_RESULT\"\nexit 0\nEOF\n"]
