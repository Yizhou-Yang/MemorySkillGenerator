[192.809067, "i", "cat > /app/start_vm.sh <<'EOF'\n#!/bin/sh\nnohup setsid qemu-system-x86_64 \\\n  -m 2048 -smp 2 \\\n  -machine pc,accel=kvm:tcg \\\n  -cdrom /app/alpine.iso \\\n  -drive file=/app/alpine-disk.qcow2,if=virtio,format=qcow2 \\\n  -netdev user,id=net0,hostfwd=tcp::2222-:22 \\\n  -device virtio-net-pci,netdev=net0 \\\n  -display none \\\n  -serial tcp:127.0.0.1:9001,server,nowait \\\n  -monitor none \\\n  -pidfile /tmp/qemu.pid \\\n  </dev/null >/tmp/qemu.log 2>&1 &\necho \"started qemu pid $!\"\nEOF\n"]
[192.809227, "o", "cat > /app/start_vm.sh <<'EOF'"]
