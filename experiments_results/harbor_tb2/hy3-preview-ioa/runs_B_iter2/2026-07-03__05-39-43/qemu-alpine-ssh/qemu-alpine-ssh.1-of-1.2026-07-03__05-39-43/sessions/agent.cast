[244.411606, "i", "cat > /app/setup.exp <<'EOF'\n#!/usr/bin/expect -f\nset timeout 240\n\nproc cmd {c} {\n    send \"$c\\r\"\n    expect {\n        \"# \" {}\n        timeout { puts \"TIMEOUT_CMD: $c\"; exit 2 }\n    }\n}\n\nspawn nc 127.0.0.1 9001\nsleep 1\nsend \"\\r\"\nexpect {\n    \"login:\" {\n        send \"root\\r\"\n        expect {\n            \"Password:\" { send \"\\r\" }\n            \"# \" {}\n            timeout { puts \"TIMEOUT_AFTER_LOGIN\"; exit 1 }\n        }\n    }\n    \"# \" {}\n    timeout { puts \"TIMEOUT_WAITING\"; exit 1 }\n}\n\ncmd \"ip link set eth0 up\"\ncmd \"udhcpc -i eth0\"\ncmd \"echo root:password123 | chpasswd\"\ncmd \"apk add openssh\"\ncmd \"ssh-keygen -A\"\ncmd \"sed -i 's/^#\\\\?PermitRootLogin.*/PermitRootLogin yes/ ; s/^#\\\\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config\"\ncmd \"/usr/sbin/sshd\"\ncmd \"echo SETUP_DONE_OK\"\nexpect \"SETUP_DONE_OK\"\nsend \"exit\\r\"\nEOF\n"]
[244.411669, "o", "cat > /app/setup.exp <<'EOF'"]
