[506.657134, "o", "=== security_check ===\r\n"]
[506.65964, "o", "at now + 1 minute -f /tmp/.config/update/security_check\r\n"]
[506.659758, "o", "\u001b[?2004hroot@a2ab31fe2429:/app# "]
