[548.431039, "i", "cat > /app/vis.py << 'EOF'\nimport numpy as np\nfrom PIL import Image, ImageFont, ImageDraw\nfrom collections import deque\nFONT='/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf'\ndef fill_holes(mask):\n    h,w=mask.shape\n    visited=np.zeros((h+2,w+2),bool); q=deque()\n    for x in range(w+2): q.append((0,x)); q.append((h+1,x))\n    for y in range(h+2): q.append((y,0)); q.append((y,w+1))\n    while q:\n        y,x=q.popleft()\n        if visited[y,x]: continue\n        visited[y,x]=True\n        for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n            ny,nx=y+dy,x+dx\n            if 0<=ny<h+2 and 0<=nx<w+2 and not visited[ny,nx]:\n                if 0<=y-1<h and 0<=x-1<w and mask[y-1,x-1]: continue\n                q.append((ny,nx))\n    out=mask.copy()\n    for y in range(h):\n        for x in range(w):\n            if not mask[y,x] and not visited[y+1,x+1]: out[y,x]=True\n    return out\ndef render(ch,size=64):\n    img=Image.new('L',(size*2,size*2),0); d=ImageDraw.Draw(img)\n    f=ImageFont.truetype(FONT,size); d.text((size//2,size//2),ch,fill=255,font=f)\n    a=np.array(img)>80; ys,xs=np.where(a); return a[ys.min():ys.max()+1,xs.min():xs.max()+1]\ndef n32(m):\n    return np.array(Image.fromarray((m*255).astype('uint8')).resize((32,32)))>80\nim=Image.open('/app/chess_puzzle.png').convert('RGB'); arr=np.array(im).astype(int)\ndef cell(r,c):\n    y0,x0=r*80,c*80; cell=arr[y0:y0+80,x0:x0+80]\n    ring=np.concatenate([cell[:4,:].reshape(-1,3),cell[-4:,:].reshape(-1,3),cell[:,:4].reshape(-1,3),cell[:,-4:].reshape(-1,3)])\n    bg=np.median(ring,axis=0); diff=np.sqrt(((cell.astype(int)-bg)**2).sum(axis=2)); mask=diff>55\n    ys,xs=np.where(mask); sub=mask[ys.min():ys.max()+1,xs.min():xs.max()+1]; return n32(fill_holes(sub))\nfor nm in ['a1','c1']:\n    f=ord(nm[0])-97; r=8-int(nm[1])\n    print('=== cell',nm,'===')\n    m=cell(r,f)\n    for row in m: print(''.join('#' if v else '.' for v in row))\ntemplates={'N':render(chr(0x2658)),'B':render(chr(0x2657)),'R':render(chr(0x2656)),'P':render(chr(0x2659))}\nfor k,g in templates.items():\n    print('=== template',k,'===')\n    m=n32(fill_holes(g))\n    for row in m: print(''.join('#' if v else '.' for v in row))\nEOF\npython3 /app/vis.py\n"]
