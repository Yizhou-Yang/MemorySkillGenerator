[136.939019, "o", "\u001b[?2004hroot@e3e5581261f2:/app# "]
[186.576954, "i", "cat > /app/analyze.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\n\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.array(im).astype(int)\nN = 80\nfiles = 'abcdefgh'\n\ncells = []\nfor r in range(8):\n    for c in range(8):\n        y0, x0 = r*N, c*N\n        cell = arr[y0:y0+N, x0:x0+N]\n        # background = median of border ring\n        ring = np.concatenate([cell[:4,:].reshape(-1,3), cell[-4:,:].reshape(-1,3),\n                               cell[:,:4].reshape(-1,3), cell[:,-4:].reshape(-1,3)])\n        bg = np.median(ring, axis=0)\n        diff = np.sqrt(((cell.astype(int)-bg)**2).sum(axis=2))\n        mask = diff > 50\n        ink = cell[mask]\n        occ = mask.sum()\n        lum = float(ink.mean()) if occ>20 else None\n        cells.append((r,c,occ,lum,mask))\n\nprint('Occ/color grid (occ count, lum):')\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        occ=cells[r*8+c][2]; lum=cells[r*8+c][3]\n        if occ<20:\n            row.append('  .  ')\n        elif lum>140:\n            row.append(' W%.0f'%lum)\n        else:\n            row.append(' B%.0f'%lum)\n    print(8-r, ' '.join(row))\nprint('   '+' '.join(files[i]+'   ' for i in range(8)))\n\n# extract normalized masks for occupied cells\nmasks=[]\nfor (r,c,occ,lum,mask) in cells:\n    if occ<20: continue\n    ys,xs=np.where(mask)\n    y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\n    m=mask[y0:y1,x0:x1]\n    m=Image.fromarray((m*255).astype('uint8')).resize((32,32))\n    m=np.array(m)>80\n    masks.append((r,c,lum,m))\n\nprint('num occupied:',len(masks))\n\n# cluster\nclusters=[]\nfor (r,c,lum,m) in masks:\n    placed=False\n    for cl in clusters:\n        _,_,_,cm=cl[0]\n        d=(m^cm).mean()\n        if d<0.12:\n            cl.append((r,c,lum,m)); placed=True; break\n    if not placed:\n        clusters.append([(r,c,lum,m)])\n\nprint('num clusters:',len(clusters))\nfor i,cl in enumerate(clusters):\n    rs=[ ''.join(files[c]+str(8-r) for (r,c,lum,m) in cl) ]\n    print('--- cluster',i,'members:', ' '.join(rs), 'lum~%.0f'%cl[0][2])\n    rep=cl[0][3]\n    for row in rep:\n        print(''.join('#' if v else '.' for v in row))\nEOF\npython3 /app/analyze.py\n"]
