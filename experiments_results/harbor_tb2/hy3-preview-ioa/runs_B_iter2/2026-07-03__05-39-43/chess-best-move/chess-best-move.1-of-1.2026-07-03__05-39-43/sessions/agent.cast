[521.036836, "i", "cat > /app/recognize2.py << 'EOF'\nimport numpy as np\nfrom PIL import Image, ImageFont, ImageDraw\nfrom collections import deque\n\nFONT='/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf'\nwhite_glyphs = {'P':chr(0x2659),'N':chr(0x2658),'B':chr(0x2657),'R':chr(0x2656),'Q':chr(0x2655),'K':chr(0x2654)}\nblack_glyphs = {'p':chr(0x265F),'n':chr(0x265E),'b':chr(0x265D),'r':chr(0x265C),'q':chr(0x265B),'k':chr(0x265A)}\n\ndef fill_holes(mask):\n    h,w=mask.shape\n    visited=np.zeros((h+2,w+2),bool)\n    q=deque()\n    for x in range(w+2):\n        q.append((0,x)); q.append((h+1,x))\n    for y in range(h+2):\n        q.append((y,0)); q.append((y,w+1))\n    while q:\n        y,x=q.popleft()\n        if visited[y,x]: continue\n        visited[y,x]=True\n        for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n            ny,nx=y+dy,x+dx\n            if 0<=ny<h+2 and 0<=nx<w+2 and not visited[ny,nx]:\n                # border background region: inside mask array is (y-1,x-1)\n                if 0<=y-1<h and 0<=x-1<w:\n                    if mask[y-1,x-1]: continue\n                q.append((ny,nx))\n    out=mask.copy()\n    # any background pixel (inside array) not visited -> fill\n    for y in range(h):\n        for x in range(w):\n            if not mask[y,x] and not visited[y+1,x+1]:\n                out[y,x]=True\n    return out\n\ndef render_glyph(ch, size=64):\n    img=Image.new('L',(size*2,size*2),0)\n    d=ImageDraw.Draw(img)\n    f=ImageFont.truetype(FONT,size)\n    d.text((size//2,size//2),ch,fill=255,font=f)\n    a=np.array(img)>80\n    ys,xs=np.where(a)\n    if len(ys)==0: return None\n    return a[ys.min():ys.max()+1, xs.min():xs.max()+1]\n\ndef norm32(mask):\n    m=Image.fromarray((mask*255).astype('uint8')).resize((32,32))\n    return np.array(m)>80\n\ntemplates={}\nfor name,ch in list(white_glyphs.items())+list(black_glyphs.items()):\n    g=render_glyph(ch)\n    templates[name]=norm32(fill_holes(g)) if g is not None else None\n\nim=Image.open('/app/chess_puzzle.png').convert('RGB')\narr=np.array(im).astype(int)\nN=80\nfiles='abcdefgh'\ngrid=[['' for _ in range(8)] for _ in range(8)]\nfor r in range(8):\n    for c in range(8):\n        y0,x0=r*N,c*N\n        cell=arr[y0:y0+N,x0:x0+N]\n        ring=np.concatenate([cell[:4,:].reshape(-1,3),cell[-4:,:].reshape(-1,3),cell[:,:4].reshape(-1,3),cell[:,-4:].reshape(-1,3)])\n        bg=np.median(ring,axis=0)\n        diff=np.sqrt(((cell.astype(int)-bg)**2).sum(axis=2))\n        mask=diff>55\n        occ=mask.sum()\n        if occ<25: continue\n        ink=cell[mask]; lum=float(ink.mean())\n        color='white' if lum>140 else 'black'\n        ys,xs=np.where(mask)\n        sub=mask[ys.min():ys.max()+1,xs.min():xs.max()+1]\n        cm=norm32(fill_holes(sub))\n        pool=[k for k in templates if templates[k] is not None and (k.isupper()==(color=='white'))]\n        scores=sorted((( (cm^templates[k]).mean(), k) for k in pool))\n        best=scores[0][1]\n        grid[r][c]=best\n        print(files[c]+str(8-r), color, 'best=%s(%.3f)'%(scores[0][1],scores[0][0]), '2nd=%s(%.3f)'%(scores[1][1],scores[1][0]))\nprint()\nfen_rows=[]\nfor r in range(8):\n    s='';e=0\n    for c in range(8):\n        g=grid[r][c]\n        if g=='': e+=1\n        else:\n            if e:s+=str(e);e=0\n            s+=g\n    if e:s+=str(e)\n    fen_rows.append(s)\nfen='/'.join(fen_rows)+' w - - 0 1'\nprint('FEN:',fen)\nimport chess\nb=chess.Board(fen)\nprint('valid:',b.is_valid(),'checks:',b.is_check())\nprint(b)\nEOF\npython3 /app/recognize2.py\n"]
