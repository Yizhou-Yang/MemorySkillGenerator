[298.931768, "o", "def render_glyph(ch, size=64):\r\n\u001b[?2004l\r\u001b[?2004h>     img=Image.new('L',(size*2,size*2),0)\r\n\u001b[?2004l\r\u001b[?2004h>     d=ImageDraw.Draw(img)\r\n\u001b[?2004l\r\u001b[?2004h>     f=ImageFont.truetype(FONT,size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.932243, "o", "    d.text((size//2,size//2),ch,fill=255,font=f)\r\n\u001b[?2004l\r\u001b[?2004h>     a=np.array(img)>80\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.932551, "o", "    ys,xs=np.where(a)\r\n\u001b[?2004l\r\u001b[?2004h>     if len(ys)==0: return None\r\n\u001b[?2004l\r\u001b[?2004h>     return a[ys.min():ys.max()+1, xs.min():xs.max()+1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def norm32(mask):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.932694, "o", "    m=Image.fromarray((mask*255).astype('uint8')).resize((32,32))\r\n\u001b[?2004l\r\u001b[?2004h>     return np.array(m)>80\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.933074, "o", "> "]
[298.933262, "o", "templates={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.933308, "o", "for name,ch in white_glyphs.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.933512, "o", "    g=render_glyph(ch); templates[name]=norm32(g) if g is not None else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.933717, "o", "for name,ch in black_glyphs.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.93384, "o", "    g=render_glyph(ch); templates[name]=norm32(g) if g is not None else None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[298.933868, "o", "\u001b[?2004h> "]
[298.934027, "o", "im=Image.open('/app/chess_puzzle.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.934119, "o", "arr=np.array(im).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.93416, "o", "N=80\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.934311, "o", "files='abcdefgh'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.934391, "o", "grid=[['' for _ in range(8)] for _ in range(8)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.9345, "o", "for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.93454, "o", "    for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.934677, "o", "        y0,x0=r*N,c*N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.934704, "o", "        cell=arr[y0:y0+N,x0:x0+N]\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.934724, "o", "> "]
[298.935102, "o", "        ring=np.concatenate([cell[:4,:].reshape(-1,3),cell[-4:,:].reshape(-1,3),cell[:,:4].reshape(-1,3),cell[:,-4:].reshape(-1,3)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.93521, "o", "        bg=np.median(ring,axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.935234, "o", "> "]
[298.935391, "o", "        diff=np.sqrt(((cell.astype(int)-bg)**2).sum(axis=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.935456, "o", "        mask=diff>55\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.93554, "o", "        occ=mask.sum()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.935634, "o", "        if occ<25: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.935798, "o", "        ink=cell[mask]; lum=float(ink.mean())\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.936111, "o", "> "]
[298.936274, "o", "        color='white' if lum>140 else 'black'\r\n\u001b[?2004l\r\u001b[?2004h>         ys,xs=np.where(mask)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.936396, "o", "        sub=mask[ys.min():ys.max()+1,xs.min():xs.max()+1]\r\n\u001b[?2004l\r\u001b[?2004h>         cm=norm32(sub)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.937254, "o", "        pool = [k for k in templates if templates[k] is not None and (k.isupper()==(color=='white'))]\r\n\u001b[?2004l\r\u001b[?2004h>         best=None;bd=1.0\r\n\u001b[?2004l\r\u001b[?2004h>         for k in pool:\r\n\u001b[?2004l\r\u001b[?2004h>             d=(cm^templates[k]).mean()\r\n\u001b[?2004l\r\u001b[?2004h>             if d<bd: bd=d;best=k\r\n\u001b[?2004l\r\u001b[?2004h>         grid[r][c]=best\r\n\u001b[?2004l\r"]
[298.937304, "o", "\u001b[?2004h> "]
[298.937505, "o", "        print(files[c]+str(8-r), color, best, 'd=%.3f'%bd, 'occ=%d lum=%.0f'%(occ,lum))\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.937537, "o", "> \r\n\u001b[?2004l\r"]
[298.937556, "o", "\u001b[?2004h"]
[298.937575, "o", "> "]
[298.937827, "o", "print()\r\n\u001b[?2004l\r\u001b[?2004h> print('Board (rank8 top):')\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(8):\r\n\u001b[?2004l\r"]
[298.937857, "o", "\u001b[?2004h> "]
[298.938059, "o", "    print(8-r, ' '.join(g or '.' for g in grid[r]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.938202, "o", "print('   '+ ' '.join(files))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.938232, "o", "> "]
[298.938393, "o", "# build FEN\r\n\u001b[?2004l\r\u001b[?2004h> fen_rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.938534, "o", "for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>     s='';e=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.938673, "o", "    for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.938703, "o", "        g=grid[r][c]\r\n\u001b[?2004l\r"]
[298.938878, "o", "\u001b[?2004h>         if g=='': e+=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.938927, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.939092, "o", ">             if e:s+=str(e);e=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.939234, "o", "            s+=g\r\n\u001b[?2004l\r\u001b[?2004h>     if e:s+=str(e)\r\n\u001b[?2004l\r"]
[298.939263, "o", "\u001b[?2004h> "]
[298.939423, "o", "    fen_rows.append(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.939561, "o", "fen='/'.join(fen_rows)+' w - - 0 1'\r\n\u001b[?2004l\r\u001b[?2004h> print('FEN:',fen)\r\n\u001b[?2004l\r"]
[298.939598, "o", "\u001b[?2004h> "]
[298.93978, "o", "import chess\r\n\u001b[?2004l\r\u001b[?2004h> b=chess.Board(fen)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.939936, "o", "print('valid:',b.is_valid())\r\n\u001b[?2004l\r\u001b[?2004h> print(b)"]
[298.939962, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.939981, "o", "> "]
[298.940166, "o", "EOF\r\n\u001b[?2004l\r"]
