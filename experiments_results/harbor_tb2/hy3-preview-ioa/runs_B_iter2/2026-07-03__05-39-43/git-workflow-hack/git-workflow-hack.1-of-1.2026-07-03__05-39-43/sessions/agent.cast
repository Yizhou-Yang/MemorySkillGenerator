[144.531311, "o", "      <p>Moreno, L., Zhang, W., &amp; Singh, R. (2023). \"Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets.\" <em>Neuroinformatics</em>, 21(4), 299-312.</p>\r\n\u001b[?2004l\r"]
