[144.532906, "o", "      <h3>DeepVision</h3>\r\n\u001b[?2004l\r"]
[144.532941, "o", "\u001b[?2004h> "]
[144.533166, "o", "      <p class=\"meta\">Lead Developer &amp; Project Coordinator</p>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.533476, "o", "      <p>A PyTorch pipeline for two-photon image segmentation and stimulus decoding from calcium-imaging traces.</p>\r\n\u001b[?2004l\r"]
[144.533569, "o", "\u001b[?2004h> "]
[144.533653, "o", "    </div>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.53368, "o", "    <div class=\"card\">\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.533805, "o", "      <h3>NeuroGraph</h3>\r\n\u001b[?2004l\r"]
[144.53386, "o", "\u001b[?2004h"]
[144.533959, "o", "> "]
[144.53407, "o", "      <p class=\"meta\">Principal Investigator</p>\r\n\u001b[?2004l\r"]
[144.534104, "o", "\u001b[?2004h> "]
[144.534384, "o", "      <p>GNN-based classification of synapse types from electron-microscopy neuron meshes; released as part of the NeuroTools suite.</p>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.534558, "o", "    </div>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.534635, "o", "    <div class=\"card\">\r\n\u001b[?2004l\r\u001b[?2004h> "]
