[144.054367, "i", "cat > styles.css <<'EOF'\n:root{\n  --bg:#f7f7f5;\n  --fg:#1f2933;\n  --muted:#5b6b7b;\n  --accent:#2b6cb0;\n  --accent-dark:#1a4f86;\n  --card:#ffffff;\n  --border:#e3e8ee;\n}\n*{box-sizing:border-box;}\nbody{\n  margin:0;\n  font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  color:var(--fg);\n  background:var(--bg);\n  line-height:1.65;\n}\nheader.site{background:#ffffff;border-bottom:1px solid var(--border);}\nheader.site .inner{max-width:860px;margin:0 auto;padding:1.2rem 1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;}\n.brand{font-size:1.25rem;font-weight:700;color:var(--fg);text-decoration:none;}\n.brand span{color:var(--accent);}\nnav a{margin-left:1.25rem;color:var(--muted);text-decoration:none;font-weight:500;}\nnav a:hover,nav a.active{color:var(--accent);}\nmain{max-width:860px;margin:0 auto;padding:2.5rem 1.5rem 3rem;}\nh1{font-size:2rem;margin:0 0 .25rem;}\nh2{font-size:1.35rem;margin:2.2rem 0 .6rem;color:var(--accent-dark);border-bottom:1px solid var(--border);padding-bottom:.3rem;}\nh3{font-size:1.05rem;margin:1.2rem 0 .3rem;}\n.lead{color:var(--muted);font-size:1.05rem;margin-top:0;}\n.card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.2rem 1.4rem;margin:1rem 0;}\nul{margin:.4rem 0 0;padding-left:1.2rem;}\nli{margin:.25rem 0;}\n.meta{color:var(--muted);font-size:.9rem;}\na{color:var(--accent);}\n.pub{margin:1rem 0;padding-bottom:1rem;border-bottom:1px solid var(--border);}\n.pub:last-child{border-bottom:none;}\nfooter.site{background:#fff;border-top:1px solid var(--border);margin-top:2rem;}\nfooter.site .inner{max-width:860px;margin:0 auto;padding:1.4rem 1.5rem;color:var(--muted);font-size:.9rem;}\n.tag{display:inline-block;background:#eef3fa;color:var(--accent-dark);border-radius:6px;padding:.15rem .6rem;font-size:.8rem;margin-right:.4rem;margin-top:.4rem;}\nEOF\n"]
