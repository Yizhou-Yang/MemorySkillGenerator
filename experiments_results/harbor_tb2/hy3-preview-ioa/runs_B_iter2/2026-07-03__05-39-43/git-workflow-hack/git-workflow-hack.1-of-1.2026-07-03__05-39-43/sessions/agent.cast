[144.722507, "i", "cat > blog.html <<'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dr. Lydia Moreno - Blog</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"inner\">\n      <a class=\"brand\" href=\"index.html\">Lydia <span>Moreno</span></a>\n      <nav>\n        <a href=\"index.html\">About</a>\n        <a href=\"publications.html\">Publications</a>\n        <a class=\"active\" href=\"blog.html\">Blog</a>\n      </nav>\n    </div>\n  </header>\n  <main>\n    <h1>Blog</h1>\n    <p class=\"lead\">Notes on computational neuroscience, machine learning, and open science.</p>\n\n    <div class=\"card\">\n      <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\n      <p class=\"meta\">March 2025</p>\n      <p>A walkthrough of techniques for probing decision boundaries and feature attributions in models that decode neural population activity.</p>\n    </div>\n    <div class=\"card\">\n      <h3>Bridging Machine Learning and Single-Cell Genomics</h3>\n      <p class=\"meta\">January 2025</p>\n      <p>Reflections on integrating multi-modal single-cell data and the pipelines that make it reproducible.</p>\n    </div>\n    <div class=\"card\">\n      <h3>Scaling Graph Neural Networks for Connectomics</h3>\n      <p class=\"meta\">November 2024</p>\n      <p>Lessons learned training GNNs on large electron-microscopy datasets to infer synaptic connectivity motifs.</p>\n    </div>\n  </main>\n  <footer class=\"site\">\n    <div class=\"inner\">(c) 2025 Dr. Lydia Moreno - Riverbend University</div>\n  </footer>\n</body>\n</html>\nEOF\n"]
