[144.5348, "o", "      <p class=\"meta\">Co-Principal Investigator</p>\r\n\u001b[?2004l\r"]
[144.534877, "o", "\u001b[?2004h> "]
[144.535171, "o", "      <p>Nextflow workflow integrating scRNA-Seq, ATAC-Seq, and spatial FISH for human cortical organoids.</p>\r\n\u001b[?2004l\r\u001b[?2004h> "]
