[144.525913, "i", "cat > publications.html <<'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dr. Lydia Moreno - Publications</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"inner\">\n      <a class=\"brand\" href=\"index.html\">Lydia <span>Moreno</span></a>\n      <nav>\n        <a href=\"index.html\">About</a>\n        <a class=\"active\" href=\"publications.html\">Publications</a>\n        <a href=\"blog.html\">Blog</a>\n      </nav>\n    </div>\n  </header>\n  <main>\n    <h1>Publications</h1>\n    <p class=\"lead\">Selected refereed articles and conference contributions.</p>\n\n    <h2>Peer-Reviewed Articles</h2>\n    <div class=\"pub\">\n      <p>Moreno, L., &amp; Patel, A. (2024). \"Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals.\" <em>Journal of Computational Neuroscience</em>, 45(2), 123-137.</p>\n    </div>\n    <div class=\"pub\">\n      <p>Moreno, L., Zhang, W., &amp; Singh, R. (2023). \"Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets.\" <em>Neuroinformatics</em>, 21(4), 299-312.</p>\n    </div>\n    <div class=\"pub\">\n      <p>Moreno, L. et al. (2022). \"Integrative Single-Cell Atlas of Human Cerebral Organoids.\" <em>Cell Systems</em>, 9(1), 67-82.</p>\n    </div>\n    <div class=\"pub\">\n      <p>Chen, J., Moreno, L., &amp; Russo, M. (2021). \"Explainable AI Techniques in Neural Decoding.\" <em>Frontiers in Neuroscience</em>, 15, 756843.</p>\n    </div>\n\n    <h2>Selected Projects</h2>\n    <div class=\"card\">\n      <h3>DeepVision</h3>\n      <p class=\"meta\">Lead Developer &amp; Project Coordinator</p>\n      <p>A PyTorch pipeline for two-photon image segmentation and stimulus decoding from calcium-imaging traces.</p>\n    </div>\n    <div class=\"card\">\n      <h3>NeuroGraph</h3>\n      <p class=\"meta\">Principal Investigator</p>\n      <p>GNN-based classification of synapse types from electron-microscopy neuron meshes; released as part of the NeuroTools suite.</p>\n    </div>\n    <div class=\"card\">\n      <h3>CellMap</h3>\n      <p class=\"meta\">Co-Principal Investigator</p>\n      <p>Nextflow workflow integrating scRNA-Seq, ATAC-Seq, and spatial FISH for human cortical organoids.</p>\n    </div>\n  </main>\n  <footer class=\"site\">\n    <div class=\"inner\">(c) 2025 Dr. Lydia Moreno - Riverbend University</div>\n  </footer>\n</body>\n</html>\nEOF\n"]
[144.52647, "o", "cat > publications.html <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> <!DOCTYPE html>"]
