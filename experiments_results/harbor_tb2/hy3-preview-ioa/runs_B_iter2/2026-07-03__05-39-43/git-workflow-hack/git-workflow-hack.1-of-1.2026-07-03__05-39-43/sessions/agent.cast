[144.300547, "i", "cat > index.html <<'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dr. Lydia Moreno - About</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"inner\">\n      <a class=\"brand\" href=\"index.html\">Lydia <span>Moreno</span></a>\n      <nav>\n        <a class=\"active\" href=\"index.html\">About</a>\n        <a href=\"publications.html\">Publications</a>\n        <a href=\"blog.html\">Blog</a>\n      </nav>\n    </div>\n  </header>\n  <main>\n    <h1>Dr. Lydia Moreno</h1>\n    <p class=\"lead\">Associate Professor of Computational Neuroscience, Riverbend University</p>\n\n    <h2>About</h2>\n    <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University's School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n\n    <h2>Education</h2>\n    <div class=\"card\">\n      <h3>Ph.D., Computational Biology</h3>\n      <p class=\"meta\">Baywood Institute of Technology, 2014-2019</p>\n      <p>Dissertation: \"Deep Learning Models for Decoding Neural Population Activity\"</p>\n      <h3>M.Sc., Bioinformatics</h3>\n      <p class=\"meta\">Riverbend University, 2012-2014</p>\n      <p>Thesis: \"Statistical Methods for Single-Cell RNA-Seq Analysis\"</p>\n      <h3>B.Sc., Computer Science</h3>\n      <p class=\"meta\">Crestfield College of Engineering, 2008-2012</p>\n      <p>Graduated magna cum laude; President, Data Science Club</p>\n    </div>\n\n    <h2>Research Interests</h2>\n    <ul>\n      <li><strong>Neural Encoding &amp; Decoding</strong> - interpretable models translating spike-train data into behavioral predictions.</li>\n      <li><strong>Machine Learning for Biomedical Imaging</strong> - CNNs and GNNs for MRI and two-photon microscopy.</li>\n      <li><strong>Single-Cell Omics</strong> - scalable pipelines for multi-modal single-cell genomics and spatial transcriptomics.</li>\n      <li><strong>Explainable AI in Neuroscience</strong> - probing decision boundaries and feature attributions in black-box models.</li>\n    </ul>\n\n    <h2>Selected Projects</h2>\n    <div class=\"card\">\n      <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\n      <p class=\"meta\">Lead Developer &amp; Project Coordinator</p>\n      <ul>\n        <li>Designed a PyTorch-based pipeline to segment two-photon images of mouse visual cortex.</li>\n        <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium-imaging traces.</li>\n        <li>Deployed a Dockerized microservice for real-time processing with Cascade Imaging Lab.</li>\n      </ul>\n    </div>\n    <div class=\"card\">\n      <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\n      <p class=\"meta\">Principal Investigator</p>\n      <ul>\n        <li>Constructed graph representations of reconstructed neuron meshes from electron microscopy.</li>\n        <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\n        <li>Published an open-source toolkit in the NeuroTools suite, adopted by 12 labs worldwide.</li>\n      </ul>\n    </div>\n    <div class=\"card\">\n      <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\n      <p class=\"meta\">Co-Principal Investigator</p>\n      <ul>\n        <li>Developed a Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH data.</li>\n        <li>Implemented Bayesian clustering to resolve cell-type hierarchies in human cortical organoids.</li>\n        <li>Presented at ICSCG 2023.</li>\n      </ul>\n    </div>\n\n    <h2>Skills &amp; Tools</h2>\n    <p>\n      <span class=\"tag\">Python</span> <span class=\"tag\">R</span> <span class=\"tag\">C++</span>\n      <span class=\"tag\">PyTorch</span> <span class=\"tag\">TensorFlow<"]
[144.300651, "i", "/span> <span class=\"tag\">scikit-learn</span> <span class=\"tag\">NetworkX</span>\n      <span class=\"tag\">Nextflow</span> <span class=\"tag\">Snakemake</span> <span class=\"tag\">Docker</span> <span class=\"tag\">Kubernetes</span>\n      <span class=\"tag\">MATLAB</span> <span class=\"tag\">Jupyter</span> <span class=\"tag\">Seurat</span> <span class=\"tag\">Scanpy</span>\n      <span class=\"tag\">D3.js</span> <span class=\"tag\">Plotly</span> <span class=\"tag\">Matplotlib</span>\n    </p>\n\n    <h2>Contact</h2>\n    <ul>\n      <li>Email: <a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></li>\n      <li>Office: Blakely Hall, Room 312, Riverbend University</li>\n      <li>Twitter: <a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></li>\n      <li>GitHub: <a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></li>\n    </ul>\n  </main>\n  <footer class=\"site\">\n    <div class=\"inner\">(c) 2025 Dr. Lydia Moreno - Riverbend University</div>\n  </footer>\n</body>\n</html>\nEOF\n"]
[144.302197, "o", "cat > index.html <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> <!DOCTYPE html>\r\n\u001b[?2004l\r\u001b[?2004h> <html lang=\"en\">\r\n\u001b[?2004l\r\u001b[?2004h> <head>\r\n\u001b[?2004l\r\u001b[?2004h>   <meta charset=\"utf-8\">\r\n\u001b[?2004l\r\u001b[?2004h>   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n\u001b[?2004l\r\u001b[?2004h>   <title>Dr. Lydia Moreno - About</title>\r\n\u001b[?2004l\r><strong>Machine Learning for Biomedical Imaging</strong> - CNNs and GNNs for MRI and two-photon microscopy.</li>\r\n      <li><strong>Single-Cell Omics</strong> - scalable pipelines for multi-modal single-cell genomics and spatial transcriptomics.</li>\r\n      <li><strong>Explainable AI in Neuroscience</strong> - probing decision boundaries and feature attributions in black-box models.</li>\r\n    </ul>\r\n\r\n    <h2>Selected Projects</h2>\r\n    <div class=\"card\">\r\n      <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\r\n      <p class=\"meta\">Lead Developer &amp; Project Coordinator</p>\r\n      <ul>\r\n        <li>Designed a PyTorch-based pipeline to segment two-photon images of mouse visual cortex.</li>\r\n        <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium-imaging traces.</li>\r\n        <li>Deployed a Dockerized microservice for real-time processing with Cascade Imaging Lab.</li>\r\n      </ul>\r\n    </div>\r\n    <div class=\"card\">\r\n      <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\r\n      <p class=\"meta\">Principal Investigator</p>\r\n      <ul>\r\n        <li>Constructed graph representations of reconstructed neuron meshes from electron microscopy.</li>\r\n        <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\r\n        <li>Published an open-source toolkit in the NeuroTools suite, adopted by 12 labs worldwide.</li>\r\n      </ul>\r\n    </div>\r\n    <div class=\"card\">\r\n      <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\r\n      <p class=\"meta\">Co-Principal Investigator</p>\r\n      <ul>\r\n        <li>Developed a Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH data.</li>\r\n        <li>Implemented Bayesian clustering to resolve cell-type hierarchies in human cortical organoids.</li>\r\n        <li>Presented at ICSCG 2023.</li>\r\n      </ul>\r\n    </div>\r\n\r\n    <h2>Skills &amp; Tools</h2>\r\n    <p>\r\n      <span class=\"tag\">Python</span> <span class=\"tag\">R</span> <span class=\"tag\">C++</span>\r\n      <span class=\"tag\">PyTorch</span> <span class=\"tag\">TensorFlow</\u001b[?2004h"]
