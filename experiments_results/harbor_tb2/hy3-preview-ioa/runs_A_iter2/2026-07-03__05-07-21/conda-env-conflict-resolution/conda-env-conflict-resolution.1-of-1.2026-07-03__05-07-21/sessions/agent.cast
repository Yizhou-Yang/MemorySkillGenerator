[10.022749, "o", "#!/usr/bin/env python3"]
[10.023135, "o", "\r\n"]
[10.023305, "o", "\r\n"]
[10.023467, "o", "def test_environment():"]
[10.023581, "o", "\r\n"]
[10.023686, "o", "    \"\"\""]
[10.023788, "o", "\r\n"]
[10.023943, "o", "    Test all the required packages can be successfully imported in the environment."]
[10.024073, "o", "\r\n"]
[10.024206, "o", "    This will fail if any dependency issues exist."]
[10.024353, "o", "\r\n"]
[10.024474, "o", "    \"\"\""]
[10.024597, "o", "\r\n"]
[10.024721, "o", "    print(\"Testing imports for all required packages...\")"]
[10.02486, "o", "\r\n"]
[10.024983, "o", "    "]
[10.025104, "o", "\r\n"]
[10.025228, "o", "    # Test core scientific packages"]
[10.025368, "o", "\r\n"]
[10.025499, "o", "    print(\"Testing numpy...\")"]
[10.025573, "o", "\r\n    import numpy\r\n    print(f\"NumPy version: {numpy.__version__}\")\r\n    "]
[10.025597, "o", "\r\n    print(\"Testing scipy...\")"]
[10.026244, "o", "\r\n    import scipy\r\n    print(f\"SciPy version: {scipy.__version__}\")\r\n    \r\n    print(\"Testing pandas...\")\r\n    import pandas\r\n    print(f\"Pandas version: {pandas.__version__}\")\r\n    \r\n    print(\"Testing scikit-learn...\")\r\n    import sklearn\r\n    print(f\"Scikit-learn version: {sklearn.__version__}\")\r\n    \r\n    # Test ML frameworks\r\n    print(\"Testing TensorFlow...\")\r\n    import tensorflow as tf\r\n    print(f\"TensorFlow version: {tf.__version__}\")\r\n    \r\n    print(\"Testing PyTorch...\")\r\n    import torch\r\n    print(f\"PyTorch version: {torch.__version__}\")\r\n    \r\n    # Test NLP packages\r\n    print(\"Testing transformers...\")\r\n    import transformers\r\n    print(f\"Transformers version: {transformers.__version__}\")\r\n    \r\n    print(\"All packages imported successfully!\")\r\n\r\nif __name__ == \"__main__\":\r\n    test_environment()"]
