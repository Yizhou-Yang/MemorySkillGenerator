[82.429917, "i", "python3 - <<'PYEOF'\nimport os, shutil\nsrc='c4_sample'\ndst='c4_reshard'\nos.makedirs(dst, exist_ok=True)\nfiles=sorted(os.listdir(src))\nper=30\nfor i in range(0,len(files),per):\n    chunk=files[i:i+per]\n    folder=os.path.join(dst,'%03d'%(i//per))\n    os.makedirs(folder, exist_ok=True)\n    for f in chunk:\n        shutil.copy2(os.path.join(src,f), os.path.join(folder,f))\nprint('done', len(files), 'files into', (len(files)+per-1)//per, 'folders')\nPYEOF\n"]
[82.431286, "o", "python3 - <<'PYEOF'\r\n\u001b[?2004l\r"]
