[11.633332, "o", "\r\n"]
[11.633472, "o", "\u001b[?2004l\r"]
[11.637715, "o", "import torch\r"]
[11.638108, "o", "\r\n"]
[11.638319, "o", "import torch.nn as nn\r"]
[11.638533, "o", "\r\n"]
[11.638723, "o", "\r"]
[11.638913, "o", "\r\n"]
[11.639098, "o", "\r"]
[11.639289, "o", "\r\n"]
[11.639519, "o", "class MnistModel(nn.Module):\r"]
[11.63975, "o", "\r\n"]
[11.639939, "o", "    def __init__(\r"]
[11.640124, "o", "\r\n"]
[11.640329, "o", "        self,\r"]
[11.64054, "o", "\r\n"]
[11.640737, "o", "        input_dim: int,\r"]
[11.640923, "o", "\r\n"]
[11.641058, "o", "        hidden_dim: int,\r"]
[11.641315, "o", "\r\n"]
[11.641528, "o", "        num_classes: int,\r"]
[11.641712, "o", "\r\n"]
[11.641906, "o", "    ) -> torch.nn.Module:\r"]
[11.642092, "o", "\r\n"]
[11.642277, "o", "        super().__init__()\r"]
[11.642506, "o", "\r\n"]
[11.642699, "o", "\r"]
[11.642881, "o", "\r\n"]
[11.643065, "o", "        self.input_layer = nn.Linear(input_dim, hidden_dim)\r"]
[11.643251, "o", "\r\n"]
[11.643482, "o", "        self.hidden_layer = nn.Linear(hidden_dim, hidden_dim)\r"]
[11.643666, "o", "\r\n"]
[11.643854, "o", "        self.output_layer = nn.Linear(hidden_dim, num_classes)\r"]
[11.644037, "o", "\r\n"]
[11.644223, "o", "        self.activation = nn.ReLU()\r"]
[11.644427, "o", "\r\n"]
[11.64464, "o", "\r"]
[11.644828, "o", "\r\n"]
[11.645026, "o", "    def forward(self, x):\r"]
[11.645216, "o", "\r\n"]
[11.645425, "o", "        x = self.input_layer(x)\r"]
[11.64566, "o", "\r\n"]
[11.645846, "o", "        x = self.activation(x)\r"]
[11.646026, "o", "\r\n"]
[11.646206, "o", "\r"]
[11.646413, "o", "\r\n"]
[11.646643, "o", "        x = self.hidden_layer(x)\r"]
[11.646834, "o", "\r\n"]
[11.647472, "o", "        x = self.activation(x)\r"]
[11.647661, "o", "\r\n"]
[11.648105, "o", "\r"]
[11.648294, "o", "\r\n"]
[11.648538, "o", "        x = self.output_layer(x)\r"]
[11.648727, "o", "\r\n"]
[11.648922, "o", "        return x\r"]
[11.649111, "o", "\r\n"]
[11.651056, "o", "\u001b[?2004h"]
