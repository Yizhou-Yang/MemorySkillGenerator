[56.658821, "i", "cat > /app/check_cert.py << 'PYEOF'\nimport ssl\nimport subprocess\nimport sys\nimport os\nimport re\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\nMONTHS = {\n    \"Jan\": 1, \"Feb\": 2, \"Mar\": 3, \"Apr\": 4, \"May\": 5, \"Jun\": 6,\n    \"Jul\": 7, \"Aug\": 8, \"Sep\": 9, \"Oct\": 10, \"Nov\": 11, \"Dec\": 12,\n}\n\ndef main():\n    if not os.path.exists(CERT_PATH):\n        print(\"Certificate not found at \" + CERT_PATH)\n        sys.exit(1)\n\n    result = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\", \"-enddate\"],\n        capture_output=True, text=True,\n    )\n    if result.returncode != 0:\n        print(\"Failed to load certificate\")\n        sys.exit(1)\n\n    subject = \"\"\n    not_after = \"\"\n    for line in result.stdout.splitlines():\n        if line.startswith(\"subject=\"):\n            subject = line[len(\"subject=\"):].strip()\n        elif line.startswith(\"notAfter=\"):\n            not_after = line[len(\"notAfter=\"):].strip()\n\n    m = re.search(r\"CN\\s*=\\s*([^,/]+)\", subject)\n    cn = m.group("]
[56.658887, "o", "cat > /app/check_cert.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import ssl\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.659023, "i", "1).strip() if m else \"N/A\"\n\n    parts = not_after.split()\n    day = int(parts[1])\n    month = MONTHS.get(parts[0], 1)\n    year = int(parts[3])\n    exp_date = \"{:04d}-{:02d}-{:02d}\".format(year, month, day)\n\n    print(\"Common Name: \" + cn)\n    print(\"Expiration Date: \" + exp_date)\n    print(\"Certificate verification successful\")\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
