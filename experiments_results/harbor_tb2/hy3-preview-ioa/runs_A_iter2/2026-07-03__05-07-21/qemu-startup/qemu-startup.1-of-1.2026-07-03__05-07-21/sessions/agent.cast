[885.898196, "i", "cat > /tmp/mux2.py <<'PYEOF'\nimport socket, threading, time\nQEMU_ADDR=(\"127.0.0.1\",6666)\nTELNET_ADDR=(\"127.0.0.1\",6665)\nRAWLOG=\"/tmp/serial.log\"\nMAXHIST=4_000_000\nhistory=bytearray()\nhist_lock=threading.Lock()\ng_q=None\nq_lock=threading.Lock()\nclients=[]\nclients_lock=threading.Lock()\nopen(RAWLOG,\"w\").close()\ndef log(*a):\n    with open(\"/tmp/mux.log\",\"a\") as f:\n        f.write(time.strftime(\"%H:%M:%S \")+\" \".join(str(x) for x in a)+\"\\n\")\ndef broadcast(data):\n    with clients_lock:\n        dead=[]\n        for c in clients:\n            try: c.sendall(data)\n            except: dead.append(c)\n        for c in dead:\n            try: c.close()\n            except: pass\n            clients.remove(c)\ndef qemu_accept():\n    ls=socket.socket(); ls.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)\n    ls.bind(QEMU_ADDR); ls.listen(1)\n    log(\"mux listening for qemu on\",QEMU_ADDR)\n    while True:\n        conn,_=ls.accept(); log(\"qemu connected\")\n        with q_lock: globals()"]
[885.898628, "o", "cat > /tmp/mux2.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import socket, threading, time\r\n\u001b[?2004l\r\u001b[?2004h> QEMU_ADDR=(\"127.0.0.1\",6666)\r\n\u001b[?2004l\r"]
