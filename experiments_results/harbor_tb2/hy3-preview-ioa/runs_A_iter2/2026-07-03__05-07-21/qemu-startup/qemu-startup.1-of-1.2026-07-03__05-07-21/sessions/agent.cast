[886.07457, "o", "nohup qemu-system-x86_64 \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[886.074727, "o", "> "]
[886.075107, "o", "  -m 512 -smp 2 \\\r\n\u001b[?2004l\r\u001b[?2004h>   -kernel /tmp/vmlinuz-lts \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[886.076484, "o", ">   -initrd /tmp/initramfs-lts \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.076852, "o", "  -append \"modules=loop,squashfs,sd-mod,usb-storage console=ttyS0\" \\"]
[886.077173, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   -cdrom /app/alpine.iso \\\r\n"]
[886.077441, "o", "\u001b[?2004l\r\u001b[?2004h>   -net none \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[886.07784, "o", ">   -display none \\\r\n\u001b[?2004l\r\u001b[?2004h>   -pidfile /tmp/qemu.pid \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.078166, "o", "  -serial tcp:127.0.0.1:6666 \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.0789, "o", "  > /tmp/qemu.log 2>&1 &\r\n"]
