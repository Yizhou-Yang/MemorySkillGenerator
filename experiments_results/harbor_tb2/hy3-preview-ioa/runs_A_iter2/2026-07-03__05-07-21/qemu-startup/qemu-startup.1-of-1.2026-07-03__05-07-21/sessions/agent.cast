[416.341593, "i", "cat > /tmp/extract2.py <<'PYEOF'\nimport struct\nISO=\"/app/alpine.iso\"; OUT=\"/tmp\"\ndef read_sec(f,lba,n=1):\n    f.seek(lba*2048); return f.read(2048*n)\ndef norm(nm):\n    nm=nm.split(b\";\")[0].decode(\"latin1\")\n    while nm.endswith(\".\"): nm=nm[:-1]\n    return nm\ndef parse(f,lba,length):\n    f.seek(lba*2048); data=f.read(((length+2047)//2048)*2048)\n    off=0;n=len(data);res=[]\n    while off<n:\n        rl=data[off]\n        if rl==0:\n            off=(off//2048+1)*2048\n            if off>=n:break\n            continue\n        if off+rl>n:break\n        flags=data[off+25]; loc=struct.unpack_from(\"<I\",data,off+2)[0]; dlen=struct.unpack_from(\"<I\",data,off+10)[0]\n        nl=data[off+32]; nm=norm(data[off+33:off+33+nl])\n        res.append((nm,bool(flags&2),loc,dlen)); off+=rl\n    return res\ndef walk(f,parts):\n    pvd=read_sec(f,16); loc=struct.unpack_from(\"<I\",pvd,158)[0]; leng=struct.unpack_from(\"<I\",pvd,166)[0]\n    for i,p in enumerate(parts):\n        found=None\n        for nm,isd,l,d in parse(f,loc,leng):\n            if "]
[416.341657, "o", "cat > /tmp/extract2.py <<'PYEOF'"]
[416.341801, "i", "nm.upper()==p.upper(): found=(nm,isd,l,d);break\n        if not found: raise SystemExit(\"MISSING \"+p)\n        nm,isd,l,d=found\n        if i==len(parts)-1: return l,d\n        loc,length=l,d\nwith open(ISO,\"rb\") as f:\n    for name,path in [(\"VMLINUZ_LTS\",\"vmlinuz-lts\"),(\"INITRAMFS_LTS\",\"initramfs-lts\")]:\n        l,d=walk(f,[\"BOOT\",name])\n        f.seek(l*2048); open(OUT+\"/\"+path,\"wb\").write(f.read(d))\n        print(\"extracted\",path,d,\"bytes\")\n    l,d=walk(f,[\"BOOT\",\"SYSLINUX\"])\n    for nm,isd,l2,d2 in parse(f,l,d):\n        print(\"SYSLINUX:\",nm,\"DIR\" if isd else \"FILE\",l2,d2)\n    # extract cfg files\n    for nm,isd,l2,d2 in parse(f,l,d):\n        if not isd and nm.upper().endswith(\".CFG\"):\n            f.seek(l2*2048); open(OUT+\"/\"+nm,\"wb\").write(f.read(d2))\n            print(\"wrote\",nm)\nPYEOF\n"]
