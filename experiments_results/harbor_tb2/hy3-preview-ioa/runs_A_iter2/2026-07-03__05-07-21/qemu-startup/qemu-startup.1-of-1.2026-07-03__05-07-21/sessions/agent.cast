[520.798523, "o", "\u001b[?2004h"]
[520.798569, "o", "> "]
[520.798735, "o", "    with open(\"/tmp/mux.log\",\"a\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.798961, "o", "        f.write(time.strftime(\"%H:%M:%S \")+\" \".join(str(x) for x in a)+\"\\n\")\r\n\u001b[?2004l\r"]
[520.799013, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[520.799038, "o", "\u001b[?2004h"]
[520.799057, "o", "> "]
[520.79915, "o", "def qemu_connect():\r\n\u001b[?2004l\r"]
[520.799171, "o", "\u001b[?2004h> "]
[520.799251, "o", "    while True:\r\n\u001b[?2004l\r"]
[520.799299, "o", "\u001b[?2004h> "]
[520.799359, "o", "        try:\r\n\u001b[?2004l\r"]
[520.799391, "o", "\u001b[?2004h> "]
[520.799597, "o", "            s=socket.create_connection(QEMU_ADDR,timeout=5)\r\n\u001b[?2004l\r"]
[520.799635, "o", "\u001b[?2004h> "]
[520.7998, "o", "            log(\"connected to qemu\",QEMU_ADDR)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.799917, "o", "            return s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.800032, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[520.800064, "o", "\u001b[?2004h> "]
[520.80025, "o", "            log(\"qemu connect retry:\",e); time.sleep(1)\r\n\u001b[?2004l\r"]
[520.800291, "o", "\u001b[?2004h> "]
[520.82466, "o", "\r\n\u001b[?2004l\r"]
[520.824768, "o", "\u001b[?2004h> def reader(q):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.824841, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.824864, "o", "        try:\r\n\u001b[?2004l\r"]
[520.82488, "o", "\u001b[?2004h"]
[520.8249, "o", "> "]
[520.825006, "o", "            data=q.recv(65536)"]
[520.82509, "o", "\r\n"]
[520.825147, "o", "\u001b[?2004l\r"]
[520.825347, "o", "\u001b[?2004h>         except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.825463, "o", "            log(\"qemu recv error, reconnecting\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.826754, "o", "            try: q.close()\r\n\u001b[?2004l\r\u001b[?2004h>             except: pass\r\n\u001b[?2004l\r\u001b[?2004h>             q=qemu_connect(); continue\r\n\u001b[?2004l\r\u001b[?2004h>         if not data:\r\n\u001b[?2004l\r\u001b[?2004h>             log(\"qemu closed, reconnecting\")\r\n\u001b[?2004l\r\u001b[?2004h>             try: q.close()\r\n\u001b[?2004l\r\u001b[?2004h>             except: pass\r\n\u001b[?2004l\r\u001b[?2004h>             q=qemu_connect(); continue\r\n\u001b[?2004l\r\u001b[?2004h>         with hist_lock:\r\n\u001b[?2004l\r\u001b[?2004h>             history.extend(data)\r\n\u001b[?2004l\r\u001b[?2004h>             if len(history)>MAXHIST: del history[:-MAXHIST]\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.827203, "o", "            with open(RAWLOG,\"a\") as f: f.write(data.decode(\"latin1\",\"replace\"))\r\n\u001b[?2004l\r\u001b[?2004h>         except: pass\r\n\u001b[?2004l\r\u001b[?2004h>         with clients_lock:\r\n\u001b[?2004l\r\u001b[?2004h>             dead=[]\r\n\u001b[?2004l\r\u001b[?2004h>             for c in clients:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.827714, "o", "                try: c.sendall(data)\r\n\u001b[?2004l\r\u001b[?2004h>                 except: dead.append(c)"]
[520.837553, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             for c in dead:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.837642, "o", "                try: c.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.837792, "o", "                except: pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[520.838063, "o", ">                 clients.remove(c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.838311, "o", "def client_to_qemu(c,q):\r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.838345, "o", "        try: data=c.recv(4096)\r\n\u001b[?2004l\r"]
[520.838392, "o", "\u001b[?2004h> "]
[520.83843, "o", "        except: break\r\n\u001b[?2004l\r"]
[520.838454, "o", "\u001b[?2004h> "]
[520.838555, "o", "        if not data: break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.847289, "o", "        try: q.sendall(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.847384, "o", "        except: break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.847468, "o", "    with clients_lock:\r\n\u001b[?2004l\r"]
[520.847512, "o", "\u001b[?2004h> "]
[520.847751, "o", "        if c in clients: clients.remove(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.84786, "o", "    try: c.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.848102, "o", "    except: pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def serve():\r\n\u001b[?2004l\r\u001b[?2004h"]
[520.848137, "o", "> "]
[520.848343, "o", "    ls=socket.socket(socket.AF_INET,socket.SOCK_STREAM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.848564, "o", "    ls.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)\r\n\u001b[?2004l\r"]
[520.87316, "o", "\u001b[?2004h> "]
[520.873249, "o", "    ls.bind(LISTEN_ADDR); ls.listen(5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.873326, "o", "    log(\"mux listening on\",LISTEN_ADDR)\r\n\u001b[?2004l\r"]
[520.873345, "o", "\u001b[?2004h> "]
[520.873399, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.87348, "o", "        c,_=ls.accept()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.873857, "o", "        log(\"client connect\")\r\n\u001b[?2004l\r\u001b[?2004h>         with hist_lock: h=bytes(history)\r\n\u001b[?2004l\r\u001b[?2004h>         try: c.sendall(h)\r\n\u001b[?2004l\r\u001b[?2004h>         except:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.873952, "o", "            c.close(); continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.874104, "o", "        with clients_lock: clients.append(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.874366, "o", "        threading.Thread(target=client_to_qemu,args=(c,q),daemon=True).start()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.874392, "o", "def main():\r\n\u001b[?2004l\r"]
[520.874416, "o", "\u001b[?2004h> "]
[520.874582, "o", "    open(\"/tmp/mux.log\",\"w\").close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.87467, "o", "    q=qemu_connect()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.879869, "o", "    threading.Thread(target=reader,args=(q,),daemon=True).start()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[520.880034, "o", "    serve()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> main()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[520.883159, "o", "\u001b[?2004hroot@68b41fa74434:/app# "]
[520.951826, "i", "cat > /tmp/run.sh <<'SH'\n#!/bin/bash\nset -e\nnohup qemu-system-x86_64 \\\n  -m 512 -smp 2 \\\n  -kernel /tmp/vmlinuz-lts \\\n  -initrd /tmp/initramfs-lts \\\n  -append \"modules=loop,squashfs,sd-mod,usb-storage console=ttyS0\" \\\n  -cdrom /app/alpine.iso \\\n  -net none \\\n  -display none \\\n  -pidfile /tmp/qemu.pid \\\n  -serial tcp:127.0.0.1:6666,server,nowait \\\n  > /tmp/qemu.log 2>&1 &\necho \"qemu pid $!\"\nnohup python3 /tmp/mux.py > /tmp/mux.stdout 2>&1 &\necho \"mux pid $!\"\nSH\n"]
