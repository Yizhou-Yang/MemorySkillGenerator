[671.967739, "i", "cat > /tmp/probe.py <<'PYEOF'\nimport socket,time\ns=socket.create_connection((\"127.0.0.1\",6665),timeout=5)\ns.settimeout(2.5)\nbuf=b\"\"\ntry:\n    while True:\n        d=s.recv(4096)\n        if not d: break\n        buf+=d\nexcept Exception as e:\n    pass\nprint(\"AFTER CONNECT, last 200 bytes of replay:\")\nprint(repr(buf[-200:]))\ns.sendall(b\"\\n\")\ntime.sleep(2)\ntry:\n    while True:\n        d=s.recv(4096)\n        if not d: break\n        buf+=d\nexcept: pass\nprint(\"AFTER sending newline, total buf len:\", len(buf))\nprint(\"login occurrences:\", buf.count(b\"login:\"))\nprint(\"last 200 bytes:\")\nprint(repr(buf[-200:]))\ns.close()\nPYEOF\npython3 /tmp/probe.py\n"]
[671.967795, "o", "cat > /tmp/probe.py <<'PYEOF'"]
