[886.071997, "i", "cat > /tmp/run2.sh <<'SH'\n#!/bin/bash\nnohup python3 /tmp/mux2.py > /tmp/mux2.stdout 2>&1 &\necho \"mux pid $!\"\nsleep 1\nnohup qemu-system-x86_64 \\\n  -m 512 -smp 2 \\\n  -kernel /tmp/vmlinuz-lts \\\n  -initrd /tmp/initramfs-lts \\\n  -append \"modules=loop,squashfs,sd-mod,usb-storage console=ttyS0\" \\\n  -cdrom /app/alpine.iso \\\n  -net none \\\n  -display none \\\n  -pidfile /tmp/qemu.pid \\\n  -serial tcp:127.0.0.1:6666 \\\n  > /tmp/qemu.log 2>&1 &\necho \"qemu pid $!\"\nSH\n"]
[886.073725, "o", "cat > /tmp/run2.sh <<'SH'\r\n\u001b[?2004l\r"]
[886.073828, "o", "\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
