[335.635639, "i", "cat > /tmp/extract.py <<'PYEOF'\nimport struct\nISO=\"/app/alpine.iso\"\nOUT=\"/tmp\"\ndef read_sector(f,lba,count=1):\n    f.seek(lba*2048)\n    return f.read(2048*count)\ndef parse_dir(f,lba,length,cb):\n    sectors=(length+2047)//2048\n    f.seek(lba*2048)\n    data=f.read(sectors*2048)\n    off=0\n    n=len(data)\n    while off<n:\n        rec_len=data[off]\n        if rec_len==0:\n            off=(off//2048+1)*2048\n            if off>=n: break\n            continue\n        if off+rec_len>n: break\n        flags=data[off+25]\n        loc=struct.unpack_from(\"<I\",data,off+2)[0]\n        dlen=struct.unpack_from(\"<I\",data,off+10)[0]\n        name_len=data[off+32]\n        name=data[off+33:off+33+name_len]\n        nm=name.split(b\";\")[0].decode(\"latin1\")\n        is_dir=bool(flags & 2)\n        cb(nm,is_dir,loc,dlen)\n        off+=rec_len\ndef find(f,parts):\n    parts=[p.upper() for p in parts]\n    pvd=read_sector(f,16)\n    cur_loc=struct.unpack_from(\"<I\",pvd,156+2)[0]\n    cur_len=struct.unpack_from(\"<I\",pvd,156+10)[0]\n    for i,part in enu"]
[335.635727, "i", "merate(parts):\n        found=[None]\n        def cb(nm,is_dir,loc,dlen):\n            if nm.upper()==part:\n                found[0]=(nm,is_dir,loc,dlen)\n        parse_dir(f,cur_loc,cur_len,cb)\n        if not found[0]:\n            raise SystemExit(\"NOT FOUND: \"+part)\n        nm,is_dir,loc,dlen=found[0]\n        if i==len(parts)-1:\n            return loc,dlen\n        if not is_dir:\n            raise SystemExit(\"NOT DIR: \"+part)\n        cur_loc=loc; cur_len=dlen\ndef extract(f,parts,outp):\n    loc,dlen=find(f,parts)\n    f.seek(loc*2048)\n    data=f.read(dlen)\n    with open(outp,\"wb\") as o:\n        o.write(data)\n    print(\"extracted\", \"/\".join(parts), len(data), \"->\", outp)\nwith open(ISO,\"rb\") as f:\n    extract(f,[\"boot\",\"vmlinuz-lts\"],OUT+\"/vmlinuz-lts\")\n    extract(f,[\"boot\",\"initramfs-lts\"],OUT+\"/initramfs-lts\")\nPYEOF\n"]
