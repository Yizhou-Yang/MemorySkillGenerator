[350.841082, "i", "cat > /tmp/list.py <<'PYEOF'\nimport struct\nISO=\"/app/alpine.iso\"\ndef read_sector(f,lba):\n    f.seek(lba*2048); return f.read(2048)\ndef parse_dir(f,lba,length):\n    f.seek(lba*2048); data=f.read(((length+2047)//2048)*2048)\n    off=0; n=len(data); res=[]\n    while off<n:\n        rec_len=data[off]\n        if rec_len==0:\n            off=(off//2048+1)*2048\n            if off>=n: break\n            continue\n        if off+rec_len>n: break\n        flags=data[off+25]\n        loc=struct.unpack_from(\"<I\",data,off+2)[0]\n        dlen=struct.unpack_from(\"<I\",data,off+10)[0]\n        name_len=data[off+32]\n        nm=data[off+33:off+33+name_len].split(b\";\")[0].decode(\"latin1\")\n        res.append((nm,bool(flags&2),loc,dlen))\n        off+=rec_len\n    return res\nwith open(ISO,\"rb\") as f:\n    pvd=read_sector(f,16)\n    loc=struct.unpack_from(\"<I\",pvd,156+2)[0]\n    leng=struct.unpack_from(\"<I\",pvd,156+10)[0]\n    print(\"ROOT:\")\n    for nm,isd,l,d in parse_dir(f,loc,leng):\n        print(\"  \", repr(nm), \"DIR\" if isd else \"FILE\", l, d)"]
[350.841577, "o", "cat > /tmp/list.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct\r\n\u001b[?2004l\r\u001b[?2004h> ISO=\"/app/alpine.iso\"\r\n\u001b[?2004l\r\u001b[?2004h> def read_sector(f,lba):\r\n\u001b[?2004l\r\u001b[?2004h>     f.seek(lba*2048); return f.read(2048)\r\n\u001b[?2004l\r\u001b[?2004h> def parse_dir(f,lba,length):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.843891, "i", "\n    for nm,isd,l,d in parse_dir(f,loc,leng):\n        if isd and nm not in (\".\",\"..\"):\n            print(\"DIR\", nm, \"contents:\")\n            for nm2,isd2,l2,d2 in parse_dir(f,l,d):\n                print(\"     \", repr(nm2), \"DIR\" if isd2 else \"FILE\", l2, d2)\nPYEOF\n"]
