[885.900649, "o", "            clients.remove(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[885.900923, "o", "def qemu_accept():\r\n\u001b[?2004l\r\u001b[?2004h>     ls=socket.socket(); ls.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
