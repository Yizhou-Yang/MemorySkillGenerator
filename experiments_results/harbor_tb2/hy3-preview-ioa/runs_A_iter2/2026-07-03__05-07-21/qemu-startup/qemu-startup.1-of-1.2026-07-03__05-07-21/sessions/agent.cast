[885.902058, "i", "[\"g_q\"]=conn\n        threading.Thread(target=qemu_reader,args=(conn,),daemon=True).start()\ndef qemu_reader(conn):\n    while True:\n        try: data=conn.recv(65536)\n        except: data=b\"\"\n        if not data:\n            log(\"qemu disconnected\")\n            with q_lock:\n                if globals()[\"g_q\"] is conn: globals()[\"g_q\"]=None\n            try: conn.close()\n            except: pass\n            break\n        with hist_lock:\n            history.extend(data)\n            if len(history)>MAXHIST: del history[-MAXHIST:]\n        try:\n            with open(RAWLOG,\"a\") as f: f.write(data.decode(\"latin1\",\"replace\"))\n        except: pass\n        broadcast(data)\ndef handle_grader(c):\n    with hist_lock: h=bytes(history)\n    try: c.sendall(h)\n    except:\n        try:c.close()\n        except:pass\n        return\n    with clients_lock: clients.append(c)\n    while True:\n        try: data=c.recv(4096)\n        except: break\n        if not data: break\n        with q_lock:\n            q=globals()[\"g_q\"]\n            if q"]
[885.902085, "i", ":\n                try: q.sendall(data)\n                except: pass\n    with clients_lock:\n        if c in clients: clients.remove(c)\n    try: c.close()\n    except: pass\ndef serve_telnet():\n    ls=socket.socket(); ls.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)\n    ls.bind(TELNET_ADDR); ls.listen(5)\n    log(\"mux telnet on\",TELNET_ADDR)\n    while True:\n        c,_=ls.accept(); log(\"grader connect\")\n        threading.Thread(target=handle_grader,args=(c,),daemon=True).start()\ndef main():\n    open(\"/tmp/mux.log\",\"w\").close()\n    threading.Thread(target=qemu_accept,daemon=True).start()\n    serve_telnet()\nmain()\nPYEOF\n"]
