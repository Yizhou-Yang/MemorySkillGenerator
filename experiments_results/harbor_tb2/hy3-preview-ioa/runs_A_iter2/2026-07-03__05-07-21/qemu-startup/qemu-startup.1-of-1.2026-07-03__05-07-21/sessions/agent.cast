[885.899917, "o", "def broadcast(data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[885.89996, "o", "    with clients_lock:\r\n\u001b[?2004l\r"]
[885.900003, "o", "\u001b[?2004h> "]
[885.900225, "o", "        dead=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for c in clients:\r\n\u001b[?2004l\r\u001b[?2004h>             try: c.sendall(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[885.900326, "o", "            except: dead.append(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
