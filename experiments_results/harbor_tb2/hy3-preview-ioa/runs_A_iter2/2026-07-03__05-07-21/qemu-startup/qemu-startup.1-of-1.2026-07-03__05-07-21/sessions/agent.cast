[520.767654, "i", "cat > /tmp/mux.py <<'PYEOF'\nimport socket, threading, time, sys\n\nQEMU_ADDR=(\"127.0.0.1\",6666)\nLISTEN_ADDR=(\"127.0.0.1\",6665)\nRAWLOG=\"/tmp/serial.log\"\nMAXHIST=4_000_000\n\nhistory=bytearray()\nhist_lock=threading.Lock()\nclients=[]\nclients_lock=threading.Lock()\n\nopen(RAWLOG,\"w\").close()\n\ndef log(*a):\n    with open(\"/tmp/mux.log\",\"a\") as f:\n        f.write(time.strftime(\"%H:%M:%S \")+\" \".join(str(x) for x in a)+\"\\n\")\n\ndef qemu_connect():\n    while True:\n        try:\n            s=socket.create_connection(QEMU_ADDR,timeout=5)\n            log(\"connected to qemu\",QEMU_ADDR)\n            return s\n        except Exception as e:\n            log(\"qemu connect retry:\",e); time.sleep(1)\n\ndef reader(q):\n    while True:\n        try:\n            data=q.recv(65536)\n        except Exception:\n            log(\"qemu recv error, reconnecting\")\n            try: q.close()\n            except: pass\n            q=qemu_connect(); continue\n        if not data:\n            log(\"qemu closed, reco"]
[520.767752, "i", "nnecting\")\n            try: q.close()\n            except: pass\n            q=qemu_connect(); continue\n        with hist_lock:\n            history.extend(data)\n            if len(history)>MAXHIST: del history[:-MAXHIST]\n        try:\n            with open(RAWLOG,\"a\") as f: f.write(data.decode(\"latin1\",\"replace\"))\n        except: pass\n        with clients_lock:\n            dead=[]\n            for c in clients:\n                try: c.sendall(data)\n                except: dead.append(c)\n            for c in dead:\n                try: c.close()\n                except: pass\n                clients.remove(c)\n\ndef client_to_qemu(c,q):\n    while True:\n        try: data=c.recv(4096)\n        except: break\n        if not data: break\n        try: q.sendall(data)\n        except: break\n    with clients_lock:\n        if c in clients: clients.remove(c)\n    try: c.close()\n    except: pass\n\ndef serve():\n    ls=socket.socket(socket.AF_INET,socket.SOCK_STREAM)\n    ls.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)\n    ls.bind("]
[520.767777, "i", "LISTEN_ADDR); ls.listen(5)\n    log(\"mux listening on\",LISTEN_ADDR)\n    while True:\n        c,_=ls.accept()\n        log(\"client connect\")\n        with hist_lock: h=bytes(history)\n        try: c.sendall(h)\n        except:\n            c.close(); continue\n        with clients_lock: clients.append(c)\n        threading.Thread(target=client_to_qemu,args=(c,q),daemon=True).start()\n\ndef main():\n    open(\"/tmp/mux.log\",\"w\").close()\n    q=qemu_connect()\n    threading.Thread(target=reader,args=(q,),daemon=True).start()\n    serve()\n\nmain()\nPYEOF\n"]
