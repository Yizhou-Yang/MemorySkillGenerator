[1476.109068, "m", "Episode 45: 3 commands"]
[1476.109068, "o", "root@84e2f2396ab6:/app/frotz# "]
[1515.868444, "i", "cat > /app/play3.py <<'PYEOF'\nimport os, sys, time, pwd, fcntl, termios, struct, threading\n\ndef main():\n    cmds = [c for c in open(sys.argv[1]).read().split('\\n') if c.strip() != '']\n    master, slave = os.openpty()\n    # set window size 40x80\n    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 40, 80, 0, 0))\n    pid = os.fork()\n    if pid == 0:\n        os.setsid()\n        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)\n        os.dup2(slave, 0)\n        os.dup2(slave, 1)\n        os.dup2(slave, 2)\n        os.close(master)\n        uid = pwd.getpwnam('player').pw_uid\n        gid = pwd.getpwnam('player').pw_gid\n        os.setgid(gid)\n        os.setuid(uid)\n        os.environ['TERM'] = 'dumb'\n        os.execv('/app/frotz/frotz', ['frotz', '/app/frotz/zork1.z5'])\n    os.close(slave)\n    out = open('/app/transcript.txt', 'wb')\n    def writer():\n        time.sleep(0.8)\n        for c in cmds:\n            os.write(master, (c + '\\n').encode())\n            time.sleep(0"]
[1515.869135, "o", "cat > /app/play3.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1515.869474, "o", "> "]
[1515.869615, "o", "import os, sys, time, pwd, fcntl, termios, struct, threading"]
