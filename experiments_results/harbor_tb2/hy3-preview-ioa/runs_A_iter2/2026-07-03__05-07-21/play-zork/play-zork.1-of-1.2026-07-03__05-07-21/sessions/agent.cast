[1566.431701, "i", "cat > /app/play4.py <<'PYEOF'\nimport os, pty, sys, time, select, pwd, threading\n\ndef main():\n    cmds = [c for c in open(sys.argv[1]).read().split('\\n') if c.strip() != '']\n    uid = pwd.getpwnam('player').pw_uid\n    gid = pwd.getpwnam('player').pw_gid\n    pid, fd = pty.fork()\n    if pid == 0:\n        os.setgid(gid)\n        os.setuid(uid)\n        os.environ['TERM'] = 'dumb'\n        os.environ['LINES'] = '40'\n        os.environ['COLUMNS'] = '80'\n        os.execv('/app/frotz/frotz', ['frotz', '/app/frotz/zork1.z5'])\n    out = open('/app/transcript.txt', 'wb')\n    def writer():\n        time.sleep(0.8)\n        for c in cmds:\n            os.write(fd, (c + '\\n').encode())\n            time.sleep(0.2)\n        time.sleep(0.5)\n        os.write(fd, b'\\n')\n        time.sleep(0.5)\n    t = threading.Thread(target=writer)\n    t.start()\n    deadline = time.time() + 30\n    while time.time() < deadline:\n        r, _, _ = select.select([fd], [], [], 0.5)\n        if r:\n            try:\n                d = os.read(fd, 65536)\n            except OSError:\n                break\n            if not d:\n                break\n            out.write(d)\n            out.flush()\n    out.close()\n    try:\n        os.waitpid(pid, 0)\n    except Exception:\n        pass\n\nmain()\nPYEOF\n"]
[1566.432883, "o", "cat > /app/play4.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os, pty, sys, time, select, pwd, threading\r\n\u001b[?2004l\r\u001b[?2004h> "]
