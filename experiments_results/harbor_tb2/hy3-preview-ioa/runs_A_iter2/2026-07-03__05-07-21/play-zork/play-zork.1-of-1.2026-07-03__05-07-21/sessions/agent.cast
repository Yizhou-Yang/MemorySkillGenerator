[1418.69535, "i", "cat > /app/dbg.py <<'PYEOF'\nimport os, pty, time, select\npid, fd = pty.fork()\nif pid == 0:\n    os.execv('/bin/bash', ['bash', '-c', 'echo LINE_A; echo LINE_B; sleep 0.3; echo LINE_C'])\nout = open('/app/dbg.txt', 'wb')\ntime.sleep(0.6)\nr,_,_ = select.select([fd], [], [], 2)\nd = b''\nwhile True:\n    r,_,_ = select.select([fd], [], [], 0.4)\n    if not r:\n        break\n    try:\n        chunk = os.read(fd, 65536)\n    except OSError:\n        break\n    if not chunk:\n        break\n    d += chunk\nout.write(d)\nout.close()\ntry:\n    os.waitpid(pid, 0)\nexcept Exception:\n    pass\nprint('CAPTURED_LEN', len(d))\nPYEOF\n"]
[1418.698145, "o", "cat > /app/dbg.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os, pty, time, select\r\n\u001b[?2004l\r\u001b[?2004h> pid, fd = pty.fork()\r\n\u001b[?2004l\r\u001b[?2004h> if pid == 0:\r\n\u001b[?2004l\r\u001b[?2004h>     os.execv('/bin/bash', ['bash', '-c', 'echo LINE_A; echo LINE_B; sleep 0.3; echo LINE_C'])\r\n\u001b[?2004l\r\u001b[?2004h> out = open('/app/dbg.txt', 'wb')\r\n\u001b[?2004l\r\u001b[?2004h> time.sleep(0.6)\r\n\u001b[?2004l\r\u001b[?2004h> r,_,_ = select.select([fd], [], [], 2)\r\n\u001b[?2004l\r\u001b[?2004h> d = b''\r\n\u001b[?2004l\r\u001b[?2004h> while True:\r\n\u001b[?2004l\r\u001b[?2004h>     r,_,_ = select.select([fd], [], [], 0.4)\r\n\u001b[?2004l\r\u001b[?2004h>     if not r:\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         chunk = os.read(fd, 65536)\r\n\u001b[?2004l\r\u001b[?2004h>     except OSError:\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h>     if not chunk:\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h>     d += chunk"]
