[1024.210711, "i", "cat > /app/play.py <<'PYEOF'\nimport os, pty, sys, time, select\ndef main():\n    cmds=[c for c in open(sys.argv[1]).read().split('\\n') if c.strip()!='']\n    pid,fd=pty.fork()\n    if pid==0:\n        os.environ['TERM']='dumb'\n        os.execv('/app/frotz/frotz',['frotz','/app/frotz/zork1.z5'])\n    out=open('/app/transcript.txt','wb')\n    time.sleep(0.6)\n    for c in cmds:\n        os.write(fd,(c+'\\n').encode()); time.sleep(0.2)\n    os.write(fd,b'quit\\n'); time.sleep(0.4)\n    os.write(fd,b'y\\n'); time.sleep(0.4)\n    end=time.time()+2\n    while time.time()<end:\n        r,_,_=select.select([fd],[],[],0.3)\n        if r:\n            try:\n                d=os.read(fd,4096)\n                if not d: break\n                out.write(d); out.flush()\n            except OSError: break\n    out.close()\n    try: os.waitpid(pid,0)\n    except: pass\nmain()\nPYEOF\n"]
