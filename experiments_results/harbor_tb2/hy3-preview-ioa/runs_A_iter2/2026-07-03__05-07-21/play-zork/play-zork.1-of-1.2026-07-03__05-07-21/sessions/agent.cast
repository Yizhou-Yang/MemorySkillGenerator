[1882.174877, "i", "cat > /app/play6.py <<'PYEOF'\nimport os, pty, sys, time, pwd\n\ndef main():\n    cmds = [c for c in open(sys.argv[1]).read().split('\\n') if c.strip() != '']\n    uid = pwd.getpwnam('player').pw_uid\n    gid = pwd.getpwnam('player').pw_gid\n    pid, fd = pty.fork()\n    if pid == 0:\n        os.setgid(gid)\n        os.setuid(uid)\n        os.environ['TERM'] = 'dumb'\n        os.environ['LINES'] = '40'\n        os.environ['COLUMNS'] = '80'\n        os.execv('/app/frotz/frotz', ['frotz', '/app/frotz/zork1.z5'])\n    out = open('/app/transcript.txt', 'wb')\n    time.sleep(1.0)\n    def read_one():\n        try:\n            return os.read(fd, 65536)\n        except OSError:\n            return b''\n    # initial banner read\n    time.sleep(0.3)\n    out.write(read_one())\n    for c in cmds:\n        os.write(fd, (c + '\\n').encode())\n        time.sleep(0.3)\n        d = read_one()\n        out.write(d)\n    # trailing newline to dismiss 'Hit any key to exit.'\n    os.write(fd, b'\\n')\n    time.sleep(0.4)\n    d = read_one()\n    out.write(d)\n    out.close()\n    try:\n        os.waitpid(pid, 0)\n    except Exception:\n        pass\n\nmain()\nPYEOF\n"]
