[1613.526012, "i", "cat > /app/t.py <<'PYEOF'\nimport os, pty, pwd, time, sys\nuid = pwd.getpwnam('player').pw_uid\ngid = pwd.getpwnam('player').pw_gid\npid, fd = pty.fork()\nif pid == 0:\n    os.setgid(gid); os.setuid(uid)\n    os.environ['TERM']='dumb'\n    os.execv('/app/frotz/frotz',['frotz','/app/frotz/zork1.z5'])\nout=open('/app/tout.txt','wb')\ntime.sleep(1.0)\nos.write(fd,b'open mailbox\\n'); time.sleep(0.5)\ntry:\n    out.write(os.read(fd,65536))\nexcept OSError as e:\n    out.write(('ERR '+str(e)+'\\n').encode())\nos.write(fd,b'look\\n'); time.sleep(0.5)\ntry:\n    out.write(os.read(fd,65536))\nexcept OSError as e:\n    out.write(('ERR '+str(e)+'\\n').encode())\nos.write(fd,b'quit\\n'); time.sleep(0.3)\nos.write(fd,b'y\\n'); time.sleep(0.5)\ntry:\n    out.write(os.read(fd,65536))\nexcept OSError as e:\n    out.write(('ERR '+str(e)+'\\n').encode())\nout.close()\nprint('child exit', os.waitpid(pid,0))\nPYEOF\n"]
