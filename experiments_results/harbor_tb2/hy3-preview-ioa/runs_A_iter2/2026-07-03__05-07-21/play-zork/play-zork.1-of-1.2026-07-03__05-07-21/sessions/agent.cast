[1114.877211, "i", "cat > /app/play.py <<'PYEOF'\nimport os, pty, sys, time, select\n\ndef main():\n    cmds = [c for c in open(sys.argv[1]).read().split('\\n') if c.strip() != '']\n    pid, fd = pty.fork()\n    if pid == 0:\n        os.environ['TERM'] = 'dumb'\n        os.environ['LINES'] = '40'\n        os.environ['COLUMNS'] = '80'\n        os.execv('/app/frotz/frotz', ['frotz', '/app/frotz/zork1.z5'])\n    out = open('/app/transcript.txt', 'wb')\n    time.sleep(0.8)\n    for c in cmds:\n        os.write(fd, (c + '\\n').encode())\n        time.sleep(0.15)\n    end = time.time() + 3\n    while time.time() < end:\n        r, _, _ = select.select([fd], [], [], 0.3)\n        if r:\n            try:\n                d = os.read(fd, 65536)\n            except OSError:\n                break\n            if not d:\n                break\n            out.write(d)\n            out.flush()\n            end = time.time() + 2\n    out.close()\n    try:\n        os.waitpid(pid, 0)\n    except Exception:\n        pass\n\nmain()\nPYEOF\n"]
