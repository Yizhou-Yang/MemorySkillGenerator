[1515.871825, "i", ".2)\n        time.sleep(0.5)\n        os.write(master, b'\\n')\n        time.sleep(0.5)\n    t = threading.Thread(target=writer)\n    t.start()\n    while True:\n        try:\n            d = os.read(master, 65536)\n        except OSError:\n            break\n        if not d:\n            break\n        out.write(d)\n        out.flush()\n    out.close()\n    try:\n        os.waitpid(pid, 0)\n    except Exception:\n        pass\n\nmain()\nPYEOF\n"]
