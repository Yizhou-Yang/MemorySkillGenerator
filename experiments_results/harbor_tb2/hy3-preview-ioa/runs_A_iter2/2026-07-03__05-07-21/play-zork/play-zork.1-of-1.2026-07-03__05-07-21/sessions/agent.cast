[1467.65553, "i", "cat > /app/play2.py <<'PYEOF'\nimport os, pty, sys, time, select, pwd, threading\n\ndef main():\n    cmds = [c for c in open(sys.argv[1]).read().split('\\n') if c.strip() != '']\n    uid = pwd.getpwnam('player').pw_uid\n    gid = pwd.getpwnam('player').pw_gid\n    pid, fd = pty.fork()\n    if pid == 0:\n        os.setgid(gid)\n        os.setuid(uid)\n        os.environ['TERM'] = 'dumb'\n        os.environ['LINES'] = '40'\n        os.environ['COLUMNS'] = '80'\n        os.execv('/app/frotz/frotz', ['frotz', '/app/frotz/zork1.z5'])\n    out = open('/app/transcript.txt', 'wb')\n    stop = threading.Event()\n    def writer():\n        time.sleep(0.8)\n        for c in cmds:\n            os.write(fd, (c + '\\n').encode())\n            time.sleep(0.2)\n        time.sleep(0.5)\n        os.write(fd, b'\\n')  # dismiss 'Hit any key to exit.'\n        time.sleep(0.3)\n        stop.set()\n    t = threading.Thread(target=writer)\n    t.start()\n    while True:\n        r, _, _ = select.select([fd], [], [], 0.4)\n        if r:\n            try:\n                d = os.read(fd, 65536)\n            except OSError:\n                break\n            if not d:\n                break\n            out.write(d)\n            out.flush()\n        if stop.is_set() and not r:\n            # give a moment for final output then stop\n            time.sleep(0.3)\n            break\n    out.close()\n    try:\n        os.waitpid(pid, 0)\n    except Exception:\n        pass\n\nmain()\nPYEOF\n"]
[1467.655965, "o", "cat > /app/play2.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.656259, "o", "import os, pty, sys, time, select, pwd, threading\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
