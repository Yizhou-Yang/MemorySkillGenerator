[434.399048, "i", "cat > /tmp/fitcheck.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nrows=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        rows.append((float(p[0]),float(p[1])))\nd=np.array(rows); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\ndef lor(x, x0, gamma, amp, off):\n    return off + amp*gamma**2/((x-x0)**2+gamma**2)\ncands={3745.1:80, 6329.4:80, 10289.9:600, 19139.5:1200}\nfor c,w in cands.items():\n    m=(x>=c-w)&(x<=c+w)\n    xx=x[m]; yy=y[m]\n    i0=np.argmax(yy); x0g=xx[i0]; amp0=yy[i0]-np.median(yy[:5])\n    off0=np.median(yy[-10:])\n    p0=[x0g, w*0.2, amp0, off0]\n    try:\n        popt,pcov=curve_fit(lor,xx,yy,p0=p0,maxfev=20000)\n        pred=lor(xx,*popt)\n        ss_res=np.sum((yy-pred)**2); ss_tot=np.sum((yy-yy.mean())**2)\n        r2=1-ss_res/ss_tot\n        print(f'cand={c:9.1f} R2={r2:.4f} x0={popt[0]:9.2f} gamma={popt[1]:9.2f} amp={popt[2]:10.2f} of"]
[434.399552, "o", "cat > /tmp/fitcheck.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if not line: continue\r\n\u001b[?2004l\r\u001b[?2004h>         p=line.replace(',','.').split()\r\n\u001b[?2004l\r\u001b[?2004h>         if len(p)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append((float(p[0]),float(p[1])))\r\n\u001b[?2004l\r\u001b[?2004h> d=np.array(rows); x=d[:,0]; y=d[:,1]\r\n\u001b[?2004l\r\u001b[?2004h> o=np.argsort(x); x=x[o]; y=y[o]\r\n\u001b[?2004l\r\u001b[?2004h> def lor(x, x0, gamma, amp, off):\r\n\u001b[?2004l\r\u001b[?2004h>     return off + amp*gamma**2/((x-x0)**2+gamma**2)\r\n\u001b[?2004l\r\u001b[?2004h> cands={3745.1:80, 6329.4:80, 10289.9:600, 19139.5:1200}\r\n\u001b[?2004l\r\u001b[?2004h> for c,w in cands.items():\r\n\u001b[?2004l\r\u001b[?2004h>     m=(x>=c-w)&(x<=c+w)\r\n\u001b[?2004l\r\u001b[?2004h>     xx=x[m]; yy=y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     i0=np.argmax(yy); x0g=xx[i0]; amp0="]
[434.40026, "i", "f={popt[3]:10.2f} npts={len(xx)}')\n    except Exception as e:\n        print('cand',c,'fail',e)\nEOF\npython3 /tmp/fitcheck.py\n"]
