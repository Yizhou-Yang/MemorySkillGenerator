[476.444043, "o", "\u001b[?2004h"]
[476.444189, "o", "> "]
[476.444418, "o", "o=np.argsort(x); x=x[o]; y=y[o]"]
[476.44463, "o", "\r\n"]
[476.444841, "o", "\u001b[?2004l\r"]
[476.444994, "o", "\u001b[?2004h"]
