[364.681784, "i", "cat > /tmp/peaks.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\nrows=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        rows.append((float(p[0]),float(p[1])))\nd=np.array(rows); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\n# robust background: fit polynomial on a downsampled + smoothed version\n# Use a moving median to estimate background then smooth\nfrom scipy.ndimage import median_filter\nyf = median_filter(y, size=151)\ncoef = np.polyfit(x, yf, 4)\nbg = np.polyval(coef, x)\nresid = y - bg\npk,_ = find_peaks(resid, prominence=1500)\nprint('candidate peaks (height above background):')\norder=np.argsort(resid[pk])[::-1]\nfor idx in order[:12]:\n    i=pk[idx]\n    print(f'x={x[i]:9.1f}  y={y[i]:9.1f}  above_bg={resid[i]:9.1f}  bg={bg[i]:9.1f}')\nEOF\npython3 /tmp/peaks.py\n"]
[364.685074, "o", "cat > /tmp/peaks.py << 'EOF'\r\n"]
[364.685127, "o", "\u001b[?2004l\r"]
