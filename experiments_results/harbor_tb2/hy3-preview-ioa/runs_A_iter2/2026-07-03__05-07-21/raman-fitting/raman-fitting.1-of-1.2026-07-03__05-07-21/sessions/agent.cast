[139.514853, "o", "\u001b[?2004hroot@4008c52d3fe4:/app# "]
[192.443515, "i", "cat > /tmp/win.py << 'EOF'\nimport numpy as np\nrows = []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        rows.append((float(p[0]),float(p[1])))\nd=np.array(rows); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\nfor lo,hi in [(9000,11000),(15000,20000),(3000,7000),(32000,34000)]:\n    m=(x>=lo)&(x<=hi)\n    xx=x[m]; yy=y[m]\n    if len(xx)==0: continue\n    print('=== window',lo,hi,'npts',len(xx),'===')\n    # downsample for printing\n    idx=np.linspace(0,len(xx)-1,min(40,len(xx))).astype(int)\n    for i in idx:\n        print(f'{xx[i]:.2f} {yy[i]:.2f}')\nEOF\npython3 /tmp/win.py\n"]
[192.443805, "o", "cat > /tmp/win.py << 'EOF'"]
