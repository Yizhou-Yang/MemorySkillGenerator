[476.437238, "i", "100,120])}.items():\n    print(name, 'cand', c)\n    for w in wins:\n        p,r,n=fit_peak(c,w)\n        print(f'  w={w:3d} R2={r:.4f} x0={p[0]:9.3f} gamma={p[1]:9.3f} amp={p[2]:10.3f} off={p[3]:10.3f} n={n}')\n\n# final fit\npg,rg,_=fit_peak(3745.1,70)\npd,rd,_=fit_peak(6329.4,100)\nres={\n  \"G\":  {\"x0\":float(pg[0]),\"gamma\":float(pg[1]),\"amplitude\":float(pg[2]),\"offset\":float(pg[3])},\n  \"2D\": {\"x0\":float(pd[0]),\"gamma\":float(pd[1]),\"amplitude\":float(pd[2]),\"offset\":float(pd[3])},\n}\nprint('FINAL G R2=%.4f  2D R2=%.4f'%(rg,rd))\nprint(json.dumps(res,indent=2))\nfor path in ['/app/results.json','/tmp/results.json']:\n    with open(path,'w') as f:\n        json.dump(res,f,indent=2)\n    print('wrote',path)\nEOF\npython3 /tmp/fit.py\n"]
