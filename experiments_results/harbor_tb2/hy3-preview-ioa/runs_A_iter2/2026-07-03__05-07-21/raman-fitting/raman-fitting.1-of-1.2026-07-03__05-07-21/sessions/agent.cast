[115.907387, "i", "cat > /tmp/explore.py << 'EOF'\nimport numpy as np\nd = np.loadtxt('/app/graphene.dat', delimiter=None, converters={0: lambda s: float(s.decode().replace(',', '.')), 1: lambda s: float(s.decode().replace(',', '.'))})\nx = d[:,0]; y = d[:,1]\nprint('n', len(x))\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\n# sort by x\no = np.argsort(x)\nx = x[o]; y = y[o]\n# find peaks: local maxima larger than neighborhood\nfrom scipy.signal import find_peaks\npk, props = find_peaks(y, distance=10, prominence=500)\nprint('num peaks', len(pk))\nfor i in pk:\n    print(f'x={x[i]:.1f} y={y[i]:.1f}')\nEOF\npython3 /tmp/explore.py\n"]
