[476.445393, "o", "\u001b[?2004l\r\u001b[?2004h"]
[476.445594, "o", "> "]
[476.445805, "o", "def lor(x, x0, gamma, amp, off):"]
[476.445941, "o", "\r\n"]
[476.446166, "o", "\u001b[?2004l\r\u001b[?2004h"]
[476.446466, "o", "> "]
[476.446643, "o", "    return off + amp*gamma**2/((x-x0)**2+gamma**2)"]
[476.446871, "o", "\r\n"]
[476.447009, "o", "\u001b[?2004l\r"]
[476.447242, "o", "\u001b[?2004h"]
[476.455721, "o", "> "]
[476.455803, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def fit_peak(center, half):\r\n\u001b[?2004l\r\u001b[?2004h>     m=(x>=center-half)&(x<=center+half)\r\n\u001b[?2004l\r\u001b[?2004h>     xx=x[m]; yy=y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     i0=np.argmax(yy)\r\n\u001b[?2004l\r\u001b[?2004h>     x0g=xx[i0]; off0=np.median(yy[np.argsort(np.abs(xx-center))[:10]])\r\n\u001b[?2004l\r\u001b[?2004h>     amp0=yy[i0]-off0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.456726, "o", "    p0=[x0g, half*0.25, amp0, off0]\r\n\u001b[?2004l\r\u001b[?2004h>     popt,_=curve_fit(lor,xx,yy,p0=p0,maxfev=40000)\r\n\u001b[?2004l\r\u001b[?2004h>     pred=lor(xx,*popt)\r\n\u001b[?2004l\r\u001b[?2004h>     r2=1-np.sum((yy-pred)**2)/np.sum((yy-yy.mean())**2)\r\n\u001b[?2004l\r\u001b[?2004h>     return popt, r2, len(xx)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.475957, "o", "# stability across windows\r\n\u001b[?2004l\r\u001b[?2004h> for name,(c,wins) in {'G':(3745.1,[50,70,90]),'2D':(6329.4,[80,100,120])}.items():\r\n\u001b[?2004l\r\u001b[?2004h>     print(name, 'cand', c)\r\n\u001b[?2004l\r\u001b[?2004h>     for w in wins:\r\n\u001b[?2004l\r\u001b[?2004h>         p,r,n=fit_peak(c,w)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'  w={w:3d} R2={r:.4f} x0={p[0]:9.3f} gamma={p[1]:9.3f} amp={p[2]:10.3f} off={p[3]:10.3f} n={n}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[476.483836, "o", "\u001b[?2004h> # final fit\r\n\u001b[?2004l\r\u001b[?2004h> pg,rg,_=fit_peak(3745.1,70)\r\n\u001b[?2004l\r\u001b[?2004h> pd,rd,_=fit_peak(6329.4,100)\r\n\u001b[?2004l\r\u001b[?2004h> res={\r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.484113, "o", "  \"G\":  {\"x0\":float(pg[0]),\"gamma\":float(pg[1]),\"amplitude\":float(pg[2]),\"offset\":float(pg[3])},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.484355, "o", "  \"2D\": {\"x0\":float(pd[0]),\"gamma\":float(pd[1]),\"amplitude\":float(pd[2]),\"offset\":float(pd[3])},\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.4845, "o", "print('FINAL G R2=%.4f  2D R2=%.4f'%(rg,rd))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.484575, "o", "print(json.dumps(res,indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.484723, "o", "for path in ['/app/results.json','/tmp/results.json']:\r\n\u001b[?2004l\r"]
[476.484801, "o", "\u001b[?2004h> "]
[476.484955, "o", "    with open(path,'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         json.dump(res,f,indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[476.485335, "o", "    print('wrote',path)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[476.511255, "o", "\u001b[?2004hroot@4008c52d3fe4:/app# "]
[476.511633, "o", "python3 /tmp/fit.py\r\n\u001b[?2004l\r"]
[477.79776, "o", "G cand 3745.1\r\n"]
[477.814769, "o", "  w= 50 R2=0.9964 x0= 3745.273 gamma=  -32.297 amp= 14434.377 off= -1300.609 n=37\r\n  w= 70 R2=0.9953 x0= 3745.295 gamma=  -28.854 amp= 13194.078 off=    68.660 n=52\r\n  w= 90 R2=0.9945 x0= 3745.326 gamma=  -27.357 amp= 12799.699 off=   544.920 n=67\r\n2D cand 6329.4\r\n  w= 80 R2=0.9933 x0= 6327.645 gamma=   37.496 amp=  8625.319 off=  5304.150 n=17\r\n  w=100 R2=0.9933 x0= 6327.832 gamma=   37.531 amp=  8635.912 off=  5292.979 n=22\r\n"]
[477.827791, "o", "  w=120 R2=0.9909 x0= 6327.878 gamma=   35.836 amp=  8437.766 off=  5543.914 n=27\r\nFINAL G R2=0.9953  2D R2=0.9933\r\n{\r\n  \"G\": {\r\n    \"x0\": 3745.295430021106,\r\n    \"gamma\": -28.853737077623794,\r\n    \"amplitude\": 13194.078114889682,\r\n    \"offset\": 68.66008925786201\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 6327.8316709954515,\r\n    \"gamma\": 37.531176982439966,\r\n    \"amplitude\": 8635.911538128661,\r\n    \"offset\": 5292.979470159311\r\n  }\r\n}\r\nwrote /app/results.json\r\nwrote /tmp/results.json\r\n"]
[477.985127, "o", "\u001b[?2004h"]
[477.985524, "m", "Episode 13: 2 commands"]
[477.985524, "o", "root@4008c52d3fe4:/app# "]
[507.754077, "i", "cat > /tmp/fit2.py << 'EOF'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\nrows=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        rows.append((float(p[0]),float(p[1])))\nd=np.array(rows); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\ndef lor(x,x0,gamma,amp,off):\n    return off + amp*gamma**2/((x-x0)**2+gamma**2)\ndef fit(center,half):\n    m=(x>=center-half)&(x<=center+half); xx=x[m]; yy=y[m]\n    i0=np.argmax(yy); x0g=xx[i0]\n    off0=np.median(yy[np.argsort(np.abs(xx-center))[:10]])\n    amp0=yy[i0]-off0\n    p0=[x0g,half*0.25,amp0,off0]\n    popt,_=curve_fit(lor,xx,yy,p0=p0,maxfev=40000,\n                     bounds=([x0g-200,1e-4,-1e9,-1e9],[x0g+200,1e4,1e9,1e9]))\n    pred=lor(xx,*popt); r2=1-np.sum((yy-pred)**2)/np.sum((yy-yy.mean())**2)\n    return popt,r2\npg,rg=fit(3745.1,70); pd,rd=fit(6329.4,100)\nres={\n  \"G\": {\"x0\":float(pg[0]),\"gamma\":float(pg[1]),\""]
[507.754147, "i", "amplitude\":float(pg[2]),\"offset\":float(pg[3])},\n  \"2D\":{\"x0\":float(pd[0]),\"gamma\":float(pd[1]),\"amplitude\":float(pd[2]),\"offset\":float(pd[3])}}\nprint('G R2=%.4f  2D R2=%.4f'%(rg,rd))\nprint(json.dumps(res,indent=2))\nfor path in ['/app/results.json','/tmp/results.json']:\n    with open(path,'w') as f: json.dump(res,f,indent=2)\n    print('wrote',path)\nEOF\npython3 /tmp/fit2.py\n"]
[507.760142, "o", "cat > /tmp/fit2.py << 'EOF'"]
