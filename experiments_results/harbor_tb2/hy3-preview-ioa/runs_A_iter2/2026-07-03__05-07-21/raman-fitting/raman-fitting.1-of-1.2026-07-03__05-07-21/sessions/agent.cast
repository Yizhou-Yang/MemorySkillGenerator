[253.888204, "i", "cat > /tmp/full.py << 'EOF'\nimport numpy as np\nrows = []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        rows.append((float(p[0]),float(p[1])))\nd=np.array(rows); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\nprint('FULL spectrum downsampled (120 pts):')\nidx=np.linspace(0,len(x)-1,120).astype(int)\nfor i in idx:\n    print(f'{x[i]:.1f} {y[i]:.1f}')\nEOF\npython3 /tmp/full.py\n"]
