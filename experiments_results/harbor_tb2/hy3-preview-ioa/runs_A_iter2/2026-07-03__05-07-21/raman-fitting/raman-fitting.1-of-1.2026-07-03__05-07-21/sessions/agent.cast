[476.432333, "i", "cat > /tmp/fit.py << 'EOF'\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\nrows=[]\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        rows.append((float(p[0]),float(p[1])))\nd=np.array(rows); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp*gamma**2/((x-x0)**2+gamma**2)\n\ndef fit_peak(center, half):\n    m=(x>=center-half)&(x<=center+half)\n    xx=x[m]; yy=y[m]\n    i0=np.argmax(yy)\n    x0g=xx[i0]; off0=np.median(yy[np.argsort(np.abs(xx-center))[:10]])\n    amp0=yy[i0]-off0\n    p0=[x0g, half*0.25, amp0, off0]\n    popt,_=curve_fit(lor,xx,yy,p0=p0,maxfev=40000)\n    pred=lor(xx,*popt)\n    r2=1-np.sum((yy-pred)**2)/np.sum((yy-yy.mean())**2)\n    return popt, r2, len(xx)\n\n# stability across windows\nfor name,(c,wins) in {'G':(3745.1,[50,70,90]),'2D':(6329.4,[80,"]
[476.432595, "o", "cat > /tmp/fit.py << 'EOF'"]
