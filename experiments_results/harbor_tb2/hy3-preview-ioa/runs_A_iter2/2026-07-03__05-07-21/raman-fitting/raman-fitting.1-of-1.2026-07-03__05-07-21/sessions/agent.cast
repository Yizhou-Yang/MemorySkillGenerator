[126.692605, "i", "cat > /tmp/explore.py << 'EOF'\nimport numpy as np\nrows = []\nwith open('/app/graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        parts = line.replace(',', '.').split()\n        if len(parts) < 2: continue\n        rows.append((float(parts[0]), float(parts[1])))\nd = np.array(rows)\nx = d[:,0]; y = d[:,1]\nprint('n', len(x))\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\no = np.argsort(x); x = x[o]; y = y[o]\nfrom scipy.signal import find_peaks\npk, props = find_peaks(y, distance=10, prominence=500)\nprint('num peaks', len(pk))\nfor i in pk:\n    print(f'x={x[i]:.1f} y={y[i]:.1f}')\nEOF\npython3 /tmp/explore.py\n"]
