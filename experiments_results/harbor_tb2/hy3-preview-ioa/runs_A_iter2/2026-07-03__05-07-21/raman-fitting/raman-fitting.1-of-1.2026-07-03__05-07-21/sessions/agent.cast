[364.692471, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # robust background: fit polynomial on a downsampled + smoothed version\r\n\u001b[?2004l\r\u001b[?2004h> # Use a moving median to estimate background then smooth\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.ndimage import median_filter\r\n\u001b[?2004l\r\u001b[?2004h> yf = median_filter(y, size=151)\r\n\u001b[?2004l\r\u001b[?2004h> coef = np.polyfit(x, yf, 4)\r\n\u001b[?2004l\r\u001b[?2004h> bg = np.polyval(coef, x)\r\n\u001b[?2004l\r\u001b[?2004h> resid = y - bg\r\n\u001b[?2004l\r\u001b[?2004h> pk,_ = find_peaks(resid, prominence=1500)\r\n\u001b[?2004l\r\u001b[?2004h> print('candidate peaks (height above background):')\r\n\u001b[?2004l\r\u001b[?2004h> order=np.argsort(resid[pk])[::-1]\r\n\u001b[?2004l\r\u001b[?2004h> for idx in order[:12]:\r\n\u001b[?2004l\r\u001b[?2004h>     i=pk[idx]\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'x={x[i]:9.1f}  y={y[i]:9.1f}  above_bg={resid[i]:9.1f}  bg={bg[i]:9.1f}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
