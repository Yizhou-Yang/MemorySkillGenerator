[824.026739, "i", "cat > /app/count.py << 'EOF'\nimport os, sys\nfrom huggingface_hub import hf_hub_download, HfApi\nimport pyarrow.parquet as pq\nfrom tokenizers import Tokenizer\nfrom collections import Counter\n\nREPO='open-thoughts/OpenThoughts-114k'\nTOK='/root/.cache/huggingface/hub/models--Qwen--Qwen2.5-1.5B-Instruct/snapshots/989aa7980e4cf806f80c7fef2b1adb7bc71aa306/tokenizer.json'\ntok=Tokenizer.from_file(TOK)\nprint('tokenizer vocab', tok.get_vocab_size(), flush=True)\n\napi=HfApi()\nfiles=[f.path for f in api.list_repo_tree(REPO, repo_type='dataset', path_in_repo='metadata')]\nfiles=sorted(files)\nprint('shards:', files, flush=True)\n\nshard_dir='/app/shards'\nos.makedirs(shard_dir, exist_ok=True)\n\ntotal=0\ncol_tot={'deepseek_reasoning':0,'deepseek_solution':0}\nfor fn in files:\n    path=hf_hub_download(REPO, fn, repo_type='dataset', local_dir=shard_dir)\n    t=pq.read_table(path, columns=['domain','deepseek_reasoning','deepseek_solution'])\n    domains=t.column('domain').to_pylist()\n    cnt"]
[824.027062, "o", "cat > /app/count.py << 'EOF'"]
