[824.03155, "i", "=Counter(domains)\n    print(f'{os.path.basename(fn)} rows={t.num_rows} domains={dict(cnt)}', flush=True)\n    # build science mask\n    dr=t.column('deepseek_reasoning').to_pylist()\n    ds=t.column('deepseek_solution').to_pylist()\n    for i,d in enumerate(domains):\n        if d=='science':\n            a=dr[i] or ''\n            b=ds[i] or ''\n            for colname, text in (('deepseek_reasoning',a),('deepseek_solution',b)):\n                n=len(tok.encode(text).ids)\n                col_tot[colname]+=n\n    total=col_tot['deepseek_reasoning']+col_tot['deepseek_solution']\n    print(f'  running deepseek token total={total} (reasoning={col_tot[\"deepseek_reasoning\"]} solution={col_tot[\"deepseek_solution\"]})', flush=True)\n    del t\n    os.remove(path)\n\nprint('FINAL deepseek tokens (science):', total, flush=True)\nprint('reasoning=',col_tot['deepseek_reasoning'],'solution=',col_tot['deepseek_solution'], flush=True)\nwith open('/app/answer.txt','w') as f:\n    f.write(str(total))\nEOF\necho written\n"]
