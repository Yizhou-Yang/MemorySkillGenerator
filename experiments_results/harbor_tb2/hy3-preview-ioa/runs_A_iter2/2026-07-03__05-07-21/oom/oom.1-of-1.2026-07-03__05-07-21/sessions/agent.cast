[554.10414, "i", "cat > /tmp/verify.py << 'EOF'\nimport os\nfrom pathlib import Path\nimport transformers as T\n\nbase = Path('/root/.cache/huggingface/hub/models--albert--albert-base-v2/snapshots/8e2f239c5f8a2c0f253781ca60135db913e5c80c')\n\n# 1) Load directly from the local snapshot path (no network at all)\nm = T.AlbertModel.from_pretrained(str(base))\ntok = T.AlbertTokenizer.from_pretrained(str(base))\nout = m(**tok('Hello, offline world', return_tensors='pt'))\nprint('via path   :', tuple(out.last_hidden_state.shape))\n\n# 2) Load by model id with offline mode (the flight scenario)\nos.environ['HF_HUB_OFFLINE'] = '1'\nos.environ['TRANSFORMERS_OFFLINE'] = '1'\nm2 = T.AlbertModel.from_pretrained('albert-base-v2')\ntok2 = T.AlbertTokenizer.from_pretrained('albert-base-v2')\nout2 = m2(**tok2('Hello, offline world', return_tensors='pt'))\nprint('via id     :', tuple(out2.last_hidden_state.shape))\nprint('ALL OK - model and tokenizer are cached and work offline')\nEOF\n"]
