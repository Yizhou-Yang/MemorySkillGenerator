[1238.463421, "i", "cat > _smoke2.py <<'EOF'\nimport sys\nsys.path.insert(0, '.')\nimport torch\nfrom transformers import RobertaConfig\nfrom model.head_for_sequence_classification import RobertaPrefixForSequenceClassification\n\ncfg = RobertaConfig(\n    vocab_size=100, hidden_size=32, num_hidden_layers=2, num_attention_heads=2,\n    intermediate_size=64, hidden_dropout_prob=0.1, num_labels=2, pre_seq_len=10,\n    prefix_projection=False, prefix_hidden_size=16,\n)\ncfg.problem_type = \"single_label_classification\"\nmodel = RobertaPrefixForSequenceClassification(cfg)\nx = torch.randint(0, 100, (2, 8)); am = torch.ones(2, 8)\nout = model(input_ids=x, attention_mask=am, labels=torch.tensor([0,1]))\nloss = out[0] if isinstance(out, tuple) else out.loss\nprint(\"PREFIX_MODEL_OK loss=\", float(loss))\nEOF\npython3 _smoke2.py\n"]
