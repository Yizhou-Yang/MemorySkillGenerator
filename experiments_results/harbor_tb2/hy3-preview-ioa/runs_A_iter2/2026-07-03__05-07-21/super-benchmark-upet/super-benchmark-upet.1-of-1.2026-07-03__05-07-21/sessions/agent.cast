[457.463394, "o", "import torch"]
[457.463768, "o", "\r\n"]
[457.463912, "o", "\r\n"]
[457.46406, "o", "# from transformers.models.bart.modeling_bart import BartForConditionalGeneration"]
[457.464401, "o", "\r\n"]
[457.465004, "o", "# from transformers.models.bert.modeling_bert import BertForSequenceClassification"]
[457.46517, "o", "\r\n"]
[457.465353, "o", "\r\n"]
[457.465504, "o", "# model = BartForConditionalGeneration(None)"]
[457.46564, "o", "\r\n"]
[457.465784, "o", "\r\n"]
[457.466356, "o", "\r\n"]
[457.466504, "o", "\r\n"]
[457.466644, "o", "class PrefixEncoder(torch.nn.Module):"]
[457.466782, "o", "\r\n"]
[457.466926, "o", "    r'''"]
[457.467066, "o", "\r\n"]
[457.467296, "o", "    The torch.nn model to encode the prefix"]
[457.46742, "o", "\r\n"]
[457.467547, "o", "\r\n"]
[457.467682, "o", "    Input shape: (batch-size, prefix-length)"]
[457.46782, "o", "\r\n"]
[457.46797, "o", "\r\n"]
[457.468124, "o", "    Output shape: (batch-size, prefix-length, 2*layers*hidden)"]
[457.468272, "o", "\r\n"]
[457.468426, "o", "    '''"]
[457.468563, "o", "\r\n"]
[457.468705, "o", "    def __init__(self, config):"]
[457.468838, "o", "\r\n"]
[457.468986, "o", "        super().__init__()"]
[457.469146, "o", "\r\n"]
[457.469718, "o", "        self.prefix_projection = config.prefix_projection"]
[457.469859, "o", "\r\n"]
[457.469996, "o", "        if self.prefix_projection:"]
[457.470162, "o", "\r\n"]
[457.47033, "o", "            # Use a two-layer MLP to encode the prefix"]
[457.470471, "o", "\r\n"]
[457.470619, "o", "            self.embedding = torch.nn.Embedding(config.pre_seq_len, config.hidden_size)"]
[457.470749, "o", "\r\n"]
[457.470885, "o", "            self.trans = torch.nn.Sequential("]
[457.471022, "o", "\r\n"]
[457.47119, "o", "                torch.nn.Linear(config.hidden_size, config.prefix_hidden_size),"]
[457.471361, "o", "\r\n"]
[457.471496, "o", "                torch.nn.Tanh(),"]
[457.471628, "o", "\r\n"]
[457.471767, "o", "                torch.nn.Linear(config.prefix_hidden_size, config.num_hidden_layers * 2 * config.hidden_size)"]
[457.4719, "o", "\r\n"]
[457.472048, "o", "            )"]
[457.472211, "o", "\r\n"]
[457.472374, "o", "        else:"]
[457.472507, "o", "\r\n"]
[457.472654, "o", "            self.embedding = torch.nn.Embedding(config.pre_seq_len, config.num_hidden_layers * 2 * config.hidden_size)"]
[457.472806, "o", "\r\n"]
[457.472957, "o", "\r\n"]
[457.473122, "o", "    def forward(self, prefix: torch.Tensor):"]
[457.473419, "o", "\r\n"]
[457.473559, "o", "        if self.prefix_projection:"]
[457.473695, "o", "\r\n"]
[457.473844, "o", "            prefix_tokens = self.embedding(prefix) # [pre_seq_len, hidden_dim]"]
[457.473989, "o", "\r\n"]
[457.474159, "o", "            past_key_values = self.trans(prefix_tokens)"]
[457.474317, "o", "\r\n"]
[457.474469, "o", "        else:"]
[457.474616, "o", "\r\n"]
[457.474755, "o", "            past_key_values = self.embedding(prefix)"]
[457.474892, "o", "\r\n"]
[457.475123, "o", "        return past_key_values"]
