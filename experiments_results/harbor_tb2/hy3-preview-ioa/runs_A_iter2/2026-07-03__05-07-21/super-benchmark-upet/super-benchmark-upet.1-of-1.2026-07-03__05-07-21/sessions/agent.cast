[58.40532, "o", "cat run.py\r\n\u001b[?2004l\r"]
[58.417068, "o", "import logging"]
[58.417463, "o", "\r\n"]
[58.417641, "o", "import os"]
[58.417797, "o", "\r\n"]
[58.417979, "o", "import sys"]
[58.418165, "o", "\r\n"]
[58.418324, "o", "import numpy as np"]
[58.41848, "o", "\r\n"]
[58.418657, "o", "from typing import Dict"]
[58.418819, "o", "\r\n"]
[58.418976, "o", "\r\n"]
[58.419191, "o", "import datasets"]
[58.419348, "o", "\r\n"]
[58.419503, "o", "import transformers"]
[58.419674, "o", "\r\n"]
[58.419852, "o", "from transformers import set_seed, Trainer"]
[58.420009, "o", "\r\n"]
[58.420666, "o", "from transformers.trainer_utils import get_last_checkpoint"]
[58.420843, "o", "\r\n"]
[58.421014, "o", "\r\n"]
[58.421388, "o", "from arguments import get_args"]
[58.42158, "o", "\r\n"]
[58.42175, "o", "\r\n"]
[58.421919, "o", "from tasks.utils import *"]
[58.423019, "o", "\r\n"]
[58.423324, "o", "\r\n"]
[58.423533, "o", "os.environ[\"WANDB_DISABLED\"] = \"true\""]
[58.423725, "o", "\r\n"]
[58.423918, "o", "\r\n"]
[58.425026, "o", "logger = logging.getLogger(__name__)"]
[58.42523, "o", "\r\n"]
[58.425416, "o", "\r\n"]
[58.425653, "o", "def train(trainer, resume_from_checkpoint=None, last_checkpoint=None):"]
[58.425828, "o", "\r\n"]
[58.425998, "o", "    checkpoint = None"]
[58.426244, "o", "\r\n"]
[58.42675, "o", "    if resume_from_checkpoint is not None:"]
[58.427363, "o", "\r\n"]
[58.427539, "o", "        checkpoint = resume_from_checkpoint"]
[58.427847, "o", "\r\n"]
[58.428355, "o", "    elif last_checkpoint is not None:"]
[58.428611, "o", "\r\n"]
[58.428835, "o", "        checkpoint = last_checkpoint"]
[58.429063, "o", "\r\n"]
[58.429277, "o", "    train_result = trainer.train(resume_from_checkpoint=checkpoint)"]
[58.42954, "o", "\r\n"]
[58.429737, "o", "    # trainer.save_model()，"]
[58.429982, "o", "\r\n"]
[58.430171, "o", "    "]
[58.430409, "o", "\r\n"]
[58.430852, "o", "    try:"]
[58.431094, "o", "\r\n"]
[58.431261, "o", "        metrics = train_result.metrics"]
[58.431432, "o", "\r\n"]
[58.431617, "o", "\r\n"]
[58.431787, "o", "        trainer.log_metrics(\"train\", metrics)"]
[58.431962, "o", "\r\n"]
[58.432211, "o", "        trainer.save_metrics(\"train\", metrics)"]
[58.432391, "o", "\r\n"]
[58.432585, "o", "        trainer.save_state()"]
[58.433107, "o", "\r\n"]
[58.433278, "o", "\r\n"]
[58.433434, "o", "        trainer.log_best_metrics()"]
[58.433607, "o", "\r\n"]
[58.433763, "o", "    except:"]
[58.433919, "o", "\r\n"]
[58.434092, "o", "        pass"]
[58.434287, "o", "\r\n"]
[58.434443, "o", "\r\n"]
[58.434617, "o", "def evaluate(trainer):"]
[58.434781, "o", "\r\n"]
[58.434937, "o", "    logger.info(\"*** Evaluate ***\")"]
[58.435111, "o", "\r\n"]
[58.435309, "o", "    metrics = trainer.evaluate()"]
[58.435466, "o", "\r\n"]
[58.435641, "o", "\r\n"]
[58.435796, "o", "    trainer.log_metrics(\"eval\", metrics)"]
[58.435955, "o", "\r\n"]
[58.436132, "o", "    trainer.save_metrics(\"eval\", metrics)"]
[58.436297, "o", "\r\n"]
[58.436855, "o", "\r\n"]
[58.437019, "o", "def predict(trainer, predict_dataset=None):"]
[58.437227, "o", "\r\n"]
[58.437413, "o", "    if predict_dataset is None:"]
[58.437587, "o", "\r\n"]
[58.437755, "o", "        logger.info(\"No dataset is available for testing\")"]
[58.437849, "o", "\r\n"]
[58.43794, "o", "\r\n"]
[58.438331, "o", "    elif isinstance(predict_dataset, dict):"]
[58.438895, "o", "\r\n"]
[58.438982, "o", "        "]
[58.43907, "o", "\r\n"]
[58.439479, "o", "        for dataset_name, d in predict_dataset.items():"]
[58.439812, "o", "\r\n"]
[58.439896, "o", "            logger.info(\"*** Predict: %s ***\" % dataset_name)"]
[58.440644, "o", "\r\n"]
[58.44074, "o", "            predictions, labels, metrics = trainer.predict(d, metric_key_prefix=\"predict\")"]
[58.441355, "o", "\r\n"]
[58.441468, "o", "            predictions = np.argmax(predictions, axis=2)"]
[58.441699, "o", "\r\n"]
[58.441942, "o", "\r\n            trainer.log_metrics(\"predict\", metrics)\r\n            trainer.save_metrics(\"predict\", metrics)\r\n\r\n    else:\r\n        logger.info(\"*** Predict ***\")\r\n        predictions, labels, metrics = trainer.predict(predict_dataset, metric_key_prefix=\"predict\")\r\n        predictions = np.argmax(predictions, axis=2)\r\n\r\n        trainer.log_metrics(\"predict\", metrics)\r\n        trainer.save_metrics(\"predict\", metrics)\r\n\r\nif __name__ == '__main__':\r\n\r\n"]
[58.442063, "o", "    args = get_args()"]
[58.442182, "o", "\r\n"]
[58.442339, "o", "\r\n    _, dat"]
[58.442473, "o", "a_args, training_args, semi_training_args, _ = args\r\n"]
[58.44278, "o", "\r\n"]
[58.442884, "o", "    logging.basicConfig("]
[58.442989, "o", "\r\n"]
[58.443102, "o", "        format=\"%(asctime)s - %(levelname)s - %(name)s - %(message)s\","]
[58.443196, "o", "\r\n"]
[58.443282, "o", "        datefmt=\"%m/%d/%Y %H:%M:%S\","]
[58.443387, "o", "\r\n        handlers=[logging.StreamHandler(sys.stdout)],"]
[58.443478, "o", "\r\n"]
[58.443577, "o", "    )"]
