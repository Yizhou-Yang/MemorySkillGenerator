[17.119309, "o", "#!/bin/bash\r\r\n# Data processing script\r\r\n\r"]
[17.119368, "o", "\r\n# Check if input data exists\r\r\nif [ -f \"/data/output/raw_data.txt\" ]; then\r\r\n    # Process the data\r\r\n    cat /data/output/raw_data.txt | tr 'a-z' 'A-Z' > /data/output/processed_data.txt\r\r\n    echo \"Data processed successfully!\"\r\r\n    exit 0\r\r\n"]
[17.120527, "o", "else\r\r\n    echo \"Error: Input data not found!\"\r\r\n    exit 1\r\r\nfi\u001b[?2004hroot@2615703e702e:/app# "]
[17.197584, "i", "cat generate_report.sh\n"]
