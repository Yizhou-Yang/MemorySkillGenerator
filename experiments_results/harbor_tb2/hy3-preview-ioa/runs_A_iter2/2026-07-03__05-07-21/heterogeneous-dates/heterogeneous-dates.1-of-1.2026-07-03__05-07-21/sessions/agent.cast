[29.768614, "i", "python3 - <<'EOF'\nimport re\nfrom datetime import datetime\n\ndef parse_date(s):\n    s = s.strip()\n    for fmt in ('%Y-%m-%d','%m/%d/%Y %H:%M:%S','%m-%d-%Y %H:%M:%S'):\n        try:\n            return datetime.strptime(s, fmt).strftime('%Y-%m-%d')\n        except ValueError:\n            pass\n    return None\n\ndef load(fn):\n    d={}\n    with open(fn) as f:\n        next(f)\n        for line in f:\n            line=line.strip()\n            if not line: continue\n            date,temp=line.split(',')\n            d[parse_date(date)]=float(temp)\n    return d\n\nhigh=load('daily_temp_sf_high.csv')\nlow=load('daily_temp_sf_low.csv')\ncommon=set(high)&set(low)\ndiffs=[high[k]-low[k] for k in common]\navg=sum(diffs)/len(diffs)\nwith open('avg_temp.txt','w') as f:\n    f.write(str(avg))\nprint('days:',len(diffs),'avg:',avg)\nEOF\n"]
