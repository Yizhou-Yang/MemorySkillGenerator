[153.917209, "o", "git@localhost: Permission denied (publickey,password).\r\r\nfatal: Could not read from remote repository.\r\n\r\nPlease make sure you have the correct access rights\r\nand the repository exists.\r\n\u001b[?2004hroot@52e1bb54e013:/app# "]
[171.243356, "i", "cat > /tmp/push.exp << 'EOF'\n#!/usr/bin/expect -f\nset timeout 30\nset repo [lindex $argv 0]\nspawn git push ssh://git@localhost/git/project $repo\nexpect {\n  -re \"(?i)password:\" { send \"password\\r\"; exp_continue }\n  eof\n}\nEOF\nchmod +x /tmp/push.exp\n"]
