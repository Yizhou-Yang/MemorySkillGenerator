[153.456809, "i", "su - git -c 'git config --global user.email t@t; git config --global user.name t; git config --global core.sshCommand \"ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null\"; mkdir -p ~/t && cd ~/t && git init -q && git checkout -q -b main && echo MAIN > index.html && git add . && git commit -qm m1 && git push ssh://git@localhost/git/project main 2>&1 | tail -5' \n"]
[153.458352, "o", "su - git -c 'git config --global user.email t@t; git config --global user.name t; git config --global core.sshCommand \"ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null\"; mkdir -p ~/t && cd ~/t && git init -q && git checkout -q -b main && echo MAIN > index.html && git add . && git commit -qm m1 && git push ssh://git@localhost/git/project main 2>&1 | tail -5' "]
