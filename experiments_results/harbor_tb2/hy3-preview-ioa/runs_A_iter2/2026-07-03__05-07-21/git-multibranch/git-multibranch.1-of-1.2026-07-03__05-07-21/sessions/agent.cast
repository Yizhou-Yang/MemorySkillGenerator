[81.885351, "i", "cat > /git/project/hooks/post-receive << 'EOF'\n#!/bin/bash\nunset GIT_DIR\nwhile read oldrev newrev refname; do\n    branch=\"${refname#refs/heads/}\"\n    case \"$branch\" in\n        main) target=/var/www/html ;;\n        dev)  target=/var/www/html/dev ;;\n        *) continue ;;\n    esac\n    mkdir -p \"$target\"\n    git --git-dir=/git/project archive \"$branch\" | tar -x -C \"$target\"\ndone\nEOF\n"]
