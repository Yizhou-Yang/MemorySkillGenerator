[756.042375, "i", "cat > /tmp/diag2.exp << 'EOF'\n#!/usr/bin/expect -f\nset timeout 20\nspawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null git@localhost \"git-receive-pack '/git/project'\"\nexpect {\n  -re \"(?i)password:\" { send \"password\\r\"; exp_continue }\n  eof\n}\nEOF\nchmod +x /tmp/diag2.exp; expect /tmp/diag2.exp 2>&1 | cat -v | head -20\n"]
