[227.55107, "i", "ore JSON-RPC method. Returns the result dict, or None on error.\"\"\"\n    payload = {\"jsonrpc\": \"1.0\", \"id\": \"curltext\", \"method\": method,\n               \"params\": params or []}\n    try:\n        resp = requests.post(\n            RPC_URL, json=payload, auth=(RPC_USER, RPC_PASSWORD),\n            timeout=10)\n        resp.raise_for_status()\n        data = resp.json()\n    except Exception:\n        return None\n    if \"error\" in data and data[\"error\"] is not None:\n        return None\n    return data.get(\"result\")\n\n\ndef _connected():\n    \"\"\"Return True if the node responds to RPC.\"\"\"\n    return _rpc(\"getnetworkinfo\") is not None\n\n\ndef _hex(v):\n    \"\"\"Convert a bytes/hex value to a hex string.\"\"\"\n    if isinstance(v, bytes):\n        return v.hex()\n    if isinstance(v, str):\n        return v\n    return str(v)\n\n\n@app.route(\"/status\", methods=[\"GET\"])\ndef status():\n    info = _rpc(\"getnetworkinfo\")\n    if info is None:\n        return jsonify({\"error\": \"Not connected to the Bitcoin network\"}), 503\n    return jsonify({\"status"]
[227.551127, "o", "import requests"]
[227.551362, "i", "\": \"online\"}), 200\n\n\n@app.route(\"/block/<block_hash>\", methods=[\"GET\"])\ndef block(block_hash):\n    if not HEX64.match(block_hash):\n        return jsonify({\"error\": \"Invalid block hash\"}), 404\n    if not _connected():\n        return jsonify({\"error\": \"Not connected to the Bitcoin network\"}), 503\n    blk = _rpc(\"getblock\", [block_hash])\n    if blk is None:\n        return jsonify({\"error\": \"Block not found\"}), 404\n    return jsonify({\n        \"hash\": _hex(blk.get(\"hash\", \"\")),\n        \"height\": blk.get(\"height\", 0),\n        \"merkleroot\": _hex(blk.get(\"merkleroot\", \"\")),\n        \"time\": blk.get(\"time\", 0),\n        \"nonce\": blk.get(\"nonce\", 0),\n        \"tx\": [_hex(t) for t in blk.get(\"tx\", [])],\n    }), 200\n\n\n@app.route(\"/transaction/<txid>\", methods=[\"GET\"])\ndef transaction(txid):\n    if not HEX64.match(txid):\n        return jsonify({\"error\": \"Invalid transaction id\"}), 404\n    if not _connected():\n        return jsonify({\"error\": \"Not connected to the Bitcoin network\"}), 503\n    raw = _rpc(\"getrawtransaction\", ["]
[227.55298, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.553053, "i", "txid, True])\n    if raw is None:\n        return jsonify({\"error\": \"Transaction not found\"}), 404\n    vin = []\n    for inp in raw.get(\"vin\", []):\n        entry = {\"sequence\": inp.get(\"sequence\", 0)}\n        if \"coinbase\" in inp:\n            entry[\"coinbase\"] = inp[\"coinbase\"]\n        vin.append(entry)\n    vout = []\n    for out in raw.get(\"vout\", []):\n        spk = out.get(\"scriptPubKey\", {})\n        vout.append({\n            \"value\": out.get(\"value\", 0),\n            \"n\": out.get(\"n\", 0),\n            \"scriptPubKey\": {\n                \"asm\": spk.get(\"asm\", \"\"),\n                \"hex\": spk.get(\"hex\", \"\"),\n                \"type\": spk.get(\"type\", \"\"),\n            },\n        })\n    return jsonify({\n        \"txid\": _hex(raw.get(\"txid\", \"\")),\n        \"blockhash\": _hex(raw.get(\"blockhash\", \"\")),\n        \"vin\": vin,\n        \"vout\": vout,\n    }), 200\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"127.0.0.1\", port=5000)\nPYEOF\n"]
