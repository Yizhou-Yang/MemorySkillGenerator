[227.61235, "o", ">     return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h>         \"hash\": _hex(blk.get(\"hash\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>         \"height\": blk.get(\"height\", 0),\r\n\u001b[?2004l\r\u001b[?2004h>         \"merkleroot\": _hex(blk.get(\"merkleroot\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>         \"time\": blk.get(\"time\", 0),\r\n\u001b[?2004l\r\u001b[?2004h>         \"nonce\": blk.get(\"nonce\", 0),\r\n\u001b[?2004l\r\u001b[?2004h>         \"tx\": [_hex(t) for t in blk.get(\"tx\", [])],\r\n\u001b[?2004l\r\u001b[?2004h>     }), 200\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[227.612465, "o", "> "]
[227.61251, "o", "@app.route(\"/transaction/<txid>\", methods=[\"GET\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.612642, "o", "def transaction(txid):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.612708, "o", "    if not HEX64.match(txid):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[227.612838, "o", "        return jsonify({\"error\": \"Invalid transaction id\"}), 404\r\n\u001b[?2004l\r\u001b[?2004h"]
[227.613032, "o", ">     if not _connected():\r\n\u001b[?2004l\r"]
[227.613128, "o", "\u001b[?2004h"]
[227.617012, "o", "> "]
[227.620934, "o", "        return jsonify({\"error\": \"Not connected to the Bitcoin network\"}), 503\r\n\u001b[?2004l\r\u001b[?2004h>     raw = _rpc(\"getrawtransaction\", [txid, True])\r\n\u001b[?2004l\r\u001b[?2004h>     if raw is None:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"error\": \"Transaction not found\"}), 404\r\n\u001b[?2004l\r\u001b[?2004h>     vin = []\r\n\u001b[?2004l\r\u001b[?2004h>     for inp in raw.get(\"vin\", []):\r\n\u001b[?2004l\r\u001b[?2004h>         entry = {\"sequence\": inp.get(\"sequence\", 0)}\r\n\u001b[?2004l\r\u001b[?2004h>         if \"coinbase\" in inp:\r\n\u001b[?2004l\r\u001b[?2004h>             entry[\"coinbase\"] = inp[\"coinbase\"]\r\n\u001b[?2004l\r\u001b[?2004h>         vin.append(entry)\r\n\u001b[?2004l\r\u001b[?2004h>     vout = []\r\n\u001b[?2004l\r\u001b[?2004h>     for out in raw.get(\"vout\", []):\r\n\u001b[?2004l\r\u001b[?2004h>         spk = out.get(\"scriptPubKey\", {})\r\n\u001b[?2004l\r\u001b[?2004h>         vout.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"value\": out.get(\"value\", 0),\r\n\u001b[?2004l\r\u001b[?2004h>             \"n\": out.get(\"n\", 0),\r\n\u001b[?2004l\r\u001b[?2004h>             \"scriptPubKey\": {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"asm\": spk.get(\"asm\", \"\"),\r\n\u001b["]
[227.625033, "o", "?2004l\r\u001b[?2004h>                 \"hex\": spk.get(\"hex\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"type\": spk.get(\"type\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h>         \"txid\": _hex(raw.get(\"txid\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>         \"blockhash\": _hex(raw.get(\"blockhash\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h>         \"vin\": vin,\r\n\u001b[?2004l\r\u001b[?2004h>         \"vout\": vout,\r\n\u001b[?2004l\r\u001b[?2004h>     }), 200\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     app.run(host=\"127.0.0.1\", port=5000)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r\u001b[?2004hroot@465f00b73b9d:/app# "]
