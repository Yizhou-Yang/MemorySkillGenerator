[227.53906, "i", "cat > /app/bitcoin_service.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"Bitcoin blockchain data service.\n\nExposes a Flask API that connects to a local Bitcoin Core node via JSON-RPC\nand returns blockchain data (blocks, transactions, network status).\n\"\"\"\nimport os\nimport re\nimport sys\nimport json\nimport requests\nfrom flask import Flask, jsonify\n\n# RPC configuration for the local Bitcoin Core node.\nRPC_HOST = os.environ.get(\"BITCOIN_RPC_HOST\", \"127.0.0.1\")\nRPC_PORT = int(os.environ.get(\"BITCOIN_RPC_PORT\", \"8332\"))\nRPC_USER = os.environ.get(\"BITCOIN_RPC_USER\", \"user\")\nRPC_PASSWORD = os.environ.get(\"BITCOIN_RPC_PASSWORD\", \"password\")\nRPC_URL = \"http://{}:{}\".format(RPC_HOST, RPC_PORT)\n# Bitcoin P2P network port (informational / connection target).\nP2P_PORT = int(os.environ.get(\"BITCOIN_P2P_PORT\", \"8333\"))\n\napp = Flask(__name__)\n\n# Regex for a 64-char hex Bitcoin hash / txid.\nHEX64 = re.compile(r\"^[0-9a-fA-F]{64}$\")\n\n\ndef _rpc(method, params=None):\n    \"\"\"Call a Bitcoin C"]
[227.539551, "o", "cat > /app/bitcoin_service.py << 'PYEOF'"]
