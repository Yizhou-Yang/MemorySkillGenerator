[408.441241, "i", "cat > /tmp/dl.py << 'EOF'\nimport urllib.request, os\nos.makedirs('/tmp/debs', exist_ok=True)\nurls=[l.strip() for l in open('/tmp/urls.txt') if l.strip()]\nua={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64)'}\nfails=[]\nfor i,u in enumerate(urls):\n    fn='/tmp/debs/'+os.path.basename(u.split('?')[0])\n    try:\n        req=urllib.request.Request(u, headers=ua)\n        data=urllib.request.urlopen(req, timeout=60).read()\n        open(fn,'wb').write(data)\n        print('OK',i+1,os.path.basename(fn))\n    except Exception as e:\n        print('FAIL',e)\n        fails.append(u)\nprint('TOTAL',len(urls),'FAILS',len(fails))\nEOF\necho written\n"]
