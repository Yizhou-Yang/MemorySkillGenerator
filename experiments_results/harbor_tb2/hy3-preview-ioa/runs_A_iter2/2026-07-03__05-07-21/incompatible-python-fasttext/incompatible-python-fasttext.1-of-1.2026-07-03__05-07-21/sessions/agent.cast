[156.660135, "i", "python - <<'EOF'\nimport fasttext\nm=fasttext.load_model('/app/model.bin')\nprint('predict:', m.predict('the movie was good', k=1))\nprint('svec:', type(m.get_sentence_vector('hello')), m.get_sentence_vector('hello').shape)\ntry:\n    print('nn:', m.get_nearest_neighbors('good', k=3))\nexcept Exception as e:\n    print('NN ERROR:', repr(e))\ntry:\n    m.quantize(input='/tmp/data.txt')\n    print('quantize ok')\nexcept Exception as e:\n    print('QUANTIZE ERROR:', repr(e))\nEOF\n"]
