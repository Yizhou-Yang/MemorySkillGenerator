[19.180319, "i", "cat src/data_processor.py\n"]
[19.181085, "o", "cat src/data_processor.py\r\n\u001b[?2004l\r"]
[19.196733, "o", "from typing import Any, Dict, Tuple"]
[19.197092, "o", "\r\n"]
[19.197347, "o", "\r\n"]
[19.197642, "o", "import numpy as np  # type: ignore"]
[19.19782, "o", "\r\n"]
[19.198064, "o", "import pandas as pd  # type: ignore"]
[19.198256, "o", "\r\n"]
[19.198452, "o", "\r\n"]
[19.200058, "o", "from .data_loader import load_sample_transactions"]
[19.200289, "o", "\r\n"]
[19.200488, "o", "\r\n"]
[19.200671, "o", "\r\n"]
[19.200852, "o", "def load_and_process_data(filepath) -> pd.DataFrame:"]
[19.20113, "o", "\r\n"]
[19.201357, "o", "    \"\"\"Load CSV data with optimized dtypes using Arrow and handle mixed date formats."]
[19.201506, "o", "\r\n\r\n    Args:\r\n        filepath: Path to the CSV file containing transaction data\r\n\r\n    Returns:\r\n        DataFrame with properly typed columns using Arrow backend\r\n    \"\"\"\r\n    # This requires pandas >= 2.0.0 for date_format and dtype_backend\r\n    pd.options.mode.copy_on_write = True\r\n\r\n    df = pd.read_csv(\r\n        filepath,\r\n"]
[19.201803, "o", "        dtype_backend=\"pyarrow\","]
[19.201933, "o", "\r\n"]
[19.202614, "o", "        date_format=\"mixed\",\r\n    )\r\n\r\n    # Convert date columns using the new mixed format parser\r\n    date_cols = [\"transaction_date\", \"processing_date\"]\r\n    for col in date_cols:\r\n        if col in df.columns:\r\n            df[col] = pd.to_datetime(df[col], format=\"mixed\")\r\n\r\n    return df\r\n\r\n\r\ndef process_transactions(df: pd.DataFrame) -> Tuple[pd.DataFrame, Dict[str, Any]]:\r\n    \"\"\"Process transaction data using pandas 2.0 features.\r\n\r\n    Args:\r\n        df: Input DataFrame with transaction data\r\n\r\n    Returns:\r\n        Tuple containing:\r\n        - Summary DataFrame with transaction statistics\r\n        - Dictionary with metadata about boolean columns\r\n    \"\"\""]
[19.202767, "o", "\r\n"]
[19.202839, "o", "    # Get boolean columns using pyarrow dtypes"]
[19.202911, "o", "\r\n"]
[19.202982, "o", "    bool_cols = df.select_dtypes(include=[\"boolean[pyarrow]\"]).columns.tolist()"]
[19.203052, "o", "\r\n"]
[19.203122, "o", "\r\n"]
[19.203212, "o", "    # Calculate summary statistics"]
[19.203282, "o", "\r\n"]
[19.203371, "o", "    # Using Copy-on-Write, this won't create unnecessary copies"]
[19.203451, "o", "\r\n"]
[19.203527, "o", "    summary = pd.DataFrame("]
[19.203597, "o", "\r\n"]
[19.203666, "o", "        {"]
[19.203736, "o", "\r\n"]
[19.203806, "o", "            \"amount\": [df[\"amount\"].sum(), df[\"amount\"].mean()],"]
[19.203882, "o", "\r\n"]
[19.203959, "o", "            \"approval_rate\": [df[bool_cols[0]].mean() if bool_cols else np.nan] * 2,"]
[19.20478, "o", "\r\n"]
[19.204854, "o", "        },"]
[19.204967, "o", "\r\n"]
[19.205038, "o", "        index=[\"sum\", \"mean\"],"]
[19.205108, "o", "\r\n"]
[19.205196, "o", "    )"]
[19.205266, "o", "\r\n"]
[19.205354, "o", "\r\n"]
[19.205448, "o", "    return summary, {\"bool_columns\": bool_cols}"]
[19.205526, "o", "\r\n"]
[19.205606, "o", "\r\n"]
[19.205674, "o", "\r\n"]
[19.205743, "o", "def analyze_customer_segments(df: pd.DataFrame) -> Tuple[pd.DataFrame, list]:"]
[19.205812, "o", "\r\n"]
[19.20588, "o", "    \"\"\"Analyze customer segments with advanced pandas 2.0 features."]
[19.20595, "o", "\r\n"]
[19.206019, "o", "\r\n"]
[19.206087, "o", "    Args:"]
[19.206169, "o", "\r\n"]
[19.20624, "o", "        df: Input DataFrame with transaction data"]
[19.206382, "o", "\r\n"]
[19.206506, "o", "\r\n"]
[19.206638, "o", "    Returns:"]
[19.206762, "o", "\r\n"]
[19.206921, "o", "        Tu"]
[19.207058, "o", "ple containing:"]
[19.207242, "o", "\r\n"]
[19.207384, "o", "        - DataFrame with segment statistics"]
[19.207511, "o", "\r\n"]
[19.207638, "o", "        - List of boolean column names"]
[19.207762, "o", "\r\n"]
[19.207887, "o", "    \"\"\""]
[19.20801, "o", "\r\n"]
[19.208149, "o", "\r\n"]
[19.208313, "o", "    bool_cols = [col for col in df.columns if str(df[col].dtype) == \"bool[pyarrow]\"]"]
[19.208438, "o", "\r\n"]
[19.208563, "o", "\r\n"]
[19.208688, "o", "    # Group by customer segment and calculate statistics"]
[19.208818, "o", "\r\n"]
[19.208945, "o", "    # Copy-on-Write ensures efficient operations"]
[19.209071, "o", "\r\n"]
[19.209217, "o", "    stats = df.groupby(\"segment\").agg("]
[19.209364, "o", "\r\n"]
[19.209528, "o", "        {"]
[19.209657, "o", "\r\n"]
[19.209781, "o", "            \"amount\": [\"sum\", \"mean\"],"]
[19.209907, "o", "\r\n"]
[19.210036, "o", "            \"category\": lambda x: x.mode()[0] if not x.empty else None,"]
[19.210214, "o", "\r\n"]
[19.210358, "o", "            **{col: \"mean\" for col in bool_cols},"]
[19.210481, "o", "\r\n"]
[19.210619, "o", "        }"]
[19.210742, "o", "\r\n"]
[19.210876, "o", "    )"]
[19.211002, "o", "\r\n"]
[19.211126, "o", "    return stats, bool_cols"]
[19.211375, "o", "\r\n"]
[19.211548, "o", "\r\n"]
[19.211673, "o", "\r\n"]
[19.211796, "o", "if __name__ == \"__main__\":"]
[19.21192, "o", "\r\n"]
[19.212062, "o", "    df = load_sample_transactions()"]
[19.212255, "o", "\r\n"]
[19.212394, "o", "    print(df.head())"]
[19.212517, "o", "\r\n"]
