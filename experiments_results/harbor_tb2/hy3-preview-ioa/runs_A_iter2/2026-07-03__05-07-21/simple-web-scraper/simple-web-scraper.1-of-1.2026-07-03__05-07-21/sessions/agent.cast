[11.594003, "o", "\u001b[?2004hroot@6fe7af5cbd21:/app# "]
[25.004886, "i", "cat > scrape.py << 'EOF'\nimport re\nimport requests\nfrom bs4 import BeautifulSoup\nimport pandas as pd\n\nURL = \"http://server:8000\"\n\n\ndef parse_num(text, pattern):\n    m = re.search(pattern, text)\n    return m.group(1) if m else \"\"\n\n\ndef scrape(url=URL):\n    resp = requests.get(url, timeout=30)\n    resp.raise_for_status()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n\n    books = []\n    for book in soup.find_all(\"div\", class_=\"book\"):\n        title_el = book.find(\"div\", class_=\"book-title\")\n        author_el = book.find(\"div\", class_=\"book-author\")\n        year_el = book.find(\"span\", class_=\"book-year\")\n        rating_el = book.find(\"span\", class_=\"book-rating\")\n        price_el = book.find(\"span\", class_=\"book-price\")\n\n        title = title_el.get_text(strip=True) if title_el else \"\"\n        author = author_el.get_text(strip=True) if author_el else \"\"\n        # remove leading 'by '\n        author = re.sub(r\"^\\s*by\\s+\", \"\", author)\n        year = parse_num(year_el.get_text(strip=True), r\"(\\d{4})\") if year_e"]
[25.004931, "i", "l else \"\"\n        rating = parse_num(rating_el.get_text(strip=True), r\"([\\d.]+)/?5?\") if rating_el else \"\"\n        price = parse_num(price_el.get_text(strip=True), r\"\\$?([\\d.]+)\") if price_el else \"\"\n\n        books.append({\n            \"title\": title,\n            \"author\": author,\n            \"year\": int(year) if year else \"\",\n            \"rating\": float(rating) if rating else \"\",\n            \"price\": float(price) if price else \"\",\n        })\n    return books\n\n\ndef main():\n    books = scrape()\n    df = pd.DataFrame(books, columns=[\"title\", \"author\", \"year\", \"rating\", \"price\"])\n    df.to_csv(\"books.csv\", index=False)\n\n    total = len(df)\n    avg_price = df[\"price\"].mean()\n    idx = df[\"rating\"].idxmax()\n    top = df.loc[idx]\n\n    report = (\n        \"Book Store Scraping Summary Report\\n\"\n        \"==================================\\n\"\n        f\"Total number of books scraped: {total}\\n\"\n        f\"Average book price: ${avg_price:.2f}\\n\"\n        f\"Highest rated book: {top['title']} by {top['author']} \"\n        f\"(R"]
[25.004954, "i", "ating: {top['rating']}/5, Price: ${top['price']:.2f})\\n\"\n    )\n    with open(\"report.txt\", \"w\") as f:\n        f.write(report)\n\n    print(report)\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
