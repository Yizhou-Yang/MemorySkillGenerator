[19.561306, "o", "000000 0d 00 00 00 0a 0f 49 00 0f f0 0f df 0f ce 0f bd  >......I.........<\r\n000010 0f ac 0f 9b 0f 8a 0f 79 0f 61 0f 49 00 00 00 00  >.......y.a.I....<\r\n000020 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00  >................<\r\n*\r\n000f40 00 00 00 00 00 00 00 00 00 16 0a 04 00 21 07 74  >.............!.t<\r\n000f50 65 73 74 77 6f 72 64 30 39 3f e0 00 00 00 00 00  >estword09?......<\r\n000f60 00 16 09 04 00 21 07 74 65 73 74 77 6f 72 64 30  >.....!.testword0<\r\n000f70 38 40 58 ff 5c 28 f5 c2 8f 0f 08 04 00 21 01 74  >8@X.\\(.......!.t<\r\n000f80 65 73 74 77 6f 72 64 30 37 63 0f 07 04 00 21 01  >estword07c....!.<\r\n000f90 74 65 73 74 77 6f 72 64 30 36 4b 0f 06 04 00 21  >testword06K....!<\r\n000fa0 01 74 65 73 74 77 6f 72 64 30 35 32 0f 05 04 00  >.testword052....<\r\n000fb0 21 01 74 65 73 74 77 6f 72 64 30 34 2a 0f 04 04  >!.testword04*...<\r\n000fc0 00 21 01 74 65 73 74 77 6f 72 64 30 33 19 0f 03  >.!.testword03...<\r\n000fd0 04 00 21 01 74 65 73 74 77 6f 72 64 30 32 0a 0f  >..!.testword02..<\r\n000fe0 02 04 00 21 01 74 65 73 74 77 6f 72 64 30 31 02  >...!.testword01.<\r\n000ff0 0e 01 04 00 21 09 74 65 73 74 77 6f 72 64 30 30  >....!.testword00<\r\n001000\r\n"]
