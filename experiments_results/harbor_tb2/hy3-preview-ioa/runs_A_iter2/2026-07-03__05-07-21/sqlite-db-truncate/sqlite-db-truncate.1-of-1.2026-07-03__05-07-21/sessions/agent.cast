[254.745739, "i", "cat > /app/debug.py << 'EOF'\nimport struct\ndata = open('/app/trunc.db','rb').read()\n\ndef rv(b,off):\n    r=0\n    for i in range(9):\n        x=b[off+i]\n        if i==8: return (r<<8)|x, off+9\n        r=(r<<7)|(x&0x7f)\n        if not (x&0x80): return r, off+i+1\n    return r, off+9\n\ncc = int.from_bytes(data[3:5],'big')\nptrs = [int.from_bytes(data[8+i*2:10+i*2],'big') for i in range(cc)]\nfor ptr in ptrs:\n    off=ptr\n    pl,off = rv(data,off)\n    rid,off = rv(data,off)\n    rs = off\n    hl,off = rv(data,off)\n    he = rs+hl\n    serials=[]\n    while off<he:\n        st,off=rv(data,off)\n        serials.append(st)\n    body=off\n    print('--- ptr',hex(ptr),'pl',pl,'rid',rid,'hl',hl,'serials',[hex(s) for s in serials])\n    # dump body bytes\n    print('  body@',hex(body),'bytes:', data[body:body+20].hex())\n    for st in serials:\n        if st==0x21:\n            print('  text:', data[body:body+10].decode(), 'textbytes', data[body:body+10].hex())\n        if st==7:\n            print('  FLOAT bytes:', data[body:body+8].hex(), '= ', struct.unpack('<d', data[body:body+8])[0])\nEOF\npython3 /app/debug.py\n"]
