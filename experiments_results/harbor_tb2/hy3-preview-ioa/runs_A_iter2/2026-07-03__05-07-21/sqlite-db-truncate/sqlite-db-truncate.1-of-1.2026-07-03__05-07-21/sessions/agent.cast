[19.561696, "o", "\u001b[?2004hroot@c093e5eac1f3:/app# "]
[102.992006, "i", "cat > /app/recover.py << 'EOF'\nimport json\n\nwith open('/app/trunc.db','rb') as f:\n    data = f.read()\n\nprint('file size', len(data))\nprint('first byte', hex(data[0]))\n\n# We treat the whole file as a single table b-tree LEAF page (type 0x0d)\n# because the 100-byte database header is missing/overwritten.\n# Page header (leaf):\n#  0: page type\n#  1-2: first freeblock\n#  3-4: cell count\n#  5-6: cell content start\n#  7: fragmented free bytes\n#  8..: cell pointer array (2 bytes each)\n\ndef read_varint(b, off):\n    result = 0\n    for i in range(9):\n        x = b[off+i]\n        if i == 8:\n            result = (result << 8) | x\n            return result, off + 9\n        result = (result << 7) | (x & 0x7f)\n        if not (x & 0x80):\n            return result, off + i + 1\n    return result, off + 9\n\npage_type = data[0]\ncell_count = int.from_bytes(data[3:5], 'big')\ncell_start = int.from_bytes(data[5:7], 'big')\nprint('page_type', hex(page_type), 'cell_count', cell_count, 'cell_start', hex(cell_start))\n\ncell_ptrs = []\nfor i in range(cell_count):\n    off = 8 + i*2\n    p = int.from_bytes(data[off:off+2], 'big')\n    cell_ptrs.append(p)\nprint('cell_ptrs', [hex(p) for p in cell_ptrs])\n\ndef serial_value(st, b, off):\n    if st == 0:\n        return None, off\n    if st == 1:\n        return int.from_bytes(b[off:off+1], 'big', signed=True), off+1\n    if st == 2:\n        return int.from_bytes(b[off:off+2], 'big', signed=True), off+2\n    if st == 3:\n        return int.from_bytes(b[off:off+3], 'big', signed=True), off+3\n    if st == 4:\n        return int.from_bytes(b[off:off+4], 'big', signed=True), off+4\n    if st == 5:\n        return int.from_bytes(b[off:off+6], 'big', signed=True), off+6\n    if st == 6:\n        return int.from_bytes(b[off:off+8], 'big', signed=True), off+8\n    if st == 7:\n        return float(int.from_bytes(b[off:off+8], 'big')) if False else None, off  # placeholder\n    if st == 8:\n        return 0, off\n    if st == 9:\n        return 1, off\n    if st >= 12 and st % 2 == 0:\n        n = (st-12)//2\n        return b[off:off+n], off+n\n    if st >= 13 and st % 2 == 1:\n        n = (st-13)//2\n        return b[off:off+n].decode('utf-8', 'replace'), off+n\n    return None, off\n\nrows = []\nfor ptr in cell_ptrs:\n    try:\n        off = ptr\n        payload_len, off = read_varint(data, off)\n        rowid, off = read_varint(data, off)\n        rec_start = off\n        hdr_len, off = read_varint(data, off)\n        header_end = rec_start + hdr_len\n        serials = []\n        while off < header_end:\n            st, off = read_varint(data, off)\n            serials.append(st)\n        body = off\n        vals = []\n        for st in serials:\n            v, body = serial_value(st, data, body)\n            vals.append(v)\n        # classify: word = first text column, value = first numeric column\n        word = None\n        value = None\n        for v in vals:\n            if isinstance(v, str) and word is None:\n                word = v\n            elif isinstance(v, (int, float)) and not isinstance(v, bool) and value is None:\n                value = v\n        if word is None:\n            continue\n        if value is None:\n            value = 0\n        rows.append({'word': word, 'value': value})\n    except Exception as e:\n        print('failed ptr', hex(ptr), e)\n        continue\n\nprint('recovered', len(rows))\nfor r in rows:\n    print(r)\n\nwith open('/app/recover.json','w') as f:\n    json.dump(rows, f, indent=2)\nEOF\n"]
