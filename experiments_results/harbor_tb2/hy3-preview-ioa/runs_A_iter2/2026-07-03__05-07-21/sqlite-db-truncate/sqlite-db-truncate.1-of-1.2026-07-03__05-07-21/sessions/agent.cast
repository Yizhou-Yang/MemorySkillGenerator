[336.604786, "i", "cat > /app/debug2.py << 'EOF'\nimport struct\ndata = open('/app/trunc.db','rb').read()\n\ndef rv(b,off):\n    r=0\n    for i in range(9):\n        x=b[off+i]\n        if i==8: return (r<<8)|x, off+9\n        r=(r<<7)|(x&0x7f)\n        if not (x&0x80): return r, off+i+1\n    return r, off+9\n\ncc = int.from_bytes(data[3:5],'big')\nptrs = [int.from_bytes(data[8+i*2:10+i*2],'big') for i in range(cc)]\nfor ptr in ptrs:\n    off=ptr\n    pl,off = rv(data,off)\n    rid,off = rv(data,off)\n    rec_start=off\n    hl,off = rv(data,off)\n    he = rec_start+hl\n    serials=[]\n    while off<he:\n        st,off=rv(data,off); serials.append(st)\n    body=off\n    print('ptr',hex(ptr),'rid',rid,'serials',serials,'body',hex(body))\n    for st in serials:\n        if st==0x0:\n            pass\n        elif st==0x21:\n            print('   text=',data[body:body+10]); body+=10\n        elif st==7:\n            fb=data[body:body+8]\n            print('   FLOAT slice',fb.hex(),'->',struct.unpack('<d',fb)[0])\nEOF\npython3 /app/debug2.py\n"]
