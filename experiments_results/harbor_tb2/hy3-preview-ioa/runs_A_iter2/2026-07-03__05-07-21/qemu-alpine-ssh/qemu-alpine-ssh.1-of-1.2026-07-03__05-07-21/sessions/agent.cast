[782.663103, "o", "\u001b[?2004hroot@4690d664d417:/app# "]
[871.264071, "i", "cat > /app/setup.exp <<'EOF'\n#!/usr/bin/expect -f\nlog_file -a /tmp/setup.log\nset timeout 600\nspawn telnet 127.0.0.1 4444\nexpect \"login:\"\nsend \"root\\r\"\nexpect {\n  -re \"Password:\" { send \"\\r\" }\n  -re \"~#\" {}\n}\nexpect -re \"~#\"\nsend \"IF=\\$(ip -o link show | awk -F': ' '!/lo/{print \\$2; exit}'); echo IF=\\$IF; ip link set \\$IF up; (udhcpc -i \\$IF -t 10 -n || ip addr add 10.0.2.15/24 dev \\$IF); ip -br a\\r\"\nexpect -re \"~#\"\nsend \"echo RCHK; ls /media; echo ENDR\\r\"\nexpect \"ENDR\"\nexpect -re \"~#\"\nsend \"echo /media/cdrom/apks/x86_64 > /etc/apk/repositories; apk update 2>&1 | tail -2\\r\"\nexpect -re \"~#\"\nsend \"apk add openssh-server 2>&1 | tail -6\\r\"\nexpect -re \"~#\"\nsend \"echo 'root:password123' | chpasswd && echo PWOK\\r\"\nexpect \"PWOK\"\nexpect -re \"~#\"\nsend \"sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/; s/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config; grep -E 'PermitRootLogin|PasswordAuthentication' /etc/ssh/sshd_config\\r\"\nexpect -re \"~#\"\ns"]
[871.264133, "o", "cat > /app/setup.exp <<'EOF'"]
[871.264367, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[871.264464, "o", "> "]
[871.264642, "o", "#!/usr/bin/expect -f"]
[871.26473, "i", "end \"rc-update add sshd default; /etc/init.d/sshd start; sleep 1; netstat -tlnp 2>/dev/null | grep :22; echo ALLDONE\\r\"\nexpect \"ALLDONE\"\nexpect -re \"~#\"\nsend \"exit\\r\"\nexpect eof\nEOF\n"]
[871.264824, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[871.264996, "o", "> log_file -a /tmp/setup.log"]
[871.265088, "o", "\r\n"]
[871.265185, "o", "\u001b[?2004l\r"]
[871.265296, "o", "\u001b[?2004h"]
[871.265449, "o", "> set timeout 600"]
[871.266176, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> spawn telnet 127.0.0.1 4444\r\n\u001b[?2004l\r\u001b[?2004h> expect \"login:\"\r\n\u001b[?2004l\r\u001b[?2004h> send \"root\\r\"\r\n\u001b[?2004l\r\u001b[?2004h> expect {\r\n\u001b[?2004l\r\u001b[?2004h>   -re \"Password:\" { send \"\\r\" }\r\n\u001b[?2004l\r\u001b[?2004h>   -re \"~#\" {}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> expect -re \"~#\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[871.266304, "o", "> "]
[871.266742, "o", "send \"IF=\\$(ip -o link show | awk -F': ' '!/lo/{print \\$2; exit}'); echo IF=\\$IF; ip link set \\$IF up; (udhcpc -i \\$IF -t 10 -n || ip addr add 10.0.2.15/24 dev \\$IF); ip -br a\\r\"\r\n\u001b[?2004l\r"]
[871.266858, "o", "\u001b[?2004h> "]
[871.266905, "o", "expect -re \"~#\"\r\n\u001b[?2004l\r"]
[871.266926, "o", "\u001b[?2004h"]
[871.266956, "o", "> "]
[871.268471, "o", "send \"echo RCHK; ls /media; echo ENDR\\r\"\r\n\u001b[?2004l\r\u001b[?2004h> expect \"ENDR\"\r\n\u001b[?2004l\r\u001b[?2004h> expect -re \"~#\"\r\n\u001b[?2004l\r\u001b[?2004h> send \"echo /media/cdrom/apks/x86_64 > /etc/apk/repositories; apk update 2>&1 | tail -2\\r\"\r\n\u001b[?2004l\r\u001b[?2004h> expect -re \"~#\"\r\n\u001b[?2004l\r\u001b[?2004h> send \"apk add openssh-server 2>&1 | tail -6\\r\"\r\n\u001b[?2004l\r\u001b[?2004h> expect -re \"~#\"\r\n\u001b[?2004l\r\u001b[?2004h> send \"echo 'root:password123' | chpasswd && echo PWOK\\r\"\r\n\u001b[?2004l\r\u001b[?2004h> expect \"PWOK\"\r\n\u001b[?2004l\r\u001b[?2004h> expect -re \"~#\""]
[871.268735, "o", "\r\n"]
[871.26937, "o", "\u001b[?2004l\r\u001b[?2004h> send \"sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/; s/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config; grep -E 'PermitRootLogin|PasswordAuthentication' /etc/ssh/sshd_config\\r\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[871.269629, "o", "> "]
[871.269903, "o", "expect -re \"~#\""]
[871.270625, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> send \"rc-update add sshd default; /etc/init.d/sshd start; sleep 1; netstat -tlnp 2>/dev/null | grep :22; echo ALLDONE\\r\"\r\n\u001b[?2004l\r\u001b[?2004h> expect \"ALLDONE\"\r\n\u001b[?2004l\r\u001b[?2004h> expect -re \"~#\"\r\n\u001b[?2004l\r\u001b[?2004h> send \"exit\\r\"\r\n"]
[871.27079, "o", "\u001b[?2004l\r"]
