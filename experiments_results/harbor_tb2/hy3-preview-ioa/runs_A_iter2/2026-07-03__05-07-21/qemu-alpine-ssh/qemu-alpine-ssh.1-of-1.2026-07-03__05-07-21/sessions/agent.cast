[477.540911, "o", "\u001b[?2004l\r"]
[477.541057, "o", "\u001b[?2004h"]
[477.541262, "o", "> "]
[477.541484, "o", "        assert pvd[1:6]==b'CD001', 'not iso'"]
[477.541701, "o", "\r\n"]
[477.541838, "o", "\u001b[?2004l\r\u001b[?2004h"]
[477.542026, "o", "> "]
[477.542194, "o", "        root=pvd[156:190]"]
[477.542403, "o", "\r\n"]
[477.542538, "o", "\u001b[?2004l\r\u001b[?2004h"]
[477.54278, "o", ">         rlba=int.from_bytes(root[2:6],'little')"]
