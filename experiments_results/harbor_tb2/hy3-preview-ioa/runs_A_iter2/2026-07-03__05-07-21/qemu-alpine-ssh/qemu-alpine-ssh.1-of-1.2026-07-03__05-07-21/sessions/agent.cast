[168.617667, "i", "cat > /app/probe.exp <<'EOF'\n#!/usr/bin/expect -f\nlog_file -a /tmp/probe.log\nset timeout 200\nspawn telnet 127.0.0.1 4444\nexpect \"login:\"\nsend \"root\\r\"\nexpect {\n  \"Password:\" { send \"\\r\" }\n  \":~#\" { }\n}\nsend \"cat /etc/apk/repositories; echo MARK1; ls /media; echo MARK2; which sshd; which udhcpc; which apk; echo MARK3; ip -br a\\r\"\nexpect \"MARK3\"\nexpect \":~#\"\nsend \"exit\\r\"\nexpect eof\nEOF\n"]
