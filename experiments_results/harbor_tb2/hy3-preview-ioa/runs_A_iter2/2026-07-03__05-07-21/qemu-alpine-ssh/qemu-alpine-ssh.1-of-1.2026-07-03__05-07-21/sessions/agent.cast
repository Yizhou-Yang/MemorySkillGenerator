[477.54993, "o", "            with open(ISO,'rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[477.550212, "o", "                n=(s+SECTOR-1)//SECTOR\r\n\u001b[?2004l\r\u001b[?2004h>                 data=b''\r\n\u001b[?2004l\r\u001b[?2004h>                 for i in range(n):\r\n\u001b[?2004l\r"]
[477.550399, "o", "\u001b[?2004h>                     data+=read_sector(f,l+i)\r\n\u001b[?2004l\r"]
[477.550658, "o", "\u001b[?2004h>                 data=data[:s]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[477.550803, "o", "            with open(path.split('/')[-1],'wb') as o:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[477.551091, "o", "                o.write(data)\r\n\u001b[?2004l\r\u001b[?2004h>             print('wrote',path.split('/')[-1],s)\r\n\u001b[?2004l\r"]
[477.551253, "o", "\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h>     print('not found',path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[477.551525, "o", "if __name__=='__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     if sys.argv[1]=='list': list_files()\r\n\u001b[?2004l\r"]
