[477.533039, "o", "        nm=name.split(b';')[0].replace(b' ',b'')"]
[477.533241, "o", "\r\n"]
[477.533386, "o", "\u001b[?2004l\r"]
[477.533644, "o", "\u001b[?2004h"]
[477.5338, "o", "> "]
