[477.509786, "i", "cat > /app/iso.py <<'EOF'\nimport sys\nISO=\"/app/alpine.iso\"\nSECTOR=2048\ndef read_sector(f,lba):\n    f.seek(lba*SECTOR)\n    return f.read(SECTOR)\ndef walk(f, lba, length, prefix, out):\n    n=(length+SECTOR-1)//SECTOR\n    data=b''\n    for i in range(n):\n        data+=read_sector(f,lba+i)\n    data=data[:length]\n    off=0\n    while off+33<=len(data):\n        reclen=data[off]\n        if reclen==0:\n            off=(off//SECTOR+1)*SECTOR\n            continue\n        rec=data[off:off+reclen]\n        if len(rec)<33: break\n        ext_lba=int.from_bytes(rec[2:6],'little')\n        ext_size=int.from_bytes(rec[10:14],'little')\n        flags=rec[25]\n        id_len=rec[32]\n        name=rec[33:33+id_len]\n        off+=reclen\n        nm=name.split(b';')[0].replace(b' ',b'')\n        if nm in (b'\\x00',b'\\x01'): continue\n        path=(prefix+'/'+nm.decode('latin1'))\n        if flags & 2:\n            walk(f,ext_lba,ext_size,path,out)\n        else:\n            out.append((path,ext_lba,ext_size))\ndef list_files():\n    out=[]\n    with"]
[477.509844, "o", "cat > /app/iso.py <<'EOF'"]
[477.510325, "i", " open(ISO,'rb') as f:\n        pvd=read_sector(f,16)\n        assert pvd[1:6]==b'CD001', 'not iso'\n        root=pvd[156:190]\n        rlba=int.from_bytes(root[2:6],'little')\n        rlen=int.from_bytes(root[10:14],'little')\n        walk(f,rlba,rlen,'',out)\n    for p,l,s in sorted(out):\n        print(f\"{s:>10}  {p}\")\n    return out\ndef extract(path):\n    out=list_files()\n    for p,l,s in out:\n        if p.lower()==path.lower():\n            with open(ISO,'rb') as f:\n                n=(s+SECTOR-1)//SECTOR\n                data=b''\n                for i in range(n):\n                    data+=read_sector(f,l+i)\n                data=data[:s]\n            with open(path.split('/')[-1],'wb') as o:\n                o.write(data)\n            print('wrote',path.split('/')[-1],s)\n            return\n    print('not found',path)\nif __name__=='__main__':\n    if sys.argv[1]=='list': list_files()\n    elif sys.argv[1]=='extract': extract(sys.argv[2])\nEOF\n"]
