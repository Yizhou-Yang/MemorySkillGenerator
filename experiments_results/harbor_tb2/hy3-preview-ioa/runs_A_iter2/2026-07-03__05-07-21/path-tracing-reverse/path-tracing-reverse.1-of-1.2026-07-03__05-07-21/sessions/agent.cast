[159.960983, "i", "python3 - <<'EOF'\nimport struct\nhexlines=[\"01000200 00008040 6f12833a 17b7d138\",\n\"cdcc4c3e 6666663f cdcccc3e 0000c0bf\",\n\"cdcc4c3f 0000004b 71fd7f43 000080bf\",\n\"0000c842 00001644 00c01544 00c04744\",\n\"abaa2a40 abaaaa3f 01020304 05060708\"]\nbase=0x3000\nfor ln in hexlines:\n    ws=ln.split()\n    for w in ws:\n        b=bytes.fromhex(w)\n        f=struct.unpack('<f',b)[0]\n        i=struct.unpack('<I',b)[0]\n        print(hex(base), w, f, i)\n        base+=4\nEOF\n"]
[159.971095, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct\r\n\u001b[?2004l\r\u001b[?2004h> hexlines=[\"01000200 00008040 6f12833a 17b7d138\",\r\n\u001b[?2004l\r\u001b[?2004h> \"cdcc4c3e 6666663f cdcccc3e 0000c0bf\",\r\n\u001b[?2004l\r\u001b[?2004h> \"cdcc4c3f 0000004b 71fd7f43 000080bf\",\r\n\u001b[?2004l\r\u001b[?2004h> \"0000c842 00001644 00c01544 00c04744\",\r\n\u001b[?2004l\r\u001b[?2004h> \"abaa2a40 abaaaa3f 01020304 05060708\"]\r\n\u001b[?2004l\r\u001b[?2004h> base=0x3000\r\n\u001b[?2004l\r\u001b[?2004h> for ln in hexlines:\r\n\u001b[?2004l\r\u001b[?2004h>     ws=ln.split()\r\n\u001b[?2004l\r"]
[159.971476, "o", "\u001b[?2004h>     for w in ws:\r\n\u001b[?2004l\r\u001b[?2004h>         b=bytes.fromhex(w)\r\n\u001b[?2004l\r\u001b[?2004h>         f=struct.unpack('<f',b)[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.971623, "o", ">         i=struct.unpack('<I',b)[0]\r\n\u001b[?2004l\r"]
[159.971773, "o", "\u001b[?2004h>         print(hex(base), w, f, i)\r\n\u001b[?2004l\r"]
