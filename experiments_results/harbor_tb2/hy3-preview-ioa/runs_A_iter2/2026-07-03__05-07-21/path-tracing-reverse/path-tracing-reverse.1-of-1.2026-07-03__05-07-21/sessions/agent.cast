[485.050735, "o", "\u001b[?2004hroot@ce0a3652f1b4:/app# "]
[564.908085, "i", "python3 - <<'EOF'\nimport struct\nwith open('mystery','rb') as f:\n    data=f.read()\n# find .rodata via readelf-like: just search for 'image.ppm' and 'wb'\nfor pat in [b'image.ppm',b'wb',b'P3',b'Wrote']:\n    i=data.find(pat)\n    print(pat, hex(i) if i>=0 else 'NOTFOUND')\nEOF\n"]
[564.909935, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct\r\n\u001b[?2004l\r\u001b[?2004h> with open('mystery','rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data=f.read()\r\n\u001b[?2004l\r\u001b[?2004h> # find .rodata via readelf-like: just search for 'image.ppm' and 'wb'\r\n\u001b[?2004l\r\u001b[?2004h> for pat in [b'image.ppm',b'wb',b'P3',b'Wrote']:\r\n\u001b[?2004l\r\u001b[?2004h>     i=data.find(pat)\r\n\u001b[?2004l\r\u001b[?2004h>     print(pat, hex(i) if i>=0 else 'NOTFOUND')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[564.945984, "o", "b'image.ppm' 0x309c\r\nb'wb' NOTFOUND\r\nb'P3' 0x304a\r\nb'Wrote' 0x3062\r\n"]
