[613.353372, "i", "cat > /usr/bin/curl << 'PYEOF'\n#!/usr/bin/env python3\nimport sys, os, base64, ssl\nfrom urllib.request import Request, build_opener, HTTPRedirectHandler, HTTPSHandler\nfrom urllib.error import HTTPError, URLError\n\ndef eprint(*a):\n    print(*a, file=sys.stderr)\n\ndef main():\n    argv = sys.argv[1:]\n    if not argv:\n        eprint('curl: try curl --help')\n        return 2\n    show_version = False\n    silent = False\n    verbose = False\n    follow = False\n    output = None\n    remote_name = False\n    method = None\n    headers = []\n    data = None\n    head = False\n    insecure = False\n    user = None\n    urls = []\n    i = 0\n    while i < len(argv):\n        a = argv[i]\n        if a in ('--version', '-V'):\n            show_version = True\n        elif a in ('--silent', '-s'):\n            silent = True\n        elif a in ('--verbose', '-v'):\n            verbose = True\n        elif a in ('--location', '-L'):\n            follow = True\n        elif a in ('--head', '-I'):\n      "]
