[613.357082, "i", "      head = True\n        elif a in ('--insecure', '-k'):\n            insecure = True\n        elif a in ('-o', '--output'):\n            i += 1\n            output = argv[i]\n        elif a.startswith('-o') and len(a) > 2:\n            output = a[2:]\n        elif a in ('-O', '--remote-name'):\n            remote_name = True\n        elif a in ('-X', '--request'):\n            i += 1\n            method = argv[i]\n        elif a.startswith('-X') and len(a) > 2:\n            method = a[2:]\n        elif a in ('-H', '--header'):\n            i += 1\n            headers.append(argv[i])\n        elif a.startswith('-H') and len(a) > 2:\n            headers.append(a[2:])\n        elif a in ('-d', '--data', '--data-raw'):\n            i += 1\n            data = argv[i]\n        elif a.startswith('-d') and len(a) > 2 and not a.startswith('--data'):\n            data = a[2:]\n        elif a in ('-u', '--user'):\n            i += 1\n            user = argv[i]\n        elif a.startswith('-u') and len(a) > 2:\n            user = a[2:]\n        elif a.startswith('-'):\n            pass\n        else:\n            urls.append(a)\n        i += 1\n    if show_version:\n        print('curl 8.2.1 (x86_64-pc-linux-gnu) libcurl/8.2.1 OpenSSL zlib python-wrapper')\n        print('Release-Date: 2023-07-26')\n        print('Protocols: dict file ftp ftps http https')\n        print('Features: AsynchDNS HTTPS-proxy')\n        return 0\n    if not urls:\n        eprint('curl: no URL specified!')\n        return 2\n    hdrs = {}\n    for h in headers:\n        if ':' in h:\n            k, v = h.split(':', 1)\n            hdrs[k.strip()] = v.strip()\n    if user:\n        tok = base64.b64encode(user.encode()).decode()\n        hdrs.setdefault('Authorization', 'Basic ' + tok)\n    body = None\n    if data is not None:\n        body = data.encode()\n        if method is None:\n            method = 'POST'\n        hdrs.setdefault('Content-Type', 'application/x-www-form-urlencoded')\n    if method is None:\n        method = 'HEAD' if head else 'GET'\n    ctx = None\n    if insecure:\n        ctx = ssl.create_default_context()\n        ctx.check_hostname = False\n        ctx.verify_mode = ssl.CERT_NONE\n    class NoRedirect(HTTPRedirectHandler):\n        def redirect_request(self, *a, **k):\n            return None\n    handlers = []\n    if ctx:\n        handlers.append(HTTPSHandler(context=ctx))\n    if not follow:\n        handlers.append(NoRedirect())\n    opener = build_opener(*handlers)\n    rc = 0\n    for url in urls:\n        req = Request(url, data=body, method=method)\n        for k, v in hdrs.items():\n            req.add_header(k, v)\n        try:\n            resp = opener.open(req)\n        except HTTPError as e:\n            resp = e\n        except URLError as e:\n            eprint('curl: (%s) %s' % (url, e.reason))\n            rc = 6\n            continue\n        status = resp.status\n        if verbose:\n            ver = getattr(resp, 'version', None)\n            http_ver = ver / 10.0 if ver else 1.1\n            eprint('HTTP/%s %d %s' % (http_ver, status, resp.reason))\n            for k, v in resp.getheaders():\n                eprint('%s: %s' % (k, v))\n            eprint('')\n        out = output\n        if remote_name and out is None:\n            out = os.path.basename(url.split('?')[0]) or 'index.html'\n        try:\n            payload = resp.read()\n        finally:\n            resp.close()\n        if out:\n            with open(out, 'wb') as f:\n                f.write(payload)\n        else:\n            sys.stdout.buffer.write(payload)\n            sys.stdout.flush()\n        if 400 <= status < 600:\n            rc = 22\n    return rc\n\nif __name__ == '__main__':\n    sys.exit(main())\nPYEOF\n"]
