[1342.639817, "o", "        with FileLock(lock_path) if is_local else contextlib.nullcontext():"]
[1342.639958, "o", "\r\n"]
[1342.640111, "o", "            # Check if the data already exists"]
[1342.640241, "o", "\r\n"]
[1342.640375, "o", "            data_exists = self._fs.exists(posixpath.join(self._output_dir, config.DATASET_INFO_FILENAME))"]
[1342.64059, "o", "\r\n"]
[1342.640743, "o", "            if data_exists and download_mode == DownloadMode.REUSE_DATASET_IF_EXISTS:"]
[1342.640871, "o", "\r\n"]
[1342.641001, "o", "                logger.info(f\"Found cached dataset {self.dataset_name} ({self._output_dir})\")"]
[1342.641149, "o", "\r\n"]
[1342.64128, "o", "                # We need to update the info in case some splits were added in the meantime"]
[1342.641409, "o", "\r\n"]
[1342.64154, "o", "                # for example when calling load_dataset from multiple workers."]
[1342.641685, "o", "\r\n"]
[1342.641816, "o", "                self.info = self._load_info()"]
[1342.642067, "o", "\r\n                self.download_post_processing_resources(dl_manager)\r\n                return\r\n\r\n            logger.info(f\"Generating dataset {self.dataset_name} ({self._output_dir})\")\r\n            if is_local:  # if cache dir is local, check for available space\r\n                if not has_sufficient_disk_space("]
[1342.642341, "o", "\r\n                    self.info.size_in_bytes or 0, directory=Path(self._output_dir).parent\r\n                ):\r\n                    raise OSError(\r\n                        f\"Not enough disk space. Needed: {size_str(self.info.size_in_bytes or 0)} (download: {size_str(self.info.download_size or 0)}, generated: {size_str(self.info.dataset_size or 0)}, post-processed: {size_str(self.info.post_processing_size or 0)})\"\r\n                    )\r\n\r\n            @contextlib.contextmanager\r\n            def incomplete_dir(dirname):\r\n                \"\"\"Create temporary dir for dirname and rename on exit.\"\"\"\r\n                if not is_local:\r\n                    self._fs.makedirs(dirname, exist_ok=True)\r\n                    yield dirname\r\n                else:\r\n                    tmp_dir = dirname + \".incomplete\"\r\n                    os.makedirs(tmp_dir, exist_ok=True)\r\n                    try:\r\n                        yield tmp_dir\r\n                        if os.path.isdir(dirname):\r\n                            shutil.rmt"]
[1342.642639, "o", "ree(dirname)\r\n"]
