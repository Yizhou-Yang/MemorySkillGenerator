[360.971247, "o", "\r\n"]
[360.971417, "o", "\u001b[?2004l\r"]
[360.983646, "o", "class ModelMeta(BaseModel):"]
[360.984052, "o", "\r\n"]
[360.984229, "o", "    \"\"\"The model metadata object."]
[360.984482, "o", "\r\n"]
[360.984677, "o", "\r\n"]
[360.984849, "o", "    Attributes:"]
[360.985027, "o", "\r\n"]
[360.985202, "o", "        loader: the function that loads the model. If None it will just default to loading the model using the sentence transformer library."]
[360.985413, "o", "\r\n"]
[360.985609, "o", "        name: The name of the model, ideally the name on huggingface."]
[360.985784, "o", "\r\n"]
[360.985958, "o", "        n_parameters: The number of parameters in the model, e.g. 7_000_000 for a 7M parameter model. Can be None if the number of parameters is not known (e.g. for proprietary models) or"]
[360.986141, "o", "\r\n"]
[360.986315, "o", "            if the loader returns a SentenceTransformer model from which it can be derived."]
[360.986508, "o", "\r\n"]
[360.986703, "o", "        memory_usage_mb: The memory usage of the model in MB. Can be None if the memory usage is not known (e.g. for proprietary models). To calculate it use the `calculate_memory_usage_mb` method."]
[360.986884, "o", "\r\n"]
[360.987058, "o", "        max_tokens: The maximum number of tokens the model can handle. Can be None if the maximum number of tokens is not known (e.g. for proprietary"]
[360.987234, "o", "\r\n"]
[360.98743, "o", "            models)."]
[360.98763, "o", "\r\n"]
[360.987803, "o", "        embed_dim: The dimension of the embeddings produced by the model. Currently all models are assumed to produce fixed-size embeddings."]
[360.988004, "o", "\r\n"]
[360.988177, "o", "        revision: The revision number of the model. If None, it is assumed that the metadata (including the loader) is valid for all revisions of the model."]
[360.988353, "o", "\r\n"]
[360.988556, "o", "        release_date: The date the model's revision was released."]
[360.988744, "o", "\r\n"]
[360.988913, "o", "        license: The license under which the model is released. Required if open_weights is True."]
[360.989084, "o", "\r\n"]
[360.989254, "o", "        open_weights: Whether the model is open source or proprietary."]
[360.989441, "o", "\r\n"]
[360.989634, "o", "        public_training_code: A link to the publicly available training code. If None, it is assumed that the training code is not publicly available."]
[360.989807, "o", "\r\n"]
[360.989983, "o", "        public_training_data: A link to the publicly available training data. If None, it is assumed that the training data is not publicly available."]
[360.990156, "o", "\r\n"]
[360.990329, "o", "        similarity_fn_name: The distance metric used by the model."]
[360.990535, "o", "\r\n"]
[360.990726, "o", "        framework: The framework the model is implemented in, can be a list of frameworks e.g. `[\"Sentence Transformers\", \"PyTorch\"]`."]
[360.991048, "o", "\r\n"]
[360.99122, "o", "        reference: A URL to the model's page on huggingface or another source."]
[360.991409, "o", "\r\n"]
[360.991582, "o", "        languages: The languages the model is intended to be specified as a 3-letter language code followed by a script code e.g., \"eng-Latn\" for English"]
[360.991772, "o", "\r\n"]
[360.991939, "o", "            in the Latin script."]
[360.992109, "o", "\r\n"]
[360.992289, "o", "        use_instructions: Whether the model uses instructions E.g. for prompt-based models. This also includes models that require a specific format for"]
[360.992492, "o", "\r\n"]
[360.992687, "o", "            input, such as \"query: {document}\" or \"passage: {document}\"."]
[360.994389, "o", "\r\n"]
[360.994702, "o", "        training_datasets: A dictionary of datasets that the model was trained on. Names should be names as they appear in `mteb` for example"]
[360.994909, "o", "\r\n"]
[360.995087, "o", "            {\"ArguAna\": [\"test\"]} if the model is trained on the ArguAna test set. This field is used to determine if a model generalizes zero-shot to"]
[360.995268, "o", "\r\n"]
[360.995465, "o", "            a benchmark as well as mark dataset contaminations."]
[360.995664, "o", "\r\n"]
[360.995843, "o", "        adapted_from: Name of the model from which this model is adapted. For quantizations, fine-tunes, long doc extensions, etc."]
[360.996022, "o", "\r\n"]
[360.996198, "o", "        superseded_by: Name of the model that supersedes this model, e.g., nvidia/NV-Embed-v2 supersedes v1."]
[360.996395, "o", "\r\n"]
[360.996578, "o", "        is_cross_encoder: Whether the model can act as a cross-encoder or not."]
[360.996775, "o", "\r\n"]
[360.996951, "o", "        modalities: A list of strings representing the modalities the model supports. Default is [\"text\"]."]
[360.997128, "o", "\r\n"]
[360.997301, "o", "    \"\"\""]
[360.997503, "o", "\r\n"]
[360.997694, "o", "\r\n"]
[360.997871, "o", "    model_config = ConfigDict(extra=\"forbid\")"]
[360.998046, "o", "\r\n"]
[360.998221, "o", "\r\n"]
[360.998411, "o", "    name: str | None"]
[360.998592, "o", "\r\n"]
[360.998786, "o", "    revision: str | None"]
[360.998966, "o", "\r\n"]
[360.999141, "o", "    release_date: STR_DATE | None"]
[360.999318, "o", "\r\n"]
[360.999514, "o", "    languages: list[ISO_LANGUAGE_SCRIPT] | None"]
[360.999709, "o", "\r\n"]
[360.999889, "o", "    loader: Callable[..., Encoder] | None = None"]
[361.000065, "o", "\r\n"]
[361.000239, "o", "    n_parameters: int | None"]
[361.000433, "o", "\r\n"]
[361.000629, "o", "    memory_usage_mb: float | None"]
[361.000803, "o", "\r\n"]
[361.00098, "o", "    max_tokens: float | None"]
[361.001154, "o", "\r\n"]
[361.00133, "o", "    embed_dim: int | None"]
[361.001529, "o", "\r\n"]
[361.001722, "o", "    license: str | None"]
[361.001897, "o", "\r\n"]
[361.002076, "o", "    open_weights: bool | None"]
[361.002253, "o", "\r\n"]
[361.002451, "o", "    public_training_code: str | None"]
[361.002644, "o", "\r\n"]
[361.00282, "o", "    public_training_data: str | bool | None"]
[361.003957, "o", "\r\n"]
[361.004279, "o", "    framework: list[FRAMEWORKS]"]
[361.004492, "o", "\r\n"]
[361.00469, "o", "    reference: STR_URL | None = None"]
[361.00487, "o", "\r\n"]
[361.005051, "o", "    similarity_fn_name: DISTANCE_METRICS | None"]
[361.005235, "o", "\r\n"]
[361.005438, "o", "    use_instructions: bool | None"]
[361.005645, "o", "\r\n"]
[361.005825, "o", "    training_datasets: dict[str, list[str]] | None"]
[361.006004, "o", "\r\n"]
[361.006183, "o", "    adapted_from: str | None = None"]
[361.00636, "o", "\r\n"]
[361.006566, "o", "    superseded_by: str | None = None"]
[361.006762, "o", "\r\n"]
[361.006942, "o", "    is_cross_encoder: bool | None = None"]
[361.007123, "o", "\r\n"]
