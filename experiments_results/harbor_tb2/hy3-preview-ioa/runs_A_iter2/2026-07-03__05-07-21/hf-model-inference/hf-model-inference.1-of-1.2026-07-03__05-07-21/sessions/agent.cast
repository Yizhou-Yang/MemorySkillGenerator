[321.670752, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.671289, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r"]
[321.671314, "o", "\u001b[?2004h> from flask import Flask, request, jsonify\r\n\u001b[?2004l\r\u001b[?2004h> from transformers import AutoTokenizer, AutoModelForSequenceClassification\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.671377, "o", "MODEL_PATH = \"/app/model_cache/sentiment_model\"\r\n\u001b[?2004l\r"]
[321.671423, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.671573, "o", "app = Flask(__name__)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.671704, "o", "print(\"Loading model from\", MODEL_PATH, flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.671885, "o", "tokenizer = AutoTokenizer.from_pretrained(MODEL_PATH, local_files_only=True)\r\n\u001b[?2004l\r"]
[321.672186, "o", "\u001b[?2004h> model = AutoModelForSequenceClassification.from_pretrained(MODEL_PATH, local_files_only=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.672511, "o", "model.eval()"]
[321.672841, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.673513, "o", "print(\"Model loaded.\", flush=True)"]
[321.673783, "o", "\r\n"]
[321.674186, "o", "\u001b[?2004l\r"]
[321.674346, "o", "\u001b[?2004h"]
[321.674535, "o", "> "]
[321.67471, "o", "\r\n"]
[321.674913, "o", "\u001b[?2004l\r"]
[321.675064, "o", "\u001b[?2004h"]
[321.675225, "o", "> "]
[321.675549, "o", "# distilbert sst-2 config: id2label -> 0=NEGATIVE, 1=POSITIVE"]
[321.676777, "o", "\r\n"]
[321.676857, "o", "\u001b[?2004l\r"]
[321.676986, "o", "\u001b[?2004h"]
[321.677097, "o", "> "]
[321.677413, "o", "id2label = getattr(model.config, \"id2label\", None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.677575, "o", "if id2label and isinstance(id2label, dict):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.677776, "o", "    label_map = {int(k): str(v).lower() for k, v in id2label.items()}\r\n\u001b[?2004l\r"]
[321.677843, "o", "\u001b[?2004h> "]
[321.677859, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.677987, "o", "    label_map = {0: \"negative\", 1: \"positive\"}"]
[321.678154, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.678176, "o", "> "]
[321.678232, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.678879, "o", "\u001b[?2004h> def analyze(text):\r\n\u001b[?2004l\r\u001b[?2004h>     inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\r\n\u001b[?2004l\r\u001b[?2004h>     with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>         logits = model(**inputs).logits\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.678951, "o", "        probs = F.softmax(logits, dim=-1)[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.679808, "o", "    conf = {}\r\n\u001b[?2004l\r\u001b[?2004h>     for idx, label in label_map.items():\r\n\u001b[?2004l\r\u001b[?2004h>         # normalize label key to positive/negative\r\n\u001b[?2004l\r\u001b[?2004h>         key = \"positive\" if \"pos\" in label else (\"negative\" if \"neg\" in label else label)\r\n\u001b[?2004l\r\u001b[?2004h>         conf[key] = float(probs[idx].item())\r\n\u001b[?2004l\r\u001b[?2004h>     if \"positive\" not in conf:\r\n\u001b[?2004l\r"]
[321.679825, "o", "\u001b[?2004h> "]
[321.680924, "o", "        conf[\"positive\"] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     if \"negative\" not in conf:\r\n\u001b[?2004l\r\u001b[?2004h>         conf[\"negative\"] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     sentiment = \"positive\" if conf[\"positive\"] >= conf[\"negative\"] else \"negative\"\r\n\u001b[?2004l\r\u001b[?2004h>     return sentiment, conf\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.681095, "o", "\u001b[?2004h> "]
[321.681141, "o", "\r\n\u001b[?2004l\r"]
[321.681152, "o", "\u001b[?2004h"]
[321.681524, "o", "> @app.route(\"/sentiment\", methods=[\"POST\"])\r\n\u001b[?2004l\r\u001b[?2004h> def sentiment():\r\n\u001b[?2004l\r\u001b[?2004h>     data = request.get_json(silent=True)\r\n\u001b[?2004l\r"]
[321.681552, "o", "\u001b[?2004h> "]
[321.681611, "o", "    if data is None:\r\n\u001b[?2004l\r"]
[321.681634, "o", "\u001b[?2004h"]
[321.681659, "o", "> "]
[321.681842, "o", "        return jsonify({\"error\": \"Request body must be valid JSON\"}), 400\r\n\u001b[?2004l\r"]
[321.681868, "o", "\u001b[?2004h> "]
[321.682014, "o", "    if not isinstance(data, dict) or \"text\" not in data:\r\n\u001b[?2004l\r"]
[321.682074, "o", "\u001b[?2004h> "]
[321.682261, "o", "        return jsonify({\"error\": \"Missing required field 'text'\"}), 400\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.682284, "o", "> "]
[321.682334, "o", "    text = data[\"text\"]\r\n\u001b[?2004l\r"]
[321.682349, "o", "\u001b[?2004h> "]
[321.682553, "o", "    if not isinstance(text, str) or not text.strip():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.682771, "o", "        return jsonify({\"error\": \"Field 'text' must be a non-empty string\"}), 400\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.682806, "o", "> "]
[321.682817, "o", "    try:\r\n\u001b[?2004l\r"]
[321.682878, "o", "\u001b[?2004h> "]
[321.683019, "o", "        sentiment_label, conf = analyze(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.683215, "o", "        return jsonify({\"sentiment\": sentiment_label, \"confidence\": conf})\r\n\u001b[?2004l\r"]
[321.683241, "o", "\u001b[?2004h> "]
[321.683323, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[321.683344, "o", "\u001b[?2004h> "]
[321.683493, "o", "        return jsonify({\"error\": str(e)}), 500\r\n\u001b[?2004l\r"]
[321.683513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[321.683545, "o", "\u001b[?2004h"]
[321.683551, "o", "> \r\n\u001b[?2004l\r"]
[321.683576, "o", "\u001b[?2004h"]
[321.683584, "o", "> "]
[321.683726, "o", "@app.route(\"/health\", methods=[\"GET\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.683739, "o", "> "]
[321.68377, "o", "def health():\r\n\u001b[?2004l\r"]
[321.683792, "o", "\u001b[?2004h"]
[321.683801, "o", "> "]
[321.683904, "o", "    return jsonify({\"status\": \"ok\"})\r\n\u001b[?2004l\r"]
[321.683916, "o", "\u001b[?2004h"]
[321.684, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[321.684083, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[321.684098, "o", "\u001b[?2004h"]
[321.684154, "o", "> "]
[321.684339, "o", "    app.run(host=\"0.0.0.0\", port=5000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[321.684388, "o", "> "]
[321.684492, "o", "EOF\r\n\u001b[?2004l\r"]
[321.687967, "o", "\u001b[?2004hroot@7febd660ca3b:/app# "]
[321.688184, "m", "Episode 10: 2 commands"]
[321.688184, "o", "echo 'app.py written'\r\n\u001b[?2004l\rapp.py written\r\n\u001b[?2004hroot@7febd660ca3b:/app# "]
