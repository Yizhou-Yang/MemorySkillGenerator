[347.469343, "i", "cat > /app/test_api.py << 'EOF'\nimport json\nimport urllib.request\n\nURL = \"http://127.0.0.1:5000/sentiment\"\n\nsamples = [\n    \"I absolutely loved this movie, it was fantastic and heartwarming!\",\n    \"This was a terrible experience, I hated every boring minute of it.\",\n    \"The book was okay, nothing special but not bad either.\",\n]\n\nfor text in samples:\n    payload = json.dumps({\"text\": text}).encode(\"utf-8\")\n    req = urllib.request.Request(URL, data=payload, headers={\"Content-Type\": \"application/json\"}, method=\"POST\")\n    try:\n        with urllib.request.urlopen(req, timeout=30) as resp:\n            result = json.loads(resp.read().decode(\"utf-8\"))\n        print(\"TEXT:   \", text)\n        print(\"RESULT: \", json.dumps(result, indent=2))\n    except urllib.error.HTTPError as e:\n        body = e.read().decode(\"utf-8\")\n        print(\"TEXT:   \", text)\n        print(\"ERROR:  \", body)\n    print(\"-\" * 60)\nEOF\npython3 /app/test_api.py\n"]
