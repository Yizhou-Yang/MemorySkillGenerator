[321.670358, "i", "cat > /app/app.py << 'EOF'\nimport os\nimport torch\nimport torch.nn.functional as F\nfrom flask import Flask, request, jsonify\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\nMODEL_PATH = \"/app/model_cache/sentiment_model\"\n\napp = Flask(__name__)\n\nprint(\"Loading model from\", MODEL_PATH, flush=True)\ntokenizer = AutoTokenizer.from_pretrained(MODEL_PATH, local_files_only=True)\nmodel = AutoModelForSequenceClassification.from_pretrained(MODEL_PATH, local_files_only=True)\nmodel.eval()\nprint(\"Model loaded.\", flush=True)\n\n# distilbert sst-2 config: id2label -> 0=NEGATIVE, 1=POSITIVE\nid2label = getattr(model.config, \"id2label\", None)\nif id2label and isinstance(id2label, dict):\n    label_map = {int(k): str(v).lower() for k, v in id2label.items()}\nelse:\n    label_map = {0: \"negative\", 1: \"positive\"}\n\n\ndef analyze(text):\n    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n    with torch.no_grad():\n        logits = model(**inputs).logits\n        probs = F.softmax(logi"]
[321.670422, "i", "ts, dim=-1)[0]\n    conf = {}\n    for idx, label in label_map.items():\n        # normalize label key to positive/negative\n        key = \"positive\" if \"pos\" in label else (\"negative\" if \"neg\" in label else label)\n        conf[key] = float(probs[idx].item())\n    if \"positive\" not in conf:\n        conf[\"positive\"] = 0.0\n    if \"negative\" not in conf:\n        conf[\"negative\"] = 0.0\n    sentiment = \"positive\" if conf[\"positive\"] >= conf[\"negative\"] else \"negative\"\n    return sentiment, conf\n\n\n@app.route(\"/sentiment\", methods=[\"POST\"])\ndef sentiment():\n    data = request.get_json(silent=True)\n    if data is None:\n        return jsonify({\"error\": \"Request body must be valid JSON\"}), 400\n    if not isinstance(data, dict) or \"text\" not in data:\n        return jsonify({\"error\": \"Missing required field 'text'\"}), 400\n    text = data[\"text\"]\n    if not isinstance(text, str) or not text.strip():\n        return jsonify({\"error\": \"Field 'text' must be a non-empty string\"}), 400\n    try:\n        sentiment_label, conf = analyz"]
[321.670437, "i", "e(text)\n        return jsonify({\"sentiment\": sentiment_label, \"confidence\": conf})\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n\n\n@app.route(\"/health\", methods=[\"GET\"])\ndef health():\n    return jsonify({\"status\": \"ok\"})\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=5000)\nEOF\necho 'app.py written'\n"]
