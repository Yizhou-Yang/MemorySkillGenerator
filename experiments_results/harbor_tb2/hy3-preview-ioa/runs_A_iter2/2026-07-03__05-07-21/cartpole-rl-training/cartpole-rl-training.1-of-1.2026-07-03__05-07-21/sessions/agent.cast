[70.609094, "o", "import torch.optim as optim\r\n\u001b[?2004l\r\u001b[?2004h> import gymnasium as gym\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from agent import Agent\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> BATCH_SIZE = 128\r\n\u001b[?2004l\r\u001b[?2004h> GAMMA = 0.99\r\n\u001b[?2004l\r\u001b[?2004h> LR = 1e-3\r\n\u001b[?2004l\r\u001b[?2004h> BUFFER_SIZE = 100000\r\n\u001b[?2004l\r"]
[70.609251, "o", "\u001b[?2004h"]
[70.609359, "o", "> "]
[70.609501, "o", "TARGET_UPDATE = 10"]
[70.609601, "o", "\r\n"]
