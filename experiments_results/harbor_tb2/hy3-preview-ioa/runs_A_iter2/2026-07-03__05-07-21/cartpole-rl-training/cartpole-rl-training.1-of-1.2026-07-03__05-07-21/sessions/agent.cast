[70.605849, "i", "cat > /app/train.py << 'PYEOF'\nimport random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport gymnasium as gym\n\nfrom agent import Agent\n\nBATCH_SIZE = 128\nGAMMA = 0.99\nLR = 1e-3\nBUFFER_SIZE = 100000\nTARGET_UPDATE = 10\nEPISODES = 3000\n\n\nclass ReplayBuffer:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.buffer = []\n        self.pos = 0\n\n    def push(self, *args):\n        if len(self.buffer) < self.capacity:\n            self.buffer.append(args)\n        else:\n            self.buffer[self.pos] = args\n        self.pos = (self.pos + 1) % self.capacity\n\n    def sample(self, batch_size):\n        batch = random.sample(self.buffer, batch_size)\n        return zip(*batch)\n\n    def __len__(self):\n        return len(self.buffer)\n\n\ndef evaluate(agent, episodes=20):\n    env = gym.make(\"CartPole-v1\")\n    rewards = []\n    for _ in range(episodes):\n        obs, _ = env.reset()\n        total = 0.0\n        while "]
[70.606059, "o", "cat > /app/train.py << 'PYEOF'"]
[70.606104, "o", "\r\n"]
[70.606149, "o", "\u001b[?2004l\r"]
[70.606244, "o", "\u001b[?2004h"]
[70.606292, "i", "True:\n            action = agent.select_action(obs)\n            obs, reward, terminated, truncated, _ = env.step(action)\n            total += reward\n            if terminated or truncated:\n                rewards.append(total)\n                break\n    env.close()\n    return sum(rewards) / len(rewards)\n\n\ndef main():\n    env = gym.make(\"CartPole-v1\")\n    agent = Agent()\n    target_net = Agent().policy_net\n    target_net.load_state_dict(agent.policy_net.state_dict())\n    target_net.eval()\n\n    optimizer = optim.Adam(agent.policy_net.parameters(), lr=LR)\n    buffer = ReplayBuffer(BUFFER_SIZE)\n    criterion = nn.SmoothL1Loss()\n\n    eps_start = 1.0\n    eps_end = 0.02\n    eps_decay = 800\n\n    best_reward = -float(\"inf\")\n    steps_done = 0\n\n    state, _ = env.reset()\n    for episode in range(EPISODES):\n        eps = eps_end + (eps_start - eps_end) * np.exp(-steps_done / eps_decay)\n        while True:\n            steps_done += 1\n            if random.random() < eps:\n                action = env.action_space.sample()\n"]
[70.606313, "i", "            else:\n                action = agent.select_action(state)\n            next_state, reward, terminated, truncated, _ = env.step(action)\n            buffer.push(state, action, reward, next_state, terminated or truncated)\n            state = next_state\n\n            if len(buffer) >= BATCH_SIZE:\n                s, a, r, ns, d = buffer.sample(BATCH_SIZE)\n                s = torch.as_tensor(np.array(s), dtype=torch.float32)\n                a = torch.as_tensor(np.array(a), dtype=torch.int64).unsqueeze(1)\n                r = torch.as_tensor(np.array(r), dtype=torch.float32).unsqueeze(1)\n                ns = torch.as_tensor(np.array(ns), dtype=torch.float32)\n                d = torch.as_tensor(np.array(d), dtype=torch.float32).unsqueeze(1)\n                q_values = agent.policy_net(s).gather(1, a)\n                with torch.no_grad():\n                    next_q = target_net(ns).max(1)[0].unsqueeze(1)\n                    target = r + GAMMA * next_q * (1 - d)\n "]
[70.606358, "i", "               loss = criterion(q_values, target)\n                optimizer.zero_grad()\n                loss.backward()\n                optimizer.step()\n\n            if terminated or truncated:\n                state, _ = env.reset()\n                break\n\n        if episode % TARGET_UPDATE == 0:\n            target_net.load_state_dict(agent.policy_net.state_dict())\n\n        if episode % 20 == 0:\n            avg = evaluate(agent, episodes=20)\n            print(f\"Episode {episode}, eps={eps:.3f}, eval_avg={avg:.1f}\")\n            if avg > best_reward:\n                best_reward = avg\n                agent.save(\"/app/trained_model\")\n            if avg >= 480:\n                print(\"Solved threshold reached, saving best model.\")\n                agent.save(\"/app/trained_model\")\n                break\n\n    env.close()\n    print(f\"Best reward: {best_reward}\")\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
