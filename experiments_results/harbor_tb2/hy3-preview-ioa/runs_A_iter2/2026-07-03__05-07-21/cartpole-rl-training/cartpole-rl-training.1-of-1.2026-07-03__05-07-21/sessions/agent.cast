[70.611359, "o", "\u001b[?2004l\r"]
[70.612159, "o", "\u001b[?2004h> class ReplayBuffer:\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, capacity):\r\n\u001b[?2004l\r\u001b[?2004h>         self.capacity = capacity\r\n\u001b[?2004l\r\u001b[?2004h>         self.buffer = []\r\n\u001b[?2004l\r\u001b[?2004h>         self.pos = 0"]
[70.612292, "o", "\r\n"]
[70.612407, "o", "\u001b[?2004l\r"]
[70.612539, "o", "\u001b[?2004h"]
[70.612658, "o", "> "]
[70.612814, "o", "\r\n"]
[70.612956, "o", "\u001b[?2004l\r"]
[70.613096, "o", "\u001b[?2004h"]
[70.613204, "o", "> "]
[70.613366, "o", "    def push(self, *args):"]
[70.613467, "o", "\r\n"]
[70.61357, "o", "\u001b[?2004l\r"]
[70.613689, "o", "\u001b[?2004h"]
[70.613801, "o", "> "]
[70.614045, "o", "        if len(self.buffer) < self.capacity:"]
[70.614149, "o", "\r\n"]
[70.614249, "o", "\u001b[?2004l\r"]
[70.614366, "o", "\u001b[?2004h"]
[70.614473, "o", "> "]
[70.614653, "o", "            self.buffer.append(args)"]
[70.614753, "o", "\r\n"]
[70.614853, "o", "\u001b[?2004l\r"]
[70.614994, "o", "\u001b[?2004h"]
[70.615124, "o", "> "]
[70.615256, "o", "        else:"]
[70.615355, "o", "\r\n"]
[70.615454, "o", "\u001b[?2004l\r"]
[70.615577, "o", "\u001b[?2004h"]
[70.615682, "o", "> "]
[70.615869, "o", "            self.buffer[self.pos] = args"]
[70.61631, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.61633, "o", "        self.pos = (self.pos + 1) % self.capacity\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.616451, "o", "> "]
[70.61657, "o", "\r\n"]
[70.616686, "o", "\u001b[?2004l\r"]
[70.616817, "o", "\u001b[?2004h"]
[70.616951, "o", "> "]
[70.617417, "o", "    def sample(self, batch_size):"]
[70.617449, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.617568, "o", "> "]
[70.617828, "o", "        batch = random.sample(self.buffer, batch_size)"]
[70.61796, "o", "\r\n"]
[70.618093, "o", "\u001b[?2004l\r"]
[70.618222, "o", "\u001b[?2004h"]
[70.618392, "o", "> "]
[70.618749, "o", "        return zip(*batch)"]
[70.618777, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.618971, "o", "    def __len__(self):"]
[70.619102, "o", "\r\n"]
[70.619218, "o", "\u001b[?2004l\r"]
[70.619354, "o", "\u001b[?2004h"]
[70.619472, "o", "> "]
[70.619665, "o", "        return len(self.buffer)"]
[70.619778, "o", "\r\n"]
[70.620104, "o", "\u001b[?2004l\r"]
[70.620738, "o", "\u001b[?2004h"]
[70.620854, "o", "> "]
[70.620975, "o", "\r\n"]
[70.621095, "o", "\u001b[?2004l\r"]
[70.621209, "o", "\u001b[?2004h"]
[70.621314, "o", "> "]
[70.621415, "o", "\r\n"]
[70.621524, "o", "\u001b[?2004l\r"]
[70.621639, "o", "\u001b[?2004h"]
[70.621744, "o", "> "]
[70.621936, "o", "def evaluate(agent, episodes=20):"]
[70.622056, "o", "\r\n"]
[70.622154, "o", "\u001b[?2004l\r"]
[70.622268, "o", "\u001b[?2004h"]
[70.622371, "o", "> "]
[70.622545, "o", "    env = gym.make(\"CartPole-v1\")"]
[70.622641, "o", "\r\n"]
[70.622741, "o", "\u001b[?2004l\r"]
[70.622865, "o", "\u001b[?2004h"]
[70.622992, "o", "> "]
[70.623149, "o", "    rewards = []"]
[70.623247, "o", "\r\n"]
[70.623345, "o", "\u001b[?2004l\r"]
[70.623466, "o", "\u001b[?2004h"]
[70.623571, "o", "> "]
[70.623841, "o", "    for _ in range(episodes):"]
[70.624039, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.62432, "o", "        obs, _ = env.reset()\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.624445, "o", "> "]
[70.624619, "o", "        total = 0.0"]
[70.624798, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.624939, "o", "> "]
[70.625244, "o", "        while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.625486, "o", "            action = agent.select_action(obs)"]
[70.625951, "o", "\r\n"]
[70.62608, "o", "\u001b[?2004l\r"]
[70.626197, "o", "\u001b[?2004h"]
[70.626344, "o", "> "]
[70.626585, "o", "            obs, reward, terminated, truncated, _ = env.step(action)"]
[70.626684, "o", "\r\n"]
[70.626781, "o", "\u001b[?2004l\r"]
[70.626915, "o", "\u001b[?2004h"]
[70.627048, "o", "> "]
[70.627251, "o", "            total += reward\r\n"]
[70.627418, "o", "\u001b[?2004l\r"]
[70.627537, "o", "\u001b[?2004h"]
[70.62777, "o", ">             if terminated or truncated:"]
[70.627885, "o", "\r\n"]
[70.628029, "o", "\u001b[?2004l\r"]
[70.628158, "o", "\u001b[?2004h"]
[70.62847, "o", "> "]
[70.628503, "o", "                rewards.append(total)"]
[70.628598, "o", "\r\n"]
[70.628695, "o", "\u001b[?2004l\r"]
[70.628811, "o", "\u001b[?2004h"]
[70.628928, "o", "> "]
[70.629095, "o", "                break"]
[70.62919, "o", "\r\n"]
[70.629286, "o", "\u001b[?2004l\r"]
[70.629398, "o", "\u001b[?2004h"]
[70.6295, "o", "> "]
[70.629633, "o", "    env.close()"]
[70.630396, "o", "\r\n"]
[70.630483, "o", "\u001b[?2004l\r"]
[70.630541, "o", "\u001b[?2004h"]
[70.630632, "o", "> "]
[70.630805, "o", "    return sum(rewards) / len(rewards)"]
[70.6309, "o", "\r\n"]
[70.631039, "o", "\u001b[?2004l\r"]
[70.631139, "o", "\u001b[?2004h"]
[70.631228, "o", "> "]
[70.631314, "o", "\r\n"]
[70.631356, "o", "\u001b[?2004l\r"]
[70.631455, "o", "\u001b[?2004h"]
[70.631543, "o", "> "]
[70.631588, "o", "\r\n"]
[70.631672, "o", "\u001b[?2004l\r"]
[70.631732, "o", "\u001b[?2004h"]
[70.631823, "o", "> "]
[70.631894, "o", "def main():"]
[70.63237, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     env = gym.make(\"CartPole-v1\")"]
[70.632793, "o", "\r\n"]
[70.633001, "o", "\u001b[?2004l\r"]
[70.633233, "o", "\u001b[?2004h"]
[70.633478, "o", "> "]
[70.633635, "o", "    agent = Agent()"]
[70.633763, "o", "\r\n"]
[70.63387, "o", "\u001b[?2004l\r"]
[70.633964, "o", "\u001b[?2004h"]
[70.634125, "o", "> "]
[70.634944, "o", "    target_net = Agent().policy_net\r\n\u001b[?2004l\r"]
[70.635176, "o", "\u001b[?2004h> "]
[70.635619, "o", "    target_net.load_state_dict(agent.policy_net.state_dict())"]
[70.635811, "o", "\r\n"]
[70.636141, "o", "\u001b[?2004l\r\u001b[?2004h>     target_net.eval()\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.636258, "o", "> \r\n\u001b[?2004l\r"]
[70.636466, "o", "\u001b[?2004h"]
[70.636571, "o", "> "]
[70.636723, "o", "    optimizer = optim.Adam(agent.policy_net.parameters(), lr=LR)\r\n\u001b[?2004l\r"]
[70.636813, "o", "\u001b[?2004h> "]
[70.636998, "o", "    buffer = ReplayBuffer(BUFFER_SIZE)"]
[70.637112, "o", "\r\n"]
[70.637164, "o", "\u001b[?2004l\r"]
[70.638231, "o", "\u001b[?2004h>     criterion = nn.SmoothL1Loss()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     eps_start = 1.0\r\n\u001b[?2004l\r\u001b[?2004h>     eps_end = 0.02\r\n\u001b[?2004l\r\u001b[?2004h>     eps_decay = 800\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.638313, "o", "> "]
[70.638363, "o", "\r\n"]
[70.638408, "o", "\u001b[?2004l\r"]
[70.63847, "o", "\u001b[?2004h"]
[70.638525, "o", "> "]
[70.638646, "o", "    best_reward = -float(\"inf\")"]
[70.63869, "o", "\r\n"]
[70.638734, "o", "\u001b[?2004l\r"]
[70.638802, "o", "\u001b[?2004h"]
[70.638853, "o", "> "]
[70.638962, "o", "    steps_done = 0"]
[70.639028, "o", "\r\n"]
[70.639075, "o", "\u001b[?2004l\r"]
[70.639137, "o", "\u001b[?2004h"]
[70.639188, "o", "> "]
[70.639234, "o", "\r\n"]
[70.639279, "o", "\u001b[?2004l\r"]
[70.639342, "o", "\u001b[?2004h"]
[70.639394, "o", "> "]
[70.639503, "o", "    state, _ = env.reset()"]
[70.639546, "o", "\r\n"]
[70.639593, "o", "\u001b[?2004l\r"]
[70.639657, "o", "\u001b[?2004h"]
[70.639706, "o", "> "]
[70.639838, "o", "    for episode in range(EPISODES):"]
[70.639883, "o", "\r\n"]
[70.63995, "o", "\u001b[?2004l\r"]
[70.640031, "o", "\u001b[?2004h"]
[70.640084, "o", "> "]
[70.640312, "o", "        eps = eps_end + (eps_start - eps_end) * np.exp(-steps_done / eps_decay)"]
[70.640358, "o", "\r\n"]
[70.640403, "o", "\u001b[?2004l\r"]
[70.640466, "o", "\u001b[?2004h"]
[70.64052, "o", "> "]
[70.640615, "o", "        while True:"]
[70.640661, "o", "\r\n"]
[70.64071, "o", "\u001b[?2004l\r"]
[70.640777, "o", "\u001b[?2004h"]
[70.64083, "o", "> "]
[70.642649, "o", "            steps_done += 1\r\n\u001b[?2004l\r\u001b[?2004h>             if random.random() < eps:\r\n\u001b[?2004l\r\u001b[?2004h>                 action = env.action_space.sample()\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 action = agent.select_action(state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.64563, "o", "            next_state, reward, terminated, truncated, _ = env.step(action)"]
[70.645765, "o", "\r\n\u001b[?2004l\r"]
[70.645885, "o", "\u001b[?2004h"]
[70.645934, "o", "> "]
[70.646235, "o", "            buffer.push(state, action, reward, next_state, terminated or truncated)\r\n\u001b[?2004l\r"]
[70.646349, "o", "\u001b[?2004h> "]
[70.646502, "o", "            state = next_state\r\n\u001b[?2004l\r"]
[70.646589, "o", "\u001b[?2004h> "]
[70.646701, "o", "\r\n\u001b[?2004l\r"]
[70.646812, "o", "\u001b[?2004h> "]
[70.646992, "o", "            if len(buffer) >= BATCH_SIZE:"]
[70.64706, "o", "\r\n"]
[70.647106, "o", "\u001b[?2004l\r"]
[70.647171, "o", "\u001b[?2004h"]
[70.647223, "o", "> "]
[70.647408, "o", "                s, a, r, ns, d = buffer.sample(BATCH_SIZE)"]
[70.647456, "o", "\r\n"]
[70.647503, "o", "\u001b[?2004l\r"]
[70.647569, "o", "\u001b[?2004h"]
[70.647623, "o", "> "]
[70.647878, "o", "                s = torch.as_tensor(np.array(s), dtype=torch.float32)"]
[70.647942, "o", "\r\n"]
[70.647986, "o", "\u001b[?2004l\r"]
[70.648072, "o", "\u001b[?2004h"]
[70.648125, "o", "> "]
[70.648367, "o", "                a = torch.as_tensor(np.array(a), dtype=torch.int64).unsqueeze(1)"]
[70.648414, "o", "\r\n"]
[70.648461, "o", "\u001b[?2004l\r"]
[70.648527, "o", "\u001b[?2004h"]
[70.64858, "o", "> "]
[70.648975, "o", "                r = torch.as_tensor(np.array(r), dtype=torch.float32).unsqueeze(1)"]
[70.649045, "o", "\r\n"]
[70.649127, "o", "\u001b[?2004l\r"]
[70.649198, "o", "\u001b[?2004h"]
[70.649251, "o", "> "]
[70.649471, "o", "                ns = torch.as_tensor(np.array(ns), dtype=torch.float32)"]
[70.649517, "o", "\r\n"]
[70.649565, "o", "\u001b[?2004l\r"]
[70.649631, "o", "\u001b[?2004h"]
[70.649684, "o", "> "]
[70.649946, "o", "                d = torch.as_tensor(np.array(d), dtype=torch.float32).unsqueeze(1)"]
[70.650206, "o", "\r\n"]
[70.650249, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[70.650503, "o", "                q_values = agent.policy_net(s).gather(1, a)\r\n"]
[70.650608, "o", "\u001b[?2004l\r"]
[70.650685, "o", "\u001b[?2004h"]
[70.650724, "o", "> "]
[70.650861, "o", "                with torch.no_grad():"]
[70.651128, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.651318, "o", "                    next_q = target_net(ns).max(1)[0].unsqueeze(1)"]
[70.651589, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.651675, "o", "                    target = r + GAMMA * next_q * (1 - d)"]
[70.651771, "o", "\r\n\u001b[?2004l\r"]
[70.651852, "o", "\u001b[?2004h"]
[70.651978, "o", "> "]
[70.657276, "o", "                loss = criterion(q_values, target)\r\n\u001b[?2004l\r"]
[70.657406, "o", "\u001b[?2004h> "]
[70.657644, "o", "                optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.65787, "o", "                loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.657988, "o", "                optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.658196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.658272, "o", "            if terminated or truncated:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.65851, "o", "                state, _ = env.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.659018, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         if episode % TARGET_UPDATE == 0:\r\n\u001b[?2004l\r\u001b[?2004h>             target_net.load_state_dict(agent.policy_net.state_dict())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.659369, "o", "\u001b[?2004h> "]
[70.659401, "o", "        if episode % 20 == 0:\r\n\u001b[?2004l\r\u001b[?2004h>             avg = evaluate(agent, episodes=20)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.659575, "o", "            print(f\"Episode {episode}, eps={eps:.3f}, eval_avg={avg:.1f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.659666, "o", "            if avg > best_reward:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.65979, "o", "                best_reward = avg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.660046, "o", "                agent.save(\"/app/trained_model\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.660075, "o", "            if avg >= 480:\r\n\u001b[?2004l\r"]
[70.660087, "o", "\u001b[?2004h> "]
[70.660525, "o", "                print(\"Solved threshold reached, saving best model.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.660654, "o", "                agent.save(\"/app/trained_model\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.660731, "o", "                break\r\n\u001b[?2004l\r"]
[70.660776, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.661046, "o", "\u001b[?2004h> "]
[70.661072, "o", "    env.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.661557, "o", "    print(f\"Best reward: {best_reward}\")\r\n\u001b[?2004l\r"]
[70.661597, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.661611, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.661629, "o", "\u001b[?2004h> "]
[70.661732, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[70.661761, "o", "\u001b[?2004h> "]
[70.661841, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
