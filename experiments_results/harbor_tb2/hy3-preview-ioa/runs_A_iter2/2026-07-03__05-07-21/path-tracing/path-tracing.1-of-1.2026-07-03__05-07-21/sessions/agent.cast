[351.83248, "i", "cat > /tmp/extract.py << 'EOF'\nimport numpy as np, re\na=np.fromfile('image.ppm',dtype=np.uint8)\nm=re.match(rb'P6\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)', a[:30])\nW,H=int(m.group(1)),int(m.group(2)); off=len(m.group(0))\npx=a[off:].reshape(H,W,3).astype(float)\nR,G,B=px[:,:,0],px[:,:,1],px[:,:,2]\nis_sky=(B>R+10)&(B>G+10)\nfrac=np.array([is_sky[y,5:60].mean() for y in range(H)])\nhorizon=int(np.where(frac>0.5)[0].max())\nprint('horizon_y',horizon)\n# sky table from pure-sky strip\nsky=np.zeros((horizon+1,3))\nfor y in range(horizon+1):\n    sky[y]=np.median(px[y,5:60],axis=0)\nnp.save('/tmp/sky.npy',sky)\nprint('sky top',sky[0].astype(int),'sky@horizon',sky[horizon].astype(int))\n# sphere mask\nsm=(R>G+12)&(R>B+12)&(R>40)\nys,xs=np.where(sm)\nprint('sphere px count',len(xs))\ncx=xs.mean(); cy=ys.mean()\nd=np.sqrt((xs-cx)**2+(ys-cy)**2)\nprint('sphere center x,y=%.1f,%.1f'%(cx,cy),'mean_r=%.1f'%d.mean(),'max_r=%.1f'%d.max(),'min_r=%.1f'%d.min())\nprint('sphere bbox x[%.0f,%.0f] y[%.0f,%.0f]'%(xs.min(),xs.max(),ys.min(),ys.max()))\n# floor base colors in far-right region\nsl=px[horizon+5:H, 640:790].reshape(-1,3)\ndark=np.percentile(sl,15,axis=0); lite=np.percentile(sl,85,axis=0)\nprint('floor dark%%',dark.astype(int),'floor lite%%',lite.astype(int))\n# horizontal checker period at two depths: luminance along a row\nfor y in (400,480,540):\n    L=0.299*px[y,:,0]+0.587*px[y,:,1]+0.114*px[y,:,2]\n    L=pd=L-np.roll(L,1); L[:1]=0\n    # zero crossings of (L - median)\n    med=np.median(L)\n    sgn=np.sign(L-med)\n    cross=np.where((sgn[:-1]<0)&(sgn[1:]>0))[0]\n    cross=cross[cross>50]\n    if len(cross)>6:\n        sp=np.diff(cross[:8])\n        print('y=%d first boundaries x=%s spacing~%.0f'%(y,cross[:8],sp.mean()))\n    else:\n        print('y=%d few crossings'%y)\nEOF\n.venv/bin/python /tmp/extract.py\n"]
