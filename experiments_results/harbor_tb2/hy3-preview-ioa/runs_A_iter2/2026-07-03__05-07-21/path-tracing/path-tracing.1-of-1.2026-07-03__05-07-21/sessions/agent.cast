[678.016286, "i", "cat > /tmp/proto.py << 'EOF'\nimport numpy as np, re, math, random\nGT=np.fromfile('/app/image.ppm',dtype=np.uint8)\nm=re.match(rb'P6\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+',GT[:30]); W=int(m.group(1));H=int(m.group(2)); off=m.end()\nGT=GT[off:].reshape(H,W,3).astype(np.float64)/255.0\nsky=np.load('/tmp/sky.npy')/255.0\n\nR=GT[:,:,0];G=GT[:,:,1];B=GT[:,:,2]\nmask=(R>G+0.05)&(R>B+0.05)&(R>0.15)\nys,xs=np.where(mask)\nxc=xs.mean();yc=ys.mean()\nrr=np.sqrt((xs-xc)**2+(ys-yc)**2);r_app=np.percentile(rr,95)\narg=int(np.argmax(np.where(mask,R,-1)))\nsy,sx=np.unravel_index(arg,(H,W))\nC=np.array([0.0,-1.645,15.915]);r=3.181\nf=300.0\nu=sx+0.5-W/2;v=H/2-(sy+0.5)\nd=np.array([u,v,-f]);d/=np.linalg.norm(d)\noc=-C\nb=np.dot(d,oc);cc=np.dot(oc,oc)-r*r;disc=b*b-cc;t=-b-math.sqrt(disc)\nP=d*t;N=(P-C)/r;N/=np.linalg.norm(N)\nalbedo=GT[sy,sx].copy()\nprint('xc,yc,r_app=%.1f,%.1f,%.1f'%(xc,yc,r_app))\nprint('brightest px=(%d,%d) albedo=%.3f,%.3f,%.3f'%(sx,sy,albedo[0],albedo[1],albedo[2]))\nprint('L=%.3f,%.3f,%.3f"]
