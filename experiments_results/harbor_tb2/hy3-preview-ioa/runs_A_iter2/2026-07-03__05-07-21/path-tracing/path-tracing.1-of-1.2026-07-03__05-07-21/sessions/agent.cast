[89.353662, "i", "cat > /tmp/an2.py << 'EOF'\nimport numpy as np\nimport re\na=np.fromfile('image.ppm',dtype=np.uint8)\nm=re.match(rb'P6\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\s', a[:30])\nw,h=int(m.group(1)),int(m.group(2))\noff=len(m.group(0))\npx=a[off:].reshape(h,w,3).astype(np.float64)\nprint('w,h',w,h)\n# sky gradient: sample a column near the left where likely sky. Find column with mostly sky (top rows).\n# Examine vertical profile at x=400 (center)\nfor x in [400]:\n    col=px[:,x,:]\n    print('col',x,'top px',col[0].astype(int),'mid',col[h//2].astype(int),'bot',col[-1].astype(int))\n# Look at top row gradient across x (should be sky)\ntop=px[0]\nprint('top row min/max per channel')\nprint(top.min(0).astype(int), top.max(0).astype(int))\n# Find sphere: scan for large smooth colored region distinct from sky. \n# Compute per-row mean across x for a middle region to detect sphere/plane transitions.\nrowmean=px.mean(1)\n# print a coarse vertical profile every 50 rows\nfor y in range(0,h,40):\n    print('y',y,'me"]
