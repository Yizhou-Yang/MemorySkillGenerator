[678.027208, "o", "\r\n"]
[678.02757, "o", "\u001b[?2004l\r\u001b[?2004h> oc=-C"]
[678.027883, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[678.028015, "o", "b=np.dot(d,oc);cc=np.dot(oc,oc)-r*r;disc=b*b-cc;t=-b-math.sqrt(disc)"]
[678.028183, "o", "\r\n"]
[678.028362, "o", "\u001b[?2004l\r"]
[678.028595, "o", "\u001b[?2004h"]
[678.028742, "o", "> P=d*t;N=(P-C)/r;N/=np.linalg.norm(N)"]
[678.028937, "o", "\r\n\u001b[?2004l\r"]
[678.02915, "o", "\u001b[?2004h> "]
[678.029296, "o", "albedo=GT[sy,sx].copy()"]
[678.029468, "o", "\r\n"]
[678.029743, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[678.029874, "o", "print('xc,yc,r_app=%.1f,%.1f,%.1f'%(xc,yc,r_app))"]
[678.030022, "o", "\r\n"]
[678.030216, "o", "\u001b[?2004l\r"]
[678.030573, "o", "\u001b[?2004h"]
[678.03072, "o", "> print('brightest px=(%d,%d) albedo=%.3f,%.3f,%.3f'%(sx,sy,albedo[0],albedo[1],albedo[2]))"]
[678.030867, "o", "\r\n"]
[678.03101, "o", "\u001b[?2004l\r"]
[678.031188, "o", "\u001b[?2004h"]
[678.031347, "o", "> "]
[678.031546, "o", "print('L=%.3f,%.3f,%.3f"]
[678.031786, "i", "'%(N[0],N[1],N[2]))\n\n# floor lighting probe: row-median luminance of floor region\nlum=0.299*R+0.587*G+0.114*B\nprint('floor row medians (y=320,400,480,560):',\n      [round(float(np.median(lum[y,5:795])),3) for y in (320,400,480,560)])\n\n# proxy target\ntW,tH=200,150\ntarget=GT.reshape(tH,4,tW,4,3).mean((1,3))\n\ndef make_dirs(W,H,ss):\n    U=np.arange(W)+0.5-W/2.0\n    V=(np.arange(H)+0.5-H/2.0)[::-1]  # row0 top\n    offs=(np.arange(ss)-(ss-1)/2.0)/ss\n    dirs=[]\n    for oi in offs:\n        for oj in offs:\n            UU=U[None,:]+oi; VV=V[:,None]+oj\n            dd=np.stack([UU,VV,-np.full_like(UU,H/2.0)],-1)\n            dd/=np.sqrt((dd**2).sum(-1,keepdims=True))\n            dirs.append(dd.astype(np.float64))\n    return dirs\n\ndirs=make_dirs(tW,tH,3)\nskyJ=np.clip(np.round(299.5-dirs[0][:,:,1]),0,299).astype(int)\nskycol=sky[skyJ]  # (tH,tW,3)\n\ndef render(params):\n    fy,s,ox,oz,A=params\n    Cx,Cy,Cz,r=0.0,-1.645,15.915,3.181\n    L=N\n    acc=np.zeros((tH,tW,3))\n    for d in dirs:\n        dx,dy,dz=d[:,:,0],d[:,:,1],d[:,:,2]\n        ocx=-Cx;ocy=-Cy;ocz=-Cz\n        b=dx*ocx+dy*ocy+dz*ocz\n        oc2=Cx*Cx+Cy*Cy+Cz*Cz\n        cc=oc2-r*r\n        disc=b*b-cc\n        t_s=np.where(disc>0,-b-np.sqrt(np.maximum(disc,0)),np.inf)\n        t_s=np.where(t_s>0,t_s,np.inf)\n        t_f=np.where(dy<0,fy/dy,np.inf)\n        is_s=t_s<t_f\n        # sphere\n        Px,Py,Pz=dx*t_s,dy*t_s,dz*t_s\n        Nx,Ny,Nz=(Px-Cx)/r,(Py-Cy)/r,(Pz-Cz)/r\n        ndl=Nx*L[0]+Ny*L[1]+Nz*L[2]\n        diff=np.maximum(0,ndl)\n        sph=albedo*(A+diff*(1-A))\n        # floor\n        hx,hy=dx*t_f,dz*t_f\n        ch=((np.floor(hx*s+ox).astype(np.int64)+np.floor(hy*s+oz).astype(np.int64))&1)\n        base=np.where(ch==0,np.array([0.6,0.6,0.6]),np.array([0.26,0.26,0.26]))\n        col=skycol.copy()\n        floor=~is_s&(t_f<np.inf)\n        col=np.where(is_s[:,:,None],sph,col)\n        col=np.where(floor[:,:,None],base,col)\n        acc+=col\n    return acc/(len(dirs))\n\ndef sim(img):\n    a=target.reshape(-1);b=img.reshape(-1)\n    re"]
