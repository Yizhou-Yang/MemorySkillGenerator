[126.550035, "i", "python3 << 'EOF'\nimport nbformat as nbf\nnb = nbf.v4.new_notebook()\nmd = nbf.v4.new_markdown_cell('''# What is Jupyter Notebook?\\n\\nJupyter Notebook is an open-source web application that allows you to create and share documents containing live code, equations, visualizations, and narrative text. It supports many programming languages and is widely used for data cleaning and transformation, numerical simulation, statistical modeling, data visualization, and machine learning.''',)\ncode = nbf.v4.new_code_cell('''import numpy as np\\nimport matplotlib.pyplot as plt\\n\\nx = np.linspace(0, 2*np.pi, 100)\\ny = np.sin(x)\\n\\nplt.figure(figsize=(8, 4))\\nplt.plot(x, y)\\nplt.title('Sine Wave')\\nplt.xlabel('x')\\nplt.ylabel('sin(x)')\\nplt.grid(True)\\nplt.show()''')\nnb.cells = [md, code]\nwith open('/app/test_notebook.ipynb', 'w') as f:\n    nbf.write(nb, f)\nprint('notebook written')\nEOF\n"]
[126.550218, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
[126.550277, "o", "\u001b[?2004h> "]
[126.550302, "o", "import nbformat as nbf\r\n\u001b[?2004l\r"]
[126.550374, "o", "\u001b[?2004h"]
[126.550483, "o", "> nb = nbf.v4.new_notebook()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.551564, "o", "md = nbf.v4.new_markdown_cell('''# What is Jupyter Notebook?\\n\\nJupyter Notebook is an open-source web application that allows you to create and share documents containing live code, equations, visualizations, and narrative text. It supports many programming languages and is widely used for data cleaning and transformation, numerical simulation, statistical modeling, data visualization, and machine learning.''',)\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.551762, "o", "> "]
[126.55225, "o", "code = nbf.v4.new_code_cell('''import numpy as np\\nimport matplotlib.pyplot as plt\\n\\nx = np.linspace(0, 2*np.pi, 100)\\ny = np.sin(x)\\n\\nplt.figure(figsize=(8, 4))\\nplt.plot(x, y)\\nplt.title('Sine Wave')\\nplt.xlabel('x')\\nplt.ylabel('sin(x)')\\nplt.grid(True)\\nplt.show()''')\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.552328, "o", "> "]
[126.552345, "o", "nb.cells = [md, code]\r\n\u001b[?2004l\r\u001b[?2004h> "]
