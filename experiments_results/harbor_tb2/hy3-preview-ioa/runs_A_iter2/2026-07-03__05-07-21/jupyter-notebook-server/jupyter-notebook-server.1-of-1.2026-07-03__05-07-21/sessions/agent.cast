[117.712031, "i", "python3 << 'EOF'\nhash_ = 'argon2:$argon2id$v=19$m=10240,t=10,p=8$V3aqs2VA5qcYAlfHlebQjw$T9o3vAh9fp57lDa/hBmoM6bH7msHVzCG7IKanf4HsYE'\ncfg = '''c.ServerApp.certfile = '/app/mycert.pem'\nc.ServerApp.keyfile = '/app/mykey.key'\nc.ServerApp.ip = '0.0.0.0'\nc.ServerApp.port = 8888\nc.ServerApp.open_browser = False\nc.ServerApp.password = '%s'\nc.ServerApp.allow_root = True\nc.ServerApp.allow_origin = '*'\nc.NotebookApp.certfile = '/app/mycert.pem'\nc.NotebookApp.keyfile = '/app/mykey.key'\nc.NotebookApp.ip = '0.0.0.0'\nc.NotebookApp.port = 8888\nc.NotebookApp.open_browser = False\nc.NotebookApp.password = '%s'\nc.NotebookApp.allow_root = True\n''' % (hash_, hash_)\nwith open('/app/jupyter_server_config.py','w') as f:\n    f.write(cfg)\nprint('written')\nEOF\n"]
