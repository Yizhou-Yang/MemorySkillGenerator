[62.136357, "i", "cat > /app/build.py << 'EOF'\nimport csv, json\nfrom datetime import datetime, timezone\nfrom collections import defaultdict\n\nDATA = '/app/data'\n\ndef read_csv(p):\n    with open(p, newline='', encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\ndepartments = read_csv(f'{DATA}/departments.csv')\nemployees = read_csv(f'{DATA}/employees.csv')\nprojects = read_csv(f'{DATA}/projects.csv')\n\n# index employees by department\nemp_by_dept = defaultdict(list)\nfor e in employees:\n    e['years_of_service'] = int(e['years_of_service'])\n    e['skills'] = [s.strip() for s in e['skills'].split(';') if s.strip()]\n    emp_by_dept[e['department_id']].append(e)\n\nproj_by_dept = defaultdict(list)\nfor p in projects:\n    p['members'] = [m.strip() for m in p['member_ids'].split(';') if m.strip()]\n    proj_by_dept[p['department_id']].append(p)\n\ndept_list = []\nfor d in departments:\n    d['budget'] = float(d['budget'])\n    emps = []\n    for e in emp_by_dept.get(d['id'], []):\n        emps.append({\n            'id': e['id'],\n         "]
[62.136543, "o", "cat > /app/build.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.136715, "i", "   'name': e['name'],\n            'position': e['position'],\n            'skills': e['skills'],\n            'years_of_service': e['years_of_service'],\n        })\n    projs = []\n    for p in proj_by_dept.get(d['id'], []):\n        projs.append({\n            'name': p['name'],\n            'status': p['status'],\n            'members': p['members'],\n            'deadline': p['deadline'],\n        })\n    dept_list.append({\n        'id': d['id'],\n        'name': d['name'],\n        'budget': d['budget'],\n        'employees': emps,\n        'projects': projs,\n    })\n\n# statistics\ntotal_budget = sum(d['budget'] for d in dept_list)\naverage_budget = round(total_budget / len(dept_list), 2) if dept_list else 0\nall_employees = [e for d in dept_list for e in d['employees']]\ntotal_employees = len(all_employees)\n\nskill_dist = defaultdict(int)\nfor e in all_employees:\n    for s in set(e['skills']):\n        skill_dist[s] += 1\n\ndept_sizes = {d['name']: len(d['employees']) for d in dept_list}\n\nstatus_dist = defaultdict(int)\nfor d in "]
[62.136878, "o", "> import csv, json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import datetime, timezone\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.137015, "i", "dept_list:\n    for p in d['projects']:\n        status_dist[p['status']] += 1\n\navg_years = round(sum(e['years_of_service'] for e in all_employees) / total_employees, 2) if total_employees else 0\n\nout = {\n    'metadata': {\n        'version': '1.0.0',\n        'timestamp': datetime.now(timezone.utc).astimezone().isoformat(),\n        'generator': 'CSV-to-JSON Processor',\n    },\n    'organization': {\n        'name': 'Global Organization',\n        'founded': '2000-01-01',\n        'departments': dept_list,\n    },\n    'statistics': {\n        'averageDepartmentBudget': average_budget,\n        'totalEmployees': total_employees,\n        'skillDistribution': dict(skill_dist),\n        'departmentSizes': dept_sizes,\n        'projectStatusDistribution': dict(status_dist),\n        'averageYearsOfService': avg_years,\n    },\n}\n\nwith open('/app/organization.json', 'w', encoding='utf-8') as f:\n    json.dump(out, f, indent=2, ensure_ascii=False)\n\nprint('Wrote /app/organization.json')\nprint('Departments:', len(dept_list), 'Employee"]
