[1698.690491, "i", "cd /app && python3 - <<'EOF'\nimport urllib.request\nhost='https://cdn.kernel.org'\nfor path in ['/pub/linux/kernel/v6.x/linux-6.9.tar.xz','/pub/linux/kernel/v6.x/linux-6.9.tar.sign','/pub/linux/README','/']:\n    u=host+path\n    req=urllib.request.Request(u, headers={'User-Agent':'Mozilla/5.0'})\n    try:\n        r=urllib.request.urlopen(req, timeout=12)\n        body=r.read(200)\n        print('OK', r.status, repr(body[:120]), path)\n    except urllib.error.HTTPError as e:\n        body=e.read(200)\n        print('HTTP', e.code, repr(body[:120]), path)\n    except Exception as e:\n        print('ERR', type(e).__name__, str(e)[:50], path)\nEOF\n"]
