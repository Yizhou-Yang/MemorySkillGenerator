[1767.048167, "i", "cd /app && python3 - <<'EOF'\nimport urllib.request\n# codeload retry-after\nreq=urllib.request.Request('https://codeload.github.com/torvalds/linux/tar.gz/refs/tags/v6.9', headers={'User-Agent':'Mozilla/5.0'})\ntry:\n    urllib.request.urlopen(req, timeout=12)\nexcept urllib.error.HTTPError as e:\n    print('codeload', e.code, 'Retry-After=', e.headers.get('Retry-After'), 'X-RateLimit-Reset=', e.headers.get('X-RateLimit-Reset'))\nexcept Exception as e:\n    print('codeload err', e)\n# debian archive\nfor u in ['http://deb.debian.org/debian/pool/main/l/linux/','https://deb.debian.org/debian/pool/main/l/linux/']:\n    req=urllib.request.Request(u, headers={'User-Agent':'Mozilla/5.0'})\n    try:\n        r=urllib.request.urlopen(req, timeout=12)\n        print('debian OK', r.status, u)\n    except urllib.error.HTTPError as e:\n        print('debian HTTP', e.code, u)\n    except Exception as e:\n        print('debian ERR', type(e).__name__, str(e)[:50], u)\nEOF\n"]
