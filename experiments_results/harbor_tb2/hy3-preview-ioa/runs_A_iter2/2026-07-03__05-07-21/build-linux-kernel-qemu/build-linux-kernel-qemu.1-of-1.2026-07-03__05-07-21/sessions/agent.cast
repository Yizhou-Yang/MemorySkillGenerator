[1919.679413, "i", "mkdir -p /app/git_debs && cd /app/git_debs && python3 - <<'EOF'\nimport urllib.request\nok=fail=0\nfor line in open('/app/git_urls.txt'):\n    url=line.strip()\n    if not url: continue\n    fn=url.rsplit('/',1)[-1]\n    req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64)'})\n    try:\n        open(fn,'wb').write(urllib.request.urlopen(req, timeout=60).read())\n        ok+=1\n    except Exception as e:\n        print('FAIL', fn, e); fail+=1\nprint('OK',ok,'FAIL',fail)\nEOF\n"]
[1919.680221, "o", "mkdir -p /app/git_debs && cd /app/git_debs && python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
