[515.952204, "o", "\u001b[?2004h> req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64)'})\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     d=urllib.request.urlopen(req, timeout=30).read()\r\n\u001b[?2004l\r\u001b[?2004h>     open('test.deb','wb').write(d)\r\n\u001b[?2004l\r\u001b[?2004h>     print('OK', len(d))\r\n\u001b[?2004l\r\u001b[?2004h> except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>     print('FAIL', e)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
