[517.177169, "o", "root@afeeb31381b7:/app/debs# "]
[556.072128, "i", "cd /app/debs && rm -f test.deb && python3 - <<'EOF'\nimport urllib.request\nok=fail=0\nfor line in open('/app/uris.txt'):\n    url=line.strip()\n    if not url: continue\n    fn=url.rsplit('/',1)[-1]\n    req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64)'})\n    try:\n        d=urllib.request.urlopen(req, timeout=60).read()\n        open(fn,'wb').write(d)\n        ok+=1\n    except Exception as e:\n        print('FAIL', fn, e); fail+=1\nprint('OK',ok,'FAIL',fail)\nEOF\n"]
[556.077487, "o", "cd /app/debs && rm -f test.deb && python3 - <<'EOF'"]
