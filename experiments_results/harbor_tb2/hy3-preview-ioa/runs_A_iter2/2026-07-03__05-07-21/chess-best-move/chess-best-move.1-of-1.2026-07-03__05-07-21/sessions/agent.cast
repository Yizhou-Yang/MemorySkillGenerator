[98.393211, "i", "cat > /tmp/analyze.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\n\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.asarray(im).astype(int)\nS = 80\nprint('shape', a.shape)\n# Background colors: sample center of each square type\n# Determine light/dark by sampling corner squares\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        sq = a[r*S:(r+1)*S, c*S:(c+1)*S]\n        # how many pixels differ strongly from the corner pixel (background)\n        corner = sq[2,2]\n        diff = np.abs(sq-corner).sum(axis=2)\n        ink = (diff>60).sum()\n        row.append(ink)\n    print(' '.join('%4d'%v for v in row))\nEOF\npython3 /tmp/analyze.py\n"]
