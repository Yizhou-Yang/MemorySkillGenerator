[489.242487, "i", "cat > /tmp/board.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nS=80\nim=Image.open('/app/chess_puzzle.png').convert('RGB')\narr=np.asarray(im).astype(int)\nN=14\ndef cell(r,c):\n    sq=arr[r*S:(r+1)*S, c*S:(c+1)*S]\n    bg=np.median(sq.reshape(-1,3),axis=0)\n    d=np.abs(sq-bg).sum(axis=2)\n    m=d>55\n    small=np.array(Image.fromarray(m).resize((N,N)))\n    return [''.join('#' if v>0 else ' ' for v in row) for row in small]\nfor r in range(8):\n    rows=[cell(r,c) for c in range(8)]\n    print('--- rank %d (files a-h) ---'%(8-r))\n    for i in range(N):\n        print(' | '.join(rows[c][i] for c in range(8)))\n    print()\nEOF\npython3 /tmp/board.py > /tmp/board.txt 2>&1\nwc -l /tmp/board.txt\n"]
