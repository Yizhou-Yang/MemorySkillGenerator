[673.102468, "i", "cat > /tmp/solve.py << 'EOF'\nimport chess\nfen = 'r1bq1r2/1p3pp1/p1n1p3/3nPkbP/8/P1N5/1P2QPP1/R1B1K2R w - - 0 1'\nb = chess.Board(fen)\nprint('VALID' if b.status()==chess.STATUS_VALID else 'INVALID', b.status())\nprint(b)\nprint('turn white?', b.turn==chess.WHITE)\nprint('black king in check?', b.is_check())\nEOF\npython3 /tmp/solve.py\n"]
