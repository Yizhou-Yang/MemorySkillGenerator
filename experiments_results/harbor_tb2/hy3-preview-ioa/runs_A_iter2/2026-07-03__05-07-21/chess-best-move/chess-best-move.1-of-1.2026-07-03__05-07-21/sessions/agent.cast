[549.771299, "i", "cat > /tmp/dump.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nS=80\nim=Image.open('/app/chess_puzzle.png').convert('RGB')\narr=np.asarray(im).astype(int)\nN=22\ndef info(r,c):\n    sq=arr[r*S:(r+1)*S, c*S:(c+1)*S]\n    bg=np.median(sq.reshape(-1,3),axis=0)\n    d=np.abs(sq-bg).sum(axis=2)\n    m=d>55\n    lum=sq[m].mean() if m.sum()>0 else 0\n    col='W' if lum>150 else 'B'\n    return m,col,m.sum()\ndef show(r,c):\n    m,col,ink=info(r,c)\n    if ink<80:\n        return\n    small=np.array(Image.fromarray(m).resize((N,N)))\n    name=chr(ord('a')+c)+str(8-r)\n    print('=== %s  color=%s ink=%d ==='%(name,col,ink))\n    for row in small:\n        print(''.join('#' if v>0 else ' ' for v in row))\nfor r in range(8):\n    for c in range(8):\n        show(r,c)\nEOF\npython3 /tmp/dump.py > /tmp/dump.txt 2>&1\ngrep -n '===' /tmp/dump.txt\n"]
