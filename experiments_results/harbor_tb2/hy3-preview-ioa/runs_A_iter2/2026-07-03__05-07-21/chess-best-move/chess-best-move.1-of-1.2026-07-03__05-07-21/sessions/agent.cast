[285.295402, "i", "cat > /tmp/match3.py << 'EOF'\nfrom PIL import Image, ImageFont, ImageDraw\nimport numpy as np\n\nS=80\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.asarray(im).astype(int)\n\n# 12 glyphs; code defines type and color (upper=white outline, lower=black solid)\nglyphs = {\n  'K':0x2654,'Q':0x2655,'R':0x2656,'B':0x2657,'N':0x2658,'P':0x2659,\n  'k':0x265A,'q':0x265B,'r':0x265C,'b':0x265D,'n':0x265E,'p':0x265F,\n}\nfont = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 64)\n\ndef norm_mask(mask):\n    ys,xs=np.where(mask)\n    if len(xs)==0: return np.zeros((64,64),bool)\n    y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\n    crop=mask[y0:y1,x0:x1]\n    h,w=crop.shape\n    side=max(h,w)\n    canvas=np.zeros((side,side),bool)\n    oy=(side-h)//2; ox=(side-w)//2\n    canvas[oy:oy+h,ox:ox+w]=crop\n    return np.array(Image.fromarray(canvas).resize((64,64)))\n\ntempl={}\nfor name,cp in glyphs.items():\n    img=Image.new('L',(S,S),255)\n    d=ImageDraw.Draw(img)\n    d.text((S/2,S/2),chr(cp),font=font,fill=0,anchor='mm')\n    m=np.asarray(img)<128\n    templ[name]=norm_mask(m)\n\ndef iou(a,b):\n    return (a&b).sum()/max((a|b).sum(),1)\n\nfor r in range(8):\n    for c in range(8):\n        sq=arr[r*S:(r+1)*S, c*S:(c+1)*S]\n        bg=np.median(sq.reshape(-1,3),axis=0)\n        d=np.abs(sq-bg).sum(axis=2)\n        m=d>50\n        if m.sum()<60: continue\n        nm=norm_mask(m)\n        scores=sorted(((iou(nm,tm),name) for name,tm in templ.items()),reverse=True)\n        top=scores[:3]\n        sqname=chr(ord('a')+c)+str(8-r)\n        info=' '.join('%s:%02d'%(n,int(s*100)) for s,n in top)\n        print(sqname, info, 'ink=%d'%m.sum())\nEOF\npython3 /tmp/match3.py\n"]
[285.296079, "o", "cat > /tmp/match3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image, ImageFont, ImageDraw\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> S=80\r\n\u001b[?2004l\r\u001b[?2004h> "]
