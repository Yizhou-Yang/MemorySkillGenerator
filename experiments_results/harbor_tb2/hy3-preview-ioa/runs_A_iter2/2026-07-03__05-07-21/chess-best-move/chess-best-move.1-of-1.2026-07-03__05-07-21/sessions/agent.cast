[341.333859, "o", "++++++++++..++..++++++++++++\r\n+++++++++..++++..+++++++++++\r\n+++++++++ ...... +++++++++++\r\n+++++++++........+++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n=== e1 (r7 c4) ===\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++..++++++++++++++\r\n+++++++++++.  .+++++++++++++\r\n++++++++++++..++++++++++++++\r\n++++++++.   ++   .++++++++++\r\n+++++++ .++.  .++. +++++++++\r\n"]
[341.333889, "o", "++++++..++++  ++++..++++++++\r\n++++++ +++++..++++. ++++++++\r\n++++++ +++++..++++. ++++++++\r\n"]
[341.333905, "o", "++++++..++++..++++..++++++++\r\n"]
[341.334606, "o", "+++++++ ....  .... +++++++++\r\n++++++++  . .. .  ++++++++++\r\n++++++++..++++++..++++++++++\r\n++++++++..++++++..++++++++++\r\n++++++++..........++++++++++\r\n+++++++++........+++++++++++\r\n++++++++++++++.+++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n++++++++++++++++++++++++++++\r\n=== h1 (r7 c7) ===\r\n............................\r\n............................\r\n............................\r\n............................\r\n............................\r\n............................\r\n............................\r\n............................\r\n.......   .    .   .........\r\n.......            .........\r\n........          ..........\r\n........  ......  ..........\r\n.........        ...........\r\n......... ...... ...........\r\n......... ...... ...........\r\n......... ...... ...........\r\n......... ...... ...........\r\n.........  ....  ...........\r\n.........        ...........\r\n........  ......  ..........\r\n........          ..........\r\n.......            .........\r\n"]
