[464.82043, "o", "    ys,xs=np.where(mask)\r\n\u001b[?2004l\r\u001b[?2004h>     if len(xs)==0:return np.zeros((64,64),bool)\r\n\u001b[?2004l\r\u001b[?2004h>     y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\r\n\u001b[?2004l\r\u001b[?2004h>     cr=mask[y0:y1,x0:x1];h,w=cr.shape;side=max(h,w)\r\n\u001b[?2004l\r\u001b[?2004h>     cv=np.zeros((side,side),bool);cv[(side-h)//2:(side-h)//2+h,(side-w)//2:(side-w)//2+w]=cr\r\n\u001b[?2004l\r\u001b[?2004h>     return np.array(Image.fromarray(cv).resize((64,64)))\r\n\u001b[?2004l\r\u001b[?2004h> def fill(mask):\r\n\u001b[?2004l\r\u001b[?2004h>     h,w=mask.shape;ni=~mask;vis=np.zeros_like(mask);st=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for x in range(w):\r\n\u001b[?2004l\r\u001b[?2004h>         for y in(0,h-1):\r\n\u001b[?2004l\r\u001b[?2004h>             if ni[y,x] and not vis[y,x]:vis[y,x]=1;st.append((y,x))\r\n\u001b[?2004l\r\u001b[?2004h>     for y in range(h):\r\n\u001b[?2004l\r\u001b[?2004h>         for x in(0,w-1):\r\n\u001b[?2004l\r\u001b[?2004h>             if ni[y,x] and not vis[y,x]:vis[y,x]=1;st.append((y,x))\r\n\u001b[?2004l\r\u001b[?2004h>     while st:\r\n\u001b[?2004l\r\u001b[?2004h>         y,x=st.pop()\r\n\u001b[?2004l\r\u001b[?2004h>         for dy,dx in((1,0),(-1,0),(0,1),(0,-1)):\r\n\u001b[?2004l\r\u001b[?2004h>             ny,nx=y+dy,x+dx\r\n\u001b[?2004l\r\u001b[?2004h>             if 0<=ny<h and 0<=nx<w and ni[ny,nx] and not vis[ny,nx]:vis[ny,nx]=1;st.append((ny,nx))\r\n\u001b[?2004l\r\u001b[?2004h>     return mask|(ni&~vis)\r\n\u001b[?2004l\r\u001b[?2004h> templ={n:norm(np.asarray(Image.new('L',(S,S),255).copy()) if False else np.asarray((lambda i,d: (d.text((S/2,S/2),chr(cp),font=font,fill=0,anchor='mm'), np.asarray(i)<128)[1])(Image.new('L',(S,S),255),ImageDraw.Draw(Image.new('L',(S,S),255))))[1]) for n,cp in glyph.items()}\r\n\u001b[?2004l\r\u001b[?2004h> "]
