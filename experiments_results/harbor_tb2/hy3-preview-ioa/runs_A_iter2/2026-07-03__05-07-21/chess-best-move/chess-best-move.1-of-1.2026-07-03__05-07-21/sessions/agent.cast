[161.992055, "o", "\u001b[?2004hroot@e4205ab934cc:/app# "]
[218.84134, "i", "cat > /tmp/match2.py << 'EOF'\nfrom PIL import Image, ImageFont, ImageDraw\nimport numpy as np\n\nS=80\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.asarray(im).astype(int)\n\nglyphs = {'k':0x265A,'q':0x265B,'r':0x265C,'b':0x265D,'n':0x265E,'p':0x265F}\nfont = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 64)\n\ndef norm_mask(mask):\n    ys,xs=np.where(mask)\n    if len(xs)==0: return np.zeros((64,64),bool)\n    y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\n    crop=mask[y0:y1,x0:x1]\n    h,w=crop.shape\n    side=max(h,w)\n    canvas=np.zeros((side,side),bool)\n    oy=(side-h)//2; ox=(side-w)//2\n    canvas[oy:oy+h,ox:ox+w]=crop\n    return np.array(Image.fromarray(canvas).resize((64,64)))\n\ntempl={}\nfor name,cp in glyphs.items():\n    img=Image.new('L',(S,S),255)\n    d=ImageDraw.Draw(img)\n    d.text((S/2,S/2),chr(cp),font=font,fill=0,anchor='mm')\n    m=np.asarray(img)<128\n    templ[name]=norm_mask(m)\n\ndef iou(a,b):\n    return (a&b).sum()/max((a|b).sum(),1)\n\nfiles='abcdefgh'\nboard=[['.' for _ in range(8)] for _ in range(8)]\nfor r in range(8):\n    for c in range(8):\n        sq=arr[r*S:(r+1)*S, c*S:(c+1)*S]\n        bg=np.median(sq.reshape(-1,3),axis=0)\n        d=np.abs(sq-bg).sum(axis=2)\n        m=d>50\n        if m.sum()<60:\n            continue\n        # color\n        ink_px=sq[m]\n        lum=ink_px.mean()\n        color='w' if lum>140 else 'b'\n        nm=norm_mask(m)\n        best=None;bs=-1\n        for name,tm in templ.items():\n            s=iou(nm,tm)\n            if s>bs: bs=s;best=name\n        letter=best.upper() if color=='w' else best\n        board[r][c]=letter+('_%02d'%int(bs*100))\nfor r in range(8):\n    print(' '.join('%5s'%x for x in board[r]))\n# count kings\nflat=[x[0] for row in board for x in row if x!='.']\nprint('K',flat.count('K'),'k',flat.count('k'))\nEOF\npython3 /tmp/match2.py\n"]
