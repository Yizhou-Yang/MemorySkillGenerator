[464.814738, "i", "cat > /tmp/dbg.py << 'EOF'\nfrom PIL import Image, ImageFont, ImageDraw\nimport numpy as np\n\nS=80\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.asarray(im).astype(int)\nglyph={'k':0x265A,'q':0x265B,'r':0x265C,'b':0x265D,'n':0x265E,'p':0x265F}\nfont=ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf',60)\ndef norm(mask):\n    ys,xs=np.where(mask)\n    if len(xs)==0:return np.zeros((64,64),bool)\n    y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\n    cr=mask[y0:y1,x0:x1];h,w=cr.shape;side=max(h,w)\n    cv=np.zeros((side,side),bool);cv[(side-h)//2:(side-h)//2+h,(side-w)//2:(side-w)//2+w]=cr\n    return np.array(Image.fromarray(cv).resize((64,64)))\ndef fill(mask):\n    h,w=mask.shape;ni=~mask;vis=np.zeros_like(mask);st=[]\n    for x in range(w):\n        for y in(0,h-1):\n            if ni[y,x] and not vis[y,x]:vis[y,x]=1;st.append((y,x))\n    for y in range(h):\n        for x in(0,w-1):\n            if ni[y,x] and not vis[y,x]:vis[y,x]=1;st.append((y,x))\n    while st:\n        y,x=st.pop()\n        for dy,dx in((1,0),(-1,0),(0,1),(0,-1)):\n            ny,nx=y+dy,x+dx\n            if 0<=ny<h and 0<=nx<w and ni[ny,nx] and not vis[ny,nx]:vis[ny,nx]=1;st.append((ny,nx))\n    return mask|(ni&~vis)\ntempl={n:norm(np.asarray(Image.new('L',(S,S),255).copy()) if False else np.asarray((lambda i,d: (d.text((S/2,S/2),chr(cp),font=font,fill=0,anchor='mm'), np.asarray(i)<128)[1])(Image.new('L',(S,S),255),ImageDraw.Draw(Image.new('L',(S,S),255))))[1]) for n,cp in glyph.items()}\ndef iou(a,b):return (a&b).sum()/max((a|b).sum(),1)\ndef show(r,c):\n    sq=arr[r*S:(r+1)*S,c*S:(c+1)*S]\n    bg=np.median(sq.reshape(-1,3),axis=0)\n    d=np.abs(sq-bg).sum(axis=2);m=d>50\n    lum=sq[m].mean() if m.sum()>0 else 0\n    sil=fill(m);ns=norm(sil)\n    sc=sorted(((iou(ns,t),n) for n,t in templ.items()),reverse=True)[:3]\n    print(chr(ord('a')+c)+str(8-r),'ink',m.sum(),'lum%.0f'%lum,'->',['%s:%d'%(n,int(s*100)) for s,n in sc])\nfor r,c in [(0,0),(2,0),(5,0),(7,0),(7,4),(7,2),(7,7),(3,4)]:\n    show(r,c)\nEOF\npython3 /tmp/dbg.py\n"]
