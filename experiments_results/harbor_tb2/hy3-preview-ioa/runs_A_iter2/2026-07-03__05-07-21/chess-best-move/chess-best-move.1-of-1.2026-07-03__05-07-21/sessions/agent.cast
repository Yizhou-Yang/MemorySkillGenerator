[132.930651, "i", "cat > /tmp/ascii.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\n\nim = Image.open('/app/chess_puzzle.png').convert('L')\na = np.asarray(im)\nS=80\ndef show(r,c):\n    sq=a[r*S:(r+1)*S, c*S:(c+1)*S]\n    # downsample to 20x20\n    small=sq.reshape(20,4,20,4).mean(axis=(1,3))\n    print('square',chr(ord('a')+c), 8-r)\n    for row in small:\n        line=''.join('#' if v<128 else ('.' if v<220 else ' ') for v in row)\n        print(line)\n    print()\n# show a few occupied squares\nfor (r,c) in [(0,0),(0,2),(1,1),(2,2),(3,4),(6,4),(7,0),(7,7)]:\n    show(r,c)\nEOF\npython3 /tmp/ascii.py\n"]
