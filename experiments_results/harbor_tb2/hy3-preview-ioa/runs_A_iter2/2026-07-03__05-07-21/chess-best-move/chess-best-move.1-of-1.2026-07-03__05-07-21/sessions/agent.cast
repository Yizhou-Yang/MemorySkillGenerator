[161.606959, "i", "cat > /tmp/match.py << 'EOF'\nfrom PIL import Image, ImageFont, ImageDraw\nimport numpy as np\n\nS=80\nim = Image.open('/app/chess_puzzle.png').convert('L')\na = np.asarray(im)\n\n# build templates\nglyphs = {\n  'K':0x2654,'Q':0x2655,'R':0x2656,'B':0x2657,'N':0x2658,'P':0x2659,\n  'k':0x265A,'q':0x265B,'r':0x265C,'b':0x265D,'n':0x265E,'p':0x265F,\n}\nfont = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 60)\ntempl={}\nfor name,cp in glyphs.items():\n    img=Image.new('L',(S,S),255)\n    d=ImageDraw.Draw(img)\n    d.text((S/2,S/2),chr(cp),font=font,fill=0,anchor='mm')\n    arr=np.asarray(img)\n    m=arr<128\n    templ[name]=m\n\ndef iou(m1,m2):\n    inter=(m1&m2).sum()\n    uni=(m1|m2).sum()\n    return inter/uni if uni>0 else 0\n\nfiles='abcdefgh'\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        sq=a[r*S:(r+1)*S, c*S:(c+1)*S]\n        m=sq<128\n        if m.sum()<40:\n            row.append('  .  ')\n            continue\n        best=None;bs=-1\n        for n"]
