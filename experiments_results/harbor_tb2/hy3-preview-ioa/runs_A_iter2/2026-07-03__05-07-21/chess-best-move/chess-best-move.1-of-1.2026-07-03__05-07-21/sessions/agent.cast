[340.991706, "i", "cat > /tmp/look.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('L')\nS=80\ndef show(name, r, c):\n    sq=im.crop((c*S,r*S,c*S+S,r*S+S)).resize((28,28))\n    a=np.asarray(sq)\n    print('=== %s (r%d c%d) ==='% (name,r,c))\n    for row in a:\n        line=''.join('#' if v<100 else ('+' if v<170 else ('.' if v<225 else ' ')) for v in row)\n        print(line)\nfor name,r,c in [('a8',0,0),('c8',0,2),('e5',3,4),('f5',3,5),('a3',5,0),('c3',5,2),('a1',7,0),('c1',7,2),('e1',7,4),('h1',7,7)]:\n    show(name,r,c)\nEOF\npython3 /tmp/look.py\n"]
