[341.365633, "o", "\u001b[?2004hroot@e4205ab934cc:/app# "]
[423.1888, "i", "cat > /tmp/recog.py << 'EOF'\nfrom PIL import Image, ImageFont, ImageDraw\nimport numpy as np\n\nS=80\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.asarray(im).astype(int)\n\nglyph_types = {'k':0x265A,'q':0x265B,'r':0x265C,'b':0x265D,'n':0x265E,'p':0x265F}\nfont = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 60)\n\ndef norm(mask):\n    ys,xs=np.where(mask)\n    if len(xs)==0: return np.zeros((64,64),bool)\n    y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\n    crop=mask[y0:y1,x0:x1]\n    h,w=crop.shape\n    side=max(h,w)\n    canvas=np.zeros((side,side),bool)\n    oy=(side-h)//2; ox=(side-w)//2\n    canvas[oy:oy+h,ox:ox+w]=crop\n    return np.array(Image.fromarray(canvas).resize((64,64)))\n\ndef fill_holes(mask):\n    h,w=mask.shape\n    notink=~mask\n    visited=np.zeros_like(mask)\n    stack=[]\n    for x in range(w):\n        for y in (0,h-1):\n            if notink[y,x] and not visited[y,x]: visited[y,x]=True; stack.append((y,x))\n    for y in range(h):\n        for x in (0,w-1):\n            if notink[y,x] and not visited[y,x]: visited[y,x]=True; stack.append((y,x))\n    while stack:\n        y,x=stack.pop()\n        for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n            ny,nx=y+dy,x+dx\n            if 0<=ny<h and 0<=nx<w and notink[ny,nx] and not visited[ny,nx]:\n                visited[ny,nx]=True; stack.append((ny,nx))\n    return mask | (notink & ~visited)\n\n# templates: solid silhouette (no fill needed)\ntempl={}\nfor name,cp in glyph_types.items():\n    img=Image.new('L',(S,S),255)\n    d=ImageDraw.Draw(img)\n    d.text((S/2,S/2),chr(cp),font=font,fill=0,anchor='mm')\n    m=np.asarray(img)<128\n    # erode slightly to remove anti-alias fringe then it's the silhouette\n    templ[name]=norm(m)\n\ndef iou(a,b):\n    return (a&b).sum()/max((a|b).sum(),1)\n\nboard=[['.' for _ in range(8)] for _ in range(8)]\nfor r in range(8):\n    for c in range(8):\n        sq=arr[r*S:(r+1)*S, c*S:(c+1)*S]\n        bg=np.median(sq.reshape(-1,3),axis=0)\n        d=np.abs(sq-bg).sum(axis=2)\n        m=d>50\n        if m.sum()<80: continue\n        lum=sq[m].mean()\n        color='w' if lum>150 else 'b'\n        sil=fill_holes(m)\n        ns=norm(sil)\n        best=None;bs=-1\n        for name,tm in templ.items():\n            s=iou(ns,tm)\n            if s>bs: bs=s;best=name\n        letter=best.upper() if color=='w' else best\n        board[r][c]=letter+('%02d'%int(bs*100))\nfor r in range(8):\n    print(' '.join('%5s'%x for x in board[r]))\nflat=[x[0] for row in board for x in row if x!='.']\nprint('counts K',flat.count('K'),'k',flat.count('k'),'Q',flat.count('Q'),'q',flat.count('q'))\nprint('total',len(flat))\nEOF\npython3 /tmp/recog.py\n"]
