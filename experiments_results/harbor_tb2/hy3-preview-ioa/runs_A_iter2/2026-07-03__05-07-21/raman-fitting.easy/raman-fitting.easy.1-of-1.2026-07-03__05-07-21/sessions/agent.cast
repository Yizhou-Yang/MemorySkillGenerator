[425.945736, "i", "cat > explore2.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\ndata=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.split()\n        if len(p)!=2: continue\n        data.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\nidx=np.argsort(x); x=x[idx]; y=y[idx]\n# baseline estimate via min in nearby window? just look at peaks\npeaks, props = find_peaks(y, prominence=2000, distance=20)\nprint('num peaks:', len(peaks))\norder=np.argsort(props['prominences'])[::-1]\nprint('Top 12 peaks by prominence (x, y, prom):')\nfor i in order[:12]:\n    print(round(x[peaks[i]],2), round(y[peaks[i]],2), round(props['prominences'][i],2))\n# report max y in G and 2D windows (if x were cm-1)\nfor lo,hi,name in [(1500,1700,'1580win'),(2600,2900,'2700win')]:\n    m=(x>=lo)&(x<=hi)\n    if m.any():\n        j=np.argmax(y[m]); print(name, 'x', r"]
[425.945916, "i", "ound(x[m][j],2), 'y', round(y[m][j],2))\n    else:\n        print(name,'no data in window')\nEOF\npython3 explore2.py\n"]
