[550.917926, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\npts=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.split()\n        if len(p)!=2: continue\n        pts.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(pts)\nx=d[:,0]; y=d[:,1]\nidx=np.argsort(x); x=x[idx]; y=y[idx]\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp/(1.0+((x-x0)/gamma)**2)\n\ndef fit_peak(x, y, x0g, hw):\n    m=(x>=x0g-hw)&(x<=x0g+hw)\n    xx=x[m]; yy=y[m]\n    off0=yy.min(); amp0=yy.max()-yy.min()\n    p0=[x0g, hw*0.4, amp0, off0]\n    popt,_=curve_fit(lor, xx, yy, p0=p0, maxfev=200000)\n    x0,gamma,amp,off=popt\n    return x0, abs(gamma), abs(amp), off\n\nx0g,gg,ag,og = fit_peak(x,y,19139,1500)\nx02,g2,a2,o2 = fit_peak(x,y,33244,1500)\n\nres={\n  \"G\": {\"x0\": float(x0g), \"gamma\": float(gg), \"amplitude\": float(ag), \"offset\": float(og)},\n  \"2D\": {\"x0\": float(x02), \"gamma\": float(g2), \"amplitude\": float(a2), \"o"]
[550.918374, "i", "ffset\": float(o2)}\n}\nprint(\"G fit:  x0=%.2f gamma=%.2f amp=%.2f offset=%.2f\"%(x0g,gg,ag,og))\nprint(\"2D fit: x0=%.2f gamma=%.2f amp=%.2f offset=%.2f\"%(x02,g2,a2,o2))\nwith open('results.json','w') as f:\n    json.dump(res, f, indent=2)\nprint('written results.json')\nEOF\npython3 fit.py\n"]
