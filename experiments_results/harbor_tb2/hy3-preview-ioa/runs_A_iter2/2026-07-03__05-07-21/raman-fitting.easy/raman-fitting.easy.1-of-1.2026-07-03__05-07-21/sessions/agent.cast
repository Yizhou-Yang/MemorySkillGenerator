[632.671318, "i", "cat > diag.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\npts=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.split()\n        if len(p)!=2: continue\n        pts.append((float(p[0].replace(',','.')), float(p[1].replace(',','.'))))\nd=np.array(pts); x=d[:,0]; y=d[:,1]\nidx=np.argsort(x); x=x[idx]; y=y[idx]\ndef lor(x,x0,g,a,o): return o+a/(1.0+((x-x0)/g)**2)\ndef fit(x,y,x0g,hw):\n    m=(x>=x0g-hw)&(x<=x0g+hw); xx=x[m]; yy=y[m]\n    p0=[x0g,hw*0.4,yy.max()-yy.min(),yy.min()]\n    popt,_=curve_fit(lor,xx,yy,p0=p0,maxfev=200000)\n    return popt,m\nfor name,x0g,hw in [('G',19139,1500),('2D',33244,1500)]:\n    popt,m=fit(x,y,x0g,hw); x0,g,a,o=popt\n    xx=x[m]; yy=y[m]; pred=lor(xx,*popt)\n    r2=1-np.sum((yy-pred)**2)/np.sum((yy-yy.mean())**2)\n    print(f'{name}: x0={x0:.2f} g={g:.2f} amp={a:.2f} off={o:.2f} peak={o+a:.2f} datamax={yy.max():.2f} R2_win={r2:.4f} npts={len(xx)}')\nEOF"]
[632.671555, "i", "\npython3 diag.py\n"]
