[591.279588, "i", "cat >> fit.py << 'EOF'\n\ndef r2(x,y,x0,g,a,o):\n    pred=lor(x,x0,g,a,o)\n    ss_res=np.sum((y-pred)**2); ss_tot=np.sum((y-y.mean())**2)\n    return 1-ss_res/ss_tot\nprint('R2 G ', r2(x,y, x0g,gg,ag,og))\nprint('R2 2D', r2(x,y, x02,g2,a2,o2))\nEOF\npython3 fit.py\n"]
