[632.680624, "o", "> "]
[632.680851, "o", "def lor(x,x0,g,a,o): return o+a/(1.0+((x-x0)/g)**2)"]
[632.681112, "o", "\r\n"]
[632.681233, "o", "\u001b[?2004l\r"]
[632.681447, "o", "\u001b[?2004h"]
[632.681998, "o", "> "]
[632.682272, "o", "def fit(x,y,x0g,hw):"]
[632.682392, "o", "\r\n"]
[632.682594, "o", "\u001b[?2004l\r"]
[632.68273, "o", "\u001b[?2004h"]
[632.682856, "o", "> "]
[632.683162, "o", "    m=(x>=x0g-hw)&(x<=x0g+hw); xx=x[m]; yy=y[m]"]
[632.684233, "o", "\r\n"]
[632.684436, "o", "\u001b[?2004l\r"]
[632.684575, "o", "\u001b[?2004h"]
[632.684761, "o", "> "]
[632.684983, "o", "    p0=[x0g,hw*0.4,yy.max()-yy.min(),yy.min()]"]
[632.685184, "o", "\r\n"]
[632.685381, "o", "\u001b[?2004l\r"]
[632.685546, "o", "\u001b[?2004h"]
[632.685731, "o", "> "]
[632.685961, "o", "    popt,_=curve_fit(lor,xx,yy,p0=p0,maxfev=200000)"]
[632.686164, "o", "\r\n"]
[632.686332, "o", "\u001b[?2004l\r"]
[632.687443, "o", "\u001b[?2004h"]
[632.687577, "o", "> "]
[632.687812, "o", "    return popt,m"]
[632.687932, "o", "\r\n"]
[632.688052, "o", "\u001b[?2004l\r"]
[632.688292, "o", "\u001b[?2004h"]
[632.688443, "o", "> "]
[632.688709, "o", "for name,x0g,hw in [('G',19139,1500),('2D',33244,1500)]:"]
[632.688904, "o", "\r\n"]
[632.68909, "o", "\u001b[?2004l\r"]
[632.68923, "o", "\u001b[?2004h"]
[632.689454, "o", "> "]
[632.689844, "o", "    popt,m=fit(x,y,x0g,hw); x0,g,a,o=popt"]
[632.690655, "o", "\r\n"]
[632.69083, "o", "\u001b[?2004l\r"]
[632.691013, "o", "\u001b[?2004h"]
[632.691209, "o", "> "]
[632.691437, "o", "    xx=x[m]; yy=y[m]; pred=lor(xx,*popt)"]
[632.691619, "o", "\r\n"]
[632.691813, "o", "\u001b[?2004l\r"]
[632.692796, "o", "\u001b[?2004h"]
[632.692995, "o", "> "]
[632.693252, "o", "    r2=1-np.sum((yy-pred)**2)/np.sum((yy-yy.mean())**2)"]
[632.693458, "o", "\r\n"]
[632.693624, "o", "\u001b[?2004l\r"]
[632.693771, "o", "\u001b[?2004h"]
[632.693983, "o", "> "]
[632.694443, "o", "    print(f'{name}: x0={x0:.2f} g={g:.2f} amp={a:.2f} off={o:.2f} peak={o+a:.2f} datamax={yy.max():.2f} R2_win={r2:.4f} npts={len(xx)}')"]
[632.694667, "o", "\r\n"]
[632.694831, "o", "\u001b[?2004l\r"]
[632.695049, "o", "\u001b[?2004h"]
[632.696017, "o", "> "]
[632.69622, "o", "EOF"]
