[399.969448, "i", "cat > explore.py << 'EOF'\nimport numpy as np\n# convert commas to dots\ndata = []\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        parts=line.split()\n        if len(parts)!=2: continue\n        x=float(parts[0].replace(',','.'))\n        y=float(parts[1].replace(',','.'))\n        data.append((x,y))\ndata=np.array(data)\nx=data[:,0]; y=data[:,1]\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\nprint('n', len(x))\n# sort\nidx=np.argsort(x)\nx=x[idx]; y=y[idx]\n# find peaks (local maxima) - top 10 maxima\norder=np.argsort(y)[::-1]\nprint('Top 15 intensity points (x, y):')\nfor i in order[:15]:\n    print(round(x[i],2), round(y[i],2))\nEOF\npython3 explore.py\n"]
