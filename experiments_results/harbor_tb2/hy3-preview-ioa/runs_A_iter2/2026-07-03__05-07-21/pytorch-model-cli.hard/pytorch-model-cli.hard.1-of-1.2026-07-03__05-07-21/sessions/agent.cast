[526.741784, "o", "> "]
[526.742179, "o", "    if ct==2: return [(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),3)]"]
[526.742391, "o", "\r\n"]
[526.742586, "o", "\u001b[?2004l\r"]
[526.742793, "o", "\u001b[?2004h"]
[526.742984, "o", "> "]
[526.743356, "o", "    if ct==4: return [pix[i] for i in range(0,len(pix),2)]"]
