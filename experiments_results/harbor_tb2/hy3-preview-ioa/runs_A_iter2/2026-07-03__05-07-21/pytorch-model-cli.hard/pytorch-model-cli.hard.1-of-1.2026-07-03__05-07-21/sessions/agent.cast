[482.865845, "i", "cat > /app/test_pre.py << 'PYEOF'\nimport torch, json, struct, zlib\nsd = torch.load('model.pth', map_location='cpu', weights_only=False)\nclass M:\n    pass\nimport torch.nn.functional as F\n\ndef decode_png(path):\n    d=open(path,'rb').read(); pos=8; w=h=ct=None; idat=b''\n    while pos < len(d):\n        ln=struct.unpack('>I', d[pos:pos+4])[0]; t=d[pos+4:pos+8]; c=d[pos+8:pos+8+ln]\n        if t==b'IHDR': w,h,bd,ct,comp,filt,il=struct.unpack('>IIBBBBB', c)\n        elif t==b'IDAT': idat+=c\n        elif t==b'IEND': break\n        pos+=12+ln\n    raw=zlib.decompress(idat); ch=1; stride=w*ch; out=bytearray(); prev=bytearray(stride)\n    i=0\n    for y in range(h):\n        f=raw[i]; i+=1; ln=bytearray(raw[i:i+stride]); i+=stride\n        for x in range(stride):\n            a=ln[x-1] if x>=1 else 0; b=prev[x]; c=prev[x-1] if x>=1 else 0\n            if f==0: v=ln[x]\n            elif f==1: v=ln[x]+a\n            elif f==2: v=ln[x]+b\n            elif f==3: v=ln[x]+((a+b)//2)\n        "]
