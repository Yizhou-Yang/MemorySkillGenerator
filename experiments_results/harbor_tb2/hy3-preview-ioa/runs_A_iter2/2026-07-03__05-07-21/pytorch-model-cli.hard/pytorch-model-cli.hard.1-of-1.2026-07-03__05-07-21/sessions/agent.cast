[526.70767, "i", "cat > /app/forward.py << 'PYEOF'\nimport json, struct, zlib, sys\ndef decode_png(path):\n    d=open(path,'rb').read(); pos=8; w=h=ct=None; idat=b''\n    while pos < len(d):\n        ln=struct.unpack('>I', d[pos:pos+4])[0]; t=d[pos+4:pos+8]; c=d[pos+8:pos+8+ln]\n        if t==b'IHDR': w,h,bd,ct,comp,filt,il=struct.unpack('>IIBBBBB', c)\n        elif t==b'IDAT': idat+=c\n        elif t==b'IEND': break\n        pos+=12+ln\n    raw=zlib.decompress(idat); ch={0:1,2:3,4:2,6:4}[ct]; stride=w*ch\n    out=bytearray(); prev=bytearray(stride); i=0\n    for y in range(h):\n        f=raw[i]; i+=1; ln=bytearray(raw[i:i+stride]); i+=stride\n        for x in range(stride):\n            a=ln[x-ch] if x>=ch else 0; b=prev[x]; c=prev[x-ch] if x>=ch else 0\n            if f==0: v=ln[x]\n            elif f==1: v=ln[x]+a\n            elif f==2: v=ln[x]+b\n            elif f==3: v=ln[x]+((a+b)//2)\n            elif f==4:\n                p=a+b-c; pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\n                v=ln["]
[526.70804, "i", "x]+(a if (pa<=pb and pa<=pc) else (b if pb<=pc else c))\n            ln[x]=v&0xff\n        out+=ln; prev=ln\n    return w,h,ct,list(out)\n\ndef to_gray(w,h,ct,pix):\n    if ct==0: return pix\n    if ct==2: return [(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),3)]\n    if ct==4: return [pix[i] for i in range(0,len(pix),2)]\n    if ct==6: return [(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),4)]\n\ndef resize(g,w,h,TW=28,TH=28):\n    if w==TW and h==TH: return g\n    out=[]\n    for y in range(TH):\n        sy=min(h-1, y*h//TH)\n        for x in range(TW):\n            sx=min(w-1, x*w//TW)\n            out.append(g[sy*w+sx])\n    return out\n\nd=json.load(open('weights.json'))\nw,h,ct,pix=decode_png('image.png')\ngray=to_gray(w,h,ct,pix)\ng=resize(gray,w,h)\nx=[float(v) for v in g]\nD=d['dims']\ndef lin(W,B,x):\n    return [sum(W[i][j]*x[j] for j in range(len(x)))+B[i] for i in range(len(W))]\nh1=[max(0.0,v) for v in lin(d['W1'],d['b1'],x)]\nh2=[max(0.0,v) for v in lin(d['W2'],d['b2'],h1)]\no=lin(d['W3'],d['b3'],h2)\nans=m"]
[526.708119, "i", "ax(range(len(o)), key=lambda i:o[i])\nprint(ans)\nopen('prediction.txt','w').write(str(ans)+'\\n')\nPYEOF\npython3 /app/forward.py 2>&1\n"]
