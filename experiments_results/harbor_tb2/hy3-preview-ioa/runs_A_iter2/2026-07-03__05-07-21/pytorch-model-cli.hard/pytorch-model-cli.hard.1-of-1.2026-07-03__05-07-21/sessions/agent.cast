[526.743768, "o", "\u001b[?2004l\r"]
[526.744478, "o", "\u001b[?2004h"]
[526.745628, "o", "> "]
[526.752982, "o", "    if ct==6: return [(pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix),4)]"]
[526.753499, "o", "\r\n"]
[526.753696, "o", "\u001b[?2004l\r"]
[526.753922, "o", "\u001b[?2004h"]
