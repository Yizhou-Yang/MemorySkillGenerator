[526.754333, "o", "\r\n"]
[526.754518, "o", "\u001b[?2004l\r"]
[526.754714, "o", "\u001b[?2004h"]
[526.754897, "o", "> "]
[526.755171, "o", "def resize(g,w,h,TW=28,TH=28):"]
[526.755372, "o", "\r\n"]
[526.755575, "o", "\u001b[?2004l\r"]
[526.755773, "o", "\u001b[?2004h"]
[526.756, "o", "> "]
[526.756305, "o", "    if w==TW and h==TH: return g"]
[526.756511, "o", "\r\n"]
[526.756711, "o", "\u001b[?2004l\r"]
[526.756922, "o", "\u001b[?2004h"]
[526.757124, "o", "> "]
[526.757349, "o", "    out=[]"]
[526.757528, "o", "\r\n"]
[526.757704, "o", "\u001b[?2004l\r"]
[526.7579, "o", "\u001b[?2004h"]
[526.758099, "o", "> "]
[526.758351, "o", "    for y in range(TH):"]
[526.758534, "o", "\r\n"]
[526.75871, "o", "\u001b[?2004l\r"]
[526.758904, "o", "\u001b[?2004h"]
[526.759104, "o", "> "]
[526.759721, "o", "        sy=min(h-1, y*h//TH)"]
[526.760314, "o", "\r\n"]
[526.760522, "o", "\u001b[?2004l\r"]
[526.76123, "o", "\u001b[?2004h"]
[526.761441, "o", "> "]
[526.761683, "o", "        for x in range(TW):"]
[526.761861, "o", "\r\n"]
[526.762038, "o", "\u001b[?2004l\r"]
[526.767913, "o", "\u001b[?2004h"]
[526.768229, "o", "> "]
[526.768518, "o", "            sx=min(w-1, x*w//TW)"]
[526.7687, "o", "\r\n"]
[526.76888, "o", "\u001b[?2004l\r"]
[526.769122, "o", "\u001b[?2004h"]
[526.769328, "o", "> "]
[526.769593, "o", "            out.append(g[sy*w+sx])"]
[526.769774, "o", "\r\n"]
[526.769955, "o", "\u001b[?2004l\r"]
[526.770175, "o", "\u001b[?2004h"]
[526.770427, "o", "> "]
[526.770483, "o", "    return out\r\n\u001b[?2004l\r"]
[526.77053, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[526.770563, "o", "> "]
[526.770664, "o", "d=json.load(open('weights.json'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.770776, "o", "w,h,ct,pix=decode_png('image.png')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.770888, "o", "gray=to_gray(w,h,ct,pix)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.770907, "o", "g=resize(gray,w,h)\r\n\u001b[?2004l\r"]
[526.770918, "o", "\u001b[?2004h> "]
[526.771084, "o", "x=[float(v) for v in g]\r\n\u001b[?2004l\r\u001b[?2004h> D=d['dims']\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.771109, "o", "> "]
[526.771158, "o", "def lin(W,B,x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.771386, "o", "    return [sum(W[i][j]*x[j] for j in range(len(x)))+B[i] for i in range(len(W))]\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.771408, "o", "> "]
[526.77153, "o", "h1=[max(0.0,v) for v in lin(d['W1'],d['b1'],x)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.771555, "o", "> "]
[526.771689, "o", "h2=[max(0.0,v) for v in lin(d['W2'],d['b2'],h1)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.771805, "o", "o=lin(d['W3'],d['b3'],h2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.771918, "o", "ans=max(range(len(o)), key=lambda i:o[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[526.771937, "o", "print(ans)\r\n\u001b[?2004l\r"]
[526.771948, "o", "\u001b[?2004h> "]
[526.772105, "o", "open('prediction.txt','w').write(str(ans)+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[526.772123, "o", "> "]
