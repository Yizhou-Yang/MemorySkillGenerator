[449.830517, "i", "cat > /app/dump.py << 'PYEOF'\nimport torch, json, struct, zlib\n\nsd = torch.load('model.pth', map_location='cpu', weights_only=False)\nW1 = sd['input_layer.weight'].tolist()\nb1 = sd['input_layer.bias'].tolist()\nW2 = sd['hidden_layer.weight'].tolist()\nb2 = sd['hidden_layer.bias'].tolist()\nW3 = sd['output_layer.weight'].tolist()\nb3 = sd['output_layer.bias'].tolist()\ndims = {'in': len(W1[0]), 'hidden': len(W1), 'out': len(W3)}\njson.dump({'dims': dims, 'W1': W1, 'b1': b1, 'W2': W2, 'b2': b2, 'W3': W3, 'b3': b3}, open('weights.json','w'))\nprint('wrote weights.json dims', dims)\n\ndef decode_png(path):\n    d = open(path,'rb').read()\n    assert d[:8]==b'\\x89PNG\\r\\n\\x1a\\n', 'bad png'\n    pos=8; w=h=ct=None; idat=b''\n    while pos < len(d):\n        ln=struct.unpack('>I', d[pos:pos+4])[0]\n        t=d[pos+4:pos+8]; c=d[pos+8:pos+8+ln]\n        if t==b'IHDR':\n            w,h,bd,ct,comp,filt,il=struct.unpack('>IIBBBBB', c)\n        elif t==b'IDAT': idat+=c\n        elif t==b'IEND':"]
[449.830662, "o", "cat > /app/dump.py << 'PYEOF'\r\nimport torch, json, struct, zlib\r\n\r\nsd = torch.load('model.pth', map_location='cpu', weights_only=False)\r\nW1 = sd['input_layer.weight'].tolist()\r\nb1 = sd['input_layer.bias'].tolist()\r\nW2 = sd['hidden_layer.weight'].tolist()\r\nb2 = sd['hidden_layer.bias'].tolist()\r\nW3 = sd['output_layer.weight'].tolist()\r\nb3 = sd['output_layer.bias'].tolist()\r\ndims = {'in': len(W1[0]), 'hidden': len(W1), 'out': len(W3)}\r\njson.dump({'dims': dims, 'W1': W1, 'b1': b1, 'W2': W2, 'b2': b2, 'W3': W3, 'b3': b3}, open('weights.json','w'))\r\nprint('wrote weights.json dims', dims)\r\n\r\ndef decode_png(path):\r\n    d = open(path,'rb').read()\r\n    assert d[:8]==b'\\x89PNG\\r\\n\\x1a\\n', 'bad png'\r\n    pofuse-overlayfs  984G  963G     0 100% /\r\ns=8; w=h=ct=None; idat=b''\r\n    while pos < len(d):\r\n        ln=struct.unpack('>I', d[pos:pos+4])[0]\r\n        t=d[pos+4:pos+8]; c=d[pos+8:pos+8+ln]\r\n        if t==b'IHDR':\r\n            w,h,bd,ct,comp,filt,il=struct.unpack('>IIBBBBB', c)\r\n        elif t==b'IDAT': idat+=c\r\n       "]
[449.83079, "o", " elif t==b'IEND':"]
[449.831147, "o", "\u001b[?2004hroot@6a2749715abb:/app# cat > /app/dump.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, json, struct, zlib\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.831239, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[449.831553, "i", " break\n        pos+=12+ln\n    raw=zlib.decompress(idat)\n    ch={0:1,2:3,4:2,6:4}[ct]\n    stride=w*ch\n    out=bytearray(); prev=bytearray(stride)\n    def paeth(a,b,c):\n        p=a+b-c; pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\n        if pa<=pb and pa<=pc: return a\n        if pb<=pc: return b\n        return c\n    i=0\n    for y in range(h):\n        f=raw[i]; i+=1\n        ln=bytearray(raw[i:i+stride]); i+=stride\n        for x in range(stride):\n            a=ln[x-ch] if x>=ch else 0\n            b=prev[x]; c=prev[x-ch] if x>=ch else 0\n            if f==0: v=ln[x]\n            elif f==1: v=ln[x]+a\n            elif f==2: v=ln[x]+b\n            elif f==3: v=ln[x]+((a+b)//2)\n            elif f==4: v=ln[x]+paeth(a,b,c)\n            ln[x]=v&0xff\n        out+=ln; prev=ln\n    return w,h,ct,list(out)\n\nw,h,ct,pix=decode_png('image.png')\nprint('IMG', w, h, 'colortype', ct, 'min', min(pix), 'max', max(pix), 'mean', sum(pix)/len(pix))\nif ct==0:\n    gray=pix\nelif ct==2:\n    gray=[ (pix[i]+pix[i+1]+pix[i+2])//3 for i in range(0,len(pix"]
