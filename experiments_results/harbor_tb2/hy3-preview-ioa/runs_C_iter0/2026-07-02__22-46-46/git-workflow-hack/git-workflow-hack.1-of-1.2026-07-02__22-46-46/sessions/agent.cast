[431.788954, "i", "naptic Motifs in EM Datasets.\" <em>Neuroinformatics</em>, 21(4), 299–312.</div>\n  <div class=\"card\">3. Moreno, L. et al. (2022). \"Integrative Single-Cell Atlas of Human Cerebral Organoids.\" <em>Cell Systems</em>, 9(1), 67–82.</div>\n  <div class=\"card\">4. Chen, J., Moreno, L., &amp; Russo, M. (2021). \"Explainable AI Techniques in Neural Decoding.\" <em>Frontiers in Neuroscience</em>, 15, 756843.</div>\n</main>\n<footer>© 2025 Dr. Lydia Moreno.</footer>\n</body>\n</html>\nEOF\n"]
