[431.383863, "o", "  <section>\r\n"]
[431.383889, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[431.383985, "o", "    <h2>Education</h2>\r\n\u001b[?2004l\r\u001b[?2004h"]
[431.384015, "o", "> "]
[431.384471, "o", "    <div class=\"card\"><strong>Ph.D., Computational Biology</strong> — Baywood Institute of Technology, 2014–2019<br>Dissertation: \"Deep Learning Models for Decoding Neural Population Activity\"</div>"]
[431.385369, "o", "\r\n"]
[431.385459, "o", "\u001b[?2004l\r"]
[431.385542, "o", "\u001b[?2004h"]
[431.385611, "o", "> "]
[431.386104, "o", "    <div class=\"card\"><strong>M.Sc., Bioinformatics</strong> — Riverbend University, 2012–2014<br>Thesis: \"Statistical Methods for Single-Cell RNA-Seq Analysis\"</div>"]
[431.386174, "o", "\r\n"]
[431.386245, "o", "\u001b[?2004l\r"]
[431.386341, "o", "\u001b[?2004h"]
[431.386415, "o", "> "]
[431.387151, "o", "    <div class=\"card\"><strong>B.Sc., Computer Science</strong> — Crestfield College of Engineering, 2008–2012<br>Graduated magna cum laude; President, Data Science Club</div>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.387244, "o", "  </section>"]
[431.38733, "o", "\r\n\u001b[?2004l\r"]
[431.387408, "o", "\u001b[?2004h"]
[431.38748, "o", "> "]
[431.387583, "o", "  <section>"]
[431.387694, "o", "\r\n\u001b[?2004l\r"]
[431.387889, "o", "\u001b[?2004h> "]
[431.387945, "o", "    <h2>Research Interests</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <ul>\r\n\u001b[?2004l\r"]
[431.390859, "o", "\u001b[?2004h>       <li><strong>Neural Encoding &amp; Decoding</strong> — interpretable models translating spike-train data into behavioral predictions.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>Machine Learning for Biomedical Imaging</strong> — CNNs and GNNs applied to MRI and two-photon microscopy.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>Single-Cell Omics</strong> — scalable pipelines integrating multi-modal single-cell genomics and spatial transcriptomics.</li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><strong>Explainable AI in Neuroscience</strong> — probing decision boundaries and feature attributions in black-box models.</li>\r\n\u001b[?2004l\r\u001b[?2004h>     </ul>\r\n\u001b[?2004l\r\u001b[?2004h>   </section>\r\n\u001b[?2004l\r\u001b[?2004h>   <section>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Selected Projects</h2>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.392015, "o", "    <div class=\"card\"><strong>DeepVision: High-Resolution Neural Activity Mapping</strong><br>Lead Developer &amp; Project Coordinator. PyTorch-based pipeline to segment two-photon images of mouse visual cortex; TCNs predict stimulus orientation from calcium traces; Dockerized microservice deployed with Cascade Imaging Lab.</div>"]
[431.39209, "o", "\r\n"]
[431.392164, "o", "\u001b[?2004l\r"]
[431.392278, "o", "\u001b[?2004h"]
[431.392378, "o", "> "]
[431.393143, "o", "    <div class=\"card\"><strong>NeuroGraph: Graph Neural Networks for Circuit Analysis</strong><br>Principal Investigator. Graph representations of reconstructed neuron meshes from EM; GNNs classify synapses and infer connectivity motifs. Open-source toolkit adopted by 12 labs.</div>"]
[431.393213, "o", "\r\n"]
[431.393284, "o", "\u001b[?2004l\r"]
[431.393388, "o", "\u001b[?2004h"]
[431.393467, "o", "> "]
[431.394142, "o", "    <div class=\"card\"><strong>CellMap: Multi-Modal Single-Cell Atlas</strong><br>Co-Principal Investigator. Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH; Bayesian clustering of human cortical organoids.</div>"]
[431.394212, "o", "\r\n"]
[431.394285, "o", "\u001b[?2004l\r"]
[431.394415, "o", "\u001b[?2004h> "]
[431.39453, "o", "  </section>\r\n\u001b[?2004l\r"]
[431.394675, "o", "\u001b[?2004h>   <section>"]
[431.394727, "o", "\r\n\u001b[?2004l\r"]
[431.394748, "o", "\u001b[?2004h"]
[431.394768, "o", "> "]
[431.39495, "o", "    <h2>Skills &amp; Tools</h2>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.395503, "o", "    <p><strong>Languages:</strong> Python, R, C++ &nbsp;|&nbsp; <strong>Frameworks:</strong> PyTorch, TensorFlow, scikit-learn, NetworkX &nbsp;|&nbsp; <strong>Data Tools:</strong> Nextflow, Snakemake, Docker, Kubernetes</p>\r\n\u001b[?2004l\r"]
[431.395615, "o", "\u001b[?2004h>   </section>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.395844, "o", "  <section>\r\n\u001b[?2004l\r"]
[431.395876, "o", "\u001b[?2004h> "]
[431.395996, "o", "    <h2>Contact</h2>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.396026, "o", "    <ul>\r\n\u001b[?2004l\r"]
[431.396108, "o", "\u001b[?2004h> "]
[431.396233, "o", "      <li>Email: lydia.moreno@riverbend.edu</li>\r\n\u001b[?2004l\r"]
[431.396263, "o", "\u001b[?2004h> "]
[431.396469, "o", "      <li>Office: Blakely Hall, Room 312, Riverbend University</li>\r\n\u001b[?2004l\r"]
[431.3965, "o", "\u001b[?2004h> "]
[431.396861, "o", "      <li>Twitter: <a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></li>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.397052, "o", "      <li>GitHub: <a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></li>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[431.3971, "o", "    </ul>\r\n\u001b[?2004l\r\u001b[?2004h> "]
