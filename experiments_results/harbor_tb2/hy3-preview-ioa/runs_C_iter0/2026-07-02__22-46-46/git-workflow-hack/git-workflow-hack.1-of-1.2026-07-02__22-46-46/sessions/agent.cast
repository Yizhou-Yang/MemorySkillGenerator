[431.597647, "i", "cat > public/blog.html <<'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Blog — Dr. Lydia Moreno</title>\n<link rel=\"stylesheet\" href=\"assets/styles.css\">\n</head>\n<body>\n<header>\n  <div class=\"header-inner\">\n    <h1>Dr. Lydia Moreno</h1>\n    <div class=\"tagline\">Associate Professor of Computational Neuroscience, Riverbend University</div>\n  </div>\n  <nav>\n    <a href=\"index.html\">About Me</a>\n    <a href=\"blog.html\" class=\"active\">Blog</a>\n    <a href=\"publications.html\">Publications</a>\n  </nav>\n</header>\n<main>\n  <h2>Latest Posts</h2>\n  <div class=\"card\"><strong>March 2025</strong><br>Building Interpretable Deep Learning Models for Neuroscience</div>\n  <div class=\"card\"><strong>January 2025</strong><br>Bridging Machine Learning and Single-Cell Genomics</div>\n  <div class=\"card\"><strong>November 2024</strong><br>Scaling Graph Neural Networks for Connectomics</div>\n"]
[431.599713, "i", "</main>\n<footer>© 2025 Dr. Lydia Moreno.</footer>\n</body>\n</html>\nEOF\n"]
