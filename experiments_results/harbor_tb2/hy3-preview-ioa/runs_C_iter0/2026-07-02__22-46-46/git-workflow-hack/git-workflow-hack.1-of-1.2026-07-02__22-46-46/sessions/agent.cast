[431.259913, "o", "\u001b[?2004hroot@5b966c112c97:/app/my_website# "]
[431.373808, "i", "cat > public/index.html <<'EOF'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Dr. Lydia Moreno — Research Profile</title>\n<link rel=\"stylesheet\" href=\"assets/styles.css\">\n</head>\n<body>\n<header>\n  <div class=\"header-inner\">\n    <h1>Dr. Lydia Moreno</h1>\n    <div class=\"tagline\">Associate Professor of Computational Neuroscience, Riverbend University</div>\n  </div>\n  <nav>\n    <a href=\"index.html\" class=\"active\">About Me</a>\n    <a href=\"blog.html\">Blog</a>\n    <a href=\"publications.html\">Publications</a>\n  </nav>\n</header>\n<main>\n  <section>\n    <h2>About</h2>\n    <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University's School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n  </section>\n  <section>\n    <h2>Education</h2>\n    <div class=\"card\"><strong>Ph.D., Computational Biology</strong> — Baywood Institute of Technology, 2014–2019<br>Dissertation: \"Deep Learning Models for Decoding Neural Population Activity\"</div>\n    <div class=\"card\"><strong>M.Sc., Bioinformatics</strong> — Riverbend University, 2012–2014<br>Thesis: \"Statistical Methods for Single-Cell RNA-Seq Analysis\"</div>\n    <div class=\"card\"><strong>B.Sc., Computer Science</strong> — Crestfield College of Engineering, 2008–2012<br>Graduated magna cum laude; President, Data Science Club</div>\n  </section>\n  <section>\n    <h2>Research Interests</h2>\n    <ul>\n      <li><strong>Neural Encoding &amp; Decoding</strong> — interpretable models translating spike-train data into behavioral predictions.</li>\n      <li><strong>Machine Learning for Biomedical Imaging</strong> — CNNs and GNNs applied to MRI and two-photon microscopy.</li>\n      <li><strong>Single-Cell Omics</strong> — scalable pipelines integrating multi-modal single-cell genomics and spatial transcriptomics.</li>\n      <li><strong>Explainable AI in Neuroscience</strong> — probing decision boundaries and feature attributions in black-box models.</li>\n    </ul>\n  </section>\n  <section>\n    <h2>Selected Projects</h2>\n    <div class=\"card\"><strong>DeepVision: High-Resolution Neural Activity Mapping</strong><br>Lead Developer &amp; Project Coordinator. PyTorch-based pipeline to segment two-photon images of mouse visual cortex; TCNs predict stimulus orientation from calcium traces; Dockerized microservice deployed with Cascade Imaging Lab.</div>\n    <div class=\"card\"><strong>NeuroGraph: Graph Neural Networks for Circuit Analysis</strong><br>Principal Investigator. Graph representations of reconstructed neuron meshes from EM; GNNs classify synapses and infer connectivity motifs. Open-source toolkit adopted by 12 labs.</div>\n    <div class=\"card\"><strong>CellMap: Multi-Modal Single-Cell Atlas</strong><br>Co-Principal Investigator. Nextflow workflow combining scRNA-Seq, ATAC-Seq, and spatial FISH; Bayesian clustering of human cortical organoids.</div>\n  </section>\n  <section>\n    <h2>Skills &amp; Tools</h2>\n    <p><strong>Languages:</strong> Python, R, C++ &nbsp;|&nbsp; <strong>Frameworks:</strong> PyTorch, TensorFlow, scikit-learn, NetworkX &nbsp;|&nbsp; <strong>Data Tools:</strong> Nextflow, Snakemake, Docker, Kubernetes</p>\n  </section>\n  <section>\n    <h2>Contact</h2>\n    <ul>\n      <li>Email: lydia.moreno@riverbend.edu</li>\n      <li>Office: Blakely Hall, Room 312, Riverbend University</li>\n      <li>Twitter: <a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></li>\n      <li>GitHub: <a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></li>\n    </ul>\n  </section>\n</main>\n<footer>© 2025 Dr. Lydia Moreno. Generated from info.md.</footer>\n</body>\n</html>\nEOF\n"]
