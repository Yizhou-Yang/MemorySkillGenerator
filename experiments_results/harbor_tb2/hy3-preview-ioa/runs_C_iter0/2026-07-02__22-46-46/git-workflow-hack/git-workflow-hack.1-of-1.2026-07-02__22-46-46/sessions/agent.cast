[443.296312, "i", "cat > .github/workflows/deploy.yml <<'EOF'\nname: Deploy Site\non:\n  push:\n    branches:\n      - main\n  workflow_dispatch:\n\n# Least-privilege: only what is needed to publish GitHub Pages.\npermissions:\n  contents: write\n\njobs:\n  deploy:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Check out repository\n        uses: actions/checkout@v4\n\n      - name: Deploy to GitHub Pages\n        uses: peaceiris/actions-gh-pages@v4\n        with:\n          github_token: ${{ secrets.GITHUB_TOKEN }}\n          publish_dir: ./public\n          publish_branch: gh-pages\nEOF\n"]
