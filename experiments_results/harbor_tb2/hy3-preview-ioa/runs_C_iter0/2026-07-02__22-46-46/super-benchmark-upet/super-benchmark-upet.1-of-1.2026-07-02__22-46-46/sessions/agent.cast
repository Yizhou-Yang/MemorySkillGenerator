[2768.904501, "o", "14:def random_sampling(raw_datasets: load_dataset, data_type: str=\"train\", num_examples_per_label: Optional[int]=16):\r\n36:task_to_test_key = {\r\n47:task_to_keys = {\r\n58:task_to_template = {\r\n70:label_words_mapping = {\r\n77:logger = logging.getLogger(__name__)\r\n90:        raw_datasets = load_dataset(\"super_glue\", data_args.dataset_name)\r\n229:        self.metric = load_metric(\"./metrics/super_glue\", data_args.dataset_name)\r\n355:            from sklearn.metrics import f1_score\r\n369:        from tasks.superglue.utils import f1_score, exact_match_score, metric_max_over_ground_truths\r\n"]
