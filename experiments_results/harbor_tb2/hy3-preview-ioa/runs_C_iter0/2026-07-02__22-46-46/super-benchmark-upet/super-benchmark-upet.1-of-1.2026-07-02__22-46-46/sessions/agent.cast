[2394.76308, "o", "# Copyright 2020 The HuggingFace Team. All rights reserved."]
[2394.763465, "o", "\r\n"]
[2394.763659, "o", "#"]
[2394.763826, "o", "\r\n"]
[2394.764089, "o", "# Licensed under the Apache License, Version 2.0 (the \"License\");"]
[2394.764688, "o", "\r\n"]
[2394.764872, "o", "# you may not use this file except in compliance with the License."]
[2394.765058, "o", "\r\n"]
[2394.765231, "o", "# You may obtain a copy of the License at"]
[2394.765426, "o", "\r\n"]
[2394.7656, "o", "#"]
[2394.765767, "o", "\r\n"]
[2394.765959, "o", "#     http://www.apache.org/licenses/LICENSE-2.0"]
[2394.766127, "o", "\r\n"]
[2394.766296, "o", "#"]
[2394.766484, "o", "\r\n"]
[2394.766679, "o", "# Unless required by applicable law or agreed to in writing, software"]
[2394.766857, "o", "\r\n"]
[2394.767066, "o", "# distributed under the License is distributed on an \"AS IS\" BASIS,"]
[2394.767577, "o", "\r\n"]
[2394.767757, "o", "# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied."]
[2394.767946, "o", "\r\n"]
[2394.768119, "o", "# See the License for the specific language governing permissions and"]
[2394.768299, "o", "\r\n"]
[2394.768497, "o", "# limitations under the License."]
[2394.76867, "o", "\r\n"]
[2394.768844, "o", "\r\n"]
[2394.769039, "o", "# ***********"]
[2394.769212, "o", "\r\n"]
[2394.769408, "o", "# `huggingface_hub` init has 2 modes:"]
[2394.76958, "o", "\r\n"]
[2394.769756, "o", "# - Normal usage:"]
[2394.769946, "o", "\r\n"]
[2394.770123, "o", "#       If imported to use it, all modules and functions are lazy-loaded. This means"]
[2394.772646, "o", "\r\n"]
[2394.776026, "o", "#       they exist at top level in module but are imported only the first time they are"]
[2394.777097, "o", "\r\n"]
[2394.783092, "o", "#       used. This way, `from huggingface_hub import something` will import `something`"]
[2394.783474, "o", "\r\n"]
[2394.78367, "o", "#       quickly without the hassle of importing all the features from `huggingface_hub`."]
[2394.783853, "o", "\r\n"]
[2394.784057, "o", "# - Static check:"]
[2394.78424, "o", "\r\n"]
[2394.790729, "o", "#       If statically analyzed, all modules and functions are loaded normally. This way"]
[2394.791119, "o", "\r\n"]
[2394.791404, "o", "#       static typing check works properly as well as autocomplete in text editors and"]
[2394.791573, "o", "\r\n"]
[2394.791762, "o", "#       IDEs."]
[2394.791945, "o", "\r\n"]
[2394.792114, "o", "#"]
[2394.79228, "o", "\r\n"]
[2394.792479, "o", "# The static model imports are done inside the `if TYPE_CHECKING:` statement at"]
[2394.792647, "o", "\r\n"]
[2394.793842, "o", "# the bottom of this file. Since module/functions imports are duplicated, it is"]
[2394.794033, "o", "\r\n"]
[2394.794204, "o", "# mandatory to make sure to add them twice when adding one. This is checked in the"]
[2394.794396, "o", "\r\n"]
[2394.797896, "o", "# `make quality` command."]
[2394.798418, "o", "\r\n"]
[2394.798716, "o", "    def __getattr__(name):"]
[2394.798885, "o", "\r\n"]
[2394.799081, "o", "        if name in submodules:"]
[2394.799284, "o", "\r\n"]
[2394.799482, "o", "            return importlib.import_module(f\"{package_name}.{name}\")"]
[2394.800237, "o", "\r\n"]
[2394.800436, "o", "        elif name in attr_to_modules:"]
[2394.801173, "o", "\r\n"]
[2394.80157, "o", "            submod_path = f\"{package_name}.{attr_to_modules[name]}\""]
[2394.802344, "o", "\r\n"]
[2394.803148, "o", "            submod = importlib.import_module(submod_path)"]
[2394.804978, "o", "\r\n"]
[2394.80818, "o", "            attr = getattr(submod, name)"]
[2394.815727, "o", "\r\n"]
[2394.819515, "o", "\r\n"]
[2394.820063, "o", "            # If the attribute lives in a file (module) with the same"]
[2394.820421, "o", "\r\n"]
[2394.830643, "o", "            # name as the attribute, ensure that the attribute and *not*"]
[2394.831029, "o", "\r\n            # the module is accessible on the package.\r\n            if name == attr_to_modules[name]:\r\n                pkg = sys.modules[package_name]\r\n                pkg.__dict__[name] = attr\r\n\r\n            return attr\r\n"]
[2394.833276, "m", "Episode 61: 2 commands"]
[2394.833276, "o", "\u001b[?2004hroot@2623c8c1b420:/app/UPET# "]
[2416.103054, "i", "python3 - <<'EOF'\np='/usr/local/lib/python3.10/site-packages/huggingface_hub/__init__.py'\ns=open(p).read()\nold='    def __getattr__(name):\\n        if name in submodules:'\nnew='    def __getattr__(name):\\n        if name == \"hf_api\":\\n            return importlib.import_module(\"huggingface_hub.hf_api\")\\n        if name in submodules:'\nassert old in s, 'pattern not found'\ns=s.replace(old,new,1)\nopen(p,'w').write(s)\nprint('patched huggingface_hub __init__')\nEOF\n"]
[2416.104453, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> p='/usr/local/lib/python3.10/site-packages/huggingface_hub/__init__.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> old='    def __getattr__(name):\\n        if name in submodules:'\r\n\u001b[?2004l\r\u001b[?2004h> new='    def __getattr__(name):\\n        if name == \"hf_api\":\\n            return importlib.import_module(\"huggingface_hub.hf_api\")\\n        if name in submodules:'\r\n\u001b[?2004l\r\u001b[?2004h> assert old in s, 'pattern not found'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2416.106469, "o", "s=s.replace(old,new,1)\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)"]
[2416.106866, "o", "\r\n"]
