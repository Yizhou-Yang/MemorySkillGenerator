[446.142509, "i", "cat > /app/mkparquet.py << 'PYEOF'\nimport csv, struct\n\ndef write_varint(buf, n):\n    while True:\n        b = n & 0x7f\n        n >>= 7\n        if n:\n            buf.append(b | 0x80)\n        else:\n            buf.append(b)\n            break\n\ndef zigzag(n):\n    return (n << 1) ^ (n >> 63)\n\ndef wb(buf, b):\n    write_varint(buf, len(b))\n    buf.extend(b)\n\nclass TStruct:\n    def __init__(self):\n        self.buf = bytearray()\n        self.last = 0\n    def _hdr(self, fid, ftype):\n        d = fid - self.last\n        if 1 <= d <= 15:\n            self.buf.append((d << 4) | ftype)\n        else:\n            self.buf.append(ftype)\n            write_varint(self.buf, zigzag(fid))\n        self.last = fid\n    def i32(self, fid, v):\n        self._hdr(fid, 5); write_varint(self.buf, zigzag(v))\n    def i64(self, fid, v):\n        self._hdr(fid, 6); write_varint(self.buf, zigzag(v))\n    def binary(self, fid, b):\n        self._hdr(fid, 8); write_varint(self.buf, len(b)); self.buf.extend(b)\n    def string(self, fid, s):\n        self.binary(fid, s.encode('utf-8'))\n    def struct(self, fid, b):\n        self._hdr(fid, 12); self.buf.extend(b)\n    def list(self, fid, etype, items, wfn):\n        self._hdr(fid, 9)\n        n = len(items)\n        if n < 15:\n            self.buf.append((n << 4) | etype)\n        else:\n            self.buf.append((15 << 4) | etype)\n            write_varint(self.buf, n)\n        for it in items:\n            wfn(self.buf, it)\n    def finish(self):\n        self.buf.append(0x00)\n        return bytes(self.buf)\n\ndef infer_type(vals):\n    for v in vals:\n        if v == '':\n            continue\n        try:\n            int(v)\n        except ValueError:\n            return 'BYTE_ARRAY'\n    return 'INT32'\n\ndef main():\n    with open('/app/data.csv', newline='') as f:\n        rows = list(csv.reader(f))\n    header = rows[0]\n    data = rows[1:]\n    n = len(data)\n    cols = []\n    for i, name in enumerate(header):\n        vals = [r[i] for r in data]\n        cols.append((name, infer_type(vals), vals))\n\n    out = bytearray(b'PAR1')\n    recs = []\n    off = 4\n    for (name, t, vals) in cols:\n        if t == 'INT32':\n            page_data = b''.join(struct.pack('<i', int(v)) for v in vals)\n        else:\n            page_data = b''.join(struct.pack('<I', len(v.encode('utf-8'))) + v.encode('utf-8') for v in vals)\n        dph = TStruct(); dph.i32(1, n); dph.i32(2, 0); dph.i32(3, 3); dph.i32(4, 3)\n        dph_b = dph.finish()\n        ph = TStruct(); ph.i32(1, 0); ph.i32(2, len(page_data)); ph.i32(3, len(page_data)); ph.struct(5, dph_b)\n        ph_b = ph.finish()\n        chunk = ph_b + page_data\n        recs.append((name, t, off, ph_b, page_data))\n        out.extend(chunk); off += len(chunk)\n\n    tc = {'INT32': 1, 'BYTE_ARRAY': 6}\n    col_chunk = []\n    total = 0\n    for (name, t, data_page_offset, ph_b, page_data) in recs:\n        ct = len(ph_b) + len(page_data); total += ct\n        cm = TStruct()\n        cm.i32(1, tc[t])\n        cm.list(2, 5, [0, 3], lambda buf, e: write_varint(buf, zigzag(e)))\n        cm.list(3, 8, [name], lambda buf, p: wb(buf, p.encode('utf-8')))\n        cm.i32(4, 0)\n        cm.i64(5, n); cm.i64(6, ct); cm.i64(7, ct); cm.i64(9, data_page_offset)\n        cm_b = cm.finish()\n        cc = TStruct(); cc.string(1, ''); cc.i64(2, data_page_offset); cc.struct(3, cm_b)\n        col_chunk.append(cc.finish())\n\n    rg = TStruct()\n    rg.list(1, 12, col_chunk, lambda buf, b: buf.extend(b))\n    rg.i64(2, total); rg.i64(3, n); rg.i64(5, recs[0][2]); rg.i64(6, total)\n    rg_b = rg.finish()\n\n    sb = []\n    root = TStruct(); root.string(1, 'schema'); root.i32(4, 0); root.i32(5, len(cols))\n    sb.append(root.finish())\n    for (name, t, vals) in cols:\n        s = TStruct(); s.string(1, name); s.i32(2, tc[t]); s.i32(4, 0)\n        if t == 'BYTE_ARRAY':\n            s.i32(6, 0)\n        sb.append(s.finish())\n\n    fm = TStruct(); fm.i32(1, 1)\n    fm.list(2, 12, sb, lambda buf, b: buf.extend(b))\n    fm.i64(3, n); fm.list(4, 12, [rg_b], lambda buf, b: buf.extend(b))\n    fm.string(6, 'pure-python-parquet-writer')\n    footer = fm.finish()\n\n    out.extend(fo"]
[446.142575, "i", "oter)\n    out.extend(struct.pack('<I', len(footer)))\n    out.extend(b'PAR1')\n    with open('/app/data.parquet', 'wb') as f:\n        f.write(out)\n    print('wrote', len(out), 'bytes; footer', len(footer))\n\nmain()\nPYEOF\n"]
