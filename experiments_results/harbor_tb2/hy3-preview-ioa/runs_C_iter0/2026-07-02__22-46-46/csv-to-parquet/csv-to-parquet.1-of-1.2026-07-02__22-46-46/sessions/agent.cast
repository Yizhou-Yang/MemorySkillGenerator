[486.333486, "o", "\u001b[?2004hroot@6ebe3529d47e:/app# "]
[539.827335, "i", "cat > /app/verify2.py << 'PYEOF'\nimport struct, csv\n\ndef rd_varint(b, i):\n    shift=0; val=0\n    while True:\n        x=b[i]; i+=1\n        val |= (x & 0x7f) << shift\n        if not (x & 0x80): break\n        shift += 7\n    return val, i\n\ndef zz(n):\n    return (n >> 1) ^ -(n & 1)\n\ndef parse_struct(b, i):\n    fields={}; prev=0\n    while i < len(b):\n        t=b[i]; i+=1\n        if t==0: break\n        ft=t&0x0f; did=t>>4\n        if did==0:\n            fv,i=rd_varint(b,i); fid=zz(fv)\n        else:\n            fid=prev+did\n        prev=fid\n        if ft in (5,6):\n            v,i=rd_varint(b,i); fields[fid]=zz(v)\n        elif ft==8:\n            ln,i=rd_varint(b,i); fields[fid]=b[i:i+ln]; i+=ln\n        elif ft==9:\n            h=b[i]; i+=1\n            if (h>>4)==15:\n                cnt,i=rd_varint(b,i)\n            else:\n                cnt=h>>4\n            et=h&0x0f\n            items=[]\n            for _ in range(cnt):\n                if et in (5,6):\n                    v,i=rd_varint(b,i); items.append(zz(v))\n                elif et==8:\n                    ln,i=rd_varint(b,i); items.append(b[i:i+ln]); i+=ln\n                elif et==12:\n                    sub,i=parse_struct(b,i); items.append(sub)\n                else:\n                    raise ValueError('unhandled list et %d'%et)\n            fields[fid]=items\n        elif ft==12:\n            sub,i=parse_struct(b,i); fields[fid]=sub\n        else:\n            raise ValueError('unhandled ft %d'%ft)\n    return fields, i\n\nwith open('/app/data.csv','rb') as f:\n    raw=f.read()\nassert raw[:4]==b'PAR1' and raw[-4:]==b'PAR1'\nflen=struct.unpack('<I', raw[-8:-4])[0]\nfooter=raw[-8-flen:-8]\nfm,_=parse_struct(footer,0)\nnum_rows=fm[3]\nprint('num_rows =', num_rows, ' version =', fm[1])\nschema_list=fm[2]  # list of SchemaElement structs (pre-order)\ncols=[]\nfor el in schema_list[1:]:  # skip root\n    name=el[1].decode(); typ=el[2]; cols.append((name,typ))\nprint('columns:', [(n, {1:'INT32',6:'BYTE_ARRAY'}.get(t,str(t))) for n,t in cols])\n\n# read CSV expected\nwith open('/app/data.csv', newline='') as f:\n    rows=list(csv.reader(f))\nhdr=rows[0]; data=rows[1:]\nassert len(data)==num_rows, 'row count mismatch'\n\ntc={1:'INT32',6:'BYTE_ARRAY'}\nrgs=fm[4]\nok=True\nfor rg in rgs:\n    ccs=rg[1]  # list of ColumnChunk\n    for ci,cc in enumerate(ccs):\n        cm=cc[3]  # ColumnMetaData\n        typ=cm[1]; offset=cm[9]; path=cm[3][0].decode()\n        ph,pos=parse_struct(raw, offset)\n        ptype=ph[1]; upsz=ph[2]; cpsz=ph[3]\n        dph=ph[5]; nv=dph[1]; enc=dph[2]\n        pdata=raw[pos:pos+cpsz]\n        if typ==1:\n            vals=[struct.unpack('<i', pdata[k:k+4])[0] for k in range(0,len(pdata),4)]\n        elif typ==6:\n            vals=[]; k=0\n            while k<len(pdata):\n                ln=struct.unpack('<I', pdata[k:k+4])[0]; k+=4\n                vals.append(pdata[k:k+ln].decode()); k+=ln\n        else:\n            raise ValueError('type')\n        expected=[ (int(r[ci]) if typ==1 else r[ci]) for r in data ]\n        match = vals == expected\n        ok = ok and match\n        print('col %-12s type=%s enc=%d nv=%d match=%s'%(path, tc[typ], enc, nv, match))\n        if not match:\n            print('  got   ', vals)\n            print('  expect', expected)\nprint('RESULT:', 'ALL MATCH' if ok else 'MISMATCH')\nPYEOF\n"]
[539.841963, "o", "cat > /app/verify2.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct, csv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def rd_varint(b, i):\r\n\u001b[?2004l\r\u001b[?2004h>     shift=0; val=0\r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\n\u001b[?2004l\r\u001b[?2004h>         x=b[i]; i+=1\r\n\u001b[?2004l\r\u001b[?2004h>         val |= (x & 0x7f) << shift\r\n\u001b[?2004l\r\u001b[?2004h>         if not (x & 0x80): break\r\n\u001b[?2004l\r\u001b[?2004h>         shift += 7\r\n\u001b[?2004l\r\u001b[?2004h>     return val, i\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def zz(n):\r\n\u001b[?2004l\r\u001b[?2004h>     return (n >> 1) ^ -(n & 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse_struct(b, i):\r\n\u001b[?2004l\r\u001b[?2004h>     fields={}; prev=0\r\n\u001b[?2004l\r\u001b[?2004h>     while i < len(b):\r\n\u001b[?2004l\r\u001b[?2004h>         t=b[i]; i+=1\r\n\u001b[?2004l\r\u001b[?2004h>         if t==0: break\r\n\u001b[?2004l\r\u001b[?2004h>         ft=t&0x0f; did=t>>4\r\n\u001b[?2004l\r\u001b[?2004h>         if did==0:\r\n\u001b[?2004l\r\u001b[?2004h>             fv,i=rd_varint(b,i); fid=zz(fv)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             fid=prev+did\r\n\u001b[?2004l\r\u001b[?2004h>         prev=fid\r\n\u001b[?2004l\r\u001b[?2004h>         if ft in (5,6):\r\n\u001b[?2004l\r\u001b[?2004h>             v,i=rd_varint(b,i); fields[fid]=zz(v)\r\n\u001b[?2004l\r\u001b[?2004h>         elif ft==8:\r\n\u001b[?2004l\r\u001b[?2004h>             ln,i=rd_varint(b,i); fields[fid]=b[i:i+ln]; i+=ln\r\n\u001b[?2004l\r\u001b[?2004h>         elif ft==9:\r\n\u001b[?2004l\r\u001b[?2004h>             h=b[i]; i+=1\r\n\u001b[?2004l\r\u001b[?2004h>             if (h>>4)==15:\r\n\u001b[?2004l\r\u001b[?2004h>                 cnt,i=rd_varint(b,i)\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 cnt=h>>4\r\n\u001b[?2004l\r\u001b[?2004h>             et=h&0x0f\r\n\u001b[?2004l\r\u001b[?2004h>             items=[]\r\n\u001b[?2004l\r\u001b[?2004h>             for _ in range(cnt):\r\n\u001b[?2004l\r\u001b[?2004h>                 if et in (5,6):\r\n\u001b[?2004l\r\u001b[?2004h>                     v,i=rd_varint(b,i); items.append(zz(v))\r\n\u001b[?2004l\r\u001b[?2004h>                 elif et==8:\r\n\u001b[?2004l\r\u001b[?2004h>                     ln,i=rd_varint(b,i); items.append(b[i:i+ln]); i+=ln\r\n\u001b[?2004l\r\u001b[?2004h>                 elif et==12:\r\n\u001b[?2004l\r\u001b[?2004h>                     sub,i=parse_struct(b,i); items.append(sub)\r\n\u001b[?2004l\r\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h>                     raise ValueError('unhandled list et %d'%et)\r\n\u001b[?2004l\r\u001b[?2004h>             fields[fid]=items\r\n\u001b[?2004l\r\u001b[?2004h>         elif ft==12:\r\n\u001b[?2004l\r\u001b[?2004h>             sub,i=parse_struct(b,i); fields[fid]=sub\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError('unhandled ft %d'%ft)\r\n\u001b[?2004l\r\u001b[?2004h>     return fields, i\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/data.csv','rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     raw=f.read()\r\n\u001b[?2004l\r\u001b[?2004h> assert raw[:4]==b'PAR1' and raw[-4:]==b'PAR1'\r\n\u001b[?2004l\r\u001b[?2004h> flen=struct.unpack('<I', raw[-8:-4])[0]\r\n\u001b[?2004l\r\u001b[?2004h> footer=raw[-8-flen:-8]\r\n\u001b[?2004l\r\u001b[?2004h> fm,_=parse_struct(footer,0)\r\n\u001b[?2004l\r\u001b[?2004h> num_rows=fm[3]\r\n\u001b[?2004l\r\u001b[?2004h> print('num_rows =', num_rows, ' version =', fm[1])\r\n\u001b[?2004l\r\u001b[?2004h> schema_list=fm[2]  # list of SchemaElement structs (pre-order)\r\n\u001b[?2004l\r\u001b[?2004h> cols=[]\r\n\u001b[?2004l\r\u001b[?2004h> for el in schema_list[1:]:  # skip root\r\n\u001b[?2004l\r\u001b[?2004h>     name=el[1].decode(); typ=el[2]; cols.append((name,typ))\r\n\u001b[?2004l\r\u001b[?2004h> print('columns:', [(n, {1:'INT32',6:'BYTE_ARRAY'}.get(t,str(t))) for n,t in cols])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # read CSV expected\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/data.csv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     rows=list(csv.reader(f))\r\n\u001b[?2004l\r\u001b[?2004h> hdr=rows[0]; data=rows[1:]\r\n\u001b[?2004l\r\u001b[?2004h> assert len(data)==num_rows, 'row count mismatch'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> tc={1:'INT32',6:'BYTE_ARRAY'}\r\n\u001b[?2004l\r\u001b[?2004h> rgs=fm[4]\r\n\u001b[?2004l\r\u001b[?2004h> ok=True\r\n\u001b[?2004l\r\u001b[?2004h> for rg in rgs:\r\n\u001b[?2004l\r\u001b[?2004h>     ccs=rg[1]  # list of ColumnChunk\r\n\u001b[?2004l\r\u001b[?2004h>     for ci,cc in enumerate(ccs):\r\n\u001b[?2004l\r\u001b[?2004h>         cm=cc[3]  # ColumnMetaData\r\n\u001b[?2004l\r\u001b[?2004h>         typ=cm[1]; offset=cm[9]; path=cm[3][0].decode()\r\n\u001b[?2004l\r\u001b[?2004h>         ph,pos=parse_struct(raw, offset)\r\n\u001b[?2004l\r\u001b[?2004h>    "]
[539.842164, "o", "     ptype=ph[1]; upsz=ph[2]; cpsz=ph[3]\r\n\u001b[?2004l\r\u001b[?2004h>         dph=ph[5]; nv=dph[1]; enc=dph[2]\r\n\u001b[?2004l\r\u001b[?2004h>         pdata=raw[pos:pos+cpsz]\r\n\u001b[?2004l\r\u001b[?2004h>         if typ==1:\r\n\u001b[?2004l\r\u001b[?2004h>             vals=[struct.unpack('<i', pdata[k:k+4])[0] for k in range(0,len(pdata),4)]\r\n\u001b[?2004l\r\u001b[?2004h>         elif typ==6:\r\n\u001b[?2004l\r\u001b[?2004h>             vals=[]; k=0\r\n\u001b[?2004l\r\u001b[?2004h>             while k<len(pdata):\r\n\u001b[?2004l\r\u001b[?2004h>                 ln=struct.unpack('<I', pdata[k:k+4])[0]; k+=4\r\n\u001b[?2004l\r\u001b[?2004h>                 vals.append(pdata[k:k+ln].decode()); k+=ln\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError('type')\r\n\u001b[?2004l\r\u001b[?2004h>         expected=[ (int(r[ci]) if typ==1 else r[ci]) for r in data ]\r\n\u001b[?2004l\r\u001b[?2004h>         match = vals == expected\r\n\u001b[?2004l\r\u001b[?2004h>         ok = ok and match\r\n\u001b[?2004l\r\u001b[?2004h>         print('col %-12s type=%s enc=%d nv=%d match=%s'%(path, tc[typ], enc, nv, match))\r\n\u001b[?2004l\r\u001b[?2004h>         if not match:\r\n\u001b[?2004l\r\u001b[?2004h>             print('  got   ', vals)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[539.842433, "o", "            print('  expect', expected)\r\n\u001b[?2004l\r\u001b[?2004h> "]
