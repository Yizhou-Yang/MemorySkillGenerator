[485.958687, "o", ">     if t == 0: return None, i\r\n\u001b[?2004l\r\u001b[?2004h>     ft = t & 0x0f; did = t >> 4\r\n\u001b[?2004l\r\u001b[?2004h>     if did == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         fid, i = rd_varint(b, i); fid = zigzag(fid)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         fid = None\r\n\u001b[?2004l\r\u001b[?2004h>     if ft in (5, 6):\r\n\u001b[?2004l\r\u001b[?2004h>         v, i = rd_varint(b, i); v = zigzag(v)\r\n\u001b[?2004l\r\u001b[?2004h>         return ('i', v), i\r\n\u001b[?2004l\r\u001b[?2004h>     if ft == 8:\r\n\u001b[?2004l\r\u001b[?2004h>         ln, i = rd_varint(b, i); s = b[i:i+ln]; i += ln\r\n\u001b[?2004l\r\u001b[?2004h>         return ('bin', s), i\r\n\u001b[?2004l\r\u001b[?2004h>     if ft == 9:\r\n\u001b[?2004l\r\u001b[?2004h>         h = b[i]; i += 1\r\n\u001b[?2004l\r\u001b[?2004h>         if h >> 4 == 15:\r\n\u001b[?2004l\r\u001b[?2004h>             cnt, i = rd_varint(b, i)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.961047, "o", "            cnt = h >> 4\r\n\u001b[?2004l\r\u001b[?2004h>         et = h & 0x0f\r\n\u001b[?2004l\r\u001b[?2004h>         for _ in range(cnt):\r\n\u001b[?2004l\r\u001b[?2004h>             i = skip(b, i)[1]\r\n\u001b[?2004l\r\u001b[?2004h>         return ('list', None), i\r\n\u001b[?2004l\r\u001b[?2004h>     if ft == 12:\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             v, i = skip(b, i)\r\n\u001b[?2004l\r\u001b[?2004h>             if v is None: break\r\n\u001b[?2004l\r\u001b[?2004h>         return ('struct', None), i\r\n\u001b[?2004l\r\u001b[?2004h>     raise ValueError('unknown type %d' % ft)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/data.parquet','rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> assert data[:4] == b'PAR1', 'bad head'\r\n\u001b[?2004l\r\u001b[?2004h> assert data[-4:] == b'PAR1', 'bad tail'\r\n\u001b[?2004l\r\u001b[?2004h> flen = struct.unpack('<I', data[-8:-4])[0]\r\n\u001b[?2004l\r\u001b[?2004h> footer = data[-8-flen:-8]\r\n\u001b[?2004l\r\u001b[?2004h> assert len(footer) == flen, 'footer len mismatch'\r\n\u001b[?2004l\r\u001b[?2004h> "]
