[485.927956, "i", "cat > /app/verify.py << 'PYEOF'\nimport struct\n\ndef rd_varint(b, i):\n    shift = 0; val = 0\n    while True:\n        x = b[i]; i += 1\n        val |= (x & 0x7f) << shift\n        if not (x & 0x80):\n            break\n        shift += 7\n    return val, i\n\ndef zigzag(n):\n    return (n >> 1) ^ -(n & 1)\n\ndef skip(b, i):\n    t = b[i]; i += 1\n    if t == 0: return None, i\n    ft = t & 0x0f; did = t >> 4\n    if did == 0:\n        fid, i = rd_varint(b, i); fid = zigzag(fid)\n    else:\n        fid = None\n    if ft in (5, 6):\n        v, i = rd_varint(b, i); v = zigzag(v)\n        return ('i', v), i\n    if ft == 8:\n        ln, i = rd_varint(b, i); s = b[i:i+ln]; i += ln\n        return ('bin', s), i\n    if ft == 9:\n        h = b[i]; i += 1\n        if h >> 4 == 15:\n            cnt, i = rd_varint(b, i)\n        else:\n            cnt = h >> 4\n        et = h & 0x0f\n        for _ in range(cnt):\n            i = skip(b, i)[1]\n        return ('list', None), i\n    if ft == 12:\n        while True:\n            v, i = skip(b, i)\n            if v is None: break\n        return ('struct', None), i\n    raise ValueError('unknown type %d' % ft)\n\nwith open('/app/data.parquet','rb') as f:\n    data = f.read()\nassert data[:4] == b'PAR1', 'bad head'\nassert data[-4:] == b'PAR1', 'bad tail'\nflen = struct.unpack('<I', data[-8:-4])[0]\nfooter = data[-8-flen:-8]\nassert len(footer) == flen, 'footer len mismatch'\n# parse FileMetaData: f1 version i32, f2 schema list<struct>, f3 num_rows i64\nfields = {}\nprev = 0; i = 0\nwhile True:\n    v, i = skip(footer, i)\n    if v is None: break\n    # need field id tracking; redo parse with ids\n    break\n\n# simpler: walk with field ids\ni = 0; prev = 0\nwhile i < len(footer):\n    t = footer[i]; i += 1\n    if t == 0: break\n    ft = t & 0x0f; did = t >> 4\n    if did == 0:\n        fidv, i = rd_varint(footer, i); fid = zigzag(fidv)\n    else:\n        fid = prev + did\n    prev = fid\n    if ft in (5,6):\n        v, i = rd_varint(footer, i); v = zigzag(v)\n        if fid == 3: print('num_rows =', v)\n        if fid == 1: print('version =', v)\n    elif ft == 8:\n        ln, i = rd_varint(footer, i); i += ln\n    elif ft == 9:\n        h = footer[i]; i += 1\n        if h>>4 == 15: cnt, i = rd_varint(footer, i)\n        else: cnt = h>>4\n        et = h & 0x0f\n        if fid == 2:\n            children = cnt; print('schema children =', cnt)\n        for _ in range(cnt):\n            i = skip(footer, i)[1]\n    elif ft == 12:\n        while True:\n            v, i = skip(footer, i)\n            if v is None: break\nprint('OK: valid Parquet footer parsed')\nPYEOF\n"]
