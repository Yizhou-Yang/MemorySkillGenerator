[636.93779, "i", "cat > /tmp/extract2.py <<'EOF'\nimport struct\nISO='/app/alpine.iso'; SECTOR=2048\nf=open(ISO,'rb'); f.seek(16*SECTOR)\npvd=f.read(SECTOR); root_dr=pvd[156:190]\ndef parse_dr(dr):\n    return (struct.unpack('<I',dr[2:6])[0], struct.unpack('<I',dr[10:14])[0], dr[25], dr[33:33+dr[32]])\nwanted=['vmlinuz-lts','intel-ucode.img','amd-ucode.img','initramfs-lts']\ngot={}\ndef walk(extent,length,path=''):\n    f.seek(extent*SECTOR); data=f.read(length); off=0\n    while off<len(data):\n        rl=data[off]\n        if rl==0:\n            off=(off//SECTOR+1)*SECTOR; continue\n        e,d,fl,nm=parse_dr(data[off:off+rl])\n        if nm in (b'\\x00',b'\\x01'):\n            off+=rl; continue\n        nm=nm.split(b';')[0].decode('latin1'); full=(path+'/'+nm) if path else nm\n        if fl&2: walk(e,d,full)\n        else:\n            if nm.lower() in wanted: got[nm]=(e,d)\n        off+=rl\next,dl,fl,nm=parse_dr(root_dr); walk(ext,dl)\nfor nm in wanted:\n    if nm in got:\n        e,d=got[nm]; f.seek(e*SECTOR); data=f.read(d)\n        open('/tmp/'+nm,"]
[636.93786, "o", "cat > /tmp/extract2.py <<'EOF'"]
[636.938427, "i", "'wb').write(data)\n        print('OK', nm, d, 'bytes')\n    else:\n        print('MISSING', nm)\nEOF\n"]
