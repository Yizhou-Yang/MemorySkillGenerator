[605.476853, "o", "BOOT EFI/BOOT/BOOTX64.EFI 688128\r\n=== CFG FILES ===\r\n"]
[605.477381, "o", "--- BOOT/GRUB/GRUB.CFG ---"]
[605.477556, "o", "\r\n"]
[605.477756, "o", "set timeout=1"]
[605.477965, "o", "\r\n"]
[605.478109, "o", "\r\n"]
[605.478244, "o", "menuentry \"Linux lts\" {"]
[605.478531, "o", "\r\n"]
[605.478672, "o", "linux"]
[605.47886, "o", "\t"]
[605.479025, "o", "/boot/vmlinuz-lts modules=loop,squashfs,sd-mod,usb-storage quiet "]
[605.479239, "o", "\r\n"]
[605.479431, "o", "initrd"]
[605.479671, "o", "\t/boot/intel-ucode.img /boot/amd-ucode.img /boot/initramfs-lts\r\n}\r\n\r\n"]
[605.512987, "o", "--- BOOT/SYSLINUX/SYSLINUX.CFG ---\r\nTIMEOUT 10\r\nPROMPT 1\r\nDEFAULT lts\r\n\r\nLABEL lts\r\nMENU LABEL Linux lts\r\nKERNEL /boot/vmlinuz-lts\r\nINITRD /boot/intel-ucode.img,/boot/amd-ucode.img,/boot/initramfs-lts\r\nFDTDIR /boot/dtbs-lts\r\nAPPEND modules=loop,squashfs,sd-mod,usb-storage quiet \r\n\r\n"]
[605.530469, "o", "\u001b[?2004h"]
