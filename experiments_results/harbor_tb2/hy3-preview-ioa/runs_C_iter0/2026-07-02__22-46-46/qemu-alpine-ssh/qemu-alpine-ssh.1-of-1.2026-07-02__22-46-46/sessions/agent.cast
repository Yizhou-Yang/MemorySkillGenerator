[663.769229, "i", "cat > /tmp/dbg.py <<'EOF'\nimport struct\nISO='/app/alpine.iso'; SECTOR=2048\nf=open(ISO,'rb')\n# print volume descriptors\ntype=0\nfor i in range(16,32):\n    f.seek(i*SECTOR); h=f.read(SECTOR)\n    t=h[0]\n    if t==0: break\n    if t==1: print('PVD at',i)\n    elif t==2: print('SVD(joliet?) at',i)\n    elif t==255: print('Terminator at',i)\n    else: print('type',t,'at',i)\nf.seek(16*SECTOR); pvd=f.read(SECTOR); root=pvd[156:190]\ndef pr(dr): return (struct.unpack('<I',dr[2:6])[0],struct.unpack('<I',dr[10:14])[0],dr[25],dr[33:33+dr[32]])\ndef walk(ext,length,path,depth=0):\n    if depth>20: return\n    f.seek(ext*SECTOR); data=f.read(length); off=0; n=0\n    while off<len(data):\n        rl=data[off]\n        if rl==0: off=(off//SECTOR+1)*SECTOR; continue\n        e,d,fl,nm=pr(data[off:off+rl])\n        if nm in (b'\\x00',b'\\x01'): off+=rl; continue\n        nm=nm.split(b';')[0].decode('latin1'); full=(path+'/'+nm) if path else nm\n        if fl&2: walk(e,d,full,depth+1)\n        else: print('F',full,d)\n        off+=rl; n+=1\n    ret"]
[663.76966, "i", "urn n\next,dl,fl,nm=pr(root); print('root ext',ext,'len',dl)\nprint('entries in root:', walk(ext,dl,''))\nEOF\n"]
