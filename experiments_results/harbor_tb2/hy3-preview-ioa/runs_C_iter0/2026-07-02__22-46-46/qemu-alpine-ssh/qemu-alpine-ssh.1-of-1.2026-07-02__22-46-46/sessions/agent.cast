[892.744581, "i", "cat > /tmp/setup.py <<'PYEOF'\nimport socket, time, sys\n\nHOST, PORT = '127.0.0.1', 4555\ns = socket.create_connection((HOST, PORT), timeout=15)\ns.settimeout(1.0)\nbuf = b''\n\ndef drain(t=3):\n    global buf\n    end = time.time() + t\n    while time.time() < end:\n        try:\n            d = s.recv(4096)\n            if d: buf += d\n        except socket.timeout:\n            pass\n\ndef waitfor(tok, t=90):\n    global buf\n    tok = tok.encode() if isinstance(tok, str) else tok\n    end = time.time() + t\n    while time.time() < end:\n        try:\n            d = s.recv(4096)\n            if d: buf += d\n        except socket.timeout:\n            pass\n        if tok in buf:\n            return True\n    return False\n\ndef send(x):\n    s.sendall(x.encode())\n\nguest_script = r'''\ncat > /tmp/setup.sh <<'SETUP'\n#!/bin/sh\nset -x\nudhcpc -i eth0 >/dev/null 2>&1 || true\n: > /etc/apk/repositories\nfor d in /media/* ; do\n  if [ -d \"$d/apks\" ]; then echo \"$d/apks\" >> /etc/apk/repositories; fi\ndo"]
[892.744765, "o", "cat > /tmp/setup.py <<'PYEOF'"]
