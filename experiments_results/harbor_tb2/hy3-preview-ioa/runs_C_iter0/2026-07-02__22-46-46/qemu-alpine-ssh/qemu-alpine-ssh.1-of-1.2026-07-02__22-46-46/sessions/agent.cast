[754.658878, "i", "cat > /tmp/ssh.py <<'EOF'\nimport struct\nISO='/app/alpine.iso'; SECTOR=2048\nf=open(ISO,'rb'); f.seek(16*SECTOR)\npvd=f.read(SECTOR); root=pvd[156:190]\ndef pr(dr): return (struct.unpack('<I',dr[2:6])[0],struct.unpack('<I',dr[10:14])[0],dr[25],dr[33:33+dr[32]])\nhits=[]\ndef walk(ext,length,path):\n    f.seek(ext*SECTOR); data=f.read(length); off=0\n    while off<len(data):\n        rl=data[off]\n        if rl==0: off=(off//SECTOR+1)*SECTOR; continue\n        e,d,fl,nm=pr(data[off:off+rl])\n        if nm in (b'\\x00',b'\\x01'): off+=rl; continue\n        nm=nm.split(b';')[0].decode('latin1'); full=(path+'/'+nm) if path else nm\n        if fl&2: walk(e,d,full)\n        elif 'SSH' in nm.upper() or 'DROPBEAR' in nm.upper(): hits.append(full)\n        off+=rl\next,dl,fl,nm=pr(root); walk(ext,dl,'')\nprint('\\n'.join(hits) or 'NONE')\nEOF\npython3 /tmp/ssh.py\n"]
