[605.237211, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for full,e,d in files:\r\n\u001b[?2004l\r\u001b[?2004h>     if full.lower().endswith('syslinux.cfg') or full.lower().endswith('grub.cfg'):\r\n\u001b[?2004l\r\u001b[?2004h>         f.seek(e*SECTOR); cfg=f.read(d).decode('latin1','replace')\r\n\u001b[?2004l\r\u001b[?2004h>         print('---',full,'---'); print(cfg)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
