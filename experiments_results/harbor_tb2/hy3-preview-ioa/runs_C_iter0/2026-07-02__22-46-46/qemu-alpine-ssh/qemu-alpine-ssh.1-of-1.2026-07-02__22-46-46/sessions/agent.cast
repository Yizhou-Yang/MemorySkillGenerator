[605.21259, "i", "cat > /tmp/iso_extract.py <<'EOF'\nimport struct\nISO='/app/alpine.iso'; SECTOR=2048\nf=open(ISO,'rb'); f.seek(16*SECTOR)\npvd=f.read(SECTOR)\nassert pvd[0:1]==b'\\x01'\nroot_dr=pvd[156:190]\ndef parse_dr(dr):\n    e=struct.unpack('<I',dr[2:6])[0]; d=struct.unpack('<I',dr[10:14])[0]\n    fl=dr[25]; nl=dr[32]; nm=dr[33:33+nl]\n    return e,d,fl,nm\ndef walk(extent,length,path=''):\n    f.seek(extent*SECTOR); data=f.read(length); off=0\n    while off<len(data):\n        rl=data[off]\n        if rl==0:\n            off=(off//SECTOR+1)*SECTOR; continue\n        e,d,fl,nm=parse_dr(data[off:off+rl])\n        if nm in (b'\\x00',b'\\x01'):\n            off+=rl; continue\n        nm=nm.split(b';')[0].decode('latin1')\n        full=(path+'/'+nm) if path else nm\n        if fl&2: walk(e,d,full)\n        else: files.append((full,e,d))\n        off+=rl\nfiles=[]; ext,dl,fl,nm=parse_dr(root_dr); walk(ext,dl)\nfor full,e,d in files:\n    if '/boot/' in full.lower(): print('BOOT', full, d)\nprint('=== CFG FI"]
