[575.487177, "i", "cat > /tmp/iso_extract.py <<'EOF'\nimport struct, os\nISO='/app/alpine.iso'\nSECTOR=2048\nf=open(ISO,'rb')\nf.seek(16*SECTOR)\npvd=f.read(SECTOR)\nassert pvd[0:1]==b'\\x01', 'no PVD'\nroot_dr=pvd[156:190]\ndef parse_dr(dr):\n    extent=struct.unpack('<I',dr[2:6])[0]\n    dl=struct.unpack('<I',dr[10:14])[0]\n    flags=dr[25]\n    nl=dr[32]\n    name=dr[33:33+nl]\n    return extent,dl,flags,name\next,dl,flags,name=parse_dr(root_dr)\nfiles=[]\ndef walk(extent,length,path=''):\n    f.seek(extent*SECTOR)\n    data=f.read(length)\n    off=0\n    while off<len(data):\n        rl=data[off]\n        if rl==0:\n            off=(off//SECTOR+1)*SECTOR\n            continue\n        e,d,fl,nm=parse_dr(data[off:off+rl])\n        nm=nm.split(b';')[0].decode('ascii','replace')\n        if nm in ('.','..'):\n            off+=rl; continue\n        full=(path+'/'+nm) if path else nm\n        if fl&2:\n            walk(e,d,full)\n        else:\n            files.append((full,e,d))\n        off+=rl\nwalk(ext,dl)\nfor full,e,d in files:\n    if '/boot/' in full.lower() "]
[575.487373, "i", "or 'syslinux' in full.lower():\n        print('FILE', full, d)\nprint('=== CFG ===')\nfor full,e,d in files:\n    if full.lower().endswith('syslinux.cfg'):\n        f.seek(e*SECTOR); cfg=f.read(d).decode('ascii','replace')\n        print(cfg)\nEOF\n"]
[575.487988, "o", "cat > /tmp/iso_extract.py <<'EOF'\r\n\u001b[?2004l\ror 'syslinux' in full.lower():\r\n        print('FILE', full, d)\r\nprint('=== CFG ===')\r\nfor full,e,d in files:\r\n    if full.lower().endswith('syslinux.cfg'):\r\n        f.seek(e*SECTOR); cfg=f.read(d).decode('ascii','replace')\r\n        print(cfg)\r\nEOF\r\n"]
