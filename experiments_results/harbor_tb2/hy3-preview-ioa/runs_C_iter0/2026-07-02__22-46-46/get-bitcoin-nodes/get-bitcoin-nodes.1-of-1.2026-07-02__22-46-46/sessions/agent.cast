[306.129038, "i", "cat > /app/bitcoin_service.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"\nbitcoin_service.py\n\nA local Flask service that connects to a Bitcoin Core node over JSON-RPC and\nexposes blockchain data (blocks, transactions, and network status) through a\nsimple HTTP API.\n\nThe Bitcoin Core node is reached over the standard RPC interface. The node\nitself is connected to the Bitcoin peer-to-peer network (default P2P port 8333),\nso querying the node gives access to the live blockchain.\n\nConfiguration (environment variables, with bitcoin.conf overrides):\n  BITCOIND_RPC_HOST       default 127.0.0.1\n  BITCOIND_RPC_PORT       default 8332  (Bitcoin Core RPC port)\n  BITCOIND_RPC_USER       RPC username\n  BITCOIND_RPC_PASSWORD   RPC password\n  BITCOIND_RPC_TIMEOUT    RPC request timeout (seconds)\n\nThe service listens on localhost:5000.\n\"\"\"\n\nimport os\nimport json\nimport configparser\n\nimport requests\nfrom flask import Flask, jsonify\n\n# bitcoinlib is part of the required toolchain; import to confirm availability.\ntry:\n    import bitco"]
[306.129923, "i", "inlib  # noqa: F401\nexcept Exception:\n    pass\n\n# Bitcoin P2P default port (the port on which the node is connected to the network).\nBITCOIN_P2P_PORT = 8333\n\napp = Flask(__name__)\n\n# ---------------------------------------------------------------------------\n# Configuration\n# ---------------------------------------------------------------------------\nRPC_HOST = os.environ.get(\"BITCOIND_RPC_HOST\", \"127.0.0.1\")\nRPC_PORT = int(os.environ.get(\"BITCOIND_RPC_PORT\", \"8332\"))\nRPC_USER = os.environ.get(\"BITCOIND_RPC_USER\", \"\")\nRPC_PASSWORD = os.environ.get(\"BITCOIND_RPC_PASSWORD\", \"\")\nRPC_TIMEOUT = float(os.environ.get(\"BITCOIND_RPC_TIMEOUT\", \"10\"))\nRPC_URL = \"http://{0}:{1}\".format(RPC_HOST, RPC_PORT)\nDATADIR = os.path.expanduser(\"~/.bitcoin\")\n\n\ndef _load_conf():\n    global RPC_HOST, RPC_PORT, RPC_USER, RPC_PASSWORD, DATADIR\n    candidates = [\n        os.path.expanduser(\"~/.bitcoin/bitcoin.conf\"),\n        \"/etc/bitcoin/bitcoin.conf\",\n        \"/etc/bitcoin.conf\",\n        \"bitcoin.conf\",\n    ]\n    path = next((c for c "]
[306.130339, "o", "cat > /app/bitcoin_service.py << 'PYEOF'"]
[306.130906, "i", "in candidates if os.path.exists(c)), None)\n    if not path:\n        return\n    try:\n        with open(path) as fh:\n            data = \"[default]\\n\" + fh.read()\n        cp = configparser.ConfigParser()\n        cp.read_string(data)\n        d = cp[\"default\"]\n        if d.get(\"rpcconnect\"):\n            RPC_HOST = d.get(\"rpcconnect\")\n        if d.get(\"rpcport\"):\n            RPC_PORT = int(d.get(\"rpcport\"))\n        if d.get(\"rpcuser\"):\n            RPC_USER = d.get(\"rpcuser\")\n        if d.get(\"rpcpassword\"):\n            RPC_PASSWORD = d.get(\"rpcpassword\")\n        if d.get(\"datadir\"):\n            DATADIR = os.path.expanduser(d.get(\"datadir\"))\n    except Exception:\n        pass\n\n\n_load_conf()\n\n\ndef _get_cookie():\n    candidates = []\n    if DATADIR:\n        candidates.append(os.path.join(DATADIR, \".cookie\"))\n    candidates.append(os.path.expanduser(\"~/.bitcoin/.cookie\"))\n    for c in candidates:\n        if os.path.exists(c):\n            try:\n                with open(c) as fh:\n                    content = fh.read().st"]
[306.131053, "o", "\r\n\u001b[?2004l\rin candidates if os.path.exists(c)), None)\r\n    if not path:\r\n        return\r\n    try:\r\n        with open(path) as fh:\r\n            data = \"[default]\\n\" + fh.read()\r\n        cp = configparser.ConfigParser()\r\n        cp.read_string(data)\r\n        d = cp[\"default\"]\r\n        if d.get(\"rpcconnect\"):\r\n            RPC_HOST = d.get(\"rpcconnect\")\r\n        if d.get(\"rpcport\"):\r\n            RPC_PORT = int(d.get(\"rpcport\"))\r\n        if d.get(\"rpcuser\"):\r\n            RPC_USER = d.get(\"rpcuser\")\r\n        if d.get(\"rpcpassword\"):\r\n            RPC_PASSWORD = d.get(\"rpcpassword\")\r\n        if d.get(\"datadir\"):\r\n            DATADIR = os.path.expanduser(d.get(\"datadir\"))\r\n    except Exception:\r\n        pass\r\n\r\n\r\n_load_conf()\r\n\r\n\r\ndef _get_cookie():\r\n    candidates = []\r\n    if DATADIR:\r\n        candidates.append(os.path.join(DATADIR, \".cookie\"))\r\n    candidates.append(os.path.expanduser(\"~/.bitcoin/.cookie\"))\r\n    for c in candidates:\r\n        if os.path.exists(c):\r\n            try:\r\n                with open(c) as f"]
[306.131171, "i", "rip()\n                if \":\" in content:\n                    user, pw = content.split(\":\", 1)\n                    return (user, pw)\n                return (\"__cookie__\", content)\n            except Exception:\n                return None\n    return None\n\n\ndef _rpc_auth():\n    if RPC_USER:\n        return (RPC_USER, RPC_PASSWORD)\n    return _get_cookie()\n\n\ndef rpc_call(method, params=None, attempts=2):\n    \"\"\"Call a Bitcoin Core JSON-RPC method. Returns (result, error).\"\"\"\n    payload = {\n        \"jsonrpc\": \"1.0\",\n        \"id\": \"bitcoin_service\",\n        \"method\": method,\n        \"params\": params or [],\n    }\n    headers = {\"Content-Type\": \"application/json\"}\n    last_err = \"Unknown RPC error\"\n    for _ in range(max(1, attempts)):\n        try:\n            resp = requests.post(\n                RPC_URL,\n                data=json.dumps(payload),\n                auth=_rpc_auth(),\n                headers=headers,\n                timeout=RPC_TIMEOUT,\n            )\n            if resp.status_code == 401:\n              "]
