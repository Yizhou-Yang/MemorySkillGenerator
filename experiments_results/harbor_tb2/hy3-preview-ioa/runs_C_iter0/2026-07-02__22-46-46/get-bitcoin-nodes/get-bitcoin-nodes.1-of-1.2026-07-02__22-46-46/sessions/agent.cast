[306.131617, "i", "  return None, \"Authentication failed: invalid RPC credentials\"\n            resp.raise_for_status()\n            data = resp.json()\n            if data.get(\"error\"):\n                return None, data[\"error\"].get(\"message\", \"RPC error\")\n            return data.get(\"result\"), None\n        except requests.exceptions.ConnectionError as exc:\n            last_err = \"Not connected to the Bitcoin network ({0})\".format(exc)\n        except requests.exceptions.Timeout as exc:\n            last_err = \"Bitcoin RPC request timed out ({0})\".format(exc)\n        except Exception as exc:  # noqa: BLE001\n            last_err = \"RPC call failed: {0}\".format(exc)\n    return None, last_err\n\n\ndef _is_not_found(err):\n    e = (err or \"\").lower()\n    return any(k in e for k in (\"not found\", \"no such\", \"invalid\", \"does not exist\"))\n\n\n# ---------------------------------------------------------------------------\n# Endpoints\n# ---------------------------------------------------------------------------\n@app.route(\"/status\")\ndef status():\n  "]
[306.13209, "i", "  result, err = rpc_call(\"getblockchaininfo\")\n    if err:\n        return jsonify({\"status\": err, \"error\": err}), 503\n    return jsonify({\n        \"status\": \"online\",\n        \"chain\": result.get(\"chain\"),\n        \"blocks\": result.get(\"blocks\"),\n        \"headers\": result.get(\"headers\"),\n    })\n\n\n@app.route(\"/block/<block_hash>\")\ndef get_block(block_hash):\n    _, err = rpc_call(\"getblockchaininfo\")\n    if err:\n        return jsonify({\"error\": err}), 503\n\n    block, berr = rpc_call(\"getblock\", [block_hash, 1])\n    if berr:\n        if _is_not_found(berr):\n            return jsonify({\"error\": \"Block not found: {0}\".format(block_hash)}), 404\n        return jsonify({\"error\": berr}), 503\n\n    return jsonify({\n        \"hash\": block.get(\"hash\"),\n        \"height\": block.get(\"height\"),\n        \"merkleroot\": block.get(\"merkleroot\"),\n        \"time\": block.get(\"time\"),\n        \"nonce\": block.get(\"nonce\"),\n        \"tx\": block.get(\"tx\", []),\n    })\n\n\n@app.route(\"/transaction/<txid>\")\ndef get_transaction(txid):\n    _, err = rpc"]
[306.132154, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[306.132172, "i", "_call(\"getblockchaininfo\")\n    if err:\n        return jsonify({\"error\": err}), 503\n\n    tx, terr = rpc_call(\"getrawtransaction\", [txid, 1])\n    if terr:\n        if _is_not_found(terr):\n            return jsonify({\"error\": \"Transaction not found: {0}\".format(txid)}), 404\n        return jsonify({\"error\": terr}), 503\n\n    vin = [{\"coinbase\": v.get(\"coinbase\"), \"sequence\": v.get(\"sequence\")}\n           for v in tx.get(\"vin\", [])]\n\n    vout = []\n    for out in tx.get(\"vout\", []):\n        spk = out.get(\"scriptPubKey\", {})\n        vout.append({\n            \"value\": out.get(\"value\"),\n            \"n\": out.get(\"n\"),\n            \"scriptPubKey\": {\n                \"asm\": spk.get(\"asm\"),\n                \"hex\": spk.get(\"hex\"),\n                \"type\": spk.get(\"type\"),\n            },\n        })\n\n    return jsonify({\n        \"txid\": tx.get(\"txid\"),\n        \"blockhash\": tx.get(\"blockhash\"),\n        \"vin\": vin,\n        \"vout\": vout,\n    })\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=5000, threaded=True)\nPYEOF\n"]
