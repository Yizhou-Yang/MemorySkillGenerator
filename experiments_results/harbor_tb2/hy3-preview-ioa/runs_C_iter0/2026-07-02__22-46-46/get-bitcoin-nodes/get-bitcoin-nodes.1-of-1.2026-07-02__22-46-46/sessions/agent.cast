[306.217848, "o", "            data = \"[default]\\n\" + fh.read()\r\n\u001b[?2004l\r \u001b[?2004h> "]
[306.219941, "o", "        cp = configparser.ConfigParser()\r\n\u001b[?2004l\r\u001b[?2004h>         cp.read_string(data)\r\n\u001b[?2004l\r\u001b[?2004h>         d = cp[\"default\"]\r\n\u001b[?2004l\r\u001b[?2004h>         if d.get(\"rpcconnect\"):\r\n\u001b[?2004l\r\u001b[?2004h>             RPC_HOST = d.get(\"rpcconnect\")\r\n\u001b[?2004l\r\"\u001b[?2004h>         if d.get(\"rpcport\"):\r\n\u001b[?2004l\r,\u001b[?2004h>             RPC_PORT = int(d.get(\"rpcport\"))\r\n\u001b[?2004l\r\u001b[?2004h>         if d.get(\"rpcuser\"):\r\n\u001b[?2004l\r  \u001b[?2004h>             RPC_USER = d.get(\"rpcuser\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.224141, "o", "        if d.get(\"rpcpassword\"):\r\n\u001b[?2004l\r\u001b[?2004h>             RPC_PASSWORD = d.get(\"rpcpassword\")\r\n\u001b[?2004l\r\u001b[?2004h>         if d.get(\"datadir\"):\r\n\u001b[?2004l\r\u001b[?2004h>             DATADIR = os.path.expanduser(d.get(\"datadir\"))\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>         pass\r\n\u001b[?2004l\ra\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> _load_conf()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> def _get_cookie():\r\n\u001b[?2004l\r\u001b[?2004h>     candidates = []\r\n\u001b[?2004l\r\u001b[?2004h>     if DATADIR:\r\n\u001b[?2004l\r\u001b[?2004h>         candidates.append(os.path.join(DATADIR, \".cookie\"))\r\n\u001b[?2004l\r\u001b[?2004h>     candidates.append(os.path.expanduser(\"~/.bitcoin/.cookie\"))\r\n\u001b[?2004l\r\u001b[?2004h>     for c in candidates:\r\n\u001b[?2004l\r\u001b[?2004h>         if os.path.exists(c):\r\n"]
[306.234705, "o", "\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 with open(c) as fh:\r\n\u001b[?2004l\r\u001b[?2004h>                     content = fh.read().strip()\r\n\u001b[?2004l\r\u001b[?2004h>                 if \":\" in content:\r\n\u001b[?2004l\r\u001b[?2004h>                     user, pw = content.split(\":\", 1)\r\n\u001b[?2004l\r\u001b[?2004h>                     return (user, pw)\r\n\u001b[?2004l\r\u001b[?2004h>                 return (\"__cookie__\", content)\r\n\u001b[?2004l\r\u001b[?2004h>             except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>                 return None\r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _rpc_auth():\r\n\u001b[?2004l\r\u001b[?2004h>     if RPC_USER:\r\n\u001b[?2004l\r\u001b[?2004h>         return (RPC_USER, RPC_PASSWORD)\r\n\u001b[?2004l\r\u001b[?2004h>     return _get_cookie()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def rpc_call(method, params=None, attempts=2):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Call a Bitcoin Core JSON-RPC method. Returns (result, error).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     payload = {\r\n\u001b[?2004l\r\u001b[?2004h>"]
[306.235773, "o", "         \"jsonrpc\": \"1.0\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"id\": \"bitcoin_service\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"method\": method,\r\n\u001b[?2004l\r\u001b[?2004h>         \"params\": params or [],\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     headers = {\"Content-Type\": \"application/json\"}\r\n\u001b[?2004l\r\u001b[?2004h>     last_err = \"Unknown RPC error\"\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(max(1, attempts)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.236437, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h>             resp = requests.post(\r\n\u001b[?2004l\r"]
[306.236464, "o", "\u001b[?2004h> "]
[306.236793, "o", "                RPC_URL,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.23784, "o", "                data=json.dumps(payload),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.238137, "o", "                auth=_rpc_auth(),\r\n\u001b[?2004l\r"]
[306.238304, "o", "\u001b[?2004h>                 headers=headers,\r\n"]
[306.238435, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[306.238564, "o", "                timeout=RPC_TIMEOUT,\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.238697, "o", "            if resp.status_code == 401:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.238967, "o", "                return None, \"Authentication failed: invalid RPC credentials\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.238982, "o", "            resp.raise_for_status()\r\n\u001b[?2004l\r"]
[306.238997, "o", "\u001b[?2004h> "]
[306.239228, "o", "            data = resp.json()\r\n\u001b[?2004l\r\u001b[?2004h>             if data.get(\"error\"):\r\n"]
[306.239251, "o", "\u001b[?2004l\r"]
[306.239267, "o", "\u001b[?2004h"]
[306.239461, "o", ">                 return None, data[\"error\"].get(\"message\", \"RPC error\")\r\n\u001b[?2004l\r"]
[306.239488, "o", "\u001b[?2004h> "]
[306.240649, "o", "            return data.get(\"result\"), None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.245945, "o", "        except requests.exceptions.ConnectionError as exc:\r\n\u001b[?2004l\r\u001b[?2004h>             last_err = \"Not connected to the Bitcoin network ({0})\".format(exc)\r\n\u001b[?2004l\r\u001b[?2004h>         except requests.exceptions.Timeout as exc:\r\n\u001b[?2004l\r\u001b[?2004h>             last_err = \"Bitcoin RPC request timed out ({0})\".format(exc)\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as exc:  # noqa: BLE001\r\n\u001b[?2004l\r\u001b[?2004h>             last_err = \"RPC call failed: {0}\".format(exc)\r\n\u001b[?2004l\r\u001b[?2004h>     return None, last_err\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _is_not_found(err):\r\n\u001b[?2004l\r\u001b[?2004h>     e = (err or \"\").lower()\r\n\u001b[?2004l\r\u001b[?2004h>     return any(k in e for k in (\"not found\", \"no such\", \"invalid\", \"does not exist\"))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> # Endpoints\r\n\u001b[?2004l\r\u001b[?2004h> # --------------------------------------------------------------------------"]
[306.245986, "o", "-\r\n\u001b[?2004l\r\u001b[?2004h> @app.route(\"/status\")\r\n\u001b[?2004l\r\u001b[?2004h> def status():\r\n\u001b[?2004l\r\u001b[?2004h>     result, err = rpc_call(\"getblockchaininfo\")\r\n\u001b[?2004l\r\u001b[?2004h>     if err:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"status\": err, \"error\": err}), 503\r\n\u001b[?2004l\r\u001b[?2004h>     return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": \"online\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"chain\": result.get(\"chain\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"blocks\": result.get(\"blocks\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"headers\": result.get(\"headers\"),\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.route(\"/block/<block_hash>\")\r\n\u001b[?2004l\r\u001b[?2004h> def get_block(block_hash):\r\n\u001b[?2004l\r\u001b[?2004h>     _, err = rpc_call(\"getblockchaininfo\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.247976, "o", "    if err:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"error\": err}), 503\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     block, berr = rpc_call(\"getblock\", [block_hash, 1])\r\n\u001b[?2004l\r\u001b[?2004h>     if berr:\r\n\u001b[?2004l\r\u001b[?2004h>         if _is_not_found(berr):\r\n\u001b[?2004l\r\u001b[?2004h>             return jsonify({\"error\": \"Block not found: {0}\".format(block_hash)}), 404\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"error\": berr}), 503\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h>         \"hash\": block.get(\"hash\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"height\": block.get(\"height\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"merkleroot\": block.get(\"merkleroot\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.248698, "o", "        \"time\": block.get(\"time\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"nonce\": block.get(\"nonce\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"tx\": block.get(\"tx\", []),\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @app.route(\"/transaction/<txid>\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.249187, "o", "def get_transaction(txid):\r\n\u001b[?2004l\r\u001b[?2004h>     _, err = rpc_call(\"getblockchaininfo\")\r\n\u001b[?2004l\r\u001b[?2004h>     if err:\r\n\u001b[?2004l\r\u001b[?2004h>         return jsonify({\"error\": err}), 503\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[306.249728, "o", "> "]
[306.249786, "o", "    tx, terr = rpc_call(\"getrawtransaction\", [txid, 1])\r\n\u001b[?2004l\r\u001b[?2004h>     if terr:\r\n\u001b[?2004l\r\u001b[?2004h>         if _is_not_found(terr):\r\n\u001b[?2004l\r\u001b[?2004h>             return jsonify({\"error\": \"Transaction not found: {0}\".format(txid)}), 404\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.251009, "o", "        return jsonify({\"error\": terr}), 503\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     vin = [{\"coinbase\": v.get(\"coinbase\"), \"sequence\": v.get(\"sequence\")}\r\n\u001b[?2004l\r\u001b[?2004h>            for v in tx.get(\"vin\", [])]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     vout = []\r\n\u001b[?2004l\r\u001b[?2004h>     for out in tx.get(\"vout\", []):\r\n\u001b[?2004l\r\u001b[?2004h>         spk = out.get(\"scriptPubKey\", {})\r\n\u001b[?2004l\r\u001b[?2004h>         vout.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"value\": out.get(\"value\"),\r\n\u001b[?2004l\r\u001b[?2004h>             \"n\": out.get(\"n\"),\r\n\u001b[?2004l\r\u001b[?2004h>             \"scriptPubKey\": {\r\n\u001b[?2004l\r"]
[306.251039, "o", "\u001b[?2004h> "]
[306.251229, "o", "                \"asm\": spk.get(\"asm\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[306.251256, "o", "                \"hex\": spk.get(\"hex\"),\r\n\u001b[?2004l\r"]
[306.253347, "o", "\u001b[?2004h>                 \"type\": spk.get(\"type\"),\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return jsonify({\r\n\u001b[?2004l\r\u001b[?2004h>         \"txid\": tx.get(\"txid\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"blockhash\": tx.get(\"blockhash\"),\r\n\u001b[?2004l\r\u001b[?2004h>         \"vin\": vin,\r\n\u001b[?2004l\r\u001b[?2004h>         \"vout\": vout,\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     app.run(host=\"0.0.0.0\", port=5000, threaded=True)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
