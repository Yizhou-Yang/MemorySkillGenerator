[410.894418, "i", "python3 - << 'PY'\np='/app/bitcoin_service.py'\ns=open(p).read()\ns=s.replace('last_err = \"Not connected to the Bitcoin network ({0})\".format(exc)', 'last_err = \"Not connected to the Bitcoin network\"')\nold='''    if err:\n        return jsonify({\"status\": err, \"error\": err}), 503\n    return jsonify({\n        \"status\": \"online\",\n        \"chain\": result.get(\"chain\"),\n        \"blocks\": result.get(\"blocks\"),\n        \"headers\": result.get(\"headers\"),\n    })'''\nnew='''    if err:\n        return jsonify({\"error\": err}), 503\n    return jsonify({\"status\": \"online\"})'''\nassert old in s, 'status block not found'\ns=s.replace(old,new)\nopen(p,'w').write(s)\nprint('patched OK')\nPY\n"]
