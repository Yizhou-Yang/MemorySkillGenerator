[323.672045, "o", "\u001b[?2004hroot@40f2d484ff5c:/app# "]
[505.089, "i", "cat > /tmp/recover.py << 'EOF'\nimport struct, json\n\nwith open('/app/trunc.db','rb') as f:\n    data = f.read()\n\ndef read_varint(buf, off):\n    result = 0\n    for i in range(9):\n        b = buf[off+i]\n        if i == 8:\n            result = (result << 8) | b\n            return result, off+9\n        result = (result << 7) | (b & 0x7f)\n        if not (b & 0x80):\n            return result, off+i+1\n    return result, off+9\n\npgtype = data[0]\nnum_cells = struct.unpack('>H', data[3:5])[0]\ncell_start = struct.unpack('>H', data[5:7])[0]\nprint('page type', hex(pgtype), 'num_cells', num_cells, 'cell_content_start', hex(cell_start))\n\nrows = []\nfor i in range(num_cells):\n    ptr = struct.unpack('>H', data[8+2*i:8+2*i+2])[0]\n    off = ptr\n    try:\n        payload_len, off = read_varint(data, off)\n        rowid, off = read_varint(data, off)\n        hlen, hoff = read_varint(data, off)\n        serial_types = []\n        while hoff < off + hlen:\n            st, hoff = read_varint(data, hoff)\n            serial_types.append(st)\n        doff = off + hlen\n        vals = []\n        for st in serial_types:\n            if st == 0:\n                vals.append(None)\n            elif st == 1:\n                vals.append(int.from_bytes(data[doff:doff+1],'big',signed=True)); doff+=1\n            elif st == 2:\n                vals.append(int.from_bytes(data[doff:doff+2],'big',signed=True)); doff+=2\n            elif st == 3:\n                vals.append(int.from_bytes(data[doff:doff+3],'big',signed=True)); doff+=3\n            elif st == 4:\n                vals.append(int.from_bytes(data[doff:doff+4],'big',signed=True)); doff+=4\n            elif st == 5:\n                vals.append(int.from_bytes(data[doff:doff+6],'big',signed=True)); doff+=6\n            elif st == 6:\n                vals.append(int.from_bytes(data[doff:doff+8],'big',signed=True)); doff+=8\n            elif st == 7:\n                vals.append(struct.unpack('>d', data[doff:doff+8])[0]); doff+=8\n            elif st == 8:\n                vals.append(0)\n            elif st == 9:\n                vals.append(1)\n            elif st >= 12 and st % 2 == 0:\n                n=(st-12)//2; vals.append(data[doff:doff+n].hex()); doff+=n\n            elif st >= 13 and st % 2 == 1:\n                n=(st-13)//2; vals.append(data[doff:doff+n].decode('utf-8','replace')); doff+=n\n            else:\n                vals.append(None)\n        word = vals[1]\n        value = vals[2]\n        rows.append({\"word\": word, \"value\": value})\n    except Exception as e:\n        print('failed cell', i, 'at ptr', hex(ptr), ':', e)\n\nprint(json.dumps(rows, indent=2))\nwith open('/app/recover.json','w') as f:\n    json.dump(rows, f)\nprint('wrote', len(rows), 'rows')\nEOF\n"]
