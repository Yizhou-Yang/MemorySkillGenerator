[239.643807, "o", "\r\n"]
[239.644075, "o", "1402:              print STDERR \"      'The reference LZMA Decoder ignores the value of the \\\"Corrupted\\\" variable.\\n\";"]
[239.644305, "o", "\r\n"]
[239.644516, "o", "1403:              print STDERR \"       So it continues to decode the stream, even if the corruption can be detected\\n\";"]
[239.644738, "o", "\r\n"]
[239.644965, "o", "1404:              print STDERR \"       in the Range Decoder. To provide the full compatibility with output of the\\n\";"]
[239.64519, "o", "\r\n"]
[239.645668, "o", "1405:              print STDERR \"       reference LZMA Decoder, another LZMA Decoder implementation must also\\n\";"]
[239.645903, "o", "\r\n"]
[239.646102, "o", "1406:              print STDERR \"       ignore the value of the \\\"Corrupted\\\" variable.'\\n\";"]
[239.647093, "o", "\r\n1407:              print STDERR \"\\n\";\r\n1408:              print STDERR \"      (taken from the DOC/lzma-specification.txt file of the 7z-SDK: see for instance:\\n\";\r\n1409:              print STDERR \"       https://github.com/jljusten/LZMA-SDK/blob/master/DOC/lzma-specification.txt#L343-L347)\\n\";\r\n1499:        # to print several hash buffers, but this is a very special case)\r\n1524:      print STDERR \"WARNING: no AES data found in the 7z file '\" . $file_path . \"'\\n\";\r\n1531:    print STDERR \"WARNING: lzma2 compression found within '\" . $file_path . \"' is currently not supported, \";\r\n1532:    print STDERR \"but could be probably added easily\\n\";\r\n1538:    print STDERR \"WARNING: unsupported coder with codec id '0x\" . unpack (\"H*\", $codec_id) . \"' in file '\" . $file_path . \"' found.\\n\";\r\n1539:    print STDERR \"If you think this codec method from DOC/Methods.txt of the 7-Zip source code \";\r\n1540:    print STDERR \"should be supported, please file a problem report/feature request\\n\";\r\n1690:            print STDERR sprintf (\"DEBUG: new stream found with first file consisting of %9d bytes of %10d bytes total stream length\\n\", $length_first_file, $length_compressed);"]
