[13.035591, "m", "Episode 1: 2 commands"]
[13.035591, "o", "\u001b[?2004hroot@1bf77de67b57:/app# "]
[18.813047, "i", "cat /usr/local/bin/rencrypt\n"]
[18.813735, "o", "cat /usr/local/bin/rencrypt"]
[18.814089, "o", "\r\n"]
[18.81425, "o", "\u001b[?2004l\r"]
[18.81849, "o", "#!/usr/bin/env python3"]
[18.819082, "o", "\r\n"]
[18.81931, "o", "import argparse"]
[18.819543, "o", "\r\n"]
[18.81976, "o", "import os"]
[18.819993, "o", "\r\n"]
[18.820291, "o", "import sys"]
[18.820526, "o", "\r\n"]
[18.820739, "o", "\r\n"]
[18.820962, "o", "\r\n"]
[18.821211, "o", "def encrypt(input_file, protocol='rev'):"]
[18.821436, "o", "\r\n"]
[18.821674, "o", "    \"\"\"Naively encrypts the content of the file and returns it as a string.\"\"\""]
[18.821888, "o", "\r\n"]
[18.822133, "o", "    with open(input_file, 'r') as file:"]
[18.822348, "o", "\r\n"]
[18.822582, "o", "        content = file.read()"]
[18.822795, "o", "\r\n"]
[18.823028, "o", "\r\n"]
[18.82325, "o", "    if protocol == 'rev':"]
[18.823493, "o", "\r\n"]
[18.823721, "o", "        return content[::-1]"]
[18.82394, "o", "\r\n"]
[18.824185, "o", "    elif protocol == 'doub':"]
[18.824402, "o", "\r\n"]
[18.824643, "o", "        return content * 2"]
[18.824878, "o", "\r\n"]
[18.825122, "o", "    elif protocol == 'cap':"]
[18.825346, "o", "\r\n"]
[18.825592, "o", "        return content.upper()"]
[18.825854, "o", "\r\n"]
[18.826096, "o", "    else:"]
[18.826316, "o", "\r\n"]
[18.826556, "o", "        raise ValueError(f\"Invalid protocol: {protocol}\")"]
[18.826775, "o", "\r\n"]
[18.827011, "o", "\r\n"]
[18.827313, "o", "def main():"]
[18.827552, "o", "\r\n"]
[18.827768, "o", "    # Parse command-line arguments"]
[18.828007, "o", "\r\n"]
[18.828295, "o", "    parser = argparse.ArgumentParser(add_help=False)"]
[18.828539, "o", "\r\n"]
[18.828766, "o", "    parser.add_argument('input_files', nargs='+', help='Input files to encrypt')"]
[18.829005, "o", "\r\n"]
[18.829229, "o", "\r\n"]
[18.829452, "o", "    parser.add_argument("]
[18.829695, "o", "\r\n"]
[18.829917, "o", "        '-o', '--output',"]
[18.830158, "o", "\r\n"]
[18.833834, "o", "        default=None,\r\n        help='Output file to write the encrypted content'\r\n    )\r\n    parser.add_argument('-p', '--protocol',\r\n        default='doub',\r\n        help='Encryption protocol to use (rev, doub, cap).'\r\n    )\r\n    parser.add_argument('-v', '--version',\r\n        action='store_true',\r\n        help='Output version information and exit'"]
[18.834283, "o", "\r\n"]
[18.834516, "o", "    )"]
[18.834741, "o", "\r\n"]
[18.83499, "o", "    args = parser.parse_args()"]
[18.835225, "o", "\r\n"]
[18.835451, "o", "\r\n"]
[18.835702, "o", "    output_file = args.output"]
[18.835928, "o", "\r\n"]
[18.836176, "o", "    input_files = args.input_files"]
[18.836439, "o", "\r\n"]
[18.836685, "o", "\r\n"]
[18.83691, "o", "    if args.version:"]
[18.837159, "o", "\r\n"]
[18.83745, "o", "        print(\"rencrypt 1.0\")"]
[18.837719, "o", "\r\n"]
[18.837944, "o", "        sys.exit(0)"]
[18.838192, "o", "\r\n"]
[18.838415, "o", "\r\n"]
[18.838654, "o", "    if not input_files:"]
[18.838876, "o", "\r\n"]
[18.839121, "o", "        print(\"Error: No input files provided.\")"]
[18.839349, "o", "\r\n"]
[18.839593, "o", "        sys.exit(1)"]
[18.839817, "o", "\r\n"]
[18.840062, "o", "\r\n"]
[18.840293, "o", "    # Process each file"]
[18.840538, "o", "\r\n"]
[18.840762, "o", "    encrypted_contents = []"]
[18.841005, "o", "\r\n"]
[18.841247, "o", "    for input_file in input_files:"]
[18.841499, "o", "\r\n"]
[18.841731, "o", "        if not os.path.exists(input_file):"]
[18.841955, "o", "\r\n"]
[18.842208, "o", "            print(f\"Error: File '{input_file}' not found.\")"]
[18.842455, "o", "\r\n"]
[18.8427, "o", "            sys.exit(1)"]
[18.842924, "o", "\r\n"]
[18.84322, "o", "\r\n"]
[18.843452, "o", "        encrypted_contents.append(encrypt(input_file, protocol=args.protocol))"]
[18.843708, "o", "\r\n"]
[18.84393, "o", "\r\n"]
[18.844189, "o", "    # Output the encrypted contents"]
[18.844417, "o", "\r\n"]
[18.844664, "o", "    os.makedirs(os.path.dirname(output_file), exist_ok=True)"]
[18.845705, "o", "\r\n"]
[18.845947, "o", "    if output_file:"]
[18.846195, "o", "\r\n"]
[18.846423, "o", "        with open(output_file, 'w') as out_file:"]
[18.846703, "o", "\r\n"]
[18.846931, "o", "            out_file.write(\"\\n\".join(encrypted_contents))"]
[18.847177, "o", "\r\n"]
[18.847412, "o", "        print(f\"Encrypted content written to '{output_file}'\")"]
[18.847725, "o", "\r\n"]
[18.84795, "o", "    else:"]
[18.848197, "o", "\r\n"]
[18.848428, "o", "        print(\"\\n\".join(encrypted_contents))"]
[18.848679, "o", "\r\n"]
[18.84891, "o", "\r\n"]
[18.84916, "o", "if __name__ == \"__main__\":"]
[18.849385, "o", "\r\n"]
[18.84963, "o", "    main()"]
