[568.13339, "i", "cat > /tmp/scan3.py << 'EOF'\nimport socket\nhosts=['172.30.0.1','127.0.0.1']\nfor ip in hosts:\n    print('==',ip)\n    for p in [2375,2376,9000,9001,8080,80,22,4243]:\n        s=socket.socket(); s.settimeout(0.6)\n        r=s.connect_ex((ip,p))\n        print('  ',p,'OPEN' if r==0 else 'closed')\n        s.close()\nEOF\npython3 /tmp/scan3.py\n"]
