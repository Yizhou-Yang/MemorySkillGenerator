[454.913111, "i", "cat > /tmp/scan2.py << 'EOF'\nimport socket\nnodes={'node1':'172.30.0.4','node2':'172.30.0.2','node3':'172.30.0.3'}\nfor name,ip in nodes.items():\n    print('==',name,ip)\n    openp=[]\n    for p in range(1,1025):\n        s=socket.socket(); s.settimeout(0.05)\n        if s.connect_ex((ip,p))==0:\n            openp.append(p)\n        s.close()\n    print('  open:',openp)\nEOF\npython3 /tmp/scan2.py\n"]
[454.915121, "o", "cat > /tmp/scan2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import socket\r\n\u001b[?2004l\r\u001b[?2004h> nodes={'node1':'172.30.0.4','node2':'172.30.0.2','node3':'172.30.0.3'}\r\n\u001b[?2004l\r\u001b[?2004h> for name,ip in nodes.items():\r\n\u001b[?2004l\r\u001b[?2004h>     print('==',name,ip)\r\n\u001b[?2004l\r\u001b[?2004h>     openp=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for p in range(1,1025):\r\n\u001b[?2004l\r\u001b[?2004h>         s=socket.socket(); s.settimeout(0.05)\r\n\u001b[?2004l\r\u001b[?2004h>         if s.connect_ex((ip,p))==0:\r\n\u001b[?2004l\r\u001b[?2004h>             openp.append(p)\r\n\u001b[?2004l\r\u001b[?2004h>         s.close()\r\n\u001b[?2004l\r\u001b[?2004h>     print('  open:',openp)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
