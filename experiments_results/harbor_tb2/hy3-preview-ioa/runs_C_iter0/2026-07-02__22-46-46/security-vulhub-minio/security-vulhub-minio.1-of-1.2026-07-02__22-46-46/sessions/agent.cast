[604.101364, "i", "cat > /tmp/http.py << 'EOF'\nimport urllib.request, sys\nfor url in sys.argv[1:]:\n    print('====',url)\n    try:\n        r=urllib.request.urlopen(url, timeout=4)\n        data=r.read(2000)\n        print(r.status, r.headers.get('Server'), r.headers.get('Content-Type'))\n        print(data.decode(errors='replace'))\n    except Exception as e:\n        print('ERR',e)\nEOF\npython3 /tmp/http.py http://172.30.0.1:8080/ http://172.30.0.1:9001/ http://172.30.0.1:9000/\n"]
