[273.613037, "i", "cat > /tmp/an4.py << 'EOF'\nwith open('image.ppm','rb') as f:\n    data=f.read()\nhdr_end=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[hdr_end:]\ndef get(x,y):\n    i=(y*w+x)*3; return px[i],px[i+1],px[i+2]\n# Top region parabola fit per row\nprint('TOP parabola R(x,y)=a+b*(x-400)^2  (a at x=400, b from x=0)')\nfor y in range(0,260,20):\n    a=get(400,y)[0]\n    b=(get(0,y)[0]-a)/(400.0*400.0)\n    print('y=%3d a=%3d b=%+.6f  G_a=%d' % (y,a,b,get(400,y)[1]))\n# gradient direction histogram in bottom region\ngx=[0]*(w*h); gy=[0]*(w*h)\nfor y in range(1,h-1):\n    for x in range(1,w-1):\n        r,xp=get(x+1,y)[0],get(x-1,y)[0]\n        dyp=get(x,y+1)[0]-get(x,y-1)[0]\n        gx[y*w+x]=r-xp; gy[y*w+x]=dyp\nfrom collections import Counter\nc=Counter()\nfor y in range(350,599):\n    for x in range(1,w-1):\n        gxx=gx[y*w+x]; gyy=gy[y*w+x]\n        if abs(gxx)+abs(gyy)<3: continue\n        ang=(round((3.14159265+math.atan2(gyy,gxx))/(math.pi/9))%18)*10\n        c[ang]+=1\nprint('gradient angle histogram (bottom):')\nfor k in sorted(c): print(' %3d deg: %d' % (k,c[k]))\nimport math\nEOF\npython3 /tmp/an4.py\n"]
