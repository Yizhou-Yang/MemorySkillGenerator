[535.468915, "i", "cat > /tmp/an7.py << 'EOF'\nimport math\nwith open('image.ppm','rb') as f:\n    data=f.read()\nhe=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[he:]\ndef get(x,y):\n    i=(y*w+x)*3; return px[i],px[i+1],px[i+2]\ndef feats(u,v):\n    return [1.0,v,v*v,v*v*v,u,u*u,u*u*u,u*v,u*v*v,u*u*v]\ndef fit(plane,y0,y1):\n    M=[[0.0]*10 for _ in range(10)]; bb=[0.0]*10\n    for y in range(y0,y1):\n        for x in range(0,w):\n            f=feats(x-400,y); val=plane(x,y)\n            for i in range(10):\n                bb[i]+=f[i]*val\n                for j in range(10): M[i][j]+=f[i]*f[j]\n    A=[r[:] for r in M]; b=bb[:]\n    for p in range(10):\n        m=p\n        for r in range(p+1,10):\n            if abs(A[r][p])>abs(A[m][p]): m=r\n        A[p],A[m]=A[m],A[p]; b[p],b[m]=b[m],b[p]\n        pv=A[p][p]\n        for c in range(p,10): A[p][c]/=pv\n        b[p]/=pv\n        for r in range(10):\n            if r!=p:\n                f=A[r][p]\n                for c in range(p,10): A[r][c]-=f*A[p][c]\n                b[r]-=f*b[p]\n    return b\ndef rms(c,plane,y0,y1):\n    e=0.0;n=0\n    for y in range(y0,y1):\n        for x in range(0,w):\n            f=feats(x-400,y); p=sum(c[i]*f[i] for i in range(10)); d=p-plane(x,y); e+=d*d;n+=1\n    return math.sqrt(e/n)\ncR=fit(lambda x,y:get(x,y)[0],0,265); cG=fit(lambda x,y:get(x,y)[1],0,265)\nprint('clean R coef',[round(v,5) for v in cR],'RMS',round(rms(cR,lambda x,y:get(x,y)[0],0,265),3))\nprint('clean G coef',[round(v,5) for v in cG],'RMS',round(rms(cG,lambda x,y:get(x,y)[1],0,265),3))\nprint('sphere y=330 profile:')\nfor x in range(335,466,5):\n    print(x, get(x,330))\nprint('floor boundary x (R>100 -> light) per y:')\nfor y in range(420,590,20):\n    vals=[1 if get(x,y)[0]>100 else 0 for x in range(w)]\n    edges=[x for x in range(1,w) if vals[x]!=vals[x-1]]\n    print('y',y,'n_edges',len(edges),'first25',edges[:25])\nEOF\npython3 /tmp/an7.py\n"]
