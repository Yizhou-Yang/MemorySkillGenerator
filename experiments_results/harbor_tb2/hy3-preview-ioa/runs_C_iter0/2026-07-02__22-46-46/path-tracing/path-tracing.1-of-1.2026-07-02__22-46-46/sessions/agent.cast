[114.519651, "i", "cat > /tmp/an2.py << 'EOF'\nimport math\nwith open('image.ppm','rb') as f:\n    data=f.read()\nhdr_end=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[hdr_end:]\n# build channel arrays\nR=[0]*(w*h);G=[0]*(w*h);B=[0]*(w*h)\nfor i in range(w*h):\n    R[i]=px[i*3];G[i]=px[i*3+1];B[i]=px[i*3+2]\ndef idx(x,y):return y*w+x\n# noise estimate: std of second difference along x within a row (smooth region top)\nres=[]\nfor y in range(0,50):\n    for x in range(2,w-2):\n        for ch in (R,G,B):\n            res.append(ch[idx(x,y)]-2*ch[idx(x-1,y)]+ch[idx(x-2,y)])\nimport statistics\nprint('2nd-diff std (top rows):', statistics.pstdev(res))\n# try gradient correlation: correlation of R with x and y\nxs=[i%w for i in range(w*h)]; ys=[i//w for i in range(w*h)]\ndef corr(a,b):\n    n=len(a); ma=sum(a)/n; mb=sum(b)/n\n    num=sum((a[i]-ma)*(b[i]-mb) for i in range(n))\n    da=math.sqrt(sum((v-ma)**2 for v in a)); db=math.sqrt(sum((v-mb)**2 for v in b))\n    return num/(da*db)\nprint('R vs x',corr(R,xs),'R vs y',corr(R,ys))\nprint('G vs x',corr(G,xs),'G vs y',corr(G,ys))\nprint('B vs x',corr(B,xs),'B vs y',corr(B,ys))\n# distance from center squared\ncx,cy=400,300\nfor name,ch in [('R',R),('G',G),('B',B)]:\n    d2=[((i%w)-cx)**2+((i//w)-cy)**2 for i in range(w*h)]\n    print(name,'vs dist2',corr(ch,d2))\nEOF\npython3 /tmp/an2.py\n"]
[114.520824, "o", "cat > /tmp/an2.py << 'EOF'"]
[114.522214, "o", "\r\n"]
