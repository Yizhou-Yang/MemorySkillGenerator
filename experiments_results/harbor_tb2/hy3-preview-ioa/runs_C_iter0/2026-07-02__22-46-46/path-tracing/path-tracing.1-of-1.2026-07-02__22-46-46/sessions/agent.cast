[91.309984, "i", "cat > /tmp/analyze.py << 'EOF'\nimport sys\nwith open('image.ppm','rb') as f:\n    data=f.read()\nassert data[:2]==b'P6'\nhdr_end=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[hdr_end:]\nprint('header end',hdr_end,'pxlen',len(px),'expected',w*h*3)\ndef get(x,y):\n    i=(y*w+x)*3\n    return px[i],px[i+1],px[i+2]\n# print first row some samples\nprint('row0 x=0,10,100,400,799:')\nfor x in [0,10,100,400,799]:\n    print(x, get(x,0))\nprint('col0 y=0,10,100,300,599:')\nfor y in [0,10,100,300,599]:\n    print(y, get(0,y))\n# check if pure diagonal gradient\nprint('diag x=y:')\nfor v in [0,100,200,400,799]:\n    print(v,get(v,v))\nEOF\npython3 /tmp/analyze.py\n"]
[91.310399, "o", "cat > /tmp/analyze.py << 'EOF'"]
