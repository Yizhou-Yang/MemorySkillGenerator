[147.87001, "i", "cat > /tmp/an3.py << 'EOF'\nwith open('image.ppm','rb') as f:\n    data=f.read()\nhdr_end=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[hdr_end:]\ndef get(x,y):\n    i=(y*w+x)*3; return px[i],px[i+1],px[i+2]\n# vertical profile at x=400 every 50\nprint('VERT x=400, y step 50:')\nfor y in range(0,600,50):\n    print(y, get(400,y))\nprint('VERT x=0, y step 50:')\nfor y in range(0,600,50):\n    print(y, get(0,y))\nprint('HORIZ y=0, x step 100:')\nfor x in range(0,800,100):\n    print(x, get(x,0))\nprint('HORIZ y=300, x step 100:')\nfor x in range(0,800,100):\n    print(x, get(x,300))\nprint('points at y=400 across x:')\nfor x in [0,200,400,600,799]:\n    print(x, get(x,400))\nEOF\npython3 /tmp/an3.py\n"]
[147.872101, "o", "cat > /tmp/an3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> with open('image.ppm','rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data=f.read()\r\n\u001b[?2004l\r\u001b[?2004h> hdr_end=data.index(b'\\n255\\n')+len(b'\\n255\\n')\r\n\u001b[?2004l\r\u001b[?2004h> w,h=800,600\r\n\u001b[?2004l\r\u001b[?2004h> px=data[hdr_end:]"]
[147.8728, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[147.872852, "o", "def get(x,y):\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.873489, "o", ">     i=(y*w+x)*3; return px[i],px[i+1],px[i+2]"]
[147.87389, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[147.874497, "o", "> "]
[147.874915, "o", "# vertical profile at x=400 every 50"]
[147.875804, "o", "\r\n"]
[147.877805, "o", "\u001b[?2004l\r\u001b[?2004h> print('VERT x=400, y step 50:')\r\n\u001b[?2004l\r\u001b[?2004h> for y in range(0,600,50):\r\n\u001b[?2004l\r\u001b[?2004h>     print(y, get(400,y))\r\n\u001b[?2004l\r\u001b[?2004h> print('VERT x=0, y step 50:')\r\n\u001b[?2004l\r\u001b[?2004h> for y in range(0,600,50):\r\n\u001b[?2004l\r\u001b[?2004h>     print(y, get(0,y))\r\n\u001b[?2004l\r\u001b[?2004h> print('HORIZ y=0, x step 100:')\r\n\u001b[?2004l\r\u001b[?2004h> for x in range(0,800,100):\r\n\u001b[?2004l\r\u001b[?2004h>     print(x, get(x,0))\r\n\u001b[?2004l\r\u001b[?2004h> print('HORIZ y=300, x step 100:')\r\n\u001b[?2004l\r\u001b[?2004h> for x in range(0,800,100):\r\n\u001b[?2004l\r\u001b[?2004h>     print(x, get(x,300))\r\n\u001b[?2004l\r\u001b[?2004h> print('points at y=400 across x:')"]
[147.878224, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for x in [0,200,400,600,799]:\r\n\u001b[?2004l\r\u001b[?2004h>     print(x, get(x,400))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[147.883142, "o", "\u001b[?2004hroot@e4e667a7dedd:/app# python3 /tmp/an3.py\r\n\u001b[?2004l\r"]
[147.929755, "o", "VERT x=400, y step 50:\r\n0 (146, 190, 255)\r\n50 (151, 193, 255)\r\n100 (156, 196, 255)\r\n150 (163, 200, 255)\r\n200 (171, 205, 255)\r\n250 (181, 211, 255)\r\n"]
[147.929936, "o", "300 (51, 10, 10)\r\n350 (51, 10, 10)\r\n400 (22, 22, 22)\r\n450 (79, 79, 79)\r\n500 (74, 74, 74)\r\n550 (145, 145, 145)\r\nVERT x=0, y step 50:\r\n0 (159, 197, 255)\r\n50 (163, 200, 255)\r\n100 (168, 203, 255)\r\n150 (173, 206, 255)\r\n200 (179, 210, 255)\r\n250 (185, 213, 255)\r\n300 (121, 125, 130)\r\n350 (70, 70, 70)\r\n400 (69, 69, 69)\r\n450 (74, 74, 74)\r\n500 (153, 153, 153)\r\n550 (67, 67, 67)\r\nHORIZ y=0, x step 100:\r\n0 (159, 197, 255)\r\n"]
[147.929961, "o", "100 (155, 195, 255)\r\n200 (151, 193, 255)\r\n300 (147, 191, 255)\r\n"]
[147.929987, "o", "400 (146, 190, 255)\r\n"]
[147.930015, "o", "500 (147, 191, 255)\r\n"]
[147.930042, "o", "600 (151, 193, 255)\r\n700 (155, 195, 255)\r\nHORIZ y=300, x step 100:\r\n0 (121, 125, 130)\r\n100 (115, 117, 120)\r\n200 (117, 119, 122)\r\n"]
[147.930063, "o", "300 (117, 119, 122)\r\n400 (51, 10, 10)\r\n500 (117, 119, 122)\r\n600 (118, 120, 123)\r\n"]
[147.930491, "o", "700 (117, 119, 122)\r\npoints at y=400 across x:\r\n0 (69, 69, 69)\r\n200 (154, 154, 154)\r\n400 (22, 22, 22)\r\n600 (89, 89, 89)\r\n799 (150, 150, 150)\r\n"]
[147.934867, "m", "Episode 10: 1 commands"]
[147.934867, "o", "\u001b[?2004hroot@e4e667a7dedd:/app# "]
[188.177257, "i", "cat > /tmp/ascii.py << 'EOF'\nwith open('image.ppm','rb') as f:\n    data=f.read()\nhdr_end=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[hdr_end:]\ndef get(x,y):\n    i=(y*w+x)*3; return px[i],px[i+1],px[i+2]\nramp=' .:-=+*#%@'\ncols=100; rows=50\nfor ry in range(rows):\n    line=''\n    for rx in range(cols):\n        x=rx*w//cols; y=ry*h//rows\n        r,g,b=get(x,y)\n        lum=(r+g+b)/3.0\n        line+=ramp[min(9,int(lum/256*10))]\n    print(line)\nEOF\npython3 /tmp/ascii.py\n"]
