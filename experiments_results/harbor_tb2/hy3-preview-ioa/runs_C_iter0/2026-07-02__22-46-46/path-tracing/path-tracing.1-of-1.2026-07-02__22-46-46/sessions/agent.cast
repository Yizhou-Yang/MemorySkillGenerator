[463.760797, "i", "]=b[m],b[p]\n        pv=A[p][p]\n        for c in range(p,10): A[p][c]/=pv\n        b[p]/=pv\n        for r in range(10):\n            if r!=p:\n                f=A[r][p]\n                for c in range(p,10): A[r][c]-=f*A[p][c]\n                b[r]-=f*b[p]\n    return b\n\ndef rms(coef, plane, y0, y1):\n    e=0.0; n=0\n    for y in range(y0,y1):\n        for x in range(0,w):\n            u=x-400; v=y\n            f=feats(u,v)\n            pred=sum(coef[i]*f[i] for i in range(10))\n            d=pred-plane(x,y); e+=d*d; n+=1\n    return math.sqrt(e/n)\n\ncR=fit(lambda x,y:get(x,y)[0],0,295)\ncG=fit(lambda x,y:get(x,y)[1],0,295)\nprint('R cubic coef:',[round(c,5) for c in cR])\nprint('R cubic RMS (train):',round(rms(cR,lambda x,y:get(x,y)[0],0,295),3))\nprint('G cubic coef:',[round(c,5) for c in cG])\nprint('G cubic RMS (train):',round(rms(cG,lambda x,y:get(x,y)[1],0,295),3))\n\nprint('bottom R at x=0..400 step50:')\nfor y in [450,500,550,580]:\n    print(' y',y,[get(x,y)[0] for x in range(0,401,50)])\nprint('stripe along x+y=const (should be ~const if stripes are x+y const):')\nfor s in [0,10,20,30,40,50]:\n    print(' x',s,'y',500-s,get(s,500-s)[0])\nprint('stripe along x-y=const:')\nfor s in [0,40,80,120]:\n    print(' x',100+s,'y',500-s,get(100+s,500-s)[0])\nEOF\npython3 /tmp/an6.py\n"]
