[463.756098, "i", "cat > /tmp/an6.py << 'EOF'\nimport math\nwith open('image.ppm','rb') as f:\n    data=f.read()\nhe=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[he:]\ndef get(x,y):\n    i=(y*w+x)*3; return px[i],px[i+1],px[i+2]\nprint('B top region [y, B at x=0,400,799]:')\nfor y in range(0,300,30):\n    print(y, get(0,y)[2], get(400,y)[2], get(799,y)[2])\n\ndef feats(u,v):\n    return [1,v,v*v,v*v*v,u,u*u,u*u*u,u*v,u*v*v,u*u*v]\n\ndef fit(plane, y0, y1):\n    M=[[0.0]*10 for _ in range(10)]\n    bb=[0.0]*10\n    for y in range(y0,y1):\n        for x in range(0,w):\n            u=x-400; v=y\n            f=feats(u,v)\n            val=plane(x,y)\n            for i in range(10):\n                bb[i]+=f[i]*val\n                Mi=M[i]\n                for j in range(10):\n                    Mi[j]+=f[i]*f[j]\n    A=[row[:] for row in M]; b=bb[:]\n    for p in range(10):\n        m=p\n        for r in range(p+1,10):\n            if abs(A[r][p])>abs(A[m][p]): m=r\n        A[p],A[m]=A[m],A[p]; b[p],b[m"]
