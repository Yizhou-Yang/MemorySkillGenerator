[392.678145, "i", "cat > /tmp/an5.py << 'EOF'\nimport math\nfrom collections import Counter\nwith open('image.ppm','rb') as f:\n    data=f.read()\nhe=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[he:]\ndef get(x,y):\n    i=(y*w+x)*3\n    return px[i],px[i+1],px[i+2]\nprint('== gray transition (avg |R-G|+|G-B| per row sampled) ==')\nfor y in range(0,600,5):\n    s=0.0; n=0\n    for x in range(0,w,4):\n        r,g,b=get(x,y)\n        s+=abs(r-g)+abs(g-b); n+=1\n    print(y, round(s/n,2))\nprint('== red blob ==')\nxs=[];ys=[]\nfor y in range(h):\n    for x in range(w):\n        r,g,b=get(x,y)\n        if r-g>40 and g<90:\n            xs.append(x);ys.append(y)\nif xs:\n    print('x[%d,%d] y[%d,%d] count=%d'%(min(xs),max(xs),min(ys),max(ys),len(xs)))\nelse:\n    print('none')\nprint('== gradient angle histogram (full image) ==')\nc=Counter()\nfor y in range(1,h-1):\n    for x in range(1,w-1):\n        gxx=get(x+1,y)[0]-get(x-1,y)[0]\n        gyy=get(x,y+1)[0]-get(x,y-1)[0]\n        if abs(gxx)+abs(gyy)<4:"]
[392.678648, "i", " continue\n        ang=(round(math.degrees(math.atan2(gyy,gxx))/5)*5)%180\n        c[ang]+=1\nfor k in sorted(c):\n    print('%3d: %d'%(k,c[k]))\nEOF\npython3 /tmp/an5.py\n"]
