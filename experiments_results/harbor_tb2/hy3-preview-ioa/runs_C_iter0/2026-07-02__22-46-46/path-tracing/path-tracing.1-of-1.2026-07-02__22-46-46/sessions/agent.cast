[682.966341, "i", "cat > /tmp/an8.py << 'EOF'\nimport math\nfrom collections import Counter\nwith open('image.ppm','rb') as f:\n    data=f.read()\nhe=data.index(b'\\n255\\n')+len(b'\\n255\\n')\nw,h=800,600\npx=data[he:]\ndef get(x,y):\n    i=(y*w+x)*3; return px[i],px[i+1],px[i+2]\nfor y in [400,450,500,550,580]:\n    c=Counter()\n    for x in range(0,w):\n        r,g,b=get(x,y)\n        c[round(r/3)*3]+=1  # bin R to nearest 3\n    print('y',y,'R hist (binned):',dict(sorted(c.items())))\n# also check cross-channel equality in floor\nprint('floor RGB equality check (y=500):')\nsame=0;tot=0\nfor x in range(0,w):\n    r,g,b=get(x,500)\n    if r==g==b: same+=1\n    tot+=1\nprint('all-equal px:',same,'/',tot)\n# fine strip y=500 x 0..160 every 2\nprint('y=500 R x=0..160 step2:')\nprint([get(x,500)[0] for x in range(0,161,2)])\nEOF\npython3 /tmp/an8.py\n"]
