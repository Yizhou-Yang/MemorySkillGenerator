[534.478302, "i", "cat > /tmp/probe3.py << 'EOF'\nimport requests\nhosts = [\n  'https://solana.gemnodes.io',\n  'https://rpc.shyft.to',\n  'https://try-rpc.mainnet.rpcslib.io',\n  'https://fruitchain-rpc.saulgoodman.cloud',\n  'https://solana-mainnet.rpc.sendnodes.dev',\n  'https://mainnet.solana-rpc.com',\n  'https://public-api.solana.dev',\n  'https://solana-mainnet.phantom.app',\n  'https://solana-mainnet.rpc.dwellir.com',\n  'https://solana.api.rpcpool.com',\n  'https://api.testnet.solana.com',\n  'https://mainnet.koii-node.com',\n]\nfor h in hosts:\n    try:\n        r = requests.post(h, json={'jsonrpc':'2.0','id':1,'method':'getSlot','params':[]}, timeout=15)\n        print(h, r.status_code, r.text[:90])\n    except Exception as e:\n        print(h, 'ERR', str(e)[:80])\nEOF\npython3 /tmp/probe3.py\n"]
