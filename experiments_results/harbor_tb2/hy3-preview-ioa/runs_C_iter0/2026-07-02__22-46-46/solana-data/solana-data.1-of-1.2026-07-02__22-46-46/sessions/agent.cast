[459.132613, "i", "cat > /tmp/probe2.py << 'EOF'\nimport requests\nH='https://mainnet.helius-rpc.com'\ndef call(m, p=None):\n    r=requests.post(H, json={'jsonrpc':'2.0','id':1,'method':m,'params':p or []}, timeout=20)\n    return r.status_code, r.text[:200]\nfor m,p in [('getSlot',[]),('getVersion',[]),('getHealth',[]),('getSlotLeader',[])]:\n    print(m, call(m,p))\nEOF\npython3 /tmp/probe2.py\n"]
