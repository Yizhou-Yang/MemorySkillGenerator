[636.683172, "i", "cat > /tmp/probe4.py << 'EOF'\nimport requests\nhosts = [\n  'https://solana-mainnet.g.alchemy.com/v2/demo',\n  'https://rpc.features.fyi',\n  'https://solana.public-rpc.com',\n  'https://api.solana.pw',\n  'https://free-rpc.discovermpc.com',\n  'https://mainnet.rpc.j73.me',\n  'https://solana-mainnet.01node.com',\n  'https://solana.api.molar.is',\n  'https://rpc.tokenview.io/solana-mainnet',\n  'https://solana-mainnet.rpc.lavenderfive.com',\n  'https://solana-mainnet.rpc.commonstate.io',\n  'https://api.mainnet-beta.solana.com',\n]\nfor h in hosts:\n    try:\n        r = requests.post(h, json={'jsonrpc':'2.0','id':1,'method':'getSlot','params':[]}, timeout=15)\n        print(h, r.status_code, r.text[:120])\n    except Exception as e:\n        print(h, 'ERR', str(e)[:70])\nEOF\npython3 /tmp/probe4.py\n"]
