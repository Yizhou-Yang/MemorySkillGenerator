[349.823321, "i", "for h in https://solana-api.projectserum.com https://rpc.ankr.com/solana https://solana-mainnet.g.alchemy.com/v2/demo https://mainnet.helius-rpc.com https://ssc-dao.genesysgo.net https://api.metaplex.solana.com https://solana.rpcpool.com; do python3 -c \"import requests,sys;\\ntry:\\n r=requests.post('$h',json={'jsonrpc':'2.0','id':1,'method':'getHealth'},timeout=12); print('$h', r.status_code, r.text[:120])\\nexcept Exception as e:\\n print('$h', 'ERR', str(e)[:90])\\n\" 2>&1 | tail -1; done\n"]
[349.827686, "o", "for h in https://solana-api.projectserum.com https://rpc.ankr.com/solana https://solana-mainnet.g.alchemy.com/v2/demo https://mainnet.helius-rpc.com https://ssc-dao.genesysgo.net https://api.metaplex.solana.com https://solana.rpcpool.com; do python3 -c \"import requests,sys;\\ntry:\\n r=requests.post('$h',json={'jsonrpc':'2.0','id':1,'method':'getHealth'},timeout=12); print('$h', r.status_code, r.text[:120])\\nexcept Exception as e:\\n print('$h', 'ERR', str(e)[:90])\\n\" 2>&1 | tail -1; done\r\n\u001b[?2004l\r"]
