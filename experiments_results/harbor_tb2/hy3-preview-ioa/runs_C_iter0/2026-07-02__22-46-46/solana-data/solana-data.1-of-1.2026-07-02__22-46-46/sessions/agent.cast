[398.830979, "i", "cat > /tmp/probe.py << 'EOF'\nimport requests\nhosts = [\n  'https://solana-api.projectserum.com',\n  'https://rpc.ankr.com/solana',\n  'https://solana-mainnet.g.alchemy.com/v2/demo',\n  'https://mainnet.helius-rpc.com',\n  'https://ssc-dao.genesysgo.net',\n  'https://solana.rpcpool.com',\n  'https://api.metaplex.solana.com',\n  'https://endpoints.omniation.io/solana/mainnet',\n  'https://solana-mainnet.rpc.extrnode.com',\n]\nfor h in hosts:\n    try:\n        r = requests.post(h, json={'jsonrpc':'2.0','id':1,'method':'getHealth'}, timeout=12)\n        print(h, r.status_code, r.text[:120])\n    except Exception as e:\n        print(h, 'ERR', str(e)[:90])\nEOF\npython3 /tmp/probe.py\n"]
[398.831596, "o", "cat > /tmp/probe.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import requests\r\n\u001b[?2004l\r\u001b[?2004h> hosts = [\r\n\u001b[?2004l\r\u001b[?2004h>   'https://solana-api.projectserum.com',\r\n\u001b[?2004l\r\u001b[?2004h>   'https://rpc.ankr.com/solana',\r\n\u001b[?2004l\r\u001b[?2004h> "]
