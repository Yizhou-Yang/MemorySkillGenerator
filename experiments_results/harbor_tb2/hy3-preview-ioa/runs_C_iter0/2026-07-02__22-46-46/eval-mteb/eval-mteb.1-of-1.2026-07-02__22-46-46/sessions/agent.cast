[1163.204733, "o", "\r\n"]
[1163.204927, "o", "                [--co2_tracker CO2_TRACKER]"]
[1163.20513, "o", "\r\n"]
[1163.20537, "o", "                [--eval_splits EVAL_SPLITS [EVAL_SPLITS ...]]"]
[1163.20562, "o", "\r\n"]
[1163.205802, "o", "                [--model_revision MODEL_REVISION] [--batch_size BATCH_SIZE]"]
[1163.205993, "o", "\r\n"]
[1163.206179, "o", "                [--overwrite] [--save_predictions]"]
[1163.206429, "o", "\r\n"]
[1163.206652, "o", "\r\n"]
[1163.206779, "o", "options:"]
[1163.206976, "o", "\r\n"]
[1163.207242, "o", "  -h, --help            show this help message and exit"]
[1163.20751, "o", "\r\n"]
[1163.2076, "o", "  -m MODEL, --model MODEL"]
[1163.208031, "o", "\r\n"]
[1163.208279, "o", "                        Model to use. Will priotize model implementation in"]
[1163.208565, "o", "\r\n"]
[1163.208766, "o", "                        MTEB's model registry, but default to loading the"]
[1163.209034, "o", "\r\n"]
[1163.209258, "o", "                        model using sentence-transformers."]
[1163.20956, "o", "\r\n"]
[1163.209762, "o", "  --task_types TASK_TYPES [TASK_TYPES ...]"]
[1163.209963, "o", "\r\n"]
[1163.210159, "o", "                        List of task types (Clustering, Retrieval..) to be"]
[1163.210399, "o", "\r\n"]
[1163.210704, "o", "                        evaluated. If None, the filter is not applied"]
[1163.210907, "o", "\r\n"]
[1163.211099, "o", "  --categories CATEGORIES [CATEGORIES ...]"]
[1163.211349, "o", "\r\n"]
[1163.211547, "o", "                        List of task categories (s2s, p2p..) to be evaluated."]
[1163.211746, "o", "\r\n"]
[1163.211939, "o", "                        If None the filter is not applied"]
[1163.212211, "o", "\r\n"]
[1163.212707, "o", "  -t TASKS [TASKS ...], --tasks TASKS [TASKS ...]"]
[1163.212909, "o", "\r\n"]
[1163.213927, "o", "                        List of tasks to be evaluated. If specified, the other\r\n                        arguments are ignored.\r\n  -l [LANGUAGES ...], --languages [LANGUAGES ...]\r\n                        List of languages to be evaluated. if not set, all\r\n                        languages will be evaluated. Specified as ISO 639-3\r\n                        codes (e.g. eng, deu, fra).\r\n  -b BENCHMARKS [BENCHMARKS ...], --benchmarks BENCHMARKS [BENCHMARKS ...]\r\n                        List of benchmark to be evaluated.\r\n  --device DEVICE       Device to use for computation\r\n  --output_folder OUTPUT_FOLDER\r\n                        Output directory for results. Will default to\r\n                        `results` if not set."]
[1163.21508, "o", "\r\n  -v VERBOSITY, --verbosity VERBOSITY\r\n                        Verbosity level\r\n  --co2_tracker CO2_TRACKER\r\n                        Enable CO₂ tracker, disabled by default\r\n  --eval_splits EVAL_SPLITS [EVAL_SPLITS ...]\r\n                        Evaluation splits to use (train, dev, test..). If\r\n                        None, all splits will be used\r\n  --model_revision MODEL_REVISION\r\n                        Revision of the model to be loaded. Revisions are\r\n                        automatically read if the model is loaded from\r\n                        huggingface.\r\n  --batch_size BATCH_SIZE\r\n                        Batch size of the encode. Will be passed to the MTEB\r\n                        as MTEB.evaluate(model, encode_kwargs = {'batch_size':\r\n                        value}).\r\n  --overwrite           Overwrite the output file if it already exists\r\n  --save_predictions    For retrieval tasks. Saves the predictions file in"]
[1163.215407, "o", "\r\n                        output_folder.\r\n"]
