[10.08367, "o", "  - defaults"]
[10.084014, "o", "\r\n"]
[10.084273, "o", "dependencies:"]
[10.084367, "o", "\r\n  - python=3.10\r\n  - numpy=1.22.0\r\n  - scipy=1.9.0   \r\n  - pandas=1.4.0\r\n  - tensorflow=2.8.0   \r\n  - pytorch=1.12.0   \r\n  - cudatoolkit=11.2   "]
[10.084413, "o", "\r\n  - scikit-learn=1.0.2"]
[10.084577, "o", "\r\n"]
