[495.956983, "i", "cat > gfit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\nd = np.loadtxt('graphene.dat', delimiter=None,\n   converters={0: lambda s: float(str(s).replace(',','.')), 1: lambda s: float(str(s).replace(',','.'))})\nx=d[:,0]; y=d[:,1]; o=np.argsort(x); x=x[o]; y=y[o]\nmfit=(x>1649)&(x<30000)\nxf=x[mfit]; yf=y[mfit]\ndef lor(x,x0,g,a): return a*g**2/((x-x0)**2+g**2)\ndef model(x,p):\n    poly=np.polyval(p[:6], x)\n    return poly + lor(x,p[6],p[7],p[8]) + lor(x,p[9],p[10],p[11])\ndeg=5\npc=np.polyfit(xf,yf,deg)\np0=list(pc)+[10431,340,10000,19222,430,70000]\nlb=[[-np.inf]]*6 + [[0,1,0,0,1,0]]\npopt,_=curve_fit(model,xf,yf,p0=p0,bounds=([-1e9]*6+[0,0,0,0,0,0]),maxfev=400000)\npoly=np.polyval(popt[:6], xf)\nresid=yf-model(xf,popt)\nrms=np.sqrt(np.mean(resid**2))\nprint('global RMS=%.1f'%rms)\nprint('poly coeffs',popt[:6])\nx0g,gg,ag=popt[6],popt[7],popt[8]\nx02,g2,a2=popt[9],popt[10],popt[11]\noff_g=np.polyval(popt[:6],x0g)\noff_2=np.polyval(popt[:6],x02)\nprint('G  x0=%.2f gamma=%.2f amp=%.2f offset=%.2f"]
[495.957034, "i", "'%(x0g,gg,ag,off_g))\nprint('2D x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x02,g2,a2,off_2))\nG={'x0':float(x0g),'gamma':float(gg),'amplitude':float(ag),'offset':float(off_g)}\nD={'x0':float(x02),'gamma':float(g2),'amplitude':float(a2),'offset':float(off_2)}\nwith open('results.json','w') as f: json.dump({'G':G,'2D':D},f,indent=2)\nprint('\\nFINAL'); print(json.dumps({'G':G,'2D':D},indent=2))\nEOF\npython3 gfit.py\n"]
