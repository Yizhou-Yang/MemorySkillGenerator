[451.189788, "i", "cat > final.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\nd = np.loadtxt('graphene.dat', delimiter=None,\n   converters={0: lambda s: float(str(s).replace(',','.')), 1: lambda s: float(str(s).replace(',','.'))})\nx=d[:,0]; y=d[:,1]; o=np.argsort(x); x=x[o]; y=y[o]\ndef lor(x,off,x0,g,a): return off + a*g**2/((x-x0)**2+g**2)\ndef fit(w,p0):\n    m=(x>=w[0])&(x<=w[1])\n    p,_=curve_fit(lor,x[m],y[m],p0=p0,maxfev=300000)\n    return p\nfor w in [(9000,11900),(9500,11300)]:\n    p=fit(w,[9000,10431,347,10578]); print('G win',w,'off=%.1f x0=%.1f gamma=%.1f amp=%.1f'%(p[0],p[1],p[2],p[3]))\nfor w in [(17600,20900),(18000,19800)]:\n    p=fit(w,[14000,19222,426,70088]); print('2D win',w,'off=%.1f x0=%.1f gamma=%.1f amp=%.1f'%(p[0],p[1],p[2],p[3]))\n# final write using (9000,11900) and (17600,20900)\nG=fit((9000,11900),[9000,10431,347,10578])\nD=fit((17600,20900),[14000,19222,426,70088])\nres={\"G\":{\"x0\":float(G[1]),\"gamma\":float(abs(G[2])),\"amplitude\""]
[451.190237, "o", "cat > final.py << 'EOF'\r\n\u001b[?2004l\r"]
[451.190482, "o", "\u001b[?2004h"]
[451.190893, "o", "> "]
