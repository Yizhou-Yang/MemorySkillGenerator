[161.73757, "i", "cat > explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nd = np.loadtxt('graphene.dat', delimiter=None, converters={0: lambda s: float(str(s).replace(',','.')), 1: lambda s: float(str(s).replace(',','.'))})\nx = d[:,0]; y = d[:,1]\no = np.argsort(x); x=x[o]; y=y[o]\npk,_ = find_peaks(y, height=y.max()*0.03, distance=10)\nprint('num peaks', len(pk))\nfor p in pk:\n    print('peak x=%.2f y=%.1f' % (x[p], y[p]))\n# coarse overview\nnb=60\nedges=np.linspace(x.min(),x.max(),nb+1)\nfor i in range(nb):\n    m=(x>=edges[i])&(x<edges[i+1])\n    if m.sum()==0: continue\n    print('%.0f-%.0f  ymax=%.0f' % (edges[i],edges[i+1],y[m].max()))\nEOF\npython3 explore.py\n"]
[161.738121, "o", "cat > explore.py << 'EOF'"]
