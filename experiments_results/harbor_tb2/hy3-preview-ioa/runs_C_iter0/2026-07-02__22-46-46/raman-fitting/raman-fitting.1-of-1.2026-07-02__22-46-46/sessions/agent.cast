[528.906149, "o", "004l\r\u001b[?2004h> rms=np.sqrt(np.mean(resid**2))\r\n\u001b[?2004l\r\u001b[?2004h> print('global RMS=%.1f'%rms)\r\n\u001b[?2004l\r\u001b[?2004h> x0g,gg,ag=popt[6],popt[7],popt[8]\r\n\u001b[?2004l\r\u001b[?2004h> x02,g2,a2=popt[9],popt[10],popt[11]\r\n\u001b[?2004l\r\u001b[?2004h> off_g=np.polyval(popt[:6],x0g)\r\n\u001b[?2004l\r\u001b[?2004h> off_2=np.polyval(popt[:6],x02)\r\n\u001b[?2004l\r\u001b[?2004h> print('G  x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x0g,gg,ag,off_g))\r\n\u001b[?2004l\r\u001b[?2004h> print('2D x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x02,g2,a2,off_2))\r\n\u001b[?2004l\r\u001b[?2004h> G={'x0':float(x0g),'gamma':float(gg),'amplitude':float(ag),'offset':float(off_g)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.907088, "o", "D={'x0':float(x02),'gamma':float(g2),'amplitude':float(a2),'offset':float(off_2)}\r\n\u001b[?2004l\r\u001b[?2004h> with open('results.json','w') as f: json.dump({'G':G,'2D':D},f,indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print('\\nFINAL'); print(json.dumps({'G':G,'2D':D},indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
