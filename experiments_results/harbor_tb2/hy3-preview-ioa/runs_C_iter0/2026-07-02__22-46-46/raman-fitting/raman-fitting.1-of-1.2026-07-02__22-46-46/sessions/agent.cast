[554.454677, "i", "cat > gfit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\nd = np.loadtxt('graphene.dat', delimiter=None,\n   converters={0: lambda s: float(str(s).replace(',','.')), 1: lambda s: float(str(s).replace(',','.'))})\nx=d[:,0]; y=d[:,1]; o=np.argsort(x); x=x[o]; y=y[o]\nmfit=(x>1649)&(x<30000)\nxf=x[mfit]; yf=y[mfit]\nxref=(xf.max()+xf.min())/2.0\nxscale=(xf.max()-xf.min())/2.0\nxs=(xf-xref)/xscale\nDEG=4\ndef model(xs,*p):\n    c=p[:DEG+1]; x0g,gg,ag,x02,g2,a2=p[DEG+1],p[DEG+2],p[DEG+3],p[DEG+4],p[DEG+5],p[DEG+6]\n    poly=np.polyval(c, xs)\n    lorG=ag*gg**2/((xs-x0g)**2+gg**2)\n    lor2=a2*g2**2/((xs-x02)**2+g2**2)\n    return poly+lorG+lor2\npc=np.polyfit(xs,yf,DEG)\n# initial lorentzian params in normalized units\nx0g0=(10431-xref)/xscale; gg0=340/xscale; ag0=10000\nx02_0=(19222-xref)/xscale; g20=430/xscale; a20=70000\np0=list(pc)+[x0g0,gg0,ag0,x02_0,g20,a20]\nlb=[-1e15]*(DEG+1)+[-3,1e-3,0,-3,1e-3,0]\nub=[ 1e15]*(DEG+1)+[ 3,3,  1e9, 3,3,  1e9]\npopt,_=curve_fit(model,xs,yf,p0=p0,bounds=(lb,ub),maxf"]
[554.459385, "i", "ev=600000)\nresid=yf-model(xs,*popt)\nrms=np.sqrt(np.mean(resid**2))\nx0g= popt[DEG+1]*xscale+xref; gg=popt[DEG+2]*xscale; ag=popt[DEG+3]\nx02= popt[DEG+4]*xscale+xref; g2=popt[DEG+5]*xscale; a2=popt[DEG+6]\noff_g=np.polyval(popt[:DEG+1], (x0g-xref)/xscale)\noff_2=np.polyval(popt[:DEG+1], (x02-xref)/xscale)\nprint('global RMS=%.1f  (G h=%.0f, 2D h=%.0f)'%(rms,ag, a2))\nprint('G  x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x0g,gg,ag,off_g))\nprint('2D x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x02,g2,a2,off_2))\nG={'x0':float(x0g),'gamma':float(gg),'amplitude':float(ag),'offset':float(off_g)}\nD={'x0':float(x02),'gamma':float(g2),'amplitude':float(a2),'offset':float(off_2)}\nwith open('results.json','w') as f: json.dump({'G':G,'2D':D},f,indent=2)\nprint('\\nFINAL'); print(json.dumps({'G':G,'2D':D},indent=2))\nEOF\npython3 gfit.py\n"]
[554.459702, "o", "cat > gfit.py << 'EOF'"]
