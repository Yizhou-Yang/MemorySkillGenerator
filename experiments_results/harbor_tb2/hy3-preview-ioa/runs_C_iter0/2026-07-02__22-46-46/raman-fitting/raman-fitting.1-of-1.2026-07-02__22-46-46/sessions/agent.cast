[612.177003, "i", "cat > fit8.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\nd = np.loadtxt('graphene.dat', delimiter=None,\n   converters={0: lambda s: float(str(s).replace(',','.')), 1: lambda s: float(str(s).replace(',','.'))})\nx=d[:,0]; y=d[:,1]; o=np.argsort(x); x=x[o]; y=y[o]\ndef lor(x,x0,g,a): return a*g**2/((x-x0)**2+g**2)\ndef model(x,*p):\n    offG,x0g,gg,ag,off2,x02,g2,a2=p\n    return offG+lor(x,x0g,gg,ag)+off2+lor(x,x02,g2,a2)\nm=(x>9000)&(x<21000)\nxf=x[m]; yf=y[m]\np0=[9000,10431,340,10000,14000,19222,430,70000]\nlb=[0,10000,1,0,0,18000,1,0]\nub=[2e5,11000,2000,1e5,2e5,20000,2000,1e6]\npopt,pcov=curve_fit(model,xf,yf,p0=p0,bounds=(lb,ub),maxfev=600000)\nrms=np.sqrt(np.mean((yf-model(xf,*popt))**2))\noffG,x0g,gg,ag,off2,x02,g2,a2=popt\nprint('8-param RMS=%.1f'%(rms))\nprint('G  x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x0g,gg,ag,offG))\nprint('2D x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x02,g2,a2,off2))\nprint('total offset (offG+off2)=%.2f'%(offG+off2))\nG={'x0':float(x0g),'gamma':float(gg),'ampl"]
[612.177062, "i", "itude':float(ag),'offset':float(offG)}\nD={'x0':float(x02),'gamma':float(g2),'amplitude':float(a2),'offset':float(off2)}\nwith open('results.json','w') as f: json.dump({'G':G,'2D':D},f,indent=2)\nprint('\\nWROTE results.json'); print(json.dumps({'G':G,'2D':D},indent=2))\nEOF\npython3 fit8.py\n"]
[612.177234, "o", "cat > fit8.py << 'EOF'\r\n"]
