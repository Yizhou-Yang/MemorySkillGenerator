[268.919865, "o", "    m = (x>=xwin[0]) & (x<=xwin[1])"]
[268.921221, "o", "\r\n"]
[268.931268, "o", "\u001b[?2004l\r"]
[268.933499, "o", "\u001b[?2004h"]
[268.933731, "o", "> "]
[268.933956, "o", "    xn = x[m]; yn = y[m]"]
[268.93409, "o", "\r\n"]
[268.934281, "o", "\u001b[?2004l\r"]
[268.934409, "o", "\u001b[?2004h"]
[268.9347, "o", ">     popt, pcov = curve_fit(lor, xn, yn, p0=p0, maxfev=200000)"]
[268.934831, "o", "\r\n"]
[268.934979, "o", "\u001b[?2004l\r"]
[268.935137, "o", "\u001b[?2004h"]
[268.935276, "o", "> "]
[268.935514, "o", "    offset, x0, gamma, amp = popt"]
[268.935645, "o", "\r\n"]
[268.935775, "o", "\u001b[?2004l\r"]
[268.935957, "o", "\u001b[?2004h"]
[268.93621, "o", "> "]
[268.936316, "o", "    resid = yn - lor(xn, *popt)"]
[268.93645, "o", "\r\n"]
[268.936881, "o", "\u001b[?2004l\r\u001b[?2004h"]
[268.937634, "o", "> "]
[268.938618, "o", "    rms = np.sqrt(np.mean(resid**2))"]
[268.95348, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     pk = yn.max() - offset\r\n\u001b[?2004l\r\u001b[?2004h>     print('guess x0=%.1f' % x0_guess)\r\n\u001b[?2004l\r\u001b[?2004h>     print('  offset=%.3f  x0=%.3f  gamma=%.3f  amp=%.3f' % (offset,x0,gamma,amp))\r\n\u001b[?2004l\r\u001b[?2004h>     print('  rms=%.2f  peakheight=%.2f  rms/height=%.3f' % (rms, pk, rms/max(pk,1)))\r\n\u001b[?2004l\r\u001b[?2004h>     return dict(x0=float(x0), gamma=float(abs(gamma)), amplitude=float(amp), offset=float(offset))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # G peak around 10500\r\n\u001b[?2004l\r\u001b[?2004h> G = fit_peak(10500, (9600, 11500), p0=[12000, 10500, 400, 7000])\r\n\u001b[?2004l\r\u001b[?2004h> # 2D peak around 19139\r\n\u001b[?2004l\r\u001b[?2004h> D = fit_peak(19139, (18000, 19800), p0=[28000, 19139, 500, 52000])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> res = {\"G\": G, \"2D\": D}\r\n\u001b[?2004l\r\u001b[?2004h> with open('results.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(res, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print('\\nWROTE results.json')\r\n\u001b[?2004l\r\u001b[?2004h> print(json.dumps(res, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[268.971243, "o", "\u001b[?2004hroot@0ee6ec3050e7:/app# python3 fit.py\r\n\u001b[?2004l\r"]
