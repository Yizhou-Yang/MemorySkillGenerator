[120.049464, "i", "cat > explore.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\n\nd = np.loadtxt('graphene.dat', delimiter=None, converters={0: lambda s: float(s.decode().replace(',','.')), 1: lambda s: float(s.decode().replace(',','.'))})\nx = d[:,0]; y = d[:,1]\nprint('x range', x.min(), x.max(), 'n', len(x))\nprint('y range', y.min(), y.max())\n# sort ascending\no = np.argsort(x)\nx = x[o]; y = y[o]\npk, props = find_peaks(y, height=y.max()*0.3, distance=20)\nfor p in pk:\n    print('peak at x=%.1f y=%.1f' % (x[p], y[p]))\nprint('global max x,y', x[np.argmax(y)], y.max())\nEOF\npython3 explore.py\n"]
[120.049913, "o", "cat > explore.py << 'EOF'"]
