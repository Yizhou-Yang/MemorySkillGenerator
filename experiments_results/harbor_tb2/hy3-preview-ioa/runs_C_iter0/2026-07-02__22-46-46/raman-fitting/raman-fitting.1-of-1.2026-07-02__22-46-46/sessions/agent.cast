[554.470749, "o", "\u001b[?2004l\r"]
[554.470865, "o", "\u001b[?2004h"]
[554.47543, "o", "> xref=(xf.max()+xf.min())/2.0\r\n\u001b[?2004l\r\u001b[?2004h> xscale=(xf.max()-xf.min())/2.0\r\n\u001b[?2004l\r\u001b[?2004h> xs=(xf-xref)/xscale\r\n\u001b[?2004l\r\u001b[?2004h> DEG=4\r\n\u001b[?2004l\r\u001b[?2004h> def model(xs,*p):\r\n\u001b[?2004l\r\u001b[?2004h>     c=p[:DEG+1]; x0g,gg,ag,x02,g2,a2=p[DEG+1],p[DEG+2],p[DEG+3],p[DEG+4],p[DEG+5],p[DEG+6]\r\n\u001b[?2004l\r\u001b[?2004h>     poly=np.polyval(c, xs)\r\n\u001b[?2004l\r\u001b[?2004h>     lorG=ag*gg**2/((xs-x0g)**2+gg**2)\r\n\u001b[?2004l\r\u001b[?2004h>     lor2=a2*g2**2/((xs-x02)**2+g2**2)\r\n\u001b[?2004l\r\u001b[?2004h>     return poly+lorG+lor2\r\n\u001b[?2004l\r\u001b[?2004h> pc=np.polyfit(xs,yf,DEG)\r\n\u001b[?2004l\r\u001b[?2004h> # initial lorentzian params in normalized units\r\n\u001b[?2004l\r\u001b[?2004h> x0g0=(10431-xref)/xscale; gg0=340/xscale; ag0=10000\r\n\u001b[?2004l\r\u001b[?2004h> x02_0=(19222-xref)/xscale; g20=430/xscale; a20=70000\r\n\u001b[?2004l\r\u001b[?2004h> p0=list(pc)+[x0g0,gg0,ag0,x02_0,g20,a20]\r\n\u001b[?2004l\r\u001b[?2004h> lb=[-1e15]*(DEG+1)+[-3,1e-3,0,-3,1e-3,0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[554.47579, "o", "ub=[ 1e15]*(DEG+1)+[ 3,3,  1e9, 3,3,  1e9]\r\n\u001b[?2004l\r"]
[554.475851, "o", "\u001b[?2004h"]
[554.475879, "o", "> "]
[554.476038, "o", "popt,_=curve_fit(model,xs,yf,p0=p0,bounds=(lb,ub),maxfev=600000)"]
[554.476548, "o", "\r\n"]
[554.476746, "o", "\u001b[?2004l\r"]
[554.476911, "o", "\u001b[?2004h"]
[554.477067, "o", "> "]
[554.477597, "o", "resid=yf-model(xs,*popt)\r\n\u001b[?2004l\r\u001b[?2004h> rms=np.sqrt(np.mean(resid**2))\r\n\u001b[?2004l\r\u001b[?2004h> x0g= popt[DEG+1]*xscale+xref; gg=popt[DEG+2]*xscale; ag=popt[DEG+3]\r\n\u001b[?2004l\r"]
[554.47777, "o", "\u001b[?2004h"]
[554.477908, "o", "> "]
[554.478206, "o", "x02= popt[DEG+4]*xscale+xref; g2=popt[DEG+5]*xscale; a2=popt[DEG+6]"]
[554.478354, "o", "\r\n"]
[554.478487, "o", "\u001b[?2004l\r"]
[554.478684, "o", "\u001b[?2004h"]
[554.478819, "o", "> "]
[554.479103, "o", "off_g=np.polyval(popt[:DEG+1], (x0g-xref)/xscale)"]
[554.480125, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> off_2=np.polyval(popt[:DEG+1], (x02-xref)/xscale)\r\n\u001b[?2004l\r\u001b[?2004h> print('global RMS=%.1f  (G h=%.0f, 2D h=%.0f)'%(rms,ag, a2))\r\n\u001b[?2004l\r\u001b[?2004h> print('G  x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x0g,gg,ag,off_g))\r\n\u001b[?2004l\r\u001b[?2004h> print('2D x0=%.2f gamma=%.2f amp=%.2f offset=%.2f'%(x02,g2,a2,off_2))\r\n\u001b[?2004l\r\u001b[?2004h> G={'x0':float(x0g),'gamma':float(gg),'amplitude':float(ag),'offset':float(off_g)}"]
[554.480317, "o", "\r\n"]
[554.480441, "o", "\u001b[?2004l\r"]
[554.480608, "o", "\u001b[?2004h"]
[554.480744, "o", "> "]
[554.481069, "o", "D={'x0':float(x02),'gamma':float(g2),'amplitude':float(a2),'offset':float(off_2)}"]
[554.481271, "o", "\r\n"]
[554.481367, "o", "\u001b[?2004l\r"]
[554.481805, "o", "\u001b[?2004h> with open('results.json','w') as f: json.dump({'G':G,'2D':D},f,indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[554.481975, "o", "> "]
[554.482225, "o", "print('\\nFINAL'); print(json.dumps({'G':G,'2D':D},indent=2))"]
[554.482351, "o", "\r\n"]
[554.482491, "o", "\u001b[?2004l\r"]
[554.482657, "o", "\u001b[?2004h> "]
[554.482785, "o", "EOF"]
[554.482935, "o", "\r\n"]
[554.483088, "o", "\u001b[?2004l\r"]
[554.489784, "o", "\u001b[?2004h"]
[554.490172, "o", "root@0ee6ec3050e7:/app# "]
