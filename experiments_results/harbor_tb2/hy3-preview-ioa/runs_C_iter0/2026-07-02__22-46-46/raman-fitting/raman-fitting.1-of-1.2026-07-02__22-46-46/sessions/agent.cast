[377.089931, "i", "cat > check.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nd = np.loadtxt('graphene.dat', delimiter=None,\n   converters={0: lambda s: float(str(s).replace(',','.')), 1: lambda s: float(str(s).replace(',','.'))})\nx=d[:,0]; y=d[:,1]; o=np.argsort(x); x=x[o]; y=y[o]\ndef model(x,c,xg,gamg,ampg,xd,gamd,ampd):\n    return c + ampg*gamg**2/((x-xg)**2+gamg**2) + ampd*gamd**2/((x-xd)**2+gamd**2)\nm=(x>9000)&(x<20000)\np,_=curve_fit(model,x[m],y[m],p0=[9000,10400,350,10000,19200,430,70000],maxfev=300000)\nprint('combined: c=%.1f xg=%.1f gamg=%.1f x2d=%.1f gam2d=%.1f'%(p[0],p[1],p[2],p[4],p[5]))\nEOF\npython3 check.py\n"]
