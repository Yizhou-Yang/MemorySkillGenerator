[268.900827, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\nd = np.loadtxt('graphene.dat', delimiter=None,\n               converters={0: lambda s: float(str(s).replace(',','.')),\n                           1: lambda s: float(str(s).replace(',','.'))})\nx = d[:,0]; y = d[:,1]\no = np.argsort(x); x = x[o]; y = y[o]\n\ndef lor(x, offset, x0, gamma, amp):\n    return offset + amp*gamma**2/((x-x0)**2 + gamma**2)\n\ndef fit_peak(x0_guess, xwin, p0):\n    m = (x>=xwin[0]) & (x<=xwin[1])\n    xn = x[m]; yn = y[m]\n    popt, pcov = curve_fit(lor, xn, yn, p0=p0, maxfev=200000)\n    offset, x0, gamma, amp = popt\n    resid = yn - lor(xn, *popt)\n    rms = np.sqrt(np.mean(resid**2))\n    pk = yn.max() - offset\n    print('guess x0=%.1f' % x0_guess)\n    print('  offset=%.3f  x0=%.3f  gamma=%.3f  amp=%.3f' % (offset,x0,gamma,amp))\n    print('  rms=%.2f  peakheight=%.2f  rms/height=%.3f' % (rms, pk, rms/max(pk,1)))\n    return dict(x0=float(x0), gamma=float(abs(gamma)), amplitude=float(amp), offset=float(offs"]
[268.901678, "o", "cat > fit.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> d = np.loadtxt('graphene.dat', delimiter=None,\r\n\u001b[?2004l\r\u001b[?2004h>                converters={0: lambda s: float(str(s).replace(',','.')),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.901715, "i", "et))\n\n# G peak around 10500\nG = fit_peak(10500, (9600, 11500), p0=[12000, 10500, 400, 7000])\n# 2D peak around 19139\nD = fit_peak(19139, (18000, 19800), p0=[28000, 19139, 500, 52000])\n\nres = {\"G\": G, \"2D\": D}\nwith open('results.json','w') as f:\n    json.dump(res, f, indent=2)\nprint('\\nWROTE results.json')\nprint(json.dumps(res, indent=2))\nEOF\npython3 fit.py\n"]
