[451.203763, "i", ":float(G[3]),\"offset\":float(G[0])},\n     \"2D\":{\"x0\":float(D[1]),\"gamma\":float(abs(D[2])),\"amplitude\":float(D[3]),\"offset\":float(D[0])}}\nwith open('results.json','w') as f: json.dump(res,f,indent=2)\nprint('\\nFINAL'); print(json.dumps(res,indent=2))\nEOF\npython3 final.py\n"]
