[163.244261, "i", "cat > /tmp/explore2.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open(\"chess_puzzle.png\").convert(\"RGB\")\narr = np.array(im).astype(int)\n# build set of colors\ncolors, counts = np.unique(arr.reshape(-1,3), axis=0, return_counts=True)\norder = np.argsort(-counts)\nfor i in order[:25]:\n    print(colors[i], counts[i])\nEOF\npython3 /tmp/explore2.py\n"]
