[648.68795, "i", "cat > /tmp/final.py << 'EOF'\nimport chess\nfen = \"r1bn1r2/1p3pp1/p1q1p3/3qPkbP/8/P1N5/1P2QPP1/R1B1K2R w KQ - 0 1\"\nb = chess.Board(fen)\nmates=[]\nfor m in b.legal_moves:\n    b.push(m)\n    if b.is_checkmate():\n        mates.append(m.uci())\n    b.pop()\nprint(\"mate-in-1 moves:\", mates)\nwith open(\"/app/move.txt\",\"w\") as f:\n    f.write(\"\\n\".join(mates)+\"\\n\")\nprint(\"written\")\nEOF\npython3 /tmp/final.py\n"]
