[199.612141, "i", "cat > /tmp/detect.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open(\"chess_puzzle.png\").convert(\"RGB\")\narr = np.array(im).astype(int)\nbg_light = np.array([240,217,181])\nbg_dark = np.array([181,136,99])\n\ndef is_bg(p):\n    return (np.abs(p-bg_light).sum()<40) or (np.abs(p-bg_dark).sum()<40)\n\nfor r in range(8):\n    row=''\n    for c in range(8):\n        sq = arr[r*80:(r+1)*80, c*80:(c+1)*80]\n        flat = sq.reshape(-1,3)\n        # foreground mask\n        diff = np.minimum(np.abs(flat-bg_light).sum(1), np.abs(flat-bg_dark).sum(1))\n        fg = diff>40\n        nf = fg.sum()\n        if nf < 50:\n            row+=' . '\n            continue\n        fgpix = flat[fg]\n        wht = (fgpix.min(1)>180).sum()\n        blk = (fgpix.max(1)<80).sum()\n        # determine color by majority interior\n        if wht > blk:\n            row+=' W '\n        else:\n            row+=' B '\n    print(r, row)\nEOF\npython3 /tmp/detect.py\n"]
[199.613241, "o", "cat > /tmp/detect.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image"]
