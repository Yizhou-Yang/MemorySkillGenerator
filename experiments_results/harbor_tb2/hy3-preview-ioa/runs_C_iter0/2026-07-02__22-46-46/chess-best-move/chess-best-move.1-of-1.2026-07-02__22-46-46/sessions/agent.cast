[149.775728, "i", "cat > /tmp/explore.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open(\"chess_puzzle.png\").convert(\"RGB\")\narr = np.array(im)\nprint(\"shape\", arr.shape)\n# squares 80px\n# sample colors of corners and centers\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        sq = arr[r*80:(r+1)*80, c*80:(c+1)*80]\n        # classify: count dark/light of square bg by corner pixels\n        corners = sq[[2,2,77,77],[2,77,2,77]]\n        row.append(tuple(corners[0].tolist()))\n    print(r, row)\nEOF\npython3 /tmp/explore.py\n"]
