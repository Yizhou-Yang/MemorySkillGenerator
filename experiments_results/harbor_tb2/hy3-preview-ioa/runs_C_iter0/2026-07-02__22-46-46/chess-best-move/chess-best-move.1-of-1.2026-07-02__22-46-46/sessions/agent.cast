[469.0856, "o", "arr = np.array(im).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[469.085742, "o", "bg_l=np.array([240,217,181]); bg_d=np.array([181,136,99])"]
[469.085853, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
