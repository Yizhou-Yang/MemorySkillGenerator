[313.459175, "i", "cat > /tmp/cluster.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open(\"chess_puzzle.png\").convert(\"RGB\")\narr = np.array(im).astype(int)\nbg_l=np.array([240,217,181]); bg_d=np.array([181,136,99])\n\ndef fg(sq):\n    flat=sq.reshape(-1,3).astype(int)\n    d=np.minimum(np.abs(flat-bg_l).sum(1),np.abs(flat-bg_d).sum(1)).reshape(80,80)\n    return (d>45).astype(np.uint8)\n\ndef color_of(r,c):\n    sq=arr[r*80:(r+1)*80,c*80:(c+1)*80]\n    flat=sq.reshape(-1,3); d=np.minimum(np.abs(flat-bg_l).sum(1),np.abs(flat-bg_d).sum(1))\n    f=flat[d>45]\n    wht=(f.min(1)>180).sum(); blk=(f.max(1)<80).sum()\n    return 'W' if wht>blk else 'B'\n\nocc=[]\nfor r in range(8):\n    for c in range(8):\n        sq=arr[r*80:(r+1)*80,c*80:(c+1)*80]\n        if fg(sq).sum()<50: continue\n        col=color_of(r,c)\n        # normalize: crop to bounding box of fg, resize to 40x40\n        mask=fg(sq)\n        ys,xs=np.where(mask)\n        crop=mask[ys.min():ys.max()+1, xs.min():xs.max()+1]\n        # downscale to 32x32 by sampling\n        H,W=crop.shape\n        out=np.zeros((32,32),np.uint8)\n        for i in range(32):\n            for j in range(32):\n                yy=ys.min()+int((i+0.5)*H/32); xx=xs.min()+int((j+0.5)*W/32)\n                out[i,j]=mask[min(yy,79),min(xx,79)]\n        occ.append((r,c,col,out))\n\n# cluster within color\nfor col in ['W','B']:\n    items=[o for o in occ if o[2]==col]\n    clusters=[]\n    for it in items:\n        placed=False\n        for cl in clusters:\n            rep=cl[0][3]\n            dist=(rep!=it[3]).sum()\n            if dist<90:\n                cl.append(it); placed=True; break\n        if not placed:\n            clusters.append([it])\n    print(f\"--- color {col}: {len(clusters)} clusters ---\")\n    for cl in clusters:\n        members=[(o[0],o[1]) for o in cl]\n        print(\"  rep\",cl[0][0],cl[0][1],\"count\",len(cl),\"members\",members)\nEOF\npython3 /tmp/cluster.py\n"]
[313.471876, "o", "cat > /tmp/cluster.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> im = Image.open(\"chess_puzzle.png\").convert(\"RGB\")\r\n\u001b[?2004l\r\u001b[?2004h> arr = np.array(im).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> bg_l=np.array([240,217,181]); bg_d=np.array([181,136,99])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fg(sq):\r\n\u001b[?2004l\r\u001b[?2004h>     flat=sq.reshape(-1,3).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h>     d=np.minimum(np.abs(flat-bg_l).sum(1),np.abs(flat-bg_d).sum(1)).reshape(80,80)\r\n\u001b[?2004l\r\u001b[?2004h>     return (d>45).astype(np.uint8)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def color_of(r,c):\r\n\u001b[?2004l\r\u001b[?2004h>     sq=arr[r*80:(r+1)*80,c*80:(c+1)*80]\r\n\u001b[?2004l\r\u001b[?2004h>     flat=sq.reshape(-1,3); d=np.minimum(np.abs(flat-bg_l).sum(1),np.abs(flat-bg_d).sum(1))\r\n\u001b[?2004l\r\u001b[?2004h>     f=flat[d>45]\r\n\u001b[?2004l\r\u001b[?2004h>     wht=(f.min(1)>180).sum(); blk=(f.max(1)<80).sum()\r\n\u001b[?2004l\r\u001b[?2004h>     return 'W' if wht>blk else 'B'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> occ=[]\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>     for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>         sq=arr[r*80:(r+1)*80,c*80:(c+1)*80]\r\n\u001b[?2004l\r\u001b[?2004h>         if fg(sq).sum()<50: continue\r\n\u001b[?2004l\r\u001b[?2004h>         col=color_of(r,c)\r\n\u001b[?2004l\r\u001b[?2004h>         # normalize: crop to bounding box of fg, resize to 40x40\r\n\u001b[?2004l\r\u001b[?2004h>         mask=fg(sq)\r\n\u001b[?2004l\r\u001b[?2004h>         ys,xs=np.where(mask)\r\n\u001b[?2004l\r\u001b[?2004h>         crop=mask[ys.min():ys.max()+1, xs.min():xs.max()+1]\r\n\u001b[?2004l\r\u001b[?2004h>         # downscale to 32x32 by sampling\r\n\u001b[?2004l\r\u001b[?2004h>         H,W=crop.shape\r\n\u001b[?2004l\r\u001b[?2004h>         out=np.zeros((32,32),np.uint8)\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(32):\r\n\u001b[?2004l\r\u001b[?2004h>             for j in range(32):\r\n\u001b[?2004l\r\u001b[?2004h>                 yy=ys.min()+int((i+0.5)*H/32); xx=xs.min()+int((j+0.5)*W/32)"]
