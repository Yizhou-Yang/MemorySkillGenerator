[469.086235, "o", "    d=min(np.abs(p-bg_l).sum(),np.abs(p-bg_d).sum())\r\n\u001b[?2004l\r\u001b[?2004h>     if d<40: return ' '\r\n\u001b[?2004l\r\u001b[?2004h>     if p.max()<80: return '#'\r\n\u001b[?2004l\r"]
