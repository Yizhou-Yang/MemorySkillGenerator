[565.393668, "i", "cat > /tmp/solve.py << 'EOF'\nimport chess\nfen = \"r1bn1r2/1p3pp1/p1q1p3/3qPkbP/8/P1N5/1P2QPP1/R1B1K2R w KQ - 0 1\"\nb = chess.Board(fen)\nprint(\"status:\", b.status())\nprint(b)\nprint(\"turn white:\", b.turn==chess.WHITE)\nprint(\"legal moves:\", b.legal_moves.count())\nMATE=100000\nvals={chess.PAWN:100,chess.KNIGHT:320,chess.BISHOP:330,chess.ROOK:500,chess.QUEEN:900,chess.KING:0}\ndef evaluate(bd):\n    s=0\n    for pt in vals:\n        s+=vals[pt]*(len(bd.pieces(pt,chess.WHITE))-len(bd.pieces(pt,chess.BLACK)))\n    return s\ndef negamax(bd,depth,ply,alpha,beta):\n    if bd.is_checkmate(): return -(MATE-ply)\n    if bd.is_stalemate() or bd.is_insufficient_material(): return 0\n    if depth==0:\n        sign=1 if bd.turn==chess.WHITE else -1\n        return sign*evaluate(bd)\n    best=-10**9\n    moves=list(bd.legal_moves)\n    moves.sort(key=lambda m:-( (int(bd.gives_check(m)))*10 + int(bd.is_capture(m))*5 ))\n    for m in moves:\n        bd.push(m)\n        v=-negamax(bd,depth-1,ply+1,-bet"]
