[565.399838, "o", "\u001b[?2004h> def negamax(bd,depth,ply,alpha,beta):\r\n\u001b[?2004l\r\u001b[?2004h>     if bd.is_checkmate(): return -(MATE-ply)\r\n\u001b[?2004l\r\u001b[?2004h>     if bd.is_stalemate() or bd.is_insufficient_material(): return 0\r\n\u001b[?2004l\r\u001b[?2004h>     if depth==0:\r\n\u001b[?2004l\r\u001b[?2004h>         sign=1 if bd.turn==chess.WHITE else -1\r\n\u001b[?2004l\r\u001b[?2004h>         return sign*evaluate(bd)\r\n\u001b[?2004l\r\u001b[?2004h>     best=-10**9\r\n\u001b[?2004l\r\u001b[?2004h>     moves=list(bd.legal_moves)\r\n\u001b[?2004l\r\u001b[?2004h>     moves.sort(key=lambda m:-( (int(bd.gives_check(m)))*10 + int(bd.is_capture(m))*5 ))\r\n\u001b[?2004l\r\u001b[?2004h>     for m in moves:"]
[565.3999, "i", "a,-alpha)\n        bd.pop()\n        if v>best: best=v\n        if best>alpha: alpha=best\n        if alpha>=beta: break\n    return best\ndef root(bd,depth):\n    res=[]\n    for m in bd.legal_moves:\n        bd.push(m)\n        v=-negamax(bd,depth-1,1,-10**9,10**9)\n        bd.pop()\n        res.append((v,m))\n    res.sort(key=lambda x:-x[0])\n    return res\nfor depth in range(1,8):\n    res=root(b,depth)\n    top=res[0][0]\n    print(f\"depth {depth}: best score {top}  move {res[0][1].uci()}\")\n    if top>=MATE-50:\n        # collect all moves achieving a forced mate at the same minimal distance\n        mates=[(v,m) for v,m in res if v>=MATE-50]\n        # minimal distance = highest score among these (closer mate => higher score)\n        best=max(v for v,m in mates)\n        winning=[m for v,m in mates if v==best]\n        print(\"FORCED MATE, distance plies:\", MATE-best)\n        print(\"winning moves:\", [m.uci() for m in winning])\n        break\nEOF\npython3 /tmp/solve.py\n"]
