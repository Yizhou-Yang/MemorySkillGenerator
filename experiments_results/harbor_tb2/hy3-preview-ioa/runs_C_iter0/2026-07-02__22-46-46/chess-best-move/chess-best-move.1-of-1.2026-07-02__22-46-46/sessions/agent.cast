[370.471064, "i", "cat > /tmp/cluster2.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open(\"chess_puzzle.png\").convert(\"RGB\")\narr = np.array(im).astype(int)\nbg_l=np.array([240,217,181]); bg_d=np.array([181,136,99])\n\ndef fg(sq):\n    flat=sq.reshape(-1,3).astype(int)\n    d=np.minimum(np.abs(flat-bg_l).sum(1),np.abs(flat-bg_d).sum(1)).reshape(80,80)\n    return (d>45).astype(np.int8)\n\ndef color_of(r,c):\n    sq=arr[r*80:(r+1)*80,c*80:(c+1)*80]\n    f=sq.reshape(-1,3); d=np.minimum(np.abs(f-bg_l).sum(1),np.abs(f-bg_d).sum(1))\n    fr=f[d>45]\n    wht=(fr.min(1)>180).sum(); blk=(fr.max(1)<80).sum()\n    return 'W' if wht>blk else 'B'\n\nocc=[]\nfor r in range(8):\n    for c in range(8):\n        sq=arr[r*80:(r+1)*80,c*80:(c+1)*80]\n        m=fg(sq)\n        if m.sum()<50: continue\n        ys,xs=np.where(m)\n        occ.append((r,c,color_of(r,c),m,m.sum(),ys.max()-ys.min()+1,xs.max()-xs.min()+1))\n\nfor col in ['B','W']:\n    items=[o for o in occ if o[2]==col]\n    clusters=[]\n    for it in items:\n        best=None;bd=1e9\n        for ci,cl in enumerate(clusters):\n            dist=(cl[0][3]!=it[3]).sum()\n            if dist<bd: bd=dist;best=ci\n        if best is not None and bd<200:\n            clusters[best].append(it)\n        else:\n            clusters.append([it])\n    print(f\"=== {col}: {len(clusters)} clusters ===\")\n    for cl in clusters:\n        mem=[(o[0],o[1]) for o in cl]\n        rep=cl[0]\n        print(f\"  rep({rep[0]},{rep[1]}) cnt={len(cl)} pix={rep[4]} HxW={rep[5]}x{rep[6]} mem={mem}\")\nEOF\npython3 /tmp/cluster2.py\n"]
[370.47147, "o", "cat > /tmp/cluster2.py << 'EOF'"]
[370.471825, "o", "\r\n\u001b[?2004l\r"]
[370.472925, "o", "\u001b[?2004h"]
[370.474059, "o", "> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> im = Image.open(\"chess_puzzle.png\").convert(\"RGB\")\r\n\u001b[?2004l\r\u001b[?2004h> arr = np.array(im).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> bg_l=np.array([240,217,181]); bg_d=np.array([181,136,99])"]
[370.478776, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fg(sq):\r\n\u001b[?2004l\r\u001b[?2004h>     flat=sq.reshape(-1,3).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[370.484733, "o", "    d=np.minimum(np.abs(flat-bg_l).sum(1),np.abs(flat-bg_d).sum(1)).reshape(80,80)\r\n\u001b[?2004l\r\u001b[?2004h>     return (d>45).astype(np.int8)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def color_of(r,c):\r\n\u001b[?2004l\r\u001b[?2004h>     sq=arr[r*80:(r+1)*80,c*80:(c+1)*80]\r\n\u001b[?2004l\r\u001b[?2004h>     f=sq.reshape(-1,3); d=np.minimum(np.abs(f-bg_l).sum(1),np.abs(f-bg_d).sum(1))\r\n\u001b[?2004l\r\u001b[?2004h>     fr=f[d>45]\r\n\u001b[?2004l\r\u001b[?2004h>     wht=(fr.min(1)>180).sum(); blk=(fr.max(1)<80).sum()\r\n\u001b[?2004l\r\u001b[?2004h>     return 'W' if wht>blk else 'B'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> occ=[]\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>     for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>         sq=arr[r*80:(r+1)*80,c*80:(c+1)*80]\r\n\u001b[?2004l\r\u001b[?2004h>         m=fg(sq)\r\n\u001b[?2004l\r\u001b[?2004h>         if m.sum()<50: continue\r\n\u001b[?2004l\r\u001b[?2004h>         ys,xs=np.where(m)\r\n\u001b[?2004l\r\u001b[?2004h>         occ.append((r,c,color_of(r,c),m,m.sum(),ys.max()-ys.min()+1,xs.max()-xs.min()+1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for col in ['B','W']:\r\n\u001b[?2004l\r\u001b[?2004h>     items=[o for o in occ if o[2]==col]\r\n\u001b[?2004l\r\u001b[?2004h>     clusters=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for it in items:\r\n\u001b[?2004l\r\u001b[?2004h>         best=None;bd=1e9\r\n\u001b[?2004l\r\u001b[?2004h>         for ci,cl in enumerate(clusters):\r\n\u001b[?2004l\r\u001b[?2004h>             dist=(cl[0][3]!=it[3]).sum()\r\n\u001b[?2004l\r\u001b[?2004h>             if dist<bd: bd=dist;best=ci\r\n\u001b[?2004l\r\u001b[?2004h>         if best is not None and bd<200:\r\n\u001b[?2004l\r\u001b[?2004h>             clusters[best].append(it)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             clusters.append([it])\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"=== {col}: {len(clusters)} clusters ===\")\r\n\u001b[?2004l\r\u001b[?2004h>     for cl in clusters:\r\n\u001b[?2004l\r\u001b[?2004h>         mem=[(o[0],o[1]) for o in cl]\r\n\u001b[?2004l\r\u001b[?2004h>         rep=cl[0]\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  rep({rep[0]},{rep[1]}) cnt={len(cl)} pix={rep[4]} HxW={rep[5]}x{rep[6]} mem={mem}\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
