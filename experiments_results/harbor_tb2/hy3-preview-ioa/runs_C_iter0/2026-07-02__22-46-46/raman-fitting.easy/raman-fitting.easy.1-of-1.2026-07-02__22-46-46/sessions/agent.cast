[668.369229, "i", "cat > /app/diag2.py << 'EOF'\nimport numpy as np\nx, y = np.loadtxt('/app/graphene_converted.dat', unpack=True)\nfor lo, hi, name in [(1500,1750,'G-ish'),(2550,2850,'2D-ish'),(18000,20000,'giant'),(1600,3000,'full-raman')]:\n    m=(x>lo)&(x<hi)\n    if m.sum():\n        print(name, 'x in',lo,hi,'n=',m.sum(),'y min',y[m].min(),'max',y[m].max(),'argmax x=',x[m][np.argmax(y[m])])\n    else:\n        print(name,'no points in range')\nEOF\npython3 /app/diag2.py\n"]
