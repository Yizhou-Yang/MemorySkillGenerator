[274.331238, "i", "2] - np.median(yd), np.median(yd)]\npopt, _ = curve_fit(lor, xd, yd, p0=p0, maxfev=100000)\nresults['2D'] = {'x0': float(popt[0]), 'gamma': float(abs(popt[1])), 'amplitude': float(popt[2]), 'offset': float(popt[3])}\n\nwith open('/app/results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint(json.dumps(results, indent=2))\nEOF\n"]
