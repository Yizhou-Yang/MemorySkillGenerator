[339.242669, "i", "cat > /app/diag.py << 'EOF'\nimport numpy as np\nx, y = np.loadtxt('/app/graphene_converted.dat', unpack=True)\nprint('n =', len(x))\nprint('x: min', x.min(), 'max', x.max())\nprint('y: min', y.min(), 'max', y.max())\nprint('x monotonic decreasing?', np.all(np.diff(x) < 0))\nprint('y monotonic decreasing?', np.all(np.diff(y) < 0))\n# top intensities\nidx = np.argsort(y)[::-1][:10]\nfor i in idx:\n    print('x=%.1f y=%.1f' % (x[i], y[i]))\nEOF\npython3 /app/diag.py\n"]
