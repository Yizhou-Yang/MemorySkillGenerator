[274.325684, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np\nimport json\nfrom scipy.optimize import curve_fit\n\n# Convert: replace decimal comma with dot\nwith open('/app/graphene.dat') as f:\n    data = f.read().replace(',', '.')\nwith open('/app/graphene_converted.dat', 'w') as f:\n    f.write(data)\n\nx, y = np.loadtxt('/app/graphene_converted.dat', unpack=True)\nprint('x range:', x.min(), x.max())\nprint('y range:', y.min(), y.max())\n\ndef lor(x, x0, gamma, amp, offset):\n    return amp / (1.0 + ((x - x0) / gamma) ** 2) + offset\n\nresults = {}\n\n# G peak\nmask_g = (x > 1200) & (x < 2000)\nxg, yg = x[mask_g], y[mask_g]\nig = np.argmax(yg)\np0 = [xg[ig], 20.0, yg[ig] - np.median(yg), np.median(yg)]\npopt, _ = curve_fit(lor, xg, yg, p0=p0, maxfev=100000)\nresults['G'] = {'x0': float(popt[0]), 'gamma': float(abs(popt[1])), 'amplitude': float(popt[2]), 'offset': float(popt[3])}\n\n# 2D peak\nmask_d = (x > 2300) & (x < 3200)\nxd, yd = x[mask_d], y[mask_d]\nid2 = np.argmax(yd)\np0 = [xd[id2], 30.0, yd[id"]
[274.325873, "o", "cat > /app/fit.py << 'EOF'"]
