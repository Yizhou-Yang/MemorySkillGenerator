[493.44544, "o", "\r\n        threading.Thread(target=client_loop, args=(conn,), daemon=True).start()\r\nmain()\r\nPYEOF\r\n"]
[493.657079, "i", "cat << 'EOF' > /app/run/launch.sh\n#!/bin/bash\ncd /app/run\nrm -f /app/run/ready\nnohup python3 /app/run/relay.py > /app/run/relay.log 2>&1 &\necho \"relay pid $!\"\nsleep 1\nKVM=''\n[ -e /dev/kvm ] && KVM='-enable-kvm'\nnohup qemu-system-x86_64 $KVM -m 512 -no-reboot \\\n  -display none -vga none -monitor none \\\n  -kernel /app/run/vmlinuz-lts \\\n  -initrd /app/run/intel-ucode.img,/app/run/amd-ucode.img,/app/run/initramfs-lts \\\n  -append \"modules=loop,squashfs,sd-mod,usb-storage console=ttyS0\" \\\n  -cdrom /app/alpine.iso \\\n  -serial tcp:127.0.0.1:4545,server \\\n  > /app/run/qemu.log 2>&1 &\necho \"qemu pid $!\"\nEOF\n"]
[493.65714, "o", "cat << 'EOF' > /app/run/launch.sh\r\n#!/bin/bash\r\ncd /app/run\r\nrm -f /app/run/ready\r\nnohup python3 /app/run/relay.py > /app/run/relay.log 2>&1 &\r\necho \"relay pid $!\"\r\nsleep 1\r\nKVM=''\r\n[ -e /dev/kvm ] && KVM='-enable-kvm'\r\nnohup qemu-system-x86_64 $KVM -m 512 -no-reboot \\\r\n  -display none -vga none -monitor none \\\r\n  -kernel /app/run/vmlinuz-lts \\\r\n  -initrd /app/run/intel-ucode.img,/app/run/amd-ucode.img,/app/run/initramfs-lts \\\r\n  -append \"modules=loop,squashfs,sd-mod,usb-storage console=ttyS0\" \\\r\n  -cdrom /app/alpine.iso \\\r\n  -serial tcp:127.0.0.1:4545,server \\\r\n  > /app/run/qemu.log 2>&1 &\r\necho \"qemu pid $!\"\r\nEOF\r\n"]
