[493.437991, "i", "cat << 'PYEOF' > /app/run/relay.py\nimport socket, threading, time, os\nQHOST='127.0.0.1'; QPORT=4545; LPORT=6665\nREADY='/app/run/ready'\nBUF=bytearray()\nbuf_lock=threading.Lock()\nstate={'client':None}\nstate_lock=threading.Lock()\nqc=None\ndef escape_iac(d): return d.replace(b'\\xff', b'\\xff\\xff')\ndef connect_qemu():\n    while True:\n        try:\n            s=socket.create_connection((QHOST,QPORT),timeout=5); s.settimeout(0.5); return s\n        except Exception:\n            time.sleep(0.3)\ndef qemu_loop():\n    global qc\n    while True:\n        if qc is None:\n            try: qc=connect_qemu(); print('relay: connected to qemu serial', flush=True)\n            except Exception: time.sleep(0.3); continue\n        try: data=qc.recv(65536)\n        except socket.timeout: continue\n        except Exception: qc=None; continue\n        if not data: qc=None; continue\n        with buf_lock:\n            BUF.extend(data); buf=bytes(BUF)\n        with state_lock: c=state['client']\n        if c is not None:\n            try: c.sendall("]
[493.438054, "o", "cat << 'PYEOF' > /app/run/relay.py\r\nimport socket, threading, time, os\r\nQHOST='127.0.0.1'; QPORT=4545; LPORT=6665\r\nREADY='/app/run/ready'\r\nBUF=bytearray()\r\nbuf_lock=threading.Lock()\r\nstate={'client':None}\r\nstate_lock=threading.Lock()\r\nqc=None\r\ndef escape_iac(d): return d.replace(b'\\xff', b'\\xff\\xff')\r\ndef connect_qemu():\r\n    while True:\r\n        try:\r\n            s=socket.create_connection((QHOST,QPORT),timeout=5); s.settimeout(0.5); return s\r\n        except Exception:\r\n            time.sleep(0.3)\r\ndef qemu_loop():\r\n    global qc\r\n    while True:\r\n        if qc is None:\r\n            try: qc=connect_qemu(); print('relay: connected to qemu serial', flush=True)\r\n            except Exception: time.sleep(0.3); continue\r\n        try: data=qc.recv(65536)\r\n        except socket.timeout: continue\r\n        except Exception: qc=None; continue\r\n        if not data: qc=None; continue\r\n        with buf_lock:\r\n            BUF.extend(data); buf=bytes(BUF)\r\n        with state_lock: c=state['client']\r\n        if c is not None"]
[493.444441, "i", "escape_iac(data))\n            except Exception:\n                with state_lock: state['client']=None\n        if not os.path.exists(READY) and b'login:' in buf.lower():\n            try: open(READY,'w').write('ready\\n')\n            except Exception: pass\n            print('relay: READY login prompt seen', flush=True)\ndef client_loop(conn):\n    with state_lock: state['client']=conn\n    with buf_lock: hist=bytes(BUF)\n    try: conn.sendall(escape_iac(hist))\n    except Exception: pass\n    iac=False; iac_cmd=None; sub=False\n    while True:\n        try: chunk=conn.recv(4096)\n        except Exception: break\n        if not chunk: break\n        out=bytearray()\n        for b in chunk:\n            if sub:\n                if b==240: sub=False\n                continue\n            if iac:\n                if iac_cmd is None:\n                    iac_cmd=b\n                    if b==250: sub=True; iac=False\n                    elif b in (240,241,242,243,244): iac=False\n                else:\n                    opt=b\n           "]
[493.444505, "o", ":\r\n            try: c.sendall(escape_iac(data))\r\n            except Exception:\r\n                with state_lock: state['client']=None\r\n        if not os.path.exists(READY) and b'login:' in buf.lower():\r\n            try: open(READY,'w').write('ready\\n')\r\n            except Exception: pass\r\n            print('relay: READY login prompt seen', flush=True)\r\ndef client_loop(conn):\r\n    with state_lock: state['client']=conn\r\n    with buf_lock: hist=bytes(BUF)\r\n    try: conn.sendall(escape_iac(hist))\r\n    except Exception: pass\r\n    iac=False; iac_cmd=None; sub=False\r\n    while True:\r\n        try: chunk=conn.recv(4096)\r\n        except Exception: break\r\n        if not chunk: break\r\n        out=bytearray()\r\n        for b in chunk:\r\n            if sub:\r\n                if b==240: sub=False\r\n                continue\r\n            if iac:\r\n                if iac_cmd is None:\r\n                    iac_cmd=b\r\n                    if b==250: sub=True; iac=False\r\n                    elif b in (240,241,242,243,244): iac=False\r\n  "]
[493.444525, "i", "         try:\n                        if iac_cmd in (251,252): conn.sendall(bytes([255,253,opt]))\n                        elif iac_cmd in (253,254): conn.sendall(bytes([255,251,opt]))\n                    except Exception: pass\n                    iac=False; iac_cmd=None\n                continue\n            if b==255: iac=True; iac_cmd=None; continue\n            out.append(b)\n        if out and qc is not None:\n            try: qc.sendall(bytes(out))\n            except Exception: pass\n    with state_lock:\n        if state['client'] is conn: state['client']=None\n    try: conn.close()\n    except Exception: pass\ndef main():\n    threading.Thread(target=qemu_loop, daemon=True).start()\n    ls=socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR,1)\n    ls.bind((QHOST,LPORT)); ls.listen(1)\n    print('relay: listening on %d' % LPORT, flush=True)\n    while True:\n        conn,_=ls.accept()\n        threading.Thread(target=client_loop, args=(conn,), daemon=True).start()\n"]
[493.445189, "o", "              else:\r\n                    opt=b\r\n                    try:\r\n                        if iac_cmd in (251,252): conn.sendall(bytes([255,253,opt]))\r\n                        elif iac_cmd in (253,254): conn.sendall(bytes([255,251,opt]))\r\n                    except Exception: pass\r\n                    iac=False; iac_cmd=None\r\n                continue\r\n            if b==255: iac=True; iac_cmd=None; continue\r\n            out.append(b)\r\n        if out and qc is not None:\r\n            try: qc.sendall(bytes(out))\r\n            except Exception: pass\r\n    with state_lock:\r\n        if state['client'] is conn: state['client']=None\r\n    try: conn.close()\r\n    except Exception: pass\r\ndef main():\r\n    threading.Thread(target=qemu_loop, daemon=True).start()\r\n    ls=socket.socket(socket.AF_INET, socket.SOCK_STREAM)\r\n    ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR,1)\r\n    ls.bind((QHOST,LPORT)); ls.listen(1)\r\n    print('relay: listening on %d' % LPORT, flush=True)\r\n    while True:\r\n        conn,_=ls.accept()"]
