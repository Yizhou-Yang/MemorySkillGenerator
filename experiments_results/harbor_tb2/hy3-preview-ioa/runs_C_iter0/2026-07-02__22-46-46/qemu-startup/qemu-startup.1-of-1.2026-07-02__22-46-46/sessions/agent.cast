[205.534551, "m", "Episode 5: 2 commands"]
[205.534551, "o", "\u001b[?2004hroot@fb781a110bd4:/app# "]
[230.670769, "i", "cat << 'PYEOF' > /app/run/extract.py\nimport struct, sys, os\nISO = '/app/alpine.iso'\nOUT = '/app/run'\ndef read_sectors(f, lba, count):\n    f.seek(lba*2048)\n    return f.read(2048*count)\ndef parse_entry(rec):\n    length = rec[0]\n    if length == 0:\n        return None\n    ext_lba = struct.unpack_from('<I', rec, 2)[0]\n    data_len = struct.unpack_from('<I', rec, 10)[0]\n    flags = rec[25]\n    name_len = rec[32]\n    name = rec[33:33+name_len]\n    is_dir = bool(flags & 0x02)\n    nm = name.split(b';')[0]\n    return (ext_lba, data_len, is_dir, nm)\ndef list_dir(f, lba, length):\n    buf = read_sectors(f, lba, (length+2047)//2048)\n    entries = []\n    off = 0\n    while off < len(buf):\n        reclen = buf[off]\n        if reclen == 0:\n            break\n        rec = buf[off:off+reclen]\n        e = parse_entry(rec)\n        if e:\n            entries.append(e)\n        off += reclen\n    return entries\ndef main():\n    f = open(ISO, 'rb')\n    lba = 16\n    pvd = None\n    while Tr"]
[230.675252, "o", "cat << 'PYEOF' > /app/run/extract.py\r\n\u001b[?2004l\r\u001b[?2004h> import struct, sys, os\r\n\u001b[?2004l\r\u001b[?2004h> ISO = '/app/alpine.iso'\r\n\u001b[?2004l\r\u001b[?2004h> OUT = '/app/run'\r\n\u001b[?2004l\r\u001b[?2004h> def read_sectors(f, lba, count):"]
[230.675619, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     f.seek(lba*2048)\r\n\u001b[?2004l\r\u001b[?2004h>     return f.read(2048*count)"]
[230.675722, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[230.675864, "o", "> def parse_entry(rec):"]
[230.675972, "o", "\r\n\u001b[?2004l\r"]
[230.676068, "o", "\u001b[?2004h> "]
[230.676173, "o", "    length = rec[0]"]
[230.676283, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[230.67636, "o", "> "]
[230.676472, "o", "    if length == 0:"]
[230.676562, "o", "\r\n\u001b[?2004l\r"]
