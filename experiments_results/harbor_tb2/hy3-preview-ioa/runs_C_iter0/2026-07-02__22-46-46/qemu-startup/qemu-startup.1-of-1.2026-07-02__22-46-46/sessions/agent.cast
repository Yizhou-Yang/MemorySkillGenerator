[491.827476, "i", "cat << 'PYEOF' > /app/run/grab.py\nimport struct, os\nISO='/app/alpine.iso'; OUT='/app/run'\ndef rs(f,lba,c):\n    f.seek(lba*2048); return f.read(2048*c)\ndef pe(rec):\n    if rec[0]==0: return None\n    ext=struct.unpack_from('<I',rec,2)[0]; dl=struct.unpack_from('<I',rec,10)[0]\n    fl=rec[25]; nl=rec[32]; nm=rec[33:33+nl].split(b';')[0]\n    return (ext,dl,bool(fl&2),nm)\ndef ld(f,lba,lg):\n    buf=rs(f,lba,(lg+2047)//2048); out=[]; off=0\n    while off<len(buf):\n        rl=buf[off]\n        if rl==0: break\n        e=pe(buf[off:off+rl])\n        if e: out.append(e)\n        off+=rl\n    return out\nf=open(ISO,'rb')\nlba=16; pvd=None\nwhile True:\n    vd=rs(f,lba,1)\n    if vd[1:6]!=b'CD001': break\n    if vd[0]==1: pvd=vd; break\n    if vd[0]==255: break\n    lba+=1\nroot=pe(pvd[156:156+34])\nboot=None\nfor e in ld(f,root[0],root[1]):\n    if e[3].decode('latin1').upper()=='BOOT': boot=e; break\nfor nm in ['INTEL_UCODE.IMG','AMD_UCODE.IMG']:\n    found=False\n    for e in ld(f,boot[0],boot[1]):\n        if e[3].decode('latin1').upper()="]
[491.827769, "i", "=nm:\n            f.seek(e[0]*2048); data=f.read(e[1])\n            open(os.path.join(OUT,nm.lower()),'wb').write(data)\n            print('wrote',nm.lower(),e[1]); found=True; break\n    if not found: print('WARN missing',nm)\nPYEOF\n"]
