[205.137008, "i", "cat << 'PYEOF' > /app/run/extract.py\nimport struct, sys, os\nISO = '/app/alpine.iso'\nOUT = '/app/run'\ndef read_sectors(f, lba, count):\n    f.seek(lba*2048)\n    return f.read(2048*count)\ndef parse_entry(rec):\n    length = rec[0]\n    if length == 0:\n        return None\n    ext_lba = struct.unpack_from('<I', rec, 2)[0]\n    data_len = struct.unpack_from('<I', rec, 10)[0]\n    flags = rec[25]\n    name_len = rec[length-1]\n    name = rec[length:length+name_len]\n    is_dir = bool(flags & 0x02)\n    nm = name.split(b';')[0]\n    return (ext_lba, data_len, is_dir, nm)\ndef list_dir(f, lba, length):\n    buf = read_sectors(f, lba, (length+2047)//2048)\n    entries = []\n    off = 0\n    while off < len(buf):\n        reclen = buf[off]\n        if reclen == 0:\n            break\n        rec = buf[off:off+reclen]\n        e = parse_entry(rec)\n        if e:\n            entries.append(e)\n        off += reclen\n    return entries\ndef main():\n    f = open(ISO, 'rb')\n    lba = 16\n    pvd = None\n    while True:\n        vd = read_sectors(f, l"]
[205.13754, "i", "ba, 1)\n        if vd[1:6] != b'CD001':\n            break\n        if vd[0] == 1:\n            pvd = vd\n            break\n        if vd[0] == 255:\n            break\n        lba += 1\n    if pvd is None:\n        print('PVD not found'); sys.exit(1)\n    root_e = parse_entry(pvd[156:156+34])\n    print('root entries:')\n    for e in list_dir(f, root_e[0], root_e[1]):\n        print('  ', e[3], 'dir' if e[2] else 'file')\n    def find(parent_e, want):\n        for e in list_dir(f, parent_e[0], parent_e[1]):\n            if e[3].decode('latin1').lower() == want:\n                return e\n        return None\n    boot = find(root_e, 'boot')\n    if not boot:\n        print('boot not found'); sys.exit(1)\n    wanted = {}\n    for e in list_dir(f, boot[0], boot[1]):\n        nm = e[3].decode('latin1').lower()\n        print('  boot/', e[3])\n        if nm.startswith('vmlinuz') and 'lts' in nm:\n            wanted.setdefault('vmlinuz-lts', e)\n        if nm.startswith('initramfs') and 'lts' in nm:\n            wanted.setdefault('initramfs-l"]
[205.13765, "i", "ts', e)\n    os.makedirs(OUT, exist_ok=True)\n    for key, e in wanted.items():\n        f.seek(e[0]*2048)\n        data = f.read(e[1])\n        open(os.path.join(OUT, key), 'wb').write(data)\n        print('wrote', key, e[1], 'bytes')\n    if 'vmlinuz-lts' not in wanted or 'initramfs-lts' not in wanted:\n        print('MISSING; got', list(wanted.keys())); sys.exit(1)\nmain()\nPYEOF\n"]
