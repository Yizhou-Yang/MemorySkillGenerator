[38.170119, "i", "cat > /app/scraper.py << 'EOF'\nimport re\n\nimport requests\nfrom bs4 import BeautifulSoup\nimport pandas as pd\n\nURL = \"http://server:8000\"\n\n\ndef parse_book(book):\n    title = book.find(\"div\", class_=\"book-title\").get_text(strip=True)\n    author = book.find(\"div\", class_=\"book-author\").get_text(strip=True)\n    author = re.sub(r\"^by\\s+\", \"\", author)\n    year = book.find(\"span\", class_=\"book-year\").get_text(strip=True)\n    year = re.search(r\"(\\d{4})\", year).group(1)\n    rating = book.find(\"span\", class_=\"book-rating\").get_text(strip=True)\n    rating = re.search(r\"([\\d.]+)/?\\s*5\", rating).group(1)\n    price = book.find(\"span\", class_=\"book-price\").get_text(strip=True)\n    price = re.search(r\"\\$?([\\d.]+)\", price).group(1)\n    return {\n        \"title\": title,\n        \"author\": author,\n        \"year\": int(year),\n        \"rating\": float(rating),\n        \"price\": float(price),\n    }\n\n\ndef main():\n    resp = requests.get(URL, timeout=10)\n    resp.raise_for_status()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n    bo"]
[38.170196, "i", "oks = [parse_book(b) for b in soup.find_all(\"div\", class_=\"book\")]\n\n    df = pd.DataFrame(books, columns=[\"title\", \"author\", \"year\", \"rating\", \"price\"])\n    df.to_csv(\"books.csv\", index=False)\n\n    total = len(df)\n    avg_price = df[\"price\"].mean()\n    highest = df.loc[df[\"rating\"].idxmax()]\n\n    lines = [\n        \"Book Store Scraping Summary Report\",\n        \"=================================\",\n        f\"Total number of books scraped: {total}\",\n        f\"Average book price: ${avg_price:.2f}\",\n        f\"Highest rated book: {highest['title']} (Rating: {highest['rating']}/5)\",\n    ]\n    with open(\"report.txt\", \"w\") as f:\n        f.write(\"\\n\".join(lines) + \"\\n\")\n\n    print(\"\\n\".join(lines))\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
