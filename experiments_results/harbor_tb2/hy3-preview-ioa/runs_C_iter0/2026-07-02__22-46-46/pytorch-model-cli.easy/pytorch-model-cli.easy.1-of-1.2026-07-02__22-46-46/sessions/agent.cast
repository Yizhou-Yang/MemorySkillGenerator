[435.842291, "i", "cat > /app/dl.py << 'EOF'\nimport re, urllib.request, sys, os\nos.makedirs('/app/debs', exist_ok=True)\nurls=[]\nfor line in open('/app/uris.txt'):\n    m=re.search(r\"'(https?://[^']+)'\\s+(\\S+)\\s+(\\d+)\", line)\n    if m:\n        urls.append((m.group(1), m.group(2)))\nprint('found', len(urls), 'packages')\nfor i,(u,name) in enumerate(urls):\n    dest='/app/debs/'+name\n    if os.path.exists(dest): continue\n    try:\n        urllib.request.urlretrieve(u, dest)\n        print('ok', i, name, os.path.getsize(dest))\n    except Exception as e:\n        print('FAIL', i, name, e)\nEOF\npython3 /app/dl.py\n"]
