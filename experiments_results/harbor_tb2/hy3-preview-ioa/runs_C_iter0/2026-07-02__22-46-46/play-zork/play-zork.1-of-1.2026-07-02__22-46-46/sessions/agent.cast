[1492.843048, "o", "\u001b[0;7m\u000f6\r\u001b[38d"]
[1492.843151, "o", "\u001b[m\u000fYou try to ascend the ramp, but it is impossible, and you slide back down.\r\u001b[40d"]
[1492.843242, "o", ">"]
