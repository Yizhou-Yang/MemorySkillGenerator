[1128.166438, "o", "t"]
[1128.166954, "o", "\r\u001b[2d"]
[1128.167263, "o", "\u001b[5M\u001bM\u001b[C"]
[1128.167479, "o", "\u001b[0;7m\u000fGallery      \u001b[155G"]
[1128.167862, "o", "5\r\u001b[36d\u001b[m\u000fGallery\r\u001b[37dThis is an art gallery. Most of the paintings have been stolen by vandals with exceptional taste. The vandals left through either the north or west exits.\r\u001b[38dFortunately, there is still one chance for you to be a vandal, for on the far wall is a painting of unparalleled beauty.\r\u001b[40d>"]
[1128.390711, "i", "look\n"]
[1128.391527, "m", "Episode 33: 5 commands"]
[1128.391527, "o", "look\r\u001b[2d\u001b[5M\u001bM\u001b[155G\u001b[0;7m\u000f6\r\u001b[36d\u001b[m\u000fGallery\r\u001b[37dThis is an art gallery. Most of the paintings have been stolen by vandals with exceptional taste. The vandals left through either the north or west exits.\r\u001b[38dFortunately, there is still one chance for you to be a vandal, for on the far wall is a painting of unparalleled beauty.\r\u001b[40d>"]
[1139.145864, "i", "take painting\n"]
[1139.146685, "o", "take painting\r\u001b[2d\u001b[3M\u001bM\u001b[155G\u001b[0;7m\u000f7\r\u001b[38d\u001b[m\u000fYour load is too heavy.\r\u001b[40d>"]
[1139.38757, "i", "save\n"]
[1139.393038, "o", "save\r\u001b[2d\u001b[2M\u001b[39dEnter a file name.\r\u001b[40dDefault is \"/tmp/chasm.sav\": "]
[1139.701863, "i", "/tmp/gallery.sav\n"]
[1139.703505, "o", "/"]
[1139.709353, "o", "tmp/gallery.sav\r\u001b[2d\u001b[3M\u001b[38dOk.\r\u001b[40d>"]
[1139.994306, "i", "north\n"]
[1139.994534, "o", "nor"]
[1139.994663, "o", "th"]
[1139.995206, "o", "\r\u001b[2d\u001b[7M\u001bM\u001b[C\u001b[0;7m\u000fStudio \u001b[155G"]
[1139.995277, "o", "8\r\u001b[34d\u001b[m\u000fStudio\r\u001b[35dThis appears to have been an artist's studio. The walls and floors are splattered with paints of 69 different colors. Strangely enough, nothing of value is\r\u001b[36d"]
[1140.186053, "o", "hanging here. At the south end of the room is an open door (also covered with paint). A dark and narrow chimney leads up from a fireplace; although you might be\u001b[37;1Hable to get up it, it seems unlikely you could get back down.\r\u001b[38dLoosely attached to a wall is a small piece of paper.\r\u001b[40d>"]
[1140.267682, "i", "look\n"]
[1140.267982, "o", "loo"]
[1140.268099, "o", "k"]
[1140.268649, "o", "\r\u001b[2d"]
[1140.268942, "o", "\u001b[7M\u001bM\u001b[155G"]
[1140.269161, "o", "\u001b[0;7m\u000f9\r\u001b[34d"]
[1140.269557, "o", "\u001b[m\u000fStudio\r\u001b[35d"]
[1140.269765, "o", "This appears to have been an artist's studio. The walls and floors are splattered with paints of 69 different colors. Strangely enough, nothing of value is\r\u001b[36d"]
[1140.26998, "o", "hanging here. At the south end of the room is an open door (also covered with paint). A dark and narrow chimney leads up from a fireplace; although you might be\u001b[37;1H"]
[1140.270165, "o", "able to get up it, it seems unlikely you could get back down.\r\u001b[38d"]
[1140.270351, "o", "Loosely attached to a wall is a small piece of paper.\r\u001b[40d"]
[1140.271099, "m", "Episode 34: 9 commands"]
[1140.271099, "o", ">"]
[1197.604474, "i", "read paper\n"]
[1197.604725, "o", "re"]
[1197.604822, "o", "ad p"]
[1197.60488, "o", "aper"]
[1197.605234, "o", "\r\u001b[2d"]
[1197.605315, "o", "\u001b[9M\u001bM\u001b[154G\u001b[0;7m\u000f70\r\u001b[33d\u001b[m\u000fCongratulations!\r\u001b[35d"]
[1197.605344, "o", "You are the privileged owner of ZORK I: The Great Underground Empire, a self-contained and self-maintaining universe. If used and maintained in accordance with\r\u001b[36dnormal operating practices for small universes, ZORK will provide many months of trouble-free operation.\r\u001b[40d>"]
