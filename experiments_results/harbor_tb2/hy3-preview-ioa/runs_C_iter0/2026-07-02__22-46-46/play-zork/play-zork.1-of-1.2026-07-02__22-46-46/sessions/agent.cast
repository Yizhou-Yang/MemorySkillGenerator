[461.790555, "o", "\r\u001b[2d"]
[461.790602, "o", "\u001b[8M\u001bM\u001b[155G"]
[461.790646, "o", "\u001b[0;7m\u000f9\r\u001b[33d\u001b[m\u000fMaze\r\u001b[34dThis is part of a maze of twisty little passages, all alike. A skeleton, probably the remains of a luckless adventurer, lies here.\r\u001b[35dBeside the skeleton is a rusty knife.\r\u001b[36dThe deceased adventurer's useless lantern is here.\r\u001b[37dThere is a skeleton key here.\r\u001b[38d"]
[461.79078, "o", "An old leather bag, bulging with coins, is here.\r\u001b[40d>"]
[462.016867, "i", "look\n"]
[462.017306, "o", "l"]
[462.019253, "o", "ook\r\u001b[2d\u001b[8M\u001bM\u001b[154G\u001b[0;7m\u000f50\r\u001b[33d\u001b[m\u000fMaze\r\u001b[34dThis is part of a maze of twisty little passages, all alike. A skeleton, probably the remains of a luckless adventurer, lies here.\r\u001b[35dBeside the skeleton is a rusty knife.\r\u001b[36dThe deceased adventurer's useless lantern is here.\r\u001b[37dThere is a skeleton key here.\r\u001b[38dAn old leather bag, bulging with coins, is here.\r\u001b[40d>"]
