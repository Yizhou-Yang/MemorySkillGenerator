[1769.029402, "i", "read leaflet\n"]
[1769.029982, "o", "read leaflet"]
[1769.030267, "o", "\r\u001b[2d\u001b[7M\u001bM\u001b[154G\u001b[0;7m\u000f3\r\u001b[34d\u001b[m\u000f\"WELCOME TO ZORK!\r\u001b[36dZORK is a game of adventure, danger, and low cunning. In it you will explore some of the most amazing territory ever seen by mortals. No computer should be\r\u001b[37dwithout one!\"\r\u001b[40d>"]
[1769.256197, "i", "north\n"]
[1769.256992, "o", "nor"]
[1769.257124, "o", "th"]
[1769.257476, "o", "\r\u001b[2d\u001b[4M\u001bM\u001b[C"]
[1769.257532, "o", "\u001b[0;7m\u000fNorth of House\u001b[154G"]
[1769.257653, "o", "4\r\u001b[37d\u001b[m\u000fNorth of House\r\u001b[38d"]
[1769.257709, "o", "You are facing the north side of a white house. There is no door here, and all the windows are boarded up. To the north a narrow path winds through the trees.\r\u001b[40d>"]
[1769.43905, "i", "east\n"]
[1769.439318, "o", "east"]
[1769.439612, "o", "\r\u001b[2d\u001b[4M\u001bM\u001b[C\u001b[0;7m\u000fBehind House  \u001b[154G"]
[1769.439666, "o", "5\r\u001b[37d\u001b[m\u000fBehind House\r\u001b[38dYou are behind the white house. A path leads into the forest to the east. In one corner of the house there is a small window which is slightly ajar.\r\u001b[40d>"]
[1769.615081, "i", "open window\n"]
[1769.61533, "o", "open "]
[1769.615466, "o", "windo"]
