[178.199374, "o", "\u001b[7M\u001bM\u001b[C\u001b[0;7m\u000fLiving Room\u001b[155G"]
[178.199424, "o", "7\r\u001b[34d\u001b[m\u000fLiving Room\r\u001b[35d"]
[178.199454, "o", "You are in the living room. There is a doorway to the east, a wooden door with strange gothic lettering to the west, which appears to be nailed shut, a trophy\r\u001b[36dcase, and a large oriental rug in the center of the room.\r\u001b[37dAbove the trophy case hangs an elvish sword of great antiquity.\r\u001b[38dA battery-powered brass lantern is on the trophy case.\r\u001b[40d>"]
