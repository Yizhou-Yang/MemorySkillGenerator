[195.664822, "o", "u"]
[195.664872, "o", "g\r\u001b[2d\u001b[3M\u001bM\u001b[155G\u001b[0;7m\u000f3\r\u001b[38d\u001b[m\u000fWith a great effort, the rug is moved to one side of the room, revealing the dusty cover of a closed trap door.\r\u001b[40d>"]
[195.912427, "i", "open trap door\n"]
[195.912965, "o", "open "]
[195.913007, "o", "trap doo"]
