[1017.670492, "o", "\u001b[0;7m\u000f60\r\u001b[35d"]
[1017.670781, "o", "\u001b[m\u000fThe Troll Room\r\u001b[36dThis is a small room with passages to the east and south and a forbidding hole leading west. Bloodstains and deep scratches (perhaps made by an axe) mar the\r\u001b[37d"]
[1017.670932, "o", "walls.\r\u001b[38dThere is a bloody axe here.\r\u001b[40d>"]
