[1770.464866, "o", "\u001b[0;7m\u000fLiving Room\u001b[154G10\r\u001b[34d\u001b[m\u000fLiving Room\r\u001b[35dYou are in the living room. There is a doorway to the east, a wooden door with strange gothic lettering to the west, which appears to be nailed shut, a trophy\r\u001b[36dcase, and a large oriental rug in the center of the room.\r\u001b[37d"]
[1770.464958, "o", "Above the trophy case hangs an elvish sword of great antiquity.\r\u001b[38dA battery-powered brass lantern is on the trophy case.\r\u001b[40d>"]
