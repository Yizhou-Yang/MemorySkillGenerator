[1414.96402, "m", "Episode 41: 3 commands"]
[1414.96402, "o", "\u001b[m\u000fEast of Chasm\r\u001b[38dYou are on the east edge of a chasm, the bottom of which cannot be seen. A narrow passage goes north, and the path you are on continues to the east.\r\u001b[40d>"]
[1492.690154, "i", "north\n"]
[1492.696516, "o", "north\r\u001b[2d\u001b[3M\u001bM\u001b[C\u001b[0;7m\u000fCellar       \u001b[156G5\r\u001b[38d\u001b[m\u000fCellar\r\u001b[40d>"]
[1492.842264, "i", "west\n"]
