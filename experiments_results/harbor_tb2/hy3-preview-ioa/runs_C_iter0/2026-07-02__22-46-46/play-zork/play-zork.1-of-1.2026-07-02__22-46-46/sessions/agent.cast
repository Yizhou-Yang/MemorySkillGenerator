[1018.711578, "i", "look\n"]
[1018.71311, "o", "look\r\u001b[2d"]
[1018.713662, "o", "\u001b[5M\u001bM\u001b[155G"]
[1018.713918, "o", "\u001b[0;7m\u000f2\r\u001b[36d\u001b[m\u000fCellar\r\u001b[37d"]
[1018.713981, "m", "Episode 30: 4 commands"]
[1018.713981, "o", "You are in a dark and damp cellar with a narrow passageway leading north, and a crawlway to the south. On the west is the bottom of a steep metal ramp which is\r\u001b[38dunclimbable.\r\u001b[40d>"]
