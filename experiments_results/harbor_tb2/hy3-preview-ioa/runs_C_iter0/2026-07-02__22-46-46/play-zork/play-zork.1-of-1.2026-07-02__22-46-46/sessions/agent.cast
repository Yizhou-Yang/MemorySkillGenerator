[1769.617346, "o", "\u001b[0;7m\u000f6\r\u001b[38d"]
[1769.617477, "o", "\u001b[m\u000fWith great effort, you open the window far enough to allow entry.\r\u001b[40d"]
[1769.617578, "o", ">"]
