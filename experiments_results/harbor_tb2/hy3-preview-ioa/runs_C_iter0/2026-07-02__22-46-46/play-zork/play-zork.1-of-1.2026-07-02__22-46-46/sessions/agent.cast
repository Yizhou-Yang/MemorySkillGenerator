[1694.444189, "o", "\u001b[0;7m\u000f West of House                                                                                                                    Score: 0        Moves: 0      \u001b[31;1H"]
[1694.444657, "o", "\u001b[m\u000fZORK I: The Great Underground Empire\r\u001b[32d"]
[1694.444964, "o", "Copyright (c) 1981, 1982, 1983 Infocom, Inc. All rights reserved.\r\u001b[33d"]
[1694.445256, "o", "ZORK is a registered trademark of Infocom, Inc.\r\u001b[34d"]
[1694.445905, "o", "Revision 88 / Serial number 840726\r\u001b[36d"]
[1694.448308, "o", "West of House\r\u001b[37d"]
[1694.448907, "o", "You are standing in an open field west of a white house, with a boarded front door.\r\u001b[38dThere is a small mailbox here.\r\u001b[40d"]
[1694.449042, "m", "Episode 44: 1 commands"]
[1694.449042, "m", "Episode 45: 14 commands"]
[1694.449042, "o", ">"]
[1768.602831, "i", "open mailbox\n"]
[1768.603544, "o", "open mailbox"]
[1768.603739, "o", "\r\u001b[2d"]
[1768.604126, "o", "\u001b[3M\u001bM\u001b[154G"]
[1768.604434, "o", "\u001b[0;7m\u000f1\r\u001b[38d\u001b[m\u000fOpening the small mailbox reveals a leaflet.\r\u001b[40d>"]
[1768.840658, "i", "take leaflet\n"]
[1768.840882, "o", "ta"]
[1768.840933, "o", "ke lea"]
[1768.841057, "o", "flet"]
[1768.841335, "o", "\r\u001b[2d\u001b[3M\u001bM\u001b[154G"]
