[137.5686, "i", "cat > /etc/nginx/conf.d/git.conf <<'EOF'\nserver {\n    listen 8443 ssl;\n    server_name localhost;\n    ssl_certificate /etc/nginx/ssl/server.crt;\n    ssl_certificate_key /etc/nginx/ssl/server.key;\n    root /var/www;\n    index index.html;\n    location /dev/ {\n        root /var/www;\n    }\n    location / {\n        try_files $uri $uri/ =404;\n    }\n}\nEOF\n"]
[137.56906, "o", "cat > /etc/nginx/conf.d/git.conf <<'EOF'\r\nserver {\r\n    listen 8443 ssl;\r\n    server_name localhost;\r\n    ssl_certificate /etc/nginx/ssl/server.crt;\r\n    ssl_certificate_key /etc/nginx/ssl/server.key;\r\n    root /var/www;\r\n    index index.html;\r\n    location /dev/ {\r\n        root /var/www;\r\n    }\r\n    location / {\r\n        try_files $uri $uri/ =404;\r\n    }\r\n}\r\nEOF\r\n"]
