[133.860336, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nwhile read oldrev newrev refname; do\n    branch=\"${refname#refs/heads/}\"\n    case \"$branch\" in\n        main) target=/var/www ;;\n        dev) target=/var/www/dev ;;\n        *) continue ;;\n    esac\n    mkdir -p \"$target\"\n    git --git-dir=/git/project archive \"$branch\" | tar -x -C \"$target\"\ndone\nEOF\nchmod +x /git/project/hooks/post-receive && chown git:git /git/project/hooks/post-receive\n"]
[133.860915, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n#!/bin/bash\r\nwhile read oldrev newrev refname; do\r\n    branch=\"${refname#refs/heads/}\"\r\n    case \"$branch\" in\r\n        main) target=/var/www ;;\r\n        dev) target=/var/www/dev ;;\r\n        *) continue ;;\r\n    esac\r\n    mkdir -p \"$target\"\r\n    git --git-dir=/git/project archive \"$branch\" | tar -x -C \"$target\"\r\ndone\r\nEOF\r\nchmod +x /git/project/hooks/post-receive && chown git:git /git/project/hooks/post-receive\r\n"]
