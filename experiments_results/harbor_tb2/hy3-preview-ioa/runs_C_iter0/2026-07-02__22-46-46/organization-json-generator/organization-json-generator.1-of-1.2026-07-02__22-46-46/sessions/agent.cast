[49.106275, "o", "    with open(f'{DATA}/{name}', newline='', encoding='utf-8') as f:"]
[49.106569, "i", "bjs = []\n    for p in proj_by_dept.get(did, []):\n        proj_objs.append({\n            'name': p['name'],\n            'status': p['status'],\n            'members': [m.strip() for m in p['member_ids'].split(';') if m.strip()],\n            'deadline': p['deadline']\n        })\n    dept_list.append({\n        'id': did,\n        'name': d['name'],\n        'budget': float(d['budget']),\n        'employees': emp_objs,\n        'projects': proj_objs\n    })\n\n# statistics\nbudgets = [x['budget'] for x in dept_list]\naverage_budget = sum(budgets) / len(budgets) if budgets else 0\n\nall_emp = [emp for d in dept_list for emp in d['employees']]\ntotal_employees = len(all_emp)\n\nskill_dist = {}\nfor emp in all_emp:\n    for s in emp['skills']:\n        skill_dist[s] = skill_dist.get(s, 0) + 1\n\ndept_sizes = {d['name']: len(d['employees']) for d in dept_list}\n\nstatus_dist = {}\nfor d in dept_list:\n    for p in d['projects']:\n        status_dist[p['status']] = status_dist.get(p['status'], 0) + 1\n\nyears = [emp['years_of_service'] for emp i"]
[49.106591, "i", "n all_emp]\navg_years = sum(years) / len(years) if years else 0\n\noutput = OrderedDict()\noutput['metadata'] = {\n    'version': '1.0',\n    'timestamp': datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    'generator': 'CSV-to-JSON Processor v1.0'\n}\noutput['organization'] = {\n    'name': 'Acme Corporation',\n    'founded': '2000-01-01',\n    'departments': dept_list\n}\noutput['statistics'] = {\n    'averageDepartmentBudget': round(average_budget, 2),\n    'totalEmployees': total_employees,\n    'skillDistribution': skill_dist,\n    'departmentSizes': dept_sizes,\n    'projectStatusDistribution': status_dist,\n    'averageYearsOfService': round(avg_years, 2)\n}\n\nwith open('organization.json', 'w', encoding='utf-8') as f:\n    json.dump(output, f, indent=2, ensure_ascii=False)\n\nprint('Wrote organization.json')\nprint('Departments:', len(dept_list), 'Employees:', total_employees)\nEOF\n"]
