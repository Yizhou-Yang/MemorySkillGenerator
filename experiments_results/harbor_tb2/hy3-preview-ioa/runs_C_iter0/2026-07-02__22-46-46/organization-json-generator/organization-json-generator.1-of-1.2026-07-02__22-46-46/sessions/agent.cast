[49.105317, "i", "cat > process.py << 'EOF'\nimport csv, json, datetime\nfrom collections import OrderedDict\n\nDATA = 'data'\n\ndef read_csv(name):\n    with open(f'{DATA}/{name}', newline='', encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\ndepartments = read_csv('departments.csv')\nemployees = read_csv('employees.csv')\nprojects = read_csv('projects.csv')\n\n# index employees by department\nemp_by_dept = {}\nfor e in employees:\n    emp_by_dept.setdefault(e['department_id'], []).append(e)\n\nproj_by_dept = {}\nfor p in projects:\n    proj_by_dept.setdefault(p['department_id'], []).append(p)\n\ndept_list = []\nfor d in departments:\n    did = d['id']\n    emp_objs = []\n    for e in emp_by_dept.get(did, []):\n        emp_objs.append({\n            'id': e['id'],\n            'name': e['name'],\n            'position': e['position'],\n            'skills': [s.strip() for s in e['skills'].split(';') if s.strip()],\n            'years_of_service': int(e['years_of_service'])\n        })\n    proj_o"]
