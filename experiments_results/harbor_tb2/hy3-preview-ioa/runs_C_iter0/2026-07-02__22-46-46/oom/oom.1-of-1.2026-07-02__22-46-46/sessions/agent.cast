[43.101941, "i", "cat > /tmp/cache_model.py << 'EOF'\nimport os\nfrom huggingface_hub import snapshot_download\nfrom transformers import AutoTokenizer, AutoModel\n\nmodel_id = \"albert/albert-base-v2\"\n\nprint(\"== snapshot_download ==\")\npath = snapshot_download(repo_id=model_id, repo_type=\"model\")\nprint(\"cached at:\", path)\n\nprint(\"== tokenizer ==\")\ntok = AutoTokenizer.from_pretrained(model_id)\nprint(\"tokenizer loaded:\", type(tok).__name__)\n\nprint(\"== model ==\")\nm = AutoModel.from_pretrained(model_id)\nprint(\"model loaded:\", type(m).__name__)\n\nprint(\"DONE\")\nEOF\n"]
