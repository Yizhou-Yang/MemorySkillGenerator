[409.333891, "i", "cat > /app/app.py << 'EOF'\nimport os\nfrom flask import Flask, request, jsonify\nfrom transformers import pipeline\n\nMODEL_DIR = \"/app/model_cache/sentiment_model\"\n\napp = Flask(__name__)\n\nprint(\"Loading sentiment model from\", MODEL_DIR, flush=True)\nclassifier = pipeline(\n    \"sentiment-analysis\",\n    model=MODEL_DIR,\n    tokenizer=MODEL_DIR,\n)\nprint(\"Model loaded.\", flush=True)\n\n\ndef build_response(label, score):\n    # distilbert-sst-2 labels are POSITIVE / NEGATIVE\n    pos = score if label.upper().startswith(\"POS\") else 1.0 - score\n    neg = score if label.upper().startswith(\"NEG\") else 1.0 - score\n    sentiment = \"positive\" if label.upper().startswith(\"POS\") else \"negative\"\n    return {\n        \"sentiment\": sentiment,\n        \"confidence\": {\n            \"positive\": round(float(pos), 6),\n            \"negative\": round(float(neg), 6),\n        },\n    }\n\n\n@app.route(\"/sentiment\", methods=[\"POST\"])\ndef sentiment():\n    try:\n        data = request.get_json(silent=True)\n"]
