[353.380945, "i", "python3 - <<'EOF'\nimport struct, zlib\nd=open('image.png','rb').read()\nassert d[:8]==bytes([137,80,78,71,13,10,26,10])\nw,h=struct.unpack('>II',d[16:24])\nbit=struct.unpack('B',d[24:25])[0]; col=struct.unpack('B',d[25:26])[0]\nprint('w,h',w,h,'bit',bit,'col',col)\nidat=b''\ni=8\nimport collections\nwhile i<len(d):\n    ln=struct.unpack('>I',d[i:i+4])[0]; typ=d[i+4:i+8]\n    if typ==b'IDAT': idat+=d[i+8:i+8+ln]\n    elif typ==b'IEND': break\n    i+=12+ln\nraw=zlib.decompress(idat)\nstride=w*1+1\npx=[]\nfor y in range(h):\n    f=raw[y*stride]; row=raw[y*stride+1:(y+1)*stride]\n    px.extend(row)\nc=collections.Counter(px)\nprint('num distinct',len(c))\nprint('most common',c.most_common(5))\nprint('min,max',min(px),max(px),'mean',sum(px)/len(px))\nEOF\n"]
