[329.758891, "i", "        data=list(struct.unpack('%df'%numel, raw))\n        return Storage(key, numel, data)\n    def _rebuild(self, storage, offset, size, stride, requires_grad, hooks):\n        total=1\n        for s in size: total*=s\n        return Tensor(storage.data[offset:offset+total], list(size))\n\ndef reshape(data, shape):\n    if len(shape)==1:\n        return list(data[:shape[0]])\n    inner=shape[1:]; step=1\n    for s in inner: step*=s\n    return [reshape(data[i*step:(i+1)*step], inner) for i in range(shape[0])]\n\nZ=zipfile.ZipFile('model.pth')\nbo=Z.read('simple_mnist/byteorder').decode().strip()\npkl=Z.read('simple_mnist/data.pkl')\nstate=Loader(io.BytesIO(pkl), Z, bo).load()\nout={'weights':{}}\nfor name,t in state.items():\n    if name=='_metadata': continue\n    out['weights'][name]=reshape(t.data, t.shape)\nmi=state['input_layer.weight'].shape\nmo=state['output_layer.weight'].shape\nout['metadata']={'input_dim':mi[1],'hidden_dim':mi[0],'num_classes':mo[0]}\njson.dump(out, open('weights.json','w'))\nprint('byteorder', bo)\nprint("]
