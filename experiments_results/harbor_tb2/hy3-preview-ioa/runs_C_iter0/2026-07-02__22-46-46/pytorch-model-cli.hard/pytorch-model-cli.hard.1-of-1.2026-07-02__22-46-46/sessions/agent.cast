[403.326109, "o", "\u001b[?2004l\r\u001b[?2004h>     raw = zlib.decompress(idat)\r\n\u001b[?2004l\r\u001b[?2004h>     channels = {0:1, 2:3, 3:1, 4:2, 6:4}[col]\r\n\u001b[?2004l\r\u001b[?2004h>     stride = w * channels\r\n\u001b[?2004l\r\u001b[?2004h>     def recon():"]
[403.326506, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         result = bytearray()\r\n\u001b[?2004l\r\u001b[?2004h>         prev = bytearray(stride)\r\n\u001b[?2004l\r\u001b[?2004h> "]
