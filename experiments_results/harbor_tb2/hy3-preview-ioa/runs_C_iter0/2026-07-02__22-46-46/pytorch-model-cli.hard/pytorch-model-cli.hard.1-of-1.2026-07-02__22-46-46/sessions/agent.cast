[403.302225, "i", "cat > cli_tool <<'PYEOF'\n#!/usr/bin/env python3\nimport sys, json, struct, zlib\n\ndef load_weights(path):\n    with open(path) as f:\n        w = json.load(f)\n    return w['weights'], w.get('metadata', {})\n\ndef paeth(a, b, c):\n    p = a + b - c\n    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)\n    if pa <= pb and pa <= pc:\n        return a\n    if pb <= pc:\n        return b\n    return c\n\ndef decode_png(data):\n    if data[:8] != bytes([137,80,78,71,13,10,26,10]):\n        raise ValueError('not a PNG')\n    w = h = col = None\n    idat = b''\n    palette = None\n    i = 8\n    while i < len(data):\n        ln = struct.unpack('>I', data[i:i+4])[0]\n        typ = data[i+4:i+8]\n        chunk = data[i+8:i+8+ln]\n        if typ == b'IHDR':\n            w, h = struct.unpack('>II', chunk[0:8])\n            col = chunk[9]\n        elif typ == b'PLTE':\n            palette = chunk\n        elif typ == b'IDAT':\n            idat += chunk\n        elif typ == b'IEND':\n            break\n       "]
[403.30255, "o", "cat > cli_tool <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.302619, "o", "> "]
