[403.307283, "i", " i += 12 + ln\n    raw = zlib.decompress(idat)\n    channels = {0:1, 2:3, 3:1, 4:2, 6:4}[col]\n    stride = w * channels\n    def recon():\n        result = bytearray()\n        prev = bytearray(stride)\n        pos = 0\n        for y in range(h):\n            ft = raw[pos]; pos += 1\n            line = bytearray(raw[pos:pos+stride]); pos += stride\n            for x in range(stride):\n                a = line[x-channels] if x >= channels else 0\n                b = prev[x]\n                c = prev[x-channels] if x >= channels else 0\n                if ft == 1:\n                    line[x] = (line[x] + a) & 0xff\n                elif ft == 2:\n                    line[x] = (line[x] + b) & 0xff\n                elif ft == 3:\n                    line[x] = (line[x] + ((a+b)//2)) & 0xff\n                elif ft == 4:\n                    line[x] = (line[x] + paeth(a,b,c)) & 0xff\n            result += line\n            prev = line\n        return bytes(result)\n    pixels = recon()\n    out = [[0]*w for _ in range(h)]\n    for y in range"]
[403.307317, "i", "(h):\n        for x in range(w):\n            off = y*stride + x*channels\n            if col == 0 or col == 4:\n                v = pixels[off]\n            elif col == 2 or col == 6:\n                v = (int(pixels[off]) + int(pixels[off+1]) + int(pixels[off+2])) // 3\n            elif col == 3:\n                idx = pixels[off]\n                v = palette[idx*3] if palette else 0\n            out[y][x] = v\n    return out, w, h\n\ndef matvec(W, x):\n    return [sum(W[r][c]*x[c] for c in range(len(x))) for r in range(len(W))]\n\ndef add(b, v):\n    return [v[i] + b[i] for i in range(len(b))]\n\ndef relu(v):\n    return [x if x > 0 else 0.0 for x in v]\n\ndef main():\n    if len(sys.argv) < 3:\n        sys.stderr.write('usage: ./cli_tool weights.json image.png\\n')\n        sys.exit(1)\n    weights, meta = load_weights(sys.argv[1])\n    img = open(sys.argv[2], 'rb').read()\n    grid, w, h = decode_png(img)\n    if (w, h) != (28, 28):\n        s = [[0]*28 for _ in range(28)]\n        for j "]
[403.307361, "i", "in range(28):\n            for i in range(28):\n                sx = min(w-1, int(i * w / 28))\n                sy = min(h-1, int(j * h / 28))\n                s[j][i] = grid[sy][sx]\n        grid = s\n    flat = [grid[j][i] for j in range(28) for i in range(28)]\n    x = [(p/255.0 - 0.1307)/0.3081 for p in flat]\n    h1 = relu(add(weights['input_layer.bias'], matvec(weights['input_layer.weight'], x)))\n    h2 = relu(add(weights['hidden_layer.bias'], matvec(weights['hidden_layer.weight'], h1)))\n    out = add(weights['output_layer.bias'], matvec(weights['output_layer.weight'], h2))\n    pred = max(range(len(out)), key=lambda k: out[k])\n    print(pred)\n    with open('prediction.txt', 'w') as f:\n        f.write(str(pred))\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
