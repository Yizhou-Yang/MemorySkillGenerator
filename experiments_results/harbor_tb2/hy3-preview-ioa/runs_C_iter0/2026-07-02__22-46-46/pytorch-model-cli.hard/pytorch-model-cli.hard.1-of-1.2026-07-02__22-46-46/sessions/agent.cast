[403.327449, "o", "\u001b[?2004h"]
[403.328719, "o", ">             line = bytearray(raw[pos:pos+stride]); pos += stride\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.328754, "o", ">             for x in range(stride):\r\n\u001b[?2004l\r\u001b[?2004h>                 a = line[x-channels] if x >= channels else 0\r\n\u001b[?2004l\r\u001b[?2004h>                 b = prev[x]\r\n\u001b[?2004l\r\u001b[?2004h>                 c = prev[x-channels] if x >= channels else 0"]
[403.329145, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                 if ft == 1:\r\n"]
[403.32931, "o", "\u001b[?2004l\r"]
[403.329467, "o", "\u001b[?2004h"]
[403.329826, "o", ">                     line[x] = (line[x] + a) & 0xff"]
[403.329848, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.329974, "o", "> "]
[403.330527, "o", "                elif ft == 2:\r\n\u001b[?2004l\r\u001b[?2004h>                     line[x] = (line[x] + b) & 0xff\r\n\u001b[?2004l\r\u001b[?2004h>                 elif ft == 3:"]
[403.331289, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                     line[x] = (line[x] + ((a+b)//2)) & 0xff\r\n\u001b[?2004l\r\u001b[?2004h>                 elif ft == 4:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.332063, "o", "                    line[x] = (line[x] + paeth(a,b,c)) & 0xff\r\n\u001b[?2004l\r\u001b[?2004h>             result += line\r\n\u001b[?2004l\r\u001b[?2004h>             prev = line\r\n\u001b[?2004l\r\u001b[?2004h>         return bytes(result)\r\n\u001b[?2004l\r\u001b[?2004h>     pixels = recon()"]
[403.332314, "o", "\r\n"]
[403.337441, "o", "\u001b[?2004l\r\u001b[?2004h>     out = [[0]*w for _ in range(h)]\r\n\u001b[?2004l\r\u001b[?2004h>     for y in range(h):\r\n\u001b[?2004l\r\u001b[?2004h>         for x in range(w):\r\n\u001b[?2004l\r\u001b[?2004h>             off = y*stride + x*channels\r\n\u001b[?2004l\r\u001b[?2004h>             if col == 0 or col == 4:\r\n\u001b[?2004l\r\u001b[?2004h>                 v = pixels[off]\r\n\u001b[?2004l\r\u001b[?2004h>             elif col == 2 or col == 6:\r\n\u001b[?2004l\r\u001b[?2004h>                 v = (int(pixels[off]) + int(pixels[off+1]) + int(pixels[off+2])) // 3\r\n\u001b[?2004l\r\u001b[?2004h>             elif col == 3:\r\n\u001b[?2004l\r\u001b[?2004h>                 idx = pixels[off]\r\n\u001b[?2004l\r\u001b[?2004h>                 v = palette[idx*3] if palette else 0\r\n\u001b[?2004l\r\u001b[?2004h>             out[y][x] = v\r\n\u001b[?2004l\r\u001b[?2004h>     return out, w, h\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def matvec(W, x):\r\n\u001b[?2004l\r\u001b[?2004h>     return [sum(W[r][c]*x[c] for c in range(len(x))) for r in range(len(W))]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def add(b, v):\r\n\u001b[?2004l\r\u001b[?2004h>     return [v[i] + b[i] for i in range(len(b))]\r\n\u001b[?"]
[403.3375, "o", "2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def relu(v):\r\n\u001b[?2004l\r\u001b[?2004h> "]
