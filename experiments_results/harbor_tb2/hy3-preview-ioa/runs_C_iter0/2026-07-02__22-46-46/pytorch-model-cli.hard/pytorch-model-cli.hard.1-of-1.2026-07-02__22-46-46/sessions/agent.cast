[425.661252, "i", "python3 - <<'EOF'\nimport re\ns=open('cli_tool').read()\n# insert import os near top and use script dir for prediction.txt\nif 'import os' not in s:\n    s=s.replace('#!/usr/bin/env python3\\n','#!/usr/bin/env python3\\nimport os\\n',1)\ns=s.replace(\"    with open('prediction.txt', 'w') as f:\",\n            \"    out_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'prediction.txt')\\n    with open(out_path, 'w') as f:\")\nopen('cli_tool','w').write(s)\nprint('patched')\nEOF\n"]
[425.66133, "o", "python3 - <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> s=open('cli_tool').read()\r\n\u001b[?2004l\r\u001b[?2004h> # insert import os near top and use script dir for prediction.txt\r\n\u001b[?2004l\r\u001b[?2004h> if 'import os' not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     s=s.replace('#!/usr/bin/env python3\\n','#!/usr/bin/env python3\\nimport os\\n',1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[425.661945, "o", "s=s.replace(\"    with open('prediction.txt', 'w') as f:\",\r\n\u001b[?2004l\r\u001b[?2004h>             \"    out_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'prediction.txt')\\n    with open(out_path, 'w') as f:\")"]
[425.667309, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> open('cli_tool','w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> print('patched')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
