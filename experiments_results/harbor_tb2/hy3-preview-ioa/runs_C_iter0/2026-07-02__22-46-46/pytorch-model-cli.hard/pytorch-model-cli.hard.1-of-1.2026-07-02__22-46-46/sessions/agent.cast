[381.549348, "o", "\u001b[?2004l\r\u001b[?2004h>     grid, w, h = decode_png(img)\r\n\u001b[?2004l\r\u001b[?2004h>     # flatten; if not 28x28, resize by nearest sampling\r\n\u001b[?2004l\r\u001b[?2004h>     if (w, h) != (28, 28):\r\n\u001b[?2004l\r\u001b[?2004h>         s = [[0]*28 for _ in range(28)]\r\n\u001b[?2004l\r\u001b[?2004h>         for j in range(28):\r\n\u001b[?2004l\r\u001b[?2004h>             for i in range(28):\r\n\u001b[?2004l\r\u001b[?2004h>                 sx = min(w-1, int(i * w / 28)); sy = min(h-1, int(j * h / 28))\r\n\u001b[?2004l\r\u001b[?2004h>                 s[j][i] = grid[sy][sx]\r\n\u001b[?2004l\r\u001b[?2004h>         grid = s\r\n\u001b[?2004l\r\u001b[?2004h>     flat = [grid[j][i] for j in range(28) for i in range(28)]\r\n\u001b[?2004l\r\u001b[?2004h>     # normalize like MNIST: ToTensor then Normalize(0.1307,0.3081)\r\n\u001b[?2004l\r\u001b[?2004h>     x = [(p/255.0 - 0.1307)/0.3081 for p in flat]\r\n\u001b[?2004l\r\u001b[?2004h>     # adaptive background inversion only if background is bright (MNIST is 0=black)\r\n\u001b[?2004l\r\u001b[?2004h>     if sum(x) > 0:\r\n\u001b[?2004l\r\u001b[?2004h>         bg = sum(sorted(x)[:400])/400\r\n\u001b[?2004l\r\u001b[?2004h> n = 0  # placeholder\r\n\u001b[?2004l\r\u001b[?"]
[381.54944, "o", "2004h>         # We skip inversion because MNIST is black background; but guard against white bg:\r\n\u001b[?2004l\r\u001b[?2004h>     h1 = relu(add(weights['hidden_layer.bias'] if False else weights['input_layer.bias'], matvec(weights['input_layer.weight'], x)))\r\n\u001b[?2004l\r\u001b[?2004h>     h2 = relu(add(weights['hidden_layer.bias'], matvec(weights['hidden_layer.weight'], h1)))\r\n\u001b[?2004l\r\u001b[?2004h>     out = add(weights['output_layer.bias'], matvec(weights['output_layer.weight'], h2))\r\n\u001b[?2004l\r\u001b[?2004h>     pred = max(range(len(out)), key=lambda k: out[k])\r\n\u001b[?2004l\r\u001b[?2004h>     print(pred)\r\n\u001b[?2004l\r\u001b[?2004h>     with open('prediction.txt', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(str(pred))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
