[381.464232, "i", "cat > cli_tool <<'PYEOF'\n#!/usr/bin/env python3\nimport sys, json, struct, zlib\n\ndef load_weights(path):\n    with open(path) as f:\n        w = json.load(f)\n    return w['weights'], w.get('metadata', {})\n\ndef paeth(a, b, c):\n    p = a + b - c\n    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)\n    if pa <= pb and pa <= pc: return a\n    if pb <= pc: return b\n    return c\n\ndef decode_png(data):\n    if data[:8] != bytes([137,80,78,71,13,10,26,10]):\n        raise ValueError('not a PNG')\n    w = h = bit = col = None\n    idat = b''\n    i = 8\n    palette = None\n    while i < len(data):\n        ln = struct.unpack('>I', data[i:i+4])[0]\n        typ = data[i+4:i+8]\n        chunk = data[i+8:i+8+ln]\n        if typ == b'IHDR':\n            w, h = struct.unpack('>II', chunk[0:8])\n            bit = chunk[8]; col = chunk[9]\n        elif typ == b'PLTE':\n            palette = chunk\n        elif typ == b'IDAT':\n            idat += chunk\n        elif typ == b'IEND':\n            break\n        i += 12 + ln\n    raw = zlib.decompress(id"]
[381.464426, "i", "at)\n    channels = {0:1, 2:3, 3:1, 4:2, 6:4}[col]\n    def getpix(raw, x, y):\n        stride = w * channels + 1\n        base = y * stride + 1 + x * channels\n        return raw[base:base+channels]\n    out = [[0]*w for _ in range(h)]\n    bpp = channels\n    # process scanlines\n    stride = w * channels\n    # bpp in bytes per pixel for filtering = channels (8-bit assumed)\n    def recon():\n        result = bytearray()\n        prev = bytearray(stride)\n        pos = 0\n        for y in range(h):\n            ft = raw[pos]; pos += 1\n            line = bytearray(raw[pos:pos+stride]); pos += stride\n            for x in range(stride):\n                a = line[x-bpp] if x >= bpp else 0\n                b = prev[x]\n                c = prev[x-bpp] if x >= bpp else 0\n                if ft == 0: pass\n                elif ft == 1: line[x] = (line[x] + a) & 0xff\n                elif ft == 2: line[x] = (line[x] + b) & 0xff\n                elif ft == 3: line[x] = (line[x] + ((a+b)//2)) & 0xff\n                elif ft == 4: line[x] = "]
[381.464444, "o", "cat > cli_tool <<'PYEOF'\r\n\u001b[?2004l\r"]
[381.464451, "i", "(line[x] + paeth(a,b,c)) & 0xff\n            result += line\n            prev = line\n        return bytes(result)\n    pixels = recon()\n    for y in range(h):\n        for x in range(w):\n            off = y*stride + x*channels\n            if col == 0:\n                v = pixels[off]\n            elif col == 2:\n                v = (int(pixels[off]) + int(pixels[off+1]) + int(pixels[off+2]))//3\n            elif col == 4:\n                v = pixels[off]\n            elif col == 6:\n                v = (int(pixels[off]) + int(pixels[off+1]) + int(pixels[off+2]))//3\n            elif col == 3:\n                idx = pixels[off]\n                v = palette[idx*3] if palette else 0\n            out[y][x] = v\n    return out, w, h\n\ndef matvec(W, x):\n    return [sum(W[r][c]*x[c] for c in range(len(x))) for r in range(len(W))]\n\ndef add(b, v):\n    return [v[i] + b[i] for i in range(len(b))]\n\ndef relu(v):\n    return [x if x > 0 else 0.0 for x in v]\n\ndef main():\n    if len(sys.argv) < 3:\n        sys.stderr.write('usage: ./cli_tool w"]
[381.464586, "o", "at)\r\n    channels = {0:1, 2:3, 3:1, 4:2, 6:4}[col]\r\n    def getpix(raw, x, y):\r\n        stride = w * channels + 1\r\n        base = y * stride + 1 + x * channels\r\n        return raw[base:base+channels]\r\n    out = [[0]*w for _ in range(h)]\r\n    bpp = channels\r\n    # process scanlines\r\n    stride = w * channels\r\n    # bpp in bytes per pixel for filtering = channels (8-bit assumed)\r\n    def recon():\r\n        result = bytearray()\r\n        prev = bytearray(stride)\r\n        pos = 0\r\n        for y in range(h):\r\n            ft = raw[pos]; pos += 1\r\n            line = bytearray(raw[pos:pos+stride]); pos += stride\r\n            for x in range(stride):\r\n                a = line[x-bpp] if x >= bpp else 0\r\n                b = prev[x]\r\n                c = prev[x-bpp] if x >= bpp else 0\r\n                if ft == 0: pass\r\n                elif ft == 1: line[x] = (line[x] + a) & 0xff\r\n                elif ft == 2: line[x] = (line[x] + b) & 0xff\r\n                elif ft == 3: line[x] = (line[x] + ((a+b)//2)) & 0xff\r\n              "]
[381.464615, "i", "eights.json image.png\\n')\n        sys.exit(1)\n    weights, meta = load_weights(sys.argv[1])\n    img = open(sys.argv[2], 'rb').read()\n    grid, w, h = decode_png(img)\n    # flatten; if not 28x28, resize by nearest sampling\n    if (w, h) != (28, 28):\n        s = [[0]*28 for _ in range(28)]\n        for j in range(28):\n            for i in range(28):\n                sx = min(w-1, int(i * w / 28)); sy = min(h-1, int(j * h / 28))\n                s[j][i] = grid[sy][sx]\n        grid = s\n    flat = [grid[j][i] for j in range(28) for i in range(28)]\n    # normalize like MNIST: ToTensor then Normalize(0.1307,0.3081)\n    x = [(p/255.0 - 0.1307)/0.3081 for p in flat]\n    # adaptive background inversion only if background is bright (MNIST is 0=black)\n    if sum(x) > 0:\n        bg = sum(sorted(x)[:400])/400\nn = 0  # placeholder\n        # We skip inversion because MNIST is black background; but guard against white bg:\n    h1 = relu(add(weights['hidden_layer.bias'] if False else weights['input_layer.bias'], matvec(weights['in"]
[381.464645, "o", "  elif ft == 4: line[x] = \u001b[?2004h> "]
[381.464655, "i", "put_layer.weight'], x)))\n    h2 = relu(add(weights['hidden_layer.bias'], matvec(weights['hidden_layer.weight'], h1)))\n    out = add(weights['output_layer.bias'], matvec(weights['output_layer.weight'], h2))\n    pred = max(range(len(out)), key=lambda k: out[k])\n    print(pred)\n    with open('prediction.txt', 'w') as f:\n        f.write(str(pred))\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
