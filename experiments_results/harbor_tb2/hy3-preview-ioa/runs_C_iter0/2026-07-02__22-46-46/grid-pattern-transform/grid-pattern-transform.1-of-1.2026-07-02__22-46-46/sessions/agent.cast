[49.365746, "i", "cat > /app/grid_transform.py << 'EOF'\ndef solve(input_grid):\n    \"\"\"\n    Transform the input grid according to the pattern.\n\n    Args:\n        input_grid (List[List[int]]): 2D list of integers representing the input grid\n    Returns:\n        List[List[int]]: 2D list of integers representing the transformed grid\n    \"\"\"\n    height = len(input_grid)\n    width = len(input_grid[0])\n\n    out_h = height * 3\n    out_w = width * 3\n\n    output_grid = [[0 for _ in range(out_w)] for _ in range(out_h)]\n\n    for i in range(out_h):\n        tr = i // height   # tile row index\n        lr = i % height    # local row within the tile\n        for j in range(out_w):\n            lc = j % width # local col within the tile\n            if tr % 2 == 0:\n                val = input_grid[lr][lc]\n            else:\n                # horizontal flip of the input tile\n                val = input_grid[lr][width - 1 - lc]\n            output_grid[i][j] = val\n\n    return output_grid\nEOF\n"]
