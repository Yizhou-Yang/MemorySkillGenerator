[638.297016, "o", "\u001b[?2004l\r"]
[638.297212, "o", "\u001b[?2004h"]
[638.297744, "o", "> "]
[638.298556, "o", "                s = torch.FloatTensor(np.array([b[0] for b in batch]))"]
