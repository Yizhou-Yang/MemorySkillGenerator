[638.290356, "o", "\u001b[?2004l\r"]
[638.290767, "o", "\u001b[?2004h> "]
[638.290957, "o", "            next_obs, reward, term, trunc, _ = env.step(action)"]
[638.291143, "o", "\r\n"]
[638.291333, "o", "\u001b[?2004l\r"]
[638.291555, "o", "\u001b[?2004h"]
[638.291697, "o", "> "]
[638.291975, "o", "            done = term or trunc"]
[638.292182, "o", "\r\n"]
[638.29237, "o", "\u001b[?2004l\r"]
[638.292542, "o", "\u001b[?2004h"]
[638.292873, "o", "> "]
[638.293055, "o", "            buffer.append((obs, action, reward, next_obs, done))"]
[638.293236, "o", "\r\n"]
[638.29346, "o", "\u001b[?2004l\r"]
[638.293617, "o", "\u001b[?2004h"]
[638.293943, "o", "> "]
[638.294135, "o", "            obs = next_obs"]
