[638.305439, "o", "\u001b[?2004l\r"]
[638.305667, "o", "\u001b[?2004h"]
[638.305884, "o", "> "]
[638.306224, "o", "                q_sa = policy_net(s).gather(1, a).squeeze(1)"]
[638.306439, "o", "\r\n"]
[638.306629, "o", "\u001b[?2004l\r"]
[638.30687, "o", "\u001b[?2004h"]
[638.307069, "o", "> "]
[638.308876, "o", "                with torch.no_grad():"]
[638.309129, "o", "\r\n"]
[638.309325, "o", "\u001b[?2004l\r"]
[638.314226, "o", "\u001b[?2004h"]
[638.314662, "o", "> "]
[638.314965, "o", "                    next_q = target_net(ns).max(1)[0]"]
[638.315177, "o", "\r\n"]
[638.315391, "o", "\u001b[?2004l\r"]
[638.315618, "o", "\u001b[?2004h"]
[638.315836, "o", "> "]
[638.316116, "o", "                    target = r + GAMMA * next_q * (1 - d)"]
[638.316324, "o", "\r\n"]
[638.316535, "o", "\u001b[?2004l\r"]
[638.316746, "o", "\u001b[?2004h"]
[638.316962, "o", "> "]
[638.318413, "o", "                loss = nn.functional.mse_loss(q_sa, target)"]
[638.318984, "o", "\r\n"]
[638.319253, "o", "\u001b[?2004l\r"]
[638.319503, "o", "\u001b[?2004h"]
[638.319654, "o", "> "]
[638.32006, "o", "                optimizer.zero_grad()"]
