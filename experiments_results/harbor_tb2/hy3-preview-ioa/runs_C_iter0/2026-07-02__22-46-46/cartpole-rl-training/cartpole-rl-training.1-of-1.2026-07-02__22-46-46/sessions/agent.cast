[638.335363, "o", "\u001b[?2004l\r"]
[638.335555, "o", "\u001b[?2004h"]
[638.335813, "o", "> "]
[638.337658, "o", "                loss.backward()"]
[638.337954, "o", "\r\n"]
[638.338101, "o", "\u001b[?2004l\r"]
[638.338283, "o", "\u001b[?2004h"]
[638.33845, "o", "> "]
[638.338767, "o", "                optimizer.step()"]
[638.338992, "o", "\r\n"]
[638.339138, "o", "\u001b[?2004l\r"]
[638.339296, "o", "\u001b[?2004h"]
[638.339546, "o", "> "]
[638.339741, "o", "            if done:"]
