[638.299893, "o", "\u001b[?2004l\r"]
[638.300068, "o", "\u001b[?2004h"]
[638.30028, "o", "> "]
[638.30061, "o", "                a = torch.LongTensor([b[1] for b in batch]).unsqueeze(1)"]
[638.30083, "o", "\r\n"]
[638.301015, "o", "\u001b[?2004l\r"]
[638.301224, "o", "\u001b[?2004h"]
[638.301438, "o", "> "]
[638.301757, "o", "                r = torch.FloatTensor([b[2] for b in batch])"]
[638.301964, "o", "\r\n"]
[638.302148, "o", "\u001b[?2004l\r"]
[638.302372, "o", "\u001b[?2004h"]
[638.302561, "o", "> "]
[638.302961, "o", "                ns = torch.FloatTensor(np.array([b[3] for b in batch]))"]
