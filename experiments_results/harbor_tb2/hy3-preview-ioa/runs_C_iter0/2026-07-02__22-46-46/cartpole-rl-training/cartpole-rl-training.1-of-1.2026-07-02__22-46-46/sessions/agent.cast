[638.294448, "o", "\u001b[?2004l\r"]
[638.29459, "o", "\u001b[?2004h"]
[638.294723, "o", "> "]
[638.295036, "o", "            total += reward"]
[638.295161, "o", "\r\n"]
[638.295317, "o", "\u001b[?2004l\r"]
[638.295624, "o", "\u001b[?2004h"]
[638.295732, "o", ">             if len(buffer) >= BATCH_SIZE:"]
