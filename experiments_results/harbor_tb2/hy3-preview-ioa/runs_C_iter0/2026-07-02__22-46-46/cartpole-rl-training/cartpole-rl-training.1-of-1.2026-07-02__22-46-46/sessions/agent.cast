[153.881848, "i", "cat > /app/train.py << 'PYEOF'\nimport random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom collections import deque\n\nimport gymnasium as gym\nfrom agent import Agent, DQN\n\n\nBATCH_SIZE = 128\nGAMMA = 0.99\nLR = 1e-3\nBUFFER_SIZE = 50000\nTARGET_UPDATE = 10\nEPISODES = 1200\n\n\ndef train():\n    env = gym.make('CartPole-v1')\n    agent = Agent()\n    agent.training = True\n    policy_net = agent.policy_net\n    target_net = DQN()\n    target_net.load_state_dict(policy_net.state_dict())\n    target_net.eval()\n    optimizer = optim.Adam(policy_net.parameters(), lr=LR)\n    buffer = deque(maxlen=BUFFER_SIZE)\n    eps_start, eps_end, eps_decay = 1.0, 0.02, 4000\n\n    steps = 0\n    for ep in range(EPISODES):\n        obs, _ = env.reset()\n        total = 0\n        agent.epsilon = eps_end + (eps_start - eps_end) * np.exp(-steps / eps_decay)\n        while True:\n            steps += 1\n            action = agent.select_action(obs)\n            next_obs,"]
[153.882498, "i", " reward, term, trunc, _ = env.step(action)\n            done = term or trunc\n            buffer.append((obs, action, reward, next_obs, done))\n            obs = next_obs\n            total += reward\n            if len(buffer) >= BATCH_SIZE:\n                batch = random.sample(buffer, BATCH_SIZE)\n                s = torch.FloatTensor(np.array([b[0] for b in batch]))\n                a = torch.LongTensor([b[1] for b in batch]).unsqueeze(1)\n                r = torch.FloatTensor([b[2] for b in batch])\n                ns = torch.FloatTensor(np.array([b[3] for b in batch]))\n                d = torch.FloatTensor([b[4] for b in batch])\n                q_sa = policy_net(s).gather(1, a).squeeze(1)\n                with torch.no_grad():\n                    next_q = target_net(ns).max(1)[0]\n                    target = r + GAMMA * next_q * (1 - d)\n                loss = nn.functional.mse_loss(q_sa, target)\n                optimizer.zero_grad()\n                loss.backward()\n                optimizer.step()\n            if d"]
[153.882688, "i", "one:\n                break\n        if ep % TARGET_UPDATE == 0:\n            target_net.load_state_dict(policy_net.state_dict())\n        if ep % 50 == 0:\n            print(f'Ep {ep} reward {total:.0f} eps {agent.epsilon:.3f}')\n\n    env.close()\n    agent.training = False\n    agent.save('/app/trained_model')\n    print('Saved model to /app/trained_model')\n\n\nif __name__ == '__main__':\n    train()\nPYEOF\n"]
