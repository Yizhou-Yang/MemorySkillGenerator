[638.284728, "o", ">         total = 0"]
[638.284946, "o", "\r\n"]
[638.285077, "o", "\u001b[?2004l\r"]
[638.285454, "o", "\u001b[?2004h"]
[638.285574, "o", ">         agent.epsilon = eps_end + (eps_start - eps_end) * np.exp(-steps / eps_decay)"]
[638.285772, "o", "\r\n"]
[638.285981, "o", "\u001b[?2004l\r"]
[638.287656, "o", "\u001b[?2004h"]
[638.287895, "o", "> "]
[638.288134, "o", "        while True:"]
