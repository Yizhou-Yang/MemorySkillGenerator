[79.008249, "o", "        raise FileNotFoundError(f\"Certificate not found: {CERT_PATH}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.008268, "o", "    if not os.path.isfile(KEY_PATH):\r\n"]
[79.008328, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[79.008559, "o", "        raise FileNotFoundError(f\"Private key not found: {KEY_PATH}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.008765, "o", "    subject_out = subprocess.run(\r\n\u001b[?2004l\r"]
[79.008817, "o", "\u001b[?2004h> "]
[79.008953, "o", "        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\"],"]
[79.009044, "o", "\r\n"]
[79.009083, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[79.009262, "o", "        capture_output=True, text=True, check=True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.00928, "o", "    )\r\n\u001b[?2004l\r"]
[79.009343, "o", "\u001b[?2004h> "]
[79.009425, "o", "    dates_out = subprocess.run(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.009613, "o", "        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-dates\"],\r\n\u001b[?2004l\r"]
[79.009687, "o", "\u001b[?2004h> "]
[79.009792, "o", "        capture_output=True, text=True, check=True,\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[79.009877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.00996, "o", "    subject = subject_out.stdout.strip()\r\n\u001b[?2004l\r"]
[79.010026, "o", "\u001b[?2004h> "]
[79.010059, "o", "    cn = \"unknown\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.010176, "o", "    for part in subject.split(\",\"):\r\n\u001b[?2004l\r"]
[79.010273, "o", "\u001b[?2004h"]
[79.010335, "o", "> "]
[79.010397, "o", "        if \"CN\" in part:"]
[79.010481, "o", "\r\n"]
[79.010648, "o", "\u001b[?2004l\r"]
[79.010864, "o", "\u001b[?2004h> "]
[79.011016, "o", "            cn = part.split(\"=\", 1)[1].strip()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.011076, "o", "\u001b[?2004h> "]
[79.011102, "o", "    not_after = \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.012544, "o", "    for line in dates_out.stdout.splitlines():\r\n\u001b[?2004l\r\u001b[?2004h>         if line.startswith(\"notAfter=\"):\r\n\u001b[?2004l\r"]
[79.01281, "o", "\u001b[?2004h>             not_after = line.split(\"=\", 1)[1].strip()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     expiration = \"unknown\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not_after:\r\n\u001b[?2004l\r\u001b[?2004h>         for fmt in (\"%b %d %H:%M:%S %Y %Z\", \"%b %d %H:%M:%S %Y GMT\"):\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 expiration = datetime.strptime(not_after, fmt).strftime(\"%Y-%m-%d\")\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>             except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Certificate details:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.012837, "o", "    print(f\"  Common Name: {cn}\")\r\n\u001b[?2004l\r"]
[79.013277, "o", "\u001b[?2004h>     print(f\"  Expiration date: {expiration}\")\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Certificate verification successful\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.013503, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.013625, "o", "if __name__ == \"__main__\":"]
[79.013819, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.013925, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
