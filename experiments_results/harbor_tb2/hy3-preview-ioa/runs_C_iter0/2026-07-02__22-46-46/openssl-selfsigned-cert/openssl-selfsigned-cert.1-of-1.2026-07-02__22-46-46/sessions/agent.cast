[79.004897, "i", "cat > /app/check_cert.py << 'EOF'\n#!/usr/bin/env python3\nimport os\nimport ssl\nimport subprocess\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\nKEY_PATH = \"/app/ssl/server.key\"\n\n\ndef main():\n    if not os.path.isfile(CERT_PATH):\n        raise FileNotFoundError(f\"Certificate not found: {CERT_PATH}\")\n    if not os.path.isfile(KEY_PATH):\n        raise FileNotFoundError(f\"Private key not found: {KEY_PATH}\")\n\n    subject_out = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\"],\n        capture_output=True, text=True, check=True,\n    )\n    dates_out = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-dates\"],\n        capture_output=True, text=True, check=True,\n    )\n\n    subject = subject_out.stdout.strip()\n    cn = \"unknown\"\n    for part in subject.split(\",\"):\n        if \"CN\" in part:\n            cn = part.split(\"=\", 1)[1].strip()\n\n    not_after = \"\"\n    for line in dates_out.stdout.splitlines():\n        if line.startswith(\"notAfter=\"):\n    "]
[79.004958, "i", "        not_after = line.split(\"=\", 1)[1].strip()\n\n    expiration = \"unknown\"\n    if not_after:\n        for fmt in (\"%b %d %H:%M:%S %Y %Z\", \"%b %d %H:%M:%S %Y GMT\"):\n            try:\n                expiration = datetime.strptime(not_after, fmt).strftime(\"%Y-%m-%d\")\n                break\n            except ValueError:\n                continue\n\n    print(\"Certificate details:\")\n    print(f\"  Common Name: {cn}\")\n    print(f\"  Expiration date: {expiration}\")\n    print(\"Certificate verification successful\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
