[113.671036, "i", "cat > /app/diag.py << 'PYEOF'\nimport pickle, io, zipfile\nz = zipfile.ZipFile('/app/model.pth')\npkldata = z.read('simple_mnist/data.pkl')\nclass U(pickle.Unpickler):\n    def persistent_load(self, pid):\n        print(\"PERSISTENT:\", type(pid), repr(pid)[:200])\n        return ('STORAGE', pid)\n    def find_class(self, module, name):\n        print(\"CLASS:\", module, name)\n        if name == '_rebuild_tensor_v2':\n            def f(*a):\n                print(\"  REBUILD args:\", [type(x) for x in a], a[2] if len(a)>2 else None)\n                return ('TENSOR', a)\n            return f\n        if 'Storage' in name:\n            def f(*a):\n                print(\"  STORG\", name, a)\n                return ('SOBJ', name)\n            return f\n        return object\nU(io.BytesIO(pkldata)).load()\nPYEOF\npython3 /app/diag.py 2>&1 | head -60\n"]
