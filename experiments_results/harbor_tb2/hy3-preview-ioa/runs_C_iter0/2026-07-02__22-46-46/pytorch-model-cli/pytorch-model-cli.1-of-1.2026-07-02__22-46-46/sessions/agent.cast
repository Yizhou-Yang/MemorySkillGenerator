[583.369644, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main(int argc, char** argv){\r\n\u001b[?2004l\r\u001b[?2004h>     if(argc != 3) die(\"usage: cli_tool weights.json image.png\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.369904, "o", "    const char* wpath = argv[1];\r\n\u001b[?2004l\r\u001b[?2004h>     const char* ipath = argv[2];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.370091, "o", "    // load weights json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.371046, "o", "    FILE* f = fopen(wpath, \"rb\");\r\n\u001b[?2004l\r\u001b[?2004h>     if(!f) die(\"cannot open weights file\");\r\n\u001b[?2004l\r\u001b[?2004h>     fseek(f,0,SEEK_END); long sz = ftell(f); fseek(f,0,SEEK_SET);\r\n\u001b[?2004l\r\u001b[?2004h>     std::string buf(sz,0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.371127, "o", "    fread(&buf[0],1,sz,f); fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h>     cJSON* root = cJSON_Parse(buf.c_str());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.37144, "o", "    if(!root) die(\"invalid json\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.371619, "o", "    std::vector<double> W1 = load_array(root,\"W1\");\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> b1 = load_array(root,\"b1\");\r\n\u001b[?2004l\r"]
[583.372344, "o", "\u001b[?2004h> "]
[583.372479, "o", "    std::vector<double> W2 = load_array(root,\"W2\");\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> b2 = load_array(root,\"b2\");\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> W3 = load_array(root,\"W3\");\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> b3 = load_array(root,\"b3\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.372823, "o", "    int hidden = cJSON_GetObjectItemCaseSensitive(root,\"hidden_dim\")->valueint;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.381717, "o", "    int num_classes = cJSON_GetObjectItemCaseSensitive(root,\"num_classes\")->valueint;\r\n\u001b[?2004l\r"]
[583.38494, "o", "\u001b[?2004h>     cJSON_Delete(root);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     // decode png\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<unsigned char> image;\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned w,h;\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned err = lodepng::decode(image, w, h, ipath);\r\n\u001b[?2004l\r\u001b[?2004h>     if(err) die(\"png decode failed\");\r\n\u001b[?2004l\r\u001b[?2004h>     if((int)w!=28 || (int)h!=28) fprintf(stderr,\"warning: image is %ux%u, expected 28x28\\n\", w, h);\r\n\u001b[?2004l\r\u001b[?2004h>     // image is RGBA; convert to grayscale (take red channel)\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> x(w*h);\r\n\u001b[?2004l\r\u001b[?2004h>     for(unsigned i=0;i<w*h;i++){\r\n\u001b[?2004l\r\u001b[?2004h>         x[i] = (double)image[i*4+0];\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     // forward pass (raw 0-255 pixel values)\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> h1(hidden,0.0);\r\n\u001b[?2004l\r\u001b[?2004h>     for(int j=0;j<hidden;j++){\r\n\u001b[?2004l\r\u001b[?2004h>         double s = b1[j];\r\n\u001b[?2004l\r\u001b[?2004h>         for(int i=0;i<784;i++) s += W1[j*784+i]*"]
[583.384982, "o", "x[i];\r\n\u001b[?2004l\r\u001b[?2004h>         h1[j] = s>0? s:0.0;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> h2(hidden,0.0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.384996, "o", "    for(int j=0;j<hidden;j++){\r\n\u001b[?2004l\r"]
[583.386989, "o", "\u001b[?2004h> "]
[583.392915, "o", "        double s = b2[j];\r\n\u001b[?2004l\r\u001b[?2004h>         for(int i=0;i<hidden;i++) s += W2[j*hidden+i]*h1[i];\r\n\u001b[?2004l\r\u001b[?2004h>         h2[j] = s>0? s:0.0;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> out(num_classes,0.0);\r\n\u001b[?2004l\r\u001b[?2004h>     for(int j=0;j<num_classes;j++){\r\n\u001b[?2004l\r\u001b[?2004h>         double s = b3[j];\r\n\u001b[?2004l\r\u001b[?2004h>         for(int i=0;i<hidden;i++) s += W3[j*hidden+i]*h2[i];\r\n\u001b[?2004l\r\u001b[?2004h>         out[j] = s;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     int pred=0;\r\n\u001b[?2004l\r\u001b[?2004h>     for(int j=1;j<num_classes;j++) if(out[j]>out[pred]) pred=j;\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"%d\\n\", pred);\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> CPPEOF\r\n\u001b[?2004l\r"]
