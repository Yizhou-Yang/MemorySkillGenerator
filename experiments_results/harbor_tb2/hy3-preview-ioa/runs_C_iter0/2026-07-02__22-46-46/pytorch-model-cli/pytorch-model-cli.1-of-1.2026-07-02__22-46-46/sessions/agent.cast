[228.788471, "i", "cat > /app/convert.py << 'PYEOF'\nimport pickle, io, zipfile, struct, json\n\nz = zipfile.ZipFile('/app/model.pth')\npkldata = z.read('simple_mnist/data.pkl')\n\nclass Storage:\n    _cache = {}\n    def __init__(self, key):\n        self.key = key\n    def data(self):\n        if self.key not in Storage._cache:\n            Storage._cache[self.key] = z.read('simple_mnist/data/' + self.key)\n        return Storage._cache[self.key]\n\nclass Tensor:\n    def __init__(self, storage, offset, size, stride):\n        self.storage = storage\n        self.offset = offset\n        self.size = size\n        self.stride = stride\n\ndef rebuild(storage, offset, size, stride, requires_grad, hooks):\n    return Tensor(storage, offset, size, stride)\n\nclass StateList:\n    def __init__(self):\n        self.items = []\n    def __setitem__(self, k, v):\n        self.items.append((k, v))\n\nclass U(pickle.Unpickler):\n    def find_class(self, module, name):\n        if module == 'collections' and name == 'OrderedDict':\n            return lambda: StateList()\n "]
[228.788545, "i", "       if name == '_rebuild_tensor_v2':\n            return rebuild\n        class D: pass\n        return D\n    def persistent_load(self, pid):\n        return Storage(pid[2])\n\nstate_obj = U(io.BytesIO(pkldata)).load()\nstate = state_obj.items\n\nweights = {}\nfor key, t in state:\n    buf = t.storage.data()\n    n = 1\n    for s in t.size:\n        n *= s\n    vals = struct.unpack_from('<%df' % n, buf, t.offset*4)\n    weights[key] = list(vals)\n\norder = ['input_layer.weight','input_layer.bias','hidden_layer.weight','hidden_layer.bias','output_layer.weight','output_layer.bias']\nassert all(k in weights for k in order), weights.keys()\nout = {\n  'input_dim': 784, 'hidden_dim': 16, 'num_classes': 10,\n  'W1': weights['input_layer.weight'],\n  'b1': weights['input_layer.bias'],\n  'W2': weights['hidden_layer.weight'],\n  'b2': weights['hidden_layer.bias'],\n  'W3': weights['output_layer.weight'],\n  'b3': weights['output_layer.bias'],\n}\nwith open('/app/weights.json','w') as f:\n    json.dump(out, f)\nprint('shapes W1', len(out['W1']),"]
[228.788559, "i", " 'b1', len(out['b1']), 'W2', len(out['W2']), 'b2', len(out['b2']), 'W3', len(out['W3']), 'b3', len(out['b3']))\nprint('wrote /app/weights.json bytes=', len(json.dumps(out)))\nPYEOF\npython3 /app/convert.py\n"]
