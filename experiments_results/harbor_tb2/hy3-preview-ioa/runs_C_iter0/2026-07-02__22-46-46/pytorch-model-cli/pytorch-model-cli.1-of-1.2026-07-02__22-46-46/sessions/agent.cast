[549.656588, "i", "]; rp+=stride\n        prev = out[-stride:] if y>0 else bytes(stride)\n        row = bytearray(stride)\n        for i in range(stride):\n            x = line[i]\n            a = row[i-bpp] if i>=bpp else 0\n            b = prev[i]\n            c = prev[i-bpp] if i>=bpp else 0\n            if f==0: v=x\n            elif f==1: v=x+a\n            elif f==2: v=x+b\n            elif f==3: v=x+(a+b)//2\n            elif f==4: v=x+paeth(a,b,c)\n            row[i] = v & 0xff\n        out += row\n    # grayscale: take first channel\n    if ch>1:\n        px = [out[i] for i in range(0,len(out),ch)]\n    else:\n        px = list(out)\n    return width,height,px\n\nW = json.load(open('/app/weights.json'))\nW1=W['W1']; b1=W['b1']; W2=W['W2']; b2=W['b2']; W3=W['W3']; b3=W['b3']\nh=W['hidden_dim']; n=W['num_classes']\n\ndef forward(x):\n    h1=[0.0]*h\n    for j in range(h):\n        s=b1[j]\n        for i in range(784): s+=W1[j*784+i]*x[i]\n        h1[j]= max(0.0,s)\n    h2=[0.0]*h\n    for j in range(h):\n        s=b2[j]\n        for i in range(h): s+=W2[j"]
[549.656617, "o", "        ln = struct.unpack('>I', d[pos:pos+4])[0]"]
[549.656633, "i", "*h+i]*h1[i]\n        h2[j]= max(0.0,s)\n    out=[0.0]*n\n    for j in range(n):\n        s=b3[j]\n        for i in range(h): s+=W3[j*h+i]*h2[i]\n        out[j]=s\n    return out\n\nw,hgt,px = read_png('/app/image.png')\nprint('image', w, hgt, 'min', min(px), 'max', max(px), 'n', len(px))\n\ndef show(name, x):\n    o=forward(x)\n    am=max(range(n), key=lambda i:o[i])\n    print(name, 'argmax', am, 'logits', [round(v,1) for v in o])\n\nx_raw=[float(v) for v in px]\nshow('raw0-255', x_raw)\nshow('div255', [v/255.0 for v in x_raw])\nshow('div255_inv', [(255.0-v)/255.0 for v in x_raw])\nm=sum(x_raw)/len(x_raw); var=sum((v-m)**2 for v in x_raw)/len(x_raw); sd=var**0.5\nprint('mean', round(m,2), 'sd', round(sd,2))\nshow('std', [(v-m)/sd for v in x_raw])\nshow('std_inv', [((255.0-v)-m)/sd for v in x_raw])\nPYEOF\npython3 /app/analyze.py\n"]
