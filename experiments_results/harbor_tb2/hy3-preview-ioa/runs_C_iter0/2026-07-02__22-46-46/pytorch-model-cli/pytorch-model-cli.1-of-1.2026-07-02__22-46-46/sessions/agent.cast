[583.363063, "o", "\u001b[?2004l\r\u001b[?2004h>     for(int i=0;i<n;i++){\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.363292, "o", "        cJSON* e = cJSON_GetArrayItem(arr,i);\r\n\u001b[?2004l\r\u001b[?2004h"]
