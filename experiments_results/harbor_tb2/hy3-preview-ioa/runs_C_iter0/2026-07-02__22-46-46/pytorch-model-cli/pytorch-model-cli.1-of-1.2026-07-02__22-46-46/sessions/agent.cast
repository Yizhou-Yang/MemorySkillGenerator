[549.647835, "i", "cat > /app/analyze.py << 'PYEOF'\nimport zlib, struct, json\n\ndef read_png(path):\n    d = open(path,'rb').read()\n    assert d[:8] == bytes([137,80,78,71,13,10,26,10])\n    pos = 8\n    idat = b''\n    width=height=bitdepth=colortype=None\n    while pos < len(d):\n        ln = struct.unpack('>I', d[pos:pos+4])[0]\n        typ = d[pos+4:pos+8]\n        data = d[pos+8:pos+8+ln]\n        pos += 12+ln\n        if typ == b'IHDR':\n            width,height,bitdepth,colortype = struct.unpack('>IIBB', data[:10])\n        elif typ == b'IDAT':\n            idat += data\n        elif typ == b'IEND':\n            break\n    raw = zlib.decompress(idat)\n    ch = {0:1,2:3,3:1,4:2,6:4}[colortype]\n    stride = width*ch\n    out = bytearray()\n    bpp = ch\n    def paeth(a,b,c):\n        p = a+b-c\n        pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)\n        return a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\n    rp=0\n    for y in range(height):\n        f = raw[rp]; rp+=1\n        line = raw[rp:rp+stride"]
[549.654043, "o", "cat > /app/analyze.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import zlib, struct, json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def read_png(path):\r\n\u001b[?2004l\r\u001b[?2004h>     d = open(path,'rb').read()\r\n\u001b[?2004l\r\u001b[?2004h>     assert d[:8] == bytes([137,80,78,71,13,10,26,10])\r\n\u001b[?2004l\r\u001b[?2004h>     pos = 8\r\n\u001b[?2004l\r\u001b[?2004h>     idat = b''\r\n"]
[549.654781, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[549.654809, "o", "    width=height=bitdepth=colortype=None"]
[549.65485, "o", "\r\n"]
[549.654928, "o", "\u001b[?2004l\r"]
[549.655064, "o", "\u001b[?2004h"]
[549.655092, "o", ">     while pos < len(d):"]
