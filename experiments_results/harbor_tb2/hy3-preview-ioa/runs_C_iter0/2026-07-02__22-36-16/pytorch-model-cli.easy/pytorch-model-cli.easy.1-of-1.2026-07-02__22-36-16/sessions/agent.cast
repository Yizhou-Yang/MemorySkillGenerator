[733.364217, "o", "root@9eeb48779673:/app# "]
[746.61392, "i", "cat > /app/dl.py << 'EOF'\nimport urllib.request, re, os, sys\nos.makedirs('/app/debs', exist_ok=True)\nurls=[]\nfor line in open('/app/uris.txt'):\n    line=line.strip()\n    if line.startswith(\"'http\"):\n        url=line.split(\"'\")[1]\n        fn=line.split()[1]\n        urls.append((url,fn))\nprint('total',len(urls))\nfor i,(url,fn) in enumerate(urls):\n    dst='/app/debs/'+fn\n    if os.path.exists(dst):\n        continue\n    try:\n        urllib.request.urlretrieve(url,dst)\n    except Exception as e:\n        print('FAIL',fn,e)\nprint('done')\nEOF\npython3 /app/dl.py\n"]
[746.614132, "o", "cat > /app/dl.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
