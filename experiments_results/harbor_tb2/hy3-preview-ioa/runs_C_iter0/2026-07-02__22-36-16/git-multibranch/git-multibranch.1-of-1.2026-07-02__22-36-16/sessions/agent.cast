[63.61963, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nwhile read oldrev newrev refname\ndo\n    branch=$(echo \"$refname\" | sed 's|refs/heads/||')\n    case \"$branch\" in\n        main)\n            mkdir -p /var/www/html\n            git --git-dir=/git/project archive main | tar -x -C /var/www/html\n            ;;\n        dev)\n            mkdir -p /var/www/html/dev\n            git --git-dir=/git/project archive dev | tar -x -C /var/www/html/dev\n            ;;\n    esac\ndone\nEOF\n"]
[63.619872, "o", "cat > /git/project/hooks/post-receive <<'EOF'\r\n#!/bin/bash\r\nwhile read oldrev newrev refname\r\ndo\r\n    branch=$(echo \"$refname\" | sed 's|refs/heads/||')\r\n    case \"$branch\" in\r\n        main)\r\n            mkdir -p /var/www/html\r\n            git --git-dir=/git/project archive main | tar -x -C /var/www/html\r\n            ;;\r\n        dev)\r\n            mkdir -p /var/www/html/dev\r\n            git --git-dir=/git/project archive dev | tar -x -C /var/www/html/dev\r\n            ;;\r\n    esac\r\ndone\r\nEOF\r\n"]
[63.847797, "i", "chmod +x /git/project/hooks/post-receive && chown git:git /git/project/hooks/post-receive\n"]
