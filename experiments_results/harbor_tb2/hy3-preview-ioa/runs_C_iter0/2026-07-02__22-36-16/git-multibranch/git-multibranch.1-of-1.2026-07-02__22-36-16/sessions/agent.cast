[65.52351, "i", "cat > /etc/nginx/conf.d/gitdeploy.conf <<'EOF'\nserver {\n    listen 8443 ssl;\n    server_name localhost;\n    ssl_certificate /etc/nginx/ssl/cert.pem;\n    ssl_certificate_key /etc/nginx/ssl/key.pem;\n    root /var/www/html;\n    index index.html;\n    location / {\n        try_files $uri $uri/ =404;\n    }\n}\nEOF\n"]
[65.523984, "o", "cat > /etc/nginx/conf.d/gitdeploy.conf <<'EOF'\r\nserver {\r\n    listen 8443 ssl;\r\n    server_name localhost;\r\n    ssl_certificate /etc/nginx/ssl/cert.pem;\r\n    ssl_certificate_key /etc/nginx/ssl/key.pem;\r\n    root /var/www/html;\r\n    index index.html;\r\n    location / {\r\n        try_files $uri $uri/ =404;\r\n    }\r\n}\r\nEOF\r\n"]
