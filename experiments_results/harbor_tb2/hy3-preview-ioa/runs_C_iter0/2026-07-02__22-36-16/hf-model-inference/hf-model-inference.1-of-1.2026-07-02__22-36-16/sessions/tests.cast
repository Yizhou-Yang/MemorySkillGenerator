[28.615977, "o", "\r\n"]
[28.616081, "o", "    \u001b[33m        we verify the server's TLS certificate, or a string, in which case it\u001b[39;49;00m"]
[28.616154, "o", "\r\n"]
[28.616277, "o", "    \u001b[33m        must be a path to a CA bundle to use\u001b[39;49;00m"]
[28.616353, "o", "\r\n"]
