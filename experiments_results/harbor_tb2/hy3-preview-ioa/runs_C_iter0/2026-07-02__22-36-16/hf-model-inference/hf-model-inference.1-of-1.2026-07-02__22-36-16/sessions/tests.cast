[28.624616, "o", "                body=request.body,  \u001b[90m# type: ignore[arg-type]  # urllib3 stubs don't accept Iterable[bytes | str]\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[28.624691, "o", "\r\n"]
[28.624818, "o", "                headers=request.headers,  \u001b[90m# type: ignore[arg-type]  # urllib3#3072\u001b[39;49;00m\u001b[90m\u001b[39;49;00m"]
[28.624891, "o", "\r\n"]
[28.624991, "o", "                redirect=\u001b[94mFalse\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
[28.625063, "o", "\r\n"]
[28.625164, "o", "                assert_same_host=\u001b[94mFalse\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
