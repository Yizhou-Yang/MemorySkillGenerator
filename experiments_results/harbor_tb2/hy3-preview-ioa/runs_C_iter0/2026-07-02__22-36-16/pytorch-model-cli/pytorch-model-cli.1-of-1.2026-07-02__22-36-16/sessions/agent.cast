[331.111485, "i", "cat > /app/convert.py << 'EOF'\nimport zipfile, pickle, struct, json\n\nZIP_PATH='/app/model.pth'\n\nclass Mk: pass\nFLOAT=type('FloatStorage',(Mk,),{})\nDOUBLE=type('DoubleStorage',(Mk,),{})\nHALF=type('HalfStorage',(Mk,),{})\nclass Storage:\n    def __init__(self, marker, data):\n        self.marker=marker; self.data=data\n\nclass Loader:\n    def __init__(self, zf):\n        self.zf=zf; self.cache={}\n    def persistent_load(self, pid):\n        if isinstance(pid, tuple) and pid and pid[0]=='storage':\n            marker=pid[1]; key=pid[2]; numel=pid[4]\n            if key in self.cache: return self.cache[key]\n            raw=self.zf.read('simple_mnist/data/'+str(key))\n            if marker is FLOAT: fmt='<%df'%numel; esz=4\n            elif marker is DOUBLE: fmt='<%dd'%numel; esz=8\n            elif marker is HALF: fmt='<%de'%numel; esz=2\n            else: raise Exception('bad marker')\n            vals=list(struct.unpack(fmt, raw[:numel*esz]))\n            s=Storage(marker, vals)"]
