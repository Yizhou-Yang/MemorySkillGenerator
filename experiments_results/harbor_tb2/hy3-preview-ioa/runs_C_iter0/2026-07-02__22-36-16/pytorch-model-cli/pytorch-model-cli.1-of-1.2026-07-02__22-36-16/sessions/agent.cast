[436.112856, "i", "cat > /app/convert.py << 'EOF'\nimport zipfile, pickle, struct, json\n\nZIP_PATH='/app/model.pth'\n\nclass Mk: pass\nFLOAT=type('FloatStorage',(Mk,),{})\nDOUBLE=type('DoubleStorage',(Mk,),{})\nHALF=type('HalfStorage',(Mk,),{})\n\nclass Storage:\n    def __init__(self, marker, data):\n        self.marker=marker; self.data=data\n\nclass MyOD(dict):\n    def __init__(self, items=None):\n        super().__init__()\n        if items:\n            for k,v in items: self[k]=v\n    def __setstate__(self, state):\n        if isinstance(state, dict):\n            self.update(state)\n\nclass Loader:\n    def __init__(self, zf):\n        self.zf=zf; self.cache={}\n    def persistent_load(self, pid):\n        if isinstance(pid, tuple) and pid and pid[0]=='storage':\n            marker=pid[1]; key=pid[2]; numel=pid[4]\n            if key in self.cache: return self.cache[key]\n            raw=self.zf.read('simple_mnist/data/'+str(key))\n            if marker is FLOAT: fmt='<%df'%numel; esz=4\n            elif marker is DOUBLE: fmt='<%dd'%numel; esz=8\n    "]
[436.113013, "i", "        elif marker is HALF: fmt='<%de'%numel; esz=2\n            else: raise Exception('bad marker')\n            vals=list(struct.unpack(fmt, raw[:numel*esz]))\n            s=Storage(marker, vals); self.cache[key]=s; return s\n        return pid\n    def rebuild(self,*a):\n        storage=a[0]; offset=a[1]; size=tuple(a[2])\n        total=1\n        for s in size: total*=s\n        data=storage.data[offset:offset+total]\n        return (data, list(size))\n\nclass PUnpickler(pickle.Unpickler):\n    def __init__(self, f, loader):\n        super().__init__(f); self.loader=loader\n    def persistent_load(self, pid):\n        return self.loader.persistent_load(pid)\n    def find_class(self, module, name):\n        if module=='torch._utils' and name=='_rebuild_tensor_v2':\n            return self.loader.rebuild\n        if module=='collections' and name=='OrderedDict':\n            return MyOD\n        if module=='torch' and name=='FloatStorage': return FLOAT\n        if module=='torch' and name=='DoubleStorage': return DOUBLE\n        "]
[436.113085, "i", "if module=='torch' and name=='HalfStorage': return HALF\n        if module=='torch' and name in ('float32','float64','float16'): return name\n        if module=='torch' and name=='strided': return name\n        raise pickle.UnpicklingError('unsupported %s.%s'%(module,name))\n\nzf=zipfile.ZipFile(ZIP_PATH)\nld=Loader(zf)\ndata=zf.read('simple_mnist/data.pkl')\npk=PUnpickler(__import__('io').BytesIO(data), ld)\nsd=pk.load()\nprint('sd keys:', list(sd.keys()))\n\nrequired=['input_layer.weight','input_layer.bias','hidden_layer.weight','hidden_layer.bias','output_layer.weight','output_layer.bias']\nfor k in required:\n    assert k in sd, 'missing '+k\n\ndef tup(v):\n    if isinstance(v, tuple) and len(v)==2 and isinstance(v[0], list):\n        return v[0], list(v[1])\n    raise Exception('bad value for '+k)\n\nparams={}\nfor k in required:\n    d,sz=tup(sd[k])\n    params[k]=(d,sz)\n    print(k, sz, 'n=', len(d))\n\nw0=params['input_layer.weight'][1]; w1=params['hidden_layer.weight'][1]; w2=params['output_layer.weight'][1]\ninput_dim=w0[1]; "]
[436.113185, "o", "cat > /app/convert.py << 'EOF'\r\n\u001b[?2004l\r"]
[436.113351, "i", "hidden_dim=w0[0]; num_classes=w2[0]\nassert w0==[hidden_dim,input_dim] and w1==[hidden_dim,hidden_dim] and w2==[num_classes,hidden_dim]\nprint('input_dim',input_dim,'hidden_dim',hidden_dim,'num_classes',num_classes)\n\nj={'input_dim':input_dim,'hidden_dim':hidden_dim,'num_classes':num_classes}\nfor layer in ['input_layer','hidden_layer','output_layer']:\n    j[layer+'_weight']=params[layer+'.weight'][0]\n    j[layer+'_bias']=params[layer+'.bias'][0]\nwith open('/app/weights.json','w') as f:\n    json.dump(j,f)\nprint('wrote weights.json, total floats', sum(len(x) for x in j.values() if isinstance(x,list)))\nEOF\n"]
