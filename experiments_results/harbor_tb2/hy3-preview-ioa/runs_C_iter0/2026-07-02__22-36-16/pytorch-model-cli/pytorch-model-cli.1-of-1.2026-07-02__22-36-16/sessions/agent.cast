[282.470898, "i", "cat > /app/convert.py << 'EOF'\nimport zipfile, pickle, struct, json\n\nZIP_PATH='/app/model.pth'\n\nclass Loader:\n    def __init__(self, zf):\n        self.zf=zf\n        self.cache={}\n    def persistent_load(self, pid):\n        if isinstance(pid, tuple) and pid and pid[0]=='storage':\n            stype=pid[1]; key=pid[2]; numel=pid[4]\n            if key in self.cache: return self.cache[key]\n            raw=self.zf.read('simple_mnist/data/'+key)\n            if stype=='FloatStorage': fmt='<'+'f'*numel; esz=4\n            elif stype=='DoubleStorage': fmt='<'+'d'*numel; esz=8\n            elif stype=='HalfStorage': fmt='<'+'e'*numel; esz=2\n            else: raise Exception('unknown storage '+stype)\n            vals=list(struct.unpack(fmt, raw[:numel*esz]))\n            self.cache[key]=vals\n            return vals\n        return pid\n    def rebuild(self,*a):\n        storage=a[0]; offset=a[1]; size=tuple(a[2])\n        total=1\n        for s in size: total*=s\n        data=storag"]
[282.47132, "i", "e[offset:offset+total]\n        return (data, list(size))\n\nclass PUnpickler(pickle.Unpickler):\n    def __init__(self, f, loader):\n        super().__init__(f); self.loader=loader\n    def persistent_load(self, pid):\n        return self.loader.persistent_load(pid)\n    def find_class(self, module, name):\n        if module=='torch._utils' and name=='_rebuild_tensor_v2':\n            return self.loader.rebuild\n        if module=='collections' and name=='OrderedDict':\n            return dict\n        if module=='torch' and name in ('float32','float64','float16'):\n            return name\n        if module=='torch' and name=='strided':\n            return name\n        raise pickle.UnpicklingError('unsupported %s.%s'%(module,name))\n\nzf=zipfile.ZipFile(ZIP_PATH)\nld=Loader(zf)\ndata=zf.read('simple_mnist/data.pkl')\npk=PUnpickler(io_bytes := __import__('io').BytesIO(data), ld)\nsd=pk.load()\n\nout={}\nfor k,v in sd.items():\n    d,sz=v\n    out[k]={'data':d,'size':sz}\n    print(k, sz)\n\n# determine dims\nw0=sd['input_layer.weight'][1]"]
[282.471381, "i", "\nw1=sd['hidden_layer.weight'][1]\nw2=sd['output_layer.weight'][1]\ninput_dim=w0[1]; hidden_dim=w0[0]; num_classes=w2[0]\nassert w0==[hidden_dim,input_dim]\nassert w1==[hidden_dim,hidden_dim]\nassert w2==[num_classes,hidden_dim]\nprint('input_dim',input_dim,'hidden_dim',hidden_dim,'num_classes',num_classes)\n\nj={'input_dim':input_dim,'hidden_dim':hidden_dim,'num_classes':num_classes}\nfor layer in ['input_layer','hidden_layer','output_layer']:\n    w=sd[layer+'.weight'][0]; b=sd[layer+'.bias'][0]\n    j[layer+'_weight']=w\n    j[layer+'_bias']=b\nwith open('/app/weights.json','w') as f:\n    json.dump(j,f)\nprint('wrote weights.json')\nEOF\n"]
