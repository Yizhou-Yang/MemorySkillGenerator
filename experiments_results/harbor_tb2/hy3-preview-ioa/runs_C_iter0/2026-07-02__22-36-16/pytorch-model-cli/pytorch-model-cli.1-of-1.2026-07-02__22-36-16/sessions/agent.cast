[436.147987, "o", "            return MyOD"]
[436.14817, "o", "\r\n\u001b[?2004l\r"]
[436.148328, "o", "\u001b[?2004h> "]
[436.148618, "o", "        if module=='torch' and name=='FloatStorage': return FLOAT"]
[436.148794, "o", "\r\n\u001b[?2004l\r"]
[436.149278, "o", "\u001b[?2004h>         if module=='torch' and name=='DoubleStorage': return DOUBLE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[436.149594, "o", "        if module=='torch' and name=='HalfStorage': return HALF"]
[436.14979, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[436.150098, "o", "> "]
[436.150426, "o", "        if module=='torch' and name in ('float32','float64','float16'): return name\r\n\u001b[?2004l\r"]
[436.15068, "o", "\u001b[?2004h> "]
[436.150966, "o", "        if module=='torch' and name=='strided': return name"]
[436.151179, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[436.151524, "o", "        raise pickle.UnpicklingError('unsupported %s.%s'%(module,name))"]
[436.15171, "o", "\r\n\u001b[?2004l\r"]
[436.151901, "o", "\u001b[?2004h"]
[436.152523, "o", "> \r\n\u001b[?2004l\r"]
[436.153123, "o", "\u001b[?2004h> zf=zipfile.ZipFile(ZIP_PATH)\r\n\u001b[?2004l\r\u001b[?2004h> ld=Loader(zf)\r\n"]
[436.153268, "o", "\u001b[?2004l\r"]
[436.153402, "o", "\u001b[?2004h"]
[436.153526, "o", "> "]
[436.153738, "o", "data=zf.read('simple_mnist/data.pkl')"]
[436.153863, "o", "\r\n"]
[436.153976, "o", "\u001b[?2004l\r"]
[436.154102, "o", "\u001b[?2004h"]
[436.154225, "o", "> "]
[436.154475, "o", "pk=PUnpickler(__import__('io').BytesIO(data), ld)\r\n\u001b[?2004l\r"]
[436.154604, "o", "\u001b[?2004h> "]
[436.154768, "o", "sd=pk.load()\r\n\u001b[?2004l\r"]
[436.154915, "o", "\u001b[?2004h> "]
[436.155116, "o", "print('sd keys:', list(sd.keys()))\r\n\u001b[?2004l\r"]
[436.155269, "o", "\u001b[?2004h> "]
[436.15533, "o", "\r\n"]
[436.155458, "o", "\u001b[?2004l\r"]
[436.155487, "o", "\u001b[?2004h"]
[436.155619, "o", "> "]
[436.156493, "o", "required=['input_layer.weight','input_layer.bias','hidden_layer.weight','hidden_layer.bias','output_layer.weight','output_layer.bias']"]
[436.156638, "o", "\r\n"]
[436.156757, "o", "\u001b[?2004l\r"]
[436.156926, "o", "\u001b[?2004h"]
[436.15705, "o", "> "]
[436.157742, "o", "for k in required:"]
[436.157879, "o", "\r\n"]
[436.157992, "o", "\u001b[?2004l\r"]
[436.158131, "o", "\u001b[?2004h"]
[436.158159, "o", "> "]
[436.158433, "o", "    assert k in sd, 'missing '+k\r\n\u001b[?2004l\r"]
[436.158473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[436.158496, "o", "\u001b[?2004h> "]
[436.158625, "o", "def tup(v):\r\n\u001b[?2004l\r"]
[436.158651, "o", "\u001b[?2004h> "]
[436.159699, "o", "    if isinstance(v, tuple) and len(v)==2 and isinstance(v[0], list):\r\n\u001b[?2004l\r\u001b[?2004h>         return v[0], list(v[1])\r\n\u001b[?2004l\r"]
[436.15974, "o", "\u001b[?2004h> "]
[436.160077, "o", "    raise Exception('bad value for '+k)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> params={}\r\n\u001b[?2004l\r\u001b[?2004h> for k in required:\r\n\u001b[?2004l\r\u001b[?2004h>     d,sz=tup(sd[k])\r\n\u001b[?2004l\r\u001b[?2004h"]
[436.160306, "o", ">     params[k]=(d,sz)\r\n\u001b[?2004l\r\u001b[?2004h>     print(k, sz, 'n=', len(d))\r\n\u001b[?2004l\r\u001b[?2004h"]
[436.160333, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[436.160652, "o", "w0=params['input_layer.weight'][1]; w1=params['hidden_layer.weight'][1]; w2=params['output_layer.weight'][1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[436.160793, "o", "input_dim=w0[1]; hidden_dim=w0[0]; num_classes=w2[0]\r\n\u001b[?2004l\r"]
[436.161009, "o", "\u001b[?2004h> "]
[436.161298, "o", "assert w0==[hidden_dim,input_dim] and w1==[hidden_dim,hidden_dim] and w2==[num_classes,hidden_dim]\r\n\u001b[?2004l\r\u001b[?2004h"]
[436.161408, "o", "> print('input_dim',input_dim,'hidden_dim',hidden_dim,'num_classes',num_classes)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[436.161721, "o", "\u001b[?2004h> j={'input_dim':input_dim,'hidden_dim':hidden_dim,'num_classes':num_classes}\r\n\u001b[?2004l\r\u001b[?2004h> for layer in ['input_layer','hidden_layer','output_layer']:\r\n\u001b[?2004l\r"]
[436.161962, "o", "\u001b[?2004h> "]
[436.162106, "o", "    j[layer+'_weight']=params[layer+'.weight'][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[436.162348, "o", "    j[layer+'_bias']=params[layer+'.bias'][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[436.162482, "o", "with open('/app/weights.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(j,f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[436.162702, "o", "print('wrote weights.json, total floats', sum(len(x) for x in j.values() if isinstance(x,list)))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[436.165562, "o", "\u001b[?2004hroot@0d23ed83aaca:/app# "]
[436.317711, "i", "python3 /app/convert.py\n"]
[436.318709, "o", "python3 /app/convert.py\r\n\u001b[?2004l\r"]
[436.389677, "o", "sd keys: ['input_layer.weight', 'input_layer.bias', 'hidden_layer.weight', 'hidden_layer.bias', 'output_layer.weight', 'output_layer.bias', '_metadata']"]
[436.389949, "o", "\r\ninput_layer.weight [16, 784] n= 12544\r\ninput_layer.bias [16] n= 16\r\nhidden_layer.weight [16, 16] n= 256\r\nhidden_layer.bias [16] n= 16\r\noutput_layer.weight [10, 16] n= 160\r\noutput_layer.bias [10] n= 10\r\n"]
[436.390001, "o", "input_dim 784 hidden_dim 16 num_classes 10\r\n"]
[436.584768, "o", "wrote weights.json, total floats 13002\r\n"]
[436.598265, "m", "Episode 18: 3 commands"]
[436.598265, "o", "\u001b[?2004hroot@0d23ed83aaca:/app# "]
[473.405886, "i", "cat > /app/inspect.cpp << 'EOF'\n#include \"lodepng.h\"\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint main(int argc, char** argv){\n    vector<unsigned char> image;\n    unsigned w,h;\n    unsigned err = lodepng::decode(image, w, h, argv[1]);\n    if(err){ cout<<\"err \"<<lodepng_error_text(err)<<endl; return 1; }\n    int ch = image.size()/(w*h);\n    cout<<\"w=\"<<w<<\" h=\"<<h<<\" channels=\"<<ch<<\" total=\"<<image.size()<<endl;\n    vector<unsigned char> gray(w*h);\n    for(unsigned i=0;i<w*h;i++) gray[i]=image[i*ch];\n    unsigned mn=255,mx=0,sum=0;\n    for(unsigned i=0;i<w*h;i++){ mn=min(mn,gray[i]); mx=max(mx,gray[i]); sum+=gray[i]; }\n    cout<<\"min=\"<<mn<<\" max=\"<<mx<<\" mean=\"<<(sum/(double)(w*h))<<endl;\n    const char* ramp=\" .:-=+*#%@\";\n    for(unsigned y=0;y<h;y++){\n        for(unsigned x=0;x<w;x++){\n            unsigned char g=gray[y*w+x];\n            int idx=(g*9)/255;\n            cout<<ramp[idx];\n        }\n        cout<<endl;\n    }\n    return 0;\n}\nEOF\n"]
[473.406076, "o", "cat > /app/inspect.cpp << 'EOF'"]
