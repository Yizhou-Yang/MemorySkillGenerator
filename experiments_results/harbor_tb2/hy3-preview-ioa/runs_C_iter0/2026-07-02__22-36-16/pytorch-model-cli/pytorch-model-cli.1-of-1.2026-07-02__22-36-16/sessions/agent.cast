[282.619391, "o", "t w2==[num_classes,hidden_dim]\r\n\u001b[?2004l\r\u001b[?2004h> print('input_dim',input_dim,'hidden_dim',hidden_dim,'num_classes',num_classes)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> j={'input_dim':input_dim,'hidden_dim':hidden_dim,'num_classes':num_classes}\r\n\u001b[?2004l\r\u001b[?2004h> for layer in ['input_layer','hidden_layer','output_layer']:\r\n\u001b[?2004l\r\u001b[?2004h>     w=sd[layer+'.weight'][0]; b=sd[layer+'.bias'][0]\r\n\u001b[?2004l\r\u001b[?2004h>     j[layer+'_weight']=w\r\n\u001b[?2004l\r\u001b[?2004h>     j[layer+'_bias']=b\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/weights.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(j,f)\r\n\u001b[?2004l\r\u001b[?2004h> print('wrote weights.json')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
