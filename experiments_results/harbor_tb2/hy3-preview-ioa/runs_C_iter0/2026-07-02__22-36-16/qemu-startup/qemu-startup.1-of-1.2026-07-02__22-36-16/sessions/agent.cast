[280.583195, "o", "\u001b[?2004hroot@f2cbf281bdd3:/app# "]
[280.687618, "i", "cat > /app/probe.py << 'PYEOF'\n#!/usr/bin/env python3\nimport socket, sys, time\n\nHOST, PORT = '127.0.0.1', 6665\ndeadline = time.time() + 300\nwhile time.time() < deadline:\n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(12)\n        s.connect((HOST, PORT))\n        s.sendall(bytes([13,10]))\n        buf = b''\n        end = time.time() + 20\n        while time.time() < end:\n            try:\n                d = s.recv(4096)\n            except socket.timeout:\n                break\n            if not d:\n                break\n            buf += d\n            if b'login:' in buf.lower():\n                print('READY')\n                s.close()\n                sys.exit(0)\n        s.close()\n    except OSError:\n        pass\n    time.sleep(2)\nprint('TIMEOUT')\nsys.exit(1)\nPYEOF\n"]
[280.687752, "o", "cat > /app/probe.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[280.687829, "o", "\u001b[?2004h> "]
