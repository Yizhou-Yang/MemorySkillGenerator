[280.491472, "i", "cat > /app/relay.py << 'PYEOF'\n#!/usr/bin/env python3\nimport socket, select, time\n\nQEMU_SOCK = '/tmp/alp.sock'\nHOST, PORT = '127.0.0.1', 6665\n\ndef strip_iac(data):\n    out = bytearray()\n    i = 0\n    n = len(data)\n    while i < n:\n        b = data[i]\n        if b == 255:\n            if i+1 >= n:\n                break\n            cmd = data[i+1]\n            if cmd == 255:\n                out.append(255); i += 2; continue\n            if cmd in (251,252,253,254):\n                i += 3 if i+2 < n else 2\n                continue\n            if cmd == 250:\n                j = i+2\n                while j < n and data[j] != 240:\n                    j += 1\n                i = j+1 if j < n else n\n                continue\n            i += 2\n            continue\n        out.append(b)\n        i += 1\n    return bytes(out)\n\ndef serve_client(csock):\n    qsock = None\n    while True:\n        try:\n            qsock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\n            qsock.connect(QEMU_SOCK)\n            break\n      "]
[280.491565, "i", "  except OSError:\n            time.sleep(0.2)\n    try:\n        qsock.sendall(bytes([13,10]))\n    except OSError:\n        pass\n    poller = select.poll()\n    poller.register(csock, select.POLLIN)\n    poller.register(qsock, select.POLLIN)\n    fds = {csock.fileno(): csock, qsock.fileno(): qsock}\n    try:\n        while True:\n            for fd, ev in poller.poll(1000):\n                if ev & (select.POLLERR | select.POLLHUP | select.POLLNVAL):\n                    return\n                src = fds[fd]\n                try:\n                    data = src.recv(4096)\n                except OSError:\n                    return\n                if not data:\n                    return\n                if src is csock:\n                    fwd = strip_iac(data)\n                    if fwd:\n                        try: qsock.sendall(fwd)\n                        except OSError: return\n                else:\n                    try: csock.sendall(data)\n                    except OSError: return\n    finally:\n        try: csock.clos"]
[280.491583, "i", "e()\n        except OSError: pass\n        try: qsock.close()\n        except OSError: pass\n\ndef main():\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n    s.bind((HOST, PORT))\n    s.listen(5)\n    while True:\n        try:\n            csock, _ = s.accept()\n        except OSError:\n            continue\n        try:\n            serve_client(csock)\n        except Exception:\n            pass\n\nif __name__ == '__main__':\n    main()\nPYEOF\n"]
[280.492514, "o", "cat > /app/relay.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
