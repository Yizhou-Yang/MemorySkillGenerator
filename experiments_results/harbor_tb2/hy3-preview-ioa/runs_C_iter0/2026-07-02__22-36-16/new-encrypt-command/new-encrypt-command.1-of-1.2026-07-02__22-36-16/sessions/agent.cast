[30.054263, "o", "rencrypt(1)                                                             User Commands                                                            rencrypt(1)"]
[30.054854, "o", "\r\n"]
[30.055062, "o", "\r\n"]
[30.055245, "o", "NAME"]
[30.055488, "o", "\r\n"]
[30.055728, "o", "       rencrypt - Encrypt a file using one of several state of the art protocols"]
[30.05594, "o", "\r\n"]
[30.056166, "o", "\r\n"]
[30.056368, "o", "SYNOPSIS"]
[30.056592, "o", "\r\n"]
[30.056837, "o", "       rencrypt [OPTION]... [FILE]..."]
[30.05706, "o", "\r\n"]
[30.057268, "o", "\r\n"]
[30.057493, "o", "DESCRIPTION"]
[30.057711, "o", "\r\n"]
[30.057971, "o", "       The rencrypt command reads the specified FILE(s), encrypts the content, and writes the result to standard output or an output file."]
[30.05818, "o", "\r\n"]
[30.05835, "o", "\r\n"]
[30.058537, "o", "OPTIONS"]
[30.058712, "o", "\r\n"]
[30.058911, "o", "       -o, --output FILE"]
[30.059108, "o", "\r\n"]
[30.059284, "o", "              Write the encrypted content to FILE instead of standard output."]
[30.059477, "o", "\r\n"]
[30.059652, "o", "\r\n"]
[30.060214, "o", "       -p, --protocol"]
[30.06053, "o", "\r\n"]
[30.061098, "o", "              Which  protocol to use. The acceptable options are \"rev\", \"cap\", and \"doub\" where \"rev\" is most secure but takes the longest and \"doub\" is the"]
[30.061279, "o", "\r\n"]
[30.061468, "o", "              least secure but fastest."]
[30.061647, "o", "\r\n"]
[30.061819, "o", "\r\n"]
[30.062016, "o", "       -h, --help"]
[30.062255, "o", "\r\n"]
[30.062442, "o", "              Display this help message and exit."]
[30.062622, "o", "\r\n"]
[30.062799, "o", "\r\n"]
[30.062992, "o", "       -v, --version"]
[30.06321, "o", "\r\n"]
[30.063385, "o", "              Output version information and exit."]
[30.063587, "o", "\r\n"]
[30.063755, "o", "\r\n"]
[30.063928, "o", "EXAMPLES"]
[30.064119, "o", "\r\n"]
[30.064318, "o", "       Encrypt the contents of `input.txt` and print to standard output:"]
[30.064517, "o", "\r\n"]
[30.064734, "o", "\r\n"]
[30.064903, "o", "       rencrypt input."]
[30.065099, "o", "txt"]
[30.065295, "o", "\r\n"]
[30.065492, "o", "\r\n"]
[30.065671, "o", "       Encrypt the contents of `input.txt` and write to `output.txt`:"]
[30.065877, "o", "\r\n"]
[30.066136, "o", "\r\n"]
[30.066377, "o", "       rencrypt input.txt -o output.txt"]
[30.066609, "o", "\r\n"]
[30.066814, "o", "\r\n"]
[30.067039, "o", "       Encrypt the contents of `input.txt` with a different protocol:"]
[30.067651, "o", "\r\n"]
[30.068295, "o", "\r\n"]
[30.068881, "o", "       rencrypt input.txt -p cap"]
[30.069112, "o", "\r\n"]
[30.069317, "o", "\r\n"]
[30.069539, "o", "       Display help information:"]
[30.069781, "o", "\r\n"]
[30.070005, "o", "\r\n"]
[30.070238, "o", "       rencrypt -h"]
[30.070452, "o", "\r\n"]
[30.070658, "o", "\r\n"]
[30.070903, "o", "       Display version information:"]
[30.071122, "o", "\r\n"]
[30.071328, "o", "\r\n"]
[30.071562, "o", "       rencrypt -v"]
[30.071734, "o", "\r\n"]
[30.071943, "o", "\r\n"]
[30.072139, "o", "AUTHOR"]
[30.072328, "o", "\r\n"]
[30.073185, "o", "       Written by CLI-Bench with help from OpenAI's GPT-3.5."]
[30.073367, "o", "\r\n"]
[30.073558, "o", "\r\n"]
[30.073723, "o", "REPORTING BUGS"]
[30.073921, "o", "\r\n"]
[30.074116, "o", "       Report bugs to <bugs@example.com>."]
[30.074299, "o", "\r\n"]
[30.074996, "o", "\r\n"]
[30.076492, "o", "COPYRIGHT"]
[30.081915, "o", "\r\n"]
[30.085717, "o", "       Copyright © 2025 OpenAI. License GPLv3+: GNU GPL version 3 or later.  This is free software: you are free to change and redistribute it.  There is NO"]
[30.088088, "o", "\r\n"]
[30.093227, "o", "       WARRANTY, to the extent permitted by law."]
