[49.798931, "i", "cat /app/server.log; echo '--- test ---'; python3 - << 'PYEOF'\nimport urllib.request, urllib.error\nbase='http://localhost:3000'\ndef get(path):\n    try:\n        r=urllib.request.urlopen(base+path)\n        return r.status, r.read().decode()\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode()\nprint('n=10', get('/fib?n=10'))\nprint('n=0', get('/fib?n=0'))\nprint('n=1', get('/fib?n=1'))\nprint('missing', get('/fib'))\nprint('abc', get('/fib?n=abc'))\nprint('float', get('/fib?n=1.5'))\nPYEOF\n"]
