[41.370196, "o", "\r\n    def precision_recall_curve(self, label=None):\r\n        \"\"\"Return precision/recall curve\"\"\"\r\n        if label:\r\n            label_id = self.f.get_label_id(label)\r\n            pair_list = self.m.precisionRecallCurveLabel(label_id)\r\n        else:\r\n            pair_list = self.m.precisionRecallCurve()\r\n\r\n"]
