[778.357975, "o", "\u001b[?2004hroot@a81629553511:/app# "]
[804.804019, "i", "cat > /tmp/dl_debs.py << 'PYEOF'\nimport urllib.request, re, subprocess, os\nos.makedirs('/tmp/debs', exist_ok=True)\nwith open('/tmp/uris.txt') as f:\n    for line in f:\n        line=line.strip()\n        if not line.startswith(\"'\"):\n            continue\n        m=re.match(r\"'([^']+)'\\s+(\\S+)\\s\", line)\n        if not m:\n            continue\n        url=m.group(1); name=m.group(2)\n        out='/tmp/debs/'+name\n        print('DL', name)\n        urllib.request.urlretrieve(url, out)\n        subprocess.run(['dpkg-deb','-x',out,'/'], check=True)\nprint('DONE')\nPYEOF\n"]
[804.804214, "o", "cat > /tmp/dl_debs.py << 'PYEOF'\r\n\u001b[?2004l\r"]
