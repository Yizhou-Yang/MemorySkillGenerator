[804.804894, "o", "        line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[804.804938, "o", "        if not line.startswith(\"'\"):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[804.805102, "o", "        m=re.match(r\"'([^']+)'\\s+(\\S+)\\s\", line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[804.805366, "o", "        if not m:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[804.80545, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         url=m.group(1); name=m.group(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[804.805473, "o", "        out='/tmp/debs/'+name\r\n\u001b[?2004l\r\u001b[?2004h>         print('DL', name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[804.805559, "o", "> "]
[804.805639, "o", "        urllib.request.urlretrieve(url, out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[804.805746, "o", "        subprocess.run(['dpkg-deb','-x',out,'/'], check=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[804.805823, "o", "print('DONE')\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[804.808202, "o", "\u001b[?2004hroot@a81629553511:/app# "]
