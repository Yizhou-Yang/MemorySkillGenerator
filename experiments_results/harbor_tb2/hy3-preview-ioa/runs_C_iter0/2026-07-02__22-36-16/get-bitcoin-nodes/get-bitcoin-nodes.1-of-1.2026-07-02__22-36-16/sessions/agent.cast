[363.641733, "i", "ult\")\n\n\ndef _validate_hash(value, kind):\n    if not _HEX64.match(value):\n        raise BitcoinRPCError(\n            \"Invalid {} '{}': must be a 64-character hexadecimal string\".format(kind, value),\n            404,\n        )\n\n\n# ---------------------------------------------------------------------------\n# Endpoints\n# ---------------------------------------------------------------------------\n@app.route(\"/block/<block_hash>\")\ndef get_block(block_hash):\n    try:\n        _validate_hash(block_hash, \"block hash\")\n        block = rpc_call(\"getblock\", [block_hash, 1])\n    except BitcoinRPCError as exc:\n        return jsonify({\"error\": str(exc)}), exc.status_code\n\n    return jsonify({\n        \"hash\": block.get(\"hash\"),\n        \"height\": block.get(\"height\"),\n        \"merkleroot\": block.get(\"merkleroot\"),\n        \"time\": block.get(\"time\"),\n        \"nonce\": block.get(\"nonce\"),\n        \"tx\": block.get(\"tx\", []),\n    }), 200\n\n\n@app.route(\"/transaction/<txid>\")\ndef get_transaction(txid):\n    try:\n        _validate_hash(txi"]
