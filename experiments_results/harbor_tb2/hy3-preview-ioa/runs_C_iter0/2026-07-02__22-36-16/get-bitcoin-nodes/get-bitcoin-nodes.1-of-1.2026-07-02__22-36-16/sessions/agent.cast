[363.645201, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[363.645384, "o", "\u001b[?2004h> "]
[363.645511, "o", "# bitcoinlib is used to resolve the default Bitcoin network parameters\r\n\u001b[?2004l\r"]
[363.645647, "o", "\u001b[?2004h> "]
[363.64589, "o", "# (e.g. the default P2P port 8333) and to satisfy the dependency requirement.\r\n\u001b[?2004l\r"]
[363.646057, "o", "\u001b[?2004h> "]
[363.646491, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.646858, "o", "    from bitcoinlib.networks import NETWORK_DEFINITIONS  # type: ignore\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.647088, "o", "    _DEFAULT_P2P_PORT = int(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.647542, "o", "        NETWORK_DEFINITIONS.get(\"bitcoin\", {}).get(\"default_port\", 8333)\r\n\u001b[?2004l\r"]
[363.647671, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[363.647693, "o", "\u001b[?2004h> "]
[363.647872, "o", "except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.648128, "o", "    _DEFAULT_P2P_PORT = 8333\r\n\u001b[?2004l\r"]
[363.648259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.648403, "o", "\u001b[?2004h> "]
[363.648681, "o", "logging.basicConfig(level=logging.INFO)\r\n\u001b[?2004l\r"]
[363.648898, "o", "\u001b[?2004h> logger = logging.getLogger(\"bitcoin_service\")\r\n\u001b[?2004l\r"]
[363.648998, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.649096, "o", "app = Flask(__name__)\r\n\u001b[?2004l\r"]
[363.64919, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.649484, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[363.649667, "o", "\u001b[?2004h> "]
[363.649804, "o", "# Configuration (overridable via environment variables)\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.649963, "o", "> "]
[363.650146, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[363.65035, "o", "\u001b[?2004h> "]
[363.650468, "o", "RPC_HOST = os.environ.get(\"BITCOIN_RPC_HOST\", \"127.0.0.1\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.650603, "o", "> "]
[363.650883, "o", "RPC_PORT = int(os.environ.get(\"BITCOIN_RPC_PORT\", os.environ.get(\"BITCOIN_PORT\", \"8332\")))\r\n\u001b[?2004l\r"]
[363.651064, "o", "\u001b[?2004h> "]
[363.651311, "o", "RPC_USER = os.environ.get(\"BITCOIN_RPC_USER\", os.environ.get(\"BITCOIN_RPC_USERNAME\", \"\"))\r\n\u001b[?2004l\r"]
[363.651486, "o", "\u001b[?2004h> "]
[363.65176, "o", "RPC_PASSWORD = os.environ.get(\"BITCOIN_RPC_PASSWORD\", os.environ.get(\"BITCOIN_RPC_PASS\", \"\"))\r\n\u001b[?2004l\r"]
[363.651912, "o", "\u001b[?2004h> "]
[363.65208, "o", "RPC_COOKIE = os.environ.get(\"BITCOIN_COOKIE_FILE\", \"\")\r\n\u001b[?2004l\r"]
[363.652262, "o", "\u001b[?2004h> "]
[363.652487, "o", "RPC_USE_SSL = os.environ.get(\"BITCOIN_RPC_SSL\", \"\").lower() in (\"1\", \"true\", \"yes\")\r\n\u001b[?2004l\r"]
[363.652654, "o", "\u001b[?2004h> "]
[363.652838, "o", "REQUEST_TIMEOUT = float(os.environ.get(\"BITCOIN_RPC_TIMEOUT\", \"3\"))\r\n\u001b[?2004l\r"]
[363.653151, "o", "\u001b[?2004h> API_HOST = os.environ.get(\"API_HOST\", \"0.0.0.0\")\r\n\u001b[?2004l\r"]
[363.653485, "o", "\u001b[?2004h> API_PORT = int(os.environ.get(\"API_PORT\", \"5000\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.65405, "o", "NETWORK = os.environ.get(\"BITCOIN_NETWORK\", \"bitcoin\")\r\n\u001b[?2004l\r"]
[363.65412, "o", "\u001b[?2004h"]
[363.654208, "o", "> \r\n\u001b[?2004l\r"]
[363.654291, "o", "\u001b[?2004h> "]
[363.654574, "o", "_SCHEME = \"https\" if RPC_USE_SSL else \"http\"\r\n\u001b[?2004l\r"]
[363.654645, "o", "\u001b[?2004h"]
[363.654764, "o", "> "]
[363.655073, "o", "_BASE_URL = \"{}://{}:{}/\".format(_SCHEME, RPC_HOST, RPC_PORT)\r\n\u001b[?2004l\r"]
[363.655143, "o", "\u001b[?2004h"]
[363.65523, "o", "> \r\n\u001b[?2004l\r"]
[363.655336, "o", "\u001b[?2004h> "]
[363.655493, "o", "_DEFAULT_COOKIE_PATHS = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.655793, "o", "    os.path.expanduser(\"~/.bitcoin/.cookie\"),\r\n\u001b[?2004l\r"]
[363.656493, "o", "\u001b[?2004h>     os.path.expanduser(\"~/.bitcoin/regtest/.cookie\"),\r\n\u001b[?2004l\r\u001b[?2004h>     os.path.expanduser(\"~/.bitcoin/signet/.cookie\"),\r\n\u001b[?2004l\rxc.\u001b[?2004h> "]
[363.656679, "o", "    os.path.expanduser(\"~/.bitcoin/testnet3/.cookie\"),\r\n\u001b[?2004l\r"]
[363.656749, "o", "\u001b[?2004h"]
[363.657021, "o", "> "]
[363.65712, "o", "    \"/root/.bitcoin/.cookie\",\r\n\u001b[?2004l\r"]
[363.657197, "o", "\u001b[?2004h> "]
[363.657393, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.657463, "o", "\u001b[?2004h"]
[363.657581, "o", "> "]
[363.657861, "o", "_HEX64 = re.compile(r\"^[0-9a-fA-F]{64}$\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.658314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.658713, "o", "\u001b[?2004h> "]
[363.659154, "o", "class BitcoinRPCError(Exception):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.660097, "o", "    \"\"\"Raised when an RPC call fails. Carries the appropriate HTTP status.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[363.660504, "o", "> "]
[363.661246, "o", "    def __init__(self, message, status_code=503):\r\n\u001b[?2004l\r"]
[363.661469, "o", "\u001b[?2004h> "]
[363.662053, "o", "        super().__init__(message)\r\n\u001b[?2004l\r"]
[363.662344, "o", "\u001b[?2004h> "]
[363.66288, "o", "        self.status_code = status_code\r\n\u001b[?2004l\r"]
[363.663309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> \r\n\u001b[?2004l\r."]
[363.663684, "o", "\u001b[?2004h> "]
[363.664057, "o", "def _resolve_cookie():\r\n\u001b[?2004l\r"]
[363.664287, "o", "\u001b[?2004h> "]
[363.664633, "o", "    if RPC_COOKIE:\r\n\u001b[?2004l\r"]
[363.664718, "o", "\u001b[?2004h"]
[363.665213, "o", "> "]
[363.665642, "o", "        return RPC_COOKIE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.666203, "o", "    for path in _DEFAULT_COOKIE_PATHS:\r\n\u001b[?2004l\r"]
[363.666898, "o", "\u001b[?2004h>         if os.path.exists(path):\r\n\u001b[?2004l\r"]
[363.667259, "o", "\u001b[?2004h> "]
[363.667602, "o", "            return path\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.668152, "o", ">     return \"\"\r\n\u001b[?2004l\r"]
[363.668418, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r:"]
[363.668765, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[363.669031, "o", "def _auth():\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.669326, "o", "> "]
[363.670317, "o", "    cookie_path = _resolve_cookie()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.670643, "o", "    if cookie_path and os.path.exists(cookie_path):\r\n\u001b[?2004l\r"]
[363.670661, "o", "\u001b[?2004h> "]
[363.671004, "o", "        try:\r\n\u001b[?2004l\r"]
[363.671285, "o", "\u001b[?2004h> "]
[363.671966, "o", "            with open(cookie_path) as fh:\r\n\u001b[?2004l\r"]
[363.672048, "o", "\u001b[?2004h> "]
[363.672935, "o", "                data = fh.read().strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.673616, "o", "            if \":\" in data:"]
[363.673675, "o", "\r\n"]
[363.673855, "o", "\u001b[?2004l\r"]
[363.673944, "o", "\u001b[?2004h> "]
[363.675292, "o", "                user, password = data.split(\":\", 1)"]
[363.6754, "o", "\r\n\u001b[?2004l\r"]
[363.675748, "o", "\u001b[?2004h"]
[363.675841, "o", "> "]
[363.676768, "o", "                return (user, password)\r\n\u001b[?2004l\r"]
[363.676971, "o", "\u001b[?2004h"]
[363.677424, "o", "> "]
[363.67754, "o", "        except OSError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.677685, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.678097, "o", "    if RPC_USER:\r\n\u001b[?2004l\r\u001b[?2004h>         return (RPC_USER, RPC_PASSWORD)\r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[363.678342, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.678425, "o", "_RPC_ID = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.678526, "o", "def rpc_call(method, params=None):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.67882, "o", "    \"\"\"Perform a single Bitcoin Core JSON-RPC call.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.679002, "o", "    global _RPC_ID\r\n\u001b[?2004l\r\u001b[?2004h>     _RPC_ID += 1\r\n\u001b[?2004l\rg Bi\u001b[?2004h> "]
[363.679083, "o", "    payload = {\r\n\u001b[?2004l\ron\u001b[?2004h"]
[363.67914, "o", "> "]
[363.679234, "o", "        \"jsonrpc\": \"1.0\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.679419, "o", "        \"id\": str(_RPC_ID),\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.679536, "o", "> "]
[363.679565, "o", "        \"method\": method,\r\n\u001b[?2004l\r"]
[363.679622, "o", "\u001b[?2004h> "]
[363.679794, "o", "        \"params\": params or [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.679862, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.67992, "o", "> "]
[363.679936, "o", "    try:\r\n\u001b[?2004l\r"]
[363.679945, "o", "\u001b[?2004h"]
[363.679958, "o", "> "]
[363.680159, "o", "        response = requests.post(\r\n\u001b[?2004l\re\u001b[?2004h> "]
[363.680293, "o", "            _BASE_URL,\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.680349, "o", "> "]
[363.680392, "o", "            auth=_auth(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.680437, "o", "            json=payload,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.680535, "o", "            timeout=REQUEST_TIMEOUT,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.680701, "o", "            headers={\"Content-Type\": \"application/json\", \"Host\": RPC_HOST},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.680724, "o", "        )\r\n\u001b[?2004l\r"]
[363.680833, "o", "\u001b[?2004h"]
[363.680964, "o", "> "]
[363.681218, "o", "    except requests.exceptions.ConnectionError as exc:\r\n\u001b[?2004l\r"]
[363.681407, "o", "\u001b[?2004h> "]
[363.681626, "o", "        raise BitcoinRPCError("]
[363.68165, "o", "\r\n"]
[363.681664, "o", "\u001b[?2004l\r"]
[363.681736, "o", "\u001b[?2004h> "]
[363.682711, "o", "            \"Not connected to the Bitcoin network: cannot reach node at {}:{} ({})\".format(\r\n\u001b[?2004l\r"]
[363.68284, "o", "\u001b[?2004h> "]
[363.68329, "o", "                RPC_HOST, RPC_PORT, exc\r\n\u001b[?2004l\r"]
[363.683369, "o", "\u001b[?2004h"]
[363.683403, "o", "> "]
[363.683617, "o", "            ),\r\n\u001b[?2004l\r"]
[363.683691, "o", "\u001b[?2004h"]
[363.683769, "o", "> "]
[363.683877, "o", "            503,\r\n\u001b[?2004l\r"]
[363.683983, "o", "\u001b[?2004h> "]
[363.684095, "o", "        )\r\n\u001b[?2004l\r"]
[363.684125, "o", "\u001b[?2004h> "]
[363.684341, "o", "    except requests.exceptions.Timeout as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.684447, "o", "        raise BitcoinRPCError(\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.684514, "o", "> "]
[363.684763, "o", "            \"Not connected to the Bitcoin network: timeout reaching node ({})\".format(exc),\r\n\u001b[?2004l\r"]
[363.684853, "o", "\u001b[?2004h>             503,\r\n\u001b[?2004l\r"]
[363.684935, "o", "\u001b[?2004h> "]
[363.685038, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.68517, "o", "    except requests.exceptions.RequestException as exc:\r\n"]
[363.685255, "o", "\u001b[?2004l\r"]
[363.685344, "o", "\u001b[?2004h> "]
[363.68553, "o", "        raise BitcoinRPCError(\"Bitcoin RPC transport error: {}\".format(exc), 503)\r\n\u001b[?2004l\r"]
[363.685611, "o", "\u001b[?2004h> "]
[363.685668, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.685748, "o", "> "]
[363.685867, "o", "    if response.status_code == 401:\r\n\u001b[?2004l\r"]
[363.685942, "o", "\u001b[?2004h"]
[363.686005, "o", "> "]
[363.686072, "o", "        raise BitcoinRPCError(\r\n\u001b[?2004l\r"]
[363.686143, "o", "\u001b[?2004h> "]
[363.686368, "o", "            \"Bitcoin RPC authentication failed (check credentials or cookie file)\", 503\r\n\u001b[?2004l\r"]
[363.686419, "o", "\u001b[?2004h> "]
[363.686478, "o", "        )\r\n\u001b[?2004l\r"]
[363.686558, "o", "\u001b[?2004h> "]
[363.686607, "o", "\r\n\u001b[?2004l\r"]
[363.686692, "o", "\u001b[?2004h> "]
[363.686803, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.686859, "o", "> "]
[363.686948, "o", "        body = response.json()\r\n"]
[363.686998, "o", "\u001b[?2004l\r"]
[363.687053, "o", "\u001b[?2004h"]
[363.687074, "o", "> "]
[363.6872, "o", "    except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.687225, "o", "> "]
[363.687337, "o", "        raise BitcoinRPCError(\r\n\u001b[?2004l\r"]
[363.687392, "o", "\u001b[?2004h> "]
[363.687682, "o", "            \"Invalid response from Bitcoin node (HTTP {})\".format(response.status_code), 503\r\n\u001b[?2004l\r"]
[363.687746, "o", "\u001b[?2004h> "]
[363.687813, "o", "        )\r\n"]
[363.687828, "o", "\u001b[?2004l\r"]
[363.6879, "o", "\u001b[?2004h"]
[363.68795, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.688072, "o", "    error = body.get(\"error\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.688132, "o", "> "]
[363.688186, "o", "    if error:\r\n"]
[363.688221, "o", "\u001b[?2004l\r"]
[363.688287, "o", "\u001b[?2004h> "]
[363.688464, "o", "        message = error.get(\"message\", \"RPC error\")\r\n"]
[363.688531, "o", "\u001b[?2004l\r"]
[363.688587, "o", "\u001b[?2004h> "]
[363.688685, "o", "        code = error.get(\"code\")\r\n"]
[363.688751, "o", "\u001b[?2004l\r"]
[363.688809, "o", "\u001b[?2004h> "]
[363.689084, "o", "        # Bitcoin Core returns code -5 (RPC_INVALID_PARAMETER) for unknown\r\n"]
[363.689144, "o", "\u001b[?2004l\r"]
[363.689236, "o", "\u001b[?2004h> "]
[363.68947, "o", "        # block hashes / transaction ids -> these are \"not found\" (404).\r\n"]
[363.689524, "o", "\u001b[?2004l\r"]
[363.68958, "o", "\u001b[?2004h> "]
[363.689765, "o", "        if code == -5 or \"not found\" in message.lower():\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.689909, "o", "> "]
[363.689996, "o", "            raise BitcoinRPCError(message, 404)\r\n"]
[363.690108, "o", "\u001b[?2004l\r"]
[363.690179, "o", "\u001b[?2004h> "]
[363.690351, "o", "        raise BitcoinRPCError(message, 503)\r\n"]
[363.690406, "o", "\u001b[?2004l\r"]
[363.690452, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.690528, "o", "\u001b[?2004h> "]
[363.690642, "o", "    return body.get(\"result\")\r\n"]
[363.690712, "o", "\u001b[?2004l\r"]
[363.690806, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.690883, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.690938, "o", "> "]
[363.691008, "o", "def _validate_hash(value, kind):\r\n"]
[363.691057, "o", "\u001b[?2004l\r"]
[363.691113, "o", "\u001b[?2004h"]
[363.69115, "o", "> "]
[363.691297, "o", "    if not _HEX64.match(value):\r\n\u001b[?2004l\r"]
[363.691367, "o", "\u001b[?2004h> "]
[363.691455, "o", "        raise BitcoinRPCError(\r\n"]
[363.691503, "o", "\u001b[?2004l\r"]
[363.691553, "o", "\u001b[?2004h"]
[363.691616, "o", "> "]
[363.691933, "o", "            \"Invalid {} '{}': must be a 64-character hexadecimal string\".format(kind, value),\r\n\u001b[?2004l\r"]
[363.691993, "o", "\u001b[?2004h> "]
[363.692082, "o", "            404,\r\n\u001b[?2004l\r"]
[363.69213, "o", "\u001b[?2004h"]
[363.692183, "o", "> "]
[363.692212, "o", "        )"]
[363.692315, "o", "\r\n\u001b[?2004l\r"]
[363.69234, "o", "\u001b[?2004h> "]
[363.692514, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.692598, "o", "\u001b[?2004h"]
[363.692658, "o", "> "]
[363.692875, "o", "# ---------------------------------------------------------------------------\r\n"]
[363.692951, "o", "\u001b[?2004l\r\u001b[?2004h"]
[363.693064, "o", "> # Endpoints\r\n\u001b[?2004l\r"]
[363.693161, "o", "\u001b[?2004h> "]
[363.693417, "o", "# ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[363.693531, "o", "\u001b[?2004h> "]
[363.693666, "o", "@app.route(\"/block/<block_hash>\")\r\n\u001b[?2004l\r"]
[363.693701, "o", "\u001b[?2004h"]
[363.693744, "o", "> "]
[363.693944, "o", "def get_block(block_hash):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[363.694013, "o", "\u001b[?2004h> "]
[363.694166, "o", "        _validate_hash(block_hash, \"block hash\")\r\n\u001b[?2004l\r"]
[363.694307, "o", "\u001b[?2004h> "]
[363.694443, "o", "        block = rpc_call(\"getblock\", [block_hash, 1])\r\n"]
[363.694624, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[363.694765, "o", "    except BitcoinRPCError as exc:\r\n\u001b[?2004l\r"]
[363.694916, "o", "\u001b[?2004h> "]
[363.694986, "o", "        return jsonify({\"error\": str(exc)}), exc.status_code\r\n\u001b[?2004l\r"]
[363.695038, "o", "\u001b[?2004h"]
[363.695084, "o", "> \r\n\u001b[?2004l\r"]
[363.695121, "o", "\u001b[?2004h"]
[363.695222, "o", "> "]
[363.695312, "o", "    return jsonify({\r\n\u001b[?2004l\r"]
[363.695394, "o", "\u001b[?2004h> "]
[363.695562, "o", "        \"hash\": block.get(\"hash\"),\r\n"]
[363.695637, "o", "\u001b[?2004l\r"]
[363.695704, "o", "\u001b[?2004h> "]
[363.69584, "o", "        \"height\": block.get(\"height\"),\r\n"]
[363.69586, "o", "\u001b[?2004l\r"]
[363.695953, "o", "\u001b[?2004h> "]
[363.696113, "o", "        \"merkleroot\": block.get(\"merkleroot\"),\r\n\u001b[?2004l\r"]
[363.6962, "o", "\u001b[?2004h> "]
[363.696302, "o", "        \"time\": block.get(\"time\"),\r\n\u001b[?2004l\r"]
[363.696352, "o", "\u001b[?2004h> "]
[363.696497, "o", "        \"nonce\": block.get(\"nonce\"),\r\n"]
[363.69656, "o", "\u001b[?2004l\r\u001b[?2004h"]
[363.696616, "o", "> "]
[363.69676, "o", "        \"tx\": block.get(\"tx\", []),\r\n\u001b[?2004l\r"]
[363.696842, "o", "\u001b[?2004h> "]
[363.696913, "o", "    }), 200\r\n"]
[363.69697, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[363.697041, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[363.6971, "o", "\u001b[?2004l\r\u001b[?2004h"]
[363.697127, "o", "> "]
[363.69729, "o", "@app.route(\"/transaction/<txid>\")\r\n\u001b[?2004l\r"]
[363.697392, "o", "\u001b[?2004h> "]
[363.697466, "o", "def get_transaction(txid):\r\n"]
[363.697482, "o", "\u001b[?2004l\r"]
[363.697559, "o", "\u001b[?2004h> "]
[363.697639, "o", "    try:\r\n\u001b[?2004l\r"]
[363.69766, "o", "\u001b[?2004h"]
[363.697754, "o", "> "]
[363.697902, "o", "        _validate_hash(txid, \"transaction id\")\r\n\u001b[?2004l\r"]
[363.698386, "o", "\u001b[?2004h> "]
[363.69865, "o", "        tx = rpc_call(\"getrawtransaction\", [txid, True])\r\n\u001b[?2004l\r\u001b[?2004h>     except BitcoinRPCError as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.698704, "o", "        return jsonify({\"error\": str(exc)}), exc.status_code\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[363.698804, "o", "> "]
[363.698819, "o", "    vin = []\r\n\u001b[?2004l\r"]
[363.698945, "o", "\u001b[?2004h> "]
[363.699039, "o", "    for item in tx.get(\"vin\", []):\r\n\u001b[?2004l\r"]
[363.699142, "o", "\u001b[?2004h> "]
[363.699303, "o", "        entry = {\"sequence\": item.get(\"sequence\")}\r\n\u001b[?2004l\r"]
[363.699382, "o", "\u001b[?2004h"]
[363.699455, "o", "> "]
[363.699532, "o", "        if \"coinbase\" in item:\r\n\u001b[?2004l\r"]
[363.699549, "o", "\u001b[?2004h> "]
[363.699801, "o", "            entry[\"coinbase\"] = item.get(\"coinbase\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.699939, "o", "> "]
[363.700023, "o", "        vin.append(entry)\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.70009, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.700209, "o", "    vout = []\r\n\u001b[?2004l\r"]
[363.700293, "o", "\u001b[?2004h"]
[363.700345, "o", "> "]
[363.700508, "o", "    for output in tx.get(\"vout\", []):\r\n\u001b[?2004l\r"]
[363.70058, "o", "\u001b[?2004h> "]
[363.700731, "o", "        spk = output.get(\"scriptPubKey\", {})\r\n\u001b[?2004l\r"]
[363.700828, "o", "\u001b[?2004h> "]
[363.700958, "o", "        vout.append({\r\n"]
[363.701002, "o", "\u001b[?2004l\r"]
[363.701131, "o", "\u001b[?2004h> "]
[363.70124, "o", "            \"value\": output.get(\"value\"),\r\n\u001b[?2004l\r"]
[363.701345, "o", "\u001b[?2004h> "]
[363.701526, "o", "            \"n\": output.get(\"n\"),\r\n\u001b[?2004l\r"]
[363.70165, "o", "\u001b[?2004h> "]
[363.701766, "o", "            \"scriptPubKey\": {\r\n"]
[363.70187, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[363.70204, "o", "                \"asm\": spk.get(\"asm\"),\r\n"]
[363.702116, "o", "\u001b[?2004l\r"]
[363.702178, "o", "\u001b[?2004h> "]
[363.702333, "o", "                \"hex\": spk.get(\"hex\"),\r\n"]
[363.702433, "o", "\u001b[?2004l\r\u001b[?2004h"]
[363.702467, "o", "> "]
[363.702624, "o", "                \"type\": spk.get(\"type\"),\r\n"]
[363.702706, "o", "\u001b[?2004l\r"]
[363.702731, "o", "\u001b[?2004h> "]
[363.702829, "o", "            },\r\n"]
[363.702916, "o", "\u001b[?2004l\r"]
[363.70299, "o", "\u001b[?2004h> "]
[363.703022, "o", "        })"]
[363.703149, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.703225, "o", "    return jsonify({"]
[363.703307, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.703399, "o", "        \"txid\": tx.get(\"txid\"),\r\n\u001b[?2004l\r"]
[363.703458, "o", "\u001b[?2004h"]
[363.703524, "o", "> "]
[363.703659, "o", "        \"blockhash\": tx.get(\"blockhash\"),\r\n"]
[363.703811, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[363.703893, "o", "        \"vin\": vin,\r\n\u001b[?2004l\r"]
[363.703983, "o", "\u001b[?2004h> "]
[363.70411, "o", "        \"vout\": vout,\r\n"]
[363.704185, "o", "\u001b[?2004l\r"]
[363.704232, "o", "\u001b[?2004h> "]
[363.704316, "o", "    }), 200\r\n\u001b[?2004l\r"]
[363.7044, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.704421, "o", "\r\n"]
[363.704488, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[363.704559, "o", "@app.route(\"/status\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.704631, "o", "def status():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.704714, "o", "    try:\r\n\u001b[?2004l\r"]
[363.704828, "o", "\u001b[?2004h> "]
[363.704996, "o", "        rpc_call(\"getblockchaininfo\", [])\r\n\u001b[?2004l\r"]
[363.705076, "o", "\u001b[?2004h"]
[363.705193, "o", "> "]
[363.705292, "o", "    except BitcoinRPCError as exc:\r\n\u001b[?2004l\r"]
[363.70538, "o", "\u001b[?2004h"]
[363.705441, "o", "> "]
[363.705657, "o", "        return jsonify({\"status\": str(exc)}), 503\r\n\u001b[?2004l\r"]
[363.705756, "o", "\u001b[?2004h> "]
[363.705971, "o", "    return jsonify({\"status\": \"online\"}), 200\r\n\u001b[?2004l\r"]
[363.706075, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.706149, "o", "\u001b[?2004h> "]
[363.706236, "o", "\r\n\u001b[?2004l\r"]
[363.706334, "o", "\u001b[?2004h> "]
[363.706443, "o", "@app.errorhandler(404)\r\n\u001b[?2004l\r"]
[363.706492, "o", "\u001b[?2004h"]
[363.706597, "o", "> "]
[363.706667, "o", "def not_found(_err):\r\n"]
[363.706684, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[363.706898, "o", "    return jsonify({\"error\": \"Not found\"}), 404\r\n"]
[363.706962, "o", "\u001b[?2004l\r"]
[363.706999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.707095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.70718, "o", "\u001b[?2004h> "]
[363.707348, "o", "if __name__ == \"__main__\":\r\n"]
[363.707427, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[363.707535, "o", "    logger.info(\r\n"]
[363.707554, "o", "\u001b[?2004l\r"]
[363.70762, "o", "\u001b[?2004h> "]
[363.707905, "o", "        \"Starting Bitcoin service on %s:%s (RPC node %s:%s, P2P port %s)\",\r\n\u001b[?2004l\r"]
[363.708009, "o", "\u001b[?2004h> "]
[363.708213, "o", "        API_HOST, API_PORT, RPC_HOST, RPC_PORT, _DEFAULT_P2P_PORT,\r\n"]
[363.708279, "o", "\u001b[?2004l\r"]
[363.708351, "o", "\u001b[?2004h> "]
[363.708421, "o", "    )\r\n"]
[363.708484, "o", "\u001b[?2004l\r"]
[363.708518, "o", "\u001b[?2004h> "]
[363.708754, "o", "    app.run(host=API_HOST, port=API_PORT, threaded=True)\r\n"]
[363.708853, "o", "\u001b[?2004l\r\u001b[?2004h"]
[363.708912, "o", "> "]
[363.708974, "o", "PYEOF\r\n\u001b[?2004l\r"]
[363.712307, "o", "\u001b[?2004hroot@8df323c6133e:/app# "]
