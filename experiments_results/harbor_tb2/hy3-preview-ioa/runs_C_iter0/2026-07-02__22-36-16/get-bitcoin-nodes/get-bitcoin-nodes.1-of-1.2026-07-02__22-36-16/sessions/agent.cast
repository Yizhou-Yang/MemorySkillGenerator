[220.819913, "o", "\r\nWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable.It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\r\n\r\n[notice] A new release of pip is available: 24.3.1 -> 26.1.2\r\n[notice] To update, run: pip install --upgrade pip\r\n\u001b[?2004hroot@8df323c6133e:/app# "]
[363.641368, "i", "cat > /app/bitcoin_service.py << 'PYEOF'\n#!/usr/bin/env python3\n\"\"\"Bitcoin blockchain API service.\n\nA lightweight Flask service that connects to a Bitcoin Core node over JSON-RPC\nand exposes HTTP endpoints to retrieve blockchain data (blocks, transactions\nand network status).\n\"\"\"\nimport os\nimport re\nimport logging\n\nimport requests\nfrom flask import Flask, jsonify\n\n# ---------------------------------------------------------------------------\n# bitcoinlib is used to resolve the default Bitcoin network parameters\n# (e.g. the default P2P port 8333) and to satisfy the dependency requirement.\n# ---------------------------------------------------------------------------\ntry:\n    from bitcoinlib.networks import NETWORK_DEFINITIONS  # type: ignore\n    _DEFAULT_P2P_PORT = int(\n        NETWORK_DEFINITIONS.get(\"bitcoin\", {}).get(\"default_port\", 8333)\n    )\nexcept Exception:\n    _DEFAULT_P2P_PORT = 8333\n\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(\"bitcoin_service\")\n\napp = Flask(__name__)\n\n# -------"]
[363.641605, "i", "--------------------------------------------------------------------\n# Configuration (overridable via environment variables)\n# ---------------------------------------------------------------------------\nRPC_HOST = os.environ.get(\"BITCOIN_RPC_HOST\", \"127.0.0.1\")\nRPC_PORT = int(os.environ.get(\"BITCOIN_RPC_PORT\", os.environ.get(\"BITCOIN_PORT\", \"8332\")))\nRPC_USER = os.environ.get(\"BITCOIN_RPC_USER\", os.environ.get(\"BITCOIN_RPC_USERNAME\", \"\"))\nRPC_PASSWORD = os.environ.get(\"BITCOIN_RPC_PASSWORD\", os.environ.get(\"BITCOIN_RPC_PASS\", \"\"))\nRPC_COOKIE = os.environ.get(\"BITCOIN_COOKIE_FILE\", \"\")\nRPC_USE_SSL = os.environ.get(\"BITCOIN_RPC_SSL\", \"\").lower() in (\"1\", \"true\", \"yes\")\nREQUEST_TIMEOUT = float(os.environ.get(\"BITCOIN_RPC_TIMEOUT\", \"3\"))\nAPI_HOST = os.environ.get(\"API_HOST\", \"0.0.0.0\")\nAPI_PORT = int(os.environ.get(\"API_PORT\", \"5000\"))\nNETWORK = os.environ.get(\"BITCOIN_NETWORK\", \"bitcoin\")\n\n_SCHEME = \"https\" if RPC_USE_SSL else \"http\"\n_BASE_URL = \"{}://{}:{}/\".format(_SCHEME, RPC_HOST, RPC_PORT)\n\n_DEFAULT_COOKIE_"]
[363.641635, "o", "cat > /app/bitcoin_service.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[363.641652, "i", "PATHS = [\n    os.path.expanduser(\"~/.bitcoin/.cookie\"),\n    os.path.expanduser(\"~/.bitcoin/regtest/.cookie\"),\n    os.path.expanduser(\"~/.bitcoin/signet/.cookie\"),\n    os.path.expanduser(\"~/.bitcoin/testnet3/.cookie\"),\n    \"/root/.bitcoin/.cookie\",\n]\n\n_HEX64 = re.compile(r\"^[0-9a-fA-F]{64}$\")\n\n\nclass BitcoinRPCError(Exception):\n    \"\"\"Raised when an RPC call fails. Carries the appropriate HTTP status.\"\"\"\n\n    def __init__(self, message, status_code=503):\n        super().__init__(message)\n        self.status_code = status_code\n\n\ndef _resolve_cookie():\n    if RPC_COOKIE:\n        return RPC_COOKIE\n    for path in _DEFAULT_COOKIE_PATHS:\n        if os.path.exists(path):\n            return path\n    return \"\"\n\n\ndef _auth():\n    cookie_path = _resolve_cookie()\n    if cookie_path and os.path.exists(cookie_path):\n        try:\n            with open(cookie_path) as fh:\n                data = fh.read().strip()\n            if \":\" in data:\n                user, password = data.split(\":\", 1)\n                return (user, pass"]
