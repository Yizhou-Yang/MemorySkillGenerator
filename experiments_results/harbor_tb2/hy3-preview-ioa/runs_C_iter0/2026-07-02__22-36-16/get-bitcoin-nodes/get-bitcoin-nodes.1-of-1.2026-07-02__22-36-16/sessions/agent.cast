[363.64169, "i", "word)\n        except OSError:\n            pass\n    if RPC_USER:\n        return (RPC_USER, RPC_PASSWORD)\n    return None\n\n\n_RPC_ID = 0\n\n\ndef rpc_call(method, params=None):\n    \"\"\"Perform a single Bitcoin Core JSON-RPC call.\"\"\"\n    global _RPC_ID\n    _RPC_ID += 1\n    payload = {\n        \"jsonrpc\": \"1.0\",\n        \"id\": str(_RPC_ID),\n        \"method\": method,\n        \"params\": params or [],\n    }\n    try:\n        response = requests.post(\n            _BASE_URL,\n            auth=_auth(),\n            json=payload,\n            timeout=REQUEST_TIMEOUT,\n            headers={\"Content-Type\": \"application/json\", \"Host\": RPC_HOST},\n        )\n    except requests.exceptions.ConnectionError as exc:\n        raise BitcoinRPCError(\n            \"Not connected to the Bitcoin network: cannot reach node at {}:{} ({})\".format(\n                RPC_HOST, RPC_PORT, exc\n            ),\n            503,\n        )\n    except requests.exceptions.Timeout as exc:\n        raise BitcoinRPCError(\n            \"Not connected to the Bitcoin network"]
