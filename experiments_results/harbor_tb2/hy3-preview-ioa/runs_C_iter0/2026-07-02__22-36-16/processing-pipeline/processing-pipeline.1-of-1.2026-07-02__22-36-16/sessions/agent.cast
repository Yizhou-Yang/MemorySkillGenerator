[20.404841, "o", "#!/bin/bash\r\n# Data collection script\r\n\r\n# Try to write to the output directory\r\nmkdir -p /data/output\r\necho \"test data\" > /data/output/raw_data.txt\r\n\r\nif [ $? -eq 0 ]; then\r\n    echo \"Data collected successfully!\"\r\n    exit 0\r\nelse\r\n    echo \"Failed to collect data!\"\r\n    exit 1\r\nfi"]
