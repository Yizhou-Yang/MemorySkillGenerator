[352.927935, "i", "cat > /app/process.py << 'PYEOF'\nimport csv, json, sys, datetime, os\n\nDATA = '/app/data'\n\ndef read_csv(name):\n    with open(os.path.join(DATA, name), newline='', encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\ndepartments = read_csv('departments.csv')\nemployees = read_csv('employees.csv')\nprojects = read_csv('projects.csv')\n\n# index departments by id\ndept_by_id = {d['id']: d for d in departments}\n\n# group employees and projects by department\ndept_employees = {}\ndept_projects = {}\nfor e in employees:\n    dept_employees.setdefault(e['department_id'], []).append(e)\nfor p in projects:\n    dept_projects.setdefault(p['department_id'], []).append(p)\n\ndef split_list(s):\n    return [x.strip() for x in s.split(';') if x.strip()]\n\ndepts_out = []\nfor d in departments:\n    did = d['id']\n    emp_list = []\n    for e in dept_employees.get(did, []):\n        emp_list.append({\n            'id': e['id'],\n            'name': e['name'],\n            'position': e['posi"]
