[352.933294, "i", "tion'],\n            'skills': split_list(e['skills']),\n            'years_of_service': int(e['years_of_service'])\n        })\n    proj_list = []\n    for p in dept_projects.get(did, []):\n        proj_list.append({\n            'name': p['name'],\n            'status': p['status'],\n            'members': split_list(p['member_ids']),\n            'deadline': p['deadline']\n        })\n    depts_out.append({\n        'id': d['id'],\n        'name': d['name'],\n        'budget': float(d['budget']),\n        'employees': emp_list,\n        'projects': proj_list\n    })\n\n# statistics\nbudgets = [float(d['budget']) for d in departments]\naverage_dept_budget = round(sum(budgets) / len(budgets), 2) if budgets else 0\ntotal_employees = len(employees)\n\nskill_dist = {}\nfor e in employees:\n    for s in split_list(e['skills']):\n        skill_dist[s] = skill_dist.get(s, 0) + 1\n\ndept_sizes = {}\nfor d in departments:\n    dept_sizes[d['name']] = len(dept_employees.get(d['id'], []))\n\nproj_status = {}\nfor p in projects:\n    proj_status[p['statu"]
[352.93331, "i", "s']] = proj_status.get(p['status'], 0) + 1\n\nyears = [int(e['years_of_service']) for e in employees]\navg_years = round(sum(years) / len(years), 2) if years else 0\n\nresult = {\n    'metadata': {\n        'version': '1.0.0',\n        'timestamp': datetime.datetime.now().strftime('%Y-%m-%dT%H:%M:%S'),\n        'generator': 'csv-to-json-processor'\n    },\n    'organization': {\n        'name': 'Global Enterprises',\n        'founded': '2015-01-01',\n        'departments': depts_out\n    },\n    'statistics': {\n        'averageDepartmentBudget': average_dept_budget,\n        'totalEmployees': total_employees,\n        'skillDistribution': skill_dist,\n        'departmentSizes': dept_sizes,\n        'projectStatusDistribution': proj_status,\n        'averageYearsOfService': avg_years\n    }\n}\n\nwith open('/app/organization.json', 'w', encoding='utf-8') as f:\n    json.dump(result, f, indent=2, ensure_ascii=False)\n\nprint('Wrote organization.json')\nprint('Departments:', len(depts_out), 'Employees:', total_employees, 'Projects:', len(pr"]
