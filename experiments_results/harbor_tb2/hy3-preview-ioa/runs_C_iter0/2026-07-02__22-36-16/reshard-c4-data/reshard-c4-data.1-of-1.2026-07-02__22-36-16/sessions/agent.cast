[569.395375, "o", "\u001b[?2004h> os.makedirs(cur)\r\n\u001b[?2004l\r\u001b[?2004h> for i, f in enumerate(files):\r\n\u001b[?2004l\r\u001b[?2004h>     if i % per == 0 and i != 0:\r\n\u001b[?2004l\r\u001b[?2004h>         idx += 1\r\n\u001b[?2004l\r\u001b[?2004h>         cur = os.path.join(dst, 'part_%06d' % idx)\r\n\u001b[?2004l\r\u001b[?2004h>         os.makedirs(cur)\r\n\u001b[?2004l\r\u001b[?2004h>     os.link(os.path.join(src, f), os.path.join(cur, f))\r\n\u001b[?2004l\r\u001b[?2004h> print('rebuilt: c4_sample has', len(os.listdir(src)), 'files; parts=', idx + 1)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
