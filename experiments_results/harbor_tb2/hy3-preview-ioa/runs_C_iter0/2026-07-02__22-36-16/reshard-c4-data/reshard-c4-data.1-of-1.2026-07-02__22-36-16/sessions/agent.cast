[129.933949, "i", "python3 - << 'PREPEOF'\nimport os, shutil\nsrc = 'c4_sample'\ndst = 'c4_reshard'\nos.makedirs(dst, exist_ok=True)\nfiles = sorted(os.listdir(src))\nper = 30\npart = 0\ncount = 0\ncur = None\nfor f in files:\n    if cur is None or count == per:\n        cur = os.path.join(dst, 'part_%06d' % part)\n        os.makedirs(cur, exist_ok=True)\n        part += 1\n        count = 0\n    shutil.move(os.path.join(src, f), os.path.join(cur, f))\n    count += 1\nprint('moved', len(files), 'files into', part, 'parts')\nPREPEOF\n"]
