[129.760196, "i", "cat > /app/revert.py << 'PYEOF'\n#!/usr/bin/env python3\n'''Revert c4_reshard/ back to the original c4_sample/ flat layout.\n\nc4_reshard was produced by reorganizing the files of c4_sample into\nsub-directories (each holding at most 30 files) for upload. This script\nmoves every file found under c4_reshard/ back into c4_sample/ and removes\nthe now-empty shards, restoring the original flat structure.\n'''\nimport os\nimport shutil\nimport sys\n\nBASE_DIR = os.path.dirname(os.path.abspath(__file__))\nRESHARD = os.path.join(BASE_DIR, 'c4_reshard')\nSAMPLE = os.path.join(BASE_DIR, 'c4_sample')\n\n\ndef main():\n    if not os.path.isdir(RESHARD):\n        print('Nothing to revert: ' + RESHARD + ' does not exist.', file=sys.stderr)\n        return 1\n\n    os.makedirs(SAMPLE, exist_ok=True)\n\n    moved = 0\n    for entry in sorted(os.listdir(RESHARD)):\n        shard = os.path.join(RESHARD, entry)\n        if not os.path.isdir(shard):\n            shutil.move(shard, os.path.join(SAMPLE, entry)"]
[129.760429, "i", ")\n            moved += 1\n            continue\n        for name in sorted(os.listdir(shard)):\n            src = os.path.join(shard, name)\n            if os.path.isfile(src):\n                shutil.move(src, os.path.join(SAMPLE, name))\n                moved += 1\n        try:\n            os.rmdir(shard)\n        except OSError:\n            pass\n\n    try:\n        os.rmdir(RESHARD)\n    except OSError:\n        pass\n\n    print('Reverted ' + str(moved) + ' file(s) from c4_reshard/ back into c4_sample/.')\n    return 0\n\n\nif __name__ == '__main__':\n    sys.exit(main())\nPYEOF\n"]
