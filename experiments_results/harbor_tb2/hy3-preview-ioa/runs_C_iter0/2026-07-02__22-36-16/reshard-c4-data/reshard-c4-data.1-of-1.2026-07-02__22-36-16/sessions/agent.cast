[674.317084, "i", "cat > /app/revert.py << 'PYEOF'\n#!/usr/bin/env python3\n'''Revert c4_reshard/ back to the original (flat) c4_sample/ layout.\n\nThe files of the original c4_sample/ were reshaped into c4_reshard/ for upload:\nthey were distributed into part_* sub-directories, each holding at most 30 files.\nThis script reverses that reshape: it moves every file found in any sub-directory\nof c4_reshard/ up to the top level of c4_reshard/ and removes the now-empty\nsub-directories. After running this, c4_reshard/ contains the same flat set of\nfiles that originally lived in c4_sample/, so the two match.\n'''\nimport os\nimport shutil\nimport sys\n\nBASE_DIR = os.path.dirname(os.path.abspath(__file__))\nRESHARD = os.path.join(BASE_DIR, 'c4_reshard')\n\n\ndef main():\n    if not os.path.isdir(RESHARD):\n        print('Nothing to revert: ' + RESHARD + ' does not exist.', file=sys.stderr)\n        return 1\n\n    moved = 0\n    for entry in sorted(os.listdir(RESHARD)):\n        sub = os.path.join(RESHARD, entry)\n        if not os.path.isdir(sub):\n            continue\n        for name in sorted(os.listdir(sub)):\n            src = os.path.join(sub, name)\n            if os.path.isfile(src):\n                dst = os.path.join(RESHARD, name)\n                if os.path.abspath(src) != os.path.abspath(dst):\n                    shutil.move(src, dst)\n                    moved += 1\n        try:\n            os.rmdir(sub)\n        except OSError as e:\n            print('Could not remove ' + sub + ': ' + str(e), file=sys.stderr)\n\n    print('Reverted c4_reshard/: moved ' + str(moved) +\n          ' file(s) up to the top level and removed sub-directories.')\n    return 0\n\n\nif __name__ == '__main__':\n    sys.exit(main())\nPYEOF\n"]
