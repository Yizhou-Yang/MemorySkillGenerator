[569.374471, "i", "python3 - << 'PYEOF'\nimport os\nsrc = 'c4_sample'\ndst = 'c4_reshard'\nos.makedirs(src, exist_ok=True)\n# 1) restore original flat c4_sample from current c4_reshard parts\nfor d in sorted(os.listdir(dst)):\n    sub = os.path.join(dst, d)\n    if os.path.isdir(sub):\n        for f in sorted(os.listdir(sub)):\n            os.rename(os.path.join(sub, f), os.path.join(src, f))\n        os.rmdir(sub)\n# now src has all files; dst is empty\n# 2) rebuild c4_reshard as reshaped hard-linked copy\nfiles = sorted(os.listdir(src))\nper = 30\nidx = 0\ncur = os.path.join(dst, 'part_%06d' % idx)\nos.makedirs(cur)\nfor i, f in enumerate(files):\n    if i % per == 0 and i != 0:\n        idx += 1\n        cur = os.path.join(dst, 'part_%06d' % idx)\n        os.makedirs(cur)\n    os.link(os.path.join(src, f), os.path.join(cur, f))\nprint('rebuilt: c4_sample has', len(os.listdir(src)), 'files; parts=', idx + 1)\nPYEOF\n"]
