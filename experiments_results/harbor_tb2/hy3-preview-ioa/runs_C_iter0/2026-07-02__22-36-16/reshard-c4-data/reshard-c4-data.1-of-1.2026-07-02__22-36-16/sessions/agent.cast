[230.493315, "i", "python3 - << 'PREPEOF'\nimport os, shutil\nsrc = 'c4_sample'\ndst = 'c4_reshard'\nos.makedirs(dst, exist_ok=True)\nper = 30\n\ndef part_for(i):\n    return os.path.join(dst, 'part_%06d' % i)\n\n# find highest existing part index\nidx = -1\nfor e in os.listdir(dst):\n    if e.startswith('part_'):\n        try:\n            n = int(e.split('_')[1])\n            idx = max(idx, n)\n        except ValueError:\n            pass\nif idx < 0:\n    idx = 0\n    os.makedirs(part_for(idx), exist_ok=True)\n\nfiles = sorted(os.listdir(src))\nmoved = 0\nfor f in files:\n    cur = part_for(idx)\n    if len(os.listdir(cur)) >= per:\n        idx += 1\n        cur = part_for(idx)\n        os.makedirs(cur, exist_ok=True)\n    shutil.move(os.path.join(src, f), os.path.join(cur, f))\n    moved += 1\nprint('continued, moved', moved, 'files; last part idx', idx)\nPREPEOF\n"]
