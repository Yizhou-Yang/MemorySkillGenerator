[420.134824, "i", "cat > /app/agent.py << 'PYEOF'\nimport os\nimport numpy as np\nimport torch\nimport torch.nn as nn\n\n\nclass QNetwork(nn.Module):\n    def __init__(self, state_dim=4, action_dim=2, hidden=64):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(state_dim, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, action_dim),\n        )\n\n    def forward(self, x):\n        return self.net(x)\n\n\nclass Agent:\n    def __init__(self, state_dim=4, action_dim=2, hidden=64):\n        self.state_dim = state_dim\n        self.action_dim = action_dim\n        self.hidden = hidden\n        self.policy_net = QNetwork(state_dim, action_dim, hidden)\n\n    def select_action(self, current_observation):\n        obs = np.asarray(current_observation, dtype=np.float32)\n        self.policy_net.eval()\n        with torch.no_grad():\n            t = torch.from_numpy(obs).unsqueeze(0)\n            q = self.policy_net(t)\n            a = int(q.argmax(dim=1).i"]
[420.135057, "i", "tem())\n        self.policy_net.train()\n        return a\n\n    def save(self, directory):\n        os.makedirs(directory, exist_ok=True)\n        path = os.path.join(directory, \"qnet.pt\")\n        torch.save(self.policy_net.state_dict(), path)\n\n    def load(self, directory):\n        path = os.path.join(directory, \"qnet.pt\")\n        state = torch.load(path, map_location=\"cpu\")\n        self.policy_net.load_state_dict(state)\n        self.policy_net.eval()\nPYEOF\n"]
