[457.782978, "o", "> "]
[457.783085, "o", "                q_val = policy(s_t).gather(1, a_t.unsqueeze(1)).squeeze(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.783201, "o", "                with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.783325, "o", "                    next_q = target(s2_t).max(dim=1)[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.783364, "o", "> "]
[457.783495, "o", "                    target_q = r_t + gamma * next_q * (1 - d_t)\r\n\u001b[?2004l\r"]
[457.783573, "o", "\u001b[?2004h> "]
