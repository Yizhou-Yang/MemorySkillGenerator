[457.763859, "i", "cat > /app/train.py << 'PYEOF'\nimport os\nimport random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport gymnasium as gym\n\nfrom agent import Agent, QNetwork\n\nSTATE_DIM = 4\nACTION_DIM = 2\nHIDDEN = 64\nTARGET_DIR = \"/app/trained_model\"\n\n\nclass ReplayBuffer:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.s = np.zeros((capacity, STATE_DIM), dtype=np.float32)\n        self.a = np.zeros((capacity,), dtype=np.int64)\n        self.r = np.zeros((capacity,), dtype=np.float32)\n        self.s2 = np.zeros((capacity, STATE_DIM), dtype=np.float32)\n        self.d = np.zeros((capacity,), dtype=np.float32)\n        self.idx = 0\n        self.size = 0\n\n    def push(self, s, a, r, s2, d):\n        self.s[self.idx] = s\n        self.a[self.idx] = a\n        self.r[self.idx] = r\n        self.s2[self.idx] = s2\n        self.d[self.idx] = d\n        self.idx = (self.idx + 1) % self.capacity\n        self.size = min(self.size + 1, self.capacity)\n\n    def sample(self, ba"]
[457.76391, "i", "tch):\n        idx = np.random.randint(0, self.size, size=batch)\n        return (self.s[idx], self.a[idx], self.r[idx], self.s2[idx], self.d[idx])\n\n\ndef evaluate(agent, env, episodes=20):\n    total = 0.0\n    for _ in range(episodes):\n        obs, _ = env.reset()\n        ep = 0.0\n        done = False\n        while not done:\n            a = agent.select_action(obs)\n            obs, r, term, trunc, _ = env.step(a)\n            ep += r\n            done = term or trunc\n        total += ep\n    return total / episodes\n\n\ndef main():\n    os.makedirs(TARGET_DIR, exist_ok=True)\n    env = gym.make(\"CartPole-v1\")\n    agent = Agent(STATE_DIM, ACTION_DIM, HIDDEN)\n    policy = agent.policy_net\n    target = QNetwork(STATE_DIM, ACTION_DIM, HIDDEN)\n    target.load_state_dict(policy.state_dict())\n    optimizer = torch.optim.Adam(policy.parameters(), lr=1e-3)\n    buffer = ReplayBuffer(20000)\n\n    gamma = 0.99\n    batch = 128\n    eps_start = 1.0\n    eps_end = 0.05\n    eps_decay = 3000\n    target_update = 250\n    max_steps = 80000\n  "]
[457.764179, "i", "  best_eval = -1.0\n    best_state = None\n    total_steps = 0\n\n    while total_steps < max_steps:\n        obs, _ = env.reset()\n        done = False\n        while not done and total_steps < max_steps:\n            eps = eps_end + (eps_start - eps_end) * np.exp(-total_steps / eps_decay)\n            if random.random() < eps:\n                a = env.action_space.sample()\n            else:\n                a = agent.select_action(obs)\n            s2, r, term, trunc, _ = env.step(a)\n            d = float(term or trunc)\n            buffer.push(obs, a, r, s2, d)\n            obs = s2\n            done = bool(d)\n            total_steps += 1\n            if len(buffer) >= batch:\n                s, a_i, rew, s2_b, d_b = buffer.sample(batch)\n                s_t = torch.from_numpy(s)\n                a_t = torch.from_numpy(a_i)\n                r_t = torch.from_numpy(rew)\n                s2_t = torch.from_numpy(s2_b)\n                d_t = torch.from_numpy(d_b)\n                q_val = policy(s_t).gather(1, a_t.unsqueeze(1)).squeez"]
[457.764395, "o", "cat > /app/train.py << 'PYEOF'\r\n\u001b[?2004l\r  best_eval = -1.0\r\n    best_state = None\r\n    total_steps = 0\r\n\r\n    while total_steps < max_steps:\r\n        obs, _ = env.reset()\r\n        done = False\r\n        while not done and total_steps < max_steps:\r\n            eps = eps_end + (eps_start - eps_end) * np.exp(-total_steps / eps_decay)\r\n            if random.random() < eps:\r\n                a = env.action_space.sample()\r\n            else:\r\n                a = agent.select_action(obs)\r\n            s2, r, term, trunc, _ = env.step(a)\r\n            d = float(term or trunc)\r\n            buffer.push(obs, a, r, s2, d)\r\n            obs = s2\r\n            done = bool(d)\r\n            total_steps += 1\r\n            if len(buffer) >= batch:\r\n                s, a_i, rew, s2_b, d_b = buffer.sample(b"]
[457.764457, "i", "e(1)\n                with torch.no_grad():\n                    next_q = target(s2_t).max(dim=1)[0]\n                    target_q = r_t + gamma * next_q * (1 - d_t)\n                loss = F.mse_loss(q_val, target_q)\n                optimizer.zero_grad()\n                loss.backward()\n                optimizer.step()\n            if total_steps % target_update == 0:\n                target.load_state_dict(policy.state_dict())\n            if total_steps % 5000 == 0:\n                ev = evaluate(agent, env, 20)\n                print(f\"step {total_steps} eval {ev:.1f} eps {eps:.3f}\", flush=True)\n                if ev > best_eval:\n                    best_eval = ev\n                    best_state = {k: v.detach().cpu().clone() for k, v in policy.state_dict().items()}\n\n    if best_state is not None:\n        torch.save(best_state, os.path.join(TARGET_DIR, \"qnet.pt\"))\n    print(\"best eval\", best_eval, flush=True)\n    env.close()\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\n"]
[457.764558, "o", "atch)\r\n                s_t = torch.from_numpy(s)\r\n                a_t = torch.from_numpy(a_i)\r\n                r_t = torch.from_numpy(rew)\r\n                s2_t = torch.from_numpy(s2_b)\r\n                d_t = torch.from_numpy(d_b)\r\n                q_val = policy(s_t).gather(1, a_t.unsqueeze(1)).squeez"]
[457.764617, "o", "\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.764719, "o", "import random\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.764739, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.764875, "o", "> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.765009, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.766274, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.767562, "o", "import gymnasium as gym\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from agent import Agent, QNetwork\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> STATE_DIM = 4\r\n\u001b[?2004l\r\u001b[?2004h> ACTION_DIM = 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.767597, "o", "HIDDEN = 64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.768116, "o", "TARGET_DIR = \"/app/trained_model\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class ReplayBuffer:\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, capacity):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.771178, "o", "        self.capacity = capacity\r\n\u001b[?2004l\r\u001b[?2004h>         self.s = np.zeros((capacity, STATE_DIM), dtype=np.float32)\r\n\u001b[?2004l\r\u001b[?2004h>         self.a = np.zeros((capacity,), dtype=np.int64)\r\n\u001b[?2004l\r\u001b[?2004h>         self.r = np.zeros((capacity,), dtype=np.float32)\r\n\u001b[?2004l\r\u001b[?2004h>         self.s2 = np.zeros((capacity, STATE_DIM), dtype=np.float32)\r\n\u001b[?2004l\r\u001b[?2004h>         self.d = np.zeros((capacity,), dtype=np.float32)\r\n\u001b[?2004l\r\u001b[?2004h>         self.idx = 0\r\n\u001b[?2004l\r\u001b[?2004h>         self.size = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def push(self, s, a, r, s2, d):\r\n\u001b[?2004l\r\u001b[?2004h>         self.s[self.idx] = s\r\n\u001b[?2004l\r\u001b[?2004h>         self.a[self.idx] = a\r\n\u001b[?2004l\r\u001b[?2004h>         self.r[self.idx] = r\r\n\u001b[?2004l\r\u001b[?2004h>         self.s2[self.idx] = s2\r\n\u001b[?2004l\r\u001b[?2004h>         self.d[self.idx] = d\r\n\u001b[?2004l\r\u001b[?2004h>         self.idx = (self.idx + 1) % self.capacity\r\n\u001b[?2004l\r\u001b[?2004h>         self.size = min(self.size + 1, self.capacity)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?20"]
[457.771261, "o", "04h>     def sample(self, batch):\r\n\u001b[?2004l\r\u001b[?2004h>         idx = np.random.randint(0, self.size, size=batch)\r\n"]
[457.771428, "o", "\u001b[?2004l\r"]
[457.771586, "o", "\u001b[?2004h"]
[457.771734, "o", "> "]
[457.772056, "o", "        return (self.s[idx], self.a[idx], self.r[idx], self.s2[idx], self.d[idx])\r\n\u001b[?2004l\r"]
[457.772105, "o", "\u001b[?2004h> "]
[457.772116, "o", "\r\n\u001b[?2004l\r"]
[457.772169, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[457.772188, "o", "\u001b[?2004h"]
[457.772273, "o", "> "]
[457.77234, "o", "def evaluate(agent, env, episodes=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.772397, "o", "    total = 0.0\r\n\u001b[?2004l\r"]
[457.772448, "o", "\u001b[?2004h> "]
[457.772529, "o", "    for _ in range(episodes):"]
[457.772542, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.772587, "o", "> "]
[457.772682, "o", "        obs, _ = env.reset()\r\n\u001b[?2004l\r"]
[457.772705, "o", "\u001b[?2004h> "]
[457.772774, "o", "        ep = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.772846, "o", "        done = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.772919, "o", "        while not done:"]
[457.772987, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.773089, "o", "            a = agent.select_action(obs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.773228, "o", "            obs, r, term, trunc, _ = env.step(a)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.773366, "o", "            ep += r\r\n"]
[457.773393, "o", "\u001b[?2004l\r"]
[457.773447, "o", "\u001b[?2004h> "]
[457.773566, "o", "            done = term or trunc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.773584, "o", "        total += ep\r\n\u001b[?2004l\r"]
[457.773598, "o", "\u001b[?2004h> "]
[457.773754, "o", "    return total / episodes\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[457.773779, "o", "\u001b[?2004h> "]
[457.773852, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.77393, "o", "    os.makedirs(TARGET_DIR, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.773948, "o", "> "]
[457.774145, "o", "    env = gym.make(\"CartPole-v1\")\r\n\u001b[?2004l\r"]
[457.774242, "o", "\u001b[?2004h> "]
[457.77439, "o", "    agent = Agent(STATE_DIM, ACTION_DIM, HIDDEN)\r\n\u001b[?2004l\r"]
[457.774495, "o", "\u001b[?2004h> "]
[457.774587, "o", "    policy = agent.policy_net\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.774715, "o", "    target = QNetwork(STATE_DIM, ACTION_DIM, HIDDEN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.774848, "o", "> "]
[457.775023, "o", "    target.load_state_dict(policy.state_dict())\r\n\u001b[?2004l\r"]
[457.775104, "o", "\u001b[?2004h> "]
[457.775154, "o", "    optimizer = torch.optim.Adam(policy.parameters(), lr=1e-3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.775234, "o", "    buffer = ReplayBuffer(20000)\r\n\u001b[?2004l\r"]
[457.775257, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[457.775368, "o", "\u001b[?2004h> "]
[457.775545, "o", "    gamma = 0.99\r\n\u001b[?2004l\r\u001b[?2004h>     batch = 128\r\n\u001b[?2004l\r"]
[457.775637, "o", "\u001b[?2004h>     eps_start = 1.0\r\n\u001b[?2004l\r\u001b[?2004h>     eps_end = 0.05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.775675, "o", "    eps_decay = 3000"]
[457.775778, "o", "\r\n\u001b[?2004l\r"]
[457.77589, "o", "\u001b[?2004h> "]
[457.777248, "o", "    target_update = 250"]
[457.777469, "o", "\r\n\u001b[?2004l\r"]
[457.777603, "o", "\u001b[?2004h> "]
[457.777776, "o", "    max_steps = 80000\r\n\u001b[?2004l\r"]
[457.7778, "o", "\u001b[?2004h> "]
[457.77787, "o", "    best_eval = -1.0"]
[457.777983, "o", "\r\n\u001b[?2004l\r"]
[457.778088, "o", "\u001b[?2004h> "]
[457.778157, "o", "    best_state = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.778233, "o", "> "]
[457.778295, "o", "    total_steps = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[457.778309, "o", "> "]
[457.778437, "o", "    while total_steps < max_steps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.778564, "o", "        obs, _ = env.reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.778631, "o", "        done = False"]
[457.77873, "o", "\r\n"]
[457.778948, "o", "\u001b[?2004l\r"]
[457.779142, "o", "\u001b[?2004h> "]
[457.779435, "o", "        while not done and total_steps < max_steps:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.779458, "o", "            eps = eps_end + (eps_start - eps_end) * np.exp(-total_steps / eps_decay)\r\n\u001b[?2004l\r"]
[457.77951, "o", "\u001b[?2004h"]
[457.779594, "o", "> "]
[457.779689, "o", "            if random.random() < eps:"]
[457.77975, "o", "\r\n"]
[457.779939, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[457.77998, "o", "                a = env.action_space.sample()"]
[457.780131, "o", "\r\n"]
[457.780238, "o", "\u001b[?2004l\r"]
[457.780358, "o", "\u001b[?2004h"]
[457.780462, "o", "> "]
[457.780615, "o", "            else:\r\n\u001b[?2004l\r"]
[457.78064, "o", "\u001b[?2004h> "]
[457.780742, "o", "                a = agent.select_action(obs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.780877, "o", "            s2, r, term, trunc, _ = env.step(a)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.780969, "o", "            d = float(term or trunc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[457.780995, "o", "> "]
[457.781115, "o", "            buffer.push(obs, a, r, s2, d)\r\n\u001b[?2004l\r"]
[457.781154, "o", "\u001b[?2004h> "]
[457.781358, "o", "            obs = s2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.781426, "o", "            done = bool(d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.781506, "o", "            total_steps += 1"]
[457.781634, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.782165, "o", "            if len(buffer) >= batch:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[457.782192, "o", "                s, a_i, rew, s2_b, d_b = buffer.sample(batch)\r\n\u001b[?2004l\r\u001b[?2004h>                 s_t = torch.from_numpy(s)\r\n\u001b[?2004l\r"]
[457.7824, "o", "\u001b[?2004h> "]
