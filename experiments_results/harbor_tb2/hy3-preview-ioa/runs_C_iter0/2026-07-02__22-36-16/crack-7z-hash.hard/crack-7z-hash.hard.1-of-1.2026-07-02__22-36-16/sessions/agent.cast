[533.266045, "i", "cat > /dev/shm/bf.py << 'EOF'\nimport lzma\ndata=open('/app/secrets.7z','rb').read()\ntarget=bytes('secrete_file.txt','utf-16-le')\nfound=[]\nfor s in range(0, len(data)):\n    for lc in range(0,9):\n        for lp in range(0,5):\n            for pb in range(0,5):\n                try:\n                    f=lzma.LZMADecompressor(format=lzma.FORMAT_RAW,filters=[{'id':lzma.FILTER_LZMA1,'lc':lc,'lp':lp,'pb':pb,'dict_size':1<<28}])\n                    out=f.decompress(data[s:])\n                    if target in out or b'secrete' in out or (out.isprintable() and 1<=len(out)<=120):\n                        found.append((s,lc,lp,pb,out))\n                except Exception:\n                    pass\nprint('candidates:',len(found))\nfor x in found[:50]:\n    print(x[0],x[1],x[2],x[3],repr(x[4][:160]))\nEOF\n"]
