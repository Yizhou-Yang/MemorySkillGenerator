[370.460108, "i", "arse_header(r):\n    pack=unpack=None\n    while True:\n        id=r.u8()\n        if id==0: break\n        if id==0x04:\n            p,u,s=parse_main_streams(r); pack,unpack=p,u\n        elif id==0x02:\n            while True:\n                pid=r.u8()\n                if pid==0: break\n                r.u8(); sz=r.varint(); r.read(sz)\n        elif id==0x05:\n            break\n        else:\n            break\n    return pack,unpack\n\ndef decode_folders(pack,unpack):\n    sizes=pack['sizes']; startpos=pack.get('startpos',0)\n    offs=[]; o=startpos\n    for s in sizes:\n        offs.append(o); o+=s\n    out=[]\n    for f in unpack:\n        blob=b''\n        for pi in f['pidx']:\n            blob+=get_packed(offs[pi], sizes[pi])\n        cd=f['coders'][0]; usize=sum(f['unpack_sizes'])\n        print(' coder',cd['id'].hex(),'props',cd['props'].hex(),'usize',usize,'bloblen',len(blob))\n        out.append(decomp(cd['id'],cd['props'],blob,usize))\n    return out\n\n# start header\nver=data[6:8]\nnext_off=struct.unpack('<Q',data[12:20])[0]\nnext_size=struct.unpack('<Q',data[20:28])[0]\nprint('ver',ver.hex(),'next_off',next_off,'next_size',next_size)\nnh=data[32+next_off:32+next_off+next_size]\nprint('encoded header:',nh.hex())\nr=R(nh)\nassert r.u8()==0x17\np,u,s=parse_main_streams(r)\nprint('enc pack',p)\nreal=decode_folders(p,u)[0]\nprint('real header len',len(real), real[:60].hex())\nr2=R(real)\np2,u2=parse_header(r2)\nprint('file pack',p2)\ncontents=decode_folders(p2,u2)\nfor i,c in enumerate(contents):\n    print('FOLDER',i,'len',len(c),'repr',repr(c[:120]))\nEOF\n"]
