[370.456883, "i", "cat > /dev/shm/p.py << 'EOF'\nimport struct, lzma\n\ndata = open('/app/secrets.7z','rb').read()\n\nclass R:\n    def __init__(self, d, pos=0):\n        self.d=d; self.p=pos\n    def u8(self):\n        v=self.d[self.p]; self.p+=1; return v\n    def read(self,n):\n        b=self.d[self.p:self.p+n]; self.p+=n; return b\n    def varint(self):\n        r=0; s=0\n        while True:\n            b=self.d[self.p]; self.p+=1\n            r|=(b&0x7f)<<s\n            if not(b&0x80): break\n            s+=7\n        return r\n\ndef get_packed(rel,n):\n    return data[32+rel:32+rel+n]\n\ndef lzma2_dict(p):\n    return (2|(p&1))<<((p>>1)+11)\n\ndef decomp(cid, props, blob, usize):\n    if cid==b'\\x03\\x01\\x01':\n        hdr=props+struct.pack('<Q', usize)\n        return lzma.decompress(hdr+blob, format=lzma.FORMAT_ALONE)\n    if cid[0]==0x21:\n        f=lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=[{'id':lzma.FILTER_LZMA2,'dict_size':lzma2_dict(props[0])}])\n        return f.decompress(blob)\n    rai"]
