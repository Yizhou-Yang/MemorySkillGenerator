[370.459424, "i", "se Exception('unknown coder '+cid.hex())\n\ndef parse_pack(r):\n    num=r.varint(); sizes=[]; startpos=0\n    while True:\n        id=r.u8()\n        if id==0: break\n        if id==0x09:\n            sizes=[r.varint() for _ in range(num)]\n        elif id==0x0A:\n            flag=r.u8()\n            if flag==1:\n                for _ in range(num): r.read(4)\n        elif id==0x18:\n            startpos=r.varint()\n        else:\n            raise Exception('pack prop %x'%id)\n    return {'num':num,'sizes':sizes,'startpos':startpos}\n\ndef parse_unpack(r):\n    assert r.u8()==0x0B\n    num_folders=r.varint(); folders=[]\n    for _ in range(num_folders):\n        nc=r.varint(); coders=[]; tin=0; tout=0\n        for _ in range(nc):\n            b=r.u8(); isc=(b&0x10)!=0; hasp=(b&0x20)!=0; ids=(b&0x0F)+1\n            cid=r.read(ids)\n            if isc: ni=r.varint(); no=r.varint()\n            else: ni=1; no=1\n            if hasp: ps=r.varint(); pr=r.read(ps)\n            else: pr=b''\n            coders.append({'id':cid,'props':pr,'ni':ni,'no':no})\n            tin+=ni; tout+=no\n        bind=[]\n        if tin>num_folders:\n            for _ in range(tin-num_folders):\n                bi=r.varint(); bo=r.varint(); bind.append((bi,bo))\n        npk = tin-len(bind)\n        pidx=[r.varint() for _ in range(npk)]\n        folders.append({'coders':coders,'tin':tin,'tout':tout,'bind':bind,'pidx':pidx})\n    assert r.u8()==0x0C\n    for f in folders:\n        f['unpack_sizes']=[r.varint() for _ in range(f['tout'])]\n    id=r.u8()\n    if id==0x0A:\n        flag=r.u8()\n        if flag==1:\n            for _ in range(num_folders): r.read(4)\n        id=r.u8()\n    assert id==0\n    return folders\n\ndef parse_main_streams(r):\n    pack=unpack=sub=None\n    while True:\n        id=r.u8()\n        if id==0: break\n        if id==0x06: pack=parse_pack(r)\n        elif id==0x07: unpack=parse_unpack(r)\n        elif id==0x08: r.varint()  # substreams skip\n        else: raise Exception('ms prop %x'%id)\n    return pack,unpack,sub\n\ndef p"]
