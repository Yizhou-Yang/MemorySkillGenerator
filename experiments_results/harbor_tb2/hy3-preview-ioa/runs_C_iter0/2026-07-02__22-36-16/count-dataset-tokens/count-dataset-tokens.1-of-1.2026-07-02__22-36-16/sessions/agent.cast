[418.967064, "i", "cat > /app/explore.py << 'EOF'\nfrom datasets import load_dataset\nfrom collections import Counter\nds = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\", streaming=True)\ndomains = Counter()\nn = 0\nsample = None\nfor ex in ds:\n    domains[ex['domain']] += 1\n    if sample is None:\n        sample = ex\n    n += 1\n    if n >= 2000:\n        break\nprint(\"partial domain counts (first 2000):\", domains)\nprint(\"keys:\", list(sample.keys()))\nprint(\"domain sample:\", repr(sample['domain']))\nprint(\"reasoning[:200]:\", repr(sample['deepseek_reasoning'][:200]))\nprint(\"solution[:200]:\", repr(sample['deepseek_solution'][:200]))\nEOF\npython3 /app/explore.py\n"]
