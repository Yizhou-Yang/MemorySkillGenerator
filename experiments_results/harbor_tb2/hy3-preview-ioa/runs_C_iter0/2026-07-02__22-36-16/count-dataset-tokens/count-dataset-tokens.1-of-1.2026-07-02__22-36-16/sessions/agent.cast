[577.07061, "i", "cat > /app/count.py << 'EOF'\nimport os\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer\n\ntok = AutoTokenizer.from_pretrained(\"Qwen/Qwen2.5-1.5B-Instruct\")\nprint(\"tokenizer loaded\", flush=True)\n\nds = load_dataset(\"open-thoughts/OpenThoughts-114k\", \"metadata\", split=\"train\", streaming=True)\n\nfrom collections import Counter\ndom = Counter()\ntotal = 0\nn_sci = 0\nseen = 0\nfor ex in ds:\n    d = ex.get('domain')\n    dom[d] += 1\n    if d == 'science':\n        t = (ex.get('deepseek_reasoning') or '') + (ex.get('deepseek_solution') or '')\n        total += len(tok(t)['input_ids'])\n        n_sci += 1\n    seen += 1\n    if seen % 20000 == 0:\n        print(f\"processed {seen} examples, science tokens so far={total}, n_sci={n_sci}\", flush=True)\n\nprint(\"DOMAIN COUNTS:\", dict(dom), flush=True)\nprint(\"science examples:\", n_sci, \"science deepseek tokens:\", total, flush=True)\n\nwith open(\"/app/answer.txt\", \"w\") as f:\n    f.write(str(total))\n    f.flush()\n    os.fsync(f.fileno())\nprint(\"WROTE\", total, flush=Tru"]
