[49.172508, "i", "cat > /app/check_cert.py << 'EOF'\n#!/usr/bin/env python3\nimport ssl\nimport subprocess\nimport os\nimport sys\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\n\ndef main():\n    # Verify the certificate exists\n    if not os.path.isfile(CERT_PATH):\n        print(f\"Certificate not found at {CERT_PATH}\")\n        sys.exit(1)\n\n    # Verify the certificate can be loaded\n    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)\n    context.load_verify_locations(CERT_PATH)\n\n    # Extract details using openssl via subprocess\n    subject = subprocess.check_output(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\"],\n        text=True,\n    ).strip()\n\n    end_date = subprocess.check_output(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-enddate\"],\n        text=True,\n    ).strip()\n\n    # Parse Common Name from subject\n    cn = \"\"\n    for part in subject.replace(\"subject=\", \"\").split(\",\"):\n        part = part.strip()\n        if part.startswith(\"CN =\"):\n            cn = part.split(\"=\", 1)[1].strip()\n\n    # Parse expira"]
[49.172557, "i", "tion date and format as YYYY-MM-DD\n    expiry_raw = end_date.replace(\"notAfter=\", \"\").strip()\n    expiry = subprocess.check_output(\n        [\"date\", \"-d\", expiry_raw, \"+%Y-%m-%d\"],\n        text=True,\n    ).strip()\n\n    print(\"Certificate Subject:\", subject)\n    print(\"Common Name:\", cn)\n    print(\"Expiration Date:\", expiry)\n\n    print(\"Certificate verification successful\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[49.172737, "o", "cat > /app/check_cert.py << 'EOF'\r\n\u001b[?2004l\r"]
