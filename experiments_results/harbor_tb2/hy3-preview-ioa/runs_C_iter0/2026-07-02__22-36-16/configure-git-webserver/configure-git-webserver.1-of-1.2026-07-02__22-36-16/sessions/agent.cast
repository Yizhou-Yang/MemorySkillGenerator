[73.862328, "o", "\u001b[?2004hroot@cb975b792377:/app# "]
[295.079886, "i", "cat > /app/setup.sh <<'SETUP_EOF'\n#!/bin/bash\nexport DEBIAN_FRONTEND=noninteractive\n\necho '[*] Installing packages...'\napt-get update -y >/dev/null 2>&1 || true\napt-get install -y git openssh-server >/dev/null 2>&1 || true\n\necho '[*] Setting up user...'\nid user >/dev/null 2>&1 || useradd -m -s /bin/bash user\ninstall -d -m700 /home/user/.ssh\nchmod 755 /home/user\n\necho '[*] Setting up SSH for root -> user@server...'\nssh-keygen -A >/dev/null 2>&1 || true\nmkdir -p /run/sshd\n[ -f /root/.ssh/id_rsa ] || ssh-keygen -t rsa -N '' -f /root/.ssh/id_rsa >/dev/null 2>&1\ncat /root/.ssh/id_rsa.pub > /home/user/.ssh/authorized_keys\nchmod 600 /home/user/.ssh/authorized_keys\nchown -R user:user /home/user/.ssh\n\ngrep -q '[[:space:]]server$' /etc/hosts || echo '127.0.0.1 server' >> /etc/hosts\n\ncat > /etc/ssh/sshd_config.d/99-git.conf <<'EOF'\nPubkeyAuthentication yes\nPasswordAuthentication no\nEOF\n\necho '[*] Starting sshd...'\npkill -x sshd 2>/dev/null || true\n/usr/sbin/sshd\n\necho '[*]"]
[295.080299, "o", "cat > /app/setup.sh <<'SETUP_EOF'\r\n"]
[295.080346, "i", " Creating bare repo...'\nmkdir -p /git\nrm -rf /git/server\ngit init --bare /git/server >/dev/null 2>&1\ngit --git-dir=/git/server symbolic-ref HEAD refs/heads/webserver\nchown -R user:user /git\n\nmkdir -p /var/www/html\nchown -R user:user /var/www/html\n\ncat > /git/server/hooks/post-receive <<'EOF'\n#!/bin/bash\nwhile read oldrev newrev refname; do\n  branch=\"${refname#refs/heads/}\"\n  if [ \"$branch\" = \"webserver\" ]; then\n    git archive \"$branch\" | tar -x -C /var/www/html\n    echo \"Deployed $branch -> /var/www/html\"\n  fi\ndone\nEOF\nchmod +x /git/server/hooks/post-receive\nchown user:user /git/server/hooks/post-receive\n\necho '[*] Seeding initial commit...'\ngit config --global --add safe.directory /git/server\nrm -rf /tmp/seed && mkdir -p /tmp/seed\ncd /tmp/seed\ngit init -q\ngit symbolic-ref HEAD refs/heads/webserver\necho '<html></html>' > index.html\ngit add index.html\ngit -c user.email=root@server -c user.name=root commit -qm 'initial'\ngit push /git/server webserver\ncd /\nchown -R user:user /git\n\necho '[*] Generating TLS cert...'\nmkdir -p /etc/ssl/gitweb\nopenssl req -x509 -newkey rsa:2048 -nodes \\\n  -keyout /etc/ssl/gitweb/key.pem -out /etc/ssl/gitweb/cert.pem \\\n  -days 3650 -subj '/CN=server' \\\n  -addext 'subjectAltName=DNS:server,IP:127.0.0.1' 2>/dev/null\ncp /etc/ssl/gitweb/cert.pem /usr/local/share/ca-certificates/gitweb.crt\nupdate-ca-certificates >/dev/null 2>&1 || true\n\necho '[*] SSH client config...'\nmkdir -p /root/.ssh\ncat > /root/.ssh/config <<'EOF'\nHost server\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n  LogLevel ERROR\nEOF\nchmod 600 /root/.ssh/config\n\necho '[*] Starting web server...'\ncat > /app/webserver.py <<'EOF'\nimport http.server, ssl, os\nos.chdir('/var/www/html')\nhttpd = http.server.HTTPServer(('0.0.0.0', 8080), http.server.SimpleHTTPRequestHandler)\nctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\nctx.load_cert_chain('/etc/ssl/gitweb/cert.pem', '/etc/ssl/gitweb/key.pem')\nhttpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)\nhttpd.serve_forever()\nEOF\npkill -f webserver.py 2>/dev/null || true\nnohup python3 /app/webserver.py >/app/webserver.log 2>&1 &\n\necho '[*] Setup complete.'\nSETUP_EOF\n"]
