[259.01365, "o", "##............##.............\r\n   ...........#..............#.............\r\n   ..........#################.............\r\n   ...........################.............\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n=== r5 c0  color=W cnt=492 lum=234 ===\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   .................####...................\r\n   ................##.##...................\r\n   .................####...................\r\n   ...............#######..................\r\n   ...............#.....##.................\r\n   ..............##......#.................\r\n   .....##........##....##.................\r\n   .....#.........#######..................\r\n   ....#.#......###......###...............\r\n   ............##..........##..............\r\n   ...........##............##.............\r\n   ..........##.............##.............\r\n   ..........#################.............\r\n   ..........#################.............\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n=== r5 c2  color=W cnt=268 lum=213 ===\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   ........................................\r\n   .................##.....................\r\n   .............##..#.#....................\r\n   .............#..#..#....................\r\n\u001b[?2004hroot@e067fc5e1a11:/app# "]
[333.066796, "i", "cat > /app/cluster.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.array(im).astype(int)\nS=80\ndef sq(r,c): return arr[r*S:(r+1)*S, c*S:(c+1)*S]\ndef bg(r,c):\n    p=sq(r,c).reshape(-1,3); return np.median(p,axis=0)\ndef maskof(r,c):\n    p=sq(r,c).reshape(-1,3); b=bg(r,c)\n    d=np.abs(p-b).sum(axis=1); m=d>60\n    return m.reshape(S,S)\nocc=[]\nfor r in range(8):\n    for c in range(8):\n        m=maskof(r,c)\n        if m.sum()>150:\n            lum=float(sq(r,c).reshape(-1,3)[m.flatten()].mean(axis=0).mean())\n            occ.append((r,c,'W' if lum>120 else 'B',m))\n# build normalized 24x24 bitmaps\ndef norm(m):\n    # center via bounding box then resize to 24x24\n    ys,xs=np.where(m)\n    if ys.size==0: return None\n    y0,y1,x0,x1=ys.min(),ys.max(),xs.min(),xs.max()\n    crop=m[y0:y1+1,x0:x1+1].astype(float)\n    H,W=crop.shape\n    out=np.zeros((24,24))\n    for i in range(24):\n        for j in range(24):\n            sy=int(i*H/24); sx=int(j*W/24)\n            out[i,j]=crop[min(sy,H-1),min(sx,W-1)]\n    return out>0.5\nbmps=[norm(m) for (*_,m) in occ]\ndef dist(a,b):\n    return int((a!=b).sum())\nclusters=[]\nfor i,(r,c,col,_) in enumerate(occ):\n    placed=False\n    for cl in clusters:\n        j=cl[0]\n        if dist(bmps[i],bmps[j])<45:\n            cl.append(i); placed=True; break\n    if not placed:\n        clusters.append([i])\nprint('num clusters', len(clusters))\nfor ci,cl in enumerate(clusters):\n    members=[(occ[i][0],occ[i][1],occ[i][2]) for i in cl]\n    print('--- cluster',ci,'members',members)\n    b=bmps[cl[0]]\n    for row in b:\n        print('   '+''.join('#' if v else '.' for v in row))\nEOF\npython3 /app/cluster.py > /app/clusters.txt 2>&1; head -5 /app/clusters.txt\n"]
[333.073297, "o", "cat > /app/cluster.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> im = Image.open('/app/chess_puzzle.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> arr = np.array(im).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> S=80\r\n\u001b[?2004l\r\u001b[?2004h> def sq(r,c): return arr[r*S:(r+1)*S, c*S:(c+1)*S]\r\n\u001b[?2004l\r\u001b[?2004h> def bg(r,c):\r\n\u001b[?2004l\r\u001b[?2004h>     p=sq(r,c).reshape(-1,3); return np.median(p,axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> def maskof(r,c):\r\n\u001b[?2004l\r\u001b[?2004h>     p=sq(r,c).reshape(-1,3); b=bg(r,c)\r\n\u001b[?2004l\r\u001b[?2004h>     d=np.abs(p-b).sum(axis=1); m=d>60\r\n\u001b[?2004l\r\u001b[?2004h>     return m.reshape(S,S)\r\n\u001b[?2004l\r\u001b[?2004h> occ=[]\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>     for c in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>         m=maskof(r,c)\r\n\u001b[?2004l\r\u001b[?2004h>         if m.sum()>150:\r\n\u001b[?2004l\r\u001b[?2004h>             lum=float(sq(r,c).reshape(-1,3)[m.flatten()].mean(axis=0).mean())\r\n\u001b[?2004l\r\u001b[?2004h>             occ.append((r,c,'W' if lum>120 else 'B',m))\r\n\u001b[?2004l\r\u001b[?2004h> # build normalized 24x24 bitmaps\r\n\u001b[?2004l\r\u001b[?2004h> def norm(m):\r\n\u001b[?2004l\r\u001b[?2004h>     # center via bounding box then resize to 24x24\r\n\u001b[?2004l\r\u001b[?2004h>     ys,xs=np.where(m)\r\n\u001b[?2004l\r\u001b[?2004h>     if ys.size==0: return None\r\n\u001b[?2004l\r\u001b[?2004h>     y0,y1,x0,x1=ys.min(),ys.max(),xs.min(),xs.max()\r\n\u001b[?2004l\r\u001b[?2004h>     crop=m[y0:y1+1,x0:x1+1].astype(float)\r\n\u001b[?2004l\r\u001b[?2004h>     H,W=crop.shape\r\n\u001b[?2004l\r\u001b[?2004h>     out=np.zeros((24,24))\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(24):\r\n\u001b[?2004l\r\u001b[?2004h>         for j in range(24):\r\n\u001b[?2004l\r\u001b[?2004h>             sy=int(i*H/24); sx=int(j*W/24)\r\n\u001b[?2004l\r\u001b[?2004h>             out[i,j]=crop[min(sy,H-1),min(sx,W-1)]\r\n\u001b[?2004l\r\u001b[?2004h>     return out>0.5\r\n\u001b[?2004l\r\u001b[?2004h> bmps=[norm(m) for (*_,m) in occ]\r\n\u001b[?2004l\r\u001b[?2004h> def dist(a,b):\r\n\u001b[?2004l\r\u001b[?2004h>     return int((a!=b).sum())\r\n\u001b[?2004l\r\u001b[?2004h> clusters=[]"]
