[147.170829, "i", "cat > /app/analyze.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\n\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.array(im)\nprint('shape', arr.shape)\nS = 80\n# sample background colors from a few corner squares\ndef sq(r,c):\n    return arr[r*S:(r+1)*S, c*S:(c+1)*S]\n\n# Determine bg color per square as median\nfor r in range(8):\n    row=[]\n    for c in range(8):\n        patch = sq(r,c).reshape(-1,3).astype(int)\n        med = np.median(patch, axis=0)\n        row.append(tuple(med.astype(int)))\n    print(r, row)\nEOF\npython3 /app/analyze.py\n"]
