[205.598418, "o", "Traceback (most recent call last):\r\n  File \"/app/render.py\", line 29, in <module>\r\n    res=render(r,c)\r\n        ^^^^^^^^^^^\r\n  File \"/app/render.py\", line 16, in render\r\n    lum=p[mask].mean(axis=0).mean() if cnt>0 else 0\r\n        ~^^^^^^\r\nIndexError: boolean index did not match indexed array along axis 0; size of axis is 6400 but size of corresponding boolean axis is 80\r\n\u001b[?2004hroot@e067fc5e1a11:/app# "]
[216.244085, "i", "cat > /app/render.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.array(im).astype(int)\nS=80\ndef sq(r,c): return arr[r*S:(r+1)*S, c*S:(c+1)*S]\ndef bg(r,c):\n    p=sq(r,c).reshape(-1,3)\n    return np.median(p,axis=0)\ndef render(r,c):\n    p=sq(r,c).reshape(-1,3)\n    b=bg(r,c)\n    d=np.abs(p-b).sum(axis=1)\n    mask=d>60\n    cnt=int(mask.sum())\n    m2d=mask.reshape(S,S)\n    if cnt<150:\n        return None\n    lum=float(p[mask].mean(axis=0).mean())\n    color='W' if lum>120 else 'B'\n    lines=[]\n    for y in range(0,S,3):\n        line=''\n        for x in range(0,S,2):\n            line += '#' if m2d[y,x] else '.'\n        lines.append(line)\n    return color,cnt,int(lum),lines\nfor r in range(8):\n    for c in range(8):\n        res=render(r,c)\n        if res:\n            color,cnt,lum,lines=res\n            print('=== r%d c%d  color=%s cnt=%d lum=%d ==='%(r,c,color,cnt,lum))\n            for l in lines:\n                print('   '+l)\nEOF\npython3 /app/render.py > /app/art.txt 2>&1; wc -l /app/art.txt\n"]
[216.245575, "o", "cat > /app/render.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> im = Image.open('/app/chess_puzzle.png').convert('RGB')\r\n\u001b[?2004l\r\u001b[?2004h> arr = np.array(im).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> S=80\r\n\u001b[?2004l\r\u001b[?2004h> def sq(r,c): return arr[r*S:(r+1)*S, c*S:(c+1)*S]\r\n\u001b[?2004l\r\u001b[?2004h> def bg(r,c):\r\n\u001b[?2004l\r\u001b[?2004h>     p=sq(r,c).reshape(-1,3)\r\n\u001b[?2004l\r\u001b[?2004h>     return np.median(p,axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
