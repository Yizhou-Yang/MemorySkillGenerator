[556.600583, "i", "cat > /app/solve.py << 'EOF'\nimport chess\nfen='r1bq1r2/1p3pp1/p1n1p3/3nPkb1/8/N1N5/1P2QPP1/R1B1K2R w - - 0 1'\nboard=chess.Board(fen)\nprint('valid:', board.is_valid())\nprint(board)\nprint('turn white:', board.turn==chess.WHITE)\nprint('white in check:', board.is_check())\n# find all mate in 1\nmates=[]\nfor m in board.legal_moves:\n    board.push(m)\n    if board.is_checkmate():\n        mates.append(m)\n    board.pop()\nprint('mate in 1 moves:')\nfor m in mates:\n    print('  ', board.san(m), m.uci())\nif not mates:\n    print('  none')\nEOF\npython3 /app/solve.py\n"]
