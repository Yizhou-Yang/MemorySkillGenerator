[168.269263, "i", "cat > /app/occ.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\narr = np.array(im).astype(int)\nS=80\ndef sq(r,c): return arr[r*S:(r+1)*S, c*S:(c+1)*S]\nbg_cache={}\ndef bg(r,c):\n    p=sq(r,c).reshape(-1,3)\n    return np.median(p,axis=0)\nfor r in range(8):\n    occ=[]\n    for c in range(8):\n        p=sq(r,c).reshape(-1,3)\n        b=bg(r,c)\n        d=np.abs(p-b).sum(axis=1)\n        mask=d>60\n        cnt=mask.sum()\n        if cnt>150:\n            fill=p[mask].mean(axis=0)\n            # classify color: white piece -> fill bright, black piece -> fill dark\n            lum=fill.mean()\n            occ.append('%3d %3d'%(cnt, lum))\n        else:\n            occ.append('  .   ')\n    print(r, ' | '.join(occ))\nEOF\npython3 /app/occ.py\n"]
