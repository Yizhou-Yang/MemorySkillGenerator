[397.005998, "o", "\u001b[?2004hroot@4f04dba2557a:/app# "]
[408.552292, "i", "cat > /tmp/cap2.py <<'EOF'\nimport socket, time, sys\nhost,port='127.0.0.1',4555\nbuf=b''\ns=socket.create_connection((host,port),timeout=5)\ns.settimeout(2)\nfor _ in range(5):\n    s.sendall(b'\\n')\n    time.sleep(0.5)\nend=time.time()+25\nwhile time.time()<end:\n    try:\n        d=s.recv(4096)\n        if not d: break\n        buf+=d\n    except socket.timeout:\n        pass\n    except Exception:\n        break\nout=buf.decode(errors='replace')\nsys.stdout.write(out)\nopen('/tmp/bootout.txt','w').write(out)\nEOF\npython3 /tmp/cap2.py\n"]
