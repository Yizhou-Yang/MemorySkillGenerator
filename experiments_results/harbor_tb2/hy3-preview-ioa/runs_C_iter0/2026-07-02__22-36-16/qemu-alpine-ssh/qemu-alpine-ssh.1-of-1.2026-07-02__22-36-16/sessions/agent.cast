[509.280004, "i", "cat > /tmp/cap4.py <<'EOF'\nimport socket, time, sys\nhost,port='127.0.0.1',4555\nbuf=b''\ns=socket.create_connection((host,port),timeout=5)\ns.settimeout(2)\nend=time.time()+60\nlast=time.time()\nwhile time.time()<end:\n    try:\n        d=s.recv(4096)\n        if not d:\n            time.sleep(0.3); continue\n        buf+=d\n    except socket.timeout:\n        if time.time()-last>3:\n            s.sendall(b'\\n'); last=time.time()\n    except Exception:\n        break\nout=buf.decode(errors='replace')\nsys.stdout.write(out)\nopen('/tmp/bootout.txt','w').write(out)\nEOF\npython3 /tmp/cap4.py\n"]
