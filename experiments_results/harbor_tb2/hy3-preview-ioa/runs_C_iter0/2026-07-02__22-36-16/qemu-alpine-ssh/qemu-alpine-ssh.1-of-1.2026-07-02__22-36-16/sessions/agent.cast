[334.633693, "i", "cat > /tmp/iso_extract.py <<'EOF'\nimport struct\nISO='/app/alpine.iso'\nSEC=2048\n\ndef read_sector(f, lba, count=1):\n    f.seek(lba*SEC)\n    return f.read(count*SEC)\n\ndef parse_dir(data):\n    recs=[]; i=0; n=len(data)\n    while i < n:\n        rec_len=data[i]\n        if rec_len==0 or rec_len<34 or i+rec_len>n: break\n        lba=struct.unpack('<I', data[i+2:i+6])[0]\n        size=struct.unpack('<I', data[i+10:i+14])[0]\n        flags=data[i+25]\n        name_len=data[i+32]\n        name=data[i+33:i+33+name_len]\n        if name==b'\\x00': nm='.'\n        elif name==b'\\x01': nm='..'\n        else:\n            s=name.split(b';')[0]\n            nm=s.decode('latin1')\n        recs.append((nm,(flags&2)!=0,lba,size)); i+=rec_len\n    return recs\n\nf=open(ISO,'rb')\npvd=read_sector(f,16)\nassert pvd[1:6]==b'CD001' and pvd[0]==1, 'no PVD'\nroot=pvd[156:190]\nlba=struct.unpack('<I', root[2:6])[0]\nsize=struct.unpack('<I', root[10:14])[0]\nfiles={}\ndef walk(lba,size,prefix):\n    data=read_sect"]
[334.634247, "o", "cat > /tmp/iso_extract.py <<'EOF'"]
[334.634579, "o", "\r\n"]
