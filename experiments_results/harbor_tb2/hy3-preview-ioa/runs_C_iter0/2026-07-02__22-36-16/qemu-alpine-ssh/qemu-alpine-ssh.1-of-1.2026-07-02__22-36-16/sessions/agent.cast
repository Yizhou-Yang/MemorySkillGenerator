[334.638132, "o", "    return f.read(count*SEC)"]
[334.638234, "i", "or(f,lba,(size+SEC-1)//SEC)\n    for nm,isdir,clba,csz in parse_dir(data):\n        if nm in ('.','..'): continue\n        p=prefix+'/'+nm\n        files[p]=(clba,csz)\n        if isdir: walk(clba,csz,p)\nwalk(lba,size,'')\nfor p,(clba,csz) in files.items():\n    up=p.upper()\n    if 'VMLINUZ' in up and 'INITRAMFS' not in up:\n        print('EXTRACT vmlinuz', p, clba, csz)\n        d=read_sector(f,clba,(csz+SEC-1)//SEC)[:csz]\n        open('/tmp/vmlinuz','wb').write(d)\n    if 'INITRAMFS' in up:\n        print('EXTRACT initramfs', p, clba, csz)\n        d=read_sector(f,clba,(csz+SEC-1)//SEC)[:csz]\n        open('/tmp/initramfs','wb').write(d)\nprint('done, total files', len(files))\nEOF\npython3 /tmp/iso_extract.py\n"]
