[689.986169, "i", "cat > /tmp/setup.py <<'EOF'\nimport socket, time, sys\n\ndef main():\n    s = socket.create_connection(('127.0.0.1',4555), timeout=10)\n    s.settimeout(2)\n    buf = b''\n    pos = 0\n    def read_until(token, timeout=40):\n        nonlocal buf, pos\n        end = time.time()+timeout\n        while time.time() < end:\n            if token in buf[pos:]:\n                idx = buf.index(token, pos)\n                pos = idx + len(token)\n                return True\n            try:\n                d = s.recv(4096)\n                if not d:\n                    time.sleep(0.1); continue\n                buf += d\n            except socket.timeout:\n                pass\n            except Exception:\n                return False\n        return False\n    def send(line):\n        s.sendall(line.encode())\n    def run(cmd, timeout=40):\n        send(cmd + '\\n')\n        ok = read_until(b'RDY>', timeout=timeout)\n        seg = buf[:pos].decode(errors='replace')\n        # strip the echoed command up to RDY>\n        return seg\n\n    print('=="]
[689.986416, "i", " wait login ==', read_until(b'login:', 30))\n    send('root\\n')\n    print('== wait shell ==', read_until(b'#', 20))\n    send(\"export PS1='RDY> '\\n\")\n    print('== wait ps1 ==', read_until(b'RDY>', 15))\n\n    cmds = [\n        \"echo 'root:password123' | chpasswd\",\n        \"ip link show eth0\",\n        \"udhcpc -i eth0 -n -q -t 8 -A 2\",\n        \"ip -4 addr show eth0\",\n        \"ip route\",\n        \"printf 'https://dl-cdn.alpinelinux.org/alpine/v3.19/main\\nhttps://dl-cdn.alpinelinux.org/alpine/v3.19/community\\n' > /etc/apk/repositories\",\n        \"apk update\",\n        \"apk add openssh\",\n        \"ssh-keygen -A\",\n        \"sed -i 's/^#\\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config\",\n        \"sed -i 's/^#\\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config\",\n        \"grep -q '^PermitRootLogin yes' /etc/ssh/sshd_config || echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config\",\n        \"/usr/sbin/sshd\",\n        \"netstat -ltn 2>/dev/null | grep ':22' || ss -ltn 2>/dev/null | grep ':22'\",\n  "]
[689.98656, "i", "  ]\n    for c in cmds:\n        out = run(c, timeout=60)\n        print('### CMD:', c)\n        print(out)\n    send('echo SETUP_COMPLETE\\n')\n    read_until(b'RDY>', 10)\n    print('=== FINAL BUF TAIL ===')\n    print(buf[-1500:].decode(errors='replace'))\n\nmain()\nEOF\necho written\n"]
