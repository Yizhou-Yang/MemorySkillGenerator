[203.458879, "i", "cat > /tmp/cap.py <<'EOF'\nimport socket, time, sys\nhost,port='127.0.0.1',4555\nbuf=b''\ns=socket.create_connection((host,port),timeout=5)\ns.settimeout(2)\ntime.sleep(1)\ntry:\n    s.sendall(b'\\n')\nexcept: pass\nend=time.time()+30\nwhile time.time()<end:\n    try:\n        d=s.recv(4096)\n        if not d: break\n        buf+=d\n    except socket.timeout:\n        pass\n    except Exception as e:\n        break\nsys.stdout.write(buf.decode(errors='replace'))\nEOF\npython3 /tmp/cap.py\n"]
