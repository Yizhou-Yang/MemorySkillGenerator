[334.643107, "o", "> "]
[334.643255, "o", "def walk(lba,size,prefix):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.643316, "o", "    data=read_sector(f,lba,(size+SEC-1)//SEC)\r\n\u001b[?2004l\r"]
[334.643334, "o", "\u001b[?2004h"]
[334.64343, "o", "> "]
[334.643961, "o", "    for nm,isdir,clba,csz in parse_dir(data):\r\n\u001b[?2004l\r"]
[334.644028, "o", "\u001b[?2004h> "]
[334.644069, "o", "        if nm in ('.','..'): continue\r\n\u001b[?2004l\r"]
[334.644112, "o", "\u001b[?2004h> "]
[334.644236, "o", "        p=prefix+'/'+nm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.644264, "o", "        files[p]=(clba,csz)\r\n\u001b[?2004l\r"]
[334.644355, "o", "\u001b[?2004h>         if isdir: walk(clba,csz,p)\r\n\u001b[?2004l\r"]
[334.64443, "o", "\u001b[?2004h> "]
[334.644578, "o", "walk(lba,size,'')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.644714, "o", "for p,(clba,csz) in files.items():\r\n\u001b[?2004l\r\u001b[?2004h>     up=p.upper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.644906, "o", "    if 'VMLINUZ' in up and 'INITRAMFS' not in up:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.644978, "o", "        print('EXTRACT vmlinuz', p, clba, csz)\r\n\u001b[?2004l\r"]
[334.645128, "o", "\u001b[?2004h> "]
[334.645212, "o", "        d=read_sector(f,clba,(csz+SEC-1)//SEC)[:csz]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.64529, "o", "        open('/tmp/vmlinuz','wb').write(d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.645514, "o", "    if 'INITRAMFS' in up:\r\n\u001b[?2004l\r\u001b[?2004h>         print('EXTRACT initramfs', p, clba, csz)\r\n\u001b[?2004l\r\u001b[?2004h"]
[334.645684, "o", ">         d=read_sector(f,clba,(csz+SEC-1)//SEC)[:csz]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[334.645843, "o", "        open('/tmp/initramfs','wb').write(d)"]
[334.645902, "o", "\r\n"]
[334.646069, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[334.646094, "o", "print('done, total files', len(files))\r\n"]
[334.646103, "o", "\u001b[?2004l\r"]
[334.646868, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[334.651576, "o", "\u001b[?2004hroot@4f04dba2557a:/app# "]
[334.652037, "o", "python3 /tmp/iso_extract.py"]
[334.652646, "o", "\r\n\u001b[?2004l\r"]
[334.69263, "o", "EXTRACT initramfs /BOOT/INITRAMFS_LTS. 377583 20486092"]
[334.694038, "o", "\r\n"]
[334.943885, "o", "EXTRACT vmlinuz /BOOT/VMLINUZ_LTS. 483188 11879168\r\n"]
[334.994896, "o", "done, total files 40"]
[334.99576, "o", "\r\n"]
[335.003126, "o", "\u001b[?2004h"]
[335.003832, "o", "root@4f04dba2557a:/app# "]
[336.492487, "i", "ls -la /tmp/vmlinuz /tmp/initramfs\n"]
[336.492711, "o", "ls -la /tmp/vmlinuz /tmp/initramfs\r\n\u001b[?2004l\r"]
[336.499915, "o", "-rw-r--r-- 1 root root 20486092 Jul  2 16:15 /tmp/initramfs"]
[336.500507, "o", "\r\n"]
[336.500767, "o", "-rw-r--r-- 1 root root 11879168 Jul  2 16:15 /tmp/vmlinuz"]
[336.501025, "o", "\r\n"]
[336.502152, "o", "\u001b[?2004h"]
[336.502458, "m", "Episode 9: 3 commands"]
[336.502458, "o", "root@4f04dba2557a:/app# "]
[362.665248, "i", "nohup qemu-system-x86_64 -m 1024 -smp 2 -kernel /tmp/vmlinuz -initrd /tmp/initramfs -append \"console=ttyS0,115200 modules=loop,squashfs,sd-mod,usb-storage\" -cdrom /app/alpine.iso -drive file=/app/alpine-disk.qcow2,format=qcow2,if=virtio -netdev user,id=net0,hostfwd=tcp::2222-:22 -device virtio-net-pci,netdev=net0 -display none -serial tcp:127.0.0.1:4555,server,nowait > /tmp/qemu.log 2>&1 &\n"]
[362.666131, "o", "nohup qemu-system-x86_64 -m 1024 -smp 2 -kernel /tmp/vmlinuz -initrd /tmp/initramfs -append \"console=ttyS0,115200 modules=loop,squashfs,sd-mod,usb-storage\" -cdrom /app/alpine.iso -drive file=/app/alpine-disk.qcow2,format=qcow2,if=virtio -netdev user,id=net0,hostfwd=tcp::2222-:22 -device virtio-net-pci,netdev=net0 -display none -serial tcp:127.0.0.1:4555,server,nowait > /tmp/qemu.log 2>&1 &\r\n\u001b[?2004l\r"]
