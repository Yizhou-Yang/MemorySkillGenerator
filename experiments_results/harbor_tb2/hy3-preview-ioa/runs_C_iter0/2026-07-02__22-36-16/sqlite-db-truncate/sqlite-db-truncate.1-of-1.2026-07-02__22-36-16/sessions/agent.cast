[463.164559, "i", "cat > /app/final_recover.py << 'PYEOF'\nimport struct, json\n\ndata = open('/app/trunc.db','rb').read()\n\ndef rv(buf, pos):\n    r = 0\n    for i in range(9):\n        b = buf[pos+i]\n        if i == 8:\n            return (r << 8) | b, pos+9\n        r = (r << 7) | (b & 0x7f)\n        if not (b & 0x80):\n            return r, pos+i+1\n    return r, pos+9\n\nncells = int.from_bytes(data[3:5],'big')\nptrs = [int.from_bytes(data[8+2*i:10+2*i],'big') for i in range(ncells)]\n\ndef parse_record(payload):\n    hdr_len, hpos = rv(payload, 0)\n    serial_types = []\n    idx = hpos\n    while idx < hdr_len:\n        st, idx = rv(payload, idx)\n        serial_types.append(st)\n    cols = []\n    dpos = hdr_len\n    for st in serial_types:\n        if st == 0:\n            cols.append(None)\n            continue\n        elif st == 1:\n            v = int.from_bytes(payload[dpos:dpos+1],'big',signed=True); dpos+=1\n        elif st == 2:\n            v = int.from_bytes(payload[dpos:dpos+2],'big',signed=Tru"]
[463.164802, "i", "e); dpos+=2\n        elif st == 3:\n            v = int.from_bytes(payload[dpos:dpos+3],'big',signed=True); dpos+=3\n        elif st == 4:\n            v = int.from_bytes(payload[dpos:dpos+4],'big',signed=True); dpos+=4\n        elif st == 5:\n            v = int.from_bytes(payload[dpos:dpos+6],'big',signed=True); dpos+=6\n        elif st == 6:\n            v = int.from_bytes(payload[dpos:dpos+8],'big',signed=True); dpos+=8\n        elif st == 7:\n            v = struct.unpack('>d', payload[dpos:dpos+8])[0]; dpos+=8\n        elif st == 8:\n            v = 0\n        elif st == 9:\n            v = 1\n        elif st >= 12 and st % 2 == 0:\n            n = (st-12)//2; v = payload[dpos:dpos+n].decode('utf-8','replace'); dpos+=n\n        elif st >= 13 and st % 2 == 1:\n            n = (st-13)//2; v = payload[dpos:dpos+n].decode('utf-8','replace'); dpos+=n\n        else:\n            v = None\n        cols.append(v)\n    return cols\n\nresults = []\nfor p in ptrs:\n    pl, pos = rv(data, p)\n    rid, pos = rv(data, pos)\n    end = pos + pl\n    payload = data[pos:end]\n    cols = parse_record(payload)\n    word = next((c for c in cols if isinstance(c, str)), None)\n    value = next((c for c in cols if isinstance(c, (int,float)) and not isinstance(c, bool)), None)\n    if word is not None and value is not None:\n        results.append((rid, word, value))\n\nresults.sort()\nout = [{\"word\": w, \"value\": v} for _, w, v in results]\nwith open('/app/recover.json','w') as f:\n    json.dump(out, f, indent=2)\nprint('recovered', len(out))\nfor r in out:\n    print(r)\nPYEOF\n"]
