[168.99074, "i", "cat > /app/recover.py << 'PYEOF'\nimport struct, json\n\ndata = open('/app/trunc.db','rb').read()\n\ndef read_varint(buf, pos):\n    result = 0\n    for i in range(9):\n        b = buf[pos+i]\n        if i == 8:\n            result = (result << 8) | b\n            return result, pos+9\n        result = (result << 7) | (b & 0x7f)\n        if not (b & 0x80):\n            return result, pos+i+1\n    return result, pos+9\n\noff = 0\npage_type = data[off]\nncells = int.from_bytes(data[off+3:off+5],'big')\ncell_ptr_array = off + 8\npointers = [int.from_bytes(data[cell_ptr_array+2*i:cell_ptr_array+2*i+2],'big') for i in range(ncells)]\n\ndef parse_record(payload):\n    hdr_len, hpos = read_varint(payload, 0)\n    serial_types = []\n    idx = hpos\n    while idx < hdr_len:\n        st, idx = read_varint(payload, idx)\n        serial_types.append(st)\n    cols = []\n    dpos = hdr_len\n    for st in serial_types:\n        if st == 0:\n            cols.append(None); continue\n        elif st == 1:\n            v = int.from_bytes(payload[dpos:dpos+1],'big',signed=True); dpos+=1\n        elif st == 2:\n            v = int.from_bytes(payload[dpos:dpos+2],'big',signed=True); dpos+=2\n        elif st == 3:\n            v = int.from_bytes(payload[dpos:dpos+3],'big',signed=True); dpos+=3\n        elif st == 4:\n            v = int.from_bytes(payload[dpos:dpos+4],'big',signed=True); dpos+=4\n        elif st == 5:\n            v = int.from_bytes(payload[dpos:dpos+6],'big',signed=True); dpos+=6\n        elif st == 6:\n            v = int.from_bytes(payload[dpos:dpos+8],'big',signed=True); dpos+=8\n        elif st == 7:\n            v = struct.unpack('>d', payload[dpos:dpos+8])[0]; dpos+=8\n        elif st == 8:\n            v = 0\n        elif st == 9:\n            v = 1\n        elif st >= 12 and st % 2 == 0:\n            n = (st-12)//2\n            v = payload[dpos:dpos+n].decode('utf-8','replace'); dpos+=n\n        elif st >= 13 and st % 2 == 1:\n            n = (st-13)//2\n            v = payload[dpos:dpos+n]; dpos+=n\n        else:\n            v = None\n        cols.append(v)\n    return cols\n\nresults = []\nfor p in pointers:\n    pos = p\n    payload_len, pos = read_varint(data, pos)\n    rowid, pos = read_varint(data, pos)\n    end = pos + payload_len\n    if end > len(data):\n        continue\n    payload = data[pos:end]\n    try:\n        cols = parse_record(payload)\n    except Exception:\n        continue\n    word = None; value = None\n    for c in cols:\n        if isinstance(c, str) and word is None:\n            word = c\n        elif isinstance(c, (int,float)) and not isinstance(c,bool) and value is None:\n            value = c\n    if word is not None and value is not None:\n        results.append((rowid, word, value))\n\nresults.sort()\nout = [{\"word\": w, \"value\": v} for _, w, v in results]\nwith open('/app/recover.json','w') as f:\n    json.dump(out, f, indent=2)\nprint(\"recovered\", len(out))\nfor r in out:\n    print(r)\nPYEOF\n"]
