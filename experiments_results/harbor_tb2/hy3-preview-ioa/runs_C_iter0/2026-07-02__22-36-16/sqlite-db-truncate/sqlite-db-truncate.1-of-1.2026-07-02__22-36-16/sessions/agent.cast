[262.591656, "i", "cat > /app/dbg.py << 'PYEOF'\nimport struct\ndata = open('/app/trunc.db','rb').read()\nprint('len', len(data))\nprint('hdr', data[:8].hex())\nncells = int.from_bytes(data[3:5],'big')\nprint('ncells', ncells)\nptrs = [int.from_bytes(data[8+2*i:10+2*i],'big') for i in range(ncells)]\nprint('ptrs', [hex(p) for p in ptrs])\n\ndef rv(buf, pos):\n    r=0\n    for i in range(9):\n        b=buf[pos+i]\n        if i==8:\n            return (r<<8)|b, pos+9\n        r=(r<<7)|(b&0x7f)\n        if not (b&0x80):\n            return r, pos+i+1\n    return r, pos+9\n\nfor p in ptrs:\n    try:\n        pl, pos = rv(data, p)\n        rid, pos = rv(data, pos)\n        end = pos+pl\n        payload = data[pos:end]\n        print(hex(p), 'plen', pl, 'rowid', rid, 'end', hex(end), 'payload', payload.hex())\n    except Exception as e:\n        print(hex(p), 'ERR', e)\nPYEOF\npython3 /app/dbg.py\n"]
