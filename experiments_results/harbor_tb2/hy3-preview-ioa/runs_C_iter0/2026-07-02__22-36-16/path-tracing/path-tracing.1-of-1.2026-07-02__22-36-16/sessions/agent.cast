[458.153581, "o", "\u001b[?2004l\r\u001b[?2004h> b = np.array(Image.open('/app/reconstructed.ppm')).astype(np.float64)\r\n\u001b[?2004l\r\u001b[?2004h> l2 = np.sqrt(((a-b)**2).sum())\r\n\u001b[?2004l\r\u001b[?2004h> norm = np.sqrt((a**2).sum())\r\n\u001b[?2004l\r\u001b[?2004h> print('sim_L2 (1-||a-b||/||a||) =', 1 - l2/norm)\r\n\u001b[?2004l\r\u001b[?2004h> an = a.reshape(-1); bn = b.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> print('cosine =', an.dot(bn)/(np.linalg.norm(an)*np.linalg.norm(bn)))\r\n\u001b[?2004l\r\u001b[?2004h> print('mse =', ((a-b)**2).mean())\r\n\u001b[?2004l\r\u001b[?2004h> print('max abs diff =', np.abs(a-b).max())\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
