[457.221007, "i", "cat > /app/image.c << 'EOF'\n#include <stdio.h>\n#include <stdlib.h>\n\nstatic long g_pos = 0;\nstatic int next_int(const unsigned char *buf, long sz){\n    while(g_pos < sz && (buf[g_pos] < '0' || buf[g_pos] > '9')) g_pos++;\n    int v = 0;\n    while(g_pos < sz){\n        unsigned char c = buf[g_pos];\n        if(c >= '0' && c <= '9'){ v = v*10 + (c-'0'); g_pos++; }\n        else break;\n    }\n    return v;\n}\n\nint main(void){\n    FILE *f = fopen(\"high_res.ppm\", \"rb\");\n    if(!f){ fprintf(stderr, \"open fail: high_res.ppm\\n\"); return 1; }\n    fseek(f, 0, SEEK_END);\n    long sz = ftell(f);\n    fseek(f, 0, SEEK_SET);\n    unsigned char *buf = (unsigned char*)malloc((size_t)sz);\n    if(!buf){ fclose(f); return 1; }\n    if(fread(buf, 1, (size_t)sz, f) != (size_t)sz){ fprintf(stderr, \"read fail\\n\"); return 1; }\n    fclose(f);\n\n    int magic = next_int(buf, sz);\n    int W = next_int(buf, sz);\n    int H = next_int(buf, sz);\n    int maxv = next_int(buf, sz);\n    (void)magic; (void)maxv;\n\n    int OW = 800, OH = 600;\n    long long *sum = (long long*)calloc((long)OW*OH*3, sizeof(long long));\n    int *cnt = (int*)calloc((long)OW*OH, sizeof(int));\n    if(!sum || !cnt){ free(buf); return 1; }\n\n    long total = (long)W * H;\n    for(long i = 0; i < total; i++){\n        int r = next_int(buf, sz);\n        int g = next_int(buf, sz);\n        int b = next_int(buf, sz);\n        int sx = (int)(i % W);\n        int sy = (int)(i / W);\n        int ox = (sx * OW) / W;\n        int oy = (sy * OH) / H;\n        long o = (long)oy * OW + ox;\n        sum[o*3]   += r;\n        sum[o*3+1] += g;\n        sum[o*3+2] += b;\n        cnt[o]++;\n    }\n    free(buf);\n\n    FILE *out = fopen(\"reconstructed.ppm\", \"wb\");\n    if(!out){ fprintf(stderr, \"out fail\\n\"); return 1; }\n    fprintf(out, \"P6\\n%d %d\\n255\\n\", OW, OH);\n    unsigned char *row = (unsigned char*)malloc((size_t)OW*3);\n    for(int y = 0; y < OH; y++){\n        for(int x = 0; x < OW; x++){\n            long o = (long)y*OW + x;\n            int c = cnt[o] > 0 ? cnt[o] : 1;\n            row[x*3+0] = (unsigned char)(sum[o*3]/c);\n            row[x*3+1] = (unsigned char)(sum[o*3+1]/c);\n            row[x*3+2] = (unsigned char)(sum[o*3+2]/c);\n        }\n        fwrite(row, 1, (size_t)OW*3, out);\n    }\n    free(row);\n    free(sum);\n    free(cnt);\n    fclose(out);\n    return 0;\n}\nEOF\necho written\n"]
[458.01613, "o", "cat > /app/image.c << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static long g_pos = 0;\r\n\u001b[?2004l\r\u001b[?2004h> static int next_int(const unsigned char *buf, long sz){\r\n\u001b[?2004l\r\u001b[?2004h>     while(g_pos < sz && (buf[g_pos] < '0' || buf[g_pos] > '9')) g_pos++;\r\n\u001b[?2004l\r\u001b[?2004h>     int v = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     while(g_pos < sz){\r\n\u001b[?2004l\r\u001b[?2004h>         unsigned char c = buf[g_pos];\r\n\u001b[?2004l\r\u001b[?2004h>         if(c >= '0' && c <= '9'){ v = v*10 + (c-'0'); g_pos++; }\r\n\u001b[?2004l\r\u001b[?2004h>         else break;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return v;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main(void){\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *f = fopen(\"high_res.ppm\", \"rb\");\r\n\u001b[?2004l\r\u001b[?2004h>     if(!f){ fprintf(stderr, \"open fail: high_res.ppm\\n\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     fseek(f, 0, SEEK_END);\r\n\u001b[?2004l\r\u001b[?2004h>     long sz = ftell(f);\r\n\u001b[?2004l\r\u001b[?2004h>     fseek(f, 0, SEEK_SET);\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned char *buf = (unsigned char*)malloc((size_t)sz);\r\n\u001b[?2004l\r\u001b[?2004h>     if(!buf){ fclose(f); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     if(fread(buf, 1, (size_t)sz, f) != (size_t)sz){ fprintf(stderr, \"read fail\\n\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int magic = next_int(buf, sz);\r\n\u001b[?2004l\r\u001b[?2004h>     int W = next_int(buf, sz);\r\n\u001b[?2004l\r\u001b[?2004h>     int H = next_int(buf, sz);\r\n\u001b[?2004l\r\u001b[?2004h>     int maxv = next_int(buf, sz);\r\n\u001b[?2004l\r\u001b[?2004h>     (void)magic; (void)maxv;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int OW = 800, OH = 600;\r\n\u001b[?2004l\r\u001b[?2004h>     long long *sum = (long long*)calloc((long)OW*OH*3, sizeof(long long));\r\n\u001b[?2004l\r\u001b[?2004h>     int *cnt = (int*)calloc((long)OW*OH, sizeof(int));\r\n\u001b[?2004l\r\u001b[?2004h>     if(!sum || !cnt){ free(buf); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     long total = (long)W * H;\r\n\u001b[?2004l\r\u001b[?2004h>     for(long i = 0; i < total; i++){\r\n\u001b[?2004l\r\u001b[?2004h>         int r = next_int(buf, sz);\r\n\u001b[?2004l\r\u001b[?2004h>         int g = next_int(buf, sz);\r\n\u001b[?2004l\r\u001b[?2004h>         int b = next_int(buf, sz);\r\n\u001b[?2004l\r\u001b[?2004h>         int sx = (int)(i % W);\r\n\u001b[?2004l\r\u001b[?2004h>         int sy = (int)(i / W);\r\n\u001b[?2004l\r\u001b[?2004h>         int ox = (sx * OW) / W;\r\n\u001b[?2004l\r\u001b[?2004h>         int oy = (sy * OH) / H;\r\n\u001b[?2004l\r\u001b[?2004h>         long o = (long)oy * OW + ox;\r\n\u001b[?2004l\r\u001b[?2004h>         sum[o*3]   += r;\r\n\u001b[?2004l\r\u001b[?2004h>         sum[o*3+1] += g;\r\n\u001b[?2004l\r\u001b[?2004h>         sum[o*3+2] += b;\r\n\u001b[?2004l\r\u001b[?2004h>         cnt[o]++;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     free(buf);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     FILE *out = fopen(\"reconstructed.ppm\", \"wb\");\r\n\u001b[?2004l\r\u001b[?2004h>     if(!out){ fprintf(stderr, \"out fail\\n\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     fprintf(out, \"P6\\n%d %d\\n255\\n\", OW, OH);\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned char *row = (unsigned char*)malloc((size_t)OW*3);\r\n\u001b[?2004l\r\u001b[?2004h>     for(int y = 0; y < OH; y++){\r\n\u001b[?2004l\r\u001b[?2004h>         for(int x = 0; x < OW; x++){\r\n\u001b[?2004l\r\u001b[?2004h>             long o = (long)y*OW + x;\r\n\u001b[?2004l\r\u001b[?2004h>             int c = cnt[o] > 0 ? cnt[o] : 1;\r\n\u001b[?2004l\r\u001b[?2004h>             row[x*3+0] = (unsigned char)(sum[o*3]/c);\r\n\u001b[?2004l\r\u001b[?2004h>             row[x*3+1] = (unsigned char)(sum[o*3+1]/c);\r\n\u001b[?2004l\r\u001b[?2004h>             row[x*3+2] = (unsigned char)(sum[o*3+2]/c);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         fwrite(row, 1, (size_t)OW*3, out);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     free(row);\r\n\u001b[?2004l\r\u001b[?2004h>     free(sum);\r\n\u001b[?2004l\r\u001b[?2004h>     free(cnt);\r\n\u001b[?2004l\r\u001b[?2004h>     fclose(out);\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
