[107.050598, "i", "cat > /tmp/analyze.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nimg = np.array(Image.open('image.ppm'))\nprint('shape', img.shape, 'dtype', img.dtype)\nprint('min', img.min(0).min(0), 'max', img.max(0).max(0))\nprint('first pixel', img[0,0])\nprint('top-left 3x3:')\nprint(img[:3,:3])\n# check row gradient: difference between adjacent pixels\nprint('mean', img.reshape(-1,3).mean(0))\n# sample a horizontal line and vertical line\nmid = img[300]\nprint('row300 sample', img[300,::80])\nprint('col400 sample', img[::75,400])\nEOF\n.venv/bin/python /tmp/analyze.py\n"]
