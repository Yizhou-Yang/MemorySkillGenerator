[458.141315, "i", "cat > /tmp/check.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\na = np.array(Image.open('/app/image.ppm')).astype(np.float64)\nb = np.array(Image.open('/app/reconstructed.ppm')).astype(np.float64)\nl2 = np.sqrt(((a-b)**2).sum())\nnorm = np.sqrt((a**2).sum())\nprint('sim_L2 (1-||a-b||/||a||) =', 1 - l2/norm)\nan = a.reshape(-1); bn = b.reshape(-1)\nprint('cosine =', an.dot(bn)/(np.linalg.norm(an)*np.linalg.norm(bn)))\nprint('mse =', ((a-b)**2).mean())\nprint('max abs diff =', np.abs(a-b).max())\nEOF\necho written\n"]
