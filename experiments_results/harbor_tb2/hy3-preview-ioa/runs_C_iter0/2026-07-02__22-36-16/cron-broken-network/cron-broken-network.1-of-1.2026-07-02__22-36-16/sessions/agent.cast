[540.314396, "i", "cat > /usr/local/bin/curl << 'PYEOF'\n#!/usr/bin/env python3\nimport sys, urllib.request, urllib.error, ssl\n\ndef main():\n    args = sys.argv[1:]\n    verbose = False; silent = False; head = False; output = None; url = None\n    headers = []\n    if any(a in ('--version','-V') for a in args):\n        print('curl 8.x-replacement (python urllib wrapper)'); return 0\n    i = 0\n    while i < len(args):\n        a = args[i]\n        if a == '-v': verbose = True\n        elif a == '-s': silent = True\n        elif a in ('-I','--head'): head = True\n        elif a == '-o': i += 1; output = args[i]\n        elif a == '-L': pass\n        elif a == '-X': i += 1\n        elif a.startswith('-H'):\n            h = a[2:] if a != '-H' else args[i+1]\n            if a == '-H': i += 1\n            if ':' in h: headers.append(h)\n        elif a.startswith('-'):\n            pass\n        else:\n            url = a\n        i += 1\n    if not url:\n        sys.stderr.write('curl: try \\'curl --help\\' for more\\n'); return 2\n    req = urllib.request.Request(url, method=('HEAD' if head else 'GET'))\n    for h in headers:\n        k, v = h.split(':', 1); req.add_header(k.strip(), v.strip())\n    try:\n        resp = urllib.request.urlopen(req, timeout=30)\n        if verbose or head:\n            sys.stderr.write('HTTP/%s %s %s\\n' % (resp.version//10, resp.status, resp.reason))\n            for kk, vv in resp.getheaders():\n                sys.stderr.write('%s: %s\\n' % (kk, vv))\n            sys.stderr.write('\\n')\n        data = resp.read() if not head else b''\n        if output:\n            with open(output, 'wb') as f: f.write(data)\n        elif not silent:\n            sys.stdout.buffer.write(data)\n        return 0\n    except urllib.error.HTTPError as e:\n        sys.stderr.write('HTTP error %s: %s\\n' % (e.code, e.reason)); return 22\n    except Exception as e:\n        sys.stderr.write('curl: (%s) %s\\n' % (type(e).__name__, e)); return 6\n\nif __name__ == '__main__':\n    sys.exit(main())\nPYEOF\n"]
