[730.497292, "i", "         headers.append(a[2:])\n        else:\n            url = a\n        i += 1\n    if not url:\n        print(\"curl: try 'curl --help' for more\", file=sys.stderr)\n        return 2\n    if '://' not in url:\n        url = 'http://' + url\n    req = urllib.request.Request(url, method=('HEAD' if head else 'GET'))\n    for h in headers:\n        k, v = h.split(':', 1)\n        req.add_header(k.strip(), v.strip())\n    status = '000'\n    try:\n        resp = urllib.request.urlopen(req, timeout=30)\n        status = str(resp.status)\n        if verbose or head:\n            print('HTTP/%s %s %s' % (resp.version // 10, resp.status, resp.reason), file=sys.stderr)\n            for kk, vv in resp.getheaders():\n                print('%s: %s' % (kk, vv), file=sys.stderr)\n        data = b'' if head else resp.read()\n        if output:\n            open(output, 'wb').write(data)\n        elif not silent:\n            sys.stdout.buffer.write(data)\n        if writeout is not None:\n            sys.stdout.write(writeout.replace('%{http_code}', status))\n        return 0\n    except urllib.error.HTTPError as e:\n        status = str(e.code)\n        if writeout is not None:\n            sys.stdout.write(writeout.replace('%{http_code}', status))\n        print('HTTP error %s: %s' % (e.code, e.reason), file=sys.stderr)\n        return 22\n    except Exception as e:\n        if writeout is not None:\n            sys.stdout.write(writeout.replace('%{http_code}', '000'))\n        print('curl: (%s) %s' % (type(e).__name__, e), file=sys.stderr)\n        return 6\n\nif __name__ == '__main__':\n    sys.exit(main())\nPYEOF\n"]
