[15.61529, "o", "---\r\n"]
[15.616606, "o", "date,temperature\r\r\n04/19/2025 06:00:00,48\r\r\n04/20/2025 06:00:00,52\r\r\n04-23-2025 06:00:00,52\r\r\n04-22-2025 06:00:00,48\r\r\n04-24-2025 06:00:00,52\r\r\n04-21-2025 06:00:00,48\r\r\n04-25-2025 06:00:00,52"]
[15.616846, "m", "Episode 2: 2 commands"]
[15.616846, "o", "\u001b[?2004hroot@ffd6d263a0bc:/app# "]
[26.948938, "i", "python3 -c \"\nimport csv, datetime\n\ndef parse_date(s):\n    s=s.split()[0]\n    for fmt in ('%Y-%m-%d','%m/%d/%Y','%m-%d-%Y'):\n        try: return datetime.datetime.strptime(s,fmt).date()\n        except: pass\n    raise ValueError(s)\n\nhigh={}; low={}\nwith open('daily_temp_sf_high.csv') as f:\n    r=csv.reader(f); next(r)\n    for d,t in r:\n        if d.strip(): high[parse_date(d)]=float(t)\nwith open('daily_temp_sf_low.csv') as f:\n    r=csv.reader(f); next(r)\n    for d,t in r:\n        if d.strip(): low[parse_date(d)]=float(t)\n\ndiffs=[high[d]-low[d] for d in high if d in low]\navg=sum(diffs)/len(diffs)\nwith open('avg_temp.txt','w') as f: f.write(str(avg))\nprint('avg=',avg,'n=',len(diffs))\n\"\n"]
