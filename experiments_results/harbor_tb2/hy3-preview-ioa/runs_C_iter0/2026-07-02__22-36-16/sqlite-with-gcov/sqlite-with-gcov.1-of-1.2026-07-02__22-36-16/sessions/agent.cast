[437.475114, "i", "cat > /tmp/getsqlite.py << 'EOF'\nimport urllib.request, sys\nurls = [\n  'https://www.sqlite.org/2024/sqlite-autoconf-3460100.tar.gz',\n  'https://www.sqlite.org/2024/sqlite-amalgamation-3460100.zip',\n]\nfor u in urls:\n    try:\n        req = urllib.request.Request(u, headers={'User-Agent':'Mozilla/5.0'})\n        with urllib.request.urlopen(req, timeout=60) as r:\n            data = r.read()\n        fn = '/tmp/' + u.rsplit('/',1)[-1]\n        open(fn,'wb').write(data)\n        print('OK', fn, len(data))\n        break\n    except Exception as e:\n        print('FAIL', u, e)\nEOF\npython3 /tmp/getsqlite.py\n"]
[437.475454, "o", "cat > /tmp/getsqlite.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
