[437.477991, "o", "  'https://www.sqlite.org/2024/sqlite-autoconf-3460100.tar.gz',\r\n\u001b[?2004l\r\u001b[?2004h>   'https://www.sqlite.org/2024/sqlite-amalgamation-3460100.zip',\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> for u in urls:\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         req = urllib.request.Request(u, headers={'User-Agent':'Mozilla/5.0'})\r\n\u001b[?2004l\r\u001b[?2004h>         with urllib.request.urlopen(req, timeout=60) as r:\r\n\u001b[?2004l\r\u001b[?2004h>             data = r.read()\r\n\u001b[?2004l\r\u001b[?2004h>         fn = '/tmp/' + u.rsplit('/',1)[-1]\r\n\u001b[?2004l\r"]
[437.478653, "o", "\u001b[?2004h>         open(fn,'wb').write(data)\r\n\u001b[?2004l\r\u001b[?2004h>         print('OK', fn, len(data))\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print('FAIL', u, e)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
