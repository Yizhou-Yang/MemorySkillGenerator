[213.017769, "o", "\u001b[?2004hroot@05e51a37be6c:/app# "]
[553.737585, "i", "cat > /app/peaks.py << 'EOF'\nimport numpy as np\nraw = open('/app/graphene.dat','rb').read().decode('latin-1')\nlines=[l for l in raw.replace('\\r','').split('\\n') if l.strip() and not l.startswith('#') and 'SKIPRAMAN' not in l]\nxs=[]; ys=[]\nfor l in lines:\n    p=l.replace(',','.').split()\n    if len(p)>=2:\n        xs.append(float(p[0])); ys.append(float(p[1]))\nx=np.array(xs); y=np.array(ys)\n# local maxima\nloc=np.where((y[1:-1]>y[:-2])&(y[1:-1]>y[2:]))[0]+1\norder=loc[np.argsort(y[loc])[::-1]]\nprint('Top 20 local maxima:')\nfor i in order[:20]:\n    print(f'  x={x[i]:.2f}  y={y[i]:.2f}  idx={i}')\nprint('\\nWindow 1500-1700:')\nm=(x>1500)&(x<1700)\nif m.any():\n    a=np.where(m)[0]\n    for i in a[::max(1,len(a)//20)]:\n        print(f'  x={x[i]:.2f} y={y[i]:.2f}')\nprint('\\nWindow 2600-2800:')\nm=(x>2600)&(x<2800)\nif m.any():\n    a=np.where(m)[0]\n    for i in a[::max(1,len(a)//20)]:\n        print(f'  x={x[i]:.2f} y={y[i]:.2f}')\nEOF\npython3 /app/peaks.py\n"]
