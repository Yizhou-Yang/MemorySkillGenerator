[212.713245, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\n\ndef load(path):\n    raw = open(path, 'rb').read()\n    txt = raw.decode('latin-1')\n    lines = [ln for ln in txt.replace('\\r','').split('\\n') if ln.strip()]\n    # try to drop any SKIPRAMAN header\n    start = 0\n    while start < len(lines) and (lines[start].startswith('#') or 'SKIPRAMAN' in lines[start]):\n        start += 1\n    xs, ys = [], []\n    for ln in lines[start:]:\n        parts = ln.replace(',', '.').split()\n        if len(parts) >= 2:\n            try:\n                xs.append(float(parts[0])); ys.append(float(parts[1]))\n            except: pass\n    return np.array(xs), np.array(ys)\n\nx, y = load('/app/graphene.dat')\nprint('n=', len(x))\nprint('xmin,xmax=', x.min(), x.max())\nprint('ymin,ymax=', y.min(), y.max())\nprint('first x', x[:5])\nprint('last x', x[-5:])\n# find peaks near target wavenumbers\nfor tgt in (1580, 2700):\n    i = np.argmin(np.abs(x - tgt))\n    print('target', tgt, '-> x=', round(x[i],2), 'y='"]
