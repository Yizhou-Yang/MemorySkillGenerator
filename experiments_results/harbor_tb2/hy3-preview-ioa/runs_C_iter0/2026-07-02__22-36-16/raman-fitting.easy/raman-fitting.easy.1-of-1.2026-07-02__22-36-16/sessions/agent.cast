[553.74097, "o", "m=(x>2600)&(x<2800)\r\n\u001b[?2004l\r\u001b[?2004h> if m.any():\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.74102, "o", "> "]
[553.741045, "o", "    a=np.where(m)[0]\r\n\u001b[?2004l\r"]
[553.741057, "o", "\u001b[?2004h"]
[553.741134, "o", "> "]
[553.741193, "o", "    for i in a[::max(1,len(a)//20)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.741203, "o", "> "]
[553.741352, "o", "        print(f'  x={x[i]:.2f} y={y[i]:.2f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
