[104.83325, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     print(report)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
