[104.799271, "i", "*5\", rating_raw)\n        rating = float(m.group(1)) if m else None\n\n        m = re.search(r\"\\$?\\s*([0-9]*\\.?[0-9]+)\", price_raw)\n        price = float(m.group(1)) if m else None\n\n        books.append({\n            \"title\": title,\n            \"author\": author,\n            \"year\": year,\n            \"rating\": rating,\n            \"price\": price,\n        })\n\n    df = pd.DataFrame(books, columns=[\"title\", \"author\", \"year\", \"rating\", \"price\"])\n    df.to_csv(\"books.csv\", index=False)\n\n    total = len(df)\n    avg_price = df[\"price\"].mean()\n    top = df.loc[df[\"rating\"].idxmax()]\n\n    report = (\n        \"Book Store Scraping Summary Report\\n\"\n        \"=================================\\n\\n\"\n        f\"Total number of books scraped: {total}\\n\"\n        f\"Average book price: ${avg_price:.2f}\\n\"\n        f\"Highest rated book: {top['title']} by {top['author']} \"\n        f\"(Rating: {top['rating']}/5, Price: ${top['price']:.2f})\\n\"\n    )\n    with open(\"report.txt\", \"w\") as f:\n        f.write(report)\n\n    print(report)\n\n\nif __name"]
[104.803437, "o", "*5\", rating_raw)\r\n        rating = float(m.group(1)) if m else None\r\n\r\n        m = re.search(r\"\\$?\\s*([0-9]*\\.?[0-9]+)\", price_raw)\r\n        price = float(m.group(1)) if m else None\r\n\r\n        books.append({\r\n            \"title\": title,\r\n            \"author\": author,\r\n            \"year\": year,\r\n            \"rating\": rating,\r\n            \"price\": price,\r\n        })\r\n\r\n    df = pd.DataFrame(books, columns=[\"title\", \"author\", \"year\", \"rating\", \"price\"])\r\n    df.to_csv(\"books.csv\", index=False)\r\n\r\n    total = len(df)\r\n    avg_price = df[\"price\"].mean()\r\n    top = df.loc[df[\"rating\"].idxmax()]\r\n\r\n    report = (\r\n        \"Book Store Scraping Summary Report\\n\"\r\n        \"=================================\\n\\n\"\r\n        f\"Total number of books scraped: {total}\\n\"\r\n        f\"Average book price: ${avg_price:.2f}\\n\"\r\n        f\"Highest rated book: {top['title']} by {top['author']} \"\r\n        f\"(Rating: {top['rating']}/5, Price: ${top['price']:.2f})\\n\"\r\n    )\r\n    with open(\"report.txt\", \"w\") as f:\r\n        f.write(report)\r"]
