[104.782322, "i", "cat > /app/scraper.py << 'EOF'\nimport re\nimport requests\nfrom bs4 import BeautifulSoup\nimport pandas as pd\n\nURL = \"http://server:8000\"\n\n\ndef parse_text(el, default=\"\"):\n    return el.get_text(strip=True) if el else default\n\n\ndef main():\n    resp = requests.get(URL, timeout=15)\n    resp.raise_for_status()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n\n    books = []\n    for book in soup.find_all(\"div\", class_=\"book\"):\n        title = parse_text(book.find(\"div\", class_=\"book-title\"))\n        author_raw = parse_text(book.find(\"div\", class_=\"book-author\"))\n        author = re.sub(r\"^by\\s+\", \"\", author_raw).strip()\n\n        year_raw = parse_text(book.find(\"span\", class_=\"book-year\"))\n        rating_raw = parse_text(book.find(\"span\", class_=\"book-rating\"))\n        price_raw = parse_text(book.find(\"span\", class_=\"book-price\"))\n\n        m = re.search(r\"(\\d{4})\", year_raw)\n        year = int(m.group(1)) if m else None\n\n        m = re.search(r\"([0-9]*\\.?[0-9]+)\\s*/\\s"]
[104.784263, "o", "cat > /app/scraper.py << 'EOF'"]
