[250.352946, "o", "  --bg:#f7f8fa; --surface:#ffffff; --ink:#1f2933; --muted:#5b6b7b;"]
[250.353144, "o", "\r\n"]
[250.353258, "o", "\u001b[?2004l\r"]
[250.353563, "o", "\u001b[?2004h>   --accent:#2c5282; --accent-2:#3182ce; --border:#e3e8ee; --maxw:980px;"]
[250.353625, "o", "\r\n"]
[250.353689, "i", ".hero{background:linear-gradient(135deg,#2c5282,#3182ce);color:#fff;padding:64px 0 56px;}\n.hero h1{margin:0 0 6px;font-size:2.4rem;}\n.hero .subtitle{margin:0;font-size:1.15rem;opacity:.95;}\n.hero .affiliation{margin:4px 0 18px;opacity:.85;}\n.hero .tagline{max-width:680px;opacity:.92;}\nmain.container{padding-top:32px;padding-bottom:48px;}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px 28px;margin-bottom:22px;box-shadow:0 1px 2px rgba(0,0,0,.03);}\n.card h2{margin-top:0;color:var(--accent);font-size:1.3rem;border-bottom:2px solid var(--border);padding-bottom:8px;}\nh3{color:var(--ink);}\n.timeline{list-style:none;padding-left:0;}\n.timeline li{margin-bottom:14px;}\n.timeline span{color:var(--muted);font-size:.92rem;display:block;margin-top:2px;}\n.skills{display:flex;flex-wrap:wrap;gap:10px;}\n.skills span{background:#eef3f9;color:var(--accent);border-radius:999px;padding:6px 12px;font-size:.85rem;font-weight:500;}\n.post{display:block;text-decoration:none;color:inherit;border:1px solid var(--border);border-radius:10px;padding:18px 20px;margin-bottom:16px;transition:.15s;}\n.post:hover{border-color:var(--accent-2);box-shadow:0 2px 8px rgba(49,130,206,.12);}\n.post h3{margin:0 0 4px;}\n.post .date{color:var(--muted);font-size:.85rem;}\n.pub{margin-bottom:18px;padding-left:18px;border-left:3px solid var(--accent);}\n.pub .title{font-weight:600;}\n.pub .meta{color:var(--muted);font-size:.9rem;}\n.contact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;}\n.contact-grid div{background:#f3f6fa;border-radius:10px;padding:14px;}\n.contact-grid strong{display:block;color:var(--accent);margin-bottom:4px;}\n.site-footer{background:var(--surface);border-top:1px solid var(--border);padding:22px 0;color:var(--muted);font-size:.88rem;text-align:center;}\na{color:var(--accent-2);}\n@media(max-width:640px){.hero h1{font-size:1.9rem;}.nav-links{gap:14px;}}\nEOF\n"]
