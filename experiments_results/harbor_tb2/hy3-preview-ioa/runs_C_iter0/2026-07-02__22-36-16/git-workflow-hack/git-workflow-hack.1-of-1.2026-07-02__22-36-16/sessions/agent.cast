[250.569472, "i", "cat > /app/my_website/public/index.html << 'EOF'\n<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='UTF-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1.0'>\n<title>Dr. Lydia Moreno — Research Profile</title>\n<link rel='stylesheet' href='css/style.css'>\n</head>\n<body>\n<header class='site-header'>\n  <nav class='nav'>\n    <a href='index.html' class='brand'>Lydia Moreno, Ph.D.</a>\n    <ul class='nav-links'>\n      <li><a href='index.html'>About Me</a></li>\n      <li><a href='blog.html'>Blog</a></li>\n      <li><a href='publications.html'>Publications</a></li>\n    </ul>\n  </nav>\n</header>\n<section class='hero'>\n  <div class='container'>\n    <h1>Dr. Lydia Moreno</h1>\n    <p class='subtitle'>Associate Professor of Computational Neuroscience</p>\n    <p class='affiliation'>Riverbend University · School of Biological Sciences</p>\n    <p class='tagline'>Bridging machine learning, systems neuroscience and bioinformatics to understand how neural circuits encode complex sensory information.</p>\n  </div>\n</section>\n<main class='container'>\n  <section class='card'>\n    <h2>About</h2>\n    <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University's School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n  </section>\n  <section class='card'>\n    <h2>Education</h2>\n    <ul class='timeline'>\n      <li><strong>Ph.D., Computational Biology</strong> — Baywood Institute of Technology, 2014–2019<span>Dissertation: Deep Learning Models for Decoding Neural Population Activity</span></li>\n      <li><strong>M.Sc., Bioinformatics</strong> — Riverbend University, 2012–2014<span>Thesis: Statistical Methods for Single-Cell RNA-Seq Analysis</span></li>\n      <li><strong>B.Sc., Computer Science</strong> — Crestfield College of Engineering, 2008–2012<span>Graduated magna cum laude; President, Data Science Club</span></li>\n    </ul>\n  </section>\n  <section class='card'>\n    <h2>Research Interests</h2>\n    <ul>\n      <li><strong>Neural Encoding &amp; Decoding</strong> — interpretable models that translate spike-train data into behavioral predictions.</li>\n      <li><strong>Machine Learning for Biomedical Imaging</strong> — CNNs and GNNs applied to MRI and two-photon microscopy.</li>\n      <li><strong>Single-Cell Omics</strong> — scalable pipelines integrating multi-modal single-cell genomics and spatial transcriptomics.</li>\n      <li><strong>Explainable AI in Neuroscience</strong> — probing decision boundaries and feature attributions in black-box models.</li>\n    </ul>\n  </section>\n  <section class='card'>\n    <h2>Selected Projects</h2>\n    <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\n    <p><em>Lead Developer &amp; Project Coordinator.</em> A PyTorch-based pipeline to segment two-photon images of mouse visual cortex, with temporal convolutional networks predicting stimulus orientation, deployed as a Dockerized microservice with Cascade Imaging Lab.</p>\n    <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\n    <p><em>Principal Investigator.</em> Graph representations of reconstructed neuron meshes from EM, GNNs to classify synapse types, and an open-source toolkit adopted by 12 labs worldwide.</p>\n    <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\n    <p><em>Co-Principal Investigator.</em> A Nextflow workflow combining scRNA-Seq, ATAC-Seq and spatial FISH, with Bayesian clustering presented at ICSCG 2023.</p>\n  </section>\n  <section class='card'>\n    <h2>Teaching &amp; Mentorship</h2>\n    <ul>\n      <li>Undergraduate Course: Introduction to Computational Neuroscience (Spring 2025)</li>\n      <li>Graduate Seminar: Advanced Machine Learning Methods in Biology (Fall 2024)</li>\n      <li>Mentorshi"]
[250.569531, "i", "p: supervised 8 Ph.D. students and 12 Master's theses.</li>\n    </ul>\n  </section>\n  <section class='card'>\n    <h2>Skills &amp; Tools</h2>\n    <div class='skills'>\n      <span>Python</span><span>R</span><span>C++</span><span>PyTorch</span><span>TensorFlow</span><span>scikit-learn</span><span>NetworkX</span><span>Nextflow</span><span>Snakemake</span><span>Docker</span><span>Kubernetes</span><span>Seurat</span><span>Scanpy</span><span>D3.js</span><span>Plotly</span>\n    </div>\n  </section>\n  <section class='card'>\n    <h2>Contact</h2>\n    <div class='contact-grid'>\n      <div><strong>Email</strong>lydia.moreno@riverbend.edu</div>\n      <div><strong>Office</strong>Blakely Hall, Room 312</div>\n      <div><strong>Twitter</strong><a href='https://twitter.com/LydiaNeuroLab'>@LydiaNeuroLab</a></div>\n      <div><strong>GitHub</strong><a href='https://github.com/lydia-moreno'>lydia-moreno</a></div>\n    </div>\n  </section>\n</main>\n<footer class='site-footer'>\n  <div class='container'><p>© 2025 Dr. Lydia Moreno · Research Profile</p></div>\n</footer>\n</body>\n</html>\nEOF\n"]
