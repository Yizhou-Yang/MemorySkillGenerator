[251.127481, "i", "cat > /app/my_website/public/publications.html << 'EOF'\n<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='UTF-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1.0'>\n<title>Publications — Dr. Lydia Moreno</title>\n<link rel='stylesheet' href='css/style.css'>\n</head>\n<body>\n<header class='site-header'>\n  <nav class='nav'>\n    <a href='index.html' class='brand'>Lydia Moreno, Ph.D.</a>\n    <ul class='nav-links'>\n      <li><a href='index.html'>About Me</a></li>\n      <li><a href='blog.html'>Blog</a></li>\n      <li><a href='publications.html'>Publications</a></li>\n    </ul>\n  </nav>\n</header>\n<main class='container'>\n  <section class='card'>\n    <h2>Selected Publications</h2>\n    <div class='pub'>\n      <div class='title'>Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals</div>\n      <div class='meta'>Moreno, L., &amp; Patel, A. (2024). <em>Journal of Computational Neuroscience</em>, 45(2), 123–137.</div>\n    </div>\n    <div class='pub'>\n      <div class='title'>Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets</div>\n      <div class='meta'>Moreno, L., Zhang, W., &amp; Singh, R. (2023). <em>Neuroinformatics</em>, 21(4), 299–312.</div>\n    </div>\n    <div class='pub'>\n      <div class='title'>Integrative Single-Cell Atlas of Human Cerebral Organoids</div>\n      <div class='meta'>Moreno, L. et al. (2022). <em>Cell Systems</em>, 9(1), 67–82.</div>\n    </div>\n    <div class='pub'>\n      <div class='title'>Explainable AI Techniques in Neural Decoding</div>\n      <div class='meta'>Chen, J., Moreno, L., &amp; Russo, M. (2021). <em>Frontiers in Neuroscience</em>, 15, 756843.</div>\n    </div>\n  </section>\n</main>\n<footer class='site-footer'>\n  <div class='container'><p>© 2025 Dr. Lydia Moreno · Research Profile</p></div>\n</footer>\n</body>\n</html>\nEOF\n"]
