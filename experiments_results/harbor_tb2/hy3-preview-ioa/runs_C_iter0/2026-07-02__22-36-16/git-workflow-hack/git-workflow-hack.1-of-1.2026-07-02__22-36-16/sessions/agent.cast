[250.898766, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> </head>\r\n\u001b[?2004l\r\u001b[?2004h> <body>\r\n\u001b[?2004l\r\u001b[?2004h> <header class='site-header'>\r\n\u001b[?2004l\r\u001b[?2004h>   <nav class='nav'>\r\n\u001b[?2004l\r\u001b[?2004h>     <a href='index.html' class='brand'>Lydia Moreno, Ph.D.</a>\r\n\u001b[?2004l\r\u001b[?2004h>     <ul class='nav-links'>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><a href='index.html'>About Me</a></li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><a href='blog.html'>Blog</a></li>\r\n\u001b[?2004l\r\u001b[?2004h>       <li><a href='publications.html'>Publications</a></li>\r\n\u001b[?2004l\r\u001b[?2004h>     </ul>\r\n\u001b[?2004l\r\u001b[?2004h>   </nav>\r\n\u001b[?2004l\r\u001b[?2004h> </header>\r\n\u001b[?2004l\r\u001b[?2004h> <main class='container'>\r\n\u001b[?2004l\r\u001b[?2004h>   <section class='card'>\r\n\u001b[?2004l\r\u001b[?2004h>     <h2>Blog</h2>\r\n\u001b[?2004l\r\u001b[?2004h>     <p>Notes and reflections on computational neuroscience, machine learning and single-cell biology.</p>\r\n\u001b[?2004l\r\u001b[?2004h>   </section>\r\n\u001b[?2004l\r\u001b[?2004h>   <a class='post' href='#'>\r\n\u001b[?2004l\r\u001b[?2004h>     <span class='date'>March 2025</span>\r\n\u001b[?2004l\r\u001b[?2004h>     <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[250.917508, "o", "    <p>How we move from black-box decoders to models whose decision boundaries we can inspect and trust.</p>\r\n\u001b[?2004l\r\u001b[?2004h>   </a>\r\n\u001b[?2004l\r\u001b[?2004h>   <a class='post' href='#'>\r\n\u001b[?2004l\r\u001b[?2004h>     <span class='date'>January 2025</span>\r\n\u001b[?2004l\r\u001b[?2004h>     <h3>Bridging Machine Learning and Single-Cell Genomics</h3>\r\n\u001b[?2004l\r\u001b[?2004h>     <p>Lessons from integrating scRNA-Seq, ATAC-Seq and spatial FISH into a single analytical framework.</p>\r\n\u001b[?2004l\r\u001b[?2004h>   </a>\r\n\u001b[?2004l\r\u001b[?2004h>   <a class='post' href='#'>\r\n\u001b[?2004l\r\u001b[?2004h>     <span class='date'>November 2024</span>\r\n\u001b[?2004l\r\u001b[?2004h>     <h3>Scaling Graph Neural Networks for Connectomics</h3>\r\n\u001b[?2004l\r\u001b[?2004h>     <p>Training strategies for synapse classification across large electron-microscopy datasets.</p>\r\n\u001b[?2004l\r\u001b[?2004h>   </a>\r\n\u001b[?2004l\r\u001b[?2004h> </main>\r\n\u001b[?2004l\r\u001b[?2004h> <footer class='site-footer'>\r\n\u001b[?2004l\r\u001b[?2004h>   <div class='container'><p>© 2025 Dr. Lydia Moreno · Research Profile</p></div>\r\n\u001b[?2004l\r\u001b[?2004h> </footer>\r\n\u001b[?2004l\r\u001b[?2004h> </body>\r\n\u001b[?2004l\r\u001b[?2004h> </html>\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
