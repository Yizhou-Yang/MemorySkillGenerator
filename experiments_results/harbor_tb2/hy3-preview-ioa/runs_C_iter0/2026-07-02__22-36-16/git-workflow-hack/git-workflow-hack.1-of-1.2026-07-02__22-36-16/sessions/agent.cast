[250.858051, "i", "cat > /app/my_website/public/blog.html << 'EOF'\n<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='UTF-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1.0'>\n<title>Blog — Dr. Lydia Moreno</title>\n<link rel='stylesheet' href='css/style.css'>\n</head>\n<body>\n<header class='site-header'>\n  <nav class='nav'>\n    <a href='index.html' class='brand'>Lydia Moreno, Ph.D.</a>\n    <ul class='nav-links'>\n      <li><a href='index.html'>About Me</a></li>\n      <li><a href='blog.html'>Blog</a></li>\n      <li><a href='publications.html'>Publications</a></li>\n    </ul>\n  </nav>\n</header>\n<main class='container'>\n  <section class='card'>\n    <h2>Blog</h2>\n    <p>Notes and reflections on computational neuroscience, machine learning and single-cell biology.</p>\n  </section>\n  <a class='post' href='#'>\n    <span class='date'>March 2025</span>\n    <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\n    <p>How we move from black-box decoders to models whose decision boundaries we can inspect and trust.</p>\n  </a>\n  <a class='post' href='#'>\n    <span class='date'>January 2025</span>\n    <h3>Bridging Machine Learning and Single-Cell Genomics</h3>\n    <p>Lessons from integrating scRNA-Seq, ATAC-Seq and spatial FISH into a single analytical framework.</p>\n  </a>\n  <a class='post' href='#'>\n    <span class='date'>November 2024</span>\n    <h3>Scaling Graph Neural Networks for Connectomics</h3>\n    <p>Training strategies for synapse classification across large electron-microscopy datasets.</p>\n  </a>\n</main>\n<footer class='site-footer'>\n  <div class='container'><p>© 2025 Dr. Lydia Moreno · Research Profile</p></div>\n</footer>\n</body>\n</html>\nEOF\n"]
