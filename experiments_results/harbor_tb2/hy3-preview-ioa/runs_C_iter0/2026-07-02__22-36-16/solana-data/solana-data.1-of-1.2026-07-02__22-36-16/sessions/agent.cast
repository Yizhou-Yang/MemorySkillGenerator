[382.293109, "i", "cat > /tmp/rpctest2.py << 'EOF'\nimport urllib.request, json\n\ndef post(url, body, proxy=None, timeout=15):\n    data = json.dumps(body).encode()\n    req = urllib.request.Request(url, data=data, headers={'Content-Type':'application/json'})\n    handlers = []\n    if proxy:\n        ph = urllib.request.ProxyHandler({'http': proxy, 'https': proxy})\n        handlers.append(ph)\n    opener = urllib.request.build_opener(*handlers)\n    try:\n        r = opener.open(req, timeout=timeout)\n        return r.status, r.read().decode()\n    except Exception as e:\n        return 'ERR', repr(e)\n\nbody = {'jsonrpc':'2.0','id':1,'method':'getHealth'}\nprint('=== CONNECT proxy via 185.45.7.185:80 ===')\nprint('devnet', post('https://api.devnet.solana.com', body, proxy='http://185.45.7.185:80')[:2])\nprint('mainnet', post('https://api.mainnet-beta.solana.com', body, proxy='http://185.45.7.185:80')[:2])\n\nprint('=== direct (no proxy) HTTPS ===')\nprint('devnet', post('https://api.devnet.solana.com', body)[:2])\n\nprint('=== try public RPCs direc"]
[382.293917, "i", "t ===')\nfor u in ['https://api.testnet.solana.com','https://rpc.ankr.com/solana']:\n    print(u, post(u, body)[:2])\nEOF\npython3 /tmp/rpctest2.py\n"]
