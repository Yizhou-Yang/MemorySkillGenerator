[326.375826, "i", "cat > /tmp/rpctest.py << 'EOF'\nimport urllib.request, json, socket\n\ndef post(url, body, timeout=12, raw=False):\n    data = json.dumps(body).encode()\n    req = urllib.request.Request(url, data=data, headers={'Content-Type':'application/json'})\n    try:\n        r = urllib.request.urlopen(req, timeout=timeout)\n        return r.status, r.read().decode()\n    except Exception as e:\n        return 'ERR', repr(e)\n\n# Try HTTP (not https) to Solana endpoints\ntests = [\n  ('http://api.devnet.solana.com', {'jsonrpc':'2.0','id':1,'method':'getHealth'}),\n  ('http://localhost:8899', {'jsonrpc':'2.0','id':1,'method':'getHealth'}),\n  ('https://localhost:8899', {'jsonrpc':'2.0','id':1,'method':'getHealth'}),\n  ('http://127.0.0.1:8899', {'jsonrpc':'2.0','id':1,'method':'getHealth'}),\n]\nfor url, body in tests:\n    s, out = post(url, body)\n    print(url, s, str(out)[:150])\nEOF\npython3 /tmp/rpctest.py\n"]
