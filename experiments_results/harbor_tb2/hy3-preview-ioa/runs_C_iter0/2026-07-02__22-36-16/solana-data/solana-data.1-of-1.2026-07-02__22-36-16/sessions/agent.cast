[709.604049, "i", ") or {}\n        acct_keys = message.get('accountKeys') or []\n\n        def addr(i):\n            if i is None or i >= len(acct_keys):\n                return None\n            k = acct_keys[i]\n            return k.get('pubkey') if isinstance(k, dict) else k\n\n        def balances(lst):\n            out = {}\n            for b in (lst or []):\n                amt = (b.get('uiTokenAmount') or {}).get('amount')\n                out[(b['accountIndex'], b['mint'])] = int(amt) if amt is not None else 0\n            return out\n\n        pre = balances(meta.get('preTokenBalances'))\n        post = balances(meta.get('postTokenBalances'))\n        mints = set([m for (_, m) in list(pre.keys()) + list(post.keys())])\n        transfers = []\n        for m in mints:\n            diffs = {}\n            for (idx, mm), amt in pre.items():\n                if mm == m:\n                    diffs[idx] = diffs.get(idx, 0) - amt\n            for (idx, mm), amt in post.items():\n                if mm == m:\n                    diffs[idx] = diffs.get(id"]
[709.604104, "i", "x, 0) + amt\n            senders = sorted([(idx, -d) for idx, d in diffs.items() if d < 0],\n                             key=lambda x: -x[1])\n            receivers = sorted([(idx, d) for idx, d in diffs.items() if d > 0],\n                               key=lambda x: -x[1])\n            si = 0\n            for sidx, samt in senders:\n                rem = samt\n                while rem > 0 and si < len(receivers):\n                    ridx, ramt = receivers[si]\n                    take = min(rem, ramt)\n                    transfers.append({'account': addr(sidx), 'mint': m, 'amount': take})\n                    rem -= take\n                    ramt -= take\n                    if ramt <= 0:\n                        si += 1\n                    else:\n                        receivers[si] = (ridx, ramt)\n        return jsonify({\n            'signature': signature,\n            'slot': res.get('slot'),\n            'block_time': res.get('blockTime'),\n            'success': bool(meta.get('err') is None),\n            'fee': meta"]
