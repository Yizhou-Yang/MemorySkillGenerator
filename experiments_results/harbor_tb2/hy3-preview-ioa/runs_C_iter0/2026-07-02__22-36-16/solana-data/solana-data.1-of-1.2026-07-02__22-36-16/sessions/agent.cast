[130.596572, "i", "cat > /tmp/nettest.py << 'EOF'\nimport urllib.request, json\nfor url in ['https://api.devnet.solana.com','https://api.testnet.solana.com','https://api.mainnet-beta.solana.com']:\n    try:\n        data = json.dumps({'jsonrpc':'2.0','id':1,'method':'getHealth'}).encode()\n        req = urllib.request.Request(url, data=data, headers={'Content-Type':'application/json'})\n        r = urllib.request.urlopen(req, timeout=12)\n        print(url, 'OK', r.read().decode())\n    except Exception as e:\n        print(url, 'ERR', repr(e))\nEOF\npython3 /tmp/nettest.py\n"]
