[460.257739, "i", "cat > /tmp/rpctest3.py << 'EOF'\nimport urllib.request, json\n\ndef post(url, body, timeout=20):\n    data = json.dumps(body).encode()\n    req = urllib.request.Request(url, data=data, headers={'Content-Type':'application/json'})\n    try:\n        r = urllib.request.urlopen(req, timeout=timeout)\n        return r.status, r.read().decode()[:120]\n    except Exception as e:\n        return 'ERR', repr(e)[:160]\n\nbody = {'jsonrpc':'2.0','id':1,'method':'getHealth'}\nurls = [\n  'https://rpc.ankr.com/solana',\n  'https://solana-mainnet.rpc.extrnode.com',\n  'https://solana-devnet.rpc.extrnode.com',\n  'https://mainnet-ams.chainstacklabs.com',\n  'https://api.mainnet-beta.solana.com',\n  'https://ssc-dao.genesysgo.net',\n  'https://mango.devnet.rpcpool.com',\n  'https://free.rpcpool.com',\n  'https://solana.drpc.org',\n  'https://api.testnet.solana.com',\n]\nfor u in urls:\n    s, out = post(u, body)\n    print(u, '->', s, out)\nEOF\npython3 /tmp/rpctest3.py\n"]
