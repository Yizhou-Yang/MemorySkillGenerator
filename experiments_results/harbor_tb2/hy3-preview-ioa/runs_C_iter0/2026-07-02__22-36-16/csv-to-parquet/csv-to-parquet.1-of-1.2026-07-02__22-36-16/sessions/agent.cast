[721.159071, "i", "python3 - << 'EOF'\nimport struct\nd = open('/app/data.parquet','rb').read()\nfl = struct.unpack('<I', d[-8:-4])[0]\nfooter = d[-8-fl:-8]\nclass D:\n    def __init__(s,b): s.d=b; s.i=0\n    def u8(s): v=s.d[s.i]; s.i+=1; return v\n    def vi(s):\n        sh=0; r=0\n        while True:\n            b=s.u8(); r|=(b&0x7f)<<sh\n            if not b&0x80: break\n            sh+=7\n        return r\n    def zz(s,n): return (n>>1)^-(n&1)\n    def fld(s):\n        b=s.u8()\n        if b==0: return None\n        dl=(b>>4)&0xf; t=b&0xf\n        if dl==15: dl=s.vi()\n        return dl,t\n    def val(s,t):\n        if t==4 or t==5 or t==6: return s.zz(s.vi())\n        if t==7: v=struct.unpack('<d',s.d[s.i:s.i+8])[0]; s.i+=8; return v\n        if t==8: ln=s.vi(); v=s.d[s.i:s.i+ln]; s.i+=ln; return v\n        if t in (9,10):\n            b=s.u8(); sz=(b>>4)&0xf; et=b&0xf\n            if sz==15: sz=s.vi()\n            return [s.val(et) for _ in range(sz)]\n        if t==12: return s.struct()\n    def struct(s):\n        o={}; fid=0\n        while True:\n            f=s.fld()\n            if f is None: return o\n            dl,t=f; fid+=dl; o[fid]=s.val(t)\nm=D(footer).struct()\nschema=m[2]\nnames=[]\nfor el in schema:\n    e=D(el).struct()\n    names.append(e.get(4, b'?').decode())\ntypes={2:'INT64',5:'DOUBLE',6:'BYTE_ARRAY'}\nprint('root num_children=', schema[0][1] if isinstance(schema[0], bytes) else 'n/a')\nprint('schema names:', names)\nfor el in schema[1:]:\n    e=D(el).struct()\n    print('  ', e[4].decode(), '->', types.get(e[1], e[1]))\nEOF\n"]
