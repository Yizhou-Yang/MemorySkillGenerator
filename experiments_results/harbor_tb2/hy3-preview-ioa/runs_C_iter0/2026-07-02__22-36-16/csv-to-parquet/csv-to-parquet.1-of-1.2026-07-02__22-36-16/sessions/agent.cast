[569.776782, "o", "    with open(in_path, 'r', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         reader = csv.reader(f)\r\n\u001b[?2004l\r\u001b[?2004h>         rows = [r for r in reader if r]\r\n\u001b[?2004l\r\u001b[?2004h>     header = rows[0]\r\n\u001b[?2004l\r\u001b[?2004h>     data_rows = rows[1:]\r\n\u001b[?2004l\r\u001b[?2004h>     ncols = len(header)\r\n\u001b[?2004l\r\u001b[?2004h>     nrows = len(data_rows)\r\n\u001b[?2004l\r\u001b[?2004h>     cols = []\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(ncols):\r\n\u001b[?2004l\r\u001b[?2004h>         vals = [r[j] for r in data_rows]\r\n\u001b[?2004l\r\u001b[?2004h>         if vals and all(is_int(v) for v in vals):\r\n\u001b[?2004l\r\u001b[?2004h>             ivals = [int(v) for v in vals]\r\n\u001b[?2004l\r\u001b[?2004h>             page = b''.join(struct.pack('<q', x) for x in ivals)\r\n\u001b[?2004l\r\u001b[?2004h>             mn = min(ivals).to_bytes(8, 'little', signed=True)\r\n\u001b[?2004l\r\u001b[?2004h>             mx = max(ivals).to_bytes(8, 'little', signed=True)\r\n\u001b[?2004l\r\u001b[?2004h>             col_type = 2\r\n\u001b[?2004l\r\u001b[?2004h>             converted = None\r\n\u001b[?2004l\r\u001b[?2004h>         elif vals and all(is_float(v) for v in vals):\r\n\u001b[?2004l\r\u001b[?2004h>             fvals = [float(v) for v in vals]\r\n\u001b[?2004l\r\u001b[?2004h>             page = b''.join(struct.pack('<d', x) for x in fvals)\r\n\u001b[?2004l\r\u001b[?2004h>             mn = struct.pack('<d', min(fvals))\r\n\u001b[?2004l\r\u001b[?2004h>             mx = struct.pack('<d', max(fvals))\r\n\u001b[?2004l\r\u001b[?2004h>             col_type = 5\r\n\u001b[?2004l\r\u001b[?2004h>             converted = None\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             bvals = [v.encode('utf-8') for v in vals]\r\n\u001b[?2004l\r\u001b[?2004h>             page = b''.join(struct.pack('<i', len(b)) + b for b in bvals)\r\n\u001b[?2004l\r\u001b[?2004h>             mn = min(bvals)\r\n\u001b[?2004l\r\u001b[?2004h>             mx = max(bvals)\r\n\u001b[?2004l\r\u001b[?2004h>             col_type = 6\r\n\u001b[?2004l\r\u001b[?2004h>             converted = 1\r\n\u001b[?2004l\r\u001b[?2004h>         cols.append({'name': header[j], 'col_type': col_type, 'converted': converted, 'page': page, 'mn': mn, 'mx': mx})\r\n\u001b[?2004l\r\u001b[?2004h>     out = bytearray()\r\n\u001b[?2004l\r\u001b[?2004h>     out.extend(b'PAR1')\r\n\u001b[?2004l\r\u001b[?2004h>     pos = 4\r\n\u001b[?2004l\r\u001b[?2004h>     col_chunks = []\r\n\u001b[?2004l\r\u001b[?2004h>     total_uncompressed = 0\r\n\u001b[?2004l\r\u001b[?2004h>     total_compressed = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[569.777458, "o", "    for c in cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
