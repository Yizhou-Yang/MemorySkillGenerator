[637.458545, "i", "python3 - << 'EOF'\ncontent = open('/app/make_parquet.py').read()\nold = '''def schema_element(name, type_code=None, num_children=None, converted_type=None, repetition=1):\n    fields = []\n    if type_code is not None:\n        fields.append((1, I32, render_i32(type_code)))\n    if num_children is not None:\n        fields.append((5, I32, render_i32(num_children)))\n    fields.append((3, I32, render_i32(repetition)))\n    fields.append((4, BINARY, render_binary(name.encode())))\n    if converted_type is not None:\n        fields.append((6, I32, render_i32(converted_type)))\n    buf = bytearray()\n    write_struct(buf, fields)\n    return bytes(buf)'''\nnew = '''def schema_element(name, type_code=None, num_children=None, converted_type=None, repetition=1):\n    fields = []\n    if type_code is not None:\n        fields.append((1, I32, render_i32(type_code)))\n        fields.append((2, I32, render_i32(repetition)))\n    if num_children is not None:\n        fields.append((5, I32, render_i32(num_children)))\n    fields.append((3, BINARY, render_binary(name.encode())))\n    if converted_type is not None:\n        fields.append((6, I32, render_i32(converted_type)))\n    buf = bytearray()\n    write_struct(buf, fields)\n    return bytes(buf)'''\nassert old in content, 'pattern not found'\nopen('/app/make_parquet.py','w').write(content.replace(old, new))\nprint('patched')\nEOF\n"]
