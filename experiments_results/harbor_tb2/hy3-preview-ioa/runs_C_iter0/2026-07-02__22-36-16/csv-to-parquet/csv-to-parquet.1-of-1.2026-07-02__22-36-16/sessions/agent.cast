[569.661132, "o", "\u001b[?2004hroot@36ff4f9164b5:/app# "]
[569.729678, "i", "cat > /app/make_parquet.py << 'PYEOF'\nimport struct, csv, sys\n\nBOOL_TRUE=1; BOOL_FALSE=2; BYTE=3; I16=4; I32=5; I64=6; DOUBLE=7; BINARY=8; LIST=9; SET=10; MAP=11; STRUCT=12\n\ndef write_varint(buf, n):\n    n &= 0xFFFFFFFFFFFFFFFF\n    while True:\n        b = n & 0x7f\n        n >>= 7\n        if n:\n            buf.append(b | 0x80)\n        else:\n            buf.append(b)\n            break\n\ndef zigzag(n):\n    return (n << 1) if n >= 0 else ((-n) << 1) - 1\n\ndef write_struct(buf, fields):\n    fields = sorted(fields, key=lambda f: f[0])\n    prev = 0\n    for fid, ttype, val in fields:\n        delta = fid - prev\n        if delta < 15:\n            buf.append((delta << 4) | ttype)\n        else:\n            buf.append(0xf0 | ttype)\n            write_varint(buf, delta - 15)\n        val(buf)\n        prev = fid\n    buf.append(0)\n\ndef render_i32(x):\n    def r(b): write_varint(b, zigzag(x))\n    return r\n\ndef render_i64(x):\n    def r(b): write_varint(b, zigzag(x))\n    return r\n\ndef render_double(x):\n    def r(b): b.extend(struct.pack('<d', x))\n    return r\n\ndef render_binary(x):\n    def r(b):\n        write_varint(b, len(x))\n        b.extend(x)\n    return r\n\ndef render_bool(x):\n    def r(b): b.append(BOOL_TRUE if x else BOOL_FALSE)\n    return r\n\ndef render_raw(data):\n    def r(b): b.extend(data)\n    return r\n\ndef render_struct(fields):\n    def r(b): write_struct(b, fields)\n    return r\n\ndef render_list(etype, items, item_render):\n    def r(b):\n        n = len(items)\n        if n < 15:\n            b.append((n << 4) | etype)\n        else:\n            b.append(0xf0 | etype)\n            write_varint(b, n)\n        for it in items:\n            item_render(it)(b)\n    return r\n\ndef page_header(num_values, data_size):\n    dph = [\n        (1, I32, render_i32(num_values)),\n        (2, I32, render_i32(0)),\n        (3, I32, render_i32(3)),\n        (4, I32, render_i32(3)),\n    ]\n    fields = [\n        (1, I32, render_i32(0)),\n        (2, I32, render_i32(data_size)),\n        (3, I32, render_i32(data_size)),\n        (5, STRUCT, render_struct(dph)),\n    ]\n    buf = bytearray()\n    write_struct(buf, fields)\n    return bytes(buf)\n\ndef stats_fields(min_b, max_b, null_count=0):\n    return [\n        (1, BINARY, render_binary(max_b)),\n        (2, BINARY, render_binary(min_b)),\n        (3, I64, render_i64(null_count)),\n        (5, BINARY, render_binary(max_b)),\n        (6, BINARY, render_binary(min_b)),\n    ]\n\ndef column_meta(col_type, path, num_values, uncompressed, compressed, data_page_offset, stats):\n    fields = [\n        (1, I32, render_i32(col_type)),\n        (2, LIST, render_list(I32, [0, 3], render_i32)),\n        (3, LIST, render_list(BINARY, [p.encode() for p in path], render_binary)),\n        (4, I32, render_i32(0)),\n        (5, I64, render_i64(num_values)),\n        (6, I64, render_i64(uncompressed)),\n        (7, I64, render_i64(compressed)),\n        (9, I64, render_i64(data_page_offset)),\n        (12, STRUCT, render_struct(stats)),\n    ]\n    buf = bytearray()\n    write_struct(buf, fields)\n    return bytes(buf)\n\ndef column_chunk(file_offset, meta_bytes):\n    fields = [\n        (1, I64, render_i64(file_offset)),\n        (2, STRUCT, render_raw(meta_bytes)),\n    ]\n    buf = bytearray()\n    write_struct(buf, fields)\n    return bytes(buf)\n\ndef row_group(col_chunks, total_uncompressed, num_rows, total_compressed):\n    fields = [\n        (1, LIST, render_list(STRUCT, col_chunks, render_raw)),\n        (2, I64, render_i64(total_uncompressed)),\n        (3, I64, render_i64(num_rows)),\n        (6, I64, render_i64(total_compressed)),\n    ]\n    buf = bytearray()\n    write_struct(buf, fields)\n    return bytes(buf)\n\ndef schema_element(name, type_code=None, num_children=None, converted_type=None, repetition=1):\n    fields = []\n    if type_code is not None:\n        fields.append((1, I32, render_i32(type_code)))\n    if num_children is not None:\n        fields.append((5, I32, render_i32(num_children)))\n    fields.append((3, I32, render_i32(repetition)))\n    fields.append((4, BINARY, render_binary(name.encode())))\n    if converted_type is not None:\n        fields.append((6, "]
[569.729755, "i", "I32, render_i32(converted_type)))\n    buf = bytearray()\n    write_struct(buf, fields)\n    return bytes(buf)\n\ndef file_meta(row_group_bytes, schema_bytes, num_rows):\n    fields = [\n        (1, I32, render_i32(1)),\n        (2, LIST, render_list(STRUCT, schema_bytes, render_raw)),\n        (3, I64, render_i64(num_rows)),\n        (4, LIST, render_list(STRUCT, row_group_bytes, render_raw)),\n        (6, BINARY, render_binary(b\"codebuddy-parquet-writer\")),\n    ]\n    buf = bytearray()\n    write_struct(buf, fields)\n    return bytes(buf)\n\ndef is_int(s):\n    try:\n        int(s); return True\n    except: return False\n\ndef is_float(s):\n    try:\n        float(s); return True\n    except: return False\n\ndef main():\n    in_path = '/app/data.csv'\n    out_path = '/app/data.parquet'\n    with open(in_path, 'r', newline='') as f:\n        reader = csv.reader(f)\n        rows = [r for r in reader if r]\n    header = rows[0]\n    data_rows = rows[1:]\n    ncols = len(header)\n    nrows = len(data_rows)\n    cols = []\n    for j in range(ncols):\n        vals = [r[j] for r in data_rows]\n        if vals and all(is_int(v) for v in vals):\n            ivals = [int(v) for v in vals]\n            page = b''.join(struct.pack('<q', x) for x in ivals)\n            mn = min(ivals).to_bytes(8, 'little', signed=True)\n            mx = max(ivals).to_bytes(8, 'little', signed=True)\n            col_type = 2\n            converted = None\n        elif vals and all(is_float(v) for v in vals):\n            fvals = [float(v) for v in vals]\n            page = b''.join(struct.pack('<d', x) for x in fvals)\n            mn = struct.pack('<d', min(fvals))\n            mx = struct.pack('<d', max(fvals))\n            col_type = 5\n            converted = None\n        else:\n            bvals = [v.encode('utf-8') for v in vals]\n            page = b''.join(struct.pack('<i', len(b)) + b for b in bvals)\n            mn = min(bvals)\n            mx = max(bvals)\n            col_type = 6\n            converted = 1\n        cols.append({'name': header[j], 'col_type': col_type, 'converted': converted, 'page': page, 'mn': mn, 'mx': mx})\n    out = bytearray()\n    out.extend(b'PAR1')\n    pos = 4\n    col_chunks = []\n    total_uncompressed = 0\n    total_compressed = 0\n    for c in cols:\n        ph = page_header(nrows, len(c['page']))\n        data_page_offset = pos\n        out.extend(ph)\n        pos += len(ph)\n        out.extend(c['page'])\n        pos += len(c['page'])\n        st = stats_fields(c['mn'], c['mx'])\n        meta = column_meta(c['col_type'], [c['name']], nrows, len(ph) + len(c['page']), len(ph) + len(c['page']), data_page_offset, st)\n        cc = column_chunk(pos, meta)\n        col_chunks.append(cc)\n        total_uncompressed += len(ph) + len(c['page'])\n        total_compressed += len(ph) + len(c['page'])\n    schema = [schema_element('schema', num_children=ncols)]\n    for c in cols:\n        schema.append(schema_element(c['name'], type_code=c['col_type'], converted_type=c['converted']))\n    rg = row_group(col_chunks, total_uncompressed, nrows, total_compressed)\n    fm = file_meta(rg, schema, nrows)\n    out.extend(fm)\n    out.extend(struct.pack('<I', len(fm)))\n    out.extend(b'PAR1')\n    with open(out_path, 'wb') as f:\n        f.write(out)\n    print('Wrote', out_path, 'size', len(out), 'rows', nrows, 'cols', ncols)\n\nmain()\nPYEOF\n"]
