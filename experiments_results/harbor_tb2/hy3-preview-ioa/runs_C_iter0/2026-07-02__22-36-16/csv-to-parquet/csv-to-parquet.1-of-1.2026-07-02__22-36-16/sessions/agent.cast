[571.09076, "i", "cat > /app/verify_parquet.py << 'PYEOF'\nimport struct, csv\n\nd = open('/app/data.parquet','rb').read()\nassert d[:4]==b'PAR1' and d[-4:]==b'PAR1', 'magic mismatch'\nfooter_len = struct.unpack('<I', d[-8:-4])[0]\nfooter = d[-8-footer_len:-8]\n\nclass Dec:\n    def __init__(self, data):\n        self.d = data; self.i = 0\n    def u8(self):\n        v = self.d[self.i]; self.i += 1; return v\n    def varint(self):\n        shift = 0; r = 0\n        while True:\n            b = self.u8(); r |= (b & 0x7f) << shift\n            if not (b & 0x80): break\n            shift += 7\n        return r\n    def zz(self, n):\n        return (n >> 1) ^ -(n & 1)\n    def field(self):\n        b = self.u8()\n        if b == 0: return None\n        delta = (b >> 4) & 0xf; t = b & 0xf\n        if delta == 15: delta = self.varint()\n        return (delta, t)\n    def val(self, t):\n        if t == 1: return True\n        if t == 2: return False\n        if t == 3: self.i += 1; return None\n        if t == 4: return self.zz(self.varint())\n        if t == 5: return self.zz(self.varint())\n        if t == 6: return self.zz(self.varint())\n        if t == 7: v = struct.unpack('<d', self.d[self.i:self.i+8])[0]; self.i += 8; return v\n        if t == 8:\n            ln = self.varint(); v = self.d[self.i:self.i+ln]; self.i += ln; return v\n        if t in (9, 10):\n            b = self.u8(); size = (b >> 4) & 0xf; et = b & 0xf\n            if size == 15: size = self.varint()\n            return [self.val(et) for _ in range(size)]\n        if t == 11:\n            size = self.varint()\n            if size == 0: return {}\n            b = self.u8(); kt = (b >> 4) & 0xf; vt = b & 0xf\n            m = {}\n            for _ in range(size):\n                k = self.val(kt); v = self.val(vt); m[k] = v\n            return m\n        if t == 12: return self.struct()\n        raise Exception('bad type %d' % t)\n    def struct(self):\n        out = {}; fid = 0\n        while True:\n            f = self.field()\n            if f is None: return out\n            delta, t = f\n            fid += delta\n            out[fid] = self.val(t)\n\nmeta = Dec(footer).struct()\ncolumns = meta[4][0][1]\nwith open('/app/data.csv','r',newline='') as f:\n    rows = [r for r in csv.reader(f) if r]\nheader = rows[0]; data_rows = rows[1:]\nfor col in columns:\n    cm = col[2]\n    typ = cm[1]\n    path = [p.decode() for p in cm[3]]\n    dpo = cm[9]\n    dec = Dec(d); dec.i = dpo\n    ph = dec.struct()\n    ups = ph[2]\n    data = d[dec.i:dec.i+ups]\n    cidx = header.index(path[0])\n    vals = []\n    if typ == 2:\n        for k in range(0, len(data), 8):\n            vals.append(str(struct.unpack('<q', data[k:k+8])[0]))\n    elif typ == 5:\n        for k in range(0, len(data), 8):\n            vals.append(str(struct.unpack('<d', data[k:k+8])[0]))\n    elif typ == 6:\n        off = 0\n        while off < len(data):\n            ln = struct.unpack('<i', data[off:off+4])[0]; off += 4\n            s = data[off:off+ln].decode(); off += ln\n            vals.append(s)\n    else:\n        raise Exception('unknown type ' + str(typ))\n    expected = [r[cidx] for r in data_rows]\n    assert vals == expected, 'mismatch in column ' + str(path)\nprint('VERIFY OK: rows=%d cols=%d' % (len(data_rows), len(header)))\nprint('schema:', [p.decode() for p in columns[0][2][3]])\nPYEOF\n"]
