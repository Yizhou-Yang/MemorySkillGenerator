[133.938389, "i", "cat > /app/test_ssh.exp << 'EXPEOF'\n#!/usr/bin/expect -f\nset timeout 40\nspawn ssh -p 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@localhost\nexpect {\n    \"password:\" { send \"password123\\r\" }\n    timeout { puts \"NO_PROMPT\"; exit 1 }\n}\nexpect {\n    -re {# $} {}\n    timeout { puts \"NO_SHELL\"; exit 1 }\n}\nsend \"echo SSH_OK_RESULT; exit\\r\"\nexpect \"SSH_OK_RESULT\"\nEXPEOF\n"]
