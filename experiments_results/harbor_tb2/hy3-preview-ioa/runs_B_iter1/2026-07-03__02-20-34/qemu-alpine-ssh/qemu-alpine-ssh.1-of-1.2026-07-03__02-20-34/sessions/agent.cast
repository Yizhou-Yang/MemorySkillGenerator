[59.860386, "i", "cat > /app/run_vm.sh << 'EOF'\n#!/bin/sh\nqemu-system-x86_64 \\\n  -m 1024 \\\n  -smp 2 \\\n  -cdrom /app/alpine.iso \\\n  -drive file=/app/alpine-disk.qcow2,if=virtio,format=qcow2 \\\n  -netdev user,id=net0,hostfwd=tcp::2222-:22 \\\n  -device virtio-net-pci,netdev=net0 \\\n  -display none \\\n  -serial tcp:127.0.0.1:9999,server,nowait \\\n  -pidfile /app/qemu.pid \\\n  > /app/qemu.log 2>&1 &\nEOF\n"]
