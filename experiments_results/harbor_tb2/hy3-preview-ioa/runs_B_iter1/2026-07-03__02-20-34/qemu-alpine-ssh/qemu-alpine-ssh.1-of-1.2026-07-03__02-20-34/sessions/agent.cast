[133.790235, "i", "cat > /app/setup.exp << 'EXPEOF'\n#!/usr/bin/expect -f\nset timeout 240\nlog_file -a /app/setup.log\nspawn nc 127.0.0.1 9999\nsend \"\\r\"\nexpect {\n    \"login:\" { send \"root\\r\" }\n    -re {# $} {}\n    timeout { send \"\\r\"; exp_continue }\n}\nexpect {\n    -re \"Password:\" { send \"\\r\" }\n    -re {# $} {}\n    timeout { send \"\\r\"; exp_continue }\n}\nexpect -re {# $}\nproc cmd {c} {\n    send \"$c\\r\"\n    expect -re {# $}\n}\ncmd \"ip link set eth0 up\"\ncmd \"udhcpc -i eth0\"\ncmd \"echo nameserver 8.8.8.8 > /etc/resolv.conf\"\ncmd \"apk add openssh\"\ncmd \"ssh-keygen -A\"\ncmd \"echo 'root:password123' | chpasswd\"\nsend \"cat > /etc/ssh/sshd_config << 'EOF'\\r\"\nsend \"PermitRootLogin yes\\r\"\nsend \"PasswordAuthentication yes\\r\"\nsend \"PubkeyAuthentication yes\\r\"\nsend \"EOF\\r\"\nexpect -re {# $}\ncmd \"/usr/sbin/sshd\"\ncmd \"echo SETUP_DONE_OK\"\nexpect \"SETUP_DONE_OK\"\nEXPEOF\n"]
