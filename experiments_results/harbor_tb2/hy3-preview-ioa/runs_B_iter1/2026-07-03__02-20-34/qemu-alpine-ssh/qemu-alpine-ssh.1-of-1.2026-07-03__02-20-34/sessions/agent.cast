[527.741493, "o", "spawn nc 127.0.0.1 9999\r\r\n\r\r\n\r\r\r\r\nWelcome to Alpine Linux 3.19\r\r\r\n\rKernel 6.6.4-1-lts on an x86_64 (/dev/ttyS0)\r\r\r\n\r\r\r\r\n\rlocalhost login: root\r"]
[527.741647, "o", "\r\nroot\r\r\r\nWelcome to Alpine!\r\r\r\n\r\r\r\nThe Alpine Wiki contains a large amount of how-to guides and general\r\r\r\ninformation about administrating Alpine systems.\r\r\r\nSee <https://wiki.alpinelinux.org/>.\r\r\r\n\r\r\r\nYou can setup the system with the command: setup-alpine\r\r\r\n\r\r\r\nYou may change this message by editing /etc/motd.\r\r\r\n\r\r\r\nlocalhost:~# \u001b[6n"]
[527.741888, "o", "\u001b[?2004hroot@31dadb18c35a:/app# "]
[527.742322, "i", "\u001b[40;14R"]
[527.742486, "m", "Episode 14: 2 commands"]
[527.742486, "o", "\u0007;14R"]
[573.65669, "i", "cat > /app/setup2.exp << 'EXPEOF'\n#!/usr/bin/expect -f\nset timeout 30\nlog_file -a /app/setup2.log\nspawn nc 127.0.0.1 9999\nexpect {\n    \"login:\" { send \"root\\r\"; exp_continue }\n    -re {# $} {}\n    eof { puts \"CONNECT_FAILED\"; exit 1 }\n    timeout { send \"\\r\"; exp_continue }\n}\nproc runcmd {c} {\n    send \"$c; echo ZZENDZZ\\r\"\n    expect {\n        \"ZZENDZZ\" {}\n        eof { puts \"CMD_EOF\"; exit 1 }\n        timeout { send \"\\003\"; exp_continue }\n    }\n}\nset timeout 60\nruncmd \"ip link set eth0 up\"\nset timeout 120\nruncmd \"udhcpc -i eth0 -q\"\nruncmd \"echo nameserver 8.8.8.8 > /etc/resolv.conf\"\nset timeout 300\nruncmd \"apk add openssh\"\nruncmd \"ssh-keygen -A\"\nruncmd \"echo 'root:password123' | chpasswd\"\nruncmd \"printf 'PermitRootLogin yes\\\\nPasswordAuthentication yes\\\\nPubkeyAuthentication yes\\\\n' > /etc/ssh/sshd_config\"\nruncmd \"cat /etc/ssh/sshd_config\"\nruncmd \"/usr/sbin/sshd\"\nruncmd \"echo SETUP_COMPLETE_FINAL\"\nexpect \"SETUP_COMPLETE_FINAL\"\nEXPEOF\n"]
[573.656754, "o", "cat > /app/setup2.exp << 'EXPEOF'"]
