[225.767271, "o", "ne   (or \u001b[4mN\u001b[24m"]
[225.767402, "o", " lines).\r\n\u001b[16;1H  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\r\n\u001b[17;1H  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\r\n\u001b[18;1H  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\r\n\u001b[19;1H  w                 *  Backward one window (and set window to \u001b[4mN\u001b[24m).\r\n\u001b[20;1H  ESC-SPACE         *  Forward  one window, but don't stop at end-of-file.\r\n\u001b[21;1H  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\r\n\u001b[22;1H  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\r\n\u001b[23;1H  ESC-)  RightArrow *  Right one half screen width (or \u001b[4mN\u001b[24m positions).\r\n\u001b[24;1H  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\r\n\u001b[25;1H  ESC-}  ^RightArrow   Right to last column displayed.\r\n\u001b[26;1H  ESC-{  ^LeftArrow    Left  to first column.\r\n\u001b[27;1H  F                    Forward forever; like \u001b[7m\"\u001b[27mtail -f\u001b[7m\"\u001b[27m.\r\n\u001b[28;1H  ESC-F                Like F but stop when search pa"]
[225.767419, "o", "ttern is fou"]
[225.778348, "o", "nd.\r\n\u001b[29;1H  r  ^R  ^L            Repaint screen.\r\n\u001b[30;1H  R                    Repaint screen, discarding buffered input.\r\n\u001b[31;1H        ---------------------------------------------------\r\n\u001b[32;1H        Default \u001b[7m\"\u001b[27mwindow\u001b[7m\"\u001b[27m is the screen height.\r\n\u001b[33;1H        Default \u001b[7m\"\u001b[27mhalf-window\u001b[7m\"\u001b[27m is half of the screen height.\r\n\u001b[34;1H ---------------------------------------------------------------------------\r\n\u001b[35;1H\r\n\u001b[36;1H                          \u001b[1mSEARCHING\u001b[0m\r\n\u001b[37;1H\r\n\u001b[38;1H  /\u001b[4mpattern\u001b[24m          *  Search forward for (\u001b[4mN\u001b[24m-th) matching line.\r\n\u001b[39;1H  ?\u001b[4mpattern\u001b[24m          *  Search backward for (\u001b[4mN\u001b[24m-th) matching line.\r\n\u001b[40;1H  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\r\n  N                 *  Repeat previous search in reverse direction.\r\n  ESC-n             *  Repeat previous search, spanning files.\r\n  ESC-N             *  Repeat previous search, reverse dir. & spanning files.\r\n  ESC-u                Undo (toggle) "]
[225.778412, "o", "search highlighting.\r\n  ESC-U                Clear search highlighting.\r\n  &\u001b[4mpattern\u001b[24m          *  Display only matching lines.\r\n        ---------------------------------------------------\r\n        A search pattern may begin with one or more of:\r\n        ^N or !  Search for NON-matching lines.\r\n        ^E or *  Search multiple files (pass thru END OF FILE).\r\n        ^F or @  Start search at FIRST file (for /) or last file (for ?).\r\n        ^K       Highlight matches, but don't move (KEEP position).\r\n        ^R       Don't use REGULAR EXPRESSIONS.\r\n        ^W       WRAP search if no match found.\r\n ---------------------------------------------------------------------------\r\n\r\n                           \u001b[1mJUMPING\u001b[0m\r\n\r\n  g  <  ESC-<       *  Go to first line in file (or line \u001b[4mN\u001b[24m).\r\n  G  >  ESC->       *  Go to last line in file (or line \u001b[4mN\u001b[24m).\r\n  p  %              *  Go to beginning of file (or \u001b[4mN\u001b[24m percent into file).\r\n  t                 *  Go to the (\u001b[4mN\u001b[24m-th) next tag.\r\n  T  "]
[225.778425, "o", "               *  Go to the (\u001b[4m"]
[225.778498, "o", "N\u001b[24m-th) previous tag.\r\n  {  (  [           *  Find close bracket } ) ].\r\n  }  )  ]           *  Find open bracket { ( [.\r\n  ESC-^F \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find close bracket \u001b[4m<c2>\u001b[24m.\r\n  ESC-^B \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find open bracket \u001b[4m<c1>\u001b[24m.\r\n        ---------------------------------------------------\r\n        Each \u001b[7m\"\u001b[27mfind close bracket\u001b[7m\"\u001b[27m command goes forward to the close bracket \r\n          matching the (\u001b[4mN\u001b[24m-th) open bracket in the top line.\r\n        Each \u001b[7m\"\u001b[27mfind open bracket\u001b[7m\"\u001b[27m command goes backward to the open bracket \r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K"]
[225.778784, "o", "\u001b[H\u001bM        Default \u001b[7m\"\u001b[27mwindow\u001b[7m\"\u001b[27m is the screen height.\r\n\u001b[H\u001bM        ---------------------------------------------------\r\n\u001b[H\u001bM  R                    Repaint screen, discarding buffered input.\r\n\u001b[H\u001bM  r  ^R  ^L            Repaint screen.\r\n\u001b[H\u001bM  ESC-F                Like F but stop when search pattern is found.\r\n\u001b[H\u001bM  F                    Forward forever; like \u001b[7m\"\u001b[27mtail -f\u001b[7m\"\u001b[27m.\r\n\u001b[H\u001bM  ESC-{  ^LeftArrow    Left  to first column.\r\n\u001b[H\u001bM  ESC-}  ^RightArrow   Right to last column displayed.\r\n\u001b[H\u001bM  ESC-(  LeftArrow  *  Left  one half screen width (or \u001b[4mN\u001b[24m positions).\r\n\u001b[H\u001bM  ESC-)  RightArrow *  Right one half screen width (or \u001b[4mN\u001b[24m positions).\r\n\u001b[H\u001bM  u  ^U             *  Backward one half-window (and set half-window to \u001b[4mN\u001b[24m).\r\n\u001b[H\u001bM  d  ^D             *  Forward  one half-window (and set half-window to \u001b[4mN\u001b[24m).\r\n\u001b[H\u001bM  ESC-SPACE         *  Forward  one window, but don't stop at end-of-file.\r\n\u001b[H\u001bM  w                 *  Backward one window (and set window to \u001b[4m"]
[225.778801, "o", "N\u001b[24m).\r\n\u001b[H"]
[225.779718, "o", "\u001bM  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\r\n\u001b[H\u001bM  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\r\n\u001b[H\u001bM  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\r\n\u001b[H\u001bM  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\r\n\u001b[H\u001bM  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\r\n\u001b[H\u001bM\r\n\u001b[H\u001bM                           \u001b[1mMOVING\u001b[0m\r\n\u001b[H\u001bM\r\n\u001b[H\u001bM ---------------------------------------------------------------------------\r\n\u001b[H\u001bM  q  :q  Q  :Q  ZZ     Exit.\r\n\u001b[H\u001bM  h  H                 Display this help.\r\n\u001b[H\u001bM\r\n\u001b[H\u001bM      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\r\n\u001b[H\u001bM      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\r\n\u001b[H\u001bM      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\r\n\u001b[H\u001bM\r\n\u001b[H\u001bM                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\r\n\u001b[H\u001bM\r\n\u001b[40;1H\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press "]
[225.779743, "o", "RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\u001b[7mNo next tag  (press RETURN)\u001b[27m\u001b[40;1H\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\u0007\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K\r\u001b[K\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K  n                 *  Repeat previous search (for \u001b[4mN\u001b[24m-th occurrence).\r\n  N                 *  Repeat previous search in reverse direction.\r\n  ESC-n             *  Repeat previous search, spanning files.\r\n  ESC-N             *  Repeat previous search, reverse dir. & spanning files.\r\n  ESC-u                Undo (toggle) search highlighting.\r\n  ESC-U                Clear search highlighting.\r\n  &\u001b[4mpattern\u001b[24m          *  Display only matching lines.\r\n        ---------------------------------------------------\r\n        A search pattern may begin with one or more of:\r\n        ^N or !  Search for NON-matching lines.\r\n        ^E or *  Search multiple files (pass thru E"]
[225.779786, "o", "ND OF FILE).\r\n        ^F or @  Start search at FIRST file (for /) or last file (for ?).\r\n        ^K       Highlight matches, but don't move (KEEP position).\r\n        ^R       Don't use REGULAR EXPRESSIONS.\r\n        ^W       WRAP search if no match found.\r\n ---------------------------------------------------------------------------\r\n\r\n                           \u001b[1mJUMPING\u001b[0m\r\n\r\n  g  <  ESC-<       *  Go to first line in file (or line \u001b[4mN\u001b[24m).\r\n  G  >  ESC->       *  Go to last line in file (or line \u001b[4mN\u001b[24m).\r\n  p  %              *  Go to beginning of file (or \u001b[4mN\u001b[24m percent into file).\r\n  t                 *  Go to the (\u001b[4mN\u001b[24m-th) next tag.\r\n  T                 *  Go to the (\u001b[4mN\u001b[24m-th) previous tag.\r\n  {  (  [           *  Find close bracket } ) ].\r\n  }  )  ]           *  Find open bracket { ( [.\r\n  ESC-^F \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find close bracket \u001b[4m<c2>\u001b[24m.\r\n  ESC-^B \u001b[4m<c1>\u001b[24m \u001b[4m<c2>\u001b[24m  *  Find open bracket \u001b[4m<c1>\u001b[24m.\r\n        ------------------------------------"]
[225.779855, "m", "Episode 4: 3 commands"]
[225.779855, "o", "---------------\r\n        Each \u001b[7m\"\u001b[27mfind close bracket\u001b[7m\"\u001b[27m command goes forward to the close bracket \r\n          matching the (\u001b[4mN\u001b[24m-th) open bracket in the top line.\r\n        Each \u001b[7m\"\u001b[27mfind open bracket\u001b[7m\"\u001b[27m command goes backward to the open bracket \r\n          matching the (\u001b[4mN\u001b[24m-th) close bracket in the bottom line.\r\n\r\n  m\u001b[4m<letter>\u001b[24m            Mark the current top line with <letter>.\r\n  M\u001b[4m<letter>\u001b[24m            Mark the current bottom line with <letter>.\r\n  '\u001b[4m<letter>\u001b[24m            Go to a previously marked position.\r\n  ''                   Go to the previous position.\r\n  ^X^X                 Same as '.\r\n\u001b[7mHELP -- Press RETURN for more, or q when done\u001b[27m\u001b[K\r\u001b[K-\r\u001b[K--\u001b[Ka\ba\r\u001b[K--\u001b[Ka\ba\u001b[Ku\bu\u001b[Kt\bt\u001b[Ko\bo\u001b[K-\b-\u001b[Kb\bb\u001b[Ku\bu\u001b[Kf\bf\u001b[Kf\bf\u001b[Ke\be\u001b[Kr\br\u001b[Ks\bs\r\u001b[K\u001b[7mDon't automatically allocate buffers  (press RETURN)\u001b[27m"]
[344.231384, "i", "q\n"]
[344.232172, "o", "\u001b[40;1H\u001b[K...skipping...\r\n\u001b[7mESC\u001b[27m[35md6987af002b122fef54bc0be402062c76488a4d9:ray_processing/process.py\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[36m:\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[32m74\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[36m:\u001b[7mESC\u001b[27m[m    os.environ['AWS_ACCESS_KEY_ID'] = \u001b[7m\"\u001b[27m\u001b[7mESC\u001b[27m \b[1;31mAKIA1234567890123456\u001b[7mESC\u001b[27m[m\u001b[7m\"\u001b[27m\r\n\u001b[7mESC\u001b[27m[35md6987af002b122fef54bc0be402062c76488a4d9:ray_processing/process.py\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[36m:\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[32m75\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[36m:\u001b[7mESC\u001b[27m[m    os.environ['AWS_SECRET_ACCESS_KEY'] =  \b\u001b[7m\"\u001b[27m\u001b[7mESC\u001b[27m[1;31mD4w8z9wKN1aVeT3BpQj6kIuN7wH8X0M9KfV5OqzF\u001b[7mESC\u001b[27m[m\u001b[7m\"\u001b[27m\r\n\u001b[7mESC\u001b[27m[35md6987af002b122fef54bc0be402062c76488a4d9:ray_processing/ray_cluster.yaml\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[36m:\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[32m29\u001b[7mESC\u001b[27m[m\u001b[7mESC\u001b[27m[36m:\u001b[7mESC\u001b[27m[m    - echo 'export AWS_ACCESS_KEY_ID \b=\u001b[7mESC\u001b[27m[1;31mAKIA1234567890123456\u001b[7mESC\u001b[27m[m' >> ~/.bashrc\r\n\u001b[7mESC\u001b[27m[35md6987af002b122fef54bc0be402062c76488a4d9:ray_pr"]
