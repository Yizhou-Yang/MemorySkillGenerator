[224.777575, "o", "\u001b[Ks\bs\u001b[KT\bT\u001b[Ku\bu\u001b[KV\bV\u001b[Kw\bw\u001b[KX\bX\u001b[Ky\by\u001b[KZ\bZ\u001b[K0\b0\u001b[K1\b1\u001b[K2\b2\u001b[K3\b3\u001b[K4\b4\u001b[K5\b5\u001b[K6\b6\u001b[K7\b7\u001b[K8\b8\u001b[K9\b9\u001b[K'\b'\u001b[K \b \u001b[KH\bH\u001b[KE\bE\u001b[KA\bA\u001b[KD\bD\r\u001b[K"]
