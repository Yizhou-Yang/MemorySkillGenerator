[225.766764, "o", "\u001b[2;1H                   \u001b[1mSUMMARY\u001b[0m \u001b[1mOF\u001b[0m \u001b[1mLESS\u001b[0m \u001b[1mCOMMANDS\u001b[0m\r\n\u001b[3;1H\r\n\u001b[4;1H      Commands marked with * may be preceded by a number, \u001b[4mN\u001b[24m.\r\n\u001b[5;1H      Notes in parentheses indicate the behavior if \u001b[4mN\u001b[24m is given.\r\n\u001b[6;1H      A key preceded by a caret indicates the Ctrl key; thus ^K is ctrl-K.\r\n\u001b[7;1H\r\n\u001b[8;1H  h  H                 Display this help.\r\n\u001b[9;1H  q  :q  Q  :Q  ZZ     Exit.\r\n\u001b[10;1H ---------------------------------------------------------------------------\r\n\u001b[11;1H\r\n\u001b[12;1H                           \u001b[1mMOVING\u001b[0m\r\n\u001b[13;1H\r\n\u001b[14;1H  e  ^E  j  ^N  CR  *  Forward  one line   (or \u001b[4mN\u001b[24m lines).\r\n\u001b[15;1H  y  ^Y  k  ^K  ^P  *  Backward one line   (or \u001b[4mN\u001b[24m lines).\r\n\u001b[16;1H  f  ^F  ^V  SPACE  *  Forward  one window (or \u001b[4mN\u001b[24m lines).\r\n\u001b[17;1H  b  ^B  ESC-v      *  Backward one window (or \u001b[4mN\u001b[24m lines).\r\n\u001b[18;1H  z                 *  Forward  one window (and set window to \u001b[4mN\u001b[24m).\r\n\u001b[19;1H  w                 *  Backward one window (and set window to "]
