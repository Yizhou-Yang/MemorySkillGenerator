[508.140091, "i", "cat > /tmp/art.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\ncell=80\nfiles='abcdefgh'\nfor r in range(8):\n    for c in range(8):\n        sub=a[r*cell:(r+1)*cell, c*cell:(c+1)*cell]\n        bg=sub[2,2].astype(int)\n        d=np.abs(sub.astype(int)-bg).sum(axis=2)\n        mask=(d>40)\n        if mask.mean()>0.03:\n            # downsample to 20x20\n            small=np.array(Image.fromarray((mask*255).astype('uint8')).resize((20,20)))\n            print('=== %s%d ==='%(files[c],8-r))\n            for y in range(20):\n                line=''.join('#' if small[y,x]>80 else ' ' for x in range(20))\n                print(line)\nEOF\npython3 /tmp/art.py > /tmp/art.txt 2>&1\nwc -l /tmp/art.txt\n"]
