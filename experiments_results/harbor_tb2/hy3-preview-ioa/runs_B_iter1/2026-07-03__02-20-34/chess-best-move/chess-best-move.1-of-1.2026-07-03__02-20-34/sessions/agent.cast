[492.583692, "i", "cat > /tmp/recon2.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\ncell=80\nfiles='abcdefgh'\nfor r in range(8):\n    for c in range(8):\n        sub=a[r*cell:(r+1)*cell, c*cell:(c+1)*cell]\n        bg=sub[2,2].astype(int)\n        d=np.abs(sub.astype(int)-bg).sum(axis=2)\n        frac=(d>40).mean()\n        if frac>0.03:\n            # color detection: mean hue of non-bg pixels\n            mask=d>40\n            cols=sub[mask]\n            print(files[c], 8-r, 'occ=%.2f'%frac, 'R=%.0f G=%.0f B=%.0f'%(cols[:,0].mean(),cols[:,1].mean(),cols[:,2].mean()))\nEOF\npython3 /tmp/recon2.py\n"]
