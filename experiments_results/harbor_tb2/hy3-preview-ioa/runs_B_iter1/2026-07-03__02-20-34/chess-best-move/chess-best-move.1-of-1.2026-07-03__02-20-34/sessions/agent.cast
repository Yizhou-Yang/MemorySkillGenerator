[641.458404, "o", "\u001b[?2004h>         pass\r\n\u001b[?2004l\r\u001b[?2004h> # recompute color by RGB\r\n\u001b[?2004l\r\u001b[?2004h> for (fc,rr) in cells:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.458512, "o", "    c=files.index(fc); r=8-rr\r\n\u001b[?2004l\r\u001b[?2004h>     sub=a[r*cell:(r+1)*cell, c*cell:(c+1)*cell]\r\n\u001b[?2004l\r\u001b[?2004h>     bg=sub[2,2].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h>     d=np.abs(sub.astype(int)-bg).sum(axis=2)\r\n\u001b[?2004l\r\u001b[?2004h>     cols=sub[d>40]\r\n\u001b[?2004l\r\u001b[?2004h>     lum=cols.mean()\r\n\u001b[?2004l\r\u001b[?2004h>     colors.append('W' if lum>140 else 'B')\r\n\u001b[?2004l\r\u001b[?2004h> # cluster\r\n\u001b[?2004l\r\u001b[?2004h> N=len(cells)\r\n\u001b[?2004l\r\u001b[?2004h> dist=[[0]*N for _ in range(N)]\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(N):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.459439, "o", "        dist[i][j]=(masks[i]^masks[j]).mean()\r\n"]
[641.459599, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[641.460299, "o", "assigned=[-1]*N; reps=[]\r\n\u001b[?2004l\r"]
[641.460489, "o", "\u001b[?2004h> for i in range(N):\r\n\u001b[?2004l\r\u001b[?2004h"]
[641.460795, "o", "> "]
[641.460859, "o", "    if assigned[i]!=-1: continue\r\n\u001b[?2004l\r\u001b[?2004h>     assigned[i]=len(reps)\r\n\u001b[?2004l\r"]
[641.461053, "o", "\u001b[?2004h> "]
[641.461102, "o", "    for j in range(i+1,N):"]
[641.461444, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.461493, "o", "        if assigned[j]==-1 and dist[i][j]<0.10:"]
[641.461696, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.461914, "o", "            assigned[j]=len(reps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.462107, "o", "    reps.append([i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.462655, "o", "print('num clusters', len(reps))\r\n\u001b[?2004l\r\u001b[?2004h> for k,grp in enumerate(reps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.462913, "o", "    print('--- cluster',k,'members:',[ (cells[i],colors[i]) for i in grp])\r\n\u001b[?2004l\r"]
[641.463411, "o", "\u001b[?2004h>     rep=masks[grp[0]]\r\n\u001b[?2004l\r\u001b[?2004h>     for y in range(32):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.463793, "o", "        print(''.join('#' if rep[y,x] else ' ' for x in range(32)))"]
[641.463937, "o", "\r\n"]
[641.464062, "o", "\u001b[?2004l\r"]
[641.464202, "o", "\u001b[?2004h"]
