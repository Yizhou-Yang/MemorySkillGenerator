[597.37362, "o", "       #####        \r\n       ####         \r\n       ## #         \r\n       ## #         \r\n       #  ##        \r\n      ######        \r\n          #         \r\n                    \r\n                    \r\n                    \r\n=== e1 ===\r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n        ##          \r\n        ###         \r\n     #########      \r\n    ##  ##   #      \r\n    #    #   #      \r\n    ##   #   #      \r\n     #########      \r\n      #######       \r\n      #     #       \r\n      #######       \r\n          #         \r\n                    \r\n                    \r\n                    \r\n=== h1 ===\r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n                    \r\n     ########       \r\n      #    ##       \r\n      #    #        \r\n       #   #        \r\n                    \r\n                    \r\n       #   #        \r\n      #    #        \r\n      #    ##       \r\n     ########       \r\n          ##        \r\n                    \r\n                    \r\n                    \r\n"]
