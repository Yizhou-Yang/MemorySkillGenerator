[597.373857, "o", "\u001b[?2004hroot@d0c5892a127e:/app# "]
[641.43019, "i", "cat > /tmp/cluster.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\ncell=80\nfiles='abcdefgh'\ncells=[]\nmasks=[]\nfor r in range(8):\n    for c in range(8):\n        sub=a[r*cell:(r+1)*cell, c*cell:(c+1)*cell]\n        bg=sub[2,2].astype(int)\n        d=np.abs(sub.astype(int)-bg).sum(axis=2)\n        mask=(d>40)\n        if mask.mean()>0.03:\n            ys,xs=np.where(mask)\n            y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1\n            m=mask[y0:y1,x0:x1]\n            m=Image.fromarray((m*255).astype('uint8')).resize((32,32))\n            m=np.array(m)>80\n            cells.append((files[c],8-r))\n            masks.append(m)\n# classify color\ncolors=[]\nfor r in range(8):\n    for c in range(8):\n        pass\n# recompute color by RGB\nfor (fc,rr) in cells:\n    c=files.index(fc); r=8-rr\n    sub=a[r*cell:(r+1)*cell, c*cell:(c+1)*cell]\n    bg=sub[2,2].astype(int)\n    d=np.abs(sub.astype(int)-bg).sum(axis=2)\n    cols=sub[d>40]\n    lum=cols.mean()\n    colors.append('W' if lum>140 else 'B')\n# cluster\nN=len(cells)\ndist=[[0]*N for _ in range(N)]\nfor i in range(N):\n    for j in range(N):\n        dist[i][j]=(masks[i]^masks[j]).mean()\nassigned=[-1]*N; reps=[]\nfor i in range(N):\n    if assigned[i]!=-1: continue\n    assigned[i]=len(reps)\n    for j in range(i+1,N):\n        if assigned[j]==-1 and dist[i][j]<0.10:\n            assigned[j]=len(reps)\n    reps.append([i])\nprint('num clusters', len(reps))\nfor k,grp in enumerate(reps):\n    print('--- cluster',k,'members:',[ (cells[i],colors[i]) for i in grp])\n    rep=masks[grp[0]]\n    for y in range(32):\n        print(''.join('#' if rep[y,x] else ' ' for x in range(32)))\nEOF\npython3 /tmp/cluster.py > /tmp/clusters.txt 2>&1\nhead -1 /tmp/clusters.txt\n"]
[641.431095, "o", "cat > /tmp/cluster.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
