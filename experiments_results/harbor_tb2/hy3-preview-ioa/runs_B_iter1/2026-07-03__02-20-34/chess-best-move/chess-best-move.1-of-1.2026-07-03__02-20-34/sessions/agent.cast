[475.163292, "i", "cat > /tmp/recon.py << 'EOF'\nfrom PIL import Image\nimport numpy as np\nim = Image.open('/app/chess_puzzle.png').convert('RGB')\na = np.array(im).astype(int)\nprint('shape', a.shape)\ncell=80\n# determine background colors per cell: corners are background\n# Print occupancy map based on color variance from corner pixel\nfor r in range(8):\n    row=''\n    for c in range(8):\n        sub=a[r*cell:(r+1)*cell, c*cell:(c+1)*cell]\n        # distance of center region from background (corner)\n        bg=sub[2,2].astype(int)\n        d=np.abs(sub.astype(int)-bg).sum(axis=2)\n        frac=(d>40).mean()\n        row+= ('#' if frac>0.03 else '.')\n    print(8-r, row)\nEOF\npython3 /tmp/recon.py\n"]
