[27.511551, "i", "cat > /app/scrape.py << 'EOF'\nimport re\nimport requests\nfrom bs4 import BeautifulSoup\nimport pandas as pd\n\nURL = \"http://server:8000\"\n\ndef main():\n    resp = requests.get(URL, timeout=30)\n    resp.raise_for_status()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n\n    books = []\n    for book in soup.find_all(\"div\", class_=\"book\"):\n        title_el = book.find(\"div\", class_=\"book-title\")\n        author_el = book.find(\"div\", class_=\"book-author\")\n        year_el = book.find(\"span\", class_=\"book-year\")\n        rating_el = book.find(\"span\", class_=\"book-rating\")\n        price_el = book.find(\"span\", class_=\"book-price\")\n\n        title = title_el.get_text(strip=True) if title_el else \"\"\n        author = \"\"\n        if author_el:\n            author = re.sub(r\"^by\\s+\", \"\", author_el.get_text(strip=True))\n        year = \"\"\n        if year_el:\n            m = re.search(r\"(\\d{4})\", year_el.get_text())\n            year = int(m.group(1)) if m else None\n        rating = None\n        if rating_el:\n            m = re.searc"]
[27.51182, "o", "cat > /app/scrape.py << 'EOF'"]
[27.511893, "i", "h(r\"([\\d.]+)/\\s*5\", rating_el.get_text())\n            rating = float(m.group(1)) if m else None\n        price = None\n        if price_el:\n            m = re.search(r\"\\$?\\s*([\\d.]+)\", price_el.get_text())\n            price = float(m.group(1)) if m else None\n\n        books.append({\n            \"title\": title,\n            \"author\": author,\n            \"year\": year,\n            \"rating\": rating,\n            \"price\": price,\n        })\n\n    df = pd.DataFrame(books, columns=[\"title\", \"author\", \"year\", \"rating\", \"price\"])\n    df.to_csv(\"books.csv\", index=False)\n\n    total = len(df)\n    avg_price = df[\"price\"].mean()\n    highest = df.loc[df[\"rating\"].idxmax()]\n\n    lines = []\n    lines.append(\"Book Store Scraping Summary Report\")\n    lines.append(\"=\" * 40)\n    lines.append(f\"Total number of books scraped: {total}\")\n    lines.append(f\"Average book price: ${avg_price:.2f}\")\n    lines.append(f\"Highest rated book: {highest['title']} (Rating: {highest['rating']}/5, by {highest['author']})\")\n\n    with open(\"report.txt\", \"w\""]
[27.512006, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.512115, "i", ") as f:\n        f.write(\"\\n\".join(lines) + \"\\n\")\n\n    print(\"\\n\".join(lines))\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
