[58.798502, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_multi_branch_https_deploy\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m"]
[58.799569, "o", "\r\n"]
[58.79992, "o", "        \u001b[96mopen\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mverify.sh\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mw\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).write(\u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.800191, "o", "\r\n"]
[58.800509, "o", "    \u001b[33m#!/bin/bash\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.801011, "o", "\r\n"]
[58.801325, "o", "    \u001b[33mset -e\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.801623, "o", "\r\n"]
[58.802009, "o", "    \u001b[33m\u001b[39;49;00m"]
[58.802242, "o", "\r\n"]
[58.802621, "o", "    \u001b[33mapt-get update\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.802862, "o", "\r\n"]
[58.803234, "o", "    \u001b[33mDEBIAN_FRONTEND=noninteractive apt-get install -y curl expect git openssh-client\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.806118, "o", "\r\n"]
[58.806925, "o", "    \u001b[33m\u001b[39;49;00m"]
[58.807185, "o", "\r\n"]
[58.807449, "o", "    \u001b[33mmkdir -p ~/.ssh\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.807677, "o", "\r\n"]
[58.80841, "o", "    \u001b[33mecho \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mHost localhost\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.808929, "o", "\r\n"]
[58.809528, "o", "    \u001b[33m    StrictHostKeyChecking no\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.810735, "o", "\r\n"]
[58.811775, "o", "    \u001b[33m    UserKnownHostsFile=/dev/null\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m > ~/.ssh/config\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
