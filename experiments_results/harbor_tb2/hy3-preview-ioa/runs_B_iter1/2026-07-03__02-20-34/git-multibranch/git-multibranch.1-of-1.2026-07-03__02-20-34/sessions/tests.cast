[58.814251, "o", "    \u001b[33mchmod 600 ~/.ssh/config\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m# Expect script to push both branches\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[58.815146, "o", "\r\n    \u001b[33mcat > git_push.exp << \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mEOF\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m#!/usr/bin/expect -f\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mset timeout 20\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33mspawn git clone git@localhost:/git/project project-test\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexpect \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33myes/no\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m send \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33myes\u001b[39;49;00m\u001b[33m\\\\\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m; exp_continue }\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mpassword:\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m send \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mpassword\u001b[39;49;00m\u001b[33m\\\\\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m }\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m}\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexpect eof\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m# main branch\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mspawn bash -c \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mcd project-test && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m                git checkout -b main && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m                echo \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mmain branch content\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m > index.html && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m                git add index.html && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m                git config user.email \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mmain@example.com\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m                git config user.name \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mMain Dev\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m                git commit -m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mmain commit\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexpect eof\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33mspawn bash -c \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mcd project-test && git push origin main\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n"]
[58.815998, "o", "    \u001b[33mexpect \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mpassword:\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33msend \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mpassword\u001b[39;49;00m\u001b[33m\\\\\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexpect eof\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m# dev branch\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mspawn bash -c \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mcd project-test && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m               git checkout -b dev && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m               echo \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mdev branch content\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m > index.html && \u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\r\n    \u001b[33m               git commit -am \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mdev commit\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexpect eof\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33mspawn bash -c \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mcd project-test && git push origin dev\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexpect \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mpassword:\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33msend \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mpassword\u001b[39;49;00m\u001b[33m\\\\\u001b[39;49;00m\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mexpect eof\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u00