[260.403263, "i", "rm -rf /git/project && git init --bare -b main /git/project >/dev/null; cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nGIT_DIR=/git/project\nwhile read oldrev newrev refname; do\n  branch=\"${refname#refs/heads/}\"\n  case \"$branch\" in\n    main) target=/var/www ;;\n    dev) target=/var/www/dev ;;\n    *) continue ;;\n  esac\n  mkdir -p \"$target\"\n  git --git-dir=\"$GIT_DIR\" archive \"$branch\" | tar -x -C \"$target\"\ndone\nEOF\nchmod +x /git/project/hooks/post-receive; chown -R git:git /git/project /var/www; echo RESET_DONE\n"]
[260.406414, "o", "rm -rf /git/project && git init --bare -b main /git/project >/dev/null; cat > /git/project/hooks/post-receive <<'EOF'\r\n\u001b[?2004l\r"]
[260.406614, "o", "\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> GIT_DIR=/git/project\r\n\u001b[?2004l\r\u001b[?2004h> while read oldrev newrev refname; do\r\n\u001b[?2004l\r\u001b[?2004h>   branch=\"${refname#refs/heads/}\"\r\n\u001b[?2004l\r\u001b[?2004h>   case \"$branch\" in\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.406651, "o", "    main) target=/var/www ;;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[260.406844, "o", "    dev) target=/var/www/dev ;;\r\n\u001b[?2004l\r\u001b[?2004h"]
[260.406878, "o", ">     *) continue ;;\r\n\u001b[?2004l\r\u001b[?2004h>   esac\r\n\u001b[?2004l\r\u001b[?2004h>   mkdir -p \"$target\"\r\n\u001b[?2004l\r"]
[260.406915, "o", "\u001b[?2004h> "]
[260.417524, "o", "  git --git-dir=\"$GIT_DIR\" archive \"$branch\" | tar -x -C \"$target\"\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
