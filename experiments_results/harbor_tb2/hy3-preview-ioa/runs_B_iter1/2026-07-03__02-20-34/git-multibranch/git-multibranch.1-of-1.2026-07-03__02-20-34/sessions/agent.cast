[337.279492, "i", "cat > /tmp/sshtest.py <<'EOF'\nimport pty, os, sys, time, select\ncmd=[\"ssh\",\"-o\",\"StrictHostKeyChecking=no\",\"-o\",\"UserKnownHostsFile=/dev/null\",\"-o\",\"PubkeyAuthentication=no\",\"git@localhost\",\"echo AUTH_OK\"]\npid, fd = pty.fork()\nif pid==0:\n    os.execvp(cmd[0],cmd)\nsent=False; buf=b\"\"; start=time.time()\nwhile time.time()-start<15:\n    r,_,_=select.select([fd],[],[],0.3)\n    if r:\n        try: data=os.read(fd,4096)\n        except OSError: break\n        if not data: break\n        buf+=data; sys.stdout.buffer.write(data); sys.stdout.flush()\n        if (not sent) and b\"assword:\" in buf:\n            os.write(fd,b\"password\\n\"); sent=True\n        if b\"AUTH_OK\" in buf:\n            print(\"\\nRESULT: AUTH_OK\"); sys.exit(0)\n        if b\"Permission denied\" in buf:\n            print(\"\\nRESULT: DENIED\"); sys.exit(1)\nprint(\"\\nRESULT: TIMEOUT\")\nEOF\npython3 /tmp/sshtest.py\n"]
[337.280252, "o", "cat > /tmp/sshtest.py <<'EOF'"]
