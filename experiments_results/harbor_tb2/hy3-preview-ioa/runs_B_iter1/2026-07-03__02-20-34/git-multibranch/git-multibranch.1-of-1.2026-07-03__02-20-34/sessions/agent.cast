[99.65781, "i", "cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nGIT_DIR=/git/project\nwhile read oldrev newrev refname; do\n  branch=\"${refname#refs/heads/}\"\n  case \"$branch\" in\n    main) target=/var/www ;;\n    dev) target=/var/www/dev ;;\n    *) continue ;;\n  esac\n  mkdir -p \"$target\"\n  git --git-dir=\"$GIT_DIR\" archive \"$branch\" | tar -x -C \"$target\"\ndone\nEOF\nchmod +x /git/project/hooks/post-receive; chown git:git /git/project/hooks/post-receive; cat /git/project/hooks/post-receive\n"]
