[293.093055, "i", "cat > /tmp/sshtest.py <<'EOF'\nimport pty, os, sys, time, select\ndef main():\n    cmd=[\"ssh\",\"-o\",\"StrictHostKeyChecking=no\",\"-o\",\"UserKnownHostsFile=/dev/null\",\"-o\",\"PubkeyAuthentication=no\",\"git@localhost\",\"echo AUTH_OK\"]\n    pid, fd = pty.fork()\n    if pid==0:\n        os.execvp(cmd[0],cmd)\n    buf=b\"\"; start=time.time()\n    while time.time()-start<15:\n        r,_,_=select.select([fd],[],[],0.2)\n        if r:\n            try: data=os.read(fd,1024)\n            except OSError: break\n            if not data: break\n            buf+=data\n            if b\"assword\" in buf.lower() and b\"AUTH_OK\" not in buf:\n                os.write(fd,b\"password\\n\")\n            if b\"AUTH_OK\" in buf:\n                print(\"RESULT_AUTH_OK\"); break\n    sys.stdout.write(buf.decode(errors='replace'))\nmain()\nEOF\npython3 /tmp/sshtest.py\n"]
[293.093919, "o", "cat > /tmp/sshtest.py <<'EOF'"]
