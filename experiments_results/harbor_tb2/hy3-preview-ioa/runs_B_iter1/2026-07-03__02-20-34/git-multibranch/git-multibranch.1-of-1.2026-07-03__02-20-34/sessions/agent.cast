[396.53264, "i", "rm -rf /git/project; git init --bare -b main /git/project >/dev/null; cat > /git/project/hooks/post-receive <<'EOF'\n#!/bin/bash\nGIT_DIR=/git/project\nwhile read oldrev newrev refname; do\n  branch=\"${refname#refs/heads/}\"\n  case \"$branch\" in\n    main) target=/var/www ;;\n    dev) target=/var/www/dev ;;\n    *) continue ;;\n  esac\n  mkdir -p \"$target\"\n  git --git-dir=\"$GIT_DIR\" archive \"$branch\" | tar -x -C \"$target\"\ndone\nEOF\nchmod +x /git/project/hooks/post-receive; chown -R git:git /git/project /var/www; rm -f /var/www/index.html /var/www/dev/index.html; echo RESET_PRistine_DONE\n"]
