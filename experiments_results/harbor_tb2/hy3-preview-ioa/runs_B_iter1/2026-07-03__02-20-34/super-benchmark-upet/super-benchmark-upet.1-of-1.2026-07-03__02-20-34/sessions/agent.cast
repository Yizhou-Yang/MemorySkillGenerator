[1532.802251, "o", "1:from datasets.load import load_dataset, load_metric\r\n229:        self.metric = load_metric(\"./metrics/super_glue\", data_args.dataset_name)\r\n347:    def compute_metrics(self, p: EvalPrediction):\r\n352:            return self.reocrd_compute_metrics(p)\r\n359:            result = self.metric.compute(predictions=preds, references=p.label_ids)\r\n368:    def reocrd_compute_metrics(self, p: EvalPrediction):\r\n"]
