[138.415996, "i", "cat > /tmp/extract.py << 'EOF'\nimport struct\nISO='/app/alpine.iso'\nf=open(ISO,'rb')\nf.seek(16*2048)\npvd=f.read(2048)\nassert pvd[1:6]==b'CD001', 'not iso9660'\ndef parse(data,i):\n    rl=data[i]\n    if rl==0: return None\n    extent=struct.unpack('<I',data[i+2:i+6])[0]\n    dlen=struct.unpack('<I',data[i+10:i+14])[0]\n    flags=data[i+25]\n    nlen=data[i+32]\n    name=data[i+33:i+33+nlen]\n    return name,extent,dlen,(flags&2),rl\ndef readdir(extent,dlen):\n    f.seek(extent*2048); data=f.read(dlen); out=[]; i=0\n    while i < len(data):\n        rec=parse(data,i)\n        if rec is None:\n            i=((i//2048)+1)*2048; continue\n        name,extent,dlen,isdir,rl=rec; i+=rl\n        nm=name.split(b';')[0]\n        if nm in (b'.',b'\\x00'): continue\n        out.append((nm,extent,dlen,isdir))\n    return out\ndef find_prefix(entries,pref):\n    pref=pref.upper()\n    for nm,e,dl,d in entries:\n        if nm.upper().startswith(pref): return e,dl,d\n    return None\nroot_ext=struct.unpac"]
[138.416101, "i", "k('<I',pvd[158:162])[0]\nroot_len=struct.unpack('<I',pvd[166:170])[0]\nroot=readdir(root_ext,root_len)\nboot=None\nfor nm,e,dl,d in root:\n    if nm.upper()==b'BOOT' and d: boot=(e,dl)\nassert boot, 'no boot dir'\nbootdir=readdir(boot[0],boot[1])\nk=find_prefix(bootdir,b'VMLINUZ')\ni=find_prefix(bootdir,b'INITRAMFS')\nassert k, 'no vmlinuz'; assert i,'no initramfs'\nfor fn,e,dl in [('/tmp/vmlinuz',k[0],k[1]),('/tmp/initramfs',i[0],i[1])]:\n    f.seek(e*2048); d=f.read(dl); open(fn,'wb').write(d); print('wrote',fn,dl)\nEOF\npython3 /tmp/extract.py\n"]
[138.426952, "o", "cat > /tmp/extract.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import struct\r\n\u001b[?2004l\r\u001b[?2004h> ISO='/app/alpine.iso'\r\n\u001b[?2004l\r\u001b[?2004h> f=open(ISO,'rb')\r\n\u001b[?2004l\r\u001b[?2004h> f.seek(16*2048)\r\n\u001b[?2004l\r\u001b[?2004h> pvd=f.read(2048)\r\n\u001b[?2004l\r\u001b[?2004h> assert pvd[1:6]==b'CD001', 'not iso9660'\r\n\u001b[?2004l\r\u001b[?2004h> def parse(data,i):\r\n\u001b[?2004l\r\u001b[?2004h>     rl=data[i]\r\n\u001b[?2004l\r\u001b[?2004h>     if rl==0: return None\r\n\u001b[?2004l\r\u001b[?2004h>     extent=struct.unpack('<I',data[i+2:i+6])[0]\r\n\u001b[?2004l\r\u001b[?2004h>     dlen=struct.unpack('<I',data[i+10:i+14])[0]\r\n\u001b[?2004l\r\u001b[?2004h>     flags=data[i+25]\r\n\u001b[?2004l\r\u001b[?2004h>     nlen=data[i+32]\r\n\u001b[?2004l\r\u001b[?2004h>     name=data[i+33:i+33+nlen]\r\n\u001b[?2004l\r\u001b[?2004h>     return name,extent,dlen,(flags&2),rl\r\n\u001b[?2004l\r\u001b[?2004h> def readdir(extent,dlen):\r\n\u001b[?2004l\r\u001b[?2004h>     f.seek(extent*2048); data=f.read(dlen); out=[]; i=0\r\n\u001b[?2004l\r\u001b[?2004h>     while i < len(data):\r\n\u001b[?2004l\r\u001b[?2004h> "]
