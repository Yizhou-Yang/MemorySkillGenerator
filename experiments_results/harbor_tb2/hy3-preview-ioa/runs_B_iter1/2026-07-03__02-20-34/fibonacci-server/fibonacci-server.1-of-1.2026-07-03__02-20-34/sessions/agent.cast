[18.392772, "i", "cat > /app/server.py << 'EOF'\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\n\ndef fib(n):\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def _send(self, code, payload):\n        body = payload.encode() if isinstance(payload, str) else payload\n        self.send_response(code)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/fib':\n            self._send(404, b'{\"error\": \"not found\"}')\n            return\n        qs = parse_qs(parsed.query)\n        if 'n' not in qs:\n            self._send(400, b'{\"error\": \"missing query param n\"}')\n            return\n        val = qs['n'][0]\n        try:\n            n = int(val)\n        excep"]
[18.393476, "o", "cat > /app/server.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[18.393512, "i", "t (ValueError, TypeError):\n            self._send(400, b'{\"error\": \"n must be an integer\"}')\n            return\n        if n < 0:\n            self._send(400, b'{\"error\": \"n must be non-negative\"}')\n            return\n        result = fib(n)\n        self._send(200, ('{\"result\": %d}' % result).encode())\n\n    def log_message(self, *args):\n        pass\n\n\nif __name__ == '__main__':\n    HTTPServer(('0.0.0.0', 3000), Handler).serve_forever()\nEOF\n"]
