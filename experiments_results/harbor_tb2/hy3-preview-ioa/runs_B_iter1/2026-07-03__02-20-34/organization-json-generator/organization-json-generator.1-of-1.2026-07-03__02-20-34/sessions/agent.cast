[57.664145, "o", "budgets = [float(d['budget']) for d in departments]\r\n\u001b[?2004l\r\u001b[?2004h> avg_budget = sum(budgets) / len(budgets) if budgets else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> skill_dist = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h> for e in employees:\r\n\u001b[?2004l\r\u001b[?2004h>     for s in e['skills'].split(';'):\r\n\u001b[?2004l\r\u001b[?2004h>         s = s.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if s:\r\n\u001b[?2004l\r\u001b[?2004h>             skill_dist[s] += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> dept_sizes = {d['name']: len([e for e in employees if e['department_id'] == d['id']]) for d in departments}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> status_dist = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h> for p in projects:\r\n\u001b[?2004l\r\u001b[?2004h>     status_dist[p['status']] += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> out = {\r\n\u001b[?2004l\r\u001b[?2004h>     'metadata': {\r\n\u001b[?2004l\r\u001b[?2004h>         'version': '1.0',\r\n\u001b[?2004l\r\u001b[?2004h>         'timestamp': datetime.datetime.now().isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h>         'generator': 'csv-to-json-processor',\r\n\u001b[?200"]
[57.664213, "o", "4l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     'organization': {\r\n\u001b[?2004l\r\u001b[?2004h>         'name': 'TechCorp Organization',\r\n\u001b[?2004l\r\u001b[?2004h>         'founded': '2000-01-01',\r\n\u001b[?2004l\r\u001b[?2004h>         'departments': dept_list,\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     'statistics': {\r\n\u001b[?2004l\r\u001b[?2004h>         'averageDepartmentBudget': avg_budget,\r\n\u001b[?2004l\r\u001b[?2004h>         'totalEmployees': total_employees,\r\n\u001b[?2004l\r\u001b[?2004h>         'skillDistribution': dict(skill_dist),\r\n\u001b[?2004l\r\u001b[?2004h>         'departmentSizes': dept_sizes,\r\n\u001b[?2004l\r\u001b[?2004h>         'projectStatusDistribution': dict(status_dist),\r\n\u001b[?2004l\r\u001b[?2004h>         'averageYearsOfService': avg_years,\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
