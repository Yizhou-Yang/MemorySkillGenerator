[57.507376, "i", "cat > /app/process.py << 'PYEOF'\nimport csv, json, datetime, os\nfrom collections import defaultdict\n\nDATA = os.path.join(os.path.dirname(__file__), 'data')\n\ndef read_csv(name):\n    with open(os.path.join(DATA, name), newline='', encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\ndepartments = read_csv('departments.csv')\nemployees = read_csv('employees.csv')\nprojects = read_csv('projects.csv')\n\ndept_by_id = {d['id']: d for d in departments}\nemp_by_id = {e['id']: e for e in employees}\n\n# build departments with nested employees and projects\ndept_list = []\nfor d in departments:\n    did = d['id']\n    dept_emps = [e for e in employees if e['department_id'] == did]\n    emp_objs = []\n    for e in dept_emps:\n        skills = [s.strip() for s in e['skills'].split(';') if s.strip()]\n        emp_objs.append({\n            'id': e['id'],\n            'name': e['name'],\n            'position': e['position'],\n            'skills': skills,\n            'years_of_servi"]
