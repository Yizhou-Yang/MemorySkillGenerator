[57.513888, "i", "ce': int(e['years_of_service']),\n        })\n    dept_projs = [p for p in projects if p['department_id'] == did]\n    proj_objs = []\n    for p in dept_projs:\n        members = [m.strip() for m in p['member_ids'].split(';') if m.strip()]\n        proj_objs.append({\n            'name': p['name'],\n            'status': p['status'],\n            'members': members,\n            'deadline': p['deadline'],\n        })\n    dept_list.append({\n        'id': d['id'],\n        'name': d['name'],\n        'budget': float(d['budget']),\n        'employees': emp_objs,\n        'projects': proj_objs,\n    })\n\n# statistics\ntotal_employees = len(employees)\nyears = [int(e['years_of_service']) for e in employees]\navg_years = sum(years) / len(years) if years else 0\n\nbudgets = [float(d['budget']) for d in departments]\navg_budget = sum(budgets) / len(budgets) if budgets else 0\n\nskill_dist = defaultdict(int)\nfor e in employees:\n    for s in e['skills'].split(';'):\n        s = s.strip()\n        if s:\n            skill_dist[s] += 1\n\ndept_sizes "]
[57.513948, "i", "= {d['name']: len([e for e in employees if e['department_id'] == d['id']]) for d in departments}\n\nstatus_dist = defaultdict(int)\nfor p in projects:\n    status_dist[p['status']] += 1\n\nout = {\n    'metadata': {\n        'version': '1.0',\n        'timestamp': datetime.datetime.now().isoformat(),\n        'generator': 'csv-to-json-processor',\n    },\n    'organization': {\n        'name': 'TechCorp Organization',\n        'founded': '2000-01-01',\n        'departments': dept_list,\n    },\n    'statistics': {\n        'averageDepartmentBudget': avg_budget,\n        'totalEmployees': total_employees,\n        'skillDistribution': dict(skill_dist),\n        'departmentSizes': dept_sizes,\n        'projectStatusDistribution': dict(status_dist),\n        'averageYearsOfService': avg_years,\n    },\n}\n\nwith open(os.path.join(os.path.dirname(__file__), 'organization.json'), 'w', encoding='utf-8') as f:\n    json.dump(out, f, indent=2, ensure_ascii=False)\n\nprint('Wrote organization.json')\n"]
[57.514015, "i", "print('departments:', len(dept_list), 'employees:', total_employees, 'projects:', len(projects))\nPYEOF\n"]
