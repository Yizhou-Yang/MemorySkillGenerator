[27.931248, "i", "python3 -c \"\nimport csv\nfrom datetime import datetime\ndef norm(d):\n    d=d.split()[0]\n    for fmt in ('%Y-%m-%d','%m/%d/%Y','%m-%d-%Y'):\n        try:\n            return datetime.strptime(d,fmt).strftime('%Y-%m-%d')\n        except: pass\n    return None\nhigh={}; low={}\nfor f,dst in (('daily_temp_sf_high.csv',high),('daily_temp_sf_low.csv',low)):\n    with open(f) as fh:\n        r=csv.reader(fh); next(r)\n        for row in r:\n            if not row: continue\n            dst[norm(row[0])]=float(row[1])\ndiffs=[high[d]-low[d] for d in high if d in low]\navg=sum(diffs)/len(diffs)\nwith open('avg_temp.txt','w') as o:\n    o.write(str(avg))\nprint(diffs, avg)\n\"\n"]
[27.931814, "o", "python3 -c \"\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> def norm(d):\r\n\u001b[?2004l\r\u001b[?2004h>     d=d.split()[0]\r\n\u001b[?2004l\r\u001b[?2004h>     for fmt in ('%Y-%m-%d','%m/%d/%Y','%m-%d-%Y'):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             return datetime.strptime(d,fmt).strftime('%Y-%m-%d')\r\n\u001b[?2004l\r\u001b[?2004h>         except: pass\r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\n\u001b[?2004l\r\u001b[?2004h> high={}; low={}\r\n\u001b[?2004l\r\u001b[?2004h> for f,dst in (('daily_temp_sf_high.csv',high),('daily_temp_sf_low.csv',low)):\r\n\u001b[?2004l\r\u001b[?2004h"]
