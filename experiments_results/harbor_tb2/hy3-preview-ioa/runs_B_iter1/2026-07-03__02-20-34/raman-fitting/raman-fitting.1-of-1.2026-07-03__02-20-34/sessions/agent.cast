[350.155371, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        data.append((float(p[0]),float(p[1])))\nd=np.array(data); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\n\ndef lor(x,x0,gamma,amp,offset):\n    return offset + amp/(1.0+((x-x0)/gamma)**2)\n\ndef fit_band(xmin,xmax,label):\n    m=(x>=xmin)&(x<=xmax)\n    xb=x[m]; yb=y[m]\n    offset0=float(np.median(yb))\n    i=int(np.argmax(yb)); x00=xb[i]; amp0=yb[i]-offset0; gamma0=300.0\n    popt,pcov=curve_fit(lor,xb,yb,p0=[x00,gamma0,amp0,offset0],maxfev=200000)\n    resid=yb-lor(xb,*popt)\n    r2=1-np.sum(resid**2)/np.sum((yb-yb.mean())**2)\n    print(f'{label}: x0={popt[0]:.3f} gamma={popt[1]:.3f} amp={popt[2]:.3f} offset={popt[3]:.3f} R2={r2:.4f}')\n    return popt\n\ng=fit_band(15450,17050,'G')\nd2d=fit_band(26200,28200,'2D')\nresult={'G':{'x0':float(g"]
[350.15556, "i", "[0]),'gamma':float(g[1]),'amplitude':float(g[2]),'offset':float(g[3])},\n        '2D':{'x0':float(d2d[0]),'gamma':float(d2d[1]),'amplitude':float(d2d[2]),'offset':float(d2d[3])}}\nwith open('results.json','w') as f:\n    json.dump(result,f,indent=2)\nprint('Wrote results.json')\nEOF\npython3 fit.py\n"]
