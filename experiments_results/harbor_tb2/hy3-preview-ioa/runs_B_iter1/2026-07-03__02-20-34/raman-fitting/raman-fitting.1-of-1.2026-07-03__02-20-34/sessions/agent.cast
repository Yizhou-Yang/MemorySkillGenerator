[123.839701, "i", "cat > explore.py << 'EOF'\nimport numpy as np\n\ndata = []\nwith open('graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        p = line.replace(',', '.').split()\n        if len(p) < 2: continue\n        data.append((float(p[0]), float(p[1])))\nd = np.array(data)\nx = d[:,0]; y = d[:,1]\norder = np.argsort(x); x = x[order]; y = y[order]\nprint('x range', x.min(), x.max())\nprint('y range', y.min(), y.max())\n# find local maxima\nmaxs = []\nfor i in range(1, len(y)-1):\n    if y[i] > y[i-1] and y[i] >= y[i+1] and y[i] > y.mean()+2*y.std():\n        maxs.append((x[i], y[i]))\nprint('num candidate maxima', len(maxs))\nfor mx, my in sorted(maxs):\n    print(f'{mx:10.2f}  {my:10.2f}')\nEOF\npython3 explore.py\n"]
