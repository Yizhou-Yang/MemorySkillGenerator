[192.065811, "i", "cat > fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata = []\nwith open('graphene.dat') as f:\n    for line in f:\n        line = line.strip()\n        if not line: continue\n        p = line.replace(',', '.').split()\n        if len(p) < 2: continue\n        data.append((float(p[0]), float(p[1])))\nd = np.array(data)\nx = d[:,0]; y = d[:,1]\norder = np.argsort(x); x = x[order]; y = y[order]\n\ndef lor(x, x0, gamma, amp, offset):\n    return offset + amp / (1.0 + ((x - x0) / gamma)**2)\n\ndef fit_band(xmin, xmax, label):\n    m = (x >= xmin) & (x <= xmax)\n    xb = x[m]; yb = y[m]\n    offset0 = np.median(yb)\n    i = np.argmax(yb)\n    x00 = xb[i]; amp0 = yb[i] - offset0; gamma0 = 200.0\n    p0 = [x00, gamma0, amp0, offset0]\n    popt, pcov = curve_fit(lor, xb, yb, p0=p0, maxfev=100000)\n    perr = np.sqrt(np.diag(pcov))\n    resid = yb - lor(xb, *popt)\n    ss_res = np.sum(resid**2); ss_tot = np.sum((yb-yb.mean())**2)\n    r2 = 1 - ss_res/ss_tot\n    print(f'{label}: x0={popt[0]:.3f} gamma={pop"]
[192.065873, "i", "t[1]:.3f} amp={popt[2]:.3f} offset={popt[3]:.3f}  R2={r2:.4f}')\n    print(f'   err: x0={perr[0]:.2f} gamma={perr[1]:.2f} amp={perr[2]:.2f} offset={perr[3]:.2f}')\n    return popt\n\ng = fit_band(14800, 17400, 'G')\nd2d = fit_band(25000, 27500, '2D')\n\nresult = {\n    'G': {'x0': float(g[0]), 'gamma': float(g[1]), 'amplitude': float(g[2]), 'offset': float(g[3])},\n    '2D': {'x0': float(d2d[0]), 'gamma': float(d2d[1]), 'amplitude': float(d2d[2]), 'offset': float(d2d[3])},\n}\nwith open('results.json','w') as f:\n    json.dump(result, f, indent=2)\nprint('Wrote results.json')\nEOF\npython3 fit.py\n"]
