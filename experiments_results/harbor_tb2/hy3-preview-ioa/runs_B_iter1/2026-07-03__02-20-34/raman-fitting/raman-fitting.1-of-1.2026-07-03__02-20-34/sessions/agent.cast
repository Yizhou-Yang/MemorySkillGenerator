[192.103481, "o", "> "]
[192.103668, "o", "}"]
[192.103865, "o", "\r\n"]
[192.104101, "o", "\u001b[?2004l\r"]
[192.104318, "o", "\u001b[?2004h"]
[192.104503, "o", "> "]
[192.104788, "o", "with open('results.json','w') as f:"]
[192.110862, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(result, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print('Wrote results.json')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
