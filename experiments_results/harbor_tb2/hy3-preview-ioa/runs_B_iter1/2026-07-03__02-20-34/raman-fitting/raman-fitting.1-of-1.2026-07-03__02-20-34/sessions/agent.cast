[409.195728, "i", "cat > peaks.py << 'EOF'\nimport numpy as np\nfrom scipy.signal import find_peaks\ndata=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        data.append((float(p[0]),float(p[1])))\nd=np.array(data); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\n# smooth\nfrom scipy.ndimage import uniform_filter1d\nys=uniform_filter1d(y,size=9)\npk,props=find_peaks(ys,prominence=500,width=2)\nprint('detected peaks (smoothed):')\nfor xi in pk:\n    print(f'  x={x[xi]:.1f} yraw={y[xi]:.0f} ysm={ys[xi]:.0f} prom={props[\"prominences\"][list(pk).index(xi)]:.0f}')\nEOF\npython3 peaks.py\n"]
[409.197034, "o", "cat > peaks.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.signal import find_peaks\r\n\u001b[?2004l\r\u001b[?2004h> data=[]\r\n\u001b[?2004l\r\u001b[?2004h> with open('graphene.dat') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h>         line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if not line: continue\r\n\u001b[?2004l\r\u001b[?2004h>         p=line.replace(',','.').split()\r\n\u001b[?2004l\r\u001b[?2004h>         if len(p)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>         data.append((float(p[0]),float(p[1])))\r\n\u001b[?2004l\r\u001b[?2004h"]
[409.197272, "o", "> "]
