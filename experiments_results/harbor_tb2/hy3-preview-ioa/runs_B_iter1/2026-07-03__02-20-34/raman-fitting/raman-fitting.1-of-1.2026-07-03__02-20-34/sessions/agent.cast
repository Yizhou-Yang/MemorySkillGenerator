[501.336693, "o", "    return offset + amp/(1.0+((x-x0)/gamma)**2)"]
[501.338972, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fit_band(xmin,xmax,center,label):\r\n\u001b[?2004l\r\u001b[?2004h>     m=(x>=xmin)&(x<=xmax)\r\n\u001b[?2004l\r\u001b[?2004h>     xb=x[m]; yb=y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     offset0=float(np.median(yb))\r\n\u001b[?2004l\r\u001b[?2004h>     i=int(np.argmin(np.abs(xb-center)))\r\n\u001b[?2004l\r\u001b[?2004h>     x00=xb[i]; amp0=max(yb[i]-offset0,1.0); gamma0=300.0\r\n\u001b[?2004l\r\u001b[?2004h>     bnds=([center-2000,20,0,offset0-10000],[center+2000,3000,1e6,offset0+10000])\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         popt,pcov=curve_fit(lor,xb,yb,p0=[x00,gamma0,amp0,offset0],bounds=bnds,maxfev=200000)\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>         print(label,'FAILED',e); return None\r\n\u001b[?2004l\r\u001b[?2004h>     resid=yb-lor(xb,*popt)\r\n\u001b[?2004l\r\u001b[?2004h>     r2=1-np.sum(resid**2)/np.sum((yb-yb.mean())**2)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{label}: x0={popt[0]:.2f} gamma={popt[1]:.2f} amp={popt[2]:.2f} offset={popt[3]:.2f} R2={r2:.4f}  (n={len(xb)})')\r\n\u001b[?2004l\r\u001b[?2004h>     return popt\r\n\u001b[?2004l\r"]
