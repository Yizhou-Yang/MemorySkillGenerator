[192.084511, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.084642, "o", "def lor(x, x0, gamma, amp, offset):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.084816, "o", "    return offset + amp / (1.0 + ((x - x0) / gamma)**2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.084911, "o", "def fit_band(xmin, xmax, label):\r\n\u001b[?2004l\r\u001b[?2004h"]
[192.084932, "o", "> "]
[192.085057, "o", "    m = (x >= xmin) & (x <= xmax)\r\n\u001b[?2004l\r"]
[192.085141, "o", "\u001b[?2004h"]
[192.085246, "o", "> "]
[192.085419, "o", "    xb = x[m]; yb = y[m]\r\n\u001b[?2004l\r"]
[192.085466, "o", "\u001b[?2004h> "]
[192.085527, "o", "    offset0 = np.median(yb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.085604, "o", "    i = np.argmax(yb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[192.085625, "o", "> "]
[192.086076, "o", "    x00 = xb[i]; amp0 = yb[i] - offset0; gamma0 = 200.0\r\n\u001b[?2004l\r\u001b[?2004h>     p0 = [x00, gamma0, amp0, offset0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.086229, "o", "    popt, pcov = curve_fit(lor, xb, yb, p0=p0, maxfev=100000)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.086375, "o", "    perr = np.sqrt(np.diag(pcov))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.086668, "o", "    resid = yb - lor(xb, *popt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.087273, "o", "    ss_res = np.sum(resid**2); ss_tot = np.sum((yb-yb.mean())**2)"]
[192.087369, "o", "\r\n"]
[192.087467, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[192.08766, "o", "    r2 = 1 - ss_res/ss_tot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.088069, "o", "    print(f'{label}: x0={popt[0]:.3f} gamma={popt[1]:.3f} amp={popt[2]:.3f} offset={popt[3]:.3f}  R2={r2:.4f}')\r\n\u001b[?2004l\r"]
[192.088169, "o", "\u001b[?2004h> "]
[192.088472, "o", "    print(f'   err: x0={perr[0]:.2f} gamma={perr[1]:.2f} amp={perr[2]:.2f} offset={perr[3]:.2f}')\r\n\u001b[?2004l\r"]
[192.088497, "o", "\u001b[?2004h> "]
[192.088635, "o", "    return popt\r\n\u001b[?2004l\r"]
[192.088767, "o", "\u001b[?2004h> "]
[192.088806, "o", "\r\n\u001b[?2004l\r"]
[192.088998, "o", "\u001b[?2004h> "]
[192.089388, "o", "g = fit_band(14800, 17400, 'G')\r\n\u001b[?2004l\r"]
[192.092436, "o", "\u001b[?2004h"]
[192.09435, "o", "> "]
[192.096337, "o", "d2d = fit_band(25000, 27500, '2D')"]
[192.096631, "o", "\r\n"]
[192.096905, "o", "\u001b[?2004l\r"]
[192.097367, "o", "\u001b[?2004h"]
[192.097542, "o", "> "]
[192.09773, "o", "\r\n"]
[192.09803, "o", "\u001b[?2004l\r"]
[192.098558, "o", "\u001b[?2004h"]
[192.098755, "o", "> "]
[192.099039, "o", "result = {"]
[192.099583, "o", "\r\n"]
[192.099829, "o", "\u001b[?2004l\r"]
[192.100094, "o", "\u001b[?2004h"]
[192.100296, "o", "> "]
[192.10074, "o", "    'G': {'x0': float(g[0]), 'gamma': float(g[1]), 'amplitude': float(g[2]), 'offset': float(g[3])},"]
[192.100969, "o", "\r\n"]
[192.10118, "o", "\u001b[?2004l\r"]
[192.101417, "o", "\u001b[?2004h"]
[192.1016, "o", "> "]
[192.10266, "o", "    '2D': {'x0': float(d2d[0]), 'gamma': float(d2d[1]), 'amplitude': float(d2d[2]), 'offset': float(d2d[3])},"]
[192.102868, "o", "\r\n"]
[192.10305, "o", "\u001b[?2004l\r"]
