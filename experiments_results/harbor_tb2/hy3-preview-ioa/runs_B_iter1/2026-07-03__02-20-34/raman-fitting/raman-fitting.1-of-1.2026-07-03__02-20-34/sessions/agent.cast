[549.911768, "i", "cat > final_fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndata=[]\nwith open('graphene.dat') as f:\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        p=line.replace(',','.').split()\n        if len(p)<2: continue\n        data.append((float(p[0]),float(p[1])))\nd=np.array(data); x=d[:,0]; y=d[:,1]\no=np.argsort(x); x=x[o]; y=y[o]\n\ndef lor(x,x0,gamma,amp,offset):\n    return offset + amp/(1.0+((x-x0)/gamma)**2)\n\ndef fit_band(xmin,xmax,center,label):\n    m=(x>=xmin)&(x<=xmax); xb=x[m]; yb=y[m]\n    off=float(np.median(yb)); i=int(np.argmin(np.abs(xb-center)))\n    x0c=xb[i]; a0=max(yb[i]-off,1.0)\n    bnds=([center-800,20,0,off-5000],[center+800,3000,1e6,off+5000])\n    popt,_=curve_fit(lor,xb,yb,p0=[x0c,300,a0,off],bounds=bnds,maxfev=200000)\n    r=1-np.sum((yb-lor(xb,*popt))**2)/np.sum((yb-yb.mean())**2)\n    print(f'{label}: x0={popt[0]:.3f} gamma={popt[1]:.3f} amp={popt[2]:.3f} off={popt[3]:.3f} R2={r:.4f}')\n    return popt\n\ng=fit_band(15800,16600,1"]
[549.912145, "i", "6245,'G')\nd2d=fit_band(32000,34500,33245,'2D')\n\nresult={\n  'G':{'x0':float(g[0]),'gamma':float(abs(g[1])),'amplitude':float(g[2]),'offset':float(g[3])},\n  '2D':{'x0':float(d2d[0]),'gamma':float(abs(d2d[1])),'amplitude':float(d2d[2]),'offset':float(d2d[3])}\n}\nwith open('results.json','w') as f:\n    json.dump(result,f,indent=2)\nprint('Wrote results.json')\nEOF\npython3 final_fit.py\n"]
[549.912417, "o", "cat > final_fit.py << 'EOF'"]
