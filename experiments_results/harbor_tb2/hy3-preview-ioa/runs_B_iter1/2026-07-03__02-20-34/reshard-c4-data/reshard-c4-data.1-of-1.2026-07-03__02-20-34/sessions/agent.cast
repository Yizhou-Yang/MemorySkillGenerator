[404.982025, "i", "cat > /app/build_reshard.py << 'EOF'\nimport os, shutil\nSRC = \"/app/c4_sample\"\nDST = \"/app/c4_reshard\"\nPER = 30\nfiles = sorted(os.listdir(SRC))\nos.makedirs(DST, exist_ok=True)\nfor i, f in enumerate(files):\n    b = i // PER\n    d = os.path.join(DST, \"%03d\" % b)\n    os.makedirs(d, exist_ok=True)\n    shutil.copy2(os.path.join(SRC, f), os.path.join(d, f))\nprint(\"copied\", len(files), \"files into\", (len(files) + PER - 1)//PER, \"buckets\")\nEOF\n"]
[404.982461, "o", "cat > /app/build_reshard.py << 'EOF'"]
[404.982569, "o", "\r\n"]
