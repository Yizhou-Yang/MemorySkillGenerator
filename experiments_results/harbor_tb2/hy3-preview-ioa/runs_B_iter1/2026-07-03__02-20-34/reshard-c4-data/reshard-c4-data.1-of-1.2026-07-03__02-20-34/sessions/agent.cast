[665.893661, "i", "cat > /app/revert.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"Revert the contents of c4_reshard/ back into the original c4_sample/ layout.\n\nc4_reshard/ was produced by moving the files from c4_sample/ into\nbucket subdirectories (at most 30 files per bucket). This script moves them\nall back and removes the now-empty c4_reshard/ tree, restoring c4_sample/\nexactly as it was originally.\n\"\"\"\nimport os\nimport shutil\n\nSAMPLE = \"/app/c4_sample\"\nRESHARD = \"/app/c4_reshard\"\n\n\ndef main():\n    if not os.path.isdir(RESHARD):\n        raise SystemExit(\"Nothing to revert: %s not found\" % RESHARD)\n    os.makedirs(SAMPLE, exist_ok=True)\n\n    # Move every file from each bucket back into c4_sample/.\n    for bucket in sorted(os.listdir(RESHARD)):\n        bdir = os.path.join(RESHARD, bucket)\n        if not os.path.isdir(bdir):\n            continue\n        for name in os.listdir(bdir):\n            src = os.path.join(bdir, name)\n            if not os.path.isfile(src):\n                continu"]
[665.893776, "i", "e\n            dst = os.path.join(SAMPLE, name)\n            if os.path.exists(dst):\n                raise SystemExit(\"Refusing to overwrite existing file: %s\" % dst)\n            os.rename(src, dst)\n\n    # Remove the (now empty) bucket directories and the c4_reshard tree.\n    shutil.rmtree(RESHARD)\n    print(\"Reverted c4_reshard/ back into c4_sample/\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
