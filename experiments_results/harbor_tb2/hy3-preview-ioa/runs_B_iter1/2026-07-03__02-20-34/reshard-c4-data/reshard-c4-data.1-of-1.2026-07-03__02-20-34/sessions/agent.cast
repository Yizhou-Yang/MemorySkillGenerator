[588.077177, "i", "cat > /app/reshard.py << 'EOF'\nimport os\nSRC = \"/app/c4_sample\"\nDST = \"/app/c4_reshard\"\nPER = 30\nfiles = sorted(os.listdir(SRC))\nos.makedirs(DST, exist_ok=True)\nfor i, f in enumerate(files):\n    b = i // PER\n    d = os.path.join(DST, \"%03d\" % b)\n    os.makedirs(d, exist_ok=True)\n    os.rename(os.path.join(SRC, f), os.path.join(d, f))\nprint(\"moved\", len(files), \"files into\", (len(files) + PER - 1)//PER, \"buckets\")\nEOF\n"]
[588.07789, "o", "cat > /app/reshard.py << 'EOF'\r\nimport os\r\nSRC = \"/app/c4_sample\"\r\nDST = \"/app/c4_reshard\"\r\nPER = 30\r\nfiles = sorted(os.listdir(SRC))\r\nos.makedirs(DST, exist_ok=True)\r\nfor i, f in enumerate(files):\r\n    b = i // PER\r\n    d = os.path.join(DST, \"%03d\" % b)\r\n    os.makedirs(d, exist_ok=True)\r\n    os.rename(os.path.join(SRC, f), os.path.join(d, f))\r\nprint(\"moved\", len(files), \"files into\", (len(files) + PER - 1)//PER, \"buckets\")\r\nEOF\r\n"]
[588.296877, "i", "python3 /app/reshard.py\n"]
[588.297132, "o", "python3 /app/reshard.py\r\n"]
