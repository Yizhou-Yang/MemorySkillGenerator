[234.223185, "i", "cat > /app/explore.py << 'EOF'\nimport numpy as np\n# convert: replace comma decimal separator\ndata = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nc1 = np.array([float(s.replace(',', '.')) for s in data[:,0]])\nc2 = np.array([float(s.replace(',', '.')) for s in data[:,1]])\nprint('c1 range', c1.min(), c1.max(), 'len', len(c1))\nprint('c2 range', c2.min(), c2.max(), 'len', len(c2))\nprint('c1 monotonic decreasing?', np.all(np.diff(c1)<0))\nprint('c2 monotonic?', np.all(np.diff(c2)>0), np.all(np.diff(c2)<0))\n# check if 1580 and 2700 present\ndef near(arr, v, tol):\n    return np.where(np.abs(arr-v)<tol)[0]\nprint('c2 near 1580:', near(c2,1580,5))\nprint('c1 near 1580:', near(c1,1580,5))\nprint('c2 near 2700:', near(c2,2700,5))\nprint('c1 near 2700:', near(c1,2700,5))\nEOF\npython3 /app/explore.py\n"]
