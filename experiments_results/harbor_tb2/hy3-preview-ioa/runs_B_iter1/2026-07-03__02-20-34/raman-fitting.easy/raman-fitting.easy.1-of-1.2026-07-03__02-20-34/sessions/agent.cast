[644.638432, "i", "cat > /app/fit2.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\ndata = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nc1 = np.array([float(s.replace(',', '.')) for s in data[:,0]])\nc2 = np.array([float(s.replace(',', '.')) for s in data[:,1]])\nx = c2; y = c1\n\ndef lor(x, x0, gamma, amp, off):\n    return off + amp/(1.0 + ((x-x0)/gamma)**2)\n\ndef fit_window(lo, hi, label):\n    m=(x>lo)&(x<hi); xf,yf=x[m],y[m]\n    off0=np.median(yf)\n    amp0=yf.max()-off0\n    x0_0=xf[np.argmax(yf)]\n    best=None\n    for g0 in [8,12,15,20,25,30]:\n        try:\n            popt,_=curve_fit(lor,xf,yf,p0=[x0_0,g0,amp0,off0],maxfev=500000)\n            pred=lor(xf,*popt)\n            r2=1-np.sum((yf-pred)**2)/np.sum((yf-yf.mean())**2)\n            if best is None or r2>best[1]:\n                best=(popt,r2)\n        except Exception as e:\n            pass\n    popt,r2=best\n    x0,gamma,amp,off=popt\n    print(f'{label}: x0={x0:.2f} gamma={gamma:.2f} amp={amp:.2f}"]
[644.638774, "o", "cat > /app/fit2.py << 'EOF'"]
