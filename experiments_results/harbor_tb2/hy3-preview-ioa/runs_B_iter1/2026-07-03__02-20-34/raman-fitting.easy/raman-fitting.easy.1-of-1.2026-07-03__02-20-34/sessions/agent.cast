[378.791971, "i", "cat > /app/explore4.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nc1 = np.array([float(s.replace(',', '.')) for s in data[:,0]])\nc2 = np.array([float(s.replace(',', '.')) for s in data[:,1]])\n# histogram of c2 in 1500-1700 and 2600-2800\nfor lo,hi,name in [(1500,1700,'G'),(2600,2800,'2D')]:\n    m=(c2>=lo)&(c2<hi)\n    print(f'--- {name}: c2 in [{lo},{hi}], {m.sum()} points; c1 range {c1[m].min():.1f}-{c1[m].max():.1f}')\n    xs=np.sort(c2[m]); ys=c1[m][np.argsort(c2[m])]\n    for x,y in zip(xs,ys):\n        print(f'  {x:9.3f}  {y:9.3f}')\nEOF\npython3 /app/explore4.py\n"]
[378.792411, "o", "cat > /app/explore4.py << 'EOF'"]
