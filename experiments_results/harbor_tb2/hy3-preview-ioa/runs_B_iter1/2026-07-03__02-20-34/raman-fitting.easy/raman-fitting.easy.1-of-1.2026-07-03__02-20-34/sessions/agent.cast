[275.663936, "o", "\u001b[?2004hroot@d158d1a80b24:/app# "]
[332.733984, "i", "cat > /app/explore3.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nc1 = np.array([float(s.replace(',', '.')) for s in data[:,0]])\nc2 = np.array([float(s.replace(',', '.')) for s in data[:,1]])\n\n# Interpretation B: x=c2 (wavenumber), y=c1 (intensity)\norder = np.argsort(c2)\nx = c2[order]; y = c1[order]\nN = 120\nbins = np.linspace(x.min(), x.max(), N+1)\ncenters = 0.5*(bins[:-1]+bins[1:])\navg = np.zeros(N)\nfor i in range(N):\n    m = (x>=bins[i])&(x<bins[i+1])\n    avg[i] = y[m].mean() if m.any() else np.nan\nprint('=== Interp B: x=c2(wavenumber), y=c1(intensity), binned ===')\nfor c,a in zip(centers, avg):\n    if not np.isnan(a) and 1400<c<2900:\n        print(f'{c:8.1f}  {a:8.1f}')\nEOF\npython3 /app/explore3.py\n"]
[332.734944, "o", "cat > /app/explore3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> data = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\r\n\u001b[?2004l\r\u001b[?2004h> c1 = np.array([float(s.replace(',', '.')) for s in data[:,0]])\r\n\u001b[?2004l\r\u001b[?2004h> c2 = np.array([float(s.replace(',', '.')) for s in data[:,1]])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Interpretation B: x=c2 (wavenumber), y=c1 (intensity)\r\n\u001b[?2004l\r\u001b[?2004h> order = np.argsort(c2)"]
