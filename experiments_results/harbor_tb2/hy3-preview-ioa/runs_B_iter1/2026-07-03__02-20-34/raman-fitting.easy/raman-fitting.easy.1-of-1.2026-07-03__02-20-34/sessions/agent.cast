[488.120936, "i", "cat > /app/fittest.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\ndata = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\nc1 = np.array([float(s.replace(',', '.')) for s in data[:,0]])\nc2 = np.array([float(s.replace(',', '.')) for s in data[:,1]])\nx = c2; y = c1\ndef lor(x, x0, gamma, amp, off):\n    return off + amp/(1.0 + ((x-x0)/gamma)**2)\nfor name, lo, hi, x0g in [('G',1500,1700,1580),('2D',2600,2800,2700)]:\n    m=(x>lo)&(x<hi); xf,yf=x[m],y[m]\n    off0=np.median(yf); amp0=yf.max()-yf.min()\n    p0=[x0g,30,amp0,off0]\n    popt,_=curve_fit(lor,xf,yf,p0=p0,maxfev=200000)\n    x0,gamma,amp,off=popt\n    pred=lor(xf,*popt)\n    ss_res=np.sum((yf-pred)**2); ss_tot=np.sum((yf-yf.mean())**2)\n    r2=1-ss_res/ss_tot\n    print(f'{name}: x0={x0:.2f} gamma={gamma:.2f} amp={amp:.2f} off={off:.2f} R2={r2:.3f} n={len(xf)}')\nEOF\npython3 /app/fittest.py\n"]
[488.121008, "o", "cat > /app/fittest.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from scipy.optimize import curve_fit\r\n\u001b[?2004l\r"]
[488.12102, "o", "\u001b[?2004h"]
[488.122582, "o", "> data = np.loadtxt('/app/graphene.dat', delimiter=None, dtype=str)\r\n\u001b[?2004l\r\u001b[?2004h> c1 = np.array([float(s.replace(',', '.')) for s in data[:,0]])\r\n\u001b[?2004l\r\u001b[?2004h> c2 = np.array([float(s.replace(',', '.')) for s in data[:,1]])\r\n\u001b[?2004l\r\u001b[?2004h> x = c2; y = c1\r\n\u001b[?2004l\r\u001b[?2004h> def lor(x, x0, gamma, amp, off):\r\n\u001b[?2004l\r\u001b[?2004h>     return off + amp/(1.0 + ((x-x0)/gamma)**2)\r\n\u001b[?2004l\r\u001b[?2004h> for name, lo, hi, x0g in [('G',1500,1700,1580),('2D',2600,2800,2700)]:\r\n\u001b[?2004l\r\u001b[?2004h>     m=(x>lo)&(x<hi); xf,yf=x[m],y[m]\r\n\u001b[?2004l\r\u001b[?2004h>     off0=np.median(yf); amp0=yf.max()-yf.min()\r\n\u001b[?2004l\r\u001b[?2004h"]
