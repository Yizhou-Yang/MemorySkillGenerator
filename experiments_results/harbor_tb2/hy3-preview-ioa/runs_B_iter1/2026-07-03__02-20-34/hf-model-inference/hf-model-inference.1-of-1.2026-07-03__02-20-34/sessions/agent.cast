[376.071478, "m", "Episode 12: 2 commands"]
[376.071478, "o", "\u001b[?2004hroot@3858db88fa4b:/app# "]
[387.060117, "i", "cat > /app/app.py << 'EOF'\nimport os\nimport torch\nfrom flask import Flask, request, jsonify\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\nMODEL_PATH = \"/app/model_cache/sentiment_model\"\n\napp = Flask(__name__)\n\nprint(\"Loading model from\", MODEL_PATH, flush=True)\ntokenizer = AutoTokenizer.from_pretrained(MODEL_PATH)\nmodel = AutoModelForSequenceClassification.from_pretrained(MODEL_PATH)\nmodel.eval()\nprint(\"Model loaded.\", flush=True)\n\n\n@app.route(\"/sentiment\", methods=[\"POST\"])\ndef sentiment():\n    try:\n        data = request.get_json(force=True, silent=True)\n        if not data or \"text\" not in data:\n            return jsonify({\"error\": \"Missing 'text' field in request body\"}), 400\n        text = str(data[\"text\"])\n        inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=512)\n        with torch.no_grad():\n            outputs = model(**inputs)\n            probs = torch.softmax(outputs.logits, dim=-1)[0]\n        "]
[387.060614, "o", "cat > /app/app.py << 'EOF'\r\n\u001b[?2004l\r"]
[387.060725, "o", "\u001b[?2004h> "]
[387.060762, "o", "import os\r\n\u001b[?2004l\r"]
[387.06083, "o", "\u001b[?2004h> "]
[387.060865, "o", "import torch\r\n"]
[387.060923, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[387.061057, "o", "from flask import Flask, request, jsonify\r\n\u001b[?2004l\r"]
[387.061076, "o", "\u001b[?2004h> "]
[387.061325, "o", "from transformers import AutoTokenizer, AutoModelForSequenceClassification\r\n"]
[387.061464, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[387.061517, "o", "\r\n\u001b[?2004l\r"]
[387.061655, "o", "\u001b[?2004h> "]
[387.062391, "o", "MODEL_PATH = \"/app/model_cache/sentiment_model\""]
[387.062536, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> app = Flask(__name__)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Loading model from\", MODEL_PATH, flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.06261, "i", "# DistilBert SST-2 labels: 0 = negative, 1 = positive\n        neg = float(probs[0])\n        pos = float(probs[1])\n        pred = \"positive\" if pos >= neg else \"negative\"\n        return jsonify({\n            \"sentiment\": pred,\n            \"confidence\": {\n                \"positive\": pos,\n                \"negative\": neg,\n            },\n        })\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=5000)\nEOF\n"]
