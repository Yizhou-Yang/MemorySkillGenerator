[483.063003, "i", "cat > /tmp/dl.py << 'PYEOF'\nimport re, os, time, urllib.request, concurrent.futures\nos.makedirs('/tmp/debs', exist_ok=True)\nuris=[]\nfor line in open('/tmp/uris.txt'):\n    line=line.strip()\n    m=re.match(r\"^'([^']+)'\\s+(\\S+)\\s+(\\d+)\", line)\n    if m:\n        uris.append((m.group(1), m.group(2)))\nprint(len(uris),'to download')\ndef fetch(item):\n    url,name=item\n    dest='/tmp/debs/'+name\n    if os.path.exists(dest) and os.path.getsize(dest)>0:\n        return name,'skip'\n    for a in range(4):\n        try:\n            req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})\n            data=urllib.request.urlopen(req, timeout=90).read()\n            open(dest,'wb').write(data)\n            return name,'ok'\n        except Exception as e:\n            time.sleep(1)\n    return name,'FAIL'\nwith concurrent.futures.ThreadPoolExecutor(max_workers=12) as ex:\n    for name,status in ex.map(fetch, uris):\n        if status=='FAIL':\n            print('FAILED', name)\nprint('done')\nPYEOF\n"]
[483.072002, "o", "cat > /tmp/dl.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import re, os, time, urllib.request, concurrent.futures\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('/tmp/debs', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> uris=[]\r\n\u001b[?2004l\r\u001b[?2004h> for line in open('/tmp/uris.txt'):\r\n\u001b[?2004l\r\u001b[?2004h>     line=line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     m=re.match(r\"^'([^']+)'\\s+(\\S+)\\s+(\\d+)\", line)\r\n\u001b[?2004l\r\u001b[?2004h>     if m:\r\n\u001b[?2004l\r\u001b[?2004h>         uris.append((m.group(1), m.group(2)))\r\n\u001b[?2004l\r\u001b[?2004h> print(len(uris),'to download')\r\n\u001b[?2004l\r\u001b[?2004h> def fetch(item):\r\n\u001b[?2004l\r\u001b[?2004h>     url,name=item\r\n\u001b[?2004l\r\u001b[?2004h>     dest='/tmp/debs/'+name\r\n\u001b[?2004l\r\u001b[?2004h>     if os.path.exists(dest) and os.path.getsize(dest)>0:\r\n\u001b[?2004l\r\u001b[?2004h>         return name,'skip'\r\n\u001b[?2004l\r\u001b[?2004h>     for a in range(4):\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})\r\n\u001b[?2004l\r\u001b[?2004h>             data=urllib.request.urlopen(req, timeout=90).read()\r\n\u001b[?2004l\r\u001b[?2004h>             open(dest,'wb').write(data)\r\n\u001b[?2004l\r\u001b[?2004h>             return name,'ok'\r\n\u001b[?2004l\r\u001b[?2004h>         except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h>             time.sleep(1)\r\n\u001b[?2004l\r\u001b[?2004h>     return name,'FAIL'\r\n\u001b[?2004l\r\u001b[?2004h> with concurrent.futures.ThreadPoolExecutor(max_workers=12) as ex:\r\n\u001b[?2004l\r\u001b[?2004h>     for name,status in ex.map(fetch, uris):\r\n\u001b[?2004l\r\u001b[?2004h>         if status=='FAIL':\r\n\u001b[?2004l\r\u001b[?2004h>             print('FAILED', name)\r\n\u001b[?2004l\r\u001b[?2004h"]
