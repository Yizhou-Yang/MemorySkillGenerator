[392.631618, "i", "python3 - <<'EOF'\nimport os\nfrom jupyter_server.auth import passwd\npwd_hash = passwd('benchmarkpass')\nos.makedirs('/root/.jupyter', exist_ok=True)\nconfig = '''c.ServerApp.ip = '0.0.0.0'\nc.ServerApp.port = 8888\nc.ServerApp.open_browser = False\nc.ServerApp.certfile = '/app/mycert.pem'\nc.ServerApp.keyfile = '/app/mykey.key'\nc.ServerApp.password = '%s'\nc.ServerApp.allow_root = True\nc.ServerApp.base_url = '/'\n''' % pwd_hash\nwith open('/root/.jupyter/jupyter_server_config.py','w') as f:\n    f.write(config)\nprint('wrote config')\nprint('hash:', pwd_hash)\nEOF\n"]
