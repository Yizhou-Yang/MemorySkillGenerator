[483.100145, "i", "python3 - <<'PY'\nfrom bitcoinlib.services.services import Service\nimport inspect\ns = Service()\nprint('getrawtransaction sig:', inspect.signature(s.getrawtransaction))\nprint('gettransaction sig:', inspect.signature(s.gettransaction))\ntxid='caed73c5004cc79d24a9a2c5fde3ecb909a78aba8132a3befeb390ffb1b55e27'\nrt = s.getrawtransaction(txid)\nprint('rawtx type', type(rt))\nt = s.gettransaction(txid)\nprint('gettransaction block_hash', t.block_hash)\nprint('gettransaction as_dict block_hash', t.as_dict().get('block_hash'))\nprint('block_height', t.block_hash, t.block_height)\nprint('--- invalid block ---')\ntry:\n    inv = s.getblock('00'*32)\n    print('invalid returned', type(inv), getattr(inv,'hash',None) if inv else inv)\nexcept Exception as e:\n    print('invalid raised', type(e).__name__, repr(e)[:120])\nprint('--- invalid tx ---')\ntry:\n    inv = s.gettransaction('00'*32)\n    print('invalid tx returned', inv)\nexcept Exception as e:\n    print('invalid tx raised', type(e).__name__, repr(e)[:120])\nPY\n"]
