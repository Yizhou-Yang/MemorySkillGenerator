[429.85317, "i", "python3 - <<'PY'\nfrom bitcoinlib.services.services import Service\nimport json\ns = Service()\n# get a recent block height\nbh = s.blockcount()\nprint('blockcount', bh)\nb = s.getblock(bh)\nprint('recent block hash', b.block_hash.hex() if isinstance(b.block_hash,bytes) else b.block_hash)\ntx = b.transactions[0]\nprint('first txid', tx.txid)\n# getrawtransaction\nrt = s.getrawtransaction(tx.txid, parse=True)\nprint('rawtx type', type(rt))\nprint('rawtx block_hash', getattr(rt,'block_hash',None))\nprint('rawtx as_dict keys sample:')\nd=rt.as_dict()\nprint('block_hash in dict:', d.get('block_hash'))\nprint('block_height in dict:', d.get('block_height'))\n# invalid hash\nprint('--- invalid block ---')\ntry:\n    inv = s.getblock('00'*32)\n    print('invalid returned', inv)\nexcept Exception as e:\n    print('invalid raised', type(e).__name__, repr(e)[:120])\nPY\n"]
