[358.638045, "i", "python3 - <<'PY'\nfrom bitcoinlib.services.services import Service\ns = Service()\nt = s.gettransaction('4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b')\nprint('block_hash', t.block_hash)\nprint('coinbase', t.coinbase)\nfor i, inp in enumerate(t.inputs):\n    print('IN', i, 'coinbase=', getattr(inp,'coinbase',None), 'sequence=', getattr(inp,'sequence',None), 'dir=', [a for a in dir(inp) if not a.startswith('_')][:30])\nfor o, outp in enumerate(t.outputs):\n    print('OUT', o, 'value=', getattr(outp,'value',None), 'n=', getattr(outp,'n',None))\n    spk = getattr(outp,'script_pubkey',None)\n    print('  spk', [a for a in dir(spk) if not a.startswith('_')][:30] if spk else None)\nprint('--- as_dict ---')\nimport json\nd = t.as_dict()\nprint(json.dumps(d, indent=1)[:1500])\nPY\n"]
