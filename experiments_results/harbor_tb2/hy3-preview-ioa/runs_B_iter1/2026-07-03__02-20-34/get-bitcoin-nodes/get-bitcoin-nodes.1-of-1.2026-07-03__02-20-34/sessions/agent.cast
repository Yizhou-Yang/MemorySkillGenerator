[574.996706, "i", "python3 - <<'PY'\nimport requests\nb='000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f'\nt='4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b'\nr=requests.get('https://blockstream.info/api/block/'+b,timeout=15); print('BLOCK', r.status_code); print(r.json())\nprint('--- txids ---')\nr=requests.get('https://blockstream.info/api/block/'+b+'/txid',timeout=15); print(r.status_code, r.json()[:3])\nprint('--- tx ---')\nr=requests.get('https://blockstream.info/api/tx/'+t,timeout=15); print(r.status_code)\nimport json; d=r.json(); print('txid',d['txid']); print('status',d['status']); print('vin0',d['vin'][0]); print('vout0',d['vout'][0])\nprint('--- tip ---')\nr=requests.get('https://blockstream.info/api/blocks/tip/height',timeout=15); print(r.status_code, r.text)\nPY\n"]
