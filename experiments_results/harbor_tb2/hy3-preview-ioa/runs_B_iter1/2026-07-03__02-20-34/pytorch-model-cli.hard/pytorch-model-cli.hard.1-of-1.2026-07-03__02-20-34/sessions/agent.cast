[682.915164, "i", "cat > /app/main.cpp <<'CPP'\n#include <cstdio>\n#include <cstdlib>\n#include <cmath>\n#include <vector>\n#include <algorithm>\n#include \"lodepng.h\"\n#include \"cJSON.h\"\n\nstatic char* readFile(const char* path) {\n    FILE* f = fopen(path, \"rb\");\n    if (!f) { fprintf(stderr, \"Cannot open %s\\n\", path); exit(1); }\n    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);\n    char* buf = (char*)malloc(n + 1);\n    fread(buf, 1, n, f); buf[n] = 0; fclose(f);\n    return buf;\n}\n\nstatic std::vector<double> preprocess(const std::vector<unsigned char>& img, unsigned w, unsigned h, int target, double mean, double std) {\n    std::vector<double> out(target * target, 0.0);\n    for (int ty = 0; ty < target; ++ty) {\n        double srcY = (ty + 0.5) * (double)h / target - 0.5;\n        int y0 = std::max(0, std::min((int)h - 1, (int)floor(srcY)));\n        int y1 = std::max(0, std::min((int)h - 1, y0 + 1));\n        double wy = srcY - floor(srcY);\n        for (int tx = 0; tx < tar"]
