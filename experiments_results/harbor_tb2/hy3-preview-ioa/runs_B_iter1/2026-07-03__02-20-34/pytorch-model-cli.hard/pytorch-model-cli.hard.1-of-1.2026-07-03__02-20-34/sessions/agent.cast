[557.803432, "i", "cat > /app/probe.py <<'PY'\nimport torch, numpy as np\nfrom PIL import Image\nsd = torch.load('model.pth', weights_only=True)\nW1=sd['input_layer.weight'].numpy(); b1=sd['input_layer.bias'].numpy()\nW2=sd['hidden_layer.weight'].numpy(); b2=sd['hidden_layer.bias'].numpy()\nW3=sd['output_layer.weight'].numpy(); b3=sd['output_layer.bias'].numpy()\nimg = Image.open('image.png')\nprint('mode', img.mode, 'size', img.size)\ng = img.convert('L'); g=g.resize((28,28)); px=np.asarray(g,dtype=np.float64)\nprint('px range', px.min(), px.max())\nx01 = px/255.0\n\ndef relu(a): return np.maximum(a,0)\ndef fwd(x):\n    h1=relu(W1@x+b1)\n    h2=relu(W2@h1+b2)\n    return W3@h2+b3\nfor name,x in [('raw/255',x01), ('norm',(x01-0.1307)/0.3081), ('centered',x01-0.1307)]:\n    logits=fwd(x)\n    idx=int(np.argmax(logits))\n    order=np.argsort(logits)[::-1]\n    print(f'{name}: pred={idx} top2={order[:2]} logits[top2]={logits[order[0]]:.3f},{logits[order[1]]:.3f}')\nPY\npython3 /app/probe.py 2>&1 | tail -20\n"]
[557.803827, "o", "cat > /app/probe.py <<'PY'"]
