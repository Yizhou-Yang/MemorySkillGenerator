[682.970113, "o", "    unsigned err = lodepng::decode(img, w, h, argv[2]);\r\n\u001b[?2004l\r"]
[682.970135, "o", "\u001b[?2004h> "]
[682.970626, "o", "    if (err) { fprintf(stderr, \"decode error %u\\n\", err); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     std::vector<double> cur = preprocess(img, w, h, 28, mean, std);\r\n\u001b[?2004l\r"]
[682.970655, "o", "\u001b[?2004h> "]
[682.981157, "o", "    for (int l = 0; l < nlayers; ++l) {\r\n\u001b[?2004l\r\u001b[?2004h>         int rows = (int)W[l].size(); int cols = (int)W[l][0].size();\r\n\u001b[?2004l\r\u001b[?2004h>         std::vector<double> nxt(rows, 0.0);\r\n\u001b[?2004l\r\u001b[?2004h>         for (int i = 0; i < rows; ++i) {\r\n\u001b[?2004l\r\u001b[?2004h>             double s = B[l][i];\r\n\u001b[?2004l\r\u001b[?2004h>             for (int j = 0; j < cols; ++j) s += W[l][i][j] * cur[j];\r\n\u001b[?2004l\r\u001b[?2004h>             if (l < nlayers - 1) s = s > 0 ? s : 0;\r\n\u001b[?2004l\r\u001b[?2004h>             nxt[i] = s;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         cur = nxt;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     int best = 0; double bv = cur[0];\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 1; i < (int)cur.size(); ++i) if (cur[i] > bv) { bv = cur[i]; best = i; }\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"%d\\n\", best);\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> CPP\r\n\u001b[?2004l\r"]
