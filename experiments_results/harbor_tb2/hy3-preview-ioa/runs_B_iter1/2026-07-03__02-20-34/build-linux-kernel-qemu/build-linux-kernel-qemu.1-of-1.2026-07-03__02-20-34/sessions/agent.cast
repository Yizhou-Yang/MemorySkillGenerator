[1204.620538, "i", "cat > /tmp/dl.py <<'EOF'\nimport urllib.request\nurls = [u.strip() for u in open('/tmp/urllist.txt') if u.strip()]\nhdr = {'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120 Safari/537.36','Accept':'*/*'}\nfails=0; ok=0\nfor u in urls:\n    fn = '/tmp/debs/'+u.rsplit('/',1)[-1]\n    req = urllib.request.Request(u, headers=hdr)\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r, open(fn,'wb') as f:\n            f.write(r.read())\n        ok+=1\n    except Exception as e:\n        print('FAIL', u, e); fails+=1\nprint('OK',ok,'FAIL',fails)\nEOF\ncd /tmp/debs && python3 /tmp/dl.py 2>&1 | tail -8; echo \"downloaded=$(ls *.deb | wc -l)\"\n"]
