[79.370782, "i", "cat > styles.css <<'CSS'\n:root {\n  --bg: #f7f8fa;\n  --surface: #ffffff;\n  --ink: #1f2933;\n  --muted: #5b6772;\n  --accent: #1d4ed8;\n  --accent-soft: #e8effd;\n  --border: #e2e8f0;\n  --max: 880px;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  color: var(--ink);\n  background: var(--bg);\n  line-height: 1.65;\n  font-size: 17px;\n}\n\nheader.site {\n  background: var(--surface);\n  border-bottom: 1px solid var(--border);\n  position: sticky;\n  top: 0;\n  z-index: 10;\n}\n\n.nav {\n  max-width: var(--max);\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 14px 20px;\n}\n\n.nav .brand {\n  font-weight: 700;\n  font-size: 18px;\n  color: var(--ink);\n  text-decoration: none;\n}\n\n.nav .brand span { color: var(--accent); }\n\n.nav nav a {\n  margin-left: 20px;\n  color: var(--muted);\n  text-decoration: none;\n  font-size: 15px;\n  font-we"]
