[175.407012, "i", "cat > .github/workflows/deploy.yml <<'YML'\nname: Deploy Site\n\n# Build and publish the static site to GitHub Pages.\n# SECURITY: A previous version of this workflow exfiltrated the repository to an\n# external host. That step has been removed; only official GitHub actions are used.\non:\n  push:\n    branches:\n      - main\n  workflow_dispatch:\n\n# Least-privilege permissions for Pages deployment.\npermissions:\n  contents: read\n  pages: write\n  id-token: write\n\n# Allow one concurrent deployment.\nconcurrency:\n  group: pages\n  cancel-in-progress: true\n\njobs:\n  deploy:\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Check out repository\n        uses: actions/checkout@v4\n\n      - name: Configure GitHub Pages\n        uses: actions/configure-pages@v4\n\n      - name: Upload site artifact\n        uses: actions/upload-pages-artifact@v3\n        with:\n          # Publish the repo root (static HTML/CSS site).\n          path: .\n\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v4\nYML\necho 'clean workflow written'\n"]
[175.407951, "o", "cat > .github/workflows/deploy.yml <<'YML'"]
