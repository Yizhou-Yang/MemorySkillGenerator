[135.51302, "i", "cat > index.html <<'HTML'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dr. Lydia Moreno — Research Profile</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"nav\">\n      <a class=\"brand\" href=\"index.html\">Lydia <span>Moreno</span></a>\n      <nav>\n        <a class=\"active\" href=\"index.html\">About</a>\n        <a href=\"publications.html\">Publications</a>\n        <a href=\"blog.html\">Blog</a>\n      </nav>\n    </div>\n  </header>\n\n  <section class=\"hero\">\n    <div class=\"inner\">\n      <h1>Dr. Lydia Moreno</h1>\n      <div class=\"role\">Associate Professor of Computational Neuroscience</div>\n      <div class=\"affil\">School of Biological Sciences, Riverbend University</div>\n    </div>\n  </section>\n\n  <main>\n    <h2>About Me</h2>\n    <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University&rsquo;s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high&#8209;throughput imaging analysis at Northborough Research Center.</p>\n\n    <h2>Education</h2>\n    <div class=\"card\">\n      <h3>Ph.D., Computational Biology</h3>\n      <div class=\"meta\">Baywood Institute of Technology, 2014&ndash;2019</div>\n      <p>Dissertation: &ldquo;Deep Learning Models for Decoding Neural Population Activity&rdquo;</p>\n    </div>\n    <div class=\"card\">\n      <h3>M.Sc., Bioinformatics</h3>\n      <div class=\"meta\">Riverbend University, 2012&ndash;2014</div>\n      <p>Thesis: &ldquo;Statistical Methods for Single&#8209;Cell RNA&#8209;Seq Analysis&rdquo;</p>\n    </div>\n    <div class=\"card\">\n      <h3>B.Sc., Computer Science</h3>\n      <div class=\"meta\">Crestfield College of Engineering, 2008&ndash;2012</div>\n      <p>Graduated magna cum laude; President, Data Science Club.</p>\n    </div>\n\n    <h2>Research Interests</h2>\n    <ul>\n      <li><strong>Neural Encoding &amp; Decoding</strong> &mdash; interpretable models that translate spike&#8209;train data into behavioral predictions.</li>\n      <li><strong>Machine Learning for Biomedical Imaging</strong> &mdash; CNNs and GNNs applied to MRI and two&#8209;photon microscopy.</li>\n      <li><strong>Single&#8209;Cell Omics</strong> &mdash; scalable pipelines integrating multi&#8209;modal single&#8209;cell genomics and spatial transcriptomics.</li>\n      <li><strong>Explainable AI in Neuroscience</strong> &mdash; probing decision boundaries and feature attributions in black&#8209;box models.</li>\n    </ul>\n\n    <h2>Selected Projects</h2>\n    <div class=\"card\">\n      <span class=\"project-role\">Lead Developer &amp; Project Coordinator</span>\n      <h3>DeepVision: High&#8209;Resolution Neural Activity Mapping</h3>\n      <ul>\n        <li>Designed a PyTorch&#8209;based pipeline to segment two&#8209;photon images of mouse visual cortex.</li>\n        <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium&#8209;imaging traces.</li>\n        <li>Deployed a Dockerized microservice with Cascade Imaging Lab.</li>\n      </ul>\n    </div>\n    <div class=\"card\">\n      <span class=\"project-role\">Principal Investigator</span>\n      <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\n      <ul>\n        <li>Constructed graph representations of reconstructed neuron meshes from electron&#8209;microscopy.</li>\n        <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\n        <li>Published an open&#8209;source toolkit adopted by 12 labs worldwide.</li>\n      </ul>\n    </div>\n    <div class=\"card\">\n      <span class=\"project-role\">Co&#8209;Principal Investigator</span>\n      <h3>CellMap: Multi&#8209;Modal Single&#8209;Cell Atlas</h3>\n      <ul>\n        <li>Developed a Nextflow workflow combining"]
[135.513078, "i", " scRNA&#8209;Seq, ATAC&#8209;Seq, and spatial FISH data.</li>\n        <li>Implemented Bayesian clustering to resolve cell&#8209;type hierarchies in human cortical organoids.</li>\n        <li>Presented at ICSCG 2023.</li>\n      </ul>\n    </div>\n\n    <h2>Skills &amp; Tools</h2>\n    <ul>\n      <li><strong>Languages:</strong> Python, R, C++</li>\n      <li><strong>Frameworks:</strong> PyTorch, TensorFlow, scikit&#8209;learn, NetworkX</li>\n      <li><strong>Data Tools:</strong> Nextflow, Snakemake, Docker, Kubernetes</li>\n      <li><strong>Analysis:</strong> MATLAB, Jupyter, Seurat, Scanpy</li>\n      <li><strong>Visualization:</strong> D3.js, Plotly, Matplotlib</li>\n    </ul>\n\n    <h2>Contact</h2>\n    <div class=\"contact-grid\">\n      <div><strong>Email</strong><br><a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></div>\n      <div><strong>Office</strong><br>Blakely Hall, Room 312, Riverbend University</div>\n      <div><strong>Twitter</strong><br><a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></div>\n      <div><strong>GitHub</strong><br><a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></div>\n    </div>\n  </main>\n\n  <footer class=\"site\"><div class=\"footer-inner\">&copy; 2025 Dr. Lydia Moreno &middot; Built with static HTML &amp; CSS</div></footer>\n</body>\n</html>\nHTML\necho 'index.html written'\n"]
[135.51424, "o", "cat > index.html <<'HTML'\r\n\u001b[?2004l\rering, 2008&ndash;2012</div>\r\n      <p>Graduated magna cum laude; President, Data Science Club.</p>\r\n    </div>\r\n\r\n    <h2>Research Interests</h2>\r\n    <ul>\r\n      <li><strong>Neural Encoding &amp; Decoding</strong> &mdash; interpretable models that translate spike&#8209;train data into behavioral predictions.</li>\r\n      <li><strong>Machine Learning for Biomedical Imaging</strong> &mdash; CNNs and GNNs applied to MRI and two&#8209;photon microscopy.</li>\r\n      <li><strong>Single&#8209;Cell Omics</strong> &mdash; scalable pipelines integrating multi&#8209;modal single&#8209;cell genomics and spatial transcriptomics.</li>\r\n      <li><strong>Explainable AI in Neuroscience</strong> &mdash; probing decision boundaries and feature attributions in black&#8209;box models.</li>\r\n    </ul>\r\n\r\n    <h2>Selected Projects</h2>\r\n    <div class=\"card\">\r\n      <span class=\"project-role\">Lead Developer &amp; Project Coordinator</span>\r\n      <h3>DeepVision: High&#8209;Resolution Neural Activity Mapping</h3>\r\n      <ul>\r\n        <li>Designed a PyTorch&#8209;based pipeline to segment two&#8209;photon images of mouse visual cortex.</li>\r\n        <li>Integrated temporal convolutional networks to predict stimulus orientation from calcium&#8209;imaging traces.</li>\r\n        <li>Deployed a Dockerized microservice with Cascade Imaging Lab.</li>\r\n      </ul>\r\n    </div>\r\n    <div class=\"card\">\r\n      <span class=\"project-role\">Principal Investigator</span>\r\n      <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\r\n      <ul>\r\n        <li>Constructed graph representations of reconstructed neuron meshes from electron&#8209;microscopy.</li>\r\n        <li>Trained GNNs to classify synapse types and infer connectivity motifs.</li>\r\n        <li>Published an open&#8209;source toolkit adopted by 12 labs worldwide.</li>\r\n      </ul>\r\n    </div>\r\n    <div class=\"card\">\r\n      <span class=\"project-role\">Co&#8209;Principal Investigator</span>\r\n      <h3>CellMap: Multi&#8209;Modal Single&#8209;Cell Atlas</h3>\r\n      <ul>\r\n        <li>Developed a Nextflow workflow combining scRNA&#8209;Seq, ATAC&#82"]
