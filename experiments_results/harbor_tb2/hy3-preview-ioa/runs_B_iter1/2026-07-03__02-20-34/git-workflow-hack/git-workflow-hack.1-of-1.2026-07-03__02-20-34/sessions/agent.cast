[149.298953, "i", "cat > publications.html <<'HTML'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Publications — Dr. Lydia Moreno</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"nav\">\n      <a class=\"brand\" href=\"index.html\">Lydia <span>Moreno</span></a>\n      <nav>\n        <a href=\"index.html\">About</a>\n        <a class=\"active\" href=\"publications.html\">Publications</a>\n        <a href=\"blog.html\">Blog</a>\n      </nav>\n    </div>\n  </header>\n\n  <section class=\"hero\">\n    <div class=\"inner\">\n      <h1>Publications</h1>\n      <div class=\"role\">Selected peer&#8209;reviewed work</div>\n    </div>\n  </section>\n\n  <main>\n    <div class=\"pub\">\n      <div class=\"title\">1. Temporal Convolutional Networks Decode Visual Stimuli from Two&#8209;Photon Signals</div>\n      <div class=\"venue\">Moreno, L., &amp; Patel, A. (2024). <em>Journal of Computational Neuroscience</em>, 45(2), 123&ndash;137.</div>\n    </div>\n    <div class=\"pub\">\n      <div class=\"title\">2. Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets</div>\n      <div class=\"venue\">Moreno, L., Zhang, W., &amp; Singh, R. (2023). <em>Neuroinformatics</em>, 21(4), 299&ndash;312.</div>\n    </div>\n    <div class=\"pub\">\n      <div class=\"title\">3. Integrative Single&#8209;Cell Atlas of Human Cerebral Organoids</div>\n      <div class=\"venue\">Moreno, L. et al. (2022). <em>Cell Systems</em>, 9(1), 67&ndash;82.</div>\n    </div>\n    <div class=\"pub\">\n      <div class=\"title\">4. Explainable AI Techniques in Neural Decoding</div>\n      <div class=\"venue\">Chen, J., Moreno, L., &amp; Russo, M. (2021). <em>Frontiers in Neuroscience</em>, 15, 756843.</div>\n    </div>\n  </main>\n\n  <footer class=\"site\"><div class=\"footer-inner\">&copy; 2025 Dr. Lydia Moreno &middot