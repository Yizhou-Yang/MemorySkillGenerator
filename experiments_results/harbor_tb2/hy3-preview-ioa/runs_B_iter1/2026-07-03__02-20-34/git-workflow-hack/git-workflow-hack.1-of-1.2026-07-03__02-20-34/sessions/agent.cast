[162.074128, "i", "cat > blog.html <<'HTML'\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Blog — Dr. Lydia Moreno</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <header class=\"site\">\n    <div class=\"nav\">\n      <a class=\"brand\" href=\"index.html\">Lydia <span>Moreno</span></a>\n      <nav>\n        <a href=\"index.html\">About</a>\n        <a href=\"publications.html\">Publications</a>\n        <a class=\"active\" href=\"blog.html\">Blog</a>\n      </nav>\n    </div>\n  </header>\n\n  <section class=\"hero\">\n    <div class=\"inner\">\n      <h1>Blog</h1>\n      <div class=\"role\">Notes from the lab and the field</div>\n    </div>\n  </section>\n\n  <main>\n    <div class=\"card\">\n      <h3>Building Interpretable Deep Learning Models for Neuroscience</h3>\n      <div class=\"meta\">March 2025</div>\n      <p>Reflections on designing models that neuroscientists can actually trust &mdash; feature attribution, decision&#8209;boundary probes, and why black&#8209;box accuracy is not enough when lives and hypotheses are on the line.</p>\n    </div>\n    <div class=\"card\">\n      <h3>Bridging Machine Learning and Single&#8209;Cell Genomics</h3>\n      <div class=\"meta\">January 2025</div>\n      <p>A look at how scalable embedding methods are reshaping multi&#8209;modal integration of scRNA&#8209;Seq, ATAC&#8209;Seq, and spatial FISH, and what it means for resolving cell&#8209;type hierarchies.</p>\n    </div>\n    <div class=\"card\">\n      <h3>Scaling Graph Neural Networks for Connectomics</h3>\n      <div class=\"meta\">November 2024</div>\n      <p>Lessons learned training GNNs on electron&#8209;microscopy meshes: memory bottlenecks, inductive biases for synapse classification, and the open&#8209;source tooling that made it reproducible.</p>\n    </div>\n  </main>\n\n  <footer class=\"site\"><div class=\"footer-inner\">&copy; 2025 Dr. Lydia Moreno &middot; Built with static HTML &amp; CSS</div></footer>\n</body>\n</html>\nHTML\necho 'blog.html written'\n"]
[162.074423, "o", "cat > blog.html <<'HTML'"]
[162.074512, "o", "\r\n"]
