[79.386208, "i", "ight: 500;\n}\n\n.nav nav a:hover, .nav nav a.active { color: var(--accent); }\n\n.hero {\n  background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%);\n  color: #fff;\n  padding: 56px 20px;\n}\n\n.hero .inner { max-width: var(--max); margin: 0 auto; }\n\n.hero h1 { margin: 0 0 8px; font-size: 34px; }\n\n.hero .role { font-size: 18px; opacity: 0.92; }\n\n.hero .affil { margin-top: 6px; opacity: 0.8; font-size: 15px; }\n\nmain { max-width: var(--max); margin: 0 auto; padding: 36px 20px 64px; }\\nh2 { font-size: 24px; margin: 36px 0 14px; padding-bottom: 8px; border-bottom: 2px solid var(--accent-soft); }\nh3 { font-size: 19px; margin: 24px 0 6px; }\np { margin: 0 0 14px; }\nul { padding-left: 22px; } li { margin-bottom: 6px; }\n\n.card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  padding: 20px 22px;\n  margin: 16px 0;\n  box-shadow: 0 1px 2px rgba(16,24,40,0.04);\n}\n\n.card .meta { color: var(--muted); font-size: 14px; }\n.project-role { display: inline-block; background: var(--accent-soft); color: var(--accent); font-size: 13px; font-weight: 600; padding: 2px 10px; border-radius: 999px; margin-bottom: 6px; }\npub { padding: 14px 0; border-bottom: 1px solid var(--border); } .pub:last-child { border-bottom: none; } .pub .title { font-weight: 600; } .pub .venue { color: var(--muted); font-size: 14px; }\n.contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 12px; } .contact-grid a { color: var(--accent); text-decoration: none; } .contact-grid a:hover { text-decoration: underline; }\nfooter.site { border-top: 1px solid var(--border); background: var(--surface); } .footer-inner { max-width: var(--max); margin: 0 auto; padding: 20px; color: var(--muted); font-size: 14px; text-align: center; }\nCSS\necho 'styles.css written'\n"]
