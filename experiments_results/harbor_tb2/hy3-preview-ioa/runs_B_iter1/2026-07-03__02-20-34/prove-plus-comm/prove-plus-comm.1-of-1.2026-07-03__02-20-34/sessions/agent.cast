[190.615769, "o", "plus_n_O =\r\n\u001b[1mfun\u001b[0m n : nat =>\r\nnat_ind (\u001b[1mfun\u001b[0m n0 : nat => n0\u001b[37m =\u001b[0m n0\u001b[37m +\u001b[0m 0) (eq_refl : 0\u001b[37m =\u001b[0m 0\u001b[37m +\u001b[0m 0)\r\n  (\u001b[1mfun\u001b[0m (n0 : nat) (IHn : n0\u001b[37m =\u001b[0m n0\u001b[37m +\u001b[0m 0) =>\r\n   f_equal_nat nat S n0 (n0\u001b[37m +\u001b[0m 0) IHn : S n0\u001b[37m =\u001b[0m S n0\u001b[37m +\u001b[0m 0) n\r\n     : \u001b[1mforall\u001b[0m n : nat, n\u001b[37m =\u001b[0m n\u001b[37m +\u001b[0m 0\r\n\r\nArguments \u001b[92mplus_n_O\u001b[0m n%nat_scope\r\n"]
[190.616543, "o", "plus_n_Sm =\r\n\u001b[1mfun\u001b[0m n m : nat =>\r\nnat_ind (\u001b[1mfun\u001b[0m n0 : nat => S (n0\u001b[37m +\u001b[0m m)\u001b[37m =\u001b[0m n0\u001b[37m +\u001b[0m S m)\r\n  (eq_refl : S (0\u001b[37m +\u001b[0m m)\u001b[37m =\u001b[0m 0\u001b[37m +\u001b[0m S m)\r\n  (\u001b[1mfun\u001b[0m (n0 : nat) (IHn : S (n0\u001b[37m +\u001b[0m m)\u001b[37m =\u001b[0m n0\u001b[37m +\u001b[0m S m) =>\r\n   f_equal_nat nat S (S (n0\u001b[37m +\u001b[0m m)) (n0\u001b[37m +\u001b[0m S m) IHn : S (S n0\u001b[37m +\u001b[0m m)\u001b[37m =\u001b[0m S n0\u001b[37m +\u001b[0m S m)\r\n  n\r\n     : \u001b[1mforall\u001b[0m n m : nat, S (n\u001b[37m +\u001b[0m m)\u001b[37m =\u001b[0m n\u001b[37m +\u001b[0m S m\r\n\r\nArguments \u001b[92mplus_n_Sm\u001b[0m (n m)%nat_scope\r\n"]
