[10.317625, "o", "Require Import Arith."]
[10.318172, "o", "\r\n"]
[10.318402, "o", "\r\n"]
[10.318618, "o", "Theorem plus_comm : forall n m : nat,"]
[10.318802, "o", "\r\n"]
[10.31906, "o", "  n + m = m + n."]
[10.31931, "o", "\r\n"]
[10.319533, "o", "Proof."]
[10.319745, "o", "\r\n"]
[10.319969, "o", "  intros n m."]
[10.320182, "o", "\r\n"]
[10.320411, "o", "  induction n as [|n' IHn']."]
[10.320641, "o", "\r\n"]
[10.320848, "o", "  - simpl."]
[10.321115, "o", "\r\n"]
[10.321342, "o", "    (* Need to handle the base case *)"]
[10.321587, "o", "\r\n"]
[10.321763, "o", "    admit."]
[10.322002, "o", "\r\n"]
[10.322224, "o", "  - simpl."]
[10.322475, "o", "\r\n"]
[10.322752, "o", "    (* Need to use the inductive hypothesis and plus_n_Sm *)"]
[10.322996, "o", "\r\n"]
[10.323213, "o", "    admit."]
[10.323447, "o", "\r\n"]
[10.323897, "o", "Qed. "]
