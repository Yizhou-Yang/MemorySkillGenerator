[355.618207, "i", "cat > /tmp/scan.py << 'EOF'\nimport socket, sys\nhost=sys.argv[1]\nports=[]\nfor a in sys.argv[2:]:\n    if '-' in a:\n        s,e=map(int,a.split('-')); ports+=range(s,e+1)\n    else:\n        ports.append(int(a))\nopenp=[]\nfor p in ports:\n    s=socket.socket(); s.settimeout(0.15)\n    r=s.connect_ex((host,p)); s.close()\n    if r==0: openp.append(p)\nprint(host,'open:',openp)\nEOF\npython3 /tmp/scan.py 192.168.80.2 1-1024\n"]
