[608.684257, "i", "cat > /tmp/d2.py << 'EOF'\nimport lzma, re\ndata = open('/app/secrets.7z','rb').read()\nfilt = lambda: [{'id': lzma.FILTER_LZMA1, 'dict_size': 0x00100000, 'lc':3, 'lp':0, 'pb':2}]\nprop = bytes([0x5d,0x00,0x10,0x00,0x00])\n\ndef dec(b):\n    try:\n        d = lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=filt())\n        return d.decompress(b)\n    except Exception as e:\n        return b'ERR:'+str(e).encode()\n\ncands = {\n  'off48': data[48:181],\n  'off32': data[32:181],\n  'off48+prop': prop+data[48:181],\n  'off32+prop': prop+data[32:181],\n}\nfor name, b in cands.items():\n    out = dec(b)\n    if out.startswith(b'ERR:'):\n        print(name, '->', out.decode(errors='replace'))\n    else:\n        print('=== %s -> decoded %d bytes ===' % (name, len(out)))\n        print(out[:200])\n        print('STRINGS:', re.findall(rb'[ -~]{3,}', out)[:40])\nEOF\npython3 /tmp/d2.py\n"]
