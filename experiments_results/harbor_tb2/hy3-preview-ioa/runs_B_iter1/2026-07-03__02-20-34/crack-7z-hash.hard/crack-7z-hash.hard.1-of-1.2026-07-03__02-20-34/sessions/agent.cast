[319.545005, "i", "cat > /tmp/p.py << 'EOF'\nimport struct, lzma\n\ndata = open('/app/secrets.7z','rb').read()\nprint('file size', len(data))\nprint('sig', data[:6].hex())\nnext_off = struct.unpack('<Q', data[12:20])[0]\nnext_size = struct.unpack('<Q', data[20:28])[0]\nnext_crc = struct.unpack('<I', data[28:32])[0]\nprint('next_off', next_off, 'next_size', next_size, 'next_crc', hex(next_crc))\nnh = data[32 + next_off : 32 + next_off + next_size]\nprint('nextheader', nh.hex())\n\ndef read_num(b, pos):\n    result = 0; shift = 0\n    while True:\n        byte = b[pos]; pos += 1\n        result |= (byte & 0x7F) << shift\n        if (byte & 0x80) == 0:\n            break\n        shift += 7\n    return result, pos\n\npos = 0\nwhile pos < len(nh):\n    try:\n        idv, pos = read_num(nh, pos)\n    except Exception as e:\n        print('read err at', pos, e); break\n    name = {0x00:'kEnd',0x01:'kHeader',0x06:'kPackInfo',0x07:'kUnpackInfo',0x08:'kSubStreamsInfo',0x09:'kSize',0x0A:'kCRC',0x0B:'kFolder',0x0C:'kCod"]
[319.550088, "o", "cat > /tmp/p.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.550609, "o", "import struct, lzma\r\n"]
[319.550956, "o", "\u001b[?2004l\r\u001b[?2004h"]
[319.551091, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> data = open('/app/secrets.7z','rb').read()"]
[319.551262, "o", "\r\n"]
[319.551542, "o", "\u001b[?2004l\r\u001b[?2004h"]
[319.551622, "o", "> print('file size', len(data))"]
[319.551934, "o", "\r\n"]
[319.552302, "o", "\u001b[?2004l\r\u001b[?2004h> print('sig', data[:6].hex())"]
[319.552351, "i", "ersUnpackSize',0x0D:'kNumUnpackStream',0x17:'kEncodedHeader',0x18:'kStartPos',0x19:'kDummy'}.get(idv, '?id')\n    print('id', hex(idv), name, 'at', pos)\n    if idv == 0x00:\n        break\n    if idv == 0x06:  # kPackInfo\n        pack_pos, pos = read_num(nh, pos)\n        num_pack, pos = read_num(nh, pos)\n        print('  pack_pos', pack_pos, 'num_pack', num_pack)\n        while pos < len(nh):\n            idv2, pos = read_num(nh, pos)\n            if idv2 == 0x09:\n                for _ in range(num_pack):\n                    s, pos = read_num(nh, pos); print('   size', s)\n            elif idv2 == 0x0A:\n                for _ in range(num_pack):\n                    crc, pos = read_num(nh, pos); print('   crc', hex(crc))\n            elif idv2 == 0x00:\n                break\n            else:\n                print('  unexpected', hex(idv2)); break\n    elif idv == 0x07:  # kUnpackInfo\n        # expect kFolder 0x0B\n        fid, pos = read_num(nh, pos)\n        print('  unpack first id', hex(fid))\nEOF\npython3 /tmp/p.py\n"]
