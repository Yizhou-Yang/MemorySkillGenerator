[531.329014, "i", "cat > /tmp/d.py << 'EOF'\nimport lzma, re\ndata = open('/app/secrets.7z','rb').read()\nbody = data[32:181]\nprint('body len', len(body))\nfilt = [{'id': lzma.FILTER_LZMA1, 'dict_size': 0x00100000, 'lc':3, 'lp':0, 'pb':2}]\ndef try_dec(b):\n    try:\n        d = lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=filt)\n        return d.decompress(b)\n    except Exception as e:\n        return ('ERR', str(e))\nout = try_dec(body)\nprint('whole body ->', ('ERR '+out[1]) if isinstance(out,tuple) else ('len=%d'%len(out)))\nif isinstance(out, bytes):\n    print('first 120 bytes:', out[:120])\n    print('strings:', re.findall(rb'[ -~\\x00-\\x7f]{3,}', out)[:30])\nEOF\npython3 /tmp/d.py\n"]
