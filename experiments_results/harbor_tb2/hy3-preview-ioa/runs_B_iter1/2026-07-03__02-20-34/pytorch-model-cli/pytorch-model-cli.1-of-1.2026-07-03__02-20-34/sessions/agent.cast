[276.409785, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     elif ct==b'IEND': break\r\n\u001b[?2004l\r\u001b[?2004h>     pos+=12+ln\r\n\u001b[?2004l\r\u001b[?2004h> raw=zlib.decompress(idat)\r\n\u001b[?2004l\r\u001b[?2004h> ch={0:1,2:3,3:1,4:2,6:4}[c]; bpp=ch*(bpc//8); stride=w*bpp\r\n\u001b[?2004l\r\u001b[?2004h> out=bytearray();prev=bytearray(stride);p=0"]
