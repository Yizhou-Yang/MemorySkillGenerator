[254.524173, "i", "cat > /tmp/forward.py <<'PYEOF'\nimport json, math\nd=json.load(open('/app/weights.json'))\ndef P(k): return d[k]['data'], d[k]['shape']\nW1,s1=P('input_layer.weight'); b1=d['input_layer.bias']['data']\nW2,s2=P('hidden_layer.weight'); b2=d['hidden_layer.bias']['data']\nW3,s3=P('output_layer.weight'); b3=d['output_layer.bias']['data']\nimg=[json.loads(l) for l in open('/tmp/img.json')] if False else None\n# load flat image from weights? instead hardcode read\nimport struct,zlib\npng=open('/app/image.png','rb').read()\npos=8;idat=b''\nwhile pos<len(png):\n    ln=struct.unpack('>I',png[pos:pos+4])[0]; ct=png[pos+4:pos+8]; cd=png[pos+8:pos+8+ln]\n    if ct==b'IHDR': w,h,bpc,c=struct.unpack('>IIBB',cd[:10])\n    elif ct==b'IDAT': idat+=cd\n    elif ct==b'IEND': break\n    pos+=12+ln\nraw=zlib.decompress(idat)\nstride=w*c*(bpc//8) if c in(0,3,4) else w*3*(bpc//8)\nout=bytearray();prev=bytearray(stride);p=0\nfor y in range(h):\n    ft=raw[p];p+=1;line=bytearray(raw[p:p+stride]);p+=stride;rec=bytearray(stride)\n    for i in range(stride):\n"]
[254.533497, "i", "        x=line[i];a=rec[i-stride] if i>=stride else 0;b=prev[i];cc=prev[i-stride] if i>=stride else 0\n        v=x if ft==0 else x+a if ft==1 else x+b if ft==2 else x+((a+b)//2) if ft==3 else x+(a if(a+b-cc-cc)else b)\n        rec[i]=v&0xff\n    prev=rec;out+=rec\nflat=[out[y*stride+x] for y in range(h) for x in range(w)]\ndef mv(W,sh,x):\n    oi,ii=sh; return [sum(W[i*ii+j]*x[j] for j in range(ii)) for i in range(oi)]\ndef add(a,b): return [a[i]+b[i] for i in range(len(a))]\ndef relu(v): return [x if x>0 else 0.0 for x in v]\ndef fwd(x):\n    x=relu(add(mv(W1,s1,x),b1)); x=relu(add(mv(W2,s2,x),b2)); return add(mv(W3,s3,x),b3)\ndef sm(v):\n    m=max(v);e=[math.exp(x-m) for x in v];s=sum(e);return [x/s for x in e]\nfor name,x in [('raw',[f for f in flat]),('/255',[f/255 for f in flat]),('norm',[(f/255-0.1307)/0.3081 for f in flat])]:\n    lg=fwd(x);pr=sm(lg);print(name,'argmax',max(range(10),key=lambda i:pr[i]),'conf=%.3f'%max(pr))\nPYEOF\npython3 /tmp/forward.py\n"]
[254.533909, "o", "cat > /tmp/forward.py <<'PYEOF'"]
