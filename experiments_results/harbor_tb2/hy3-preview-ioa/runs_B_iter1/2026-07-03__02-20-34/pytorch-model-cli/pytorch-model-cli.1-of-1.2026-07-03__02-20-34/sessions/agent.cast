[410.767857, "i", "cat > /app/main.cpp <<'EOF'\n#include <cstdio>\n#include <cstdlib>\n#include <string>\n#include <vector>\n#include \"cJSON.h\"\n#include \"lodepng.h\"\n\nstatic std::string readFile(const char* path) {\n    FILE* f = fopen(path, \"rb\");\n    if (!f) { fprintf(stderr, \"cannot open %s\\n\", path); exit(1); }\n    fseek(f, 0, SEEK_END);\n    long n = ftell(f);\n    fseek(f, 0, SEEK_SET);\n    std::string s;\n    s.resize((size_t)n);\n    size_t r = fread(&s[0], 1, (size_t)n, f);\n    (void)r;\n    fclose(f);\n    return s;\n}\n\nstatic float* load_param(cJSON* root, const char* name, int& rows, int& cols) {\n    cJSON* node = cJSON_GetObjectItem(root, name);\n    cJSON* shape = cJSON_GetObjectItem(node, \"shape\");\n    int nd = cJSON_GetArraySize(shape);\n    int d0 = cJSON_GetArrayItem(shape, 0)->valueint;\n    int d1 = (nd > 1) ? cJSON_GetArrayItem(shape, 1)->valueint : 1;\n    rows = d0; cols = d1;\n    int total = d0 * d1;\n    float* out = new float[total];\n    cJSON* data = cJSON_GetObjectItem(node, \"data\");\n    for (int i = 0; i < total; i++)"]
[410.767978, "i", " {\n        out[i] = (float)cJSON_GetArrayItem(data, i)->valuedouble;\n    }\n    return out;\n}\n\nstatic void linear(const float* W, const float* b, const float* x, int rows, int cols, float* out) {\n    for (int i = 0; i < rows; i++) {\n        float s = b[i];\n        const float* wr = W + (size_t)i * cols;\n        for (int j = 0; j < cols; j++) s += wr[j] * x[j];\n        out[i] = s;\n    }\n}\n\nstatic inline float relu(float v) { return v > 0.0f ? v : 0.0f; }\n\nint main(int argc, char** argv) {\n    if (argc < 3) {\n        fprintf(stderr, \"usage: %s weights.json image.png\\n\", argv[0]);\n        return 1;\n    }\n    std::string wpath = argv[1];\n    const char* ipath = argv[2];\n\n    std::string js = readFile(wpath.c_str());\n    cJSON* root = cJSON_Parse(js.c_str());\n    if (!root) { fprintf(stderr, \"bad json\\n\"); return 1; }\n\n    int r1, c1, r2, c2, r3, c3, r4, c4, r5, c5, r6, c6;\n    float* W1 = load_param(root, \"input_layer.weight\", r1, c1);\n    float* b1 = load_param(root, \"input_layer.bias\", r4, c4);\n    float* W2 = l"]
[410.768089, "i", "oad_param(root, \"hidden_layer.weight\", r2, c2);\n    float* b2 = load_param(root, \"hidden_layer.bias\", r5, c5);\n    float* W3 = load_param(root, \"output_layer.weight\", r3, c3);\n    float* b3 = load_param(root, \"output_layer.bias\", r6, c6);\n\n    std::vector<unsigned char> image;\n    unsigned w, h;\n    unsigned err = lodepng::decode(image, w, h, ipath);\n    if (err) { fprintf(stderr, \"png error %u: %s\\n\", err, lodepng_error_text(err)); return 1; }\n\n    int N = (int)(w * h);\n    float* x = new float[N];\n    for (int i = 0; i < N; i++) {\n        unsigned char pix = image[(size_t)i * 4 + 0];\n        x[i] = (float)(((double)pix / 255.0 - 0.1307) / 0.3081);\n    }\n\n    float* h1 = new float[r1];\n    float* h2 = new float[r2];\n    float* out = new float[r3];\n\n    linear(W1, b1, x, r1, c1, h1);\n    for (int i = 0; i < r1; i++) h1[i] = relu(h1[i]);\n    linear(W2, b2, h1, r2, c2, h2);\n    for (int i = 0; i < r2; i++) h2[i] = relu(h2[i]);\n    linear(W3, b3, h2, r3, c3, out);\n\n    int pred = 0;\n    for (int i = 1; i < r3; i"]
[410.768226, "o", "cat > /app/main.cpp <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.76824, "i", "++) if (out[i] > out[pred]) pred = i;\n\n    printf(\"%d\", pred);\n\n    size_t sl = wpath.find_last_of('/');\n    std::string dir = (sl == std::string::npos) ? std::string(\"./\") : wpath.substr(0, sl + 1);\n    std::string predp = dir + \"prediction.txt\";\n    FILE* pf = fopen(predp.c_str(), \"wb\");\n    if (pf) { fprintf(pf, \"%d\", pred); fclose(pf); }\n\n    return 0;\n}\nEOF\n"]
