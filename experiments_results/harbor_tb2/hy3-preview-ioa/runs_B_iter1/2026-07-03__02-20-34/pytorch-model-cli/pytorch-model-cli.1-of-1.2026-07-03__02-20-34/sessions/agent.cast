[276.300195, "i", "cat > /tmp/forward.py <<'PYEOF'\nimport json, math, struct, zlib\nd=json.load(open('/app/weights.json'))\nW1,s1=d['input_layer.weight']['data'],d['input_layer.weight']['shape']\nb1=d['input_layer.bias']['data']\nW2,s2=d['hidden_layer.weight']['data'],d['hidden_layer.weight']['shape']\nb2=d['hidden_layer.bias']['data']\nW3,s3=d['output_layer.weight']['data'],d['output_layer.weight']['shape']\nb3=d['output_layer.bias']['data']\npng=open('/app/image.png','rb').read()\npos=8;idat=b'';w=h=bpc=c=None\nwhile pos<len(png):\n    ln=struct.unpack('>I',png[pos:pos+4])[0]; ct=png[pos+4:pos+8]; cd=png[pos+8:pos+8+ln]\n    if ct==b'IHDR': w,h,bpc,c=struct.unpack('>IIBB',cd[:10])\n    elif ct==b'IDAT': idat+=cd\n    elif ct==b'IEND': break\n    pos+=12+ln\nraw=zlib.decompress(idat)\nch={0:1,2:3,3:1,4:2,6:4}[c]; bpp=ch*(bpc//8); stride=w*bpp\nout=bytearray();prev=bytearray(stride);p=0\nfor y in range(h):\n    ft=raw[p];p+=1;line=bytearray(raw[p:p+stride]);p+=stride;rec=bytearray(stride)\n    for i in range(stride):\n        x=line[i];a=rec[i-bpp] "]
