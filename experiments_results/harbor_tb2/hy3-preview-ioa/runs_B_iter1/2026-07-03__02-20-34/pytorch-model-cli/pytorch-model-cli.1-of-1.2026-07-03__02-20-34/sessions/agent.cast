[233.217321, "i", "cat > /tmp/analyze.py <<'PYEOF'\nimport zipfile, pickle, struct, zlib, io, math\n\nzf = zipfile.ZipFile('/app/model.pth')\n\nclass FloatStorage:\n    def __init__(self, key, device, numel):\n        raw = zf.read('simple_mnist/data/' + key)\n        self.data = list(struct.unpack('<%df' % numel, raw[:numel*4]))\n\ndef rebuild_tensor_v2(storage, offset, size, stride, requires_grad, hooks):\n    total = 1\n    for s in size: total *= s\n    return {'shape': list(size), 'data': storage.data[offset:offset+total]}\n\nclass OD(dict):\n    pass\n\nclass U(pickle.Unpickler):\n    def find_class(self, module, name):\n        if module=='torch' and name=='FloatStorage': return FloatStorage\n        if module=='torch._utils' and name=='_rebuild_tensor_v2': return rebuild_tensor_v2\n        if module=='collections' and name=='OrderedDict': return OD\n        raise Exception('no class %s.%s' % (module,name))\n    def persistent_load(self, pid):\n        kind, cls, key, device, numel = pid\n        return cls(key, device, numel)\n\nobj = U(io.BytesIO"]
[233.217396, "i", "(zf.read('simple_mnist/data.pkl'))).load()\nparams = {k:v for k,v in obj.items() if k!='_metadata'}\nfor k,v in params.items():\n    print(k, v['shape'])\n\nimport json\nout = {k:{'shape':v['shape'],'data':v['data']} for k,v in params.items()}\nopen('/app/weights.json','w').write(json.dumps(out))\nprint('wrote weights.json', len(json.dumps(out)), 'bytes')\n\ndef read_png(path):\n    d=open(path,'rb').read()\n    pos=8; width=height=bpc=ct=None; idat=b''\n    while pos<len(d):\n        ln=struct.unpack('>I',d[pos:pos+4])[0]; ctype=d[pos+4:pos+8]; cd=d[pos+8:pos+8+ln]\n        if ctype==b'IHDR': width,height,bpc,ct=struct.unpack('>IIBB',cd[:10])\n        elif ctype==b'IDAT': idat+=cd\n        elif ctype==b'IEND': break\n        pos+=12+ln\n    raw=zlib.decompress(idat)\n    ch={0:1,2:3,3:1,4:2,6:4}[ct]; bpp=ch*(bpc//8); stride=width*bpp\n    out=bytearray(); prev=bytearray(stride); p=0\n    for y in range(height):\n        ft=raw[p]; p+=1; line=bytearray(raw[p:p+stride]); p+=stride\n        rec=bytearray(stride)\n        for i in range"]
[233.218012, "i", "(stride):\n            x=line[i]\n            a=rec[i-bpp] if i>=bpp else 0; b=prev[i]; c=prev[i-bpp] if i>=bpp else 0\n            if ft==0: v=x\n            elif ft==1: v=x+a\n            elif ft==2: v=x+b\n            elif ft==3: v=x+((a+b)//2)\n            else:\n                pp=a+b-c; pa=abs(pp-a); pb=abs(pp-b); pc=abs(pp-c)\n                pr=a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\n                v=x+pr\n            rec[i]=v&0xff\n        prev=rec; out+=rec\n    img=[]\n    for y in range(height):\n        row=[]\n        for x in range(width):\n            base=y*stride+x*bpp\n            if ct in (0,3,4): g=out[base]\n            else: g=int(0.299*out[base]+0.587*out[base+1]+0.114*out[base+2])\n            row.append(g)\n        img.append(row)\n    return width,height,img\n\nw,h,img=read_png('/app/image.png')\nprint('image',w,h)\nfor row in img:\n    print(''.join('#' if p>128 else ('.' if p>40 else ' ') for p in row))\nflat=[img[y][x] for y in range(h) for x in range(w)]\n\ndef matvec(W,x): return [sum(W[i][j]*x"]
[233.21821, "o", "cat > /tmp/analyze.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import zipfile, pickle, struct, zlib, io, math\r\n\u001b[?2004l\r"]
[233.218241, "i", "[j] for j in range(len(x))) for i in range(len(W))]\ndef add(a,b): return [a[i]+b[i] for i in range(len(a))]\ndef relu(v): return [x if x>0 else 0.0 for x in v]\ndef forward(x):\n    x=relu(add(matvec(params['input_layer.weight']['data'],x),params['input_layer.bias']['data']))\n    x=relu(add(matvec(params['hidden_layer.weight']['data'],x),params['hidden_layer.bias']['data']))\n    x=add(matvec(params['output_layer.weight']['data'],x),params['output_layer.bias']['data'])\n    return x\ndef sm(v):\n    m=max(v); e=[math.exp(x-m) for x in v]; s=sum(e); return [x/s for x in e]\nfor name,x in [('raw',[f for f in flat]),('/255',[f/255 for f in flat]),('norm',[(f/255-0.1307)/0.3081 for f in flat])]:\n    logits=forward(x); p=sm(logits)\n    print(name,'argmax',max(range(10),key=lambda i:p[i]),'conf=%.3f'%max(p))\nPYEOF\npython3 /tmp/analyze.py\n"]
