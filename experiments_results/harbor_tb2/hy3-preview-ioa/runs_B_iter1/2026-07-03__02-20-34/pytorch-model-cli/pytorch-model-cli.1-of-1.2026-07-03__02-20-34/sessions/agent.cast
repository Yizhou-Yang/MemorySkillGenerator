[10.66992, "o", "cat /app/model.py\r\n\u001b[?2004l\r"]
[10.672982, "o", "import torch\r"]
[10.673795, "o", "\r\n"]
[10.674005, "o", "import torch.nn as nn\r"]
[10.674224, "o", "\r\n"]
[10.67459, "o", "\r\r\n\r\r\nclass MnistModel(nn.Module):\r\r\n    def __init__(\r\r\n        self,\r\r\n        input_dim: int,\r\r\n        hidden_dim: int,\r\r\n        num_classes: int,\r\r\n    ) -> torch.nn.Module:\r\r\n        super().__init__()\r\r\n\r\r\n        self.input_layer = nn.Linear(input_dim, hidden_dim)\r\r\n        self.hidden_layer = nn.Linear(hidden_dim, hidden_dim)\r\r\n        self.output_layer = nn.Linear(hidden_dim, num_classes)\r\r\n"]
[10.675027, "o", "        self.activation = nn.ReLU()\r\r\n\r\r\n    def forward(self, x):\r\r\n        x = self.input_layer(x)\r\r\n        x = self.activation(x)\r\r\n\r\r\n        x = self.hidden_layer(x)\r\r\n        x = self.activation(x)\r\r\n\r\r\n"]
[10.675579, "o", "        x = self.output_layer(x)\r\r\n        return x\r\r\n"]
[10.677437, "o", "\u001b[?2004h"]
[10.679322, "m", "Episode 1: 2 commands"]
[10.679322, "o", "root@42ea1ef673ba:/app# "]
