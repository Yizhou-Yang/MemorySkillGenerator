[276.487472, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         elif ft==1: v=x+a\r\n\u001b[?2004l\r\u001b[?2004h>         elif ft==2: v=x+b\r\n\u001b[?2004l\r\u001b[?2004h>         elif ft==3: v=x+((a+b)//2)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             pp=a+b-cc;pa=abs(pp-a);pb=abs(pp-b);pc=abs(pp-cc)\r\n\u001b[?2004l\r\u001b[?2004h>             pr=a if(pa<=pb and pa<=pc) else (b if pb<=pc else cc); v=x+pr\r\n\u001b[?2004l\r\u001b[?2004h>         rec[i]=v&0xff\r\n\u001b[?2004l\r\u001b[?2004h>     prev=rec;out+=rec\r\n\u001b[?2004l\r\u001b[?2004h> flat=[out[y*stride+x*bpp] for y in range(h) for x in range(w)]\r\n\u001b[?2004l\r\u001b[?2004h> def mv(W,sh,x):\r\n\u001b[?2004l\r\u001b[?2004h>     oi,ii=sh; return [sum(W[i*ii+j]*x[j] for j in range(ii)) for i in range(oi)]\r\n\u001b[?2004l\r\u001b[?2004h> def add(a,b): return [a[i]+b[i] for i in range(len(a))]\r\n\u001b[?2004l\r\u001b[?2004h> def relu(v): return [x if x>0 else 0.0 for x in v]\r\n\u001b[?2004l\r\u001b[?2004h> def fwd(x):\r\n\u001b[?2004l\r\u001b[?2004h>     x=relu(add(mv(W1,s1,x),b1)); x=relu(add(mv(W2,s2,x),b2)); return add(mv(W3,s3,x),b3)\r\n\u001b[?2004l\r\u001b[?2004h> def sm(v):\r\n\u001b[?2004l\r\u001b[?2004h>     m=max(v);e=[math.ex"]
[276.49398, "o", "p(x-m) for x in v];s=sum(e);return [x/s for x in e]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[276.494065, "o", "for name,x in [('raw',[f for f in flat]),('/255',[f/255 for f in flat]),('norm',[(f/255-0.1307)/0.3081 for f in flat])]:\r\n\u001b[?2004l\r\u001b[?2004h>     lg=fwd(x);pr=sm(lg);print(name,'argmax',max(range(10),key=lambda i:pr[i]),'conf=%.3f'%max(pr))\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r\u001b[?2004hroot@42ea1ef673ba:/app# python3 /tmp/forward.py\r\n\u001b[?2004l\r"]
