[410.788487, "o", "        unsigned char pix = image[(size_t)i * 4 + 0];\r\n\u001b[?2004l\r\u001b[?2004h>         x[i] = (float)(((double)pix / 255.0 - 0.1307) / 0.3081);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[410.788507, "o", "\u001b[?2004h"]
[410.788727, "o", "> "]
[410.788921, "o", "    float* h1 = new float[r1];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.789114, "o", "    float* h2 = new float[r2];\r\n\u001b[?2004l\r"]
[410.789242, "o", "\u001b[?2004h"]
[410.789281, "o", "> "]
[410.789421, "o", "    float* out = new float[r3];\r\n\u001b[?2004l\r"]
[410.789533, "o", "\u001b[?2004h> \r\n"]
[410.789554, "o", "\u001b[?2004l\r"]
[410.78968, "o", "\u001b[?2004h> "]
[410.789961, "o", "    linear(W1, b1, x, r1, c1, h1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.790107, "o", "    for (int i = 0; i < r1; i++) h1[i] = relu(h1[i]);\r\n\u001b[?2004l\r"]
[410.790304, "o", "\u001b[?2004h> "]
[410.790434, "o", "    linear(W2, b2, h1, r2, c2, h2);\r\n\u001b[?2004l\r"]
[410.790545, "o", "\u001b[?2004h> "]
[410.791029, "o", "    for (int i = 0; i < r2; i++) h2[i] = relu(h2[i]);\r\n\u001b[?2004l\r\u001b[?2004h>     linear(W3, b3, h2, r3, c3, out);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     int pred = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.79105, "o", "> "]
[410.791349, "o", "    for (int i = 1; i < r3; i++) if (out[i] > out[pred]) pred = i;\r\n\u001b[?2004l\r"]
[410.791462, "o", "\u001b[?2004h> "]
[410.791487, "o", "\r\n\u001b[?2004l\r"]
[410.79161, "o", "\u001b[?2004h> "]
[410.791631, "o", "    printf(\"%d\", pred);\r\n\u001b[?2004l\r"]
[410.791793, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.791931, "o", "    size_t sl = wpath.find_last_of('/');\r\n\u001b[?2004l\r"]
[410.791951, "o", "\u001b[?2004h> "]
[410.792192, "o", "    std::string dir = (sl == std::string::npos) ? std::string(\"./\") : wpath.substr(0, sl + 1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.792217, "o", "> "]
[410.792496, "o", "    std::string predp = dir + \"prediction.txt\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.792671, "o", "    FILE* pf = fopen(predp.c_str(), \"wb\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.792696, "o", "> "]
[410.792884, "o", "    if (pf) { fprintf(pf, \"%d\", pred); fclose(pf); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[410.792909, "o", "> \r\n\u001b[?2004l\r"]
[410.793033, "o", "\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r"]
[410.793053, "o", "\u001b[?2004h> "]
[410.793167, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[410.793191, "o", "EOF\r\n\u001b[?2004l\r"]
