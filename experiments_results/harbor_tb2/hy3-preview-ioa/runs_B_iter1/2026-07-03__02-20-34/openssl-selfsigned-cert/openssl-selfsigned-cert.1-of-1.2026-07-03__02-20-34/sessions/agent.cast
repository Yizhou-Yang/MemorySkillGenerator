[24.150513, "o", "Subject:"]
[24.151144, "o", "\r\nsubject=O = DevOps Team, CN = dev-internal.company.local\r\nValidity:\r\nnotBefore=Jul  2 19:40:36 2026 GMT\r\nnotAfter=Jul  2 19:40:36 2027 GMT\r\nSHA-256 Fingerprint:\r\nsha256 Fingerprint=B1:D0:6A:72:12:9E:80:B0:59:5C:6F:90:6E:F6:9E:77:F7:20:8F:48:55:7E:35:B0:D9:C7:A4:15:43:0C:A9:89\r\n"]
[24.151463, "m", "Episode 2: 2 commands"]
[24.151463, "o", "\u001b[?2004hroot@4ac15a82fdf0:/app# "]
[35.064049, "i", "cat > /app/check_cert.py << 'EOF'\nimport os\nimport ssl\nimport subprocess\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\n\ndef main():\n    if not os.path.exists(CERT_PATH):\n        print(\"Certificate not found at \" + CERT_PATH)\n        return\n\n    result = subprocess.run(\n        [\"openssl\", \"x509\", \"-in\", CERT_PATH, \"-noout\", \"-subject\", \"-dates\"],\n        capture_output=True, text=True,\n    )\n    if result.returncode != 0:\n        print(\"Failed to load certificate\")\n        print(result.stderr)\n        return\n\n    output = result.stdout\n\n    # Extract Common Name\n    common_name = \"unknown\"\n    for line in output.splitlines():\n        if line.strip().startswith(\"subject=\"):\n            subj = line.split(\"subject=\", 1)[1]\n            for part in subj.split(\",\"):\n                part = part.strip()\n                if part.startswith(\"CN =\"):\n                    common_name = part.split(\"CN =\", 1)[1].strip()\n\n    # Extract notAfter and convert to YYYY-MM-DD\n    expiration = \"unknown\"\n    for line in output.splitlines():\n  "]
[35.064419, "o", "cat > /app/check_cert.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import ssl\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> CERT_PATH = \"/app/ssl/server.crt\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.064552, "i", "      if line.strip().startswith(\"notAfter=\"):\n            date_str = line.split(\"notAfter=\", 1)[1].strip()  # e.g. Jul  2 19:40:36 2027 GMT\n            try:\n                from datetime import datetime\n                dt = datetime.strptime(date_str, \"%b %d %H:%M:%S %Y %Z\")\n                expiration = dt.strftime(\"%Y-%m-%d\")\n            except Exception:\n                expiration = date_str\n\n    print(\"Common Name: \" + common_name)\n    print(\"Expiration Date: \" + expiration)\n    print(\"Certificate verification successful\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
