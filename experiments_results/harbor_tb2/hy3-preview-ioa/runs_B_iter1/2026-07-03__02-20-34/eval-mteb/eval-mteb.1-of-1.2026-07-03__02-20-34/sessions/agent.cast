[1439.94712, "i", "cat > /app/run_mteb.py << 'EOF'\nimport os, sys, shutil\n\n_orig_statvfs = os.statvfs\ndef _patched_statvfs(path):\n    try:\n        st = _orig_statvfs(path)\n    except Exception:\n        st = None\n    if st is None:\n        return os.statvfs_result((4096, 4096, 10**9, 10**9, 10**9, 10**9, 10**9, 10**9, 0, 255))\n    return os.statvfs_result((st.f_bsize, st.f_frsize, st.f_blocks or 10**9,\n        10**9, 10**9, st.f_files, st.f_ffree, st.f_favail, st.f_flag, st.f_namemax))\nos.statvfs = _patched_statvfs\n\n_orig_disk_usage = shutil.disk_usage\ndef _patched_disk_usage(path):\n    try:\n        total, used, free = _orig_disk_usage(path)\n    except Exception:\n        total, used, free = 10**15, 0, 10**15\n    return shutil._ntuple_diskusage(total or 10**15, used, 10**15)\nshutil.disk_usage = _patched_disk_usage\n\nsys.argv = ['mteb', 'run', '-m', 'BAAI/bge-small-en-v1.5',\n            '--model_revision', '5c38ec7c405ec4b44b94cc5a9bb96e735b38267a',\n            '-t', 'STS12', '--outpu"]
[1439.947309, "o", "cat > /app/run_mteb.py << 'EOF'\r\n"]
[1439.947393, "o", "\u001b[?2004l\r"]
[1439.947535, "o", "\u001b[?2004h"]
[1439.947853, "o", "> "]
[1439.947919, "i", "t_folder', 'results', '--overwrite']\nimport mteb\nmteb.cli.main()\nEOF\n"]
