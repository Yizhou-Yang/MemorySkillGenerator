[100.081895, "i", "cat > /app/train.py << 'EOF'\nimport os\nimport random\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport gymnasium as gym\n\nfrom agent import Agent, DQN\n\nSEED = 0\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\n\nENV_NAME = \"CartPole-v1\"\ndevice = torch.device(\"cpu\")\n\nBATCH_SIZE = 128\nGAMMA = 0.99\nLR = 1e-3\nBUFFER_SIZE = 20000\nEPS_START = 1.0\nEPS_END = 0.05\nEPS_DECAY = 800\nTARGET_UPDATE = 10\nNUM_EPISODES = 1000\nSAVE_DIR = \"/app/trained_model\"\n\n\nclass ReplayBuffer:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.buffer = []\n        self.pos = 0\n\n    def push(self, s, a, r, s2, d):\n        if len(self.buffer) < self.capacity:\n            self.buffer.append(None)\n        self.buffer[self.pos] = (s, a, r, s2, d)\n        self.pos = (self.pos + 1) % self.capacity\n\n    def sample(self, n):\n        idx = np.random.choice(len(self.buffer), n, replace=False)\n        s = np.array([self.buffer[i][0] for i in idx])\n        a = np.array([self."]
[100.082041, "i", "buffer[i][1] for i in idx])\n        r = np.array([self.buffer[i][2] for i in idx])\n        s2 = np.array([self.buffer[i][3] for i in idx])\n        d = np.array([self.buffer[i][4] for i in idx])\n        return s, a, r, s2, d\n\n    def __len__(self):\n        return len(self.buffer)\n\n\ndef evaluate(agent, env, episodes=20):\n    rs = []\n    for _ in range(episodes):\n        o, _ = env.reset()\n        d = False\n        t = 0\n        while not d:\n            a = agent.select_action(o)\n            o, r, term, trunc, _ = env.step(a)\n            t += r\n            d = term or trunc\n        rs.append(t)\n    return sum(rs) / len(rs)\n\n\ndef main():\n    env = gym.make(ENV_NAME)\n    agent = Agent()\n    target = DQN().to(device)\n    target.load_state_dict(agent.policy_net.state_dict())\n    target.eval()\n    optimizer = optim.Adam(agent.policy_net.parameters(), lr=LR)\n    buffer = ReplayBuffer(BUFFER_SIZE)\n\n    steps_done = 0\n    best_score = -1\n\n    for ep in range(NUM_EPISODES):\n        o, _ = env.reset()\n        d = False\n  "]
[100.082082, "i", "      total = 0\n        while not d:\n            eps = EPS_END + (EPS_START - EPS_END) * np.exp(-steps_done / EPS_DECAY)\n            steps_done += 1\n            if np.random.rand() < eps:\n                a = env.action_space.sample()\n            else:\n                a = agent.select_action(o)\n            o2, r, term, trunc, _ = env.step(a)\n            d = term or trunc\n            buffer.push(o, a, r, o2, d)\n            o = o2\n            total += r\n            if len(buffer) >= BATCH_SIZE:\n                s, a, r, s2, d = buffer.sample(BATCH_SIZE)\n                s = torch.as_tensor(s, dtype=torch.float32)\n                a = torch.as_tensor(a, dtype=torch.int64).unsqueeze(1)\n                r = torch.as_tensor(r, dtype=torch.float32).unsqueeze(1)\n                s2 = torch.as_tensor(s2, dtype=torch.float32)\n                d = torch.as_tensor(d, dtype=torch.float32).unsqueeze(1)\n                q = agent.policy_net(s).gather(1, a)\n                with torch.no_grad():\n                    nq = target(s2).ma"]
[100.082118, "i", "x(1)[0].unsqueeze(1)\n                    target_q = r + GAMMA * nq * (1 - d)\n                loss = nn.functional.smooth_l1_loss(q, target_q)\n                optimizer.zero_grad()\n                loss.backward()\n                optimizer.step()\n        if ep % TARGET_UPDATE == 0:\n            target.load_state_dict(agent.policy_net.state_dict())\n        if ep % 25 == 0 or ep == NUM_EPISODES - 1:\n            score = evaluate(agent, env, 20)\n            print(f\"Episode {ep}, score {score:.1f}, eps {eps:.3f}\")\n            if score > best_score:\n                best_score = score\n                agent.save(SAVE_DIR)\n                print(f\"  -> saved best ({best_score:.1f})\")\n            if score >= 490 and ep >= 200:\n                print(\"Early stop: good enough\")\n                break\n    env.close()\n    print(f\"Best score: {best_score:.1f}\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
