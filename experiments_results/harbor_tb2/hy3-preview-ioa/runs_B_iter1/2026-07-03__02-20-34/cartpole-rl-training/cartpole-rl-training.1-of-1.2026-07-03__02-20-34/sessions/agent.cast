[100.161394, "o", "\r\n"]
[100.161581, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[100.161713, "o", "                    target_q = r + GAMMA * nq * (1 - d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.161925, "o", "                loss = nn.functional.smooth_l1_loss(q, target_q)\r\n\u001b[?2004l\r\u001b[?2004h> "]
