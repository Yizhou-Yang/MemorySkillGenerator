[100.089848, "o", "        self.buffer = []\r\n\u001b[?2004l\r\u001b[?2004h>         self.pos = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def push(self, s, a, r, s2, d):\r\n\u001b[?2004l\r\u001b[?2004h>         if len(self.buffer) < self.capacity:\r\n\u001b[?2004l\r\u001b[?2004h>             self.buffer.append(None)\r\n\u001b[?2004l\r\u001b[?2004h>         self.buffer[self.pos] = (s, a, r, s2, d)\r\n\u001b[?2004l\r\u001b[?2004h>         self.pos = (self.pos + 1) % self.capacity\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def sample(self, n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.090293, "o", "        idx = np.random.choice(len(self.buffer), n, replace=False)\r\n\u001b[?2004l\r\u001b[?2004h>         s = np.array([self.buffer[i][0] for i in idx])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.09044, "o", "        a = np.array([self.buffer[i][1] for i in idx])\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.090465, "o", "> "]
