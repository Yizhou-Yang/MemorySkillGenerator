[668.652133, "i", "cat > /tmp/probe3.py << 'PYEOF'\nimport socket, json\npayload = json.dumps({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\",\"params\":[]}).encode()\nreq = (b\"POST / HTTP/1.1\\r\\nHost: api.devnet.solana.com\\r\\nContent-Type: application/json\\r\\nContent-Length: %d\\r\\nConnection: close\\r\\n\\r\\n%s\" % (len(payload), payload))\n\ndef run(name, fn):\n    try:\n        s = fn(); s.settimeout(10)\n        s.sendall(req)\n        data=b''\n        while True:\n            c=s.recv(4096)\n            if not c: break\n            data+=c\n        print(name, '->', data[:250])\n        s.close()\n    except Exception as e:\n        print(name, 'ERR', repr(e))\n\ndef direct80():\n    return socket.create_connection(('api.devnet.solana.com', 80), 8)\n\ndef via_proxy():\n    s = socket.create_connection(('192.168.144.1', 8080), 8)\n    s.sendall(b\"POST http://api.devnet.solana.com/ HTTP/1.1\\r\\nHost: api.devnet.solana.com\\r\\nContent-Type: application/json\\r\\nContent-Length: %d\\r\\nConnection: close\\r\\n\\r\\n%s\" %"]
