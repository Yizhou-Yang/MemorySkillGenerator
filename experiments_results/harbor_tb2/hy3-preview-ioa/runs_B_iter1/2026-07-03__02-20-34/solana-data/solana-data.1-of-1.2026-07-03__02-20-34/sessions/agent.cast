[517.859573, "i", "cat > /tmp/probe.py << 'PYEOF'\nimport socket, ssl, json\n\nhost, port = 'api.devnet.solana.com', 443\npayload = json.dumps({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\",\"params\":[]}).encode()\n\ndef try_connect_tunnel():\n    try:\n        s = socket.create_connection((host, port), 8)\n        s.settimeout(8)\n        req = (f\"CONNECT {host}:443 HTTP/1.1\\r\\nHost: {host}:443\\r\\n\\r\\n\").encode()\n        s.sendall(req)\n        resp = s.recv(200)\n        print(\"CONNECT resp:\", resp[:120])\n        if b\"200\" in resp:\n            ctx = ssl.create_default_context()\n            tls = ctx.wrap_socket(s, server_hostname=host)\n            tls.sendall(b\"POST / HTTP/1.1\\r\\nHost: %s\\r\\nContent-Type: application/json\\r\\nContent-Length: %d\\r\\nConnection: close\\r\\n\\r\\n%s\" % (host.encode(), len(payload), payload))\n            data = b\"\"\n            while True:\n                chunk = tls.recv(4096)\n                if not chunk: break\n                data += chunk\n            print(\"TUNNEL OK"]
[517.859917, "o", "cat > /tmp/probe.py << 'PYEOF'"]
[517.86006, "o", "\r\n"]
[517.860094, "o", "\u001b[?2004l\r\u001b[?2004h"]
[517.860302, "o", "> "]
[517.860398, "o", "import socket, ssl, json\r\n\u001b[?2004l\r"]
[517.860521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
