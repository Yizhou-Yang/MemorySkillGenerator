[176.667842, "i", "(\"amount\")\n                amt = int(amt) if amt is not None else 0\n                m[pk] = (mint, amt)\n            return m\n        pre = balances(meta.get(\"preTokenBalances\"))\n        post = balances(meta.get(\"postTokenBalances\"))\n        token_transfers = []\n        for pk in set(pre.keys()) | set(post.keys()):\n            pa = pre.get(pk, (None, 0))[1]\n            po = post.get(pk, (None, 0))[1]\n            if pa != po:\n                mint = (post.get(pk) or pre.get(pk))[0]\n                token_transfers.append({\n                    \"account\": pk,\n                    \"mint\": mint,\n                    \"amount\": abs(po - pa),\n                })\n        sigs = ((tx.get(\"transaction\") or {}).get(\"signatures\") or [])\n        sig = sigs[0] if sigs else signature\n        return jsonify({\n            \"signature\": sig,\n            \"slot\": tx.get(\"slot\"),\n            \"block_time\": tx.get(\"blockTime\"),\n            \"success\": meta.get(\"err\") is None,\n            \"fee\": meta.get(\"fee\"),\n            \"token_transfers\""]
