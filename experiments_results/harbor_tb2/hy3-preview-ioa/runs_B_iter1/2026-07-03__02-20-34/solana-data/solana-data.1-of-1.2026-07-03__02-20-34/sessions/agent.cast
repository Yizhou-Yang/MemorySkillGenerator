[625.817172, "i", "cat > /tmp/probe2.py << 'PYEOF'\nimport socket, ssl, json\nhost, port = 'api.devnet.solana.com', 443\nproxy_host, proxy_port = '192.168.144.1', 8080\npayload = json.dumps({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\",\"params\":[]}).encode()\ntry:\n    s = socket.create_connection((proxy_host, proxy_port), 8)\n    s.settimeout(10)\n    req = (f\"CONNECT {host}:443 HTTP/1.1\\r\\nHost: {host}:443\\r\\n\\r\\n\").encode()\n    s.sendall(req)\n    resp = s.recv(200)\n    print(\"PROXY CONNECT resp:\", resp[:120])\n    if b\"200\" in resp:\n        ctx = ssl.create_default_context()\n        tls = ctx.wrap_socket(s, server_hostname=host)\n        body = b\"POST / HTTP/1.1\\r\\nHost: %s\\r\\nContent-Type: application/json\\r\\nContent-Length: %d\\r\\nConnection: close\\r\\n\\r\\n%s\" % (host.encode(), len(payload), payload)\n        tls.sendall(body)\n        data = b\"\"\n        while True:\n            chunk = tls.recv(4096)\n            if not chunk: break\n            data += chunk\n        print(\"PROXY TUNNEL OK:\", data[:400])\n    s.close()\nexcept Exception as e"]
[625.817385, "i", ":\n    print(\"proxy tunnel err:\", repr(e))\nPYEOF\npython3 /tmp/probe2.py\n"]
