[594.066252, "i", "ip route 2>/dev/null | head; echo '---'; for p in 8080 3128 8888 1087 7890; do timeout 2 bash -c \"echo > /dev/tcp/192.168.144.1/$p\" 2>/dev/null && echo \"gw:$p open\" || echo \"gw:$p closed\"; done\n"]
[594.06786, "o", "ip route 2>/dev/null | head; echo '---'; for p in 8080 3128 8888 1087 7890; do timeout 2 bash -c \"echo > /dev/tcp/192.168.144.1/$p\" 2>/dev/null && echo \"gw:$p open\" || echo \"gw:$p closed\"; done"]
