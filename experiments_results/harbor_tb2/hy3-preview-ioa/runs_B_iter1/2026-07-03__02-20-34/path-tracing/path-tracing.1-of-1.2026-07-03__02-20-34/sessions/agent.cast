[396.68785, "i", "cat > /tmp/ascii.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nimg = np.array(Image.open('image.ppm')).astype(float)\nH,W,_ = img.shape\nlum = img.mean(axis=2)\nchars = ' .:-=+*#%@'\nsh, sw = 50, 100\nfor j in range(sh):\n    row=''\n    for i in range(sw):\n        y0=j*H//sh; y1=(j+1)*H//sh\n        x0=i*W//sw; x1=(i+1)*W//sw\n        v = lum[y0:y1, x0:x1].mean()\n        row += chars[int(v/255*(len(chars)-1))]\n    print(row)\nEOF\n.venv/bin/python /tmp/ascii.py\n"]
[396.688743, "o", "cat > /tmp/ascii.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
