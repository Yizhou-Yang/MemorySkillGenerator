[358.249777, "i", "cat > /tmp/analyze.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nimg = np.array(Image.open('image.ppm'))\nprint('shape', img.shape, 'dtype', img.dtype)\nprint('unique colors approx', len(np.unique(img.reshape(-1,3),axis=0)))\nprint('min', img.min(axis=(0,1)), 'max', img.max(axis=(0,1)))\n# sample a few rows\nfor y in [0, 100, 300, 599]:\n    print('row', y, 'first px', img[y,0], 'mid px', img[y,400])\n# row difference to check gradient\nrow0 = img[0].astype(int)\nprint('row0 diff first 10 cols:', np.diff(row0[:10], axis=0).sum(axis=1))\n# overall: is it a horizontal gradient?\ncol0 = img[:,0].astype(int)\nprint('col0 diff first 10 rows:', np.diff(col0[:10], axis=0).sum(axis=1))\n# check if image is separable-ish: compute mean color per row and per column\ndata = img.reshape(-1,3).astype(float)\nprint('mean color', data.mean(axis=0))\nEOF\n.venv/bin/python /tmp/analyze.py\n"]
[358.260328, "o", "cat > /tmp/analyze.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> img = np.array(Image.open('image.ppm'))\r\n\u001b[?2004l\r\u001b[?2004h> print('shape', img.shape, 'dtype', img.dtype)\r\n\u001b[?2004l\r\u001b[?2004h> print('unique colors approx', len(np.unique(img.reshape(-1,3),axis=0)))\r\n\u001b[?2004l\r\u001b[?2004h> print('min', img.min(axis=(0,1)), 'max', img.max(axis=(0,1)))\r\n\u001b[?2004l\r\u001b[?2004h> # sample a few rows\r\n\u001b[?2004l\r\u001b[?2004h> for y in [0, 100, 300, 599]:\r\n\u001b[?2004l\r\u001b[?2004h>     print('row', y, 'first px', img[y,0], 'mid px', img[y,400])\r\n\u001b[?2004l\r\u001b[?2004h> # row difference to check gradient\r\n\u001b[?2004l\r\u001b[?2004h> row0 = img[0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> print('row0 diff first 10 cols:', np.diff(row0[:10], axis=0).sum(axis=1))\r\n\u001b[?2004l\r\u001b[?2004h> # overall: is it a horizontal gradient?\r\n\u001b[?2004l\r\u001b[?2004h> col0 = img[:,0].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> print('col0 diff first 10 rows:', np.diff(col0[:10], axis=0).sum(axis=1))\r\n\u001b[?2004l\r\u001b[?2004h> # check if image is separable-ish: compute mean color per row and per column\r\n\u001b[?2004l\r\u001b[?2004h> data = img.reshape(-1,3).astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> print('mean color', data.mean(axis=0))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[358.268361, "o", "\u001b[?2004hroot@cc35861dabf3:/app# "]
[358.26843, "o", ".venv/bin/python /tmp/analyze.py\r\n\u001b[?2004l\r"]
