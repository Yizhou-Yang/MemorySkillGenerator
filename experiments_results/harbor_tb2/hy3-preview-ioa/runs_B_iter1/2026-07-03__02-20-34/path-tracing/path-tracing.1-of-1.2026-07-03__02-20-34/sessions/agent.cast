[397.273869, "o", "\u001b[?2004hroot@cc35861dabf3:/app# "]
[421.01602, "i", "cat > /tmp/prof.py << 'EOF'\nimport numpy as np\nfrom PIL import Image\nimg = np.array(Image.open('image.ppm')).astype(float)\nH,W,_ = img.shape\n# row profile (down sample rows to 60)\nfor j in range(0,H,10):\n    r = img[j].mean(axis=0)\n    print(f'row {j:3d}: R{r[0]:6.1f} G{r[1]:6.1f} B{r[2]:6.1f}')\nEOF\n.venv/bin/python /tmp/prof.py\n"]
