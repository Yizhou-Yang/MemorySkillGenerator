[249.025208, "i", "python3 - <<'EOF'\nfrom transformers import AutoTokenizer, AutoModel\nimport os\nos.environ[\"HF_HUB_OFFLINE\"] = \"1\"\ntok = AutoTokenizer.from_pretrained(\"albert/albert-base-v2\", local_files_only=True)\nm = AutoModel.from_pretrained(\"albert/albert-base-v2\", local_files_only=True)\nout = m(**tok(\"Hello, I am offline on a flight.\", return_tensors=\"pt\"))\nprint(\"OFFLINE_OK\", tok.__class__.__name__, m.__class__.__name__, tuple(out.last_hidden_state.shape))\nEOF\n"]
