[588.517896, "i", "cat > /app/solve.py << 'EOF'\nimport os\nfrom huggingface_hub import hf_hub_download\nfrom pyarrow import parquet as pq\nfrom transformers import AutoTokenizer\n\ntok = AutoTokenizer.from_pretrained('Qwen/Qwen2.5-1.5B-Instruct')\nREPO='open-thoughts/OpenThoughts-114k'\nshards=[f'metadata/train-{i:05d}-of-00012.parquet' for i in range(12)]\nSCI={'biology','physics','chemistry'}\ntotal=0\nfor sh in shards:\n    path=hf_hub_download(repo_id=REPO, filename=sh, repo_type='dataset')\n    t=pq.read_table(path, columns=['domain','deepseek_reasoning','deepseek_solution'])\n    dom=t.column('domain').to_pylist()\n    sci=[i for i,d in enumerate(dom) if d in SCI]\n    del dom\n    cnt=0\n    if sci:\n        reasoning=t.column('deepseek_reasoning').to_pylist()\n        solution=t.column('deepseek_solution').to_pylist()\n        txts=[]\n        for i in sci:\n            txts.append(reasoning[i] or '')\n            txts.append(solution[i] or '')\n        del reasoning, solution\n        batch=500\n        for j in range(0,len(txts),batch):\n      "]
[588.51798, "i", "      ids=tok(txts[j:j+batch], add_special_tokens=False, truncation=False)['input_ids']\n            cnt+=sum(len(x) for x in ids)\n        del txts\n    total+=cnt\n    print(f'{sh} sci_examples={len(sci)} tokens={cnt} running_total={total}', flush=True)\n    del t\n    os.remove(path)\nprint('TOTAL', total, flush=True)\nwith open('/app/answer.txt','w') as f:\n    f.write(str(total))\nEOF\nnohup python3 /app/solve.py > /app/solve.log 2>&1 &\n"]
