[542.196166, "i", "cat > /app/scan.py << 'EOF'\nfrom collections import Counter\nfrom huggingface_hub import hf_hub_download\nfrom pyarrow import parquet as pq\nimport os\nREPO='open-thoughts/OpenThoughts-114k'\nshards=[f'metadata/train-{i:05d}-of-00012.parquet' for i in range(12)]\nfor sh in shards:\n    path=hf_hub_download(repo_id=REPO, filename=sh, repo_type='dataset')\n    t=pq.read_table(path, columns=['domain'])\n    c=Counter(t.column('domain').to_pylist())\n    print(sh, dict(c.most_common()), flush=True)\n    del t\n    os.remove(path)\nEOF\nnohup python3 /app/scan.py > /app/scan.log 2>&1 &\n"]
