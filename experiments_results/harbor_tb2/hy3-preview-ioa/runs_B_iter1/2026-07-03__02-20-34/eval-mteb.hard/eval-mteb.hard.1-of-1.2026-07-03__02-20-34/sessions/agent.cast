[1916.299016, "i", "cat > /app/run.py <<'PY'\nimport mteb\n\nmodel_name = \"sentence-transformers/all-mpnet-base-v2\"\ncommit = \"e8c3b32edf5434bc2275fc9bab85f82640a19130\"\n\nmodel = mteb.get_model(model_name)\n# force the model folder name and revision so output path matches the required format\nmodel.mteb_model_meta.name = model_name\nmodel.mteb_model_meta.revision = commit\nprint(\"meta.name =\", model.mteb_model_meta.name)\nprint(\"meta.revision =\", model.mteb_model_meta.revision)\nprint(\"path =\", model.mteb_model_meta.model_name_as_path())\n\ntask = mteb.get_task(\"STS12\")\nevaluation = mteb.MTEB(tasks=[task])\nresults = evaluation.run(model, output_folder=\"results\", verbosity=2)\n\nfor r in results:\n    print(\"TASK RESULT:\", r.task_name)\n    print(r)\nPY\n"]
