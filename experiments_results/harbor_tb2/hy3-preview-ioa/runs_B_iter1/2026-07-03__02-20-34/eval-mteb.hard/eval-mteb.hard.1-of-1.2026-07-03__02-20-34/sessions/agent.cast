[2090.773738, "o", "def has_sufficient_disk_space(needed_bytes, directory=\".\"):"]
[2090.774488, "o", "\r\n"]
[2090.774674, "o", "    try:"]
[2090.774875, "o", "\r\n"]
[2090.775052, "o", "        free_bytes = disk_usage(os.path.abspath(directory)).free"]
[2090.775249, "o", "\r\n"]
[2090.775427, "o", "    except OSError:"]
[2090.775603, "o", "\r\n"]
[2090.775802, "o", "        return True"]
[2090.776, "o", "\r\n"]
[2090.776208, "o", "    return needed_bytes < free_bytes"]
[2090.776388, "o", "\r\n"]
[2090.77658, "o", "\r\n"]
[2090.776853, "o", "\r\n"]
[2090.777045, "o", "def _convert_github_url(url_path: str) -> Tuple[str, Optional[str]]:"]
[2090.777256, "o", "\r\n"]
[2090.777925, "o", "    \"\"\"Convert a link to a file on a github repo in a link to the raw github object.\"\"\""]
[2090.788568, "o", "\r\n"]
[2090.788725, "o", "    parsed = urlparse(url_path)"]
[2090.788833, "o", "\r\n"]
[2090.788967, "o", "    sub_directory = None"]
[2090.789114, "o", "\r\n"]
[2090.789221, "o", "    if parsed.scheme in (\"http\", \"https\", \"s3\") and parsed.netloc == \"github.com\":"]
[2090.789396, "o", "\r\n"]
[2090.789532, "o", "        if \"blob\" in url_path:"]
[2090.789638, "o", "\r\n"]
[2090.789769, "o", "            if not url_path.endswith(\".py\"):"]
[2090.789873, "o", "\r\n"]
[2090.789978, "o", "                raise ValueError(f\"External import from github at {url_path} should point to a file ending with '.py'\")"]
[2090.790095, "o", "\r\n"]
[2090.790201, "o", "            url_path = url_path.replace(\"blob\", \"raw\")  # Point to the raw file"]
[2090.790314, "o", "\r\n"]
[2090.791496, "o", "\u001b[?2004h"]
