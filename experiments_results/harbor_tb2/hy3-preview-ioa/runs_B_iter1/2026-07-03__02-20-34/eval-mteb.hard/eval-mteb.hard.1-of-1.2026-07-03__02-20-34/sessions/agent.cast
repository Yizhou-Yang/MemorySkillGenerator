[1082.9315, "o", "def model_meta_from_sentence_transformers(model: SentenceTransformer) -> ModelMeta:"]
[1082.932194, "o", "\r\n"]
[1082.932333, "o", "    try:"]
[1082.932606, "o", "\r\n"]
[1082.932821, "o", "        name = ("]
[1082.933, "o", "\r\n"]
[1082.933201, "o", "            model.model_card_data.model_name"]
[1082.933383, "o", "\r\n"]
[1082.934049, "o", "            if model.model_card_data.model_name"]
[1082.938437, "o", "\r\n            else model.model_card_data.base_model\r\n        )\r\n        languages = (\r\n            [model.model_card_data.language]\r\n            if isinstance(model.model_card_data.language, str)\r\n            else model.model_card_data.language\r\n"]
[1082.938688, "o", "        )"]
[1082.938844, "o", "\r\n"]
[1082.93893, "o", "        meta = ModelMeta("]
[1082.939002, "o", "\r\n"]
[1082.939152, "o", "            name=name,"]
[1082.939313, "o", "\r\n"]
[1082.939493, "o", "            revision=model.model_card_data.base_model_revision,\r\n            release_date=None,\r\n            languages=languages,\r\n            framework=[\"Sentence Transformers\"],\r\n            similarity_fn_name=model.similarity_fn_name,\r\n            n_parameters=None,\r\n            memory_usage_mb=None,"]
[1082.940133, "o", "\r\n            max_tokens=None,\r\n            embed_dim=None,\r\n            license=None,\r\n            open_weights=True,\r\n            public_training_code=None,\r\n            public_training_data=None,\r\n            use_instructions=None,\r\n            training_datasets=None,\r\n        )\r\n    except AttributeError as e:\r\n        logger.warning(\r\n            f\"Failed to extract metadata from model: {e}. Upgrading to sentence-transformers v3.0.0 or above is recommended.\"\r\n"]
[1082.940718, "o", "\u001b[?2004hroot@881a47b6fe43:/app# "]
