ne and Food Pairing Research", "value_type": "str"}, {"name": "start_datetime", "value": "2024-10-20 11:00:00", "value_type": "str"}, {"name": "end_datetime", "value": "2024-10-20 13:00:00", "value_type": "str"}, {"name": "tag", "value": "Work", "value_type": "Optional[str]"}, {"name": "description", "value": "Research and experiment with different wine and food pairings to create new menu items.", "value_type": "Optional[str]"}, {"name": "location", "value": "Restaurant Kitchen", "value_type": "Optional[str]"}, {"name": "attendees", "value": "[\"Aurélien LaFleur\"]", "value_type": "list[str]"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 1728975601, "event_id": "OracleEvent-AGENT-5b50f6d7-2d73-4ee8-9265-777366c31086", "dependencies": ["Event-USER-398c1995-6080-4abd-ac7f-fece77d79c8b"], "event_relative_time": 1, "action": {"action_id": "", "app": "Calendar", "function": "add_calendar_event", "operation_type": null, "args": [{"name": "title", "value": "Wine Tasting", "value_type": "str"}, {"name": "start_datetime", "value": "2024-10-20 15:00:00", "value_type": "str"}, {"name": "end_datetime", "value": "2024-10-20 18:00:00", "value_type": "str"}, {"name": "tag", "value": "Work", "value_type": "Optional[str]"}, {"name": "description", "value": "Taste and evaluate new wines for the restaurant's wine list.", "value_type": "Optional[str]"}, {"name": "location", "value": "Wine Cellar", "value_type": "Optional[str]"}, {"name": "attendees", "value": "[\"Aurélien LaFleur\",\"Luís Silva\"]", "value_type": "list[str]"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 1728975601, "event_id": "OracleEvent-AGENT-14f63089-334d-4daf-9899-9a257c08ea51", "dependencies": ["Event-USER-398c1995-6080-4abd-ac7f-fece77d79c8b"], "event_relative_time": 1, "action": {"action_id": "", "app": "Calendar", "function": "add_calendar_event", "operation_type": null, "args": [{"name": "title", "value": "Wine Tasting", 