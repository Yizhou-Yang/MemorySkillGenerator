 "event_relative_time": 1.0, "action": {"action_id": "", "app": "Calendar", "function": "delete_calendar_event", "operation_type": null, "args": [{"name": "event_id", "value": "{{OracleEvent-AGENT-9ca29aa0-de61-43b9-8784-1181580bc6b2}}", "value_type": "str"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-e3cb5699-1201-4394-bc94-1b58b040b00f", "dependencies": ["Event-ENV-db27d521-bdb2-4e54-93c7-9020aad11998"], "event_relative_time": 1.0, "action": {"action_id": "", "app": "Calendar", "function": "delete_calendar_event", "operation_type": null, "args": [{"name": "event_id", "value": "2c50e300723342fd890a082b5b19cbba", "value_type": "str"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-95fb6b1a-36b8-42fc-a2cb-ee62b2b5b502", "dependencies": ["Event-ENV-db27d521-bdb2-4e54-93c7-9020aad11998"], "event_relative_time": 1.0, "action": {"action_id": "", "app": "Calendar", "function": "delete_calendar_event", "operation_type": null, "args": [{"name": "event_id", "value": "06551b52bea4471a87591728dfb818ab", "value_type": "str"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-818b871a-acdf-43e1-b953-009f5415c6e6", "dependencies": ["Event-ENV-db27d521-bdb2-4e54-93c7-9020aad11998"], "event_relative_time": 1.0, "action": {"action_id": "", "app": "Calendar", "function": "delete_calendar_event", "operation_type": null, "args": [{"name": "event_id", "value": "4ef002bd4c244d74a176d172b6d3094a", "value_type": "str"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-ad7375b9-b7dd-44a1-a4fa-13a57250e186", "dependencies": ["Event-ENV-db27d521-bdb2-4e54-93c7-9020aad11998"], "event_relative_time": 1.0, "action": {"action_id": "", "app": "Calendar", "function": "delete_calendar_event", "oper