"OracleEvent-AGENT-69ae9486-7cbc-4ffa-8de1-43a552e872b6", "dependencies": ["Event-USER-7762adbb-7467-44f5-a40e-37fc8048269f"], "event_relative_time": 1.0, "action": {"action_id": "", "app": "Calendar", "function": "delete_calendar_event", "operation_type": null, "args": [{"name": "event_id", "value": "1b1df251b5044fab93d395277aff298a", "value_type": "str"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-539123b0-3ac0-4225-8e6c-a6d00e629b60", "dependencies": ["Event-USER-7762adbb-7467-44f5-a40e-37fc8048269f"], "event_relative_time": 1.0, "action": {"action_id": "", "app": "Calendar", "function": "delete_calendar_event", "operation_type": null, "args": [{"name": "event_id", "value": "f041377cce14424692cf96b15fc4fd0b", "value_type": "str"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-d36add1f-6ca3-4f72-839d-4fec1e1708f9", "dependencies": ["Event-USER-7762adbb-7467-44f5-a40e-37fc8048269f"], "event_relative_time": 1.0, "action": {"action_id": "", "app": "Chats", "function": "send_message", "operation_type": null, "args": [{"name": "user_id", "value": "dd868d91-a65d-43bc-ab1a-3090c6932f4f", "value_type": "str"}, {"name": "content", "value": "Get me out of this deal, fast!", "value_type": "str"}, {"name": "attachment_path", "value": "", "value_type": "Optional[str]"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-b8c62a0a-3878-40bf-8a74-54023eaf2028", "dependencies": ["Event-USER-7762adbb-7467-44f5-a40e-37fc8048269f"], "event_relative_time": 1.0, "action": {"action_id": "", "app": "AgentUserInterface", "function": "send_message_to_user", "operation_type": null, "args": [{"name": "content", "value": "There are multiple Swedish marketing managers in your contacts. Could you please specify which one you would like to email?", "value_type": "str"