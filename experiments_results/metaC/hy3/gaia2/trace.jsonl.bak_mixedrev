 "value": "+46181234567", "value_type": "str"}, {"name": "content", "value": "Hey Åsa, Property Tour is on Saturday, Oct 19, 4PM-5PM at Lund Luxury Living, Klostergatan 15, Lund 222 22", "value_type": "str"}, {"name": "attachment_path", "value": "", "value_type": "Optional[str]"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-16d266fb-d593-4d0d-8b3e-7fe225513a09", "dependencies": ["Event-ENV-645fa4a2-1905-4c09-bef2-f1b767d2c450", "OracleEvent-AGENT-1feb05f2-6fea-4477-b3aa-d4c35a893514"], "event_relative_time": 2.0, "action": {"action_id": "", "app": "Calendar", "function": "delete_calendar_event", "operation_type": null, "args": [{"name": "event_id", "value": "{{OracleEvent-AGENT-8e4fcf55-b253-4826-a081-834aa43ca375}}", "value_type": "str"}]}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-4692e7f1-6abc-4f67-9d20-f7318a2fbaf4", "dependencies": ["Event-ENV-645fa4a2-1905-4c09-bef2-f1b767d2c450", "OracleEvent-AGENT-1feb05f2-6fea-4477-b3aa-d4c35a893514"], "event_relative_time": 2.0, "action": {"action_id": "", "app": "Cabs", "function": "user_cancel_ride", "operation_type": null, "args": []}, "metadata": null}, {"class_name": "OracleEvent", "event_type": "AGENT", "event_time": 0.0, "event_id": "OracleEvent-AGENT-8739a5ea-8803-4812-a76e-4bea6ec73fc1", "dependencies": ["Event-ENV-645fa4a2-1905-4c09-bef2-f1b767d2c450", "OracleEvent-AGENT-1feb05f2-6fea-4477-b3aa-d4c35a893514"], "event_relative_time": 2.0, "action": {"action_id": "", "app": "Calendar", "function": "add_calendar_event", "operation_type": null, "args": [{"name": "title", "value": "Property Tour", "value_type": "str"}, {"name": "start_datetime", "value": "2024-10-19 16:00:00", "value_type": "str"}, {"name": "end_datetime", "value": "2024-10-19 17:00:00", "value_type": "str"}, {"name": "tag", "value": "", "value_type": "Optional[str]"}, {"name": "description", "