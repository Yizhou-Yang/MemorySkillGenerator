_provenance": "self_assessment", "judge_model": "hy3", "protocol_hash": "7cb32d15a57d", "prof_total_s": 466.0, "prof_embed_s": 0.0, "prof_docker_s": 0.0, "prof_llm_io_s": 466.0, "prof_tok_in": 484, "prof_tok_out": 158, "prof_llm_calls": 1}
