ous fortune", "score": 0.0, "em": 0.0, "method": "exact_match", "execution_mode": "default", "error": "", "category": "", "level": "2", "patch_injected": true, "aug_len": 942, "iteration": 2, "iter_total": 3, "mutated": true, "fb_score": 0.0, "fb_mode": "self", "code_rev": "b0e4cf06", "critic_model": "grok-4.5", "metadata_author": "critic", "c_meta": false, "c_policy": "judgment", "score_provenance": "self_assessment", "judge_model": "hy3", "protocol_hash": "7cb32d15a57d", "prof_total_s": 528.75, "prof_embed_s": 0.0, "prof_docker_s": 0.0, "prof_llm_io_s": 528.75, "prof_tok_in": 511, "prof_tok_out": 336, "prof_llm_calls": 1}
