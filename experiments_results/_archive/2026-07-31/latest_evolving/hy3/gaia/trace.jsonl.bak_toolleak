ue, "fb_score": 0.0, "fb_mode": "self", "code_rev": "b0e4cf06", "critic_model": "grok-4.5", "metadata_author": "critic", "c_meta": false, "c_policy": "judgment", "score_provenance": "self_assessment", "judge_model": "hy3", "protocol_hash": "7cb32d15a57d", "prof_total_s": 232.13, "prof_embed_s": 0.0, "prof_docker_s": 0.0, "prof_llm_io_s": 232.13, "prof_tok_in": 389, "prof_tok_out": 362, "prof_llm_calls": 1}
