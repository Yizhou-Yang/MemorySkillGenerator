", "judge_model": "hy3", "protocol_hash": "7cb32d15a57d", "prof_total_s": 66.77, "prof_embed_s": 0.0, "prof_docker_s": 0.0, "prof_llm_io_s": 66.77, "prof_tok_in": 409, "prof_tok_out": 285, "prof_llm_calls": 1}
