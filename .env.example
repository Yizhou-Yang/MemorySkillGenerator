# MemorySkillGenerator environment variable configuration
# Copy this file to .env and fill in actual values

# ===== LLM API Configuration =====
# The pipeline runs against any OpenAI-compatible chat endpoint. You do NOT need
# the Tencent-internal CodeBuddy CLI: when it is absent, every LLM call (including
# GAIA2 native tool-calling) routes to the endpoint configured here automatically.
#
# Reviewers: set the three OPENAI_* vars below to any OpenAI-compatible endpoint
# (OpenAI, DeepSeek, a vLLM/TGI server, a gateway). Function-calling support is
# required for the GAIA2 agent; the other benchmarks only need plain chat.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o
# Force the OpenAI path even where CodeBuddy is installed:
# LLM_PROVIDER=openai

# OpenRouter (OpenAI-compatible free-model backend; opt-in, leaves the CodeBuddy
# path untouched). Activate with LLM_PROVIDER=openrouter and pick a backbone via
# CODEBUDDY_MODEL using a friendly alias (hy3 | nemotron-super | nemotron-nano) or
# a full "vendor/model:free" id. These free models are reasoning models, so the
# client uses a generous max_tokens (OPENROUTER_MAX_TOKENS, default 8192) and
# falls back to the `reasoning` field when `content` comes back empty.
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
#   CODEBUDDY_MODEL=nemotron-super
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # (default)
# OPENROUTER_MODEL=                                   # overrides CODEBUDDY_MODEL if set
# OPENROUTER_MAX_TOKENS=8192

# DeepSeek Official API (OpenAI-compatible; also accepted as a fallback for the
# OPENAI_* vars above, so filling these in alone is enough).
#   - Create API Key at: https://platform.deepseek.com/api_keys
#   - Available models: deepseek-chat (V3), deepseek-reasoner (R1)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding Configuration =====
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu

# ===== Mem0 Configuration =====
MEM0_VECTOR_STORE=chromadb
MEM0_COLLECTION_NAME=memskillgen_memory

# ===== Experiment Configuration =====
EXPERIMENT_DIR=./experiments
LOG_LEVEL=INFO

# ----- Token-cost knobs (agent loops dominate cost: input re-sent every turn) -----
# Lower turn caps + a sliding history window cut the quadratic context blow-up.
# Defaults below are already the cost-reduced values; raise if accuracy drops.
# GAIA2_MAX_TURNS=20        # ARE agent loop cap (was 50)
# GAIA_MAX_TURNS=20         # GAIA search/patch agent loop cap (was 40/30)
# GAIA2_HISTORY_KEEP=24     # keep system+task + last N messages, drop the middle
# GAIA2_TOOL_TRUNC=2000     # per tool-result char cap re-sent to the model (was 4000)
